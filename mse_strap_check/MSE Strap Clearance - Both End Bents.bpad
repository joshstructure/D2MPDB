      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C24Minusy = (C24y+C24L*(W2ny*Cos(Basis.TestAngle)-W2ty*Sin(Basis.TestAngle)))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C24Minusy = (C24y+C24L*(W2ny*Cos(Basis.TestAngle)-W2ty*Sin(Basis.TestAngle)))</expbody><expresult> = 3.300 ft</expresult></dynexp></paragraph>
