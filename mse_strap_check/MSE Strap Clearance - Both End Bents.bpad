      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C23PlusWall = Min(RouteMath.Dist(C23x,C23y,C23Plusx,C23Plusy,W1xmin,W1xmax,W1ymin,W1ymax),RouteMath.Dist(C23x,C23y,C23Plusx,C23Plusy,W3xmin,W3xmax,W3ymin,W3ymax),RouteMath.Dist(C23x,C23y,C23Plusx,C23Plusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C23x,C23y,C23Plusx,C23Plusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C23PlusWall = Min(RouteMath.Dist(C23x,C23y,C23Plusx,C23Plusy,W1xmin,W1xmax,W1ymin,W1ymax),RouteMath.Dist(C23x,C23y,C23Plusx,C23Plusy,W3xmin,W3xmax,W3ymin,W3ymax),RouteMath.Dist(C23x,C23y,C23Plusx,C23Plusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C23x,C23y,C23Plusx,C23Plusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2</expbody><expresult> = 45.184 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C23PlusOK = And(C23valid,C23PlusPile &gt;= Basis.Clear,C23PlusWall &gt;= 0 in,C23L*Cos(Basis.TestAngle) &gt;= C23d+Envelope)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C23PlusOK = And(C23valid,C23PlusPile &gt;= Basis.Clear,C23PlusWall &gt;= 0 in,C23L*Cos(Basis.TestAngle) &gt;= C23d+Envelope)</expbody><expresult> = false</expresult></dynexp></paragraph>
