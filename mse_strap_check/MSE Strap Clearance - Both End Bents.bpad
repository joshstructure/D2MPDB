      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31MinusOK = And(C31valid,C31MinusPile &gt;= Basis.Clear,C31MinusWall &gt;= 0 in,C31L*Cos(Basis.TestAngle) &gt;= C31d+Envelope)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31MinusOK = And(C31valid,C31MinusPile &gt;= Basis.Clear,C31MinusWall &gt;= 0 in,C31L*Cos(Basis.TestAngle) &gt;= C31d+Envelope)</expbody><expresult> = false</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31MinusStatus = If(C31MinusOK,&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31MinusStatus = If(C31MinusOK,"PASS","FAIL")</expbody><expresult> = FAIL</expresult></dynexp></paragraph>
