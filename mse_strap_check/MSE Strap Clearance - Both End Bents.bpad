          <textvalue>18 in square piles; live center offsets and clearances below.</textvalue>
        </planecontainer>
        <planecontainer origin="0.22,5.2,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#253744">
          <textvalue>Walls are clipped to this view; route checks retain their full length.</textvalue>
        </planecontainer>
      </canvas>
    </embed>
    <embed spacingbefore="5" spacingafter="8">
      <table name="Selected" capture="False" colwidths="1:340, 2:190">
        <stylerule range="A1:B9" fontfamily="Times New Roman" fontsize="9" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#A7B9C6&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#CBD5DD&quot;);"/>
        <stylerule range="A1:B1" background="#DCE7F3" fontweight="bold"/>
        <row>
          <c capture="False" background="#DCE7F3">
            <textvalue>Selected route</textvalue>
          </c>
          <c capture="False" background="#DCE7F3">
            <textvalue>Live result</textvalue>
          </c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Wall / pile</textvalue>
          </c>
          <c capture="False" background="#F3F7F8" formula="SelectedLabel"><textvalue>B1 / P2</textvalue></c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Anchor to selected pile CL, normal d</textvalue>
          </c>
          <c capture="False" background="#F3F7F8" formula="NormalDistance to ft"><num>3.802 ft</num></c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Selected route length</textvalue>
          </c>
          <c capture="False" background="#F3F7F8" formula="RouteLength to ft"><num>12.751 ft</num></c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Local wall height H</textvalue>
          </c>
          <c capture="False" background="#F3F7F8" formula="LocalHeight to ft"><num>18.216 ft</num></c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Required skew to selected pile</textvalue>
          </c>
          <c capture="False" background="#F3F7F8" formula="TargetTheta to deg"><num>15.328 deg</num></c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Selected strip / all piles: edge clearance</textvalue>
          </c>
          <c capture="False" background="#F3F7F8" formula="SelectedPileGap to in"><num>-0.216 in</num></c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Selected strip / other walls: edge clearance</textvalue>
          </c>
          <c capture="False" background="#F3F7F8" formula="SelectedWallGap to in"><num>73.195 in</num></c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Selected route at this angle and layer</textvalue>
          </c>
          <c capture="False" background="#F3F7F8" formula="SelectedStatus"><textvalue>FAIL</textvalue></c>
        </row>
      </table>
    </embed>
    <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="5" fontweight="bold" spacingbefore="8" keepwithnext="True" textcolor="#1766A0" pagebreakbefore="Break">STEP 2 OF 4 | ALL ALIGNED ORIGINS</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Every row starts from the wall normal through that target pile. Width limit is the nominal centered-strip limit at 15 degrees for that target alone, with zero required gap and zero tolerance. Route columns include all four piles, other walls, input width/gap/tolerance, full length and layer checks.</paragraph>
    <section name="LiveEquations" capture="False" hide="true">
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="Half = PileSize/2*1.00002063753194" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>Half = PileSize/2*1.00002063753194</expbody><expresult> = 0.750 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="Envelope = Half+Basis.Tolerance" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>Envelope = Half+Basis.Tolerance</expbody><expresult> = 9.000 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="Buffer = Basis.Width/2+Basis.Clear" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>Buffer = Basis.Width/2+Basis.Clear</expbody><expresult> = 1.000 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="P1x = P1xSource+P1xOffset" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>P1x = P1xSource+P1xOffset</expbody><expresult> = -6.750 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="P1y = P1ySource+P1yOffset" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>P1y = P1ySource+P1yOffset</expbody><expresult> = 0.000 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="P2x = P2xSource+P2xOffset" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>P2x = P2xSource+P2xOffset</expbody><expresult> = -2.250 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="P2y = P2ySource+P2yOffset" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>P2y = P2ySource+P2yOffset</expbody><expresult> = 0.000 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="P3x = P3xSource+P3xOffset" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>P3x = P3xSource+P3xOffset</expbody><expresult> = 2.250 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="P3y = P3ySource+P3yOffset" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>P3y = P3ySource+P3yOffset</expbody><expresult> = -0.000 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="P4x = P4xSource+P4xOffset" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>P4x = P4xSource+P4xOffset</expbody><expresult> = 6.750 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="P4y = P4ySource+P4yOffset" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>P4y = P4ySource+P4yOffset</expbody><expresult> = -0.000 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="W1xend = W1x+W1tx*W1len" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>W1xend = W1x+W1tx*W1len</expbody><expresult> = 8.664 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="W1xmin = Min(W1x,W1xend)-Max(W1nx,0)*PanelThickness" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>W1xmin = Min(W1x,W1xend)-Max(W1nx,0)*PanelThickness</expbody><expresult> = -8.669 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="W1xmax = Max(W1x,W1xend)-Min(W1nx,0)*PanelThickness" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>W1xmax = Max(W1x,W1xend)-Min(W1nx,0)*PanelThickness</expbody><expresult> = 8.664 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="W1yend = W1y+W1ty*W1len" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>W1yend = W1y+W1ty*W1len</expbody><expresult> = -3.802 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="W1ymin = Min(W1y,W1yend)-Max(W1ny,0)*PanelThickness" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>W1ymin = Min(W1y,W1yend)-Max(W1ny,0)*PanelThickness</expbody><expresult> = -4.260 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="W1ymax = Max(W1y,W1yend)-Min(W1ny,0)*PanelThickness" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>W1ymax = Max(W1y,W1yend)-Min(W1ny,0)*PanelThickness</expbody><expresult> = -3.802 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11u = (P1x-W1x)*W1tx+(P1y-W1y)*W1ty" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11u = (P1x-W1x)*W1tx+(P1y-W1y)*W1ty</expbody><expresult> = 1.919 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11d = (P1x-W1x)*W1nx+(P1y-W1y)*W1ny" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11d = (P1x-W1x)*W1nx+(P1y-W1y)*W1ny</expbody><expresult> = 3.802 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11x = W1x+C11u*W1tx" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11x = W1x+C11u*W1tx</expbody><expresult> = -6.750 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11y = W1y+C11u*W1ty" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11y = W1y+C11u*W1ty</expbody><expresult> = -3.802 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11top = If(C11u &lt; 17.3332686005741 ft,(39.388 ft+(C11u-0 ft)*0),39.388 ft)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11top = If(C11u &lt; 17.3332686005741 ft,(39.388 ft+(C11u-0 ft)*0),39.388 ft)</expbody><expresult> = 39.388 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11base = If(C11u &lt; 17.3332686005741 ft,21.172 ft,21.172 ft)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11base = If(C11u &lt; 17.3332686005741 ft,21.172 ft,21.172 ft)</expbody><expresult> = 21.172 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11H = If(W1HeightOverride &gt; 0 ft,W1HeightOverride,C11top-C11base)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11H = If(W1HeightOverride &gt; 0 ft,W1HeightOverride,C11top-C11base)</expbody><expresult> = 18.216 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11Lmin = Max(8 ft,0.7*C11H)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11Lmin = Max(8 ft,0.7*C11H)</expbody><expresult> = 12.751 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11L = If(LengthOverride &gt; 0 ft,LengthOverride,C11Lmin)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11L = If(LengthOverride &gt; 0 ft,LengthOverride,C11Lmin)</expbody><expresult> = 12.751 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11gap = (C11d-Half)*Sin(Basis.LimitAngle)-Half*Cos(Basis.LimitAngle)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11gap = (C11d-Half)*Sin(Basis.LimitAngle)-Half*Cos(Basis.LimitAngle)</expbody><expresult> = 0.785 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11width = Max(0 in,2*C11gap) to in" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11width = Max(0 in,2*C11gap) to in</expbody><expresult> = 1.569 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11theta = RouteMath.Needed(C11d,Envelope,Envelope,Buffer) to deg" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11theta = RouteMath.Needed(C11d,Envelope,Envelope,Buffer) to deg</expbody><expresult> = 15.327 deg</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11extra = Max(0 in,Envelope+(Envelope*Cos(Basis.LimitAngle)+Buffer)/Sin(Basis.LimitAngle)-C11d) to in" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11extra = Max(0 in,Envelope+(Envelope*Cos(Basis.LimitAngle)+Buffer)/Sin(Basis.LimitAngle)-C11d) to in</expbody><expresult> = 0.832 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11valid = And(C11d &gt; Envelope,C11u &gt;= 0 ft,C11u &lt;= W1len,C11L &gt;= C11Lmin,Basis.Layer &gt; C11base,Basis.Layer &lt; C11top,Basis.Layer &lt; CapBottom,Basis.Layer &lt; PileTop,Basis.Layer &gt; PileTop-TrialPileLength,Basis.InputsValid,PanelThickness &gt; 0 ft,PileSize &gt; 0 ft,CapX &gt; 0 ft,CapY &gt; 0 ft,W1len &gt; 0 ft,Abs(W1tx^2+W1ty^2-1) &lt; 0.000001,Abs(W1nx^2+W1ny^2-1) &lt; 0.000001,Abs(W1tx*W1nx+W1ty*W1ny) &lt; 0.000001,Min(Abs(W1nx),Abs(W1ny)) &lt; 0.000001)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11valid = And(C11d &gt; Envelope,C11u &gt;= 0 ft,C11u &lt;= W1len,C11L &gt;= C11Lmin,Basis.Layer &gt; C11base,Basis.Layer &lt; C11top,Basis.Layer &lt; CapBottom,Basis.Layer &lt; PileTop,Basis.Layer &gt; PileTop-TrialPileLength,Basis.InputsValid,PanelThickness &gt; 0 ft,PileSize &gt; 0 ft,CapX &gt; 0 ft,CapY &gt; 0 ft,W1len &gt; 0 ft,Abs(W1tx^2+W1ty^2-1) &lt; 0.000001,Abs(W1nx^2+W1ny^2-1) &lt; 0.000001,Abs(W1tx*W1nx+W1ty*W1ny) &lt; 0.000001,Min(Abs(W1nx),Abs(W1ny)) &lt; 0.000001)</expbody><expresult> = true</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11target = If(And(C11valid,C11theta &lt;= Basis.LimitAngle),&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11target = If(And(C11valid,C11theta &lt;= Basis.LimitAngle),"PASS","FAIL")</expbody><expresult> = FAIL</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11Plusx = (C11x+C11L*(W1nx*Cos(Basis.TestAngle)+W1tx*Sin(Basis.TestAngle)))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11Plusx = (C11x+C11L*(W1nx*Cos(Basis.TestAngle)+W1tx*Sin(Basis.TestAngle)))</expbody><expresult> = -3.450 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11Plusy = (C11y+C11L*(W1ny*Cos(Basis.TestAngle)+W1ty*Sin(Basis.TestAngle)))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11Plusy = (C11y+C11L*(W1ny*Cos(Basis.TestAngle)+W1ty*Sin(Basis.TestAngle)))</expbody><expresult> = 8.515 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11PlusPile = Min(RouteMath.Dist(C11x,C11y,C11Plusx,C11Plusy,P1x-Envelope,P1x+Envelope,P1y-Envelope,P1y+Envelope),RouteMath.Dist(C11x,C11y,C11Plusx,C11Plusy,P2x-Envelope,P2x+Envelope,P2y-Envelope,P2y+Envelope),RouteMath.Dist(C11x,C11y,C11Plusx,C11Plusy,P3x-Envelope,P3x+Envelope,P3y-Envelope,P3y+Envelope),RouteMath.Dist(C11x,C11y,C11Plusx,C11Plusy,P4x-Envelope,P4x+Envelope,P4y-Envelope,P4y+Envelope))-Basis.Width/2" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11PlusPile = Min(RouteMath.Dist(C11x,C11y,C11Plusx,C11Plusy,P1x-Envelope,P1x+Envelope,P1y-Envelope,P1y+Envelope),RouteMath.Dist(C11x,C11y,C11Plusx,C11Plusy,P2x-Envelope,P2x+Envelope,P2y-Envelope,P2y+Envelope),RouteMath.Dist(C11x,C11y,C11Plusx,C11Plusy,P3x-Envelope,P3x+Envelope,P3y-Envelope,P3y+Envelope),RouteMath.Dist(C11x,C11y,C11Plusx,C11Plusy,P4x-Envelope,P4x+Envelope,P4y-Envelope,P4y+Envelope))-Basis.Width/2</expbody><expresult> = -0.215 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11PlusWall = Min(RouteMath.Dist(C11x,C11y,C11Plusx,C11Plusy,W2xmin,W2xmax,W2ymin,W2ymax),RouteMath.Dist(C11x,C11y,C11Plusx,C11Plusy,W3xmin,W3xmax,W3ymin,W3ymax),RouteMath.Dist(C11x,C11y,C11Plusx,C11Plusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C11x,C11y,C11Plusx,C11Plusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11PlusWall = Min(RouteMath.Dist(C11x,C11y,C11Plusx,C11Plusy,W2xmin,W2xmax,W2ymin,W2ymax),RouteMath.Dist(C11x,C11y,C11Plusx,C11Plusy,W3xmin,W3xmax,W3ymin,W3ymax),RouteMath.Dist(C11x,C11y,C11Plusx,C11Plusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C11x,C11y,C11Plusx,C11Plusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2</expbody><expresult> = 22.026 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11PlusOK = And(C11valid,C11PlusPile &gt;= Basis.Clear,C11PlusWall &gt;= 0 in,C11L*Cos(Basis.TestAngle) &gt;= C11d+Envelope)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11PlusOK = And(C11valid,C11PlusPile &gt;= Basis.Clear,C11PlusWall &gt;= 0 in,C11L*Cos(Basis.TestAngle) &gt;= C11d+Envelope)</expbody><expresult> = false</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11PlusStatus = If(C11PlusOK,&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11PlusStatus = If(C11PlusOK,"PASS","FAIL")</expbody><expresult> = FAIL</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11Minusx = (C11x+C11L*(W1nx*Cos(Basis.TestAngle)-W1tx*Sin(Basis.TestAngle)))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11Minusx = (C11x+C11L*(W1nx*Cos(Basis.TestAngle)-W1tx*Sin(Basis.TestAngle)))</expbody><expresult> = -10.050 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11Minusy = (C11y+C11L*(W1ny*Cos(Basis.TestAngle)-W1ty*Sin(Basis.TestAngle)))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11Minusy = (C11y+C11L*(W1ny*Cos(Basis.TestAngle)-W1ty*Sin(Basis.TestAngle)))</expbody><expresult> = 8.515 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11MinusPile = Min(RouteMath.Dist(C11x,C11y,C11Minusx,C11Minusy,P1x-Envelope,P1x+Envelope,P1y-Envelope,P1y+Envelope),RouteMath.Dist(C11x,C11y,C11Minusx,C11Minusy,P2x-Envelope,P2x+Envelope,P2y-Envelope,P2y+Envelope),RouteMath.Dist(C11x,C11y,C11Minusx,C11Minusy,P3x-Envelope,P3x+Envelope,P3y-Envelope,P3y+Envelope),RouteMath.Dist(C11x,C11y,C11Minusx,C11Minusy,P4x-Envelope,P4x+Envelope,P4y-Envelope,P4y+Envelope))-Basis.Width/2" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11MinusPile = Min(RouteMath.Dist(C11x,C11y,C11Minusx,C11Minusy,P1x-Envelope,P1x+Envelope,P1y-Envelope,P1y+Envelope),RouteMath.Dist(C11x,C11y,C11Minusx,C11Minusy,P2x-Envelope,P2x+Envelope,P2y-Envelope,P2y+Envelope),RouteMath.Dist(C11x,C11y,C11Minusx,C11Minusy,P3x-Envelope,P3x+Envelope,P3y-Envelope,P3y+Envelope),RouteMath.Dist(C11x,C11y,C11Minusx,C11Minusy,P4x-Envelope,P4x+Envelope,P4y-Envelope,P4y+Envelope))-Basis.Width/2</expbody><expresult> = -0.215 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11MinusWall = Min(RouteMath.Dist(C11x,C11y,C11Minusx,C11Minusy,W2xmin,W2xmax,W2ymin,W2ymax),RouteMath.Dist(C11x,C11y,C11Minusx,C11Minusy,W3xmin,W3xmax,W3ymin,W3ymax),RouteMath.Dist(C11x,C11y,C11Minusx,C11Minusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C11x,C11y,C11Minusx,C11Minusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11MinusWall = Min(RouteMath.Dist(C11x,C11y,C11Minusx,C11Minusy,W2xmin,W2xmax,W2ymin,W2ymax),RouteMath.Dist(C11x,C11y,C11Minusx,C11Minusy,W3xmin,W3xmax,W3ymin,W3ymax),RouteMath.Dist(C11x,C11y,C11Minusx,C11Minusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C11x,C11y,C11Minusx,C11Minusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2</expbody><expresult> = -1.000 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11MinusOK = And(C11valid,C11MinusPile &gt;= Basis.Clear,C11MinusWall &gt;= 0 in,C11L*Cos(Basis.TestAngle) &gt;= C11d+Envelope)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11MinusOK = And(C11valid,C11MinusPile &gt;= Basis.Clear,C11MinusWall &gt;= 0 in,C11L*Cos(Basis.TestAngle) &gt;= C11d+Envelope)</expbody><expresult> = false</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C11MinusStatus = If(C11MinusOK,&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C11MinusStatus = If(C11MinusOK,"PASS","FAIL")</expbody><expresult> = FAIL</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C12u = (P2x-W1x)*W1tx+(P2y-W1y)*W1ty" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C12u = (P2x-W1x)*W1tx+(P2y-W1y)*W1ty</expbody><expresult> = 6.419 ft</expresult></dynexp></paragraph>
