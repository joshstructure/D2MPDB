      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34base = If(C34u &lt; 6.00000002924105 ft,21.172 ft,21.172 ft)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34base = If(C34u &lt; 6.00000002924105 ft,21.172 ft,21.172 ft)</expbody><expresult> = 21.172 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34H = If(W3HeightOverride &gt; 0 ft,W3HeightOverride,C34top-C34base)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34H = If(W3HeightOverride &gt; 0 ft,W3HeightOverride,C34top-C34base)</expbody><expresult> = 18.216 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34Lmin = Max(8 ft,0.7*C34H)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34Lmin = Max(8 ft,0.7*C34H)</expbody><expresult> = 12.751 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34L = If(LengthOverride &gt; 0 ft,LengthOverride,C34Lmin)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34L = If(LengthOverride &gt; 0 ft,LengthOverride,C34Lmin)</expbody><expresult> = 12.751 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34gap = (C34d-Half)*Sin(Basis.LimitAngle)-Half*Cos(Basis.LimitAngle)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34gap = (C34d-Half)*Sin(Basis.LimitAngle)-Half*Cos(Basis.LimitAngle)</expbody><expresult> = -5.077 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34width = Max(0 in,2*C34gap) to in" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34width = Max(0 in,2*C34gap) to in</expbody><expresult> = 0.000 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34theta = RouteMath.Needed(C34d,Envelope,Envelope,Buffer) to deg" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34theta = RouteMath.Needed(C34d,Envelope,Envelope,Buffer) to deg</expbody><expresult> = 36.236 deg</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34extra = Max(0 in,Envelope+(Envelope*Cos(Basis.LimitAngle)+Buffer)/Sin(Basis.LimitAngle)-C34d) to in" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34extra = Max(0 in,Envelope+(Envelope*Cos(Basis.LimitAngle)+Buffer)/Sin(Basis.LimitAngle)-C34d) to in</expbody><expresult> = 23.480 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34valid = And(C34d &gt; Envelope,C34u &gt;= 0 ft,C34u &lt;= W3len,C34L &gt;= C34Lmin,Basis.Layer &gt; C34base,Basis.Layer &lt; C34top,Basis.Layer &lt; CapBottom,Basis.Layer &lt; PileTop,Basis.Layer &gt; PileTop-TrialPileLength,Basis.InputsValid,PanelThickness &gt; 0 ft,PileSize &gt; 0 ft,CapX &gt; 0 ft,CapY &gt; 0 ft,W3len &gt; 0 ft,Abs(W3tx^2+W3ty^2-1) &lt; 0.000001,Abs(W3nx^2+W3ny^2-1) &lt; 0.000001,Abs(W3tx*W3nx+W3ty*W3ny) &lt; 0.000001,Min(Abs(W3nx),Abs(W3ny)) &lt; 0.000001)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34valid = And(C34d &gt; Envelope,C34u &gt;= 0 ft,C34u &lt;= W3len,C34L &gt;= C34Lmin,Basis.Layer &gt; C34base,Basis.Layer &lt; C34top,Basis.Layer &lt; CapBottom,Basis.Layer &lt; PileTop,Basis.Layer &gt; PileTop-TrialPileLength,Basis.InputsValid,PanelThickness &gt; 0 ft,PileSize &gt; 0 ft,CapX &gt; 0 ft,CapY &gt; 0 ft,W3len &gt; 0 ft,Abs(W3tx^2+W3ty^2-1) &lt; 0.000001,Abs(W3nx^2+W3ny^2-1) &lt; 0.000001,Abs(W3tx*W3nx+W3ty*W3ny) &lt; 0.000001,Min(Abs(W3nx),Abs(W3ny)) &lt; 0.000001)</expbody><expresult> = true</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34target = If(And(C34valid,C34theta &lt;= Basis.LimitAngle),&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34target = If(And(C34valid,C34theta &lt;= Basis.LimitAngle),"PASS","FAIL")</expbody><expresult> = FAIL</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34Plusx = (C34x+C34L*(W3nx*Cos(Basis.TestAngle)+W3tx*Sin(Basis.TestAngle)))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34Plusx = (C34x+C34L*(W3nx*Cos(Basis.TestAngle)+W3tx*Sin(Basis.TestAngle)))</expbody><expresult> = -3.652 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34Plusy = (C34y+C34L*(W3ny*Cos(Basis.TestAngle)+W3ty*Sin(Basis.TestAngle)))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34Plusy = (C34y+C34L*(W3ny*Cos(Basis.TestAngle)+W3ty*Sin(Basis.TestAngle)))</expbody><expresult> = -3.300 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34PlusPile = Min(RouteMath.Dist(C34x,C34y,C34Plusx,C34Plusy,P1x-Envelope,P1x+Envelope,P1y-Envelope,P1y+Envelope),RouteMath.Dist(C34x,C34y,C34Plusx,C34Plusy,P2x-Envelope,P2x+Envelope,P2y-Envelope,P2y+Envelope),RouteMath.Dist(C34x,C34y,C34Plusx,C34Plusy,P3x-Envelope,P3x+Envelope,P3y-Envelope,P3y+Envelope),RouteMath.Dist(C34x,C34y,C34Plusx,C34Plusy,P4x-Envelope,P4x+Envelope,P4y-Envelope,P4y+Envelope))-Basis.Width/2" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34PlusPile = Min(RouteMath.Dist(C34x,C34y,C34Plusx,C34Plusy,P1x-Envelope,P1x+Envelope,P1y-Envelope,P1y+Envelope),RouteMath.Dist(C34x,C34y,C34Plusx,C34Plusy,P2x-Envelope,P2x+Envelope,P2y-Envelope,P2y+Envelope),RouteMath.Dist(C34x,C34y,C34Plusx,C34Plusy,P3x-Envelope,P3x+Envelope,P3y-Envelope,P3y+Envelope),RouteMath.Dist(C34x,C34y,C34Plusx,C34Plusy,P4x-Envelope,P4x+Envelope,P4y-Envelope,P4y+Envelope))-Basis.Width/2</expbody><expresult> = -1.000 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34PlusWall = Min(RouteMath.Dist(C34x,C34y,C34Plusx,C34Plusy,W1xmin,W1xmax,W1ymin,W1ymax),RouteMath.Dist(C34x,C34y,C34Plusx,C34Plusy,W2xmin,W2xmax,W2ymin,W2ymax),RouteMath.Dist(C34x,C34y,C34Plusx,C34Plusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C34x,C34y,C34Plusx,C34Plusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34PlusWall = Min(RouteMath.Dist(C34x,C34y,C34Plusx,C34Plusy,W1xmin,W1xmax,W1ymin,W1ymax),RouteMath.Dist(C34x,C34y,C34Plusx,C34Plusy,W2xmin,W2xmax,W2ymin,W2ymax),RouteMath.Dist(C34x,C34y,C34Plusx,C34Plusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C34x,C34y,C34Plusx,C34Plusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2</expbody><expresult> = 5.014 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34PlusOK = And(C34valid,C34PlusPile &gt;= Basis.Clear,C34PlusWall &gt;= 0 in,C34L*Cos(Basis.TestAngle) &gt;= C34d+Envelope)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34PlusOK = And(C34valid,C34PlusPile &gt;= Basis.Clear,C34PlusWall &gt;= 0 in,C34L*Cos(Basis.TestAngle) &gt;= C34d+Envelope)</expbody><expresult> = false</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34PlusStatus = If(C34PlusOK,&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34PlusStatus = If(C34PlusOK,"PASS","FAIL")</expbody><expresult> = FAIL</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34Minusx = (C34x+C34L*(W3nx*Cos(Basis.TestAngle)-W3tx*Sin(Basis.TestAngle)))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34Minusx = (C34x+C34L*(W3nx*Cos(Basis.TestAngle)-W3tx*Sin(Basis.TestAngle)))</expbody><expresult> = -3.652 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34Minusy = (C34y+C34L*(W3ny*Cos(Basis.TestAngle)-W3ty*Sin(Basis.TestAngle)))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34Minusy = (C34y+C34L*(W3ny*Cos(Basis.TestAngle)-W3ty*Sin(Basis.TestAngle)))</expbody><expresult> = 3.300 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34MinusPile = Min(RouteMath.Dist(C34x,C34y,C34Minusx,C34Minusy,P1x-Envelope,P1x+Envelope,P1y-Envelope,P1y+Envelope),RouteMath.Dist(C34x,C34y,C34Minusx,C34Minusy,P2x-Envelope,P2x+Envelope,P2y-Envelope,P2y+Envelope),RouteMath.Dist(C34x,C34y,C34Minusx,C34Minusy,P3x-Envelope,P3x+Envelope,P3y-Envelope,P3y+Envelope),RouteMath.Dist(C34x,C34y,C34Minusx,C34Minusy,P4x-Envelope,P4x+Envelope,P4y-Envelope,P4y+Envelope))-Basis.Width/2" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34MinusPile = Min(RouteMath.Dist(C34x,C34y,C34Minusx,C34Minusy,P1x-Envelope,P1x+Envelope,P1y-Envelope,P1y+Envelope),RouteMath.Dist(C34x,C34y,C34Minusx,C34Minusy,P2x-Envelope,P2x+Envelope,P2y-Envelope,P2y+Envelope),RouteMath.Dist(C34x,C34y,C34Minusx,C34Minusy,P3x-Envelope,P3x+Envelope,P3y-Envelope,P3y+Envelope),RouteMath.Dist(C34x,C34y,C34Minusx,C34Minusy,P4x-Envelope,P4x+Envelope,P4y-Envelope,P4y+Envelope))-Basis.Width/2</expbody><expresult> = -1.000 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C34MinusWall = Min(RouteMath.Dist(C34x,C34y,C34Minusx,C34Minusy,W1xmin,W1xmax,W1ymin,W1ymax),RouteMath.Dist(C34x,C34y,C34Minusx,C34Minusy,W2xmin,W2xmax,W2ymin,W2ymax),RouteMath.Dist(C34x,C34y,C34Minusx,C34Minusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C34x,C34y,C34Minusx,C34Minusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C34MinusWall = Min(RouteMath.Dist(C34x,C34y,C34Minusx,C34Minusy,W1xmin,W1xmax,W1ymin,W1ymax),RouteMath.Dist(C34x,C34y,C34Minusx,C34Minusy,W2xmin,W2xmax,W2ymin,W2ymax),RouteMath.Dist(C34x,C34y,C34Minusx,C34Minusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C34x,C34y,C34Minusx,C34Minusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2</expbody><expresult> = 19.171 in</expresult></dynexp></paragraph>
