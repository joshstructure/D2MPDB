  <report name="Basis" title="01 - Start here and controls" unit="in" pagesize="816,1056" margin="48,48,48,48" bordermargin="0,0,0,0" collapsemargins="False">
    <stylerule type="AnyEquation" name="Input" texthighlight="#F7E6B9"/>
    <paragraph fontfamily="Times New Roman" fontsize="16" spacingafter="5" fontweight="bold">D2 MPDB PEDESTRIAN BRIDGE</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="5" fontweight="bold">MSE STRAP / PILE PLAN CLEARANCE</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Both end bents | 13 October 2026 | Straight strap starting on the pile centerline</paragraph>
    <embed spacingbefore="5" spacingafter="8">
      <table name="Overview" capture="False" colwidths="1:75, 2:455">
        <stylerule range="A1:B4" fontfamily="Times New Roman" fontsize="9" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#A7B9C6&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#CBD5DD&quot;);"/>
        <stylerule range="A1:B1" background="#DCE7F3" fontweight="bold"/>
        <row>
          <c capture="False" background="#DCE7F3">
            <textvalue>Item</textvalue>
          </c>
          <c capture="False" background="#DCE7F3">
            <textvalue>Basis</textvalue>
          </c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Objective</textvalue>
          </c>
          <c capture="False" background="#F3F7F8">
            <textvalue>Can a wall strap starting dead center in line with a pile clear it within 15 degrees?</textvalue>
          </c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Inputs</textvalue>
          </c>
          <c capture="False" background="#F3F7F8">
            <textvalue>Saved end-bent / MSE geometry; editable strap width, clearance, pile offsets and test skew. Amber equations are inputs.</textvalue>
          </c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Output</textvalue>
          </c>
          <c capture="False" background="#F3F7F8">
            <textvalue>Required target skew, maximum strap width, full-length +/- route checks and separate cap setback check.</textvalue>
          </c>
        </row>
      </table>
    </embed>
    <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="5" fontweight="bold" spacingbefore="8" keepwithnext="True" textcolor="#1766A0">CURRENT GEOMETRY SCREEN</paragraph>
    <embed spacingbefore="5" spacingafter="8">
      <table name="Summary" capture="False" colwidths="1:310, 2:110, 3:110">
        <stylerule range="A1:C8" fontfamily="Times New Roman" fontsize="9" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#A7B9C6&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#CBD5DD&quot;);"/>
        <stylerule range="A1:C1" background="#DCE7F3" fontweight="bold"/>
        <row>
          <c capture="False" background="#DCE7F3">
            <textvalue>Check</textvalue>
          </c>
          <c capture="False" background="#DCE7F3">
            <textvalue>End Bent 1</textvalue>
          </c>
          <c capture="False" background="#DCE7F3">
            <textvalue>End Bent 2</textvalue>
          </c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Front-wall 15-degree centerline clearance</textvalue>
          </c>
          <c capture="False" background="#F3F7F8" formula="EB1.FrontGap to in"><num>0.930 in</num></c>
          <c capture="False" background="#F3F7F8" formula="EB2.FrontGap to in"><num>0.784 in</num></c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Largest centered strip at 15 degrees (no tolerance)</textvalue>
          </c>
          <c capture="False" background="#F3F7F8" formula="EB1.FrontMaxWidth to in"><num>1.860 in</num></c>
          <c capture="False" background="#F3F7F8" formula="EB2.FrontMaxWidth to in"><num>1.567 in</num></c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Extra front-wall / pile separation for target</textvalue>
          </c>
          <c capture="False" background="#F3F7F8" formula="EB1.FrontExtra to in"><num>0.271 in</num></c>
          <c capture="False" background="#F3F7F8" formula="EB2.FrontExtra to in"><num>0.836 in</num></c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Front wall / input strap width</textvalue>
          </c>
          <c capture="False" background="#F3F7F8" formula="EB1.FrontTargetStatus"><textvalue>FAIL</textvalue></c>
          <c capture="False" background="#F3F7F8" formula="EB2.FrontTargetStatus"><textvalue>FAIL</textvalue></c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Left return / nearest pile</textvalue>
          </c>
          <c capture="False" background="#F3F7F8" formula="EB1.LeftTargetStatus"><textvalue>FAIL</textvalue></c>
          <c capture="False" background="#F3F7F8" formula="EB2.LeftTargetStatus"><textvalue>FAIL</textvalue></c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Right return / nearest pile</textvalue>
          </c>
          <c capture="False" background="#F3F7F8" formula="EB1.RightTargetStatus"><textvalue>FAIL</textvalue></c>
          <c capture="False" background="#F3F7F8" formula="EB2.RightTargetStatus"><textvalue>FAIL</textvalue></c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>Front cap setback &gt;= 24 in</textvalue>
          </c>
          <c capture="False" background="#F3F7F8" formula="EB1.FrontCapStatus"><textvalue>PASS</textvalue></c>
          <c capture="False" background="#F3F7F8" formula="EB2.FrontCapStatus"><textvalue>PASS</textvalue></c>
        </row>
      </table>
    </embed>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" background="#F1F5FA">A line can pass while a finite-width strap touches a pile. A target PASS is necessary but does not establish a clear route past every pile or adjacent wall. Negative margins fail. Tangency is zero margin, not usable construction clearance.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="5" fontweight="bold" spacingbefore="8" keepwithnext="True" textcolor="#1766A0">COMMON EDITABLE CONTROLS</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="Width = 2 in" mathlayout="on" showsteps="False" showresult="True" showformula="True" style="Input"><expbody>Width = 2 in</expbody><expresult> = 2.000 in</expresult></dynexp></paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5" textcolor="#43505C">Illustrative strap width only; replace with the vendor width. Not a sourced product dimension.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="Clear = 0 in" mathlayout="on" showsteps="False" showresult="True" showformula="True" style="Input"><expbody>Clear = 0 in</expbody><expresult> = 0.000 in</expresult></dynexp></paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5" textcolor="#43505C">Required clear gap from strap edge to pile. Zero means geometric non-intersection only.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="Tolerance = 0 in" mathlayout="on" showsteps="False" showresult="True" showformula="True" style="Input"><expbody>Tolerance = 0 in</expbody><expresult> = 0.000 in</expresult></dynexp></paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5" textcolor="#43505C">Square pile-location envelope in both plan directions. Zero is the nominal model; enter project allowance (e.g. a 3 in sensitivity).</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="TestAngle = 15 deg" mathlayout="on" showsteps="False" showresult="True" showformula="True" style="Input"><expbody>TestAngle = 15 deg</expbody><expresult> = 15.000 deg</expresult></dynexp></paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5" textcolor="#43505C">Both signs of this angle are checked. Ordinary skew may not exceed LimitAngle.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="Layer = 38 ft" mathlayout="on" showsteps="False" showresult="True" showformula="True" style="Input"><expbody>Layer = 38 ft</expbody><expresult> = 38.000 ft</expresult></dynexp></paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5" textcolor="#43505C">Illustrative strap elevation. Piles are modeled plumb. This layer is below both cap soffits and modeled front-wall tops.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="VendorReady = false" mathlayout="on" showsteps="False" showresult="True" showformula="True" style="Input"><expbody>VendorReady = false</expbody><expresult> = false</expresult></dynexp></paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5" textcolor="#43505C">Set true only after confirming width, required gap, placement envelope, layer and design length.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="LimitAngle = 15 deg" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>LimitAngle = 15 deg</expbody><expresult> = 15.000 deg</expresult></dynexp></paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5" textcolor="#43505C">SDG 3.13.2.K.8 ordinary limit. Developed special skew details are outside this check.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="InputsValid = And(Width &gt;= 0 in, Clear &gt;= 0 in, Tolerance &gt;= 0 in, TestAngle &gt; 0 deg, TestAngle &lt;= LimitAngle, LimitAngle &lt;= 15 deg)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>InputsValid = And(Width &gt;= 0 in, Clear &gt;= 0 in, Tolerance &gt;= 0 in, TestAngle &gt; 0 deg, TestAngle &lt;= LimitAngle, LimitAngle &lt;= 15 deg)</expbody><expresult> = true</expresult></dynexp></paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="5" fontweight="bold" spacingbefore="8" keepwithnext="True" textcolor="#1766A0" pagebreakbefore="Break">DESIGN BASIS AND STRATEGY</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" fontweight="bold">1. Inspect plan and select a route</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Use EB1 / EB2 tabs. WallChoice: 1 front, 2 left return, 3 right return. PileChoice: 1 through 4, left to right. The anchor is the perpendicular projection of that pile onto the back of facing.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5"><link address="#EB1">Open End Bent 1</link></paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5"><link address="#EB2">Open End Bent 2</link></paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" fontweight="bold">2. Check the aligned target</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Use the near pile corner, not the pile center station. Show zero-width and finite-width requirements independently.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5"><link address="#EB1">Open End Bent 1</link></paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" fontweight="bold">3. Check the full route</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">At both signs of TestAngle, check every pile and every shown wall other than the source wall along the full input length. The finite strip is conservatively treated as a capsule.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5"><link address="#EB1">Open End Bent 1</link></paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" fontweight="bold">4. Keep separate requirements visible</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Cap setback, reinforcement minimum length, wall-layer range and 70-degree corners are distinct checks. Plan clearance does not establish elevation routing or structural capacity.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5"><link address="#EB1">Open End Bent 1</link></paragraph>
    <embed spacingbefore="5" spacingafter="8">
      <table name="Criteria" capture="False" colwidths="1:170, 2:360">
        <stylerule range="A1:B6" fontfamily="Times New Roman" fontsize="9" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#A7B9C6&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#CBD5DD&quot;);"/>
        <stylerule range="A1:B1" background="#DCE7F3" fontweight="bold"/>
        <row>
          <c capture="False" background="#DCE7F3">
            <textvalue>Provision</textvalue>
          </c>
          <c capture="False" background="#DCE7F3">
            <textvalue>Applied meaning</textvalue>
          </c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>SDG 3.13.2.N.2.i</textvalue>
          </c>
          <c capture="False" background="#F3F7F8">
            <textvalue>24 in front face of cap to BACK of facing; measured separately from strap clearance.</textvalue>
          </c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>SDG 3.13.2.N.2.ii</textvalue>
          </c>
          <c capture="False" background="#F3F7F8">
            <textvalue>24 in battered pile face to leveling pad at wall base. Not established by this single-layer plumb-pile screen.</textvalue>
          </c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>SDG 3.13.2.K.8 / K.9</textvalue>
          </c>
          <c capture="False" background="#F3F7F8">
            <textvalue>Ordinary plan skew &lt;= 15 deg; elevation inclination &lt;= 15 deg. Elevation deflection is not credited here.</textvalue>
          </c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>SDG 3.13.2.F</textvalue>
          </c>
          <c capture="False" background="#F3F7F8">
            <textvalue>L &gt;= max(8 ft, 0.7 H); H from top of pad to top of coping. Longer lengths may govern stability.</textvalue>
          </c>
        </row>
        <row>
          <c capture="False" background="#F3F7F8">
            <textvalue>SDM 19.6.E</textvalue>
          </c>
          <c capture="False" background="#F3F7F8">
            <textvalue>Corners &lt; 70 deg require bin-wall design. Current landing corners are 90 deg.</textvalue>
          </c>
        </row>
      </table>
    </embed>
    <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5"><link address="https://www.fdot.gov/structures/structuresmanual/currentrelease">FDOT Structures Manual - January 2026 (SDG pp. 3-55, 3-62, 3-63; SDM 19.6)</link></paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Basis: saved native model registered under project_current/geometry/freecad. Wall profiles mark the back of the modeled facing; facing thickness extends outward. This standalone file contains an editable source snapshot, not a live connection to CAD. Refresh deliberately when CAD changes.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" background="#FFF8E9">The modeled front-wall top is used as the coping proxy. Final vendor coping and wall height are not confirmed. Current model piles are plumb and have provisional tips. Layer shifts may be entered per pile for a separately established batter/as-built section; this does not check the entire battered shaft.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5" background="#FFF8E9">VERIFICATION: native equations were independently evaluated with dimensional checks and compared with separate segment geometry. Display caches are independently computed starting values. Blockpad native recalculation and print pagination have not been verified; recalculate on opening.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5"><link address="layout_snapshot.json">Source snapshot and exact model fingerprint</link></paragraph>
  </report>
  <report name="EB1" title="02 - End Bent 1" unit="in" pagesize="816,1056" margin="48,48,48,48" bordermargin="0,0,0,0" collapsemargins="False">
    <stylerule type="AnyEquation" name="Input" texthighlight="#F7E6B9"/>
    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="5" fontweight="bold">END BENT 1 | PILE / MSE PLAN</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Dimensions in feet unless shown otherwise. Strap begins at the BACK of facing, perpendicular projection of selected pile center. Plan is live; positive sheet y points into the approach.</paragraph>
    <section name="RouteControls" capture="False" hide="false">
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="WallChoice = 1" mathlayout="on" showsteps="False" showresult="True" showformula="True" style="Input"><expbody>WallChoice = 1</expbody><expresult> = 1.000</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5" textcolor="#43505C">Wall: 1 front, 2 left return, 3 right return.</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="PileChoice = 2" mathlayout="on" showsteps="False" showresult="True" showformula="True" style="Input"><expbody>PileChoice = 2</expbody><expresult> = 2.000</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5" textcolor="#43505C">Selected pile: 1 through 4, left to right.</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="Direction = 1" mathlayout="on" showsteps="False" showresult="True" showformula="True" style="Input"><expbody>Direction = 1</expbody><expresult> = 1.000</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5" textcolor="#43505C">Selected drawing sign: +1 or -1 relative to wall tangent.</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="LengthOverride = 0 ft" mathlayout="on" showsteps="False" showresult="True" showformula="True" style="Input"><expbody>LengthOverride = 0 ft</expbody><expresult> = 0.000 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5" textcolor="#43505C">Zero uses ordinary minimum from local H. Enter longer vendor design length here.</paragraph>
    </section>
    <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="5" fontweight="bold" spacingbefore="8" keepwithnext="True" textcolor="#1766A0">STEP 1 OF 4 | PLAN AND SELECTED ROUTE</paragraph>
    <embed spacingbefore="3" spacingafter="5">
      <canvas name="Plan" title="Live plan" unit="in" size="6.5 in; 6 in; scaletofit">
        <include target="Library.Geometry"/>
        <plot formula="PlotLines([3.25+(-EB1.CapX)/(1 ft)*0.225,3.25+(EB1.CapX)/(1 ft)*0.225,3.25+(EB1.CapX)/(1 ft)*0.225,3.25+(-EB1.CapX)/(1 ft)*0.225,3.25+(-EB1.CapX)/(1 ft)*0.225],[1.25+(-EB1.CapY)/(1 ft)*0.225,1.25+(-EB1.CapY)/(1 ft)*0.225,1.25+(EB1.CapY)/(1 ft)*0.225,1.25+(EB1.CapY)/(1 ft)*0.225,1.25+(-EB1.CapY)/(1 ft)*0.225])" linecolor="#7B8993" linethickness="1.4"/>
        <plot formula="PlotLines([If(Or(EB1.W1xmin &gt; 12 ft,EB1.W1xmax &lt; -12 ft,EB1.W1ymin &gt; 16.25 ft,EB1.W1ymax &lt; -4 ft),null,3.25+(Min(12 ft,Max(-12 ft,EB1.W1xmin)))/(1 ft)*0.225),If(Or(EB1.W1xmin &gt; 12 ft,EB1.W1xmax &lt; -12 ft,EB1.W1ymin &gt; 16.25 ft,EB1.W1ymax &lt; -4 ft),null,3.25+(Min(12 ft,Max(-12 ft,EB1.W1xmax)))/(1 ft)*0.225),If(Or(EB1.W1xmin &gt; 12 ft,EB1.W1xmax &lt; -12 ft,EB1.W1ymin &gt; 16.25 ft,EB1.W1ymax &lt; -4 ft),null,3.25+(Min(12 ft,Max(-12 ft,EB1.W1xmax)))/(1 ft)*0.225),If(Or(EB1.W1xmin &gt; 12 ft,EB1.W1xmax &lt; -12 ft,EB1.W1ymin &gt; 16.25 ft,EB1.W1ymax &lt; -4 ft),null,3.25+(Min(12 ft,Max(-12 ft,EB1.W1xmin)))/(1 ft)*0.225),If(Or(EB1.W1xmin &gt; 12 ft,EB1.W1xmax &lt; -12 ft,EB1.W1ymin &gt; 16.25 ft,EB1.W1ymax &lt; -4 ft),null,3.25+(Min(12 ft,Max(-12 ft,EB1.W1xmin)))/(1 ft)*0.225)],[If(Or(EB1.W1xmin &gt; 12 ft,EB1.W1xmax &lt; -12 ft,EB1.W1ymin &gt; 16.25 ft,EB1.W1ymax &lt; -4 ft),null,1.25+(Min(16.25 ft,Max(-4 ft,EB1.W1ymin)))/(1 ft)*0.225),If(Or(EB1.W1xmin &gt; 12 ft,EB1.W1xmax &lt; -12 ft,EB1.W1ymin &gt; 16.25 ft,EB1.W1ymax &lt; -4 ft),null,1.25+(Min(16.25 ft,Max(-4 ft,EB1.W1ymin)))/(1 ft)*0.225),If(Or(EB1.W1xmin &gt; 12 ft,EB1.W1xmax &lt; -12 ft,EB1.W1ymin &gt; 16.25 ft,EB1.W1ymax &lt; -4 ft),null,1.25+(Min(16.25 ft,Max(-4 ft,EB1.W1ymax)))/(1 ft)*0.225),If(Or(EB1.W1xmin &gt; 12 ft,EB1.W1xmax &lt; -12 ft,EB1.W1ymin &gt; 16.25 ft,EB1.W1ymax &lt; -4 ft),null,1.25+(Min(16.25 ft,Max(-4 ft,EB1.W1ymax)))/(1 ft)*0.225),If(Or(EB1.W1xmin &gt; 12 ft,EB1.W1xmax &lt; -12 ft,EB1.W1ymin &gt; 16.25 ft,EB1.W1ymax &lt; -4 ft),null,1.25+(Min(16.25 ft,Max(-4 ft,EB1.W1ymin)))/(1 ft)*0.225)])" linecolor="#374B55" linethickness="2"/>
        <planecontainer origin="3.0,0.19,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#253744">
          <textvalue>A5 / front</textvalue>
        </planecontainer>
