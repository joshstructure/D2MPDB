      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C14gap = (C14d-Half)*Sin(Basis.LimitAngle)-Half*Cos(Basis.LimitAngle)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C14gap = (C14d-Half)*Sin(Basis.LimitAngle)-Half*Cos(Basis.LimitAngle)</expbody><expresult> = 0.931 in</expresult></dynexp></paragraph>
