      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C14u = (P4x-W1x)*W1tx+(P4y-W1y)*W1ty" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C14u = (P4x-W1x)*W1tx+(P4y-W1y)*W1ty</expbody><expresult> = 15.414 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C14d = (P4x-W1x)*W1nx+(P4y-W1y)*W1ny" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C14d = (P4x-W1x)*W1nx+(P4y-W1y)*W1ny</expbody><expresult> = 3.849 ft</expresult></dynexp></paragraph>
