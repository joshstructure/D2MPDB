      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C24u = (P4x-W2x)*W2tx+(P4y-W2y)*W2ty" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C24u = (P4x-W2x)*W2tx+(P4y-W2y)*W2ty</expbody><expresult> = 3.849 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C24d = (P4x-W2x)*W2nx+(P4y-W2y)*W2ny" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C24d = (P4x-W2x)*W2nx+(P4y-W2y)*W2ny</expbody><expresult> = 15.414 ft</expresult></dynexp></paragraph>
