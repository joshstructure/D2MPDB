      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C33top = If(C33u &lt; 0.458333341074365 ft,(48.2613516304142 ft+(C33u-0 ft)*0),If(C33u &lt; 6.00000002924105 ft,(39.388 ft+(C33u-0.458333341074365 ft)*0),39.388 ft))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C33top = If(C33u &lt; 0.458333341074365 ft,(48.2613516304142 ft+(C33u-0 ft)*0),If(C33u &lt; 6.00000002924105 ft,(39.388 ft+(C33u-0.458333341074365 ft)*0),39.388 ft))</expbody><expresult> = 39.388 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C33base = If(C33u &lt; 6.00000002924105 ft,21.172 ft,21.172 ft)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C33base = If(C33u &lt; 6.00000002924105 ft,21.172 ft,21.172 ft)</expbody><expresult> = 21.172 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C33H = If(W3HeightOverride &gt; 0 ft,W3HeightOverride,C33top-C33base)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C33H = If(W3HeightOverride &gt; 0 ft,W3HeightOverride,C33top-C33base)</expbody><expresult> = 18.216 ft</expresult></dynexp></paragraph>
