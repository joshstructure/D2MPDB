      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C33valid = And(C33d &gt; Envelope,C33u &gt;= 0 ft,C33u &lt;= W3len,C33L &gt;= C33Lmin,Basis.Layer &gt; C33base,Basis.Layer &lt; C33top,Basis.Layer &lt; CapBottom,Basis.Layer &lt; PileTop,Basis.Layer &gt; PileTop-TrialPileLength,Basis.InputsValid,PanelThickness &gt; 0 ft,PileSize &gt; 0 ft,CapX &gt; 0 ft,CapY &gt; 0 ft,W3len &gt; 0 ft,Abs(W3tx^2+W3ty^2-1) &lt; 0.000001,Abs(W3nx^2+W3ny^2-1) &lt; 0.000001,Abs(W3tx*W3nx+W3ty*W3ny) &lt; 0.000001,Min(Abs(W3nx),Abs(W3ny)) &lt; 0.000001)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C33valid = And(C33d &gt; Envelope,C33u &gt;= 0 ft,C33u &lt;= W3len,C33L &gt;= C33Lmin,Basis.Layer &gt; C33base,Basis.Layer &lt; C33top,Basis.Layer &lt; CapBottom,Basis.Layer &lt; PileTop,Basis.Layer &gt; PileTop-TrialPileLength,Basis.InputsValid,PanelThickness &gt; 0 ft,PileSize &gt; 0 ft,CapX &gt; 0 ft,CapY &gt; 0 ft,W3len &gt; 0 ft,Abs(W3tx^2+W3ty^2-1) &lt; 0.000001,Abs(W3nx^2+W3ny^2-1) &lt; 0.000001,Abs(W3tx*W3nx+W3ty*W3ny) &lt; 0.000001,Min(Abs(W3nx),Abs(W3ny)) &lt; 0.000001)</expbody><expresult> = true</expresult></dynexp></paragraph>
