      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C24MinusWall = Min(RouteMath.Dist(C24x,C24y,C24Minusx,C24Minusy,W1xmin,W1xmax,W1ymin,W1ymax),RouteMath.Dist(C24x,C24y,C24Minusx,C24Minusy,W3xmin,W3xmax,W3ymin,W3ymax),RouteMath.Dist(C24x,C24y,C24Minusx,C24Minusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C24x,C24y,C24Minusx,C24Minusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C24MinusWall = Min(RouteMath.Dist(C24x,C24y,C24Minusx,C24Minusy,W1xmin,W1xmax,W1ymin,W1ymax),RouteMath.Dist(C24x,C24y,C24Minusx,C24Minusy,W3xmin,W3xmax,W3ymin,W3ymax),RouteMath.Dist(C24x,C24y,C24Minusx,C24Minusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C24x,C24y,C24Minusx,C24Minusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2</expbody><expresult> = 44.617 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C24MinusOK = And(C24valid,C24MinusPile &gt;= Basis.Clear,C24MinusWall &gt;= 0 in,C24L*Cos(Basis.TestAngle) &gt;= C24d+Envelope)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C24MinusOK = And(C24valid,C24MinusPile &gt;= Basis.Clear,C24MinusWall &gt;= 0 in,C24L*Cos(Basis.TestAngle) &gt;= C24d+Envelope)</expbody><expresult> = false</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C24MinusStatus = If(C24MinusOK,&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C24MinusStatus = If(C24MinusOK,"PASS","FAIL")</expbody><expresult> = FAIL</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="W3xend = W3x+W3tx*W3len" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>W3xend = W3x+W3tx*W3len</expbody><expresult> = 8.664 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="W3xmin = Min(W3x,W3xend)-Max(W3nx,0)*PanelThickness" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>W3xmin = Min(W3x,W3xend)-Max(W3nx,0)*PanelThickness</expbody><expresult> = 8.664 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="W3xmax = Max(W3x,W3xend)-Min(W3nx,0)*PanelThickness" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>W3xmax = Max(W3x,W3xend)-Min(W3nx,0)*PanelThickness</expbody><expresult> = 9.123 ft</expresult></dynexp></paragraph>
