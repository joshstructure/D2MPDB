      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C32MinusWall = Min(RouteMath.Dist(C32x,C32y,C32Minusx,C32Minusy,W1xmin,W1xmax,W1ymin,W1ymax),RouteMath.Dist(C32x,C32y,C32Minusx,C32Minusy,W2xmin,W2xmax,W2ymin,W2ymax),RouteMath.Dist(C32x,C32y,C32Minusx,C32Minusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C32x,C32y,C32Minusx,C32Minusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C32MinusWall = Min(RouteMath.Dist(C32x,C32y,C32Minusx,C32Minusy,W1xmin,W1xmax,W1ymin,W1ymax),RouteMath.Dist(C32x,C32y,C32Minusx,C32Minusy,W2xmin,W2xmax,W2ymin,W2ymax),RouteMath.Dist(C32x,C32y,C32Minusx,C32Minusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C32x,C32y,C32Minusx,C32Minusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2</expbody><expresult> = 19.169 in</expresult></dynexp></paragraph>
