      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C12top = If(C12u &lt; 17.3332686005741 ft,(39.388 ft+(C12u-0 ft)*0),39.388 ft)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C12top = If(C12u &lt; 17.3332686005741 ft,(39.388 ft+(C12u-0 ft)*0),39.388 ft)</expbody><expresult> = 39.388 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C12base = If(C12u &lt; 17.3332686005741 ft,21.172 ft,21.172 ft)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C12base = If(C12u &lt; 17.3332686005741 ft,21.172 ft,21.172 ft)</expbody><expresult> = 21.172 ft</expresult></dynexp></paragraph>
