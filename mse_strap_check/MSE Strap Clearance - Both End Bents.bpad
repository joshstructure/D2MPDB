      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C32base = If(C32u &lt; 9.66666607722765 ft,21.708 ft,21.708 ft)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C32base = If(C32u &lt; 9.66666607722765 ft,21.708 ft,21.708 ft)</expbody><expresult> = 21.708 ft</expresult></dynexp></paragraph>
