      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C33gap = (C33d-Half)*Sin(Basis.LimitAngle)-Half*Cos(Basis.LimitAngle)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C33gap = (C33d-Half)*Sin(Basis.LimitAngle)-Half*Cos(Basis.LimitAngle)</expbody><expresult> = 8.899 in</expresult></dynexp></paragraph>
