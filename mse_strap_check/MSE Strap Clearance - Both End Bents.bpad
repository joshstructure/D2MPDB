      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C14top = If(C14u &lt; 17.333335694482 ft,(39.388 ft+(C14u-0 ft)*0),39.388 ft)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C14top = If(C14u &lt; 17.333335694482 ft,(39.388 ft+(C14u-0 ft)*0),39.388 ft)</expbody><expresult> = 39.388 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C14base = If(C14u &lt; 17.333335694482 ft,21.708 ft,21.708 ft)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C14base = If(C14u &lt; 17.333335694482 ft,21.708 ft,21.708 ft)</expbody><expresult> = 21.708 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C14H = If(W1HeightOverride &gt; 0 ft,W1HeightOverride,C14top-C14base)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C14H = If(W1HeightOverride &gt; 0 ft,W1HeightOverride,C14top-C14base)</expbody><expresult> = 17.680 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C14Lmin = Max(8 ft,0.7*C14H)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C14Lmin = Max(8 ft,0.7*C14H)</expbody><expresult> = 12.376 ft</expresult></dynexp></paragraph>
