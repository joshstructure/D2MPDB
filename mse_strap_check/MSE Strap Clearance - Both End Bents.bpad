      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C21base = If(C21u &lt; 36.9885590968149 ft,22.172 ft,If(C21u &lt; 44.8746217673087 ft,21.172 ft,21.172 ft))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C21base = If(C21u &lt; 36.9885590968149 ft,22.172 ft,If(C21u &lt; 44.8746217673087 ft,21.172 ft,21.172 ft))</expbody><expresult> = 21.172 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C21H = If(W2HeightOverride &gt; 0 ft,W2HeightOverride,C21top-C21base)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C21H = If(W2HeightOverride &gt; 0 ft,W2HeightOverride,C21top-C21base)</expbody><expresult> = 18.216 ft</expresult></dynexp></paragraph>
