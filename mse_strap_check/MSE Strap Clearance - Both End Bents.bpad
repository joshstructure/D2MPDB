      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31PlusPile = Min(RouteMath.Dist(C31x,C31y,C31Plusx,C31Plusy,P1x-Envelope,P1x+Envelope,P1y-Envelope,P1y+Envelope),RouteMath.Dist(C31x,C31y,C31Plusx,C31Plusy,P2x-Envelope,P2x+Envelope,P2y-Envelope,P2y+Envelope),RouteMath.Dist(C31x,C31y,C31Plusx,C31Plusy,P3x-Envelope,P3x+Envelope,P3y-Envelope,P3y+Envelope),RouteMath.Dist(C31x,C31y,C31Plusx,C31Plusy,P4x-Envelope,P4x+Envelope,P4y-Envelope,P4y+Envelope))-Basis.Width/2" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31PlusPile = Min(RouteMath.Dist(C31x,C31y,C31Plusx,C31Plusy,P1x-Envelope,P1x+Envelope,P1y-Envelope,P1y+Envelope),RouteMath.Dist(C31x,C31y,C31Plusx,C31Plusy,P2x-Envelope,P2x+Envelope,P2y-Envelope,P2y+Envelope),RouteMath.Dist(C31x,C31y,C31Plusx,C31Plusy,P3x-Envelope,P3x+Envelope,P3y-Envelope,P3y+Envelope),RouteMath.Dist(C31x,C31y,C31Plusx,C31Plusy,P4x-Envelope,P4x+Envelope,P4y-Envelope,P4y+Envelope))-Basis.Width/2</expbody><expresult> = -1.000 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31PlusWall = Min(RouteMath.Dist(C31x,C31y,C31Plusx,C31Plusy,W1xmin,W1xmax,W1ymin,W1ymax),RouteMath.Dist(C31x,C31y,C31Plusx,C31Plusy,W2xmin,W2xmax,W2ymin,W2ymax),RouteMath.Dist(C31x,C31y,C31Plusx,C31Plusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C31x,C31y,C31Plusx,C31Plusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31PlusWall = Min(RouteMath.Dist(C31x,C31y,C31Plusx,C31Plusy,W1xmin,W1xmax,W1ymin,W1ymax),RouteMath.Dist(C31x,C31y,C31Plusx,C31Plusy,W2xmin,W2xmax,W2ymin,W2ymax),RouteMath.Dist(C31x,C31y,C31Plusx,C31Plusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C31x,C31y,C31Plusx,C31Plusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2</expbody><expresult> = 5.018 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31PlusOK = And(C31valid,C31PlusPile &gt;= Basis.Clear,C31PlusWall &gt;= 0 in,C31L*Cos(Basis.TestAngle) &gt;= C31d+Envelope)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31PlusOK = And(C31valid,C31PlusPile &gt;= Basis.Clear,C31PlusWall &gt;= 0 in,C31L*Cos(Basis.TestAngle) &gt;= C31d+Envelope)</expbody><expresult> = false</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31PlusStatus = If(C31PlusOK,&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31PlusStatus = If(C31PlusOK,"PASS","FAIL")</expbody><expresult> = FAIL</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31Minusx = (C31x+C31L*(W3nx*Cos(Basis.TestAngle)-W3tx*Sin(Basis.TestAngle)))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31Minusx = (C31x+C31L*(W3nx*Cos(Basis.TestAngle)-W3tx*Sin(Basis.TestAngle)))</expbody><expresult> = -3.652 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31Minusy = (C31y+C31L*(W3ny*Cos(Basis.TestAngle)-W3ty*Sin(Basis.TestAngle)))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31Minusy = (C31y+C31L*(W3ny*Cos(Basis.TestAngle)-W3ty*Sin(Basis.TestAngle)))</expbody><expresult> = 3.300 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31MinusPile = Min(RouteMath.Dist(C31x,C31y,C31Minusx,C31Minusy,P1x-Envelope,P1x+Envelope,P1y-Envelope,P1y+Envelope),RouteMath.Dist(C31x,C31y,C31Minusx,C31Minusy,P2x-Envelope,P2x+Envelope,P2y-Envelope,P2y+Envelope),RouteMath.Dist(C31x,C31y,C31Minusx,C31Minusy,P3x-Envelope,P3x+Envelope,P3y-Envelope,P3y+Envelope),RouteMath.Dist(C31x,C31y,C31Minusx,C31Minusy,P4x-Envelope,P4x+Envelope,P4y-Envelope,P4y+Envelope))-Basis.Width/2" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31MinusPile = Min(RouteMath.Dist(C31x,C31y,C31Minusx,C31Minusy,P1x-Envelope,P1x+Envelope,P1y-Envelope,P1y+Envelope),RouteMath.Dist(C31x,C31y,C31Minusx,C31Minusy,P2x-Envelope,P2x+Envelope,P2y-Envelope,P2y+Envelope),RouteMath.Dist(C31x,C31y,C31Minusx,C31Minusy,P3x-Envelope,P3x+Envelope,P3y-Envelope,P3y+Envelope),RouteMath.Dist(C31x,C31y,C31Minusx,C31Minusy,P4x-Envelope,P4x+Envelope,P4y-Envelope,P4y+Envelope))-Basis.Width/2</expbody><expresult> = -1.000 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31MinusWall = Min(RouteMath.Dist(C31x,C31y,C31Minusx,C31Minusy,W1xmin,W1xmax,W1ymin,W1ymax),RouteMath.Dist(C31x,C31y,C31Minusx,C31Minusy,W2xmin,W2xmax,W2ymin,W2ymax),RouteMath.Dist(C31x,C31y,C31Minusx,C31Minusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C31x,C31y,C31Minusx,C31Minusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31MinusWall = Min(RouteMath.Dist(C31x,C31y,C31Minusx,C31Minusy,W1xmin,W1xmax,W1ymin,W1ymax),RouteMath.Dist(C31x,C31y,C31Minusx,C31Minusy,W2xmin,W2xmax,W2ymin,W2ymax),RouteMath.Dist(C31x,C31y,C31Minusx,C31Minusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C31x,C31y,C31Minusx,C31Minusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2</expbody><expresult> = 19.168 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31MinusOK = And(C31valid,C31MinusPile &gt;= Basis.Clear,C31MinusWall &gt;= 0 in,C31L*Cos(Basis.TestAngle) &gt;= C31d+Envelope)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31MinusOK = And(C31valid,C31MinusPile &gt;= Basis.Clear,C31MinusWall &gt;= 0 in,C31L*Cos(Basis.TestAngle) &gt;= C31d+Envelope)</expbody><expresult> = false</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31MinusStatus = If(C31MinusOK,&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31MinusStatus = If(C31MinusOK,"PASS","FAIL")</expbody><expresult> = FAIL</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C32u = (P2x-W3x)*W3tx+(P2y-W3y)*W3ty" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C32u = (P2x-W3x)*W3tx+(P2y-W3y)*W3ty</expbody><expresult> = 2.198 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C32d = (P2x-W3x)*W3nx+(P2y-W3y)*W3ny" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C32d = (P2x-W3x)*W3nx+(P2y-W3y)*W3ny</expbody><expresult> = 10.914 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C32x = W3x+C32u*W3tx" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C32x = W3x+C32u*W3tx</expbody><expresult> = 8.664 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C32y = W3y+C32u*W3ty" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C32y = W3y+C32u*W3ty</expbody><expresult> = 0.000 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C32top = If(C32u &lt; 0.458333341074365 ft,(48.2613516304142 ft+(C32u-0 ft)*0),If(C32u &lt; 6.00000002924105 ft,(39.388 ft+(C32u-0.458333341074365 ft)*0),39.388 ft))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C32top = If(C32u &lt; 0.458333341074365 ft,(48.2613516304142 ft+(C32u-0 ft)*0),If(C32u &lt; 6.00000002924105 ft,(39.388 ft+(C32u-0.458333341074365 ft)*0),39.388 ft))</expbody><expresult> = 39.388 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C32base = If(C32u &lt; 6.00000002924105 ft,21.172 ft,21.172 ft)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C32base = If(C32u &lt; 6.00000002924105 ft,21.172 ft,21.172 ft)</expbody><expresult> = 21.172 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C32H = If(W3HeightOverride &gt; 0 ft,W3HeightOverride,C32top-C32base)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C32H = If(W3HeightOverride &gt; 0 ft,W3HeightOverride,C32top-C32base)</expbody><expresult> = 18.216 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C32Lmin = Max(8 ft,0.7*C32H)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C32Lmin = Max(8 ft,0.7*C32H)</expbody><expresult> = 12.751 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C32L = If(LengthOverride &gt; 0 ft,LengthOverride,C32Lmin)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C32L = If(LengthOverride &gt; 0 ft,LengthOverride,C32Lmin)</expbody><expresult> = 12.751 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C32gap = (C32d-Half)*Sin(Basis.LimitAngle)-Half*Cos(Basis.LimitAngle)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C32gap = (C32d-Half)*Sin(Basis.LimitAngle)-Half*Cos(Basis.LimitAngle)</expbody><expresult> = 22.875 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C32width = Max(0 in,2*C32gap) to in" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C32width = Max(0 in,2*C32gap) to in</expbody><expresult> = 45.751 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C32theta = RouteMath.Needed(C32d,Envelope,Envelope,Buffer) to deg" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C32theta = RouteMath.Needed(C32d,Envelope,Envelope,Buffer) to deg</expbody><expresult> = 4.689 deg</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C32extra = Max(0 in,Envelope+(Envelope*Cos(Basis.LimitAngle)+Buffer)/Sin(Basis.LimitAngle)-C32d) to in" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C32extra = Max(0 in,Envelope+(Envelope*Cos(Basis.LimitAngle)+Buffer)/Sin(Basis.LimitAngle)-C32d) to in</expbody><expresult> = 0.000 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C32valid = And(C32d &gt; Envelope,C32u &gt;= 0 ft,C32u &lt;= W3len,C32L &gt;= C32Lmin,Basis.Layer &gt; C32base,Basis.Layer &lt; C32top,Basis.Layer &lt; CapBottom,Basis.Layer &lt; PileTop,Basis.Layer &gt; PileTop-TrialPileLength,Basis.InputsValid,PanelThickness &gt; 0 ft,PileSize &gt; 0 ft,CapX &gt; 0 ft,CapY &gt; 0 ft,W3len &gt; 0 ft,Abs(W3tx^2+W3ty^2-1) &lt; 0.000001,Abs(W3nx^2+W3ny^2-1) &lt; 0.000001,Abs(W3tx*W3nx+W3ty*W3ny) &lt; 0.000001,Min(Abs(W3nx),Abs(W3ny)) &lt; 0.000001)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C32valid = And(C32d &gt; Envelope,C32u &gt;= 0 ft,C32u &lt;= W3len,C32L &gt;= C32Lmin,Basis.Layer &gt; C32base,Basis.Layer &lt; C32top,Basis.Layer &lt; CapBottom,Basis.Layer &lt; PileTop,Basis.Layer &gt; PileTop-TrialPileLength,Basis.InputsValid,PanelThickness &gt; 0 ft,PileSize &gt; 0 ft,CapX &gt; 0 ft,CapY &gt; 0 ft,W3len &gt; 0 ft,Abs(W3tx^2+W3ty^2-1) &lt; 0.000001,Abs(W3nx^2+W3ny^2-1) &lt; 0.000001,Abs(W3tx*W3nx+W3ty*W3ny) &lt; 0.000001,Min(Abs(W3nx),Abs(W3ny)) &lt; 0.000001)</expbody><expresult> = true</expresult></dynexp></paragraph>
