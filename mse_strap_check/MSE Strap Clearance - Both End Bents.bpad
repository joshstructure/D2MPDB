      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31gap = (C31d-Half)*Sin(Basis.LimitAngle)-Half*Cos(Basis.LimitAngle)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31gap = (C31d-Half)*Sin(Basis.LimitAngle)-Half*Cos(Basis.LimitAngle)</expbody><expresult> = 36.852 in</expresult></dynexp></paragraph>
