      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C24top = If(C24u &lt; 5.59990935281524 ft,(39.388 ft+(C24u-0 ft)*0),If(C24u &lt; 22.1666660615011 ft,(48.2693135949134 ft+(C24u-5.59990935281524 ft)*-0.0102511819302279),If(C24u &lt; 22.624998822406 ft,(48.0994847578988 ft+(C24u-22.1666660615011 ft)*0),48.0994847578988 ft)))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C24top = If(C24u &lt; 5.59990935281524 ft,(39.388 ft+(C24u-0 ft)*0),If(C24u &lt; 22.1666660615011 ft,(48.2693135949134 ft+(C24u-5.59990935281524 ft)*-0.0102511819302279),If(C24u &lt; 22.624998822406 ft,(48.0994847578988 ft+(C24u-22.1666660615011 ft)*0),48.0994847578988 ft)))</expbody><expresult> = 39.388 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C24base = If(C24u &lt; 22.624998822406 ft,21.708 ft,21.708 ft)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C24base = If(C24u &lt; 22.624998822406 ft,21.708 ft,21.708 ft)</expbody><expresult> = 21.708 ft</expresult></dynexp></paragraph>
