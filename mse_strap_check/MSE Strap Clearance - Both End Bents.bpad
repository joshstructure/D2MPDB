      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C23valid = And(C23d &gt; Envelope,C23u &gt;= 0 ft,C23u &lt;= W2len,C23L &gt;= C23Lmin,Basis.Layer &gt; C23base,Basis.Layer &lt; C23top,Basis.Layer &lt; CapBottom,Basis.Layer &lt; PileTop,Basis.Layer &gt; PileTop-TrialPileLength,Basis.InputsValid,PanelThickness &gt; 0 ft,PileSize &gt; 0 ft,CapX &gt; 0 ft,CapY &gt; 0 ft,W2len &gt; 0 ft,Abs(W2tx^2+W2ty^2-1) &lt; 0.000001,Abs(W2nx^2+W2ny^2-1) &lt; 0.000001,Abs(W2tx*W2nx+W2ty*W2ny) &lt; 0.000001,Min(Abs(W2nx),Abs(W2ny)) &lt; 0.000001)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C23valid = And(C23d &gt; Envelope,C23u &gt;= 0 ft,C23u &lt;= W2len,C23L &gt;= C23Lmin,Basis.Layer &gt; C23base,Basis.Layer &lt; C23top,Basis.Layer &lt; CapBottom,Basis.Layer &lt; PileTop,Basis.Layer &gt; PileTop-TrialPileLength,Basis.InputsValid,PanelThickness &gt; 0 ft,PileSize &gt; 0 ft,CapX &gt; 0 ft,CapY &gt; 0 ft,W2len &gt; 0 ft,Abs(W2tx^2+W2ty^2-1) &lt; 0.000001,Abs(W2nx^2+W2ny^2-1) &lt; 0.000001,Abs(W2tx*W2nx+W2ty*W2ny) &lt; 0.000001,Min(Abs(W2nx),Abs(W2ny)) &lt; 0.000001)</expbody><expresult> = true</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C23target = If(And(C23valid,C23theta &lt;= Basis.LimitAngle),&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C23target = If(And(C23valid,C23theta &lt;= Basis.LimitAngle),"PASS","FAIL")</expbody><expresult> = PASS</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C23Plusx = (C23x+C23L*(W2nx*Cos(Basis.TestAngle)+W2tx*Sin(Basis.TestAngle)))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C23Plusx = (C23x+C23L*(W2nx*Cos(Basis.TestAngle)+W2tx*Sin(Basis.TestAngle)))</expbody><expresult> = 3.290 ft</expresult></dynexp></paragraph>
