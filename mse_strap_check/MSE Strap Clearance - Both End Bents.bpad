      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31top = If(C31u &lt; 0.458333341074365 ft,(48.2613516304142 ft+(C31u-0 ft)*0),If(C31u &lt; 6.00000002924105 ft,(39.388 ft+(C31u-0.458333341074365 ft)*0),39.388 ft))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31top = If(C31u &lt; 0.458333341074365 ft,(48.2613516304142 ft+(C31u-0 ft)*0),If(C31u &lt; 6.00000002924105 ft,(39.388 ft+(C31u-0.458333341074365 ft)*0),39.388 ft))</expbody><expresult> = 39.388 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31base = If(C31u &lt; 6.00000002924105 ft,21.172 ft,21.172 ft)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31base = If(C31u &lt; 6.00000002924105 ft,21.172 ft,21.172 ft)</expbody><expresult> = 21.172 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31H = If(W3HeightOverride &gt; 0 ft,W3HeightOverride,C31top-C31base)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31H = If(W3HeightOverride &gt; 0 ft,W3HeightOverride,C31top-C31base)</expbody><expresult> = 18.216 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31Lmin = Max(8 ft,0.7*C31H)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31Lmin = Max(8 ft,0.7*C31H)</expbody><expresult> = 12.751 ft</expresult></dynexp></paragraph>
