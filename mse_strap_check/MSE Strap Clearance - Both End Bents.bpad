      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31u = (P1x-W3x)*W3tx+(P1y-W3y)*W3ty" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31u = (P1x-W3x)*W3tx+(P1y-W3y)*W3ty</expbody><expresult> = 3.849 ft</expresult></dynexp></paragraph>
