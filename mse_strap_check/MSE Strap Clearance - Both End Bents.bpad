      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C21u = (P1x-W2x)*W2tx+(P1y-W2y)*W2ty" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C21u = (P1x-W2x)*W2tx+(P1y-W2y)*W2ty</expbody><expresult> = 41.073 ft</expresult></dynexp></paragraph>
