      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C14extra = Max(0 in,Envelope+(Envelope*Cos(Basis.LimitAngle)+Buffer)/Sin(Basis.LimitAngle)-C14d) to in" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C14extra = Max(0 in,Envelope+(Envelope*Cos(Basis.LimitAngle)+Buffer)/Sin(Basis.LimitAngle)-C14d) to in</expbody><expresult> = 0.268 in</expresult></dynexp></paragraph>
