      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31Plusx = (C31x+C31L*(W3nx*Cos(Basis.TestAngle)+W3tx*Sin(Basis.TestAngle)))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31Plusx = (C31x+C31L*(W3nx*Cos(Basis.TestAngle)+W3tx*Sin(Basis.TestAngle)))</expbody><expresult> = -3.652 ft</expresult></dynexp></paragraph>
