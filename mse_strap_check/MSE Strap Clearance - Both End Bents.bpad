      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C24valid = And(C24d &gt; Envelope,C24u &gt;= 0 ft,C24u &lt;= W2len,C24L &gt;= C24Lmin,Basis.Layer &gt; C24base,Basis.Layer &lt; C24top,Basis.Layer &lt; CapBottom,Basis.Layer &lt; PileTop,Basis.Layer &gt; PileTop-TrialPileLength,Basis.InputsValid,PanelThickness &gt; 0 ft,PileSize &gt; 0 ft,CapX &gt; 0 ft,CapY &gt; 0 ft,W2len &gt; 0 ft,Abs(W2tx^2+W2ty^2-1) &lt; 0.000001,Abs(W2nx^2+W2ny^2-1) &lt; 0.000001,Abs(W2tx*W2nx+W2ty*W2ny) &lt; 0.000001,Min(Abs(W2nx),Abs(W2ny)) &lt; 0.000001)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C24valid = And(C24d &gt; Envelope,C24u &gt;= 0 ft,C24u &lt;= W2len,C24L &gt;= C24Lmin,Basis.Layer &gt; C24base,Basis.Layer &lt; C24top,Basis.Layer &lt; CapBottom,Basis.Layer &lt; PileTop,Basis.Layer &gt; PileTop-TrialPileLength,Basis.InputsValid,PanelThickness &gt; 0 ft,PileSize &gt; 0 ft,CapX &gt; 0 ft,CapY &gt; 0 ft,W2len &gt; 0 ft,Abs(W2tx^2+W2ty^2-1) &lt; 0.000001,Abs(W2nx^2+W2ny^2-1) &lt; 0.000001,Abs(W2tx*W2nx+W2ty*W2ny) &lt; 0.000001,Min(Abs(W2nx),Abs(W2ny)) &lt; 0.000001)</expbody><expresult> = true</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C24target = If(And(C24valid,C24theta &lt;= Basis.LimitAngle),&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C24target = If(And(C24valid,C24theta &lt;= Basis.LimitAngle),"PASS","FAIL")</expbody><expresult> = PASS</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C24Plusx = (C24x+C24L*(W2nx*Cos(Basis.TestAngle)+W2tx*Sin(Basis.TestAngle)))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C24Plusx = (C24x+C24L*(W2nx*Cos(Basis.TestAngle)+W2tx*Sin(Basis.TestAngle)))</expbody><expresult> = 3.648 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C24Plusy = (C24y+C24L*(W2ny*Cos(Basis.TestAngle)+W2ty*Sin(Basis.TestAngle)))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C24Plusy = (C24y+C24L*(W2ny*Cos(Basis.TestAngle)+W2ty*Sin(Basis.TestAngle)))</expbody><expresult> = -3.300 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C24PlusPile = Min(RouteMath.Dist(C24x,C24y,C24Plusx,C24Plusy,P1x-Envelope,P1x+Envelope,P1y-Envelope,P1y+Envelope),RouteMath.Dist(C24x,C24y,C24Plusx,C24Plusy,P2x-Envelope,P2x+Envelope,P2y-Envelope,P2y+Envelope),RouteMath.Dist(C24x,C24y,C24Plusx,C24Plusy,P3x-Envelope,P3x+Envelope,P3y-Envelope,P3y+Envelope),RouteMath.Dist(C24x,C24y,C24Plusx,C24Plusy,P4x-Envelope,P4x+Envelope,P4y-Envelope,P4y+Envelope))-Basis.Width/2" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C24PlusPile = Min(RouteMath.Dist(C24x,C24y,C24Plusx,C24Plusy,P1x-Envelope,P1x+Envelope,P1y-Envelope,P1y+Envelope),RouteMath.Dist(C24x,C24y,C24Plusx,C24Plusy,P2x-Envelope,P2x+Envelope,P2y-Envelope,P2y+Envelope),RouteMath.Dist(C24x,C24y,C24Plusx,C24Plusy,P3x-Envelope,P3x+Envelope,P3y-Envelope,P3y+Envelope),RouteMath.Dist(C24x,C24y,C24Plusx,C24Plusy,P4x-Envelope,P4x+Envelope,P4y-Envelope,P4y+Envelope))-Basis.Width/2</expbody><expresult> = -1.000 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C24PlusWall = Min(RouteMath.Dist(C24x,C24y,C24Plusx,C24Plusy,W1xmin,W1xmax,W1ymin,W1ymax),RouteMath.Dist(C24x,C24y,C24Plusx,C24Plusy,W3xmin,W3xmax,W3ymin,W3ymax),RouteMath.Dist(C24x,C24y,C24Plusx,C24Plusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C24x,C24y,C24Plusx,C24Plusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C24PlusWall = Min(RouteMath.Dist(C24x,C24y,C24Plusx,C24Plusy,W1xmin,W1xmax,W1ymin,W1ymax),RouteMath.Dist(C24x,C24y,C24Plusx,C24Plusy,W3xmin,W3xmax,W3ymin,W3ymax),RouteMath.Dist(C24x,C24y,C24Plusx,C24Plusy,W4xmin,W4xmax,W4ymin,W4ymax),RouteMath.Dist(C24x,C24y,C24Plusx,C24Plusy,W5xmin,W5xmax,W5ymin,W5ymax))-Basis.Width/2</expbody><expresult> = 5.014 in</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C24PlusOK = And(C24valid,C24PlusPile &gt;= Basis.Clear,C24PlusWall &gt;= 0 in,C24L*Cos(Basis.TestAngle) &gt;= C24d+Envelope)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C24PlusOK = And(C24valid,C24PlusPile &gt;= Basis.Clear,C24PlusWall &gt;= 0 in,C24L*Cos(Basis.TestAngle) &gt;= C24d+Envelope)</expbody><expresult> = false</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C24PlusStatus = If(C24PlusOK,&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C24PlusStatus = If(C24PlusOK,"PASS","FAIL")</expbody><expresult> = FAIL</expresult></dynexp></paragraph>
