      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="W3ymin = Min(W3y,W3yend)-Max(W3ny,0)*PanelThickness" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>W3ymin = Min(W3y,W3yend)-Max(W3ny,0)*PanelThickness</expbody><expresult> = -3.802 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="W3ymax = Max(W3y,W3yend)-Min(W3ny,0)*PanelThickness" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>W3ymax = Max(W3y,W3yend)-Min(W3ny,0)*PanelThickness</expbody><expresult> = 2.198 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31u = (P1x-W3x)*W3tx+(P1y-W3y)*W3ty" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31u = (P1x-W3x)*W3tx+(P1y-W3y)*W3ty</expbody><expresult> = 2.198 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31d = (P1x-W3x)*W3nx+(P1y-W3y)*W3ny" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31d = (P1x-W3x)*W3nx+(P1y-W3y)*W3ny</expbody><expresult> = 15.414 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31x = W3x+C31u*W3tx" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31x = W3x+C31u*W3tx</expbody><expresult> = 8.664 ft</expresult></dynexp></paragraph>
