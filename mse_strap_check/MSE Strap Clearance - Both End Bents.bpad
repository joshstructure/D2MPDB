      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C32MinusStatus = If(C32MinusOK,&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C32MinusStatus = If(C32MinusOK,"PASS","FAIL")</expbody><expresult> = FAIL</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C33u = (P3x-W3x)*W3tx+(P3y-W3y)*W3ty" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C33u = (P3x-W3x)*W3tx+(P3y-W3y)*W3ty</expbody><expresult> = 2.198 ft</expresult></dynexp></paragraph>
