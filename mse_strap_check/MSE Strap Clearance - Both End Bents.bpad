      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31top = If(C31u &lt; 5.16226962645626 ft,(39.388 ft+(C31u-0 ft)*0),If(C31u &lt; 9.66666607722765 ft,(48.2708305619288 ft+(C31u-5.16226962645626 ft)*-0.0248095415959423),48.1590785508187 ft))" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31top = If(C31u &lt; 5.16226962645626 ft,(39.388 ft+(C31u-0 ft)*0),If(C31u &lt; 9.66666607722765 ft,(48.2708305619288 ft+(C31u-5.16226962645626 ft)*-0.0248095415959423),48.1590785508187 ft))</expbody><expresult> = 39.388 ft</expresult></dynexp></paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C31base = If(C31u &lt; 9.66666607722765 ft,21.708 ft,21.708 ft)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C31base = If(C31u &lt; 9.66666607722765 ft,21.708 ft,21.708 ft)</expbody><expresult> = 21.708 ft</expresult></dynexp></paragraph>
