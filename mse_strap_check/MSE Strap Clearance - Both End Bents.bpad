      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="1" spacingbefore="3"><dynexp formula="C21valid = And(C21d &gt; Envelope,C21u &gt;= 0 ft,C21u &lt;= W2len,C21L &gt;= C21Lmin,Basis.Layer &gt; C21base,Basis.Layer &lt; C21top,Basis.Layer &lt; CapBottom,Basis.Layer &lt; PileTop,Basis.Layer &gt; PileTop-TrialPileLength,Basis.InputsValid,PanelThickness &gt; 0 ft,PileSize &gt; 0 ft,CapX &gt; 0 ft,CapY &gt; 0 ft,W2len &gt; 0 ft,Abs(W2tx^2+W2ty^2-1) &lt; 0.000001,Abs(W2nx^2+W2ny^2-1) &lt; 0.000001,Abs(W2tx*W2nx+W2ty*W2ny) &lt; 0.000001,Min(Abs(W2nx),Abs(W2ny)) &lt; 0.000001)" mathlayout="on" showsteps="False" showresult="True" showformula="True"><expbody>C21valid = And(C21d &gt; Envelope,C21u &gt;= 0 ft,C21u &lt;= W2len,C21L &gt;= C21Lmin,Basis.Layer &gt; C21base,Basis.Layer &lt; C21top,Basis.Layer &lt; CapBottom,Basis.Layer &lt; PileTop,Basis.Layer &gt; PileTop-TrialPileLength,Basis.InputsValid,PanelThickness &gt; 0 ft,PileSize &gt; 0 ft,CapX &gt; 0 ft,CapY &gt; 0 ft,W2len &gt; 0 ft,Abs(W2tx^2+W2ty^2-1) &lt; 0.000001,Abs(W2nx^2+W2ny^2-1) &lt; 0.000001,Abs(W2tx*W2nx+W2ty*W2ny) &lt; 0.000001,Min(Abs(W2nx),Abs(W2ny)) &lt; 0.000001)</expbody><expresult> = true</expresult></dynexp></paragraph>
