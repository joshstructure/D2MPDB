        <paragraph spacingafter="2" spacingbefore="6">
            <dynexp formula="2.19ft to in">
                <expbody>2.19ft to in</expbody>
                <expresult> = 26.28 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Entered length expressed in inches.</paragraph>
        <section name="EqNotes_PedBridge_011_2_19ft_to_in" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">Express the entered length entirely in inches. One foot becomes 12 inches; the distance itself stays the same. This lets the value be compared directly with dimensions written in inches.</paragraph>
        </section>
        <paragraph spacingafter="2" spacingbefore="6">
            <dynexp formula="1 3/8&quot; to ft">
                <expbody>1 3/8" to ft</expbody>
                <expresult> = 0.115 ft</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Entered length expressed in decimal feet.</paragraph>
        <section name="EqNotes_PedBridge_012_1_3_8_to_ft" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">Express the entered length entirely in feet. Divide the inches portion by 12 and add it to any whole feet. This changes the unit display without changing the distance.</paragraph>
        </section>
        <paragraph spacingafter="2" spacingbefore="6">
            <dynexp formula="2 1/4 in to ft">
                <expbody>2 1/4 in to ft</expbody>
                <expresult> = 0.188 ft</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Entered length expressed in decimal feet.</paragraph>
        <section name="EqNotes_PedBridge_013_2_1_4_in_to_ft" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">Express the entered length entirely in feet. Divide the inches portion by 12 and add it to any whole feet. This changes the unit display without changing the distance.</paragraph>
        </section>
        <paragraph spacingafter="2" spacingbefore="6">
            <dynexp formula="34in to ft in">
                <expbody>34in to ft in</expbody>
                <expresult> = 2 ft 10 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Entered length displayed in feet and inches.</paragraph>
        <section name="EqNotes_PedBridge_014_34in_to_ft_in" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">Display the entered length as whole feet plus the remaining inches. This is a unit-display conversion, not a change to the physical length.</paragraph>
        </section>
