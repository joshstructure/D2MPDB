<report name="BridgeMovement" title="C003 - Bridge Temperature Movement" unit="in" pagesize="816,1056" margin="48,48,48,48" bordermargin="0,0,0,0" collapsemargins="False"><include target="Library.Geometry"/><stylerule type="AnyEquation" name="Required Input" texthighlight="#F7E6B9"/><embed spacingbefore="5" spacingafter="8"><table name="ProjectStamp" capture="False" colwidths="1:95, 2:165, 3:95, 4:165"><stylerule range="A1:D4" fontfamily="Times New Roman" fontsize="9" vertalign="Center" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#7189A6&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#7189A6&quot;);"/><row><textcell name="ProjectStampR0C0" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Firm</paragraph></textcell><textcell name="ProjectStampR0C1" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_Firm = ProjectInfo.Firm" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_Firm = ProjectInfo.Firm</expbody><expresult>Parsons Transportation Group Inc</expresult></dynexp></paragraph></textcell><textcell name="ProjectStampR0C2" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Project</paragraph></textcell><textcell name="ProjectStampR0C3" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_Project = ProjectInfo.Project" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_Project = ProjectInfo.Project</expbody><expresult>I-95 Capacity Improvements from South of SR 152 to South of SR 126</expresult></dynexp></paragraph></textcell></row><row><textcell name="ProjectStampR1C0" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Address</paragraph></textcell><textcell name="ProjectStampR1C1" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_Address = ProjectInfo.Address" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_Address = ProjectInfo.Address</expbody><expresult>1203 Governors Square Blvd, Suite 201, Tallahassee FL 32301</expresult></dynexp></paragraph></textcell><textcell name="ProjectStampR1C2" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Job no.</paragraph></textcell><textcell name="ProjectStampR1C3" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_JobNo = ProjectInfo.JobNo" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_JobNo = ProjectInfo.JobNo</expbody><expresult></expresult></dynexp></paragraph></textcell></row><row><textcell name="ProjectStampR2C0" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Designed by</paragraph></textcell><textcell name="ProjectStampR2C1" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_DesignedBy = ProjectInfo.DesignedBy" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_DesignedBy = ProjectInfo.DesignedBy</expbody><expresult>JAT</expresult></dynexp></paragraph></textcell><textcell name="ProjectStampR2C2" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Date</paragraph></textcell><textcell name="ProjectStampR2C3" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_DesignDate = ProjectInfo.DesignDate" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_DesignDate = ProjectInfo.DesignDate</expbody><expresult>10/17/2026</expresult></dynexp></paragraph></textcell></row><row><textcell name="ProjectStampR3C0" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Checked by</paragraph></textcell><textcell name="ProjectStampR3C1" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_CheckedBy = ProjectInfo.CheckedBy" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_CheckedBy = ProjectInfo.CheckedBy</expbody><expresult>MIK</expresult></dynexp></paragraph></textcell><textcell name="ProjectStampR3C2" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Date</paragraph></textcell><textcell name="ProjectStampR3C3" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_CheckDate = ProjectInfo.CheckDate" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_CheckDate = ProjectInfo.CheckDate</expbody><expresult></expresult></dynexp></paragraph></textcell></row></table></embed><paragraph fontfamily="Times New Roman" fontsize="16" spacingafter="2" fontweight="bold">D2 I-95 PEDESTRIAN BRIDGE</paragraph><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold">C003 - Bridge Temperature Movement</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Design basis: AASHTO LRFD Bridge Design Specifications, 10th edition (2024); AASHTO LRFD Guide Specifications for the Design of Pedestrian Bridges; FDOT Structures Manual January 2026 (SDG Volume 1, SDM Volume 2)</paragraph><section name="WorkingNotes" capture="False" hide="true"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="4" fontweight="bold" textcolor="#43505C">Working notes (hidden; not part of the submitted calculation): how this edition was produced, its tool status and the open bookkeeping items.</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" textcolor="#43505C">Journal edition written by calc_common/bpad.py (bridge_movement) from the notebook case 82bf12fdf18f. Every definition was evaluated independently and compared with the notebook to 1 part in 10⁹; the inputs the journal owns are live references, compared with the case by the coherence gate before the build.</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" textcolor="#43505C">The calculation was ported from the journal module BridgeMovement (journal feb1bb316d08); every definition of the module was evaluated independently from the journal file and reproduced by the notebook to 1 part in 10⁹ before this edition was written.</paragraph><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5" textcolor="#43505C">A ✓ status covers only the recomputed numerical checks; it is not design acceptance. The equation notes of the calculation are in its report.</paragraph></section><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Inputs are highlighted amber; results are the green tables.</paragraph><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">Overview</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" background="#F1F5FA">Longitudinal thermal movement of the two-span FIB 36 pedestrian bridge for joint and bearing detailing. The two simple spans are treated as one continuous deck unit with the center of movement at the intermediate pier; each end movement uses the adjacent span length.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" background="#F1F5FA">The concrete-only superstructure temperature range of FDOT SDG Table 2.7.1-1 (70 °F mean, 105 °F high, 35 °F low) and the LRFD 5.4.2.2 coefficient of thermal expansion give the unfactored joint and bearing detailing movement; the FDOT SDG 2.7.1.D factor of 1.20 gives the factored TU envelope.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" background="#F1F5FA">Outside this calculation: creep, shrinkage, skew resolution and the final expansion-joint or bearing capacity checks.</paragraph><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">Introduction</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" fontweight="bold" textdecoration="underline" spacingafter="4" id="paragraphrefreturn0028">PROJECT INFORMATION:</paragraph> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="12">This calculation determines longitudinal thermal movement of the two-span FIB 36 pedestrian bridge for joint and bearing detailing. The two simple spans are treated as one continuous deck unit with the center of movement at the intermediate pier. Geometry is referenced live from Bridge Geometry_2 Beam.</paragraph> <table name="MovementScopeBox" capture="False" colwidths="1:520">
                <stylerule range="A1:A4" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);"/>
                <stylerule range="A1" background="#DCE7F3" fontweight="bold"/>
                <row>
                    <textcell name="MovementScopeTitle" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" fontweight="bold" spacingafter="7">MOVEMENT MODEL</paragraph> </textcell> </row>
                <row>
                    <textcell name="MovementScope1" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7"> • Concrete-only superstructure temperature range is taken from FDOT SDG Table 2.7.1-1. </paragraph> </textcell> </row>
                <row>
                    <textcell name="MovementScope2" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7">• Center of movement is assumed at the intermediate pier; each end movement therefore uses the adjacent span length.</paragraph> </textcell> </row>
                <row>
                    <textcell name="MovementScope3" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7">• This module calculates thermal movement only. Creep, shrinkage, skew resolution, and final expansion-joint or bearing capacity checks are separate design items.</paragraph> </textcell> </row>
            </table>
  <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" id="paragraphrefreturn0029">1. Design basis and assumptions</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" level="1" spacingafter="7"> • FDOT SDG 2.7.1: Concrete Only temperature range = 70°F mean, 105°F high, 35°F low. </paragraph> <paragraph fontfamily="Times New Roman" fontsize="11" level="1" spacingafter="7"> • FDOT SDG 6.3: Calculate bridge movement about an assumed 70°F construction mean and base joint/bearing design on the SDG Table 2.7.1-1 temperature range. </paragraph> <paragraph fontfamily="Times New Roman" fontsize="11" level="1" spacingafter="7"> • FDOT SDG 2.7.1.D: Temperature rise and fall load effects use 120% of the tabulated maximum temperature change in accordance with LRFD Table 3.4.1-1. </paragraph> <paragraph id="paragraphc003factorrefs" fontfamily="Times New Roman" fontsize="10" spacingafter="7"> Related factor provisions: LRFD Table 3.4.1-6 and LRFD C3.4.1. See the packet’s QC qualification on the unfactored joint/bearing label. </paragraph> <paragraph fontfamily="Times New Roman" fontsize="11" level="1" spacingafter="12"> • LRFD 5.4.2.2: Normal-weight concrete coefficient of thermal expansion is taken as 6.0×10⁻⁶ /°F. </paragraph> <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True">2.1 Bridge geometry</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="L_left = BridgeGeometry_2Beam.Span_1 to ft" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>L_left = BridgeGeometry_2Beam.Span_1 to ft</expbody><expresult> = 107.350 ft</expresult></dynexp><break type="tab"/>shared value — BridgeGeometry_2Beam.Span_1; Movement length from the intermediate pier to Begin Bridge (Span 1)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="L_right = BridgeGeometry_2Beam.Span_2 to ft" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>L_right = BridgeGeometry_2Beam.Span_2 to ft</expbody><expresult> = 104.900 ft</expresult></dynexp><break type="tab"/>shared value — BridgeGeometry_2Beam.Span_2; Movement length from the intermediate pier to End Bridge (Span 2)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="L_unit = L_left + L_right to ft" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>L_unit = L_left + L_right to ft</expbody><expresult> = 212.250 ft</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Total continuous deck-unit length.</paragraph><paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True" id="paragraphrefreturn0030">2.2 Temperature parameters</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="T_mean = 70" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>T_mean = 70</expbody><expresult> = 70.000</expresult></dynexp><break type="tab"/>Mean construction temperature (°F)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="T_high = 105" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>T_high = 105</expbody><expresult> = 105.000</expresult></dynexp><break type="tab"/>High design temperature, concrete-only superstructure (°F)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="T_low = 35" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>T_low = 35</expbody><expresult> = 35.000</expresult></dynexp><break type="tab"/>Low design temperature, concrete-only superstructure (°F)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="γ_TU = 1.2" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>γ_TU = 1.2</expbody><expresult> = 1.200</expresult></dynexp><break type="tab"/>Temperature load factor for the factored TU movement envelope</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="α_T = 6*10^-6" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>α_T = 6*10^-6</expbody><expresult> = 0.000</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Coefficient of thermal expansion, normal-weight concrete (per °F) (LRFD 5.4.2.2)</paragraph><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">3. Temperature change</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="ΔT_rise = T_high - T_mean" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>ΔT_rise = T_high - T_mean</expbody><expresult> = 35.000</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Temperature rise from the 70°F mean, °F.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="ΔT_fall = T_mean - T_low" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>ΔT_fall = T_mean - T_low</expbody><expresult> = 35.000</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Temperature fall from the 70°F mean, °F.</paragraph><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" id="paragraphrefreturn0031">4. Thermal movement</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" level="1" spacingafter="7">For uniform temperature change, longitudinal movement is calculated from δ = α·ΔT·L. Temperature rise moves each end away from the intermediate pier; temperature fall moves each end toward the pier. For an end joint referenced to the approach, these correspond respectively to joint closing and opening.</paragraph> <paragraph id="paragraphc003equationref" fontfamily="Times New Roman" fontsize="10" spacingafter="7"> Supplemental equation context: LRFD Eq. 3.12.2.3-1 gives the full high-to-low thermal movement range; C003 calculates excursions from the mean. </paragraph> <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True">4.1 Unfactored joint and bearing detailing movement</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Thermal movement δ = α·ΔT·L from the center of movement at the intermediate pier to each end of the bridge, for the concrete-only temperature range.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="δ_left = α_T*ΔT_rise*L_left to in" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>δ_left = α_T*ΔT_rise*L_left to in</expbody><expresult> = 0.271 in</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Thermal movement magnitude at Begin Bridge for a 35°F rise or fall.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="δ_right = α_T*ΔT_rise*L_right to in" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>δ_right = α_T*ΔT_rise*L_right to in</expbody><expresult> = 0.264 in</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Thermal movement magnitude at End Bridge for a 35°F rise or fall.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="δ_end_max = Max(δ_left, δ_right) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>δ_end_max = Max(δ_left, δ_right) to in</expbody><expresult> = 0.271 in</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Governing unfactored end movement for joint/bearing detailing.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="δ_end_to_end = δ_left + δ_right to in" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>δ_end_to_end = δ_left + δ_right to in</expbody><expresult> = 0.535 in</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Total relative thermal change between the two bridge ends.</paragraph><paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True" id="paragraphrefreturn0032">4.2 Factored TU movement envelope</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="δ_left_TU = γ_TU*δ_left to in" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>δ_left_TU = γ_TU*δ_left to in</expbody><expresult> = 0.325 in</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Factored TU movement magnitude at Begin Bridge. (SDG 6.3)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="δ_right_TU = γ_TU*δ_right to in" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>δ_right_TU = γ_TU*δ_right to in</expbody><expresult> = 0.317 in</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Factored TU movement magnitude at End Bridge.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="δ_end_max_TU = Max(δ_left_TU, δ_right_TU) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>δ_end_max_TU = Max(δ_left_TU, δ_right_TU) to in</expbody><expresult> = 0.325 in</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Governing factored TU end movement envelope.</paragraph><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">5. Result summary</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C" fontweight="bold" keepwithnext="True">Movement Summary</paragraph><embed spacingbefore="5" spacingafter="8"><table name="MovementSummary" capture="False" colwidths="1:180, 2:180, 3:180"><stylerule range="A1:C7" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/><stylerule range="A1:C1" horzalign="Center" vertalign="Center"/><stylerule range="B2:C7" horzalign="Center" vertalign="Center"/><row><textcell name="MovementSummaryR0C0" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Item</paragraph></textcell><textcell name="MovementSummaryR0C1" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Begin Bridge</paragraph></textcell><textcell name="MovementSummaryR0C2" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">End Bridge</paragraph></textcell></row><row><textcell name="MovementSummaryR1C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Movement length</paragraph></textcell><c formula="L_left to ft" capture="False" background="#EFF7F1"><num>107.350 ft</num></c><c formula="L_right to ft" capture="False" background="#EFF7F1"><num>104.900 ft</num></c></row><row><textcell name="MovementSummaryR2C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Unfactored temperature rise</paragraph></textcell><c formula="δ_left to in" capture="False" background="#EFF7F1"><num>0.271 in</num></c><c formula="δ_right to in" capture="False" background="#EFF7F1"><num>0.264 in</num></c></row><row><textcell name="MovementSummaryR3C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Unfactored temperature fall</paragraph></textcell><c formula="δ_left to in" capture="False" background="#EFF7F1"><num>0.271 in</num></c><c formula="δ_right to in" capture="False" background="#EFF7F1"><num>0.264 in</num></c></row><row><textcell name="MovementSummaryR4C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Factored TU rise/fall</paragraph></textcell><c formula="δ_left_TU to in" capture="False" background="#EFF7F1"><num>0.325 in</num></c><c formula="δ_right_TU to in" capture="False" background="#EFF7F1"><num>0.317 in</num></c></row><row><textcell name="MovementSummaryR5C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Direction for temperature rise</paragraph></textcell><textcell name="MovementSummaryR5C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">Toward Begin Bridge</paragraph></textcell><textcell name="MovementSummaryR5C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">Toward End Bridge</paragraph></textcell></row><row><textcell name="MovementSummaryR6C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Direction for temperature fall</paragraph></textcell><textcell name="MovementSummaryR6C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">Toward Pier</paragraph></textcell><textcell name="MovementSummaryR6C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">Toward Pier</paragraph></textcell></row></table></embed><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="12">No joint or bearing adequacy conclusion is made in this module because allowable movement depends on the selected joint/bearing system and, for expansion-joint design, the applicable creep, shrinkage, skew, and other movement components.</paragraph> <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">6. Checks</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="Status = &quot;✓ All Checks Pass&quot;" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>Status = "✓ All Checks Pass"</expbody><expresult> = ✓ All Checks Pass</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Overall status of the recomputed numerical checks.</paragraph></report>