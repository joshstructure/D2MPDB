<report name="C001WindLoadOnPedBridgeSuperstructure" title="C001 - Wind Load on Ped Bridge Superstructure" unit="in" pagesize="816,1056" margin="48,48,48,48" bordermargin="0,0,0,0" collapsemargins="False"><include target="Library.Geometry"/><stylerule type="AnyEquation" name="Required Input" texthighlight="#F7E6B9"/><embed spacingbefore="5" spacingafter="8"><table name="ProjectStamp" capture="False" colwidths="1:95, 2:165, 3:95, 4:165"><stylerule range="A1:D4" fontfamily="Times New Roman" fontsize="9" vertalign="Center" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#7189A6&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#7189A6&quot;);"/><row><textcell name="ProjectStampR0C0" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Firm</paragraph></textcell><textcell name="ProjectStampR0C1" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_Firm = ProjectInfo.Firm" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_Firm = ProjectInfo.Firm</expbody><expresult>Parsons Transportation Group Inc</expresult></dynexp></paragraph></textcell><textcell name="ProjectStampR0C2" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Project</paragraph></textcell><textcell name="ProjectStampR0C3" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_Project = ProjectInfo.Project" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_Project = ProjectInfo.Project</expbody><expresult>I-95 Capacity Improvements from South of SR 152 to South of SR 126</expresult></dynexp></paragraph></textcell></row><row><textcell name="ProjectStampR1C0" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Address</paragraph></textcell><textcell name="ProjectStampR1C1" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_Address = ProjectInfo.Address" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_Address = ProjectInfo.Address</expbody><expresult>1203 Governors Square Blvd, Suite 201, Tallahassee FL 32301</expresult></dynexp></paragraph></textcell><textcell name="ProjectStampR1C2" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Job no.</paragraph></textcell><textcell name="ProjectStampR1C3" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_JobNo = ProjectInfo.JobNo" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_JobNo = ProjectInfo.JobNo</expbody><expresult></expresult></dynexp></paragraph></textcell></row><row><textcell name="ProjectStampR2C0" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Designed by</paragraph></textcell><textcell name="ProjectStampR2C1" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_DesignedBy = ProjectInfo.DesignedBy" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_DesignedBy = ProjectInfo.DesignedBy</expbody><expresult>JAT</expresult></dynexp></paragraph></textcell><textcell name="ProjectStampR2C2" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Date</paragraph></textcell><textcell name="ProjectStampR2C3" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_DesignDate = ProjectInfo.DesignDate" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_DesignDate = ProjectInfo.DesignDate</expbody><expresult>10/17/2026</expresult></dynexp></paragraph></textcell></row><row><textcell name="ProjectStampR3C0" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Checked by</paragraph></textcell><textcell name="ProjectStampR3C1" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_CheckedBy = ProjectInfo.CheckedBy" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_CheckedBy = ProjectInfo.CheckedBy</expbody><expresult>MIK</expresult></dynexp></paragraph></textcell><textcell name="ProjectStampR3C2" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Date</paragraph></textcell><textcell name="ProjectStampR3C3" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_CheckDate = ProjectInfo.CheckDate" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_CheckDate = ProjectInfo.CheckDate</expbody><expresult></expresult></dynexp></paragraph></textcell></row></table></embed><paragraph fontfamily="Times New Roman" fontsize="16" spacingafter="2" fontweight="bold">D2 I-95 PEDESTRIAN BRIDGE</paragraph><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold">C001 - Wind Load on Ped Bridge Superstructure</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Design basis: AASHTO LRFD Bridge Design Specifications, 10th edition (2024); AASHTO LRFD Guide Specifications for the Design of Pedestrian Bridges; FDOT Structures Manual January 2026 (SDG Volume 1, SDM Volume 2)</paragraph><section name="WorkingNotes" capture="False" hide="true"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="4" fontweight="bold" textcolor="#43505C">Working notes (hidden; not part of the submitted calculation): how this edition was produced, its tool status and the open bookkeeping items.</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" textcolor="#43505C">Journal edition written by calc_common/bpad.py (wind_superstructure) from the notebook case 53e431373c8a. Every definition was evaluated independently and compared with the notebook to 1 part in 10⁹; the inputs the journal owns are live references, compared with the case by the coherence gate before the build.</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" textcolor="#43505C">The calculation was ported from the journal module C001WindLoadOnPedBridgeSuperstructure (journal feb1bb316d08); every definition of the module was evaluated independently from the journal file and reproduced by the notebook to 1 part in 10⁹ before this edition was written.</paragraph><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5" textcolor="#43505C">A ✓ status covers only the recomputed numerical checks; it is not design acceptance. The equation notes of the calculation are in its report.</paragraph></section><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Inputs are highlighted amber; results are the green tables.</paragraph><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">Overview</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" background="#F1F5FA">Design wind pressures on the concrete superstructure per LRFD 3.8.1.2.1 with the FDOT SDG 2.4.1 wind speed (130 mph, Duval County), ground surface roughness category C and gust factor 0.85, for Strength III, Strength V and Service I. K_Z follows the logarithmic profile at the common fence-crown exposure height; Strength V and Service I use K_Z = 1.0.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" background="#F1F5FA">The Strength III pressure times the exposed superstructure depth gives the transverse and longitudinal line loads for the selected skew angle (LRFD Table 3.8.1.2.3a-1), the bearing share of the repair-frame wind, and, with the prescribed 0.020 ksf vertical pressure of LRFD 3.8.2, the upward line load and windward eccentricity that the uplift calculation (C004) combines with gravity. The fence wind is calculated separately in C002.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" background="#F1F5FA">Outside this calculation: the fence wind (C002), the bearing reactions and uplift checks (C004) and the direct wind on the pier (C002).</paragraph><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">1. Inputs</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" background="#FFF8E9" fontweight="bold">GEOMETRY BASIS — Cap and wind datums derive from the selected Type F pad, 6-in pedestal and 36-in cap. Individual seat grades, separate plates, the retained wind envelope, terrain reference and gross pier-face width require final-detail confirmation.</paragraph> <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True" id="paragraphrefreturn0004">1.1 Bridge geometry</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="z_clear = BridgeGeometry_2Beam.Wind_clearHeight to in" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>z_clear = BridgeGeometry_2Beam.Wind_clearHeight to in</expbody><expresult> = 227.478 in</expresult></dynexp><break type="tab"/>shared value — BridgeGeometry_2Beam.Wind_clearHeight; Vertical distance from low ground to the bottom of the concrete superstructure</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Z = BridgeGeometry_2Beam.Wind_exposureHeight to in" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>Z = BridgeGeometry_2Beam.Wind_exposureHeight to in</expbody><expresult> = 428.790 in</expresult></dynexp><break type="tab"/>shared value — BridgeGeometry_2Beam.Wind_exposureHeight; Height of the fence crown above low ground (common wind exposure height)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="d_super = BridgeGeometry_2Beam.Depth_SuperStr to in" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>d_super = BridgeGeometry_2Beam.Depth_SuperStr to in</expbody><expresult> = 85.000 in</expresult></dynexp><break type="tab"/>shared value — BridgeGeometry_2Beam.Depth_SuperStr; Depth of concrete superstructure exposed to horizontal wind</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Span_1 = BridgeGeometry_2Beam.Span_1 to ft" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>Span_1 = BridgeGeometry_2Beam.Span_1 to ft</expbody><expresult> = 107.350 ft</expresult></dynexp><break type="tab"/>shared value — BridgeGeometry_2Beam.Span_1; Span 1 length</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Span_2 = BridgeGeometry_2Beam.Span_2 to ft" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>Span_2 = BridgeGeometry_2Beam.Span_2 to ft</expbody><expresult> = 104.900 ft</expresult></dynexp><break type="tab"/>shared value — BridgeGeometry_2Beam.Span_2; Span 2 length</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="w_deck = BridgeGeometry_2Beam.Deck_out2out to in" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>w_deck = BridgeGeometry_2Beam.Deck_out2out to in</expbody><expresult> = 163.000 in</expresult></dynexp><break type="tab"/>shared value — BridgeGeometry_2Beam.Deck_out2out; Outside-to-outside deck width</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Skew_deg_str = &quot;0&quot;" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>Skew_deg_str = "0"</expbody><expresult> = 0</expresult></dynexp><break type="tab"/>Skew angle of wind attack from perpendicular (degrees, LRFD Table 3.8.1.2.3a-1 column)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Beam_count = BridgeGeometry_2Beam.Beam_count" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>Beam_count = BridgeGeometry_2Beam.Beam_count</expbody><expresult> = 2.000</expresult></dynexp><break type="tab"/>shared value — BridgeGeometry_2Beam.Beam_count; Number of beams</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="Z_calc = Max(Z, 33 ft) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>Z_calc = Max(Z, 33 ft) to in</expbody><expresult> = 428.790 in</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Height actually inserted into the exposure equations. (LRFD 3.8.1.2.1)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="L_span = Max(Span_1, Span_2) to ft" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>L_span = Max(Span_1, Span_2) to ft</expbody><expresult> = 107.350 ft</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Longer of the two individual bridge spans. (LRFD 3.8.1.2.3a)</paragraph><paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True" id="paragraphrefreturn0005">1.2 Wind speed and exposure</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="V_III = 130" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>V_III = 130</expbody><expresult> = 130.000</expresult></dynexp><break type="tab"/>Design 3-second gust wind speed, Strength III (mph)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="V_V = 80" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>V_V = 80</expbody><expresult> = 80.000</expresult></dynexp><break type="tab"/>Design gust wind speed, Strength V (mph)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="V_SI = 70" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>V_SI = 70</expbody><expresult> = 70.000</expresult></dynexp><break type="tab"/>Design gust wind speed, Service I (mph)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Exp_Cat = &quot;C&quot;" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>Exp_Cat = "C"</expbody><expresult> = C</expresult></dynexp><break type="tab"/>Wind exposure category (C unless D applies)</paragraph><paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True" id="paragraphrefreturn0006">1.3 Structure type and coefficients</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" level="1" spacingafter="4"> Structure type for drag coefficient selection (LRFD Table 3.8.1.2.1-2) </paragraph> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Struct_Type = &quot;I-Girder or Box-Girder Superstructure&quot;" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>Struct_Type = "I-Girder or Box-Girder Superstructure"</expbody><expresult> = I-Girder or Box-Girder Superstructure</expresult></dynexp><break type="tab"/>Structure type for the drag coefficient (LRFD Table 3.8.1.2.1-2)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="G_fac = 0.85" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>G_fac = 0.85</expbody><expresult> = 0.850</expresult></dynexp><break type="tab"/>Gust-effect factor</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="C_D = If(Struct_Type==&quot;I-Girder or Box-Girder Superstructure&quot;, 1.3, If(Struct_Type==&quot;Bridge Substructure&quot;, 1.6, If(Struct_Type==&quot;Truss/Column/Arch - Sharp-Edged&quot;, 2, If(Struct_Type==&quot;Truss/Column/Arch - Round&quot;, 1, 1.2))))" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>C_D = If(Struct_Type=="I-Girder or Box-Girder Superstructure", 1.3, If(Struct_Type=="Bridge Substructure", 1.6, If(Struct_Type=="Truss/Column/Arch - Sharp-Edged", 2, If(Struct_Type=="Truss/Column/Arch - Round", 1, 1.2))))</expbody><expresult> = 1.300</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Shape-dependent wind drag multiplier selected from the structure type. (LRFD Table 3.8.1.2.1-2)</paragraph><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" id="paragraphrefreturn0007">2. Wind speed by load combination (LRFD 3.8.1.1.2)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" level="1" spacingafter="8"> Per LRFD Table 3.8.1.1.2-1, the design 3-second gust wind speed for each load combination is as follows: </paragraph> <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C" fontweight="bold" keepwithnext="True">Design Wind Speed by Load Combination</paragraph><embed spacingbefore="5" spacingafter="8"><table name="WindSpeedTable" capture="False" colwidths="1:270, 2:270"><stylerule range="A1:B4" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/><stylerule range="A1:B1" horzalign="Center" vertalign="Center"/><stylerule range="B2:B4" horzalign="Center" vertalign="Center"/><row><textcell name="WindSpeedTableR0C0" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Load Combination</paragraph></textcell><textcell name="WindSpeedTableR0C1" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Design 3-Second Gust Wind Speed, V (mph)</paragraph></textcell></row><row><textcell name="WindSpeedTableR1C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Strength III</paragraph></textcell><c formula="V_III" capture="False" background="#EFF7F1"><num>130.000</num></c></row><row><textcell name="WindSpeedTableR2C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Strength V</paragraph></textcell><c formula="V_V" capture="False" background="#EFF7F1"><num>80.000</num></c></row><row><textcell name="WindSpeedTableR3C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Service I</paragraph></textcell><c formula="V_SI" capture="False" background="#EFF7F1"><num>70.000</num></c></row></table></embed><paragraph fontfamily="Times New Roman" fontsize="11" level="1" spacingafter="12"> Reference: LRFD Table 3.8.1.1.2-1 </paragraph> <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" id="paragraphrefreturn0008">3. Pressure exposure and elevation coefficient K_Z (LRFD 3.8.1.2.1)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" level="1" spacingafter="8"> K_Z is determined for Strength III using logarithmic wind profile equations in the active pier load sets. For Strength V and Service I, K_Z = 1.0. The structure height Z used shall not be taken less than 33.0 ft (LRFD Art. 3.8.1.2.1). </paragraph> <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True" id="paragraphrefreturn0009">3.1 K_Z for exposure category B (LRFD Eq. 3.8.1.2.1-2)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="K_Z_B = (2.5*Ln(Z_calc/(0.9834 ft)) + 6.87)^2/345.6" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>K_Z_B = (2.5*Ln(Z_calc/(0.9834 ft)) + 6.87)^2/345.6</expbody><expresult> = 0.727</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Pressure multiplier for height and Exposure Category B. (LRFD Eq. 3.8.1.2.1-2)</paragraph><paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True" id="paragraphrefreturn0010">3.2 K_Z for exposure category C (LRFD Eq. 3.8.1.2.1-3)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="K_Z_C = (2.5*Ln(Z_calc/(0.0984 ft)) + 7.35)^2/478.4" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>K_Z_C = (2.5*Ln(Z_calc/(0.0984 ft)) + 7.35)^2/478.4</expbody><expresult> = 1.020</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Pressure multiplier for height and Exposure Category C. (LRFD Eq. 3.8.1.2.1-3)</paragraph><paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True" id="paragraphrefreturn0011">3.3 K_Z for exposure category D (LRFD Eq. 3.8.1.2.1-4)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="K_Z_D = (2.5*Ln(Z_calc/(0.0164 ft)) + 7.65)^2/616.1" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>K_Z_D = (2.5*Ln(Z_calc/(0.0164 ft)) + 7.65)^2/616.1</expbody><expresult> = 1.172</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Pressure multiplier for height and Exposure Category D. (LRFD Eq. 3.8.1.2.1-4)</paragraph><paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True" id="paragraphrefreturn0012">3.4 Governing K_Z, selected by exposure category</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="K_Z_gov = If(Exp_Cat==&quot;D&quot;, K_Z_D, K_Z_C)" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>K_Z_gov = If(Exp_Cat=="D", K_Z_D, K_Z_C)</expbody><expresult> = 1.020</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Exposure multiplier selected by this module’s actual category switch. (LRFD 3.8.1.2.1)</paragraph><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" id="paragraphrefreturn0013">4. Design wind pressure on structures, WS (LRFD 3.8.1.2.1)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" level="1" spacingafter="8"> The wind pressure is determined by LRFD Eq. 3.8.1.2.1-1: </paragraph> <paragraph fontfamily="Times New Roman" fontsize="11" level="1" spacingafter="4"> P_Z = 2.56 × 10⁻⁶ × V² × K_Z × G × C_D (LRFD Eq. 3.8.1.2.1-1) </paragraph> <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True" id="paragraphrefreturn0014">4.1 Strength III wind pressure</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="P_Z_III = 0.00000256*V_III^2*K_Z_gov*G_fac*C_D*1 ksf to ksf" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>P_Z_III = 0.00000256*V_III^2*K_Z_gov*G_fac*C_D*1 ksf to ksf</expbody><expresult> = 0.049 ksf</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength III horizontal wind pressure on the selected structure type. (LRFD Eq. 3.8.1.2.1-1)</paragraph><paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True" id="paragraphrefreturn0015">4.2 Strength V wind pressure</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" level="1" spacingafter="8"> For Service I and Strength V, K_Z = 1.0 (LRFD 3.8.1.2.1) and G = 0.85 (FDOT SDG 2.4.1.C). </paragraph> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="P_Z_V = 0.00000256*V_V^2*1*G_fac*C_D*1 ksf to ksf" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>P_Z_V = 0.00000256*V_V^2*1*G_fac*C_D*1 ksf to ksf</expbody><expresult> = 0.018 ksf</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength V horizontal wind pressure on the selected structure type. (LRFD 3.8.1.2.1; SDG 2.4.1.C)</paragraph><paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True" id="paragraphrefreturn0016">4.3 Service I wind pressure</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" level="1" spacingafter="8"> For Service I and Strength V, K_Z = 1.0 (LRFD 3.8.1.2.1) and G = 0.85 (FDOT SDG 2.4.1.C). </paragraph> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="P_Z_SI = 0.00000256*V_SI^2*1*G_fac*C_D*1 ksf to ksf" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>P_Z_SI = 0.00000256*V_SI^2*1*G_fac*C_D*1 ksf to ksf</expbody><expresult> = 0.014 ksf</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Service I horizontal wind pressure on the selected structure type. (LRFD 3.8.1.2.1; SDG 2.4.1.C)</paragraph><paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True" id="paragraphrefreturn0017">4.4 Service IV applicability (not used)</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="8" leftindent="0" background="#F1F5FA">Service IV is not used in the current nonprestressed pier / steel-pile load set. No Service IV pressure, uplift, or FBMP entry case is produced. Strength III deck uplift remains included.</paragraph> <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" id="paragraphrefreturn0018">5. Wind loads on the superstructure (LRFD 3.8.1.2.2 and 3.8.1.2.3a)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" level="1" spacingafter="8"> For girder bridges, wind load components on the substructure are determined as the product of skew coefficients (LRFD Table 3.8.1.2.3a-1), the wind pressure from Eq. 3.8.1.2.1-1, and the depth of the bridge as seen in elevation perpendicular to the longitudinal axis. Both transverse and longitudinal components are applied simultaneously at mid-depth of the superstructure (LRFD Art. 3.8.1.2.3a). </paragraph> <paragraph fontfamily="Times New Roman" fontsize="11" level="1" spacingafter="8"> For usual girder and slab bridges with individual span length not more than 150 ft and maximum height not more than 33.0 ft above low ground or water level, simplified wind load components may be used per LRFD Art. 3.8.1.2.3a: Transverse = 100% of perpendicular load; Longitudinal = 25% of transverse load. </paragraph> <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True" id="paragraphrefreturn0019">5.1 Skew coefficients, girders (LRFD Table 3.8.1.2.3a-1)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" level="1" spacingafter="4"> Transverse skew coefficient for girders — from LRFD Table 3.8.1.2.3a-1 based on selected skew angle: </paragraph> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="C_T_gir = If(Skew_deg_str==&quot;0&quot;, 1, If(Skew_deg_str==&quot;15&quot;, 0.88, If(Skew_deg_str==&quot;30&quot;, 0.82, If(Skew_deg_str==&quot;45&quot;, 0.66, 0.34))))" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>C_T_gir = If(Skew_deg_str=="0", 1, If(Skew_deg_str=="15", 0.88, If(Skew_deg_str=="30", 0.82, If(Skew_deg_str=="45", 0.66, 0.34))))</expbody><expresult> = 1.000</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Girder wind-angle multiplier for the force component across the bridge. (LRFD Table 3.8.1.2.3a-1)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="C_L_gir = If(Skew_deg_str==&quot;0&quot;, 0, If(Skew_deg_str==&quot;15&quot;, 0.12, If(Skew_deg_str==&quot;30&quot;, 0.24, If(Skew_deg_str==&quot;45&quot;, 0.32, 0.38))))" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>C_L_gir = If(Skew_deg_str=="0", 0, If(Skew_deg_str=="15", 0.12, If(Skew_deg_str=="30", 0.24, If(Skew_deg_str=="45", 0.32, 0.38))))</expbody><expresult> = 0.000</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Girder wind-angle multiplier for the force component along the bridge. (LRFD Table 3.8.1.2.3a-1)</paragraph><paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True" id="paragraphrefreturn0020">5.2 Strength III superstructure wind line loads</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="w_T_III = P_Z_III*C_T_gir*d_super to kip/ft" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>w_T_III = P_Z_III*C_T_gir*d_super to kip/ft</expbody><expresult> = 0.345 kip/ft</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength III wind force across the bridge for each foot of bridge length. (LRFD 3.8.1.2.3a)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="w_L_III = P_Z_III*C_L_gir*d_super to kip/ft" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>w_L_III = P_Z_III*C_L_gir*d_super to kip/ft</expbody><expresult> = 0.000 kip/ft</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength III wind force along the bridge for each foot of bridge length. (LRFD 3.8.1.2.3a)</paragraph><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">6. Summary of wind load results</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C" fontweight="bold" keepwithnext="True">Wind Load Summary</paragraph><embed spacingbefore="5" spacingafter="8"><table name="WindSummaryTable" capture="False" colwidths="1:270, 2:270"><stylerule range="A1:B5" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/><stylerule range="A1:B1" horzalign="Center" vertalign="Center"/><stylerule range="B2:B5" horzalign="Center" vertalign="Center"/><row><textcell name="WindSummaryTableR0C0" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Wind Load Parameter</paragraph></textcell><textcell name="WindSummaryTableR0C1" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Strength III</paragraph></textcell></row><row><textcell name="WindSummaryTableR1C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Design Wind Speed V (mph)</paragraph></textcell><c formula="V_III" capture="False" background="#EFF7F1"><num>130.000</num></c></row><row><textcell name="WindSummaryTableR2C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">K_Z (Strength III uses K_Z_gov; other retained speeds use 1.0)</paragraph></textcell><c formula="K_Z_gov" capture="False" background="#EFF7F1"><num>1.020</num></c></row><row><textcell name="WindSummaryTableR3C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">P_Z — Design Wind Pressure (ksf) [Eq. 3.8.1.2.1-1]</paragraph></textcell><c formula="P_Z_III to ksf" capture="False" background="#EFF7F1"><num>0.049 ksf</num></c></row><row><textcell name="WindSummaryTableR4C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Transverse Wind Line Load on Superstructure (klf)</paragraph></textcell><c formula="w_T_III to kip/ft" capture="False" background="#EFF7F1"><num>0.345 kip/ft</num></c></row></table></embed><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">7. Wind applied to the repair frame</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="W_Frame = w_T_III*L_span/2/Beam_count to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>W_Frame = w_T_III*L_span/2/Beam_count to kip</expbody><expresult> = 9.267 kip</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Wind force allocated to one bearing in the repair-frame load split.</paragraph><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" id="headingC001WindLoadOnPedBridgeSuperstructure8">8. Vertical wind and perpendicular companion loads (LRFD 3.8.2)</paragraph><table name="C001VerticalScope" capture="False" colwidths="1:520">
                <stylerule range="A1:A3" fontfamily="Times New Roman" fontsize="10" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#7189A6&quot;); Border(&quot;BetweenColumns&quot;, &quot;Solid&quot;, 0.4, &quot;#7189A6&quot;);"/>
