    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_V_bw = V_u_bw/V_r_bw" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_V_bw = V_u_bw/V_r_bw</expbody>
        <expresult> = 0.213</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">backwall shear</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_Vi_bw = V_u_bw/V_ri_bw" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_Vi_bw = V_u_bw/V_ri_bw</expbody>
        <expresult> = 0.173</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">backwall interface shear (SDG 1.15)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_Avf = A_vfmin_bw/A_vf_bw" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_Avf = A_vfmin_bw/A_vf_bw</expbody>
        <expresult> = 0.279</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum interface steel</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_ts_v = Max(A_ts_bw/Min(A_pr_FF, A_pr_SF), Max(s_FF, s_SF)/s_ts_bw)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_ts_v = Max(A_ts_bw/Min(A_pr_FF, A_pr_SF), Max(s_FF, s_SF)/s_ts_bw)</expbody>
        <expresult> = 0.667</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">backwall S&amp;T, vertical</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_ts_h = Max(A_ts_bw/A_pr_HZ, s_HZ/s_ts_bw)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_ts_h = Max(A_ts_bw/A_pr_HZ, s_HZ/s_ts_bw)</expbody>
        <expresult> = 0.667</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">backwall S&amp;T, horizontal</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_V_ck = V_u_CK/V_r_CK" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_V_ck = V_u_CK/V_r_CK</expbody>
        <expresult> = 0.033</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cheek wall shear</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_Vi_ck = V_u_CK/V_ri_ck" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_Vi_ck = V_u_CK/V_ri_ck</expbody>
        <expresult> = 0.024</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cheek wall interface shear</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_ts_ck = Max(A_ts_ck/Min(A_pr_CK, A_pr_CKH), Max(s_CK, s_CKH)/s_ts_ck)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_ts_ck = Max(A_ts_ck/Min(A_pr_CK, A_pr_CKH), Max(s_CK, s_CKH)/s_ts_ck)</expbody>
        <expresult> = 0.917</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cheek wall S&amp;T</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_cov = Max((3 in)/cv_bw, If(single_ck == 1, cv_ck, 2 in)/If(single_ck == 1, (t_ck - Db(bar_CK) - Db(bar_CKH))/2, cv_ck))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_cov = Max((3 in)/cv_bw, If(single_ck == 1, cv_ck, 2 in)/If(single_ck == 1, (t_ck - Db(bar_CK) - Db(bar_CKH))/2, cv_ck))</expbody>
        <expresult> = 1.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cover, 3 in backwall and specified cheek requirement (legacy minimum 2 in)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_thk = Max((12 in)/t_bw, (8 in)/t_ck)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_thk = Max((12 in)/t_bw, (8 in)/t_ck)</expbody>
        <expresult> = 1.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">thickness, SDM 12.6.B</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_strap = z_strap/H_bw_edge" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_strap = z_strap/H_bw_edge</expbody>
        <expresult> = 0.387</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strap within the backwall height</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_T = T_u/T_lim" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_T = T_u/T_lim</expbody>
        <expresult> = 0.634</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cap torsion screen</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_strips = Max(DC_flex_FF, DC_flex_SF, DC_flex_CK, DC_min_FF, DC_min_SF, DC_min_CK, DC_eps_FF, DC_eps_SF, DC_eps_CK, DC_crk_FF, DC_crk_SF, DC_crk_CK, DC_sp_FF, DC_sp_SF, DC_sp_CK)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_strips = Max(DC_flex_FF, DC_flex_SF, DC_flex_CK, DC_min_FF, DC_min_SF, DC_min_CK, DC_eps_FF, DC_eps_SF, DC_eps_CK, DC_crk_FF, DC_crk_SF, DC_crk_CK, DC_sp_FF, DC_sp_SF, DC_sp_CK)</expbody>
        <expresult> = 0.833</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">largest strip ratio</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_joints = Max(DC_V_bw, DC_Vi_bw, DC_Avf, DC_ts_v, DC_ts_h, DC_V_ck, DC_Vi_ck, DC_ts_ck)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_joints = Max(DC_V_bw, DC_Vi_bw, DC_Avf, DC_ts_v, DC_ts_h, DC_V_ck, DC_Vi_ck, DC_ts_ck)</expbody>
        <expresult> = 0.917</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">largest joint and S&amp;T ratio</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_max = Max(DC_strips, DC_joints, DC_cov, DC_thk, DC_strap, DC_T)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_max = Max(DC_strips, DC_joints, DC_cov, DC_thk, DC_strap, DC_T)</expbody>
        <expresult> = 1.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">largest ratio</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Status = If(DC_max &lt;= 1, &quot;✓ All Checks Pass&quot;, &quot;⊗ There are FAILURES&quot;)" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False">
        <expbody>Status = If(DC_max &lt;= 1, "✓ All Checks Pass", "⊗ There are FAILURES")</expbody>
        <expresult>✓ All Checks Pass</expresult>
      </dynexp>
    </paragraph>
