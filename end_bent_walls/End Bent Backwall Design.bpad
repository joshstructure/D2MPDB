      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="γ_bw_STRIV = If(x_bw &gt; 0 in, γ_DCmax_STRIV, γ_DCmin_STRIV)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>γ_bw_STRIV = If(x_bw &gt; 0 in, γ_DCmax_STRIV, γ_DCmin_STRIV)</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="γ_PLb_STRIV = If(x_brg &gt; 0 in, γ_PL_STRIV, 0*γ_PL_STRIV)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>γ_PLb_STRIV = If(x_brg &gt; 0 in, γ_PL_STRIV, 0*γ_PL_STRIV)</expbody>
        </dynexp>
      </paragraph>
    </section>
