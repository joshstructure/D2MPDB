        <expbody>V_r_FF = φ_v*V_n_FF to kip</expbody>
        <expresult> = 13.830 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored shear resistance</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Backwall span face (SF) and cheek wall (CK): the same equations, collapsed.</paragraph>
    <section name="Rest_Members_6" capture="False" hide="true">
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="A_b_SF = Ab(n_b_SF) to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>A_b_SF = Ab(n_b_SF) to in^2</expbody>
          <expresult> = 0.310 in^2</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="d_b_SF = Db(n_b_SF) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>d_b_SF = Db(n_b_SF) to in</expbody>
          <expresult> = 0.625 in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="d_SF = h_w_SF - c_v_SF - d_b_SF/2 to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>d_SF = h_w_SF - c_v_SF - d_b_SF/2 to in</expbody>
          <expresult> = 8.688 in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="A_s_SF = A_b_SF*b_s/s_w_SF to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>A_s_SF = A_b_SF*b_s/s_w_SF to in^2</expbody>
          <expresult> = 0.310 in^2</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="a_SF = A_s_SF*fy/(0.85*fc*b_s) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>a_SF = A_s_SF*fy/(0.85*fc*b_s) to in</expbody>
          <expresult> = 0.332 in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="c_SF = a_SF/β_1 to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>c_SF = a_SF/β_1 to in</expbody>
          <expresult> = 0.428 in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="ε_t_SF = 0.003*(d_SF - c_SF)/c_SF" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>ε_t_SF = 0.003*(d_SF - c_SF)/c_SF</expbody>
          <expresult> = 0.058</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="φ_SF = If(ε_t_SF &gt;= 0.005, φ_f, If(ε_t_SF &lt;= 0.002, 0.75, 0.75 + 0.15*(ε_t_SF - 0.002)/0.003))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>φ_SF = If(ε_t_SF &gt;= 0.005, φ_f, If(ε_t_SF &lt;= 0.002, 0.75, 0.75 + 0.15*(ε_t_SF - 0.002)/0.003))</expbody>
          <expresult> = 0.900</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="M_n_SF = A_s_SF*fy*(d_SF - a_SF/2) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>M_n_SF = A_s_SF*fy*(d_SF - a_SF/2) to kip*ft</expbody>
          <expresult> = 13.209 kip*ft</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="M_r_SF = φ_SF*M_n_SF to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>M_r_SF = φ_SF*M_n_SF to kip*ft</expbody>
          <expresult> = 11.888 kip*ft</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="A_req_SF = 0.85*fc*b_s*d_SF/fy*(1 - Sqrt(Max(1 - 2*M_u_SF/(0.85*φ_f*fc*b_s*d_SF^2), 0))) to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>A_req_SF = 0.85*fc*b_s*d_SF/fy*(1 - Sqrt(Max(1 - 2*M_u_SF/(0.85*φ_f*fc*b_s*d_SF^2), 0))) to in^2</expbody>
          <expresult> = 0.111 in^2</expresult>
