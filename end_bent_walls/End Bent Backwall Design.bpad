    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="T_u = Max(T_A_0_STRI, T_A_0_STRIII1, T_A_0_STRIII2, T_A_0_STRIV, T_A_1_STRI, T_A_1_STRIII1, T_A_1_STRIII2, T_A_1_STRIV, T_A_2_STRI, T_A_2_STRIII1, T_A_2_STRIII2, T_A_2_STRIV, T_A_3_STRI, T_A_3_STRIII1, T_A_3_STRIII2, T_A_3_STRIV, T_A_4_STRI, T_A_4_STRIII1, T_A_4_STRIII2, T_A_4_STRIV, T_A_5_STRI, T_A_5_STRIII1, T_A_5_STRIII2, T_A_5_STRIV, T_A_6_STRI, T_A_6_STRIII1, T_A_6_STRIII2, T_A_6_STRIV, T_A_7_STRI, T_A_7_STRIII1, T_A_7_STRIII2, T_A_7_STRIV, T_B_0_STRI, T_B_0_STRIII1, T_B_0_STRIII2, T_B_0_STRIV, T_B_1_STRI, T_B_1_STRIII1, T_B_1_STRIII2, T_B_1_STRIV, T_B_2_STRI, T_B_2_STRIII1, T_B_2_STRIII2, T_B_2_STRIV, T_B_3_STRI, T_B_3_STRIII1, T_B_3_STRIII2, T_B_3_STRIV, T_B_4_STRI, T_B_4_STRIII1, T_B_4_STRIII2, T_B_4_STRIV, T_B_5_STRI, T_B_5_STRIII1, T_B_5_STRIII2, T_B_5_STRIV, T_B_6_STRI, T_B_6_STRIII1, T_B_6_STRIII2, T_B_6_STRIV, T_B_7_STRI, T_B_7_STRIII1, T_B_7_STRIII2, T_B_7_STRIV) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>T_u = Max(T_A_0_STRI, T_A_0_STRIII1, T_A_0_STRIII2, T_A_0_STRIV, T_A_1_STRI, T_A_1_STRIII1, T_A_1_STRIII2, T_A_1_STRIV, T_A_2_STRI, T_A_2_STRIII1, T_A_2_STRIII2, T_A_2_STRIV, T_A_3_STRI, T_A_3_STRIII1, T_A_3_STRIII2, T_A_3_STRIV, T_A_4_STRI, T_A_4_STRIII1, T_A_4_STRIII2, T_A_4_STRIV, T_A_5_STRI, T_A_5_STRIII1, T_A_5_STRIII2, T_A_5_STRIV, T_A_6_STRI, T_A_6_STRIII1, T_A_6_STRIII2, T_A_6_STRIV, T_A_7_STRI, T_A_7_STRIII1, T_A_7_STRIII2, T_A_7_STRIV, T_B_0_STRI, T_B_0_STRIII1, T_B_0_STRIII2, T_B_0_STRIV, T_B_1_STRI, T_B_1_STRIII1, T_B_1_STRIII2, T_B_1_STRIV, T_B_2_STRI, T_B_2_STRIII1, T_B_2_STRIII2, T_B_2_STRIV, T_B_3_STRI, T_B_3_STRIII1, T_B_3_STRIII2, T_B_3_STRIV, T_B_4_STRI, T_B_4_STRIII1, T_B_4_STRIII2, T_B_4_STRIV, T_B_5_STRI, T_B_5_STRIII1, T_B_5_STRIII2, T_B_5_STRIV, T_B_6_STRI, T_B_6_STRIII1, T_B_6_STRIII2, T_B_6_STRIV, T_B_7_STRI, T_B_7_STRIII1, T_B_7_STRIII2, T_B_7_STRIV) to kip*ft</expbody>
        <expresult> = 51.443 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">largest factored torque, strength combinations</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" pagebreakbefore="break">12. Summary of checks</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6">Demand / capacity ratios; 1.0 or less passes. Members FF, SF and CK as in Section 9.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="s_max_FF = s_max_bw to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>s_max_FF = s_max_bw to in</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">maximum spacing for each strip</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_flex_FF = M_u_FF/M_r_FF" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_flex_FF = M_u_FF/M_r_FF</expbody>
        <expresult> = 0.108</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">flexure, Mu / φMn</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_min_FF = M_min_FF/M_r_FF" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_min_FF = M_min_FF/M_r_FF</expbody>
        <expresult> = 0.144</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum steel, min(Mcr, 1.33Mu) / φMn</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_eps_FF = 0.005/ε_t_FF" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_eps_FF = 0.005/ε_t_FF</expbody>
        <expresult> = 0.086</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">tension-controlled, 0.005 / εt</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_crk_FF = Max(f_ss_FF/f_ss_lim, If(f_ss_FF &gt; 0 ksi, s_w_FF/s_cr_FF, 0))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_crk_FF = Max(f_ss_FF/f_ss_lim, If(f_ss_FF &gt; 0 ksi, s_w_FF/s_cr_FF, 0))</expbody>
        <expresult> = 0.109</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">crack control, max(fss / 0.8fy, s / s_cr)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_sp_FF = s_w_FF/s_max_FF" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_sp_FF = s_w_FF/s_max_FF</expbody>
        <expresult> = 0.667</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">maximum bar spacing</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Backwall span face (SF) and cheek wall (CK): the same equations, collapsed.</paragraph>
    <section name="Rest_Members_10" capture="False" hide="true">
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="s_max_SF = s_max_bw to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>s_max_SF = s_max_bw to in</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
