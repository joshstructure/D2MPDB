    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_WV_SERI = If(FZ_W_SERI*x_brg &gt; 0 kip*in, FZ_W_SERI*x_brg, 0 kip*in) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_WV_SERI = If(FZ_W_SERI*x_brg &gt; 0 kip*in, FZ_W_SERI*x_brg, 0 kip*in) to kip*ft</expbody>
        <expresult> = 0.000 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">vertical wind, overturning only</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="H_T_SERI = γ_EH_SERI*F_EH + γ_ES_SERI*F_ES + γ_LS_SERI*F_LS + γ_TU_SERI*(F_TU + F_SH) + H_W_SERI to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>H_T_SERI = γ_EH_SERI*F_EH + γ_ES_SERI*F_ES + γ_LS_SERI*F_LS + γ_TU_SERI*(F_TU + F_SH) + H_W_SERI to kip</expbody>
        <expresult> = 44.952 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">horizontal force toward the span</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_H_SERI = γ_EH_SERI*F_EH*y_EH + γ_ES_SERI*F_ES*y_ES + γ_LS_SERI*F_LS*y_LS + (γ_TU_SERI*(F_TU + F_SH) + H_W_SERI)*y_brg to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_H_SERI = γ_EH_SERI*F_EH*y_EH + γ_ES_SERI*F_ES*y_ES + γ_LS_SERI*F_LS*y_LS + (γ_TU_SERI*(F_TU + F_SH) + H_W_SERI)*y_brg to kip*ft</expbody>
        <expresult> = 93.554 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">moment of the horizontal loads about O</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_Vb_SERI = γ_brg_SERI*W_DCb*x_brg + γ_PLb_SERI*W_PLb*x_brg + γ_ped_SERI*W_ped*x_ped to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_Vb_SERI = γ_brg_SERI*W_DCb*x_brg + γ_PLb_SERI*W_PLb*x_brg + γ_ped_SERI*W_ped*x_ped to kip*ft</expbody>
        <expresult> = 122.034 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">superstructure and pedestals</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_Vs_SERI = γ_cap_SERI*W_cap*x_cap + γ_ck_SERI*W_ck*x_ck + γ_bw_SERI*W_bw*x_bw to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_Vs_SERI = γ_cap_SERI*W_cap*x_cap + γ_ck_SERI*W_ck*x_ck + γ_bw_SERI*W_bw*x_bw to kip*ft</expbody>
        <expresult> = -3.853 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cap, cheek walls and backwall</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_OT_SERI = M_H_SERI + M_Vb_SERI + M_Vs_SERI + M_WV_SERI to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_OT_SERI = M_H_SERI + M_Vb_SERI + M_Vs_SERI + M_WV_SERI to kip*ft</expbody>
        <expresult> = 211.736 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">overturning moment about O</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="e_res_SERI = M_OT_SERI/H_T_SERI to ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>e_res_SERI = M_OT_SERI/H_T_SERI to ft</expbody>
        <expresult> = 4.710 ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">resultant height above O</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_eq_SERI = M_OT_SERI/y_strap to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_eq_SERI = M_OT_SERI/y_strap to kip</expbody>
        <expresult> = 60.496 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strap force for moment equilibrium</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_str_SERI = Max(H_T_SERI, F_eq_SERI) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_str_SERI = Max(H_T_SERI, F_eq_SERI) to kip</expbody>
        <expresult> = 60.496 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">design strap force</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="f_str_SERI = F_str_SERI/L_bw to klf" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>f_str_SERI = F_str_SERI/L_bw to klf</expbody>
        <expresult> = 3.089 klf</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strap load per foot of backwall</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_pile_SERI = F_eq_SERI - H_T_SERI to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_pile_SERI = F_eq_SERI - H_T_SERI to kip</expbody>
        <expresult> = 15.544 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">pile-head force at O (+ toward span)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">The other four combinations (Strength I, Strength III wind 1, Strength III wind 2, Strength IV): the same equations, collapsed.</paragraph>
    <section name="Rest_Combos_3" capture="False" hide="true">
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="M_WV_STRI = If(FZ_W_STRI*x_brg &gt; 0 kip*in, FZ_W_STRI*x_brg, 0 kip*in) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>M_WV_STRI = If(FZ_W_STRI*x_brg &gt; 0 kip*in, FZ_W_STRI*x_brg, 0 kip*in) to kip*ft</expbody>
          <expresult> = 0.000 kip*ft</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="H_T_STRI = γ_EH_STRI*F_EH + γ_ES_STRI*F_ES + γ_LS_STRI*F_LS + γ_TU_STRI*(F_TU + F_SH) + H_W_STRI to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>H_T_STRI = γ_EH_STRI*F_EH + γ_ES_STRI*F_ES + γ_LS_STRI*F_LS + γ_TU_STRI*(F_TU + F_SH) + H_W_STRI to kip</expbody>
          <expresult> = 48.889 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="M_H_STRI = γ_EH_STRI*F_EH*y_EH + γ_ES_STRI*F_ES*y_ES + γ_LS_STRI*F_LS*y_LS + (γ_TU_STRI*(F_TU + F_SH) + H_W_STRI)*y_brg to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>M_H_STRI = γ_EH_STRI*F_EH*y_EH + γ_ES_STRI*F_ES*y_ES + γ_LS_STRI*F_LS*y_LS + (γ_TU_STRI*(F_TU + F_SH) + H_W_STRI)*y_brg to kip*ft</expbody>
          <expresult> = 89.828 kip*ft</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="M_Vb_STRI = γ_brg_STRI*W_DCb*x_brg + γ_PLb_STRI*W_PLb*x_brg + γ_ped_STRI*W_ped*x_ped to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>M_Vb_STRI = γ_brg_STRI*W_DCb*x_brg + γ_PLb_STRI*W_PLb*x_brg + γ_ped_STRI*W_ped*x_ped to kip*ft</expbody>
          <expresult> = 167.033 kip*ft</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="M_Vs_STRI = γ_cap_STRI*W_cap*x_cap + γ_ck_STRI*W_ck*x_ck + γ_bw_STRI*W_bw*x_bw to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>M_Vs_STRI = γ_cap_STRI*W_cap*x_cap + γ_ck_STRI*W_ck*x_ck + γ_bw_STRI*W_bw*x_bw to kip*ft</expbody>
          <expresult> = -0.733 kip*ft</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="M_OT_STRI = M_H_STRI + M_Vb_STRI + M_Vs_STRI + M_WV_STRI to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>M_OT_STRI = M_H_STRI + M_Vb_STRI + M_Vs_STRI + M_WV_STRI to kip*ft</expbody>
          <expresult> = 256.128 kip*ft</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="e_res_STRI = M_OT_STRI/H_T_STRI to ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>e_res_STRI = M_OT_STRI/H_T_STRI to ft</expbody>
          <expresult> = 5.239 ft</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="F_eq_STRI = M_OT_STRI/y_strap to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>F_eq_STRI = M_OT_STRI/y_strap to kip</expbody>
          <expresult> = 73.179 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="F_str_STRI = Max(H_T_STRI, F_eq_STRI) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>F_str_STRI = Max(H_T_STRI, F_eq_STRI) to kip</expbody>
          <expresult> = 73.179 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="f_str_STRI = F_str_STRI/L_bw to klf" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>f_str_STRI = F_str_STRI/L_bw to klf</expbody>
          <expresult> = 3.737 klf</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="V_pile_STRI = F_eq_STRI - H_T_STRI to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>V_pile_STRI = F_eq_STRI - H_T_STRI to kip</expbody>
          <expresult> = 24.290 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="M_WV_STRIII1 = If(FZ_W_STRIII1*x_brg &gt; 0 kip*in, FZ_W_STRIII1*x_brg, 0 kip*in) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>M_WV_STRIII1 = If(FZ_W_STRIII1*x_brg &gt; 0 kip*in, FZ_W_STRIII1*x_brg, 0 kip*in) to kip*ft</expbody>
          <expresult> = 0.000 kip*ft</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="H_T_STRIII1 = γ_EH_STRIII1*F_EH + γ_ES_STRIII1*F_ES + γ_LS_STRIII1*F_LS + γ_TU_STRIII1*(F_TU + F_SH) + H_W_STRIII1 to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>H_T_STRIII1 = γ_EH_STRIII1*F_EH + γ_ES_STRIII1*F_ES + γ_LS_STRIII1*F_LS + γ_TU_STRIII1*(F_TU + F_SH) + H_W_STRIII1 to kip</expbody>
          <expresult> = 47.707 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
