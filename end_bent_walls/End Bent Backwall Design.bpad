    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Factor on each vertical load, chosen by the sign of its arm:</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="γ_brg_SERI = If(x_brg &gt; 0 in, γ_DCmax_SERI, γ_DCmin_SERI)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>γ_brg_SERI = If(x_brg &gt; 0 in, γ_DCmax_SERI, γ_DCmin_SERI)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="γ_cap_SERI = If(x_cap &gt; 0 in, γ_DCmax_SERI, γ_DCmin_SERI)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>γ_cap_SERI = If(x_cap &gt; 0 in, γ_DCmax_SERI, γ_DCmin_SERI)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="γ_ped_SERI = If(x_ped &gt; 0 in, γ_DCmax_SERI, γ_DCmin_SERI)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>γ_ped_SERI = If(x_ped &gt; 0 in, γ_DCmax_SERI, γ_DCmin_SERI)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="γ_ck_SERI = If(x_ck &gt; 0 in, γ_DCmax_SERI, γ_DCmin_SERI)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>γ_ck_SERI = If(x_ck &gt; 0 in, γ_DCmax_SERI, γ_DCmin_SERI)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="γ_bw_SERI = If(x_bw &gt; 0 in, γ_DCmax_SERI, γ_DCmin_SERI)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>γ_bw_SERI = If(x_bw &gt; 0 in, γ_DCmax_SERI, γ_DCmin_SERI)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="γ_PLb_SERI = If(x_brg &gt; 0 in, γ_PL_SERI, 0*γ_PL_SERI)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>γ_PLb_SERI = If(x_brg &gt; 0 in, γ_PL_SERI, 0*γ_PL_SERI)</expbody>
      </dynexp>
    </paragraph>
