      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="ρ_SF = A_s_SF/(b_s*d_SF)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
