    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_u_FF = Max(M_sl_STRI, M_sl_STRIII1, M_sl_STRIII2, M_sl_STRIV) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_u_FF = Max(M_sl_STRI, M_sl_STRIII1, M_sl_STRIII2, M_sl_STRIV) to kip*ft</expbody>
        <expresult> = 1.287 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored moment, fill face</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_s_FF = M_sl_SERI to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_s_FF = M_sl_SERI to kip*ft</expbody>
        <expresult> = 0.817 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">service moment, fill face</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_u_SF = Max(M_en_STRI, M_en_STRIII1, M_en_STRIII2, M_en_STRIV, 0 kip*ft) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_u_SF = Max(M_en_STRI, M_en_STRIII1, M_en_STRIII2, M_en_STRIV, 0 kip*ft) to kip*ft</expbody>
        <expresult> = 4.318 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored moment, span face</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_s_SF = Max(M_en_SERI, 0 kip*ft) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_s_SF = Max(M_en_SERI, 0 kip*ft) to kip*ft</expbody>
        <expresult> = 3.817 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">service moment, span face</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_u_bw = Max(V_sl_STRI, V_sl_STRIII1, V_sl_STRIII2, V_sl_STRIV, Abs(V_en_STRI), Abs(V_en_STRIII1), Abs(V_en_STRIII2), Abs(V_en_STRIV)) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_u_bw = Max(V_sl_STRI, V_sl_STRIII1, V_sl_STRIII2, V_sl_STRIV, Abs(V_en_STRI), Abs(V_en_STRIII1), Abs(V_en_STRIII2), Abs(V_en_STRIV)) to kip</expbody>
        <expresult> = 2.945 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored joint shear, both states</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">7. Cheek walls: wind only (LRFD 3.8.1.2.1)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="P_Z_III = 2.56*0.000001*V_III^2*K_Z_III*G_w*C_D*(1 ksf) to psf" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>P_Z_III = 2.56*0.000001*V_III^2*K_Z_III*G_w*C_D*(1 ksf) to psf</expbody>
        <expresult> = 60.016 psf</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength III pressure</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="P_Z_SER = 2.56*0.000001*V_SER^2*K_Z_SER*G_w*C_D*(1 ksf) to psf" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>P_Z_SER = 2.56*0.000001*V_SER^2*K_Z_SER*G_w*C_D*(1 ksf) to psf</expbody>
        <expresult> = 17.060 psf</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Service I pressure</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_u_CK = P_Z_III*H_ck*b_s to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_u_CK = P_Z_III*H_ck*b_s to kip</expbody>
        <expresult> = 0.302 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored base shear, 1-ft strip</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_u_CK = P_Z_III*H_ck^2/2*b_s to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_u_CK = P_Z_III*H_ck^2/2*b_s to kip*ft</expbody>
        <expresult> = 0.760 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored base moment</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_s_CK = P_Z_SER*H_ck^2/2*b_s to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_s_CK = P_Z_SER*H_ck^2/2*b_s to kip*ft</expbody>
        <expresult> = 0.216 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">service base moment</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">8. Materials (LRFD 5.4.2, 5.6.2.2; SDG 3.10.F)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="β_1 = Min(0.85, Max(0.65, 0.85 - 0.05*(fc - (4 ksi))/(1 ksi)))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>β_1 = Min(0.85, Max(0.65, 0.85 - 0.05*(fc - (4 ksi))/(1 ksi)))</expbody>
        <expresult> = 0.775</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">stress block factor</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="E_c = 120000*K_1*(w_cE/(1 kip/ft^3))^2*(fc/(1 ksi))^0.33*(1 ksi) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>E_c = 120000*K_1*(w_cE/(1 kip/ft^3))^2*(fc/(1 ksi))^0.33*(1 ksi) to ksi</expbody>
        <expresult> = 4458.892 ksi</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">concrete modulus</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="n_m = Es/E_c" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>n_m = Es/E_c</expbody>
        <expresult> = 6.504</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">modular ratio</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="f_r = 0.24*λ*Sqrt(fc/(1 ksi))*(1 ksi) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>f_r = 0.24*λ*Sqrt(fc/(1 ksi))*(1 ksi) to ksi</expbody>
        <expresult> = 0.563 ksi</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">modulus of rupture</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="f_ss_lim = fss_ratio*fy to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>f_ss_lim = fss_ratio*fy to ksi</expbody>
        <expresult> = 48.000 ksi</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">service steel stress limit</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" pagebreakbefore="break">9. Flexure, crack control and shear: 1-ft strips (LRFD 5.6, 5.7)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6">Members: FF = backwall fill face (strap slack), SF = backwall span face (strap engaged), CK = cheek wall (either face). The equations are shown for the fill face; the span face and the cheek wall repeat them in the collapsed sections and the green tables.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="h_w_FF = t_bw to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>h_w_FF = t_bw to in</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="c_v_FF = cv_bw to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>c_v_FF = cv_bw to in</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="n_b_FF = bar_FF" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>n_b_FF = bar_FF</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="s_w_FF = s_FF to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>s_w_FF = s_FF to in</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Backwall span face (SF) and cheek wall (CK): the same equations, collapsed.</paragraph>
    <section name="Rest_Members_5" capture="False" hide="true">
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="h_w_SF = t_bw to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>h_w_SF = t_bw to in</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="c_v_SF = cv_bw to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>c_v_SF = cv_bw to in</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="n_b_SF = bar_SF" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>n_b_SF = bar_SF</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="s_w_SF = s_SF to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>s_w_SF = s_SF to in</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="h_w_CK = t_ck to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>h_w_CK = t_ck to in</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="c_v_CK = cv_ck to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>c_v_CK = cv_ck to in</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="n_b_CK = bar_CK" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>n_b_CK = bar_CK</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="s_w_CK = s_CK to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>s_w_CK = s_CK to in</expbody>
        </dynexp>
      </paragraph>
    </section>
    <embed spacingbefore="5" spacingafter="8">
      <table name="Table_Members_5" capture="False" colwidths="1:270, 2:130, 3:130, 4:130">
        <stylerule range="A1:D5" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/>
        <stylerule range="A1:D1" horzalign="Center" vertalign="Center"/>
        <stylerule range="B2:D5" horzalign="Center" vertalign="Center"/>
        <row>
          <textcell name="Table_Members_5R0C0" capture="False" background="#DCECE0">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Quantity</paragraph>
          </textcell>
          <textcell name="Table_Members_5R0C1" capture="False" background="#DCECE0">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Backwall fill face</paragraph>
          </textcell>
          <textcell name="Table_Members_5R0C2" capture="False" background="#DCECE0">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Backwall span face</paragraph>
          </textcell>
          <textcell name="Table_Members_5R0C3" capture="False" background="#DCECE0">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Cheek wall</paragraph>
          </textcell>
        </row>
        <row>
          <textcell name="Table_Members_5R1C0" capture="False" background="#EFF7F1">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">h_w (in)</paragraph>
          </textcell>
          <c formula="h_w_FF to in" capture="False" background="#EFF7F1">
            <num>12.000 in</num>
          </c>
          <c formula="h_w_SF to in" capture="False" background="#EFF7F1">
            <num>12.000 in</num>
          </c>
          <c formula="h_w_CK to in" capture="False" background="#EFF7F1">
            <num>8.000 in</num>
          </c>
        </row>
        <row>
          <textcell name="Table_Members_5R2C0" capture="False" background="#EFF7F1">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">c_v (in)</paragraph>
          </textcell>
          <c formula="c_v_FF to in" capture="False" background="#EFF7F1">
            <num>3.000 in</num>
          </c>
          <c formula="c_v_SF to in" capture="False" background="#EFF7F1">
            <num>3.000 in</num>
          </c>
          <c formula="c_v_CK to in" capture="False" background="#EFF7F1">
            <num>2.000 in</num>
          </c>
        </row>
        <row>
          <textcell name="Table_Members_5R3C0" capture="False" background="#EFF7F1">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">n_b</paragraph>
          </textcell>
          <c formula="n_b_FF" capture="False" background="#EFF7F1">
            <num>5.000</num>
          </c>
          <c formula="n_b_SF" capture="False" background="#EFF7F1">
            <num>5.000</num>
          </c>
          <c formula="n_b_CK" capture="False" background="#EFF7F1">
            <num>4.000</num>
          </c>
        </row>
        <row>
          <textcell name="Table_Members_5R4C0" capture="False" background="#EFF7F1">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">s_w (in)</paragraph>
          </textcell>
          <c formula="s_w_FF to in" capture="False" background="#EFF7F1">
            <num>12.000 in</num>
          </c>
          <c formula="s_w_SF to in" capture="False" background="#EFF7F1">
            <num>12.000 in</num>
          </c>
          <c formula="s_w_CK to in" capture="False" background="#EFF7F1">
            <num>10.000 in</num>
          </c>
        </row>
      </table>
    </embed>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_b_FF = Ab(n_b_FF) to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_b_FF = Ab(n_b_FF) to in^2</expbody>
        <expresult> = 0.310 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bar area</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="d_b_FF = Db(n_b_FF) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>d_b_FF = Db(n_b_FF) to in</expbody>
        <expresult> = 0.625 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bar diameter</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="d_FF = h_w_FF - c_v_FF - d_b_FF/2 to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>d_FF = h_w_FF - c_v_FF - d_b_FF/2 to in</expbody>
        <expresult> = 8.688 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">effective depth</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_s_FF = A_b_FF*b_s/s_w_FF to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_s_FF = A_b_FF*b_s/s_w_FF to in^2</expbody>
        <expresult> = 0.310 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">steel in the strip</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="a_FF = A_s_FF*fy/(0.85*fc*b_s) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>a_FF = A_s_FF*fy/(0.85*fc*b_s) to in</expbody>
        <expresult> = 0.332 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">stress block depth</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="c_FF = a_FF/β_1 to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>c_FF = a_FF/β_1 to in</expbody>
        <expresult> = 0.428 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">neutral axis depth</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="ε_t_FF = 0.003*(d_FF - c_FF)/c_FF" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>ε_t_FF = 0.003*(d_FF - c_FF)/c_FF</expbody>
        <expresult> = 0.058</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">net tensile strain</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="φ_FF = If(ε_t_FF &gt;= 0.005, φ_f, If(ε_t_FF &lt;= 0.002, 0.75, 0.75 + 0.15*(ε_t_FF - 0.002)/0.003))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>φ_FF = If(ε_t_FF &gt;= 0.005, φ_f, If(ε_t_FF &lt;= 0.002, 0.75, 0.75 + 0.15*(ε_t_FF - 0.002)/0.003))</expbody>
        <expresult> = 0.900</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">flexure φ (LRFD 5.5.4.2)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_n_FF = A_s_FF*fy*(d_FF - a_FF/2) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_n_FF = A_s_FF*fy*(d_FF - a_FF/2) to kip*ft</expbody>
        <expresult> = 13.209 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">nominal moment</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_r_FF = φ_FF*M_n_FF to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_r_FF = φ_FF*M_n_FF to kip*ft</expbody>
        <expresult> = 11.888 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored resistance</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_req_FF = 0.85*fc*b_s*d_FF/fy*(1 - Sqrt(Max(1 - 2*M_u_FF/(0.85*φ_f*fc*b_s*d_FF^2), 0))) to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_req_FF = 0.85*fc*b_s*d_FF/fy*(1 - Sqrt(Max(1 - 2*M_u_FF/(0.85*φ_f*fc*b_s*d_FF^2), 0))) to in^2</expbody>
        <expresult> = 0.033 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">steel required for Mu</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="S_c_FF = b_s*h_w_FF^2/6 to in^3" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>S_c_FF = b_s*h_w_FF^2/6 to in^3</expbody>
        <expresult> = 288.000 in^3</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">section modulus</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_cr_FF = gamma_3*gamma_1*f_r*S_c_FF to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_cr_FF = gamma_3*gamma_1*f_r*S_c_FF to kip*ft</expbody>
        <expresult> = 14.481 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cracking moment (LRFD 5.6.3.3)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_min_FF = Min(M_cr_FF, 1.33*M_u_FF) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_min_FF = Min(M_cr_FF, 1.33*M_u_FF) to kip*ft</expbody>
        <expresult> = 1.712 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum flexural resistance</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="ρ_FF = A_s_FF/(b_s*d_FF)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>ρ_FF = A_s_FF/(b_s*d_FF)</expbody>
        <expresult> = 0.003</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">reinforcement ratio</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="k_cr_FF = Sqrt(2*ρ_FF*n_m + (ρ_FF*n_m)^2) - ρ_FF*n_m" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>k_cr_FF = Sqrt(2*ρ_FF*n_m + (ρ_FF*n_m)^2) - ρ_FF*n_m</expbody>
        <expresult> = 0.178</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cracked neutral axis ratio</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="j_cr_FF = 1 - k_cr_FF/3" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>j_cr_FF = 1 - k_cr_FF/3</expbody>
        <expresult> = 0.941</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">lever arm ratio</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="f_ss_FF = M_s_FF/(A_s_FF*j_cr_FF*d_FF) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>f_ss_FF = M_s_FF/(A_s_FF*j_cr_FF*d_FF) to ksi</expbody>
        <expresult> = 3.869 ksi</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">service steel stress</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="d_c_FF = h_w_FF - d_FF to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>d_c_FF = h_w_FF - d_FF to in</expbody>
        <expresult> = 3.312 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cover to bar center</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="β_s_FF = 1 + d_c_FF/(0.7*(h_w_FF - d_c_FF))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>β_s_FF = 1 + d_c_FF/(0.7*(h_w_FF - d_c_FF))</expbody>
        <expresult> = 1.545</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strain ratio</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="s_cr_FF = If(f_ss_FF &gt; 0 ksi, 700*γ_e/(β_s_FF*f_ss_FF/(1 ksi))*(1 in) - 2*d_c_FF, 99 in) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>s_cr_FF = If(f_ss_FF &gt; 0 ksi, 700*γ_e/(β_s_FF*f_ss_FF/(1 ksi))*(1 in) - 2*d_c_FF, 99 in) to in</expbody>
        <expresult> = 110.486 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">crack-control spacing (LRFD 5.6.7)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="d_v_FF = Max(d_FF - a_FF/2, 0.9*d_FF, 0.72*h_w_FF) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>d_v_FF = Max(d_FF - a_FF/2, 0.9*d_FF, 0.72*h_w_FF) to in</expbody>
        <expresult> = 8.640 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shear depth</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_c_FF = 0.0316*beta_v*λ*Sqrt(fc/(1 ksi))*(1 ksi)*b_s*d_v_FF to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_c_FF = 0.0316*beta_v*λ*Sqrt(fc/(1 ksi))*(1 ksi)*b_s*d_v_FF to kip</expbody>
        <expresult> = 15.367 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">concrete shear</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_n_FF = Min(V_c_FF, 0.25*fc*b_s*d_v_FF) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_n_FF = Min(V_c_FF, 0.25*fc*b_s*d_v_FF) to kip</expbody>
        <expresult> = 15.367 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">nominal shear</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
