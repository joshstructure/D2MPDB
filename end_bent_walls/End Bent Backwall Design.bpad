          <expresult> = 0.941</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="f_ss_SF = M_s_SF/(A_s_SF*j_cr_SF*d_SF) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
