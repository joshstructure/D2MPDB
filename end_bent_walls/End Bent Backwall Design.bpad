        <dynexp formula="DC_crk_SF = Max(f_ss_SF/f_ss_lim, If(f_ss_SF &gt; 0 ksi, s_w_SF/s_cr_SF, 0))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>DC_crk_SF = Max(f_ss_SF/f_ss_lim, If(f_ss_SF &gt; 0 ksi, s_w_SF/s_cr_SF, 0))</expbody>
          <expresult> = 0.651</expresult>
