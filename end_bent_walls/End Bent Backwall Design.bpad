        <dynexp formula="DC_crk_CK = Max(f_ss_CK/f_ss_lim, If(f_ss_CK &gt; 0 ksi, s_w_CK/s_cr_CK, 0))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>DC_crk_CK = Max(f_ss_CK/f_ss_lim, If(f_ss_CK &gt; 0 ksi, s_w_CK/s_cr_CK, 0))</expbody>
          <expresult> = 0.130</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="DC_sp_CK = s_w_CK/s_max_CK" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>DC_sp_CK = s_w_CK/s_max_CK</expbody>
          <expresult> = 0.833</expresult>
        </dynexp>
      </paragraph>
    </section>
