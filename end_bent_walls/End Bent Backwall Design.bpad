          <textcell name="Table_Combos_3R5C0" capture="False" background="#EFF7F1">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">M_Vs: cap, cheek walls and backwall (kip*ft)</paragraph>
          </textcell>
          <c formula="M_Vs_SERI to kip*ft" capture="False" background="#EFF7F1">
            <num>-3.853 kip*ft</num>
          </c>
          <c formula="M_Vs_STRI to kip*ft" capture="False" background="#EFF7F1">
            <num>-0.733 kip*ft</num>
          </c>
          <c formula="M_Vs_STRIII1 to kip*ft" capture="False" background="#EFF7F1">
            <num>-0.733 kip*ft</num>
          </c>
          <c formula="M_Vs_STRIII2 to kip*ft" capture="False" background="#EFF7F1">
            <num>-0.733 kip*ft</num>
          </c>
          <c formula="M_Vs_STRIV to kip*ft" capture="False" background="#EFF7F1">
            <num>1.220 kip*ft</num>
          </c>
        </row>
        <row>
          <textcell name="Table_Combos_3R6C0" capture="False" background="#EFF7F1">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">M_OT: overturning moment about O (kip*ft)</paragraph>
          </textcell>
          <c formula="M_OT_SERI to kip*ft" capture="False" background="#EFF7F1">
            <num>211.736 kip*ft</num>
          </c>
          <c formula="M_OT_STRI to kip*ft" capture="False" background="#EFF7F1">
            <num>256.128 kip*ft</num>
          </c>
          <c formula="M_OT_STRIII1 to kip*ft" capture="False" background="#EFF7F1">
            <num>203.592 kip*ft</num>
          </c>
          <c formula="M_OT_STRIII2 to kip*ft" capture="False" background="#EFF7F1">
            <num>185.737 kip*ft</num>
          </c>
          <c formula="M_OT_STRIV to kip*ft" capture="False" background="#EFF7F1">
            <num>210.954 kip*ft</num>
          </c>
        </row>
        <row>
          <textcell name="Table_Combos_3R7C0" capture="False" background="#EFF7F1">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">e_res: resultant height above O (ft)</paragraph>
          </textcell>
          <c formula="e_res_SERI to ft" capture="False" background="#EFF7F1">
            <num>4.710 ft</num>
          </c>
          <c formula="e_res_STRI to ft" capture="False" background="#EFF7F1">
            <num>5.239 ft</num>
          </c>
          <c formula="e_res_STRIII1 to ft" capture="False" background="#EFF7F1">
            <num>4.268 ft</num>
          </c>
          <c formula="e_res_STRIII2 to ft" capture="False" background="#EFF7F1">
            <num>4.516 ft</num>
          </c>
          <c formula="e_res_STRIV to ft" capture="False" background="#EFF7F1">
            <num>5.129 ft</num>
          </c>
        </row>
        <row>
          <textcell name="Table_Combos_3R8C0" capture="False" background="#EFF7F1">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">F_eq: strap force for moment equilibrium (kip)</paragraph>
          </textcell>
          <c formula="F_eq_SERI to kip" capture="False" background="#EFF7F1">
            <num>60.496 kip</num>
          </c>
          <c formula="F_eq_STRI to kip" capture="False" background="#EFF7F1">
            <num>73.179 kip</num>
          </c>
          <c formula="F_eq_STRIII1 to kip" capture="False" background="#EFF7F1">
            <num>58.169 kip</num>
          </c>
          <c formula="F_eq_STRIII2 to kip" capture="False" background="#EFF7F1">
            <num>53.068 kip</num>
          </c>
          <c formula="F_eq_STRIV to kip" capture="False" background="#EFF7F1">
            <num>60.273 kip</num>
          </c>
        </row>
        <row>
          <textcell name="Table_Combos_3R9C0" capture="False" background="#EFF7F1">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">F_str: design strap force (kip)</paragraph>
          </textcell>
          <c formula="F_str_SERI to kip" capture="False" background="#EFF7F1">
            <num>60.496 kip</num>
          </c>
          <c formula="F_str_STRI to kip" capture="False" background="#EFF7F1">
            <num>73.179 kip</num>
          </c>
          <c formula="F_str_STRIII1 to kip" capture="False" background="#EFF7F1">
            <num>58.169 kip</num>
          </c>
          <c formula="F_str_STRIII2 to kip" capture="False" background="#EFF7F1">
            <num>53.068 kip</num>
          </c>
          <c formula="F_str_STRIV to kip" capture="False" background="#EFF7F1">
            <num>60.273 kip</num>
          </c>
