        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="k_cr_SF = Sqrt(2*ρ_SF*n_m + (ρ_SF*n_m)^2) - ρ_SF*n_m" mathlayout="on" showformula="True" showresult="True" showsteps="False">
