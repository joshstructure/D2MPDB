        <row>
          <textcell name="Table_Combos_3R10C0" capture="False" background="#EFF7F1">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">f_str: strap load per foot of backwall (klf)</paragraph>
          </textcell>
          <c formula="f_str_SERI to klf" capture="False" background="#EFF7F1">
            <num>3.089 klf</num>
          </c>
          <c formula="f_str_STRI to klf" capture="False" background="#EFF7F1">
            <num>3.737 klf</num>
          </c>
          <c formula="f_str_STRIII1 to klf" capture="False" background="#EFF7F1">
            <num>2.970 klf</num>
          </c>
          <c formula="f_str_STRIII2 to klf" capture="False" background="#EFF7F1">
            <num>2.710 klf</num>
          </c>
          <c formula="f_str_STRIV to klf" capture="False" background="#EFF7F1">
            <num>3.078 klf</num>
          </c>
        </row>
        <row>
          <textcell name="Table_Combos_3R11C0" capture="False" background="#EFF7F1">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">V_pile: pile-head force at O (+ toward span) (kip)</paragraph>
          </textcell>
          <c formula="V_pile_SERI to kip" capture="False" background="#EFF7F1">
            <num>15.544 kip</num>
          </c>
          <c formula="V_pile_STRI to kip" capture="False" background="#EFF7F1">
            <num>24.290 kip</num>
          </c>
          <c formula="V_pile_STRIII1 to kip" capture="False" background="#EFF7F1">
            <num>10.463 kip</num>
          </c>
          <c formula="V_pile_STRIII2 to kip" capture="False" background="#EFF7F1">
            <num>11.941 kip</num>
          </c>
          <c formula="V_pile_STRIV to kip" capture="False" background="#EFF7F1">
            <num>19.146 kip</num>
          </c>
        </row>
      </table>
    </embed>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="f_str_u = Max(f_str_STRI, f_str_STRIII1, f_str_STRIII2, f_str_STRIV) to klf" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>f_str_u = Max(f_str_STRI, f_str_STRIII1, f_str_STRIII2, f_str_STRIV) to klf</expbody>
        <expresult> = 3.737 klf</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored strap load for the plans</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="f_str_s = f_str_SERI to klf" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>f_str_s = f_str_SERI to klf</expbody>
        <expresult> = 3.089 klf</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">service strap load for the plans</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_str_u = f_str_u*L_bw to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_str_u = f_str_u*L_bw to kip</expbody>
        <expresult> = 73.179 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored, whole backwall</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_str_s = f_str_s*L_bw to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_str_s = f_str_s*L_bw to kip</expbody>
        <expresult> = 60.496 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">service, whole backwall</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" pagebreakbefore="break">6. Backwall demands per 1-ft strip</paragraph>
    <embed spacingbefore="4" spacingafter="5">
      <canvas name="Figure2Strip" title="Backwall strip" unit="in" size="6.5 in; 4 in; scaletofit">
        <include target="Library.Geometry"/>
        <planecontainer origin="0.15,3.75,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#29333D">
          <textvalue>BACKWALL 1-FT STRIP ABOVE THE CONSTRUCTION JOINT</textvalue>
        </planecontainer>
        <planecontainer origin="1.037,3.33,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="10" textcolor="#29333D">
          <textvalue>Strap slack</textvalue>
        </planecontainer>
        <plot formula="PlotLines([1.194,2.348,2.348,1.194,1.194],[0.429,0.429,0.822,0.822,0.429])" linecolor="#7B8993" linethickness="1"/>
        <planecontainer origin="2.112,0.56,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#7B8993">
          <textvalue>cap</textvalue>
        </planecontainer>
        <plot formula="PlotLines([1.194,2.427],[0.822,0.822])" linecolor="#7B8993" linethickness="0.7"/>
        <planecontainer origin="2.453,0.842,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#7B8993">
          <textvalue>joint</textvalue>
        </planecontainer>
        <plot formula="PlotLines([1.509,2.033,2.033,1.509,1.509],[0.822,0.822,2.957,2.957,0.822])" linecolor="#29333D" linethickness="1.6"/>
        <plot formula="PlotLines([1.509,1.509,0.512,1.22,1.509],[2.957,0.822,0.822,2.957,2.957])" linecolor="#C8702A" linethickness="1"/>
        <planecontainer origin="0.984,3.057,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#C8702A">
          <textvalue>soil + surcharges</textvalue>
        </planecontainer>
        <plot formula="PlotLines([1.509,1.509],[0.822,1.504])" linecolor="#C8372D" linethickness="3.5"/>
        <plot formula="PlotLines([0.879,1.499],[1.676,1.676])" linecolor="#B35012" linethickness="1.6"/>
        <plot formula="PlotLines([1.409,1.499,1.409],[1.632,1.676,1.719])" linecolor="#B35012" linethickness="1.6"/>
        <planecontainer origin="0.853,1.726,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#B35012">
          <textvalue>V_sl</textvalue>
        </planecontainer>
        <planecontainer origin="0.909,1.058,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#C8372D">
          <textvalue>tension face</textvalue>
        </planecontainer>
        <plot formula="PlotLines([0.329,0.512],[0.822,0.822])" linecolor="#1766A0" linethickness="0.5"/>
        <plot formula="PlotLines([0.329,1.22],[2.957,2.957])" linecolor="#1766A0" linethickness="0.5"/>
        <lineardim startpoint="0.355, 0.822, 0" endpoint="0.355, 2.957, 0" pointondimline="0.355, 1.889, 0" formula="EndBentBackwallDesign.H_bw" linecolor="#1766A0" textcolor="#1766A0" linethickness="0.7" fontsize="8">
          <num>4.069 ft</num>
        </lineardim>
        <planecontainer origin="0.329,3.007,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#1766A0">
          <textvalue>H_bw</textvalue>
        </planecontainer>
        <plot formula="PlotLines([1.529,1.552,1.581,1.613,1.65,1.689,1.729,1.771,1.813,1.854,1.893,1.929,1.962,1.99,2.014],[0.962,0.997,1.027,1.053,1.074,1.09,1.099,1.102,1.099,1.09,1.074,1.053,1.027,0.997,0.962])" linecolor="#B35012" linethickness="1.2"/>
        <plot formula="PlotLines([1.974,2.024],[1.031,0.945])" linecolor="#B35012" linethickness="1.2"/>
        <plot formula="PlotLines([1.974,2.024,2.019],[0.979,0.945,1.005])" linecolor="#B35012" linethickness="1.2"/>
        <planecontainer origin="1.651,0.422,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#B35012">
          <textvalue>M_sl</textvalue>
        </planecontainer>
        <planecontainer origin="4.237,3.33,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="10" textcolor="#29333D">
          <textvalue>Strap engaged</textvalue>
        </planecontainer>
        <plot formula="PlotLines([4.394,5.548,5.548,4.394,4.394],[0.429,0.429,0.822,0.822,0.429])" linecolor="#7B8993" linethickness="1"/>
        <planecontainer origin="5.312,0.56,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#7B8993">
          <textvalue>cap</textvalue>
        </planecontainer>
        <plot formula="PlotLines([4.394,5.627],[0.822,0.822])" linecolor="#7B8993" linethickness="0.7"/>
        <planecontainer origin="5.653,0.842,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#7B8993">
          <textvalue>joint</textvalue>
        </planecontainer>
        <plot formula="PlotLines([4.709,5.233,5.233,4.709,4.709],[0.822,0.822,2.957,2.957,0.822])" linecolor="#29333D" linethickness="1.6"/>
        <plot formula="PlotLines([4.709,4.709,3.712,4.42,4.709],[2.957,0.822,0.822,2.957,2.957])" linecolor="#C8702A" linethickness="1"/>
        <planecontainer origin="4.184,3.057,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#C8702A">
          <textvalue>soil + surcharges</textvalue>
        </planecontainer>
        <plot formula="PlotLines([5.233,5.233],[0.822,1.504])" linecolor="#C8372D" linethickness="3.5"/>
        <planecontainer origin="5.496,1.084,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#C8372D">
          <textvalue>tension face</textvalue>
        </planecontainer>
        <plot formula="PlotLines([4.709,3.87],[1.609,1.609])" linecolor="#167B75" linethickness="2"/>
        <plot formula="PlotLines([3.96,3.87,3.96],[1.652,1.609,1.565])" linecolor="#167B75" linethickness="2"/>
        <planecontainer origin="3.87,1.669,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#167B75">
          <textvalue>f_str·b_s</textvalue>
        </planecontainer>
        <lineardim startpoint="5.417, 0.822, 0" endpoint="5.417, 1.609, 0" pointondimline="5.417, 1.216, 0" formula="EndBentBackwallDesign.z_strap" linecolor="#1766A0" textcolor="#1766A0" linethickness="0.7" fontsize="8">
          <num>1.500 ft</num>
        </lineardim>
        <planecontainer origin="5.443,1.659,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#1766A0">
          <textvalue>z_strap</textvalue>
        </planecontainer>
        <plot formula="PlotLines([5.214,5.19,5.162,5.129,5.093,5.054,5.013,4.971,4.929,4.889,4.85,4.813,4.781,4.752,4.729],[0.962,0.997,1.027,1.053,1.074,1.09,1.099,1.102,1.099,1.09,1.074,1.053,1.027,0.997,0.962])" linecolor="#B35012" linethickness="1.2"/>
        <plot formula="PlotLines([4.769,4.719],[1.031,0.945])" linecolor="#B35012" linethickness="1.2"/>
        <plot formula="PlotLines([4.723,4.719,4.768],[1.005,0.945,0.979])" linecolor="#B35012" linethickness="1.2"/>
        <planecontainer origin="4.851,0.422,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#B35012">
          <textvalue>M_en</textvalue>
        </planecontainer>
      </canvas>
    </embed>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Figure 2. Backwall strip above the construction joint. Strap slack: the soil bends the wall toward the span (fill-face tension). Strap engaged: the strap pull exceeds the soil moment (span-face tension).</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_EH_bw = 0.5*k_a*gamma_s*H_bw^2*b_s to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_EH_bw = 0.5*k_a*gamma_s*H_bw^2*b_s to kip</expbody>
        <expresult> = 0.317 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">earth pressure on the strip</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_EH_bw = V_EH_bw*H_bw/3 to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_EH_bw = V_EH_bw*H_bw/3 to kip*ft</expbody>
        <expresult> = 0.430 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">EH moment at the joint</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_LS_bw = p_LS*H_bw*b_s to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_LS_bw = p_LS*H_bw*b_s to kip</expbody>
        <expresult> = 0.122 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">pedestrian surcharge</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_LS_bw = V_LS_bw*H_bw/2 to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_LS_bw = V_LS_bw*H_bw/2 to kip*ft</expbody>
        <expresult> = 0.248 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">LS moment at the joint</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_ES_bw = p_ES*H_bw*b_s to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_ES_bw = p_ES*H_bw*b_s to kip</expbody>
        <expresult> = 0.068 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">slab surcharge</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_ES_bw = V_ES_bw*H_bw/2 to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_ES_bw = V_ES_bw*H_bw/2 to kip*ft</expbody>
        <expresult> = 0.138 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ES moment at the joint</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_sl_SERI = γ_EH_SERI*M_EH_bw + γ_ES_SERI*M_ES_bw + γ_LS_SERI*M_LS_bw to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_sl_SERI = γ_EH_SERI*M_EH_bw + γ_ES_SERI*M_ES_bw + γ_LS_SERI*M_LS_bw to kip*ft</expbody>
        <expresult> = 0.817 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strap slack: moment, fill-face tension</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_sl_SERI = γ_EH_SERI*V_EH_bw + γ_ES_SERI*V_ES_bw + γ_LS_SERI*V_LS_bw to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_sl_SERI = γ_EH_SERI*V_EH_bw + γ_ES_SERI*V_ES_bw + γ_LS_SERI*V_LS_bw to kip</expbody>
        <expresult> = 0.507 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strap slack: joint shear</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_en_SERI = f_str_SERI*b_s*z_strap - M_sl_SERI to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_en_SERI = f_str_SERI*b_s*z_strap - M_sl_SERI to kip*ft</expbody>
        <expresult> = 3.817 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strap engaged: moment, span-face tension</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_en_SERI = f_str_SERI*b_s - V_sl_SERI to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
