    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="x_w0 = (L_load - L_bw)/2 to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>x_w0 = (L_load - L_bw)/2 to in</expbody>
        <expresult> = 8.000 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">backwall start</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="x_b1 = (L_load - s_brg)/2 to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>x_b1 = (L_load - s_brg)/2 to in</expbody>
        <expresult> = 74.005 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bearing 1</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="x_b2 = (L_load + s_brg)/2 to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>x_b2 = (L_load + s_brg)/2 to in</expbody>
        <expresult> = 176.995 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bearing 2</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="L_core(x) = Min(Max(x - (L_load - L_cap)/2, 0 in), L_cap)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>L_core(x) = Min(Max(x - (L_load - L_cap)/2, 0 in), L_cap)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">core cap length left of x</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="L_w(x) = Min(Max(x - x_w0, 0 in), L_bw)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>L_w(x) = Min(Max(x - x_w0, 0 in), L_bw)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">backwall length left of x</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="N_b(x) = If(x &gt;= x_b1, 1, 0) + If(x &gt;= x_b2, 1, 0)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>N_b(x) = If(x &gt;= x_b1, 1, 0) + If(x &gt;= x_b2, 1, 0)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bearings at or left of x</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="N_c(x) = If(x &gt;= t_ck/2, 1, 0) + If(x &gt;= L_load - t_ck/2, 1, 0)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>N_c(x) = If(x &gt;= t_ck/2, 1, 0) + If(x &gt;= L_load - t_ck/2, 1, 0)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cheek walls at or left of x</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="T_c_STRI(x) = t_u_STRI*x + t_cap_STRI*L_core(x) + t_b_STRI*L_w(x) + P_b_STRI*N_b(x) + P_c_STRI*N_c(x)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>T_c_STRI(x) = t_u_STRI*x + t_cap_STRI*L_core(x) + t_b_STRI*L_w(x) + P_b_STRI*N_b(x) + P_c_STRI*N_c(x)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">torque at x, combination r; Strength I</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="T_c_STRIII1(x) = t_u_STRIII1*x + t_cap_STRIII1*L_core(x) + t_b_STRIII1*L_w(x) + P_b_STRIII1*N_b(x) + P_c_STRIII1*N_c(x)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>T_c_STRIII1(x) = t_u_STRIII1*x + t_cap_STRIII1*L_core(x) + t_b_STRIII1*L_w(x) + P_b_STRIII1*N_b(x) + P_c_STRIII1*N_c(x)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">torque at x, combination r; Strength III · wind 1</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="T_c_STRIII2(x) = t_u_STRIII2*x + t_cap_STRIII2*L_core(x) + t_b_STRIII2*L_w(x) + P_b_STRIII2*N_b(x) + P_c_STRIII2*N_c(x)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>T_c_STRIII2(x) = t_u_STRIII2*x + t_cap_STRIII2*L_core(x) + t_b_STRIII2*L_w(x) + P_b_STRIII2*N_b(x) + P_c_STRIII2*N_c(x)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">torque at x, combination r; Strength III · wind 2</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="T_c_STRIV(x) = t_u_STRIV*x + t_cap_STRIV*L_core(x) + t_b_STRIV*L_w(x) + P_b_STRIV*N_b(x) + P_c_STRIV*N_c(x)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>T_c_STRIV(x) = t_u_STRIV*x + t_cap_STRIV*L_core(x) + t_b_STRIV*L_w(x) + P_b_STRIV*N_b(x) + P_c_STRIV*N_c(x)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">torque at x, combination r; Strength IV</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="X_T_0 = 0 in to ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>X_T_0 = 0 in to ft</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">stations where the torque changes slope or jumps</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Stations 1 to 7: the same equations, collapsed.</paragraph>
    <section name="Rest_Stations_8" capture="False" hide="true">
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="X_T_1 = t_ck/2 to ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>X_T_1 = t_ck/2 to ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="X_T_2 = x_w0 to ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>X_T_2 = x_w0 to ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="X_T_3 = x_b1 to ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>X_T_3 = x_b1 to ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="X_T_4 = x_b2 to ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>X_T_4 = x_b2 to ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="X_T_5 = L_load - x_w0 to ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>X_T_5 = L_load - x_w0 to ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="X_T_6 = L_load - t_ck/2 to ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>X_T_6 = L_load - t_ck/2 to ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="X_T_7 = L_load to ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>X_T_7 = L_load to ft</expbody>
        </dynexp>
      </paragraph>
    </section>
    <embed spacingbefore="5" spacingafter="8">
      <table name="Table_Stations_8" capture="False" colwidths="1:150, 2:58, 3:58, 4:58, 5:58, 6:58, 7:58, 8:58, 9:58">
        <stylerule range="A1:I2" fontfamily="Times New Roman" fontsize="9" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/>
        <stylerule range="A1:I1" horzalign="Center" vertalign="Center"/>
        <stylerule range="B2:I2" horzalign="Center" vertalign="Center"/>
        <row>
          <textcell name="Table_Stations_8R0C0" capture="False" background="#DCECE0">
            <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold" horzalign="Center">Quantity</paragraph>
          </textcell>
          <textcell name="Table_Stations_8R0C1" capture="False" background="#DCECE0">
            <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold" horzalign="Center">k = 0</paragraph>
          </textcell>
          <textcell name="Table_Stations_8R0C2" capture="False" background="#DCECE0">
            <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold" horzalign="Center">k = 1</paragraph>
          </textcell>
          <textcell name="Table_Stations_8R0C3" capture="False" background="#DCECE0">
            <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold" horzalign="Center">k = 2</paragraph>
          </textcell>
          <textcell name="Table_Stations_8R0C4" capture="False" background="#DCECE0">
            <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold" horzalign="Center">k = 3</paragraph>
          </textcell>
          <textcell name="Table_Stations_8R0C5" capture="False" background="#DCECE0">
            <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold" horzalign="Center">k = 4</paragraph>
          </textcell>
          <textcell name="Table_Stations_8R0C6" capture="False" background="#DCECE0">
            <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold" horzalign="Center">k = 5</paragraph>
          </textcell>
          <textcell name="Table_Stations_8R0C7" capture="False" background="#DCECE0">
            <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold" horzalign="Center">k = 6</paragraph>
