      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="d_v_CK = Max(d_CK - a_CK/2, 0.9*d_CK, 0.72*h_w_CK) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>d_v_CK = Max(d_CK - a_CK/2, 0.9*d_CK, 0.72*h_w_CK) to in</expbody>
          <expresult> = 5.760 in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="V_c_CK = 0.0316*beta_v*λ*Sqrt(fc/(1 ksi))*(1 ksi)*b_s*d_v_CK to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>V_c_CK = 0.0316*beta_v*λ*Sqrt(fc/(1 ksi))*(1 ksi)*b_s*d_v_CK to kip</expbody>
          <expresult> = 10.245 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="V_n_CK = Min(V_c_CK, 0.25*fc*b_s*d_v_CK) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>V_n_CK = Min(V_c_CK, 0.25*fc*b_s*d_v_CK) to kip</expbody>
          <expresult> = 10.245 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="V_r_CK = φ_v*V_n_CK to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>V_r_CK = φ_v*V_n_CK to kip</expbody>
          <expresult> = 9.220 kip</expresult>
        </dynexp>
      </paragraph>
    </section>
