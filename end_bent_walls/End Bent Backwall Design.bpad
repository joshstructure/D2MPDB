    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">10. Construction joints and distribution steel (LRFD 5.7.4, 5.10.3.2, 5.10.6; SDG 1.15)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_r_bw = Min(V_r_FF, V_r_SF) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_r_bw = Min(V_r_FF, V_r_SF) to kip</expbody>
        <expresult> = 13.830 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">backwall shear resistance</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_cv_bw = Min(d_v_FF, d_v_SF)*b_s to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_cv_bw = Min(d_v_FF, d_v_SF)*b_s to in^2</expbody>
        <expresult> = 103.680 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">interface area, dv strip</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_vf_bw = Min(A_s_FF, A_s_SF) to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_vf_bw = Min(A_s_FF, A_s_SF) to in^2</expbody>
        <expresult> = 0.310 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">steel across the joint, one face</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_ni_bw = Min(c_if*A_cv_bw + mu_if*A_vf_bw*fy, K1_if*fc*A_cv_bw, K2_if*A_cv_bw) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_ni_bw = Min(c_if*A_cv_bw + mu_if*A_vf_bw*fy, K1_if*fc*A_cv_bw, K2_if*A_cv_bw) to kip</expbody>
        <expresult> = 18.936 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">nominal interface shear, Pc = 0</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_ri_bw = φ_v*V_ni_bw to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_ri_bw = φ_v*V_ni_bw to kip</expbody>
        <expresult> = 17.042 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored interface shear</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_vfmin_bw = (0.05 ksi)*A_cv_bw/fy to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_vfmin_bw = (0.05 ksi)*A_cv_bw/fy to in^2</expbody>
        <expresult> = 0.086 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum interface steel</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_cv_ck = d_v_CK*b_s to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_cv_ck = d_v_CK*b_s to in^2</expbody>
        <expresult> = 69.120 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cheek wall interface area</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_ni_ck = Min(c_if*A_cv_ck + mu_if*A_s_CK*fy, K1_if*fc*A_cv_ck, K2_if*A_cv_ck) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_ni_ck = Min(c_if*A_cv_ck + mu_if*A_s_CK*fy, K1_if*fc*A_cv_ck, K2_if*A_cv_ck) to kip</expbody>
        <expresult> = 13.824 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cheek wall interface shear</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_ri_ck = φ_v*V_ni_ck to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_ri_ck = φ_v*V_ni_ck to kip</expbody>
        <expresult> = 12.442 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="s_max_bw = Min(1.5*t_bw, 18 in) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>s_max_bw = Min(1.5*t_bw, 18 in) to in</expbody>
        <expresult> = 18.000 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">max primary spacing, backwall</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="s_max_ck = Min(1.5*t_ck, 18 in) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>s_max_ck = Min(1.5*t_ck, 18 in) to in</expbody>
        <expresult> = 12.000 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">max primary spacing, cheek wall</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="b_ts_bw = Min(H_bw, L_bw) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>b_ts_bw = Min(H_bw, L_bw) to in</expbody>
        <expresult> = 48.830 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">least backwall width</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_ts0_bw = 1.3*b_ts_bw*t_bw/(2*(b_ts_bw + t_bw)*fy)*(1 ksi)*(1 in)/(1 ft) to in^2/ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_ts0_bw = 1.3*b_ts_bw*t_bw/(2*(b_ts_bw + t_bw)*fy)*(1 ksi)*(1 in)/(1 ft) to in^2/ft</expbody>
        <expresult> = 0.104 in^2/ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">LRFD 5.10.6-1 (b, h in in, fy in ksi)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_ts_bw = Min(Max(A_ts0_bw, 0.11 in^2/ft), 0.6 in^2/ft) to in^2/ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_ts_bw = Min(Max(A_ts0_bw, 0.11 in^2/ft), 0.6 in^2/ft) to in^2/ft</expbody>
        <expresult> = 0.110 in^2/ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">S&amp;T steel each backwall face, 0.11 to 0.60</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="s_ts_bw = Min(3*t_bw, 18 in) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>s_ts_bw = Min(3*t_bw, 18 in) to in</expbody>
        <expresult> = 18.000 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">max S&amp;T spacing</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="b_ts_ck = Min(H_ck, w_ck) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>b_ts_ck = Min(H_ck, w_ck) to in</expbody>
        <expresult> = 42.000 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">least cheek wall width</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_ts0_ck = 1.3*b_ts_ck*t_ck/(2*(b_ts_ck + t_ck)*fy)*(1 ksi)*(1 in)/(1 ft) to in^2/ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_ts0_ck = 1.3*b_ts_ck*t_ck/(2*(b_ts_ck + t_ck)*fy)*(1 ksi)*(1 in)/(1 ft) to in^2/ft</expbody>
        <expresult> = 0.073 in^2/ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">LRFD 5.10.6-1</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_ts_ck = If(single_ck == 1, 2, 1)*Min(Max(A_ts0_ck, 0.11 in^2/ft), 0.6 in^2/ft) to in^2/ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_ts_ck = If(single_ck == 1, 2, 1)*Min(Max(A_ts0_ck, 0.11 in^2/ft), 0.6 in^2/ft) to in^2/ft</expbody>
        <expresult> = 0.220 in^2/ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">S&amp;T steel, both face requirements combined for the single cheek mat</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="s_ts_ck = Min(3*t_ck, 18 in) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>s_ts_ck = Min(3*t_ck, 18 in) to in</expbody>
        <expresult> = 18.000 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">max S&amp;T spacing</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_pr_FF = A_b_FF/s_FF to in^2/ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_pr_FF = A_b_FF/s_FF to in^2/ft</expbody>
        <expresult> = 0.310 in^2/ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">provided, fill face</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_pr_SF = A_b_SF/s_SF to in^2/ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_pr_SF = A_b_SF/s_SF to in^2/ft</expbody>
        <expresult> = 0.310 in^2/ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">provided, span face</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_pr_HZ = Ab(bar_HZ)/s_HZ to in^2/ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_pr_HZ = Ab(bar_HZ)/s_HZ to in^2/ft</expbody>
        <expresult> = 0.200 in^2/ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">provided, backwall horizontal</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_pr_CK = A_b_CK/s_CK to in^2/ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_pr_CK = A_b_CK/s_CK to in^2/ft</expbody>
        <expresult> = 0.240 in^2/ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">provided, cheek vertical</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_pr_CKH = Ab(bar_CKH)/s_CKH to in^2/ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_pr_CKH = Ab(bar_CKH)/s_CKH to in^2/ft</expbody>
        <expresult> = 0.240 in^2/ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">provided, cheek horizontal</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">11. Cap torsion screen (LRFD 5.7.2.1; not in the FBMP cap model)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6">The strap restraint is spread along the backwall and balances the overturning moment, so the torque along the cap closes to zero at both ends. Uniform torques: soil and cap self-weight over the cap length, backwall and strap over the backwall length. Point torques: bearing-level loads at the two bearings, cheek walls at the cap ends.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_cp = b_cap*h_cap to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_cp = b_cap*h_cap to in^2</expbody>
        <expresult> = 1512.000 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cap gross area</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="p_cp = 2*(b_cap + h_cap) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>p_cp = 2*(b_cap + h_cap) to in</expbody>
        <expresult> = 156.000 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cap perimeter</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="T_cr = 0.126*Sqrt(fc/(1 ksi))*(1 ksi)*A_cp^2/p_cp to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>T_cr = 0.126*Sqrt(fc/(1 ksi))*(1 ksi)*A_cp^2/p_cp to kip*ft</expbody>
        <expresult> = 360.869 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cracking torque</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="T_lim = 0.25*φ_v*T_cr to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>T_lim = 0.25*φ_v*T_cr to kip*ft</expbody>
        <expresult> = 81.196 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">torsion may be neglected below this</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="t_u_SERI = (γ_EH_SERI*F_EH*y_EH + γ_ES_SERI*F_ES*y_ES + γ_LS_SERI*F_LS*y_LS)/L_load to kip*ft/ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>t_u_SERI = (γ_EH_SERI*F_EH*y_EH + γ_ES_SERI*F_ES*y_ES + γ_LS_SERI*F_LS*y_LS)/L_load to kip*ft/ft</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">uniform torque, whole cap</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="t_cap_SERI = γ_cap_SERI*W_cap*x_cap/L_cap to kip*ft/ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>t_cap_SERI = γ_cap_SERI*W_cap*x_cap/L_cap to kip*ft/ft</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">uniform torque over the core cap only</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="t_b_SERI = (γ_bw_SERI*W_bw*x_bw - M_OT_SERI)/L_bw to kip*ft/ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>t_b_SERI = (γ_bw_SERI*W_bw*x_bw - M_OT_SERI)/L_bw to kip*ft/ft</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">uniform torque over the backwall, with the strap</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="P_b_SERI = ((γ_TU_SERI*(F_TU + F_SH) + H_W_SERI)*y_brg + M_Vb_SERI + M_WV_SERI)/N_brg to kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>P_b_SERI = ((γ_TU_SERI*(F_TU + F_SH) + H_W_SERI)*y_brg + M_Vb_SERI + M_WV_SERI)/N_brg to kip*ft</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">torque at each bearing</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="P_c_SERI = γ_ck_SERI*W_ck*x_ck/2 to kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>P_c_SERI = γ_ck_SERI*W_ck*x_ck/2 to kip*ft</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">torque at each cheek wall</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">The other four combinations (Strength I, Strength III wind 1, Strength III wind 2, Strength IV): the same equations, collapsed.</paragraph>
    <section name="Rest_Combos_7" capture="False" hide="true">
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="t_u_STRI = (γ_EH_STRI*F_EH*y_EH + γ_ES_STRI*F_ES*y_ES + γ_LS_STRI*F_LS*y_LS)/L_load to kip*ft/ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>t_u_STRI = (γ_EH_STRI*F_EH*y_EH + γ_ES_STRI*F_ES*y_ES + γ_LS_STRI*F_LS*y_LS)/L_load to kip*ft/ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="t_cap_STRI = γ_cap_STRI*W_cap*x_cap/L_cap to kip*ft/ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>t_cap_STRI = γ_cap_STRI*W_cap*x_cap/L_cap to kip*ft/ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="t_b_STRI = (γ_bw_STRI*W_bw*x_bw - M_OT_STRI)/L_bw to kip*ft/ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>t_b_STRI = (γ_bw_STRI*W_bw*x_bw - M_OT_STRI)/L_bw to kip*ft/ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="P_b_STRI = ((γ_TU_STRI*(F_TU + F_SH) + H_W_STRI)*y_brg + M_Vb_STRI + M_WV_STRI)/N_brg to kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>P_b_STRI = ((γ_TU_STRI*(F_TU + F_SH) + H_W_STRI)*y_brg + M_Vb_STRI + M_WV_STRI)/N_brg to kip*ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="P_c_STRI = γ_ck_STRI*W_ck*x_ck/2 to kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>P_c_STRI = γ_ck_STRI*W_ck*x_ck/2 to kip*ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="t_u_STRIII1 = (γ_EH_STRIII1*F_EH*y_EH + γ_ES_STRIII1*F_ES*y_ES + γ_LS_STRIII1*F_LS*y_LS)/L_load to kip*ft/ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>t_u_STRIII1 = (γ_EH_STRIII1*F_EH*y_EH + γ_ES_STRIII1*F_ES*y_ES + γ_LS_STRIII1*F_LS*y_LS)/L_load to kip*ft/ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="t_cap_STRIII1 = γ_cap_STRIII1*W_cap*x_cap/L_cap to kip*ft/ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>t_cap_STRIII1 = γ_cap_STRIII1*W_cap*x_cap/L_cap to kip*ft/ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="t_b_STRIII1 = (γ_bw_STRIII1*W_bw*x_bw - M_OT_STRIII1)/L_bw to kip*ft/ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>t_b_STRIII1 = (γ_bw_STRIII1*W_bw*x_bw - M_OT_STRIII1)/L_bw to kip*ft/ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="P_b_STRIII1 = ((γ_TU_STRIII1*(F_TU + F_SH) + H_W_STRIII1)*y_brg + M_Vb_STRIII1 + M_WV_STRIII1)/N_brg to kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>P_b_STRIII1 = ((γ_TU_STRIII1*(F_TU + F_SH) + H_W_STRIII1)*y_brg + M_Vb_STRIII1 + M_WV_STRIII1)/N_brg to kip*ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="P_c_STRIII1 = γ_ck_STRIII1*W_ck*x_ck/2 to kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>P_c_STRIII1 = γ_ck_STRIII1*W_ck*x_ck/2 to kip*ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="t_u_STRIII2 = (γ_EH_STRIII2*F_EH*y_EH + γ_ES_STRIII2*F_ES*y_ES + γ_LS_STRIII2*F_LS*y_LS)/L_load to kip*ft/ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>t_u_STRIII2 = (γ_EH_STRIII2*F_EH*y_EH + γ_ES_STRIII2*F_ES*y_ES + γ_LS_STRIII2*F_LS*y_LS)/L_load to kip*ft/ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="t_cap_STRIII2 = γ_cap_STRIII2*W_cap*x_cap/L_cap to kip*ft/ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>t_cap_STRIII2 = γ_cap_STRIII2*W_cap*x_cap/L_cap to kip*ft/ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="t_b_STRIII2 = (γ_bw_STRIII2*W_bw*x_bw - M_OT_STRIII2)/L_bw to kip*ft/ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>t_b_STRIII2 = (γ_bw_STRIII2*W_bw*x_bw - M_OT_STRIII2)/L_bw to kip*ft/ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="P_b_STRIII2 = ((γ_TU_STRIII2*(F_TU + F_SH) + H_W_STRIII2)*y_brg + M_Vb_STRIII2 + M_WV_STRIII2)/N_brg to kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>P_b_STRIII2 = ((γ_TU_STRIII2*(F_TU + F_SH) + H_W_STRIII2)*y_brg + M_Vb_STRIII2 + M_WV_STRIII2)/N_brg to kip*ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="P_c_STRIII2 = γ_ck_STRIII2*W_ck*x_ck/2 to kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>P_c_STRIII2 = γ_ck_STRIII2*W_ck*x_ck/2 to kip*ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="t_u_STRIV = (γ_EH_STRIV*F_EH*y_EH + γ_ES_STRIV*F_ES*y_ES + γ_LS_STRIV*F_LS*y_LS)/L_load to kip*ft/ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>t_u_STRIV = (γ_EH_STRIV*F_EH*y_EH + γ_ES_STRIV*F_ES*y_ES + γ_LS_STRIV*F_LS*y_LS)/L_load to kip*ft/ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="t_cap_STRIV = γ_cap_STRIV*W_cap*x_cap/L_cap to kip*ft/ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>t_cap_STRIV = γ_cap_STRIV*W_cap*x_cap/L_cap to kip*ft/ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="t_b_STRIV = (γ_bw_STRIV*W_bw*x_bw - M_OT_STRIV)/L_bw to kip*ft/ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>t_b_STRIV = (γ_bw_STRIV*W_bw*x_bw - M_OT_STRIV)/L_bw to kip*ft/ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="P_b_STRIV = ((γ_TU_STRIV*(F_TU + F_SH) + H_W_STRIV)*y_brg + M_Vb_STRIV + M_WV_STRIV)/N_brg to kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>P_b_STRIV = ((γ_TU_STRIV*(F_TU + F_SH) + H_W_STRIV)*y_brg + M_Vb_STRIV + M_WV_STRIV)/N_brg to kip*ft</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="P_c_STRIV = γ_ck_STRIV*W_ck*x_ck/2 to kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>P_c_STRIV = γ_ck_STRIV*W_ck*x_ck/2 to kip*ft</expbody>
        </dynexp>
      </paragraph>
    </section>
