          <expbody>DC_flex_CK = M_u_CK/M_r_CK</expbody>
          <expresult> = 0.194</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="DC_min_CK = M_min_CK/M_r_CK" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>DC_min_CK = M_min_CK/M_r_CK</expbody>
          <expresult> = 0.258</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="DC_eps_CK = 0.005/ε_t_CK" mathlayout="on" showformula="True" showresult="True" showsteps="False">
