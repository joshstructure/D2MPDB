    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_ymax = Max(1.2, 1.1*Max(DC_flex_FF, DC_flex_SF, DC_flex_CK, DC_min_FF, DC_min_SF, DC_min_CK, DC_eps_FF, DC_eps_SF, DC_eps_CK, DC_crk_FF, DC_crk_SF, DC_crk_CK, DC_sp_FF, DC_sp_SF, DC_sp_CK, DC_V_bw, DC_Vi_bw, DC_Avf, DC_ts_v, DC_ts_h, DC_V_ck, DC_Vi_ck, DC_ts_ck, DC_cov, DC_thk, DC_strap, DC_T))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_ymax = Max(1.2, 1.1*Max(DC_flex_FF, DC_flex_SF, DC_flex_CK, DC_min_FF, DC_min_SF, DC_min_CK, DC_eps_FF, DC_eps_SF, DC_eps_CK, DC_crk_FF, DC_crk_SF, DC_crk_CK, DC_sp_FF, DC_sp_SF, DC_sp_CK, DC_V_bw, DC_Vi_bw, DC_Avf, DC_ts_v, DC_ts_h, DC_V_ck, DC_Vi_ck, DC_ts_ck, DC_cov, DC_thk, DC_strap, DC_T))</expbody>
        <expresult> = 1.200</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">vertical scale of Figure 3</paragraph>
    <embed spacingbefore="4" spacingafter="5">
      <canvas name="DCChart" title="D/C by check" unit="in" size="6.5 in; 3.2 in; scaletofit">
        <include target="Library.Geometry"/>
        <planecontainer origin="0.6,3.05,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#29333D">
          <textvalue>D/C by check — blue within 1.0, red over 1.0</textvalue>
        </planecontainer>
        <plot formula="PlotLines([0.6,6.3],[0.5,0.5])" linecolor="#29333D" linethickness="1.2"/>
        <plot formula="PlotLines([0.6,0.6],[0.5,2.9])" linecolor="#29333D" linethickness="1.2"/>
        <plot formula="PlotLines([0.6,6.3],[0.5+2.4/EndBentBackwallDesign.DC_ymax,0.5+2.4/EndBentBackwallDesign.DC_ymax])" linecolor="#7B8993" linethickness="0.9"/>
        <planecontainer origin="0.68,2.54,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#7B8993">
          <textvalue>1.0 limit</textvalue>
        </planecontainer>
        <planecontainer origin="0.38,0.44,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D">
          <textvalue>0</textvalue>
        </planecontainer>
        <planecontainer origin="0.12,2.84,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D" formula="EndBentBackwallDesign.DC_ymax">
          <num>1.200</num>
        </planecontainer>
        <plot formula="PlotLines([0.804,0.804],[0.5,0.5+2.4*If(EndBentBackwallDesign.DC_flex_FF &lt;= 1, EndBentBackwallDesign.DC_flex_FF, null)/EndBentBackwallDesign.DC_ymax])" linecolor="#1766A0" linethickness="2.2"/>
        <plot formula="PlotLines([0.804,0.804],[0.5,0.5+2.4*If(EndBentBackwallDesign.DC_flex_FF &gt; 1, EndBentBackwallDesign.DC_flex_FF, null)/EndBentBackwallDesign.DC_ymax])" linecolor="#C8372D" linethickness="2.2"/>
        <planecontainer origin="0.769,0.3,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="7" textcolor="#29333D">
