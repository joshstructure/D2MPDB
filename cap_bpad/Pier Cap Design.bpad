          <textvalue>d (B)</textvalue>
        </planecontainer>
        <planecontainer origin="1.61,2.72,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#B35012">
          <textvalue>d (N)</textvalue>
        </planecontainer>
        <planecontainer origin="2.06,0.13,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#5D6F80">
          <textvalue>b</textvalue>
        </planecontainer>
        <plot formula="PlotLines([4.779,5.25],[2.65,2.65])" linecolor="#29333D" linethickness="0.6"/>
        <planecontainer origin="5.3,2.61,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D">
          <textvalue>top steel (N)</textvalue>
        </planecontainer>
        <plot formula="PlotLines([4.756,5.25],[0.877,1.27])" linecolor="#29333D" linethickness="0.6"/>
        <planecontainer origin="5.3,1.23,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D">
          <textvalue>bottom steel (P)</textvalue>
        </planecontainer>
        <plot formula="PlotLines([4.287,5.25],[0.877,0.95])" linecolor="#C8702A" linethickness="0.6"/>
        <planecontainer origin="5.3,0.91,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#C8702A">
          <textvalue>added span bars (B)</textvalue>
        </planecontainer>
        <plot formula="PlotLines([4.873,5.25],[1.955,1.955])" linecolor="#7B8993" linethickness="0.6"/>
        <planecontainer origin="5.3,1.915,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#7B8993">
          <textvalue>skin</textvalue>
        </planecontainer>
        <plot formula="PlotLines([4.893,5.25],[2.225,2.225])" linecolor="#1766A0" linethickness="0.6"/>
        <planecontainer origin="5.3,2.185,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#1766A0">
          <textvalue>hoop</textvalue>
        </planecontainer>
      </canvas>
    </embed>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Figure 2. Cross-section between piles: continuous top (N) and bottom (P) steel, added span bars (B), skin bars and the hoop.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">4. Steel areas and effective depths (cap analysis)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="d_vbar = Db(Bar_v) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>d_vbar = Db(Bar_v) to in</expbody>
        <expresult> = 0.750 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">hoop bar diameter</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="As_N = n_N1*Ab(Bar_N1) + n_N2*Ab(Bar_N2) + n_N3*Ab(Bar_N3) to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>As_N = n_N1*Ab(Bar_N1) + n_N2*Ab(Bar_N2) + n_N3*Ab(Bar_N3) to in^2</expbody>
        <expresult> = 2.200 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">top steel, N</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="As_P = (n_P1 + n_P2)*Ab(Bar_P) to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>As_P = (n_P1 + n_P2)*Ab(Bar_P) to in^2</expbody>
        <expresult> = 4.000 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bottom steel at the piles, P</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="As_B = As_P + (n_B1 + n_B2)*Ab(Bar_B) to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>As_B = As_P + (n_B1 + n_B2)*Ab(Bar_B) to in^2</expbody>
        <expresult> = 5.550 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bottom steel with the added span bars, B</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Av = 2*n_loop*Ab(Bar_v) to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>Av = 2*n_loop*Ab(Bar_v) to in^2</expbody>
        <expresult> = 0.880 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">hoop area per set</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="As_side = n_skin*Ab(Bar_skin) to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>As_side = n_skin*Ab(Bar_skin) to in^2</expbody>
        <expresult> = 1.760 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">skin steel, one side</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="dc_N = (n_N1*Ab(Bar_N1)*y_N1 + n_N2*Ab(Bar_N2)*y_N2 + n_N3*Ab(Bar_N3)*y_N3)/Max(As_N, 0.000001 in^2) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>dc_N = (n_N1*Ab(Bar_N1)*y_N1 + n_N2*Ab(Bar_N2)*y_N2 + n_N3*Ab(Bar_N3)*y_N3)/Max(As_N, 0.000001 in^2) to in</expbody>
        <expresult> = 4.005 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">centroid of N from the top face</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="dc_P = (n_P1*Ab(Bar_P)*y_P1 + n_P2*Ab(Bar_P)*y_P2)/Max(As_P, 0.000001 in^2) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>dc_P = (n_P1*Ab(Bar_P)*y_P1 + n_P2*Ab(Bar_P)*y_P2)/Max(As_P, 0.000001 in^2) to in</expbody>
        <expresult> = 4.194 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">centroid of P from the bottom face</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="dc_B = (As_P*dc_P + n_B1*Ab(Bar_B)*y_B1 + n_B2*Ab(Bar_B)*y_B2)/Max(As_B, 0.000001 in^2) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>dc_B = (As_P*dc_P + n_B1*Ab(Bar_B)*y_B1 + n_B2*Ab(Bar_B)*y_B2)/Max(As_B, 0.000001 in^2) to in</expbody>
        <expresult> = 4.123 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">centroid of B from the bottom face</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6">Regions: N (top steel), P (bottom steel at piles), B (bottom steel between piles, added bars). Equations below are shown for region N; regions P and B repeat them in the collapsed section and the table.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="d_N = h - dc_N to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>d_N = h - dc_N to in</expbody>
        <expresult> = 31.995 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">effective depth</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Regions P and B: the same equations, collapsed.</paragraph>
    <section name="RegionsPB_Sec4" capture="False" hide="true">
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="d_P = h - dc_P to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>d_P = h - dc_P to in</expbody>
          <expresult> = 31.806 in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">effective depth</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="d_B = h - dc_B to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>d_B = h - dc_B to in</expbody>
          <expresult> = 31.877 in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">effective depth</paragraph>
    </section>
    <embed spacingbefore="5" spacingafter="8">
      <table name="Sec4Regions" capture="False" colwidths="1:280, 2:80, 3:80, 4:80">
        <stylerule range="A1:D2" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/>
        <stylerule range="A1:D1" horzalign="Center" vertalign="Center"/>
        <stylerule range="B2:D2" horzalign="Center" vertalign="Center"/>
        <row>
          <textcell name="Sec4RegionsR0C0" capture="False" background="#DCECE0">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Quantity</paragraph>
          </textcell>
          <textcell name="Sec4RegionsR0C1" capture="False" background="#DCECE0">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">N</paragraph>
          </textcell>
          <textcell name="Sec4RegionsR0C2" capture="False" background="#DCECE0">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">P</paragraph>
          </textcell>
          <textcell name="Sec4RegionsR0C3" capture="False" background="#DCECE0">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">B</paragraph>
          </textcell>
        </row>
        <row>
          <textcell name="Sec4RegionsR1C0" capture="False" background="#EFF7F1">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">effective depth (in)</paragraph>
          </textcell>
          <c formula="d_N to in" capture="False" background="#EFF7F1">
            <num>31.995 in</num>
          </c>
          <c formula="d_P to in" capture="False" background="#EFF7F1">
            <num>31.806 in</num>
          </c>
          <c formula="d_B to in" capture="False" background="#EFF7F1">
            <num>31.877 in</num>
          </c>
        </row>
      </table>
    </embed>
    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">5. Flexure and minimum reinforcement (LRFD 5.6.3, 5.6.7)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="α_1 = Max(0.75, 0.85 - 0.02*Max(fc/(1 ksi) - 10, 0))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>α_1 = Max(0.75, 0.85 - 0.02*Max(fc/(1 ksi) - 10, 0))</expbody>
        <expresult> = 0.850</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">stress block factor α1</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="β_1 = Max(0.65, 0.85 - 0.05*Max(fc/(1 ksi) - 4, 0))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>β_1 = Max(0.65, 0.85 - 0.05*Max(fc/(1 ksi) - 4, 0))</expbody>
        <expresult> = 0.775</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">stress block factor β1</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="f_r = 0.24*Sqrt(fc/(1 ksi))*(1 ksi) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>f_r = 0.24*Sqrt(fc/(1 ksi))*(1 ksi) to ksi</expbody>
        <expresult> = 0.563 ksi</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">modulus of rupture</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="I_g = b*h^3/12 to in^4" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>I_g = b*h^3/12 to in^4</expbody>
        <expresult> = 186624.000 in^4</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">gross moment of inertia</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="y_t = h/2 to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>y_t = h/2 to in</expbody>
        <expresult> = 18.000 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">centroid to the tension face</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_cr = f_r*I_g/y_t to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_cr = f_r*I_g/y_t to kip*ft</expbody>
        <expresult> = 486.302 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cracking moment</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_crm = 1.6*0.67*M_cr to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_crm = 1.6*0.67*M_cr to kip*ft</expbody>
        <expresult> = 521.316 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum-steel target, 1.6 · 0.67 M_cr</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="a_N = As_N*fy/(α_1*fc*b) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>a_N = As_N*fy/(α_1*fc*b) to in</expbody>
        <expresult> = 0.588 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">stress block depth</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="c_N = a_N/β_1 to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>c_N = a_N/β_1 to in</expbody>
        <expresult> = 0.759 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">neutral axis depth</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_n_N = As_N*fy*(d_N - a_N/2) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_n_N = As_N*fy*(d_N - a_N/2) to kip*ft</expbody>
        <expresult> = 348.713 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">nominal moment</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_r_N = φ_f*M_n_N to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_r_N = φ_f*M_n_N to kip*ft</expbody>
        <expresult> = 313.842 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored resistance</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_req_N = Mu_N/(φ_f*fy*(d_N - a_N/2)) to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_req_N = Mu_N/(φ_f*fy*(d_N - a_N/2)) to in^2</expbody>
        <expresult> = 0.274 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">steel required for M_u</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_min_N = Min(M_crm, 1.33*Mu_N) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_min_N = Min(M_crm, 1.33*Mu_N) to kip*ft</expbody>
        <expresult> = 52.030 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum factored resistance</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="ε_t_N = 0.003*(d_N - c_N)/Max(c_N, 0.000001 in)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>ε_t_N = 0.003*(d_N - c_N)/Max(c_N, 0.000001 in)</expbody>
        <expresult> = 0.123</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">net tensile strain</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_flex_N = Mu_N/M_r_N" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_flex_N = Mu_N/M_r_N</expbody>
        <expresult> = 0.125</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">flexure, M_u / M_r</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_min_N = M_min_N/M_r_N" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_min_N = M_min_N/M_r_N</expbody>
        <expresult> = 0.166</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum steel, M_min / M_r</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_eps_N = 0.005/ε_t_N" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_eps_N = 0.005/ε_t_N</expbody>
        <expresult> = 0.040</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">tension-controlled, 0.005 / ε_t</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Regions P and B: the same equations, collapsed.</paragraph>
    <section name="RegionsPB_Sec5" capture="False" hide="true">
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="a_P = As_P*fy/(α_1*fc*b) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>a_P = As_P*fy/(α_1*fc*b) to in</expbody>
          <expresult> = 1.070 in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">stress block depth</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="a_B = As_B*fy/(α_1*fc*b) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>a_B = As_B*fy/(α_1*fc*b) to in</expbody>
          <expresult> = 1.484 in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">stress block depth</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="c_P = a_P/β_1 to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>c_P = a_P/β_1 to in</expbody>
          <expresult> = 1.380 in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">neutral axis depth</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="c_B = a_B/β_1 to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>c_B = a_B/β_1 to in</expbody>
          <expresult> = 1.915 in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">neutral axis depth</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="M_n_P = As_P*fy*(d_P - a_P/2) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>M_n_P = As_P*fy*(d_P - a_P/2) to kip*ft</expbody>
          <expresult> = 625.431 kip*ft</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">nominal moment</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="M_n_B = As_B*fy*(d_B - a_B/2) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>M_n_B = As_B*fy*(d_B - a_B/2) to kip*ft</expbody>
          <expresult> = 863.984 kip*ft</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">nominal moment</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="M_r_P = φ_f*M_n_P to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>M_r_P = φ_f*M_n_P to kip*ft</expbody>
          <expresult> = 562.888 kip*ft</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored resistance</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="M_r_B = φ_f*M_n_B to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>M_r_B = φ_f*M_n_B to kip*ft</expbody>
          <expresult> = 777.586 kip*ft</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored resistance</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="A_req_P = Mu_P/(φ_f*fy*(d_P - a_P/2)) to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>A_req_P = Mu_P/(φ_f*fy*(d_P - a_P/2)) to in^2</expbody>
          <expresult> = 1.130 in^2</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">steel required for M_u</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="A_req_B = Mu_B/(φ_f*fy*(d_B - a_B/2)) to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>A_req_B = Mu_B/(φ_f*fy*(d_B - a_B/2)) to in^2</expbody>
          <expresult> = 2.611 in^2</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">steel required for M_u</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="M_min_P = Min(M_crm, 1.33*Mu_P) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>M_min_P = Min(M_crm, 1.33*Mu_P) to kip*ft</expbody>
          <expresult> = 211.443 kip*ft</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum factored resistance</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="M_min_B = Min(M_crm, 1.33*Mu_B) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>M_min_B = Min(M_crm, 1.33*Mu_B) to kip*ft</expbody>
          <expresult> = 486.567 kip*ft</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum factored resistance</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="ε_t_P = 0.003*(d_P - c_P)/Max(c_P, 0.000001 in)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>ε_t_P = 0.003*(d_P - c_P)/Max(c_P, 0.000001 in)</expbody>
          <expresult> = 0.066</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">net tensile strain</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="ε_t_B = 0.003*(d_B - c_B)/Max(c_B, 0.000001 in)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>ε_t_B = 0.003*(d_B - c_B)/Max(c_B, 0.000001 in)</expbody>
          <expresult> = 0.047</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">net tensile strain</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="DC_flex_P = Mu_P/M_r_P" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>DC_flex_P = Mu_P/M_r_P</expbody>
          <expresult> = 0.282</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">flexure, M_u / M_r</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="DC_flex_B = Mu_B/M_r_B" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>DC_flex_B = Mu_B/M_r_B</expbody>
          <expresult> = 0.470</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">flexure, M_u / M_r</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="DC_min_P = M_min_P/M_r_P" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>DC_min_P = M_min_P/M_r_P</expbody>
          <expresult> = 0.376</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum steel, M_min / M_r</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="DC_min_B = M_min_B/M_r_B" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>DC_min_B = M_min_B/M_r_B</expbody>
          <expresult> = 0.626</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum steel, M_min / M_r</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="DC_eps_P = 0.005/ε_t_P" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>DC_eps_P = 0.005/ε_t_P</expbody>
          <expresult> = 0.076</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">tension-controlled, 0.005 / ε_t</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="DC_eps_B = 0.005/ε_t_B" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>DC_eps_B = 0.005/ε_t_B</expbody>
          <expresult> = 0.107</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">tension-controlled, 0.005 / ε_t</paragraph>
    </section>
