        </row>
        <row>
          <textcell name="Sec6RegionsR3C0" capture="False" background="#EFF7F1">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">cracked moment of inertia (in^4)</paragraph>
          </textcell>
          <c formula="I_cr_N to in^4" capture="False" background="#EFF7F1">
            <num>12315.846 in^4</num>
          </c>
          <c formula="I_cr_P to in^4" capture="False" background="#EFF7F1">
            <num>20788.287 in^4</num>
          </c>
          <c formula="I_cr_B to in^4" capture="False" background="#EFF7F1">
            <num>27779.567 in^4</num>
          </c>
        </row>
        <row>
          <textcell name="Sec6RegionsR4C0" capture="False" background="#EFF7F1">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">section modulus to the steel (in^3)</paragraph>
          </textcell>
          <c formula="S_s_N to in^3" capture="False" background="#EFF7F1">
