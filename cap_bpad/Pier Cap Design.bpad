    </embed>
    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">6. Service I crack control (LRFD 5.6.7)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="E_c = 120000*0.145^2*(fc/(1 ksi))^0.33*(1 ksi) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>E_c = 120000*0.145^2*(fc/(1 ksi))^0.33*(1 ksi) to ksi</expbody>
        <expresult> = 4428.299 ksi</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">concrete modulus (cap analysis)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="n_m = Round(Es/E_c, 2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>n_m = Round(Es/E_c, 2)</expbody>
        <expresult> = 6.550</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">modular ratio, two decimals</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="f_slim = 0.8*fy to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>f_slim = 0.8*fy to ksi</expbody>
        <expresult> = 48.000 ksi</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">service steel stress limit</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="nA_N = n_m*As_N to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>nA_N = n_m*As_N to in^2</expbody>
        <expresult> = 14.410 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">transformed steel</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="c_cr_N = (-nA_N + Sqrt(nA_N^2 + 2*b*d_N*nA_N))/b to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>c_cr_N = (-nA_N + Sqrt(nA_N^2 + 2*b*d_N*nA_N))/b to in</expbody>
        <expresult> = 4.093 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cracked neutral axis</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="I_cr_N = b*c_cr_N^3/3 + nA_N*(d_N - c_cr_N)^2 to in^4" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>I_cr_N = b*c_cr_N^3/3 + nA_N*(d_N - c_cr_N)^2 to in^4</expbody>
        <expresult> = 12315.846 in^4</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cracked moment of inertia</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="S_s_N = I_cr_N/(d_N - c_cr_N) to in^3" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>S_s_N = I_cr_N/(d_N - c_cr_N) to in^3</expbody>
        <expresult> = 441.392 in^3</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">section modulus to the steel</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="β_s_N = 1 + dc_N/(0.7*(h - dc_N))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>β_s_N = 1 + dc_N/(0.7*(h - dc_N))</expbody>
        <expresult> = 1.179</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">β_s</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="f_sI_N = MI_N*n_m/S_s_N to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>f_sI_N = MI_N*n_m/S_s_N to ksi</expbody>
        <expresult> = 3.902 ksi</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Service I steel stress</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="s_I_N = If(f_sI_N &gt; 0 ksi, 700*γ_e/(β_s_N*f_sI_N/(1 ksi))*(1 in) - 2*dc_N, 1000000 in) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>s_I_N = If(f_sI_N &gt; 0 ksi, 700*γ_e/(β_s_N*f_sI_N/(1 ksi))*(1 in) - 2*dc_N, 1000000 in) to in</expbody>
        <expresult> = 144.191 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">allowable bar spacing, 5.6.7-1</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_I_N = Max(f_sI_N/f_slim, SP_N/s_I_N)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_I_N = Max(f_sI_N/f_slim, SP_N/s_I_N)</expbody>
        <expresult> = 0.081</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">larger of stress / limit and spacing / allowable</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Regions P and B: the same equations, collapsed.</paragraph>
    <section name="RegionsPB_Sec6" capture="False" hide="true">
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="nA_P = n_m*As_P to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>nA_P = n_m*As_P to in^2</expbody>
          <expresult> = 26.200 in^2</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">transformed steel</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="nA_B = n_m*As_B to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>nA_B = n_m*As_B to in^2</expbody>
          <expresult> = 36.352 in^2</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">transformed steel</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="c_cr_P = (-nA_P + Sqrt(nA_P^2 + 2*b*d_P*nA_P))/b to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>c_cr_P = (-nA_P + Sqrt(nA_P^2 + 2*b*d_P*nA_P))/b to in</expbody>
          <expresult> = 5.372 in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cracked neutral axis</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="c_cr_B = (-nA_B + Sqrt(nA_B^2 + 2*b*d_B*nA_B))/b to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>c_cr_B = (-nA_B + Sqrt(nA_B^2 + 2*b*d_B*nA_B))/b to in</expbody>
          <expresult> = 6.232 in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cracked neutral axis</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="I_cr_P = b*c_cr_P^3/3 + nA_P*(d_P - c_cr_P)^2 to in^4" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>I_cr_P = b*c_cr_P^3/3 + nA_P*(d_P - c_cr_P)^2 to in^4</expbody>
          <expresult> = 20788.287 in^4</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cracked moment of inertia</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="I_cr_B = b*c_cr_B^3/3 + nA_B*(d_B - c_cr_B)^2 to in^4" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>I_cr_B = b*c_cr_B^3/3 + nA_B*(d_B - c_cr_B)^2 to in^4</expbody>
          <expresult> = 27779.567 in^4</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cracked moment of inertia</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="S_s_P = I_cr_P/(d_P - c_cr_P) to in^3" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>S_s_P = I_cr_P/(d_P - c_cr_P) to in^3</expbody>
          <expresult> = 786.411 in^3</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">section modulus to the steel</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="S_s_B = I_cr_B/(d_B - c_cr_B) to in^3" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>S_s_B = I_cr_B/(d_B - c_cr_B) to in^3</expbody>
          <expresult> = 1083.271 in^3</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">section modulus to the steel</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="β_s_P = 1 + dc_P/(0.7*(h - dc_P))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>β_s_P = 1 + dc_P/(0.7*(h - dc_P))</expbody>
          <expresult> = 1.188</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">β_s</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="β_s_B = 1 + dc_B/(0.7*(h - dc_B))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>β_s_B = 1 + dc_B/(0.7*(h - dc_B))</expbody>
          <expresult> = 1.185</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">β_s</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="f_sI_P = MI_P*n_m/S_s_P to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>f_sI_P = MI_P*n_m/S_s_P to ksi</expbody>
          <expresult> = 12.191 ksi</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Service I steel stress</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="f_sI_B = MI_B*n_m/S_s_B to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>f_sI_B = MI_B*n_m/S_s_B to ksi</expbody>
          <expresult> = 22.654 ksi</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Service I steel stress</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="s_I_P = If(f_sI_P &gt; 0 ksi, 700*γ_e/(β_s_P*f_sI_P/(1 ksi))*(1 in) - 2*dc_P, 1000000 in) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>s_I_P = If(f_sI_P &gt; 0 ksi, 700*γ_e/(β_s_P*f_sI_P/(1 ksi))*(1 in) - 2*dc_P, 1000000 in) to in</expbody>
          <expresult> = 39.932 in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">allowable bar spacing, 5.6.7-1</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="s_I_B = If(f_sI_B &gt; 0 ksi, 700*γ_e/(β_s_B*f_sI_B/(1 ksi))*(1 in) - 2*dc_B, 1000000 in) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>s_I_B = If(f_sI_B &gt; 0 ksi, 700*γ_e/(β_s_B*f_sI_B/(1 ksi))*(1 in) - 2*dc_B, 1000000 in) to in</expbody>
          <expresult> = 17.833 in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">allowable bar spacing, 5.6.7-1</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="DC_I_P = Max(f_sI_P/f_slim, SP_P/s_I_P)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>DC_I_P = Max(f_sI_P/f_slim, SP_P/s_I_P)</expbody>
          <expresult> = 0.254</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">larger of stress / limit and spacing / allowable</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="DC_I_B = Max(f_sI_B/f_slim, SP_B/s_I_B)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>DC_I_B = Max(f_sI_B/f_slim, SP_B/s_I_B)</expbody>
          <expresult> = 0.472</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">larger of stress / limit and spacing / allowable</paragraph>
    </section>
    <embed spacingbefore="5" spacingafter="8">
      <table name="Sec6Regions" capture="False" colwidths="1:280, 2:80, 3:80, 4:80">
        <stylerule range="A1:D9" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/>
        <stylerule range="A1:D1" horzalign="Center" vertalign="Center"/>
        <stylerule range="B2:D9" horzalign="Center" vertalign="Center"/>
        <row>
          <textcell name="Sec6RegionsR0C0" capture="False" background="#DCECE0">
