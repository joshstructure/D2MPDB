    </embed>
    <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True">8.2 Torsion screen, longitudinal strain and cracking of the compression-half flange</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_vmin = 0.0316*λ*Sqrt(fc/(1 ksi))*(1 ksi)*b/Min(fy, 100 ksi) to in^2/in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_vmin = 0.0316*λ*Sqrt(fc/(1 ksi))*(1 ksi)*b/Min(fy, 100 ksi) to in^2/in</expbody>
        <expresult> = 0.059 in^2/in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum transverse steel, 5.7.2.5-1</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="f_ct = 0.213*λ*Sqrt(fc/(1 ksi))*(1 ksi) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>f_ct = 0.213*λ*Sqrt(fc/(1 ksi))*(1 ksi) to ksi</expbody>
        <expresult> = 0.500 ksi</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">flange cracking stress, C5.4.2.7</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="T_th_S = 0.25*φ_v*0.126*λ*Sqrt(fc/(1 ksi))*(1 ksi)*(b*h)^2/(2*(b + h))*Sqrt(Max(0, 1 - N_S/(b*h)/(0.126*λ*Sqrt(fc/(1 ksi))*(1 ksi)))) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>T_th_S = 0.25*φ_v*0.126*λ*Sqrt(fc/(1 ksi))*(1 ksi)*(b*h)^2/(2*(b + h))*Sqrt(Max(0, 1 - N_S/(b*h)/(0.126*λ*Sqrt(fc/(1 ksi))*(1 ksi)))) to kip*ft</expbody>
        <expresult> = 99.441 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">torsion threshold, 5.7.2.1</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="tor_S = If(T_S &gt; T_th_S, 1, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>tor_S = If(T_S &gt; T_th_S, 1, 0)</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">torsion investigated (1)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_ef_S = If(tor_S &gt; 0, Sqrt(V_S^2 + (0.9*p_h_S*T_S/(2*A_o_S))^2), V_S) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_ef_S = If(tor_S &gt; 0, Sqrt(V_S^2 + (0.9*p_h_S*T_S/(2*A_o_S))^2), V_S) to kip</expbody>
        <expresult> = 217.024 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">effective shear, 5.7.3.4.2-5</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_e_S = Max(Abs(M_S), V_S*d_v) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_e_S = Max(Abs(M_S), V_S*d_v) to kip*ft</expbody>
        <expresult> = 563.078 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">moment for ε: not less than V d_v</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="ε_b_S = (M_e_S/d_v + 0.5*N_S + V_ef_S)/(Es*A_st_S)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>ε_b_S = (M_e_S/d_v + 0.5*N_S + V_ef_S)/(Es*A_st_S)</expbody>
        <expresult> = 0.003</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">longitudinal strain, 5.7.3.4.2-4</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="ok45_S = If(Min(r_adj_S, A_w45_S/L_w45_S) &gt;= A_vmin, 1, 0)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>ok45_S = If(Min(r_adj_S, A_w45_S/L_w45_S) &gt;= A_vmin, 1, 0)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum steel in the 45° window (1)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="okg_S = If(Min(r_adj_S, A_wg_S/L_wg_S) &gt;= A_vmin, 1, 0)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>okg_S = If(Min(r_adj_S, A_wg_S/L_wg_S) &gt;= A_vmin, 1, 0)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum steel in the d_v cot θ window (1)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="simp_S = If(And(N_S &lt;= 0.0000000001 kip, Or(ok45_S &gt; 0, h &lt; 16 in)), 1, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>simp_S = If(And(N_S &lt;= 0.0000000001 kip, Or(ok45_S &gt; 0, h &lt; 16 in)), 1, 0)</expbody>
        <expresult> = 1.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">simplified β = 2, θ = 45° eligible (1), 5.7.3.4.1</paragraph>
