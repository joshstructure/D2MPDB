    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_ymax = Max(1.2, 1.1*Max(DC_flex_N, DC_flex_P, DC_flex_B, DC_min_N, DC_min_P, DC_min_B, DC_eps_N, DC_eps_P, DC_eps_B, DC_I_N, DC_I_P, DC_I_B, DC_shear, DC_LN, DC_LP, DC_LB, DC_minAv, DC_sp, DC_tamax, DC_tsmax, DC_hk))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_ymax = Max(1.2, 1.1*Max(DC_flex_N, DC_flex_P, DC_flex_B, DC_min_N, DC_min_P, DC_min_B, DC_eps_N, DC_eps_P, DC_eps_B, DC_I_N, DC_I_P, DC_I_B, DC_shear, DC_LN, DC_LP, DC_LB, DC_minAv, DC_sp, DC_tamax, DC_tsmax, DC_hk))</expbody>
        <expresult> = 1.200</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">vertical scale of Figure 3</paragraph>
    <embed spacingbefore="4" spacingafter="5">
      <canvas name="DCChart" title="D/C by check" unit="in" size="6.5 in; 3.2 in; scaletofit">
        <include target="Library.Geometry"/>
        <planecontainer origin="0.6,3.05,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#29333D">
