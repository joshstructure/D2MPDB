      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="V_s_B = A_w_B*Min(fy, 100 ksi) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>V_s_B = A_w_B*Min(fy, 100 ksi) to kip</expbody>
          <expresult> = 223.200 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">hoop shear resistance</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="V_r_B = If(okd_B &gt; 0, φ_v*Min(V_c_B + V_s_B, V_lim), 0 kip) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>V_r_B = If(okd_B &gt; 0, φ_v*Min(V_c_B + V_s_B, V_lim), 0 kip) to kip</expbody>
          <expresult> = 400.234 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored shear resistance</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="DC_V_B = Max(V_B/Max(V_r_B, 0.000000001 kip), V_ef_B/φ_v/V_lim)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>DC_V_B = Max(V_B/Max(V_r_B, 0.000000001 kip), V_ef_B/φ_v/V_lim)</expbody>
          <expresult> = 0.539</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shear D/C</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="r_eff_B = A_w_B/L_w_B to in^2/in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>r_eff_B = A_w_B/L_w_B to in^2/in</expbody>
          <expresult> = 0.119 in^2/in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">intersected A_v/s in the window</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="DC_Av_B = A_vmin/Max(r_eff_B, 0.000000001 in^2/in)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>DC_Av_B = A_vmin/Max(r_eff_B, 0.000000001 in^2/in)</expbody>
          <expresult> = 0.496</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum transverse steel D/C</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="β_g_M = 4.8/(1 + 750*ε_s_M)*If(okg_M &gt; 0, 1, 51/(39 + s_xe_M/(1 in)))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>β_g_M = 4.8/(1 + 750*ε_s_M)*If(okg_M &gt; 0, 1, 51/(39 + s_xe_M/(1 in)))</expbody>
          <expresult> = 2.270</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">general β, 5.7.3.4.2-1/-2</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="θ_g_M = (29 + 3500*ε_s_M)*(1 deg) to deg" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>θ_g_M = (29 + 3500*ε_s_M)*(1 deg) to deg</expbody>
          <expresult> = 34.200 deg</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">general θ, 5.7.3.4.2-3</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="cot_g_M = If(θ_g_M &lt; 90 deg, 1/Tan(θ_g_M), 0)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>cot_g_M = If(θ_g_M &lt; 90 deg, 1/Tan(θ_g_M), 0)</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cot θ, general (0 beyond 90°)</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="l_g_M = Max(d_v*cot_g_M, 0.00000001 in) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>l_g_M = Max(d_v*cot_g_M, 0.00000001 in) to in</expbody>
          <expresult> = 45.812 in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">general window length d_v cot θ</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="β_M = If(simp_M &gt; 0, 2, β_g_M)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>β_M = If(simp_M &gt; 0, 2, β_g_M)</expbody>
          <expresult> = 2.000</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">β used</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="θ_M = If(simp_M &gt; 0, 45 deg, θ_g_M) to deg" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>θ_M = If(simp_M &gt; 0, 45 deg, θ_g_M) to deg</expbody>
          <expresult> = 45.000 deg</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">θ used</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="cot_t_M = If(θ_M &lt; 90 deg, 1/Tan(θ_M), 0)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>cot_t_M = If(θ_M &lt; 90 deg, 1/Tan(θ_M), 0)</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cot θ used (0 beyond 90°)</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="okd_M = If(Or(simp_M &gt; 0, ε_s_M &lt;= 0.006), 1, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>okd_M = If(Or(simp_M &gt; 0, ε_s_M &lt;= 0.006), 1, 0)</expbody>
          <expresult> = 1.000</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ε_s within 0.006 (1)</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="V_c_M = 0.0316*λ*β_M*Sqrt(fc/(1 ksi))*(1 ksi)*b*d_v to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>V_c_M = 0.0316*λ*β_M*Sqrt(fc/(1 ksi))*(1 ksi)*b*d_v to kip</expbody>
          <expresult> = 221.505 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">concrete shear, 5.7.3.3-3</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="A_w_M = If(simp_M &gt; 0, A_w45_M, A_wg_M) to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>A_w_M = If(simp_M &gt; 0, A_w45_M, A_wg_M) to in^2</expbody>
          <expresult> = 3.100 in^2</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">hoop steel in the window used</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="L_w_M = If(simp_M &gt; 0, L_w45_M, L_wg_M) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>L_w_M = If(simp_M &gt; 0, L_w45_M, L_wg_M) to in</expbody>
          <expresult> = 31.135 in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">window inside the cap</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="V_s_M = A_w_M*Min(fy, 100 ksi) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>V_s_M = A_w_M*Min(fy, 100 ksi) to kip</expbody>
          <expresult> = 186.000 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">hoop shear resistance</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="V_r_M = If(okd_M &gt; 0, φ_v*Min(V_c_M + V_s_M, V_lim), 0 kip) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>V_r_M = If(okd_M &gt; 0, φ_v*Min(V_c_M + V_s_M, V_lim), 0 kip) to kip</expbody>
          <expresult> = 366.754 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored shear resistance</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="DC_V_M = Max(V_M/Max(V_r_M, 0.000000001 kip), V_ef_M/φ_v/V_lim)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>DC_V_M = Max(V_M/Max(V_r_M, 0.000000001 kip), V_ef_M/φ_v/V_lim)</expbody>
          <expresult> = 0.333</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shear D/C</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="r_eff_M = A_w_M/L_w_M to in^2/in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>r_eff_M = A_w_M/L_w_M to in^2/in</expbody>
          <expresult> = 0.100 in^2/in</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">intersected A_v/s in the window</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="DC_Av_M = A_vmin/Max(r_eff_M, 0.000000001 in^2/in)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>DC_Av_M = A_vmin/Max(r_eff_M, 0.000000001 in^2/in)</expbody>
          <expresult> = 0.595</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum transverse steel D/C</paragraph>
    </section>
    <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True">8.4 Longitudinal tension (LRFD 5.7.3.5-1, 5.7.3.6.3)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_cr_S = Min(A_dw_S*Min(fy, 100 ksi), V_S/φ_v) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_cr_S = Min(A_dw_S*Min(fy, 100 ksi), V_S/φ_v) to kip</expbody>
        <expresult> = 74.400 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">hoop credit, developed steel</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_sh_S = Max(0 kip, V_S/φ_v - 0.5*V_cr_S) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_sh_S = Max(0 kip, V_S/φ_v - 0.5*V_cr_S) to kip</expbody>
        <expresult> = 203.937 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shear part</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_to_S = If(tor_S &gt; 0, 0.45*p_h_S*T_S/(2*A_o_S*φ_v), 0 kip) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_to_S = If(tor_S &gt; 0, 0.45*p_h_S*T_S/(2*A_o_S*φ_v), 0 kip) to kip</expbody>
        <expresult> = 0.000 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">torsion part</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="φ_m_S = If(tor_S &gt; 0, φ_v, φ_f)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>φ_m_S = If(tor_S &gt; 0, φ_v, φ_f)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">φ on the moment term</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="φ_n_S = If(tor_S &gt; 0, φ_v, φ_a)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>φ_n_S = If(tor_S &gt; 0, φ_v, φ_a)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">φ on the axial term</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_mo_S = Abs(M_S)/(φ_m_S*d_v) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_mo_S = Abs(M_S)/(φ_m_S*d_v) to kip</expbody>
        <expresult> = 69.935 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">moment term</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_ax_S = 0.5*N_S/φ_n_S to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_ax_S = 0.5*N_S/φ_n_S to kip</expbody>
        <expresult> = -5.583 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">axial term</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_di_S = cot_t_S*Sqrt(F_sh_S^2 + F_to_S^2) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_di_S = cot_t_S*Sqrt(F_sh_S^2 + F_to_S^2) to kip</expbody>
        <expresult> = 203.937 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">diagonal term</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_req_S = Max(0 kip, F_mo_S + F_ax_S + F_di_S) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_req_S = Max(0 kip, F_mo_S + F_ax_S + F_di_S) to kip</expbody>
        <expresult> = 268.289 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">required tension</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_cap_S = A_st_S*fy to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_cap_S = A_st_S*fy to kip</expbody>
        <expresult> = 345.600 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">tension capacity A_s f_y</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_L_S = F_req_S/F_cap_S" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_L_S = F_req_S/F_cap_S</expbody>
        <expresult> = 0.776</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">longitudinal tension D/C</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Stations N, P, B and M: the same equations, collapsed.</paragraph>
    <section name="StationsNPBM_84" capture="False" hide="true">
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="V_cr_N = Min(A_dw_N*Min(fy, 100 ksi), V_N/φ_v) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>V_cr_N = Min(A_dw_N*Min(fy, 100 ksi), V_N/φ_v) to kip</expbody>
          <expresult> = 37.200 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">hoop credit, developed steel</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="F_sh_N = Max(0 kip, V_N/φ_v - 0.5*V_cr_N) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>F_sh_N = Max(0 kip, V_N/φ_v - 0.5*V_cr_N) to kip</expbody>
          <expresult> = 224.625 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shear part</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="F_to_N = If(tor_N &gt; 0, 0.45*p_h_N*T_N/(2*A_o_N*φ_v), 0 kip) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>F_to_N = If(tor_N &gt; 0, 0.45*p_h_N*T_N/(2*A_o_N*φ_v), 0 kip) to kip</expbody>
          <expresult> = 0.000 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">torsion part</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="φ_m_N = If(tor_N &gt; 0, φ_v, φ_f)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>φ_m_N = If(tor_N &gt; 0, φ_v, φ_f)</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">φ on the moment term</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="φ_n_N = If(tor_N &gt; 0, φ_v, φ_a)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>φ_n_N = If(tor_N &gt; 0, φ_v, φ_a)</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">φ on the axial term</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="F_mo_N = Abs(M_N)/(φ_m_N*d_v) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>F_mo_N = Abs(M_N)/(φ_m_N*d_v) to kip</expbody>
          <expresult> = 7.849 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">moment term</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="F_ax_N = 0.5*N_N/φ_n_N to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>F_ax_N = 0.5*N_N/φ_n_N to kip</expbody>
          <expresult> = -5.583 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">axial term</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="F_di_N = cot_t_N*Sqrt(F_sh_N^2 + F_to_N^2) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>F_di_N = cot_t_N*Sqrt(F_sh_N^2 + F_to_N^2) to kip</expbody>
          <expresult> = 224.625 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">diagonal term</paragraph>
