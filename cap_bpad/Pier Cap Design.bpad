    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">9. Transverse spacing at the governing interval</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6">Governing interval R1-1 → R1-2; V_u and V_eff are the largest at its search stations.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="3" fontweight="bold" spacingbefore="4" keepwithnext="True">Interval data (from the cap analysis)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="s_iv = 3.75 in" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>s_iv = 3.75 in</expbody></dynexp><break type="tab"/>hoop pitch</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="w_iv = 41.375 in" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>w_iv = 41.375 in</expbody></dynexp><break type="tab"/>across-leg spacing</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="r_iv = 0.16533333333333333 in^2/in" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>r_iv = 0.16533333333333333 in^2/in</expbody></dynexp><break type="tab"/>A_v/s of the interval</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="V_ivmax = 5.073625 kip" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>V_ivmax = 5.073625 kip</expbody></dynexp><break type="tab"/>largest V_u</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Vef_ivmax = 5.073625 kip" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>Vef_ivmax = 5.073625 kip</expbody></dynexp><break type="tab"/>largest V_eff</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_iv = Vef_ivmax/(φ_v*b*d_v) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_iv = Vef_ivmax/(φ_v*b*d_v) to ksi</expbody>
        <expresult> = 0.004 ksi</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shear stress, V_eff</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="s_lim = If(v_iv &lt; 0.125*fc, Min(0.8*d_v, 24 in), Min(0.4*d_v, 12 in)) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>s_lim = If(v_iv &lt; 0.125*fc, Min(0.8*d_v, 24 in), Min(0.4*d_v, 12 in)) to in</expbody>
        <expresult> = 24.000 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">maximum spacing, 5.7.2.6</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_o = V_ivmax/(φ_v*b*d_v) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_o = V_ivmax/(φ_v*b*d_v) to ksi</expbody>
        <expresult> = 0.004 ksi</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shear stress, V_u</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_o1 = 0.08*Sqrt(fc/(1 ksi))*(1 ksi) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_o1 = 0.08*Sqrt(fc/(1 ksi))*(1 ksi) to ksi</expbody>
        <expresult> = 0.188 ksi</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">stress below which the across-leg limit is 42 in</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_o2 = 0.16*Sqrt(fc/(1 ksi))*(1 ksi) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_o2 = 0.16*Sqrt(fc/(1 ksi))*(1 ksi) to ksi</expbody>
        <expresult> = 0.375 ksi</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">stress below which the limit is d_v or 24 in</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="w_mid = If(v_o &lt;= v_o2, Min(d_v, 24 in), Min(0.5*d_v, 12 in)) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>w_mid = If(v_o &lt;= v_o2, Min(d_v, 24 in), Min(0.5*d_v, 12 in)) to in</expbody>
        <expresult> = 24.000 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">limit above the 42 in range</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="w_lim = If(v_o &lt;= v_o1, 42 in, w_mid) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>w_lim = If(v_o &lt;= v_o1, 42 in, w_mid) to in</expbody>
        <expresult> = 42.000 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">across-leg limit, SDG 4.1.4C</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_sp = Max(s_iv/s_lim, w_iv/w_lim, A_vmin/r_iv)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_sp = Max(s_iv/s_lim, w_iv/w_lim, A_vmin/r_iv)</expbody>
        <expresult> = 0.985</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">pitch, across-leg spacing and minimum steel</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">10. Face shrinkage and temperature steel, and skin steel</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_tr0 = 1.3*b*h/(2*(b + h)*Min(fy, 75 ksi))*(1 ksi)*(1 in)/(1 ft) to in^2/ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_tr0 = 1.3*b*h/(2*(b + h)*Min(fy, 75 ksi))*(1 ksi)*(1 in)/(1 ft) to in^2/ft</expbody>
        <expresult> = 0.223 in^2/ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">5.10.6-1 (b, h in inches, f_y in ksi)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_tr = Min(Max(A_tr0, 0.11 in^2/ft), 0.6 in^2/ft) to in^2/ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_tr = Min(Max(A_tr0, 0.11 in^2/ft), 0.6 in^2/ft) to in^2/ft</expbody>
        <expresult> = 0.223 in^2/ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">required steel per face, 0.11 to 0.60</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="s_code = If(Min(b, h) &gt; 36 in, 12 in, Max(18 in, 3*Min(b, h))) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>s_code = If(Min(b, h) &gt; 36 in, 12 in, Max(18 in, 3*Min(b, h))) to in</expbody>
        <expresult> = 108.000 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">code spacing limit</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="s_tlim = Min(s_code, s_proj) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>s_tlim = Min(s_code, s_proj) to in</expbody>
        <expresult> = 12.000 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">adopted spacing limit</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6">Faces and directions checked (11). Faces are numbered 1 to 11 in the tables below.</paragraph>
    <embed spacingbefore="5" spacingafter="8">
      <table name="FaceInputs" capture="False" colwidths="1:170, 2:175, 3:175">
        <stylerule range="A1:C12" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#A78638&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#A78638&quot;);"/>
        <stylerule range="A1:C1" horzalign="Center" vertalign="Center"/>
        <stylerule range="B2:C12" horzalign="Center" vertalign="Center"/>
        <row>
          <textcell name="FaceInputsR0C0" capture="False" background="#F7E6B9">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Face</paragraph>
          </textcell>
          <textcell name="FaceInputsR0C1" capture="False" background="#F7E6B9">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">A_tp (in^2/ft)</paragraph>
          </textcell>
          <textcell name="FaceInputsR0C2" capture="False" background="#F7E6B9">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">s_tp (in)</paragraph>
          </textcell>
        </row>
        <row>
          <textcell name="FaceInputsR1C0" capture="False" background="#FFF8E9">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Top long.</paragraph>
          </textcell>
          <textcell name="FaceInputsR1C1" capture="False" background="#FFF8E9">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="2">
              <dynexp formula="A_tp_1 = 0.55 in^2/ft" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input">
                <expbody>A_tp_1 = 0.55 in^2/ft</expbody>
              </dynexp>
            </paragraph>
          </textcell>
          <textcell name="FaceInputsR1C2" capture="False" background="#FFF8E9">
