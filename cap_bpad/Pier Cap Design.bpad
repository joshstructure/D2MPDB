          <expbody>simp_B = If(And(N_B &lt;= 0.0000000001 kip, Or(ok45_B &gt; 0, h &lt; 16 in)), 1, 0)</expbody>
          <expresult> = 1.000</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">simplified β = 2, θ = 45° eligible (1), 5.7.3.4.1</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="F_fl_B = 0.5*N_B + V_ef_B - Abs(M_B)/d_v to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>F_fl_B = 0.5*N_B + V_ef_B - Abs(M_B)/d_v to kip</expbody>
          <expresult> = 104.347 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">compression-half flange force, C5.7.3.4.2</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="f_fl_B = F_fl_B*E_c/(E_c*A_cc_B + Es*A_cs_B) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>f_fl_B = F_fl_B*E_c/(E_c*A_cc_B + Es*A_cs_B) to ksi</expbody>
          <expresult> = 0.118 ksi</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">flange tensile stress</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="crk_B = If(And(N_B &gt; 0.0000000001 kip, f_fl_B &gt;= f_ct), 1, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>crk_B = If(And(N_B &gt; 0.0000000001 kip, f_fl_B &gt;= f_ct), 1, 0)</expbody>
          <expresult> = 0.000</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">flange cracked: ε doubles (1)</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="ε_s_B = Max(0, ε_b_B)*If(crk_B &gt; 0, 2, 1)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>ε_s_B = Max(0, ε_b_B)*If(crk_B &gt; 0, 2, 1)</expbody>
          <expresult> = 0.003</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strain ε_s</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="T_th_M = 0.25*φ_v*0.126*λ*Sqrt(fc/(1 ksi))*(1 ksi)*(b*h)^2/(2*(b + h))*Sqrt(Max(0, 1 - N_M/(b*h)/(0.126*λ*Sqrt(fc/(1 ksi))*(1 ksi)))) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>T_th_M = 0.25*φ_v*0.126*λ*Sqrt(fc/(1 ksi))*(1 ksi)*(b*h)^2/(2*(b + h))*Sqrt(Max(0, 1 - N_M/(b*h)/(0.126*λ*Sqrt(fc/(1 ksi))*(1 ksi)))) to kip*ft</expbody>
          <expresult> = 99.441 kip*ft</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">torsion threshold, 5.7.2.1</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="tor_M = If(T_M &gt; T_th_M, 1, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>tor_M = If(T_M &gt; T_th_M, 1, 0)</expbody>
          <expresult> = 0.000</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">torsion investigated (1)</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="V_ef_M = If(tor_M &gt; 0, Sqrt(V_M^2 + (0.9*p_h_M*T_M/(2*A_o_M))^2), V_M) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>V_ef_M = If(tor_M &gt; 0, Sqrt(V_M^2 + (0.9*p_h_M*T_M/(2*A_o_M))^2), V_M) to kip</expbody>
          <expresult> = 122.026 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">effective shear, 5.7.3.4.2-5</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="M_e_M = Max(Abs(M_M), V_M*d_v) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>M_e_M = Max(Abs(M_M), V_M*d_v) to kip*ft</expbody>
          <expresult> = 316.602 kip*ft</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">moment for ε: not less than V d_v</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="ε_b_M = (M_e_M/d_v + 0.5*N_M + V_ef_M)/(Es*A_st_M)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>ε_b_M = (M_e_M/d_v + 0.5*N_M + V_ef_M)/(Es*A_st_M)</expbody>
          <expresult> = 0.001</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">longitudinal strain, 5.7.3.4.2-4</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="ok45_M = If(Min(r_adj_M, A_w45_M/L_w45_M) &gt;= A_vmin, 1, 0)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>ok45_M = If(Min(r_adj_M, A_w45_M/L_w45_M) &gt;= A_vmin, 1, 0)</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum steel in the 45° window (1)</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="okg_M = If(Min(r_adj_M, A_wg_M/L_wg_M) &gt;= A_vmin, 1, 0)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>okg_M = If(Min(r_adj_M, A_wg_M/L_wg_M) &gt;= A_vmin, 1, 0)</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum steel in the d_v cot θ window (1)</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="simp_M = If(And(N_M &lt;= 0.0000000001 kip, Or(ok45_M &gt; 0, h &lt; 16 in)), 1, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>simp_M = If(And(N_M &lt;= 0.0000000001 kip, Or(ok45_M &gt; 0, h &lt; 16 in)), 1, 0)</expbody>
          <expresult> = 1.000</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">simplified β = 2, θ = 45° eligible (1), 5.7.3.4.1</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="F_fl_M = 0.5*N_M + V_ef_M - Abs(M_M)/d_v to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>F_fl_M = 0.5*N_M + V_ef_M - Abs(M_M)/d_v to kip</expbody>
          <expresult> = 59.610 kip</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">compression-half flange force, C5.7.3.4.2</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="f_fl_M = F_fl_M*E_c/(E_c*A_cc_M + Es*A_cs_M) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>f_fl_M = F_fl_M*E_c/(E_c*A_cc_M + Es*A_cs_M) to ksi</expbody>
          <expresult> = 0.067 ksi</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">flange tensile stress</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="crk_M = If(And(N_M &gt; 0.0000000001 kip, f_fl_M &gt;= f_ct), 1, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>crk_M = If(And(N_M &gt; 0.0000000001 kip, f_fl_M &gt;= f_ct), 1, 0)</expbody>
          <expresult> = 0.000</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">flange cracked: ε doubles (1)</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="ε_s_M = Max(0, ε_b_M)*If(crk_M &gt; 0, 2, 1)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>ε_s_M = Max(0, ε_b_M)*If(crk_M &gt; 0, 2, 1)</expbody>
          <expresult> = 0.001</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strain ε_s</paragraph>
    </section>
    <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True">8.3 Shear resistance (LRFD 5.7.3.3, 5.7.3.4; FDOT SDG 4.1.4A intersected legs)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="β_g_S = 4.8/(1 + 750*ε_s_S)*If(okg_S &gt; 0, 1, 51/(39 + s_xe_S/(1 in)))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>β_g_S = 4.8/(1 + 750*ε_s_S)*If(okg_S &gt; 0, 1, 51/(39 + s_xe_S/(1 in)))</expbody>
        <expresult> = 1.640</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">general β, 5.7.3.4.2-1/-2</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="θ_g_S = (29 + 3500*ε_s_S)*(1 deg) to deg" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>θ_g_S = (29 + 3500*ε_s_S)*(1 deg) to deg</expbody>
        <expresult> = 37.989 deg</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">general θ, 5.7.3.4.2-3</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="cot_g_S = If(θ_g_S &lt; 90 deg, 1/Tan(θ_g_S), 0)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>cot_g_S = If(θ_g_S &lt; 90 deg, 1/Tan(θ_g_S), 0)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cot θ, general (0 beyond 90°)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="l_g_S = Max(d_v*cot_g_S, 0.00000001 in) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>l_g_S = Max(d_v*cot_g_S, 0.00000001 in) to in</expbody>
        <expresult> = 39.866 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">general window length d_v cot θ</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="β_S = If(simp_S &gt; 0, 2, β_g_S)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>β_S = If(simp_S &gt; 0, 2, β_g_S)</expbody>
        <expresult> = 2.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">β used</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="θ_S = If(simp_S &gt; 0, 45 deg, θ_g_S) to deg" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>θ_S = If(simp_S &gt; 0, 45 deg, θ_g_S) to deg</expbody>
        <expresult> = 45.000 deg</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">θ used</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="cot_t_S = If(θ_S &lt; 90 deg, 1/Tan(θ_S), 0)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>cot_t_S = If(θ_S &lt; 90 deg, 1/Tan(θ_S), 0)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cot θ used (0 beyond 90°)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="okd_S = If(Or(simp_S &gt; 0, ε_s_S &lt;= 0.006), 1, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>okd_S = If(Or(simp_S &gt; 0, ε_s_S &lt;= 0.006), 1, 0)</expbody>
        <expresult> = 1.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ε_s within 0.006 (1)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_c_S = 0.0316*λ*β_S*Sqrt(fc/(1 ksi))*(1 ksi)*b*d_v to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_c_S = 0.0316*λ*β_S*Sqrt(fc/(1 ksi))*(1 ksi)*b*d_v to kip</expbody>
        <expresult> = 221.505 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">concrete shear, 5.7.3.3-3</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_w_S = If(simp_S &gt; 0, A_w45_S, A_wg_S) to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_w_S = If(simp_S &gt; 0, A_w45_S, A_wg_S) to in^2</expbody>
        <expresult> = 3.100 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">hoop steel in the window used</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="L_w_S = If(simp_S &gt; 0, L_w45_S, L_wg_S) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>L_w_S = If(simp_S &gt; 0, L_w45_S, L_wg_S) to in</expbody>
        <expresult> = 31.135 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">window inside the cap</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_s_S = A_w_S*Min(fy, 100 ksi) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_s_S = A_w_S*Min(fy, 100 ksi) to kip</expbody>
        <expresult> = 186.000 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">hoop shear resistance</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_lim = 0.25*fc*b*d_v to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_lim = 0.25*fc*b*d_v to kip</expbody>
        <expresult> = 2054.882 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">upper limit 0.25 f′c b d_v</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_r_S = If(okd_S &gt; 0, φ_v*Min(V_c_S + V_s_S, V_lim), 0 kip) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_r_S = If(okd_S &gt; 0, φ_v*Min(V_c_S + V_s_S, V_lim), 0 kip) to kip</expbody>
        <expresult> = 366.754 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored shear resistance</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_V_S = Max(V_S/Max(V_r_S, 0.000000001 kip), V_ef_S/φ_v/V_lim)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_V_S = Max(V_S/Max(V_r_S, 0.000000001 kip), V_ef_S/φ_v/V_lim)</expbody>
        <expresult> = 0.592</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shear D/C</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="r_eff_S = A_w_S/L_w_S to in^2/in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>r_eff_S = A_w_S/L_w_S to in^2/in</expbody>
        <expresult> = 0.100 in^2/in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">intersected A_v/s in the window</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_Av_S = A_vmin/Max(r_eff_S, 0.000000001 in^2/in)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_Av_S = A_vmin/Max(r_eff_S, 0.000000001 in^2/in)</expbody>
        <expresult> = 0.595</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum transverse steel D/C</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Stations N, P, B and M: the same equations, collapsed.</paragraph>
    <section name="StationsNPBM_83" capture="False" hide="true">
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="β_g_N = 4.8/(1 + 750*ε_s_N)*If(okg_N &gt; 0, 1, 51/(39 + s_xe_N/(1 in)))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>β_g_N = 4.8/(1 + 750*ε_s_N)*If(okg_N &gt; 0, 1, 51/(39 + s_xe_N/(1 in)))</expbody>
          <expresult> = 1.254</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">general β, 5.7.3.4.2-1/-2</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="θ_g_N = (29 + 3500*ε_s_N)*(1 deg) to deg" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>θ_g_N = (29 + 3500*ε_s_N)*(1 deg) to deg</expbody>
          <expresult> = 42.190 deg</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">general θ, 5.7.3.4.2-3</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="cot_g_N = If(θ_g_N &lt; 90 deg, 1/Tan(θ_g_N), 0)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>cot_g_N = If(θ_g_N &lt; 90 deg, 1/Tan(θ_g_N), 0)</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">cot θ, general (0 beyond 90°)</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="l_g_N = Max(d_v*cot_g_N, 0.00000001 in) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>l_g_N = Max(d_v*cot_g_N, 0.00000001 in) to in</expbody>
