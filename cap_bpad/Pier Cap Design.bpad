    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="MI_P = 121.97 kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>MI_P = 121.97 kip*ft</expbody></dynexp><break type="tab"/>Service I moment, P</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Mu_B = 365.84 kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>Mu_B = 365.84 kip*ft</expbody></dynexp><break type="tab"/>Strength moment, B</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="MI_B = 312.22 kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>MI_B = 312.22 kip*ft</expbody></dynexp><break type="tab"/>Service I moment, B</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="3" fontweight="bold" spacingbefore="4" keepwithnext="True">Reinforcement</paragraph>
