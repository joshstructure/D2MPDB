          <textcell name="Sec6RegionsR0C3" capture="False" background="#DCECE0">
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">B</paragraph>
          </textcell>
        </row>
        <row>
          <textcell name="Sec6RegionsR1C0" capture="False" background="#EFF7F1">
