    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Status = If(Or(DC_govern &gt; 1, DC_flex_A &gt; 1, DC_flex_B &gt; 1, DC_minflex_A &gt; 1, DC_minflex_B &gt; 1, DC_shear_A &gt; 1, DC_interface &gt; 1, DC_interface_min &gt; 1, DC_crack_A &gt; 1, DC_crack_B &gt; 1, DC_fss_A &gt; 1, DC_fss_B &gt; 1, DC_develop &gt; 1, DC_temp_v &gt; 1, DC_temp_h &gt; 1, DC_space_v &gt; 1, DC_space_h &gt; 1, DC_clear &gt; 1, DC_cover &gt; 1, DC_thick &gt; 1), &quot;⊗ There are FAILURES&quot;, &quot;✓ All Checks Pass&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>Status = If(Or(DC_govern &gt; 1, DC_flex_A &gt; 1, DC_flex_B &gt; 1, DC_minflex_A &gt; 1, DC_minflex_B &gt; 1, DC_shear_A &gt; 1, DC_interface &gt; 1, DC_interface_min &gt; 1, DC_crack_A &gt; 1, DC_crack_B &gt; 1, DC_fss_A &gt; 1, DC_fss_B &gt; 1, DC_develop &gt; 1, DC_temp_v &gt; 1, DC_temp_h &gt; 1, DC_space_v &gt; 1, DC_space_h &gt; 1, DC_clear &gt; 1, DC_cover &gt; 1, DC_thick &gt; 1), "⊗ There are FAILURES", "✓ All Checks Pass")</expbody>
        <expresult> = ✓ All Checks Pass</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Overall status of the recomputed numerical checks.</paragraph>
