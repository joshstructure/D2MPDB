      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Trial leg rounded up to the next 1/16 in [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0483 = v_0092 + (2 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0483 = v_0092 + (2 - 1)*v_0006</expbody>
        <expresult> = 79.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 2 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0484 = v_0092 + (2 - 1.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0484 = v_0092 + (2 - 1.5)*v_0006</expbody>
        <expresult> = 49.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 2 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0485 = v_0092 + (2 - 0.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0485 = v_0092 + (2 - 0.5)*v_0006</expbody>
        <expresult> = 109.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 2 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0486 = v_0485 - v_0484" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0486 = v_0485 - v_0484</expbody>
        <expresult> = 60.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 2 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0487 = v_0486*v_0454*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0487 = v_0486*v_0454*v_0003/1728</expbody>
        <expresult> = 45.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 2 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0488 = v_0021*v_0487" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0488 = v_0021*v_0487</expbody>
        <expresult> = 6.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 2 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0489 = v_0022*v_0488" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0489 = v_0022*v_0488</expbody>
        <expresult> = 8.438</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 2 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0490 = (v_0484 + v_0485)/2 - v_0483" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0490 = (v_0484 + v_0485)/2 - v_0483</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Retained for whole-wall equilibrium; carried by the wall, not the ring [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0491 = v_0489*(Abs(v_0490) + v_0011)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0491 = v_0489*(Abs(v_0490) + v_0011)</expbody>
        <expresult> = 25.312</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Superseded tributary-eccentricity basis (D-070); comparison only [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0492 = v_0455*v_0107*v_0112*Abs(v_0483 - v_0109)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0492 = v_0455*v_0107*v_0112*Abs(v_0483 - v_0109)</expbody>
        <expresult> = 0.121</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Rigid-body axial redistribution; sign taken to increase the ring force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0493 = v_0489 + v_0492" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0493 = v_0489 + v_0492</expbody>
        <expresult> = 8.558</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 2 design force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0494 = v_0114/v_0493" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0494 = v_0114/v_0493</expbody>
        <expresult> = 0.631</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0495 = v_0493/v_0073" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0495 = v_0493/v_0073</expbody>
        <expresult> = 0.105</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 2 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0496 = v_0114*v_0070/v_0074" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0496 = v_0114*v_0070/v_0074</expbody>
        <expresult> = 0.013</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 2 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0497 = v_0495 + v_0496" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0497 = v_0495 + v_0496</expbody>
        <expresult> = 0.118</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 2 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0498 = v_0495 - v_0496" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0498 = v_0495 - v_0496</expbody>
        <expresult> = 0.092</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 2 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0499 = v_0497*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0499 = v_0497*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)</expbody>
        <expresult> = 0.140</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0500 = v_0497*(v_0070^2 - v_0072^2)/(2*v_0068)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0500 = v_0497*(v_0070^2 - v_0072^2)/(2*v_0068)</expbody>
        <expresult> = 0.153</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 2 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0501 = Sqrt(6*v_0499/(v_0040*v_0035))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0501 = Sqrt(6*v_0499/(v_0040*v_0035))</expbody>
        <expresult> = 0.130</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 2 thickness bending [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0502 = v_0500/(v_0042*0.58*v_0035)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0502 = v_0500/(v_0042*0.58*v_0035)</expbody>
        <expresult> = 0.005</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 2 thickness shear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0503 = Max(v_0501, v_0502, v_0037 + 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0503 = Max(v_0501, v_0502, v_0037 + 0.0625)</expbody>
        <expresult> = 0.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Bending, shear and conservative weld-edge allowance; revise/recalculate after selecting thickness [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0504 = v_0499/v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0504 = v_0499/v_0034</expbody>
        <expresult> = 0.280</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Top/bottom weld couple separated conservatively by plate thickness [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0505 = Sqrt((v_0500/2)^2 + v_0504^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0505 = Sqrt((v_0500/2)^2 + v_0504^2)</expbody>
        <expresult> = 0.290</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Per fillet: half vertical shear + full radial couple force [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0506 = v_0071 + Sqrt(2)*v_0505/(v_0041*0.6*v_0038)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0506 = v_0071 + Sqrt(2)*v_0505/(v_0041*0.6*v_0038)</expbody>
        <expresult> = 0.075</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 2 weld strength leg [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0507 = Max(v_0506, v_0085)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0507 = Max(v_0506, v_0085)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength and minimum detailing; revise/recalculate after selecting weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0508 = Round(16*v_0507, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0508 = Round(16*v_0507, 0)</expbody>
        <expresult> = 4.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Nearest whole number of sixteenths [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0509 = If(v_0508 &gt;= 16*v_0507, v_0508, v_0508 + 1)/16" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0509 = If(v_0508 &gt;= 16*v_0507, v_0508, v_0508 + 1)/16</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Trial leg rounded up to the next 1/16 in [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0510 = v_0092 + (3 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0510 = v_0092 + (3 - 1)*v_0006</expbody>
        <expresult> = 139.500</expresult>
