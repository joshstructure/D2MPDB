      <dynexp formula="v_0511 = v_0092 + (3 - 1.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0511 = v_0092 + (3 - 1.5)*v_0006</expbody>
        <expresult> = 109.500</expresult>
