      <dynexp formula="v_0575 = v_0573*((v_0068^3 - v_0070^3)/(3*v_0066) - (v_0068^2 - v_0070^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0575 = v_0573*((v_0068^3 - v_0070^3)/(3*v_0066) - (v_0068^2 - v_0070^2)/2)</expbody>
