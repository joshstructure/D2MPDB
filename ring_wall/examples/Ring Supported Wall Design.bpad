      <dynexp formula="v_0513 = v_0512 - v_0511" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0513 = v_0512 - v_0511</expbody>
        <expresult> = 60.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 3 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0514 = v_0513*v_0454*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0514 = v_0513*v_0454*v_0003/1728</expbody>
        <expresult> = 45.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 3 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0515 = v_0021*v_0514" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0515 = v_0021*v_0514</expbody>
        <expresult> = 6.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 3 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0516 = v_0022*v_0515" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0516 = v_0022*v_0515</expbody>
        <expresult> = 8.438</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 3 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0517 = (v_0511 + v_0512)/2 - v_0510" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0517 = (v_0511 + v_0512)/2 - v_0510</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Retained for whole-wall equilibrium; carried by the wall, not the ring [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0518 = v_0516*(Abs(v_0517) + v_0011)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0518 = v_0516*(Abs(v_0517) + v_0011)</expbody>
        <expresult> = 25.312</expresult>
