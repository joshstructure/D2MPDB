        <expresult> = 0.419</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0492 = v_0490/v_0071" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0492 = v_0490/v_0071</expbody>
        <expresult> = 0.105</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 3 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0493 = v_0112*v_0068/v_0072" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0493 = v_0112*v_0068/v_0072</expbody>
        <expresult> = 0.009</expresult>
