    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">total service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0103 = v_0022*v_0102" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0103 = v_0022*v_0102</expbody>
        <expresult> = 166.699</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">total factored [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0104 = v_0068 - v_0008" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0104 = v_0068 - v_0008</expbody>
        <expresult> = 9.525</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Effective pipe wall [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0105 = v_0044*(v_0068^2 - v_0104^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0105 = v_0044*(v_0068^2 - v_0104^2)</expbody>
        <expresult> = 29.136</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">pipe area [in²]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0106 = v_0044*(v_0068^4 - v_0104^4)/4" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0106 = v_0044*(v_0068^4 - v_0104^4)/4</expbody>
        <expresult> = 1389.260</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">pipe inertia [in⁴]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0107 = v_0105*v_0012/v_0014" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0107 = v_0105*v_0012/v_0014</expbody>
        <expresult> = 1408.255</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Axial spring over the entered effective length [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0108 = 4*v_0012*v_0106/v_0013" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0108 = 4*v_0012*v_0106/v_0013</expbody>
        <expresult> = 1744092.836</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Head translation restrained; bound of the fixed-base cantilever family [kip-in/rad]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0109 = v_0092 + (v_0005 - 1)*v_0006/2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0109 = v_0092 + (v_0005 - 1)*v_0006/2</expbody>
        <expresult> = 109.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">group centroid [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0110 = v_0006^2*v_0005*(v_0005^2 - 1)/12" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0110 = v_0006^2*v_0005*(v_0005^2 - 1)/12</expbody>
        <expresult> = 18000.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Equally spaced piles; zero for one pile [in²]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0111 = v_0103*v_0011/(v_0107*v_0110 + v_0005*v_0108)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0111 = v_0103*v_0011/(v_0107*v_0110 + v_0005*v_0108)</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
