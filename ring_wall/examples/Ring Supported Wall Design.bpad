    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0267 = Max(v_0265, v_0266, v_0037 + 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0267 = Max(v_0265, v_0266, v_0037 + 0.0625)</expbody>
        <expresult> = 0.375</expresult>
