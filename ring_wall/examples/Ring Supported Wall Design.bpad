    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 4 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0427 = v_0002" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0427 = v_0002</expbody>
        <expresult> = 219.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 4 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0428 = v_0427 - v_0426" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0428 = v_0427 - v_0426</expbody>
        <expresult> = 49.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 4 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0429 = v_0428*v_0342*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0429 = v_0428*v_0342*v_0003/1728</expbody>
        <expresult> = 37.125</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 4 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0430 = v_0021*v_0429" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0430 = v_0021*v_0429</expbody>
        <expresult> = 5.569</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 4 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0431 = v_0022*v_0430" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0431 = v_0022*v_0430</expbody>
        <expresult> = 6.961</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 4 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0432 = (v_0426 + v_0427)/2 - v_0425" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0432 = (v_0426 + v_0427)/2 - v_0425</expbody>
        <expresult> = -5.250</expresult>
