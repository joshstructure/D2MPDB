    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 5 3 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0623 = v_0622 - v_0621" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0623 = v_0622 - v_0621</expbody>
        <expresult> = 60.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 5 3 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0624 = v_0623*v_0564*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0624 = v_0623*v_0564*v_0003/1728</expbody>
        <expresult> = 78.578</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 5 3 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0625 = v_0021*v_0624" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0625 = v_0021*v_0624</expbody>
        <expresult> = 11.787</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 5 3 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0626 = v_0022*v_0625" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0626 = v_0022*v_0625</expbody>
        <expresult> = 14.733</expresult>
