    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0651 = v_0650*v_0564*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0651 = v_0650*v_0564*v_0003/1728</expbody>
        <expresult> = 64.827</expresult>
