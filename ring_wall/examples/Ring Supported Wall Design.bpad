        <expbody>v_0638 = Sqrt(6*v_0636/(v_0040*v_0035))</expbody>
        <expresult> = 0.167</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 5 3 thickness bending [in]</paragraph>
