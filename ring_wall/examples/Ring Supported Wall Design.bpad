      <dynexp formula="v_0376 = v_0021*v_0375" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0376 = v_0021*v_0375</expbody>
        <expresult> = 6.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 2 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0377 = v_0022*v_0376" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0377 = v_0022*v_0376</expbody>
        <expresult> = 8.438</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 2 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0378 = (v_0372 + v_0373)/2 - v_0371" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0378 = (v_0372 + v_0373)/2 - v_0371</expbody>
        <expresult> = 0.000</expresult>
