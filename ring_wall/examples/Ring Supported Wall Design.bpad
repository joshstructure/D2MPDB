      <dynexp formula="v_0127 = v_0017*v_0126" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0127 = v_0017*v_0126</expbody>
        <expresult> = 4.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0128 = v_0018*v_0127" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0128 = v_0018*v_0127</expbody>
        <expresult> = 5.625</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0129 = (v_0123 + v_0124)/2 - v_0122" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0129 = (v_0123 + v_0124)/2 - v_0122</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 eccentricity [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0130 = Abs(v_0129) + v_0011" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0130 = Abs(v_0129) + v_0011</expbody>
        <expresult> = 3.000</expresult>
