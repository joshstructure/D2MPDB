      <dynexp formula="v_0637 = v_0634*(v_0068^2 - v_0070^2)/(2*v_0066)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0637 = v_0634*(v_0068^2 - v_0070^2)/(2*v_0066)</expbody>
        <expresult> = 0.254</expresult>
