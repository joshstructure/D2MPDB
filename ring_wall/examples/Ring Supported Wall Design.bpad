    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 2 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0374 = v_0373 - v_0372" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0374 = v_0373 - v_0372</expbody>
        <expresult> = 60.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 2 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0375 = v_0374*v_0342*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0375 = v_0374*v_0342*v_0003/1728</expbody>
        <expresult> = 45.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 2 volume [ft³]</paragraph>
