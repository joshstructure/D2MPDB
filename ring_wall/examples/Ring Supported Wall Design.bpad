    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 1 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0471 = v_0468 - v_0469" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0471 = v_0468 - v_0469</expbody>
        <expresult> = 0.077</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 1 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0472 = v_0470*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0472 = v_0470*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)</expbody>
        <expresult> = 0.122</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0473 = v_0470*(v_0070^2 - v_0072^2)/(2*v_0068)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0473 = v_0470*(v_0070^2 - v_0072^2)/(2*v_0068)</expbody>
        <expresult> = 0.133</expresult>
      </dynexp>
