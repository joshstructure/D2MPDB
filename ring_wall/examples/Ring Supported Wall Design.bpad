        <expresult> = 0.362</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Rigid-body axial redistribution; sign taken to increase the ring force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0466 = v_0462 + v_0465" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0466 = v_0462 + v_0465</expbody>
        <expresult> = 7.323</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 1 design force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0467 = v_0114/v_0466" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0467 = v_0114/v_0466</expbody>
        <expresult> = 0.737</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0468 = v_0466/v_0073" mathlayout="on" showformula="True" showresult="True" showsteps="False">
