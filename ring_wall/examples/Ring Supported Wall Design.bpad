      <dynexp formula="v_0231 = v_0221*v_0105*v_0110*Abs(v_0222 - v_0107)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0231 = v_0221*v_0105*v_0110*Abs(v_0222 - v_0107)</expbody>
