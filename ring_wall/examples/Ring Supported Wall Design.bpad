    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Nearest whole number of sixteenths [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0482 = If(v_0481 &gt;= 16*v_0480, v_0481, v_0481 + 1)/16" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0482 = If(v_0481 &gt;= 16*v_0480, v_0481, v_0481 + 1)/16</expbody>
