    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bottom ring cover [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0092 = v_0004 - v_0019 - (v_0021 - 1)*v_0020 - v_0033" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0092 = v_0004 - v_0019 - (v_0021 - 1)*v_0020 - v_0033</expbody>
        <expresult> = 22.062</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">top ring cover [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0093 = v_0006 - v_0029 - 2*v_0011" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0093 = v_0006 - v_0029 - 2*v_0011</expbody>
        <expresult> = 31.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">between rings [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0094 = v_0017*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0094 = v_0017*v_0003/1728</expbody>
        <expresult> = 0.003</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Gross concrete prism; no pipe/plate displacement deduction [kip/in²]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0095 = v_0018*v_0094" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0095 = v_0018*v_0094</expbody>
        <expresult> = 0.004</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored density [kip/in²]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0096 = 0" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0096 = 0</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 1 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0097 = v_0019 + (1 - 0.5)*v_0020" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0097 = v_0019 + (1 - 0.5)*v_0020</expbody>
        <expresult> = 24.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 1 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0098 = v_0097 - v_0096" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0098 = v_0097 - v_0096</expbody>
        <expresult> = 24.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 1 height [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0099 = v_0086 + (1 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0099 = v_0086 + (1 - 1)*v_0006</expbody>
        <expresult> = 16.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0100 = 0" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0100 = 0</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0101 = v_0086 + (1 - 0.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0101 = v_0086 + (1 - 0.5)*v_0006</expbody>
        <expresult> = 46.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0102 = v_0101 - v_0100" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0102 = v_0101 - v_0100</expbody>
        <expresult> = 46.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0103 = v_0102*v_0098*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0103 = v_0102*v_0098*v_0003/1728</expbody>
        <expresult> = 23.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0104 = v_0017*v_0103" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0104 = v_0017*v_0103</expbody>
        <expresult> = 3.487</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0105 = v_0018*v_0104" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0105 = v_0018*v_0104</expbody>
        <expresult> = 4.359</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0106 = (v_0100 + v_0101)/2 - v_0099" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0106 = (v_0100 + v_0101)/2 - v_0099</expbody>
        <expresult> = 6.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 eccentricity [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0107 = Abs(v_0106) + v_0011" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0107 = Abs(v_0106) + v_0011</expbody>
        <expresult> = 9.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Worst radial tolerance plus nominal centroid offset [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0108 = v_0105*v_0107" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0108 = v_0105*v_0107</expbody>
        <expresult> = 42.504</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 moment [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0109 = v_0105/v_0067" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0109 = v_0105/v_0067</expbody>
        <expresult> = 0.054</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0110 = v_0108*v_0064/v_0068" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0110 = v_0108*v_0064/v_0068</expbody>
        <expresult> = 0.101</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0111 = v_0109 + v_0110" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0111 = v_0109 + v_0110</expbody>
        <expresult> = 0.154</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0112 = v_0109 - v_0110" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0112 = v_0109 - v_0110</expbody>
        <expresult> = -0.047</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0113 = v_0111*((v_0064^3 - v_0066^3)/(3*v_0062) - (v_0064^2 - v_0066^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0113 = v_0111*((v_0064^3 - v_0066^3)/(3*v_0062) - (v_0064^2 - v_0066^2)/2)</expbody>
        <expresult> = 0.183</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0114 = v_0111*(v_0064^2 - v_0066^2)/(2*v_0062)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0114 = v_0111*(v_0064^2 - v_0066^2)/(2*v_0062)</expbody>
        <expresult> = 0.200</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0115 = Sqrt(6*v_0113/(v_0036*v_0031))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0115 = Sqrt(6*v_0113/(v_0036*v_0031))</expbody>
        <expresult> = 0.148</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 thickness bending [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0116 = v_0114/(v_0038*0.58*v_0031)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0116 = v_0114/(v_0038*0.58*v_0031)</expbody>
        <expresult> = 0.007</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 thickness shear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0117 = Max(v_0115, v_0116, v_0033 + 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0117 = Max(v_0115, v_0116, v_0033 + 0.0625)</expbody>
        <expresult> = 0.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Bending, shear and conservative weld-edge allowance; revise/recalculate after selecting thickness [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0118 = v_0113/v_0030" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0118 = v_0113/v_0030</expbody>
        <expresult> = 0.244</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Top/bottom weld couple separated conservatively by plate thickness [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0119 = Sqrt((v_0114/2)^2 + v_0118^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0119 = Sqrt((v_0114/2)^2 + v_0118^2)</expbody>
        <expresult> = 0.264</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Per fillet: half vertical shear + full radial couple force [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0120 = v_0065 + Sqrt(2)*v_0119/(v_0037*0.6*v_0034)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0120 = v_0065 + Sqrt(2)*v_0119/(v_0037*0.6*v_0034)</expbody>
        <expresult> = 0.074</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 weld strength leg [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0121 = Max(v_0120, v_0079)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0121 = Max(v_0120, v_0079)</expbody>
        <expresult> = 0.312</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength and minimum detailing; revise/recalculate after selecting weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0122 = v_0086 + (2 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
