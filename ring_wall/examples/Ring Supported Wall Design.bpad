    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bar area [in²]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0047 = Max(0.11, Min(0.6, 1.3*v_0003*v_0002/(2*(v_0003 + v_0002)*v_0020)))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0047 = Max(0.11, Min(0.6, 1.3*v_0003*v_0002/(2*(v_0003 + v_0002)*v_0020)))</expbody>
        <expresult> = 0.335</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">steel L [in²/ft]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0048 = Max(0.11, Min(0.6, 1.3*v_0003*v_0004/(2*(v_0003 + v_0004)*v_0020)))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0048 = Max(0.11, Min(0.6, 1.3*v_0003*v_0004/(2*(v_0003 + v_0004)*v_0020)))</expbody>
        <expresult> = 0.329</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">steel H [in²/ft]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0049 = Max(v_0047, v_0048)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0049 = Max(v_0047, v_0048)</expbody>
        <expresult> = 0.335</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Both directions / each face; gross-section envelope [in²/ft]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0050 = Min(1.5*v_0003, If(v_0003 &gt; 36, 12, 18))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0050 = Min(1.5*v_0003, If(v_0003 &gt; 36, 12, 18))</expbody>
        <expresult> = 18.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Conservative wall/slab and thick-member spacing envelope [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0051 = Min(v_0050, v_0029)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0051 = Min(v_0050, v_0029)</expbody>
        <expresult> = 12.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">pitch limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0052 = 11" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0052 = 11</expbody>
        <expresult> = 11.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Adopted pitch; fixed input in distilled sheets [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0053 = 12*v_0046/v_0052" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0053 = 12*v_0046/v_0052</expbody>
        <expresult> = 0.338</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">steel provided [in²/ft]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0054 = Max(1.5, 1.5*v_0045, 1.5*v_0018)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0054 = Max(1.5, 1.5*v_0045, 1.5*v_0018)</expbody>
        <expresult> = 1.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">clear required [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0055 = v_0052 - v_0045" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0055 = v_0052 - v_0045</expbody>
        <expresult> = 10.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">clear provided [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0056 = 1" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0056 = 1</expbody>
        <expresult> = 1.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">coating factor [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0057 = 2.4*v_0045*v_0020/Sqrt(v_0019)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0057 = 2.4*v_0045*v_0020/Sqrt(v_0019)</expbody>
        <expresult> = 38.376</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Basic length of LRFD 5.10.8.2.1a, normal weight concrete [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0058 = Min(v_0016 + v_0045/2, v_0052/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0058 = Min(v_0016 + v_0045/2, v_0052/2)</expbody>
        <expresult> = 3.312</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Smaller of the cover to the bar center and half the bar spacing (LRFD 5.10.8.2.1c) [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0059 = Max(0.4, Min(1, v_0045/v_0058))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0059 = Max(0.4, Min(1, v_0045/v_0058))</expbody>
        <expresult> = 0.400</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Reinforcement confinement factor, no transverse reinforcement credited (LRFD 5.10.8.2.1c) [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0060 = Max(12, v_0057*Min(1.7, 1.3*v_0056)*v_0059)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0060 = Max(12, v_0057*Min(1.7, 1.3*v_0056)*v_0059)</expbody>
        <expresult> = 19.956</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Horizontal bars with more than 12 in of concrete below: location factor 1.3, the product with the coating factor at most 1.7 (LRFD 5.10.8.2.1b) [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0061 = Max(12, v_0057*v_0056*v_0059)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0061 = Max(12, v_0057*v_0056*v_0059)</expbody>
        <expresult> = 15.350</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ld vertical [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0062 = 1.3*v_0060" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0062 = 1.3*v_0060</expbody>
        <expresult> = 25.942</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">lap horizontal [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0063 = 1.3*v_0061" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0063 = 1.3*v_0061</expbody>
        <expresult> = 19.956</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">lap vertical [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0064 = If(v_0026 &lt;= 8, 6, 8)*v_0045 + 2*v_0045" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0064 = If(v_0026 &lt;= 8, 6, 8)*v_0045 + 2*v_0045</expbody>
        <expresult> = 5.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bend envelope [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0065 = v_0003 - 2*v_0016" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0065 = v_0003 - 2*v_0016</expbody>
        <expresult> = 30.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">u width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0066 = v_0002 - 2*v_0016 - 2*v_0045" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0066 = v_0002 - 2*v_0016 - 2*v_0045</expbody>
        <expresult> = 211.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">u leg available [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0067 = v_0004 - 2*v_0016 - 2*v_0045" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0067 = v_0004 - 2*v_0016 - 2*v_0045</expbody>
        <expresult> = 187.613</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">vertical available [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0068 = v_0007/2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0068 = v_0007/2</expbody>
        <expresult> = 10.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">pipe radius [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0069 = v_0032/2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0069 = v_0032/2</expbody>
        <expresult> = 10.062</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">inner radius [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0070 = v_0033/2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0070 = v_0033/2</expbody>
        <expresult> = 11.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">outer radius [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0071 = v_0069 - v_0068" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0071 = v_0069 - v_0068</expbody>
        <expresult> = 0.062</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">root gap [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0072 = Max(v_0069, v_0068 + v_0037)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0072 = Max(v_0069, v_0068 + v_0037)</expbody>
        <expresult> = 10.312</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Horizontal bearing excludes upper weld footprint [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0073 = v_0044*(v_0070^2 - v_0072^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0073 = v_0044*(v_0070^2 - v_0072^2)</expbody>
        <expresult> = 81.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bearing area [in²]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0074 = v_0044*(v_0070^4 - v_0072^4)/4" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0074 = v_0044*(v_0070^4 - v_0072^4)/4</expbody>
        <expresult> = 4853.948</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bearing inertia [in⁴]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0075 = v_0039*0.85*v_0019" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0075 = v_0039*0.85*v_0019</expbody>
        <expresult> = 3.272</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">No supporting-area enhancement; m = 1 [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0076 = v_0040*v_0035*v_0034^2/6" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0076 = v_0040*v_0035*v_0034^2/6</expbody>
        <expresult> = 2.083</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Elastic radial cantilever strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0077 = v_0042*0.58*v_0035*v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0077 = v_0042*0.58*v_0035*v_0034</expbody>
        <expresult> = 14.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">plate shear capacity [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0078 = (v_0037 - v_0071)/Sqrt(2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0078 = (v_0037 - v_0071)/Sqrt(2)</expbody>
        <expresult> = 0.177</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Conservative fit-up allowance; WPS must permit gap [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0079 = v_0041*0.6*v_0038*v_0078" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0079 = v_0041*0.6*v_0038*v_0078</expbody>
        <expresult> = 5.940</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">One continuous fillet; no directional enhancement [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0080 = Max(v_0034, v_0008)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0080 = Max(v_0034, v_0008)</expbody>
        <expresult> = 0.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">thicker part [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0081 = If(v_0080 &lt;= 0.75, 0.25, 0.3125)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0081 = If(v_0080 &lt;= 0.75, 0.25, 0.3125)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum thick weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0082 = If(v_0080 &lt;= 0.5, 0.1875, v_0081)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0082 = If(v_0080 &lt;= 0.5, 0.1875, v_0081)</expbody>
        <expresult> = 0.188</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum mid weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0083 = If(v_0080 &lt;= 0.25, 0.125, v_0082)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0083 = If(v_0080 &lt;= 0.25, 0.125, v_0082)</expbody>
        <expresult> = 0.188</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum table weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0084 = Min(v_0083, v_0034, v_0008)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0084 = Min(v_0083, v_0034, v_0008)</expbody>
        <expresult> = 0.188</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">weld minimum [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0085 = v_0084 + v_0071" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0085 = v_0084 + v_0071</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">weld min gap [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0086 = If(v_0034 &lt; 0.25, v_0034, v_0034 - 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0086 = If(v_0034 &lt; 0.25, v_0034, v_0034 - 0.0625)</expbody>
        <expresult> = 0.438</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Ring edge limit; pipe is a face, not free edge [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0087 = 2*v_0044*v_0068" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0087 = 2*v_0044*v_0068</expbody>
        <expresult> = 62.832</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Each of two continuous circumferential welds [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0088 = Max(4*v_0037, 1.5)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0088 = Max(4*v_0037, 1.5)</expbody>
        <expresult> = 1.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">weld length min [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0089 = v_0043*0.58*v_0036*v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0089 = v_0043*0.58*v_0036*v_0034</expbody>
        <expresult> = 15.080</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring base capacity [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0090 = v_0043*0.58*v_0010*v_0008" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0090 = v_0043*0.58*v_0010*v_0008</expbody>
        <expresult> = 14.326</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">pipe base capacity [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0091 = v_0042*0.58*v_0009*v_0008" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0091 = v_0042*0.58*v_0009*v_0008</expbody>
        <expresult> = 13.775</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">pipe yield capacity [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0092 = (v_0002 - (v_0005 - 1)*v_0006)/2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0092 = (v_0002 - (v_0005 - 1)*v_0006)/2</expbody>
        <expresult> = 19.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">end offset [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0093 = v_0092 - v_0070 - v_0011" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0093 = v_0092 - v_0070 - v_0011</expbody>
        <expresult> = 5.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">end clear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0094 = v_0003/2 - v_0070 - v_0011" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0094 = v_0003/2 - v_0070 - v_0011</expbody>
        <expresult> = 3.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">face clear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0095 = v_0003/2 - v_0016 - 2*v_0045 - v_0070 - v_0011" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0095 = v_0003/2 - v_0016 - 2*v_0045 - v_0070 - v_0011</expbody>
        <expresult> = -0.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">grid gap [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0096 = Max(1, 1.5*v_0018)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0096 = Max(1, 1.5*v_0018)</expbody>
        <expresult> = 1.125</expresult>
