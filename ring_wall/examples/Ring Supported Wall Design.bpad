    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0311 = v_0309 + v_0310" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0311 = v_0309 + v_0310</expbody>
        <expresult> = 0.093</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0312 = v_0309 - v_0310" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0312 = v_0309 - v_0310</expbody>
        <expresult> = 0.076</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0313 = v_0311*((v_0068^3 - v_0070^3)/(3*v_0066) - (v_0068^2 - v_0070^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0313 = v_0311*((v_0068^3 - v_0070^3)/(3*v_0066) - (v_0068^2 - v_0070^2)/2)</expbody>
        <expresult> = 0.111</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0314 = v_0311*(v_0068^2 - v_0070^2)/(2*v_0066)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0314 = v_0311*(v_0068^2 - v_0070^2)/(2*v_0066)</expbody>
        <expresult> = 0.121</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0315 = Sqrt(6*v_0313/(v_0040*v_0035))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0315 = Sqrt(6*v_0313/(v_0040*v_0035))</expbody>
        <expresult> = 0.115</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 thickness bending [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0316 = v_0314/(v_0042*0.58*v_0035)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0316 = v_0314/(v_0042*0.58*v_0035)</expbody>
        <expresult> = 0.004</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 thickness shear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0317 = Max(v_0315, v_0316, v_0037 + 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0317 = Max(v_0315, v_0316, v_0037 + 0.0625)</expbody>
        <expresult> = 0.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Bending, shear and conservative weld-edge allowance; revise/recalculate after selecting thickness [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0318 = v_0313/v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0318 = v_0313/v_0034</expbody>
        <expresult> = 0.148</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Top/bottom weld couple separated conservatively by plate thickness [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0319 = Sqrt((v_0314/2)^2 + v_0318^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0319 = Sqrt((v_0314/2)^2 + v_0318^2)</expbody>
        <expresult> = 0.160</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Per fillet: half vertical shear + full radial couple force [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0320 = v_0069 + Sqrt(2)*v_0319/(v_0041*0.6*v_0038)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0320 = v_0069 + Sqrt(2)*v_0319/(v_0041*0.6*v_0038)</expbody>
        <expresult> = 0.069</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 weld strength leg [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0321 = Max(v_0320, v_0083)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0321 = Max(v_0320, v_0083)</expbody>
        <expresult> = 0.312</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength and minimum detailing; revise/recalculate after selecting weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0322 = v_0023 + (3 - 1.5)*v_0024" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0322 = v_0023 + (3 - 1.5)*v_0024</expbody>
        <expresult> = 60.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 3 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0323 = v_0023 + (3 - 0.5)*v_0024" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0323 = v_0023 + (3 - 0.5)*v_0024</expbody>
        <expresult> = 96.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 3 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0324 = v_0323 - v_0322" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0324 = v_0323 - v_0322</expbody>
        <expresult> = 36.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 3 height [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0325 = v_0324/v_0004" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0325 = v_0324/v_0004</expbody>
        <expresult> = 0.209</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Row tributary fraction of the wall height [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0326 = v_0090 + (1 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0326 = v_0090 + (1 - 1)*v_0006</expbody>
        <expresult> = 16.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0327 = 0" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0327 = 0</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0328 = v_0090 + (1 - 0.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0328 = v_0090 + (1 - 0.5)*v_0006</expbody>
        <expresult> = 46.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0329 = v_0328 - v_0327" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0329 = v_0328 - v_0327</expbody>
        <expresult> = 46.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0330 = v_0329*v_0324*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0330 = v_0329*v_0324*v_0003/1728</expbody>
        <expresult> = 34.875</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0331 = v_0021*v_0330" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0331 = v_0021*v_0330</expbody>
        <expresult> = 5.231</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0332 = v_0022*v_0331" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0332 = v_0022*v_0331</expbody>
        <expresult> = 6.539</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0333 = (v_0327 + v_0328)/2 - v_0326" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0333 = (v_0327 + v_0328)/2 - v_0326</expbody>
        <expresult> = 6.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Retained for whole-wall equilibrium; carried by the wall, not the ring [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0334 = v_0332*(Abs(v_0333) + v_0011)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0334 = v_0332*(Abs(v_0333) + v_0011)</expbody>
        <expresult> = 63.756</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Superseded tributary-eccentricity basis (D-070); comparison only [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0335 = v_0325*v_0105*v_0110*Abs(v_0326 - v_0107)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0335 = v_0325*v_0105*v_0110*Abs(v_0326 - v_0107)</expbody>
        <expresult> = 0.374</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Rigid-body axial redistribution; sign taken to increase the ring force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0336 = v_0332 + v_0335" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0336 = v_0332 + v_0335</expbody>
        <expresult> = 6.913</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 design force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0337 = v_0112/v_0336" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0337 = v_0112/v_0336</expbody>
        <expresult> = 0.519</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0338 = v_0336/v_0071" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0338 = v_0336/v_0071</expbody>
        <expresult> = 0.085</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0339 = v_0112*v_0068/v_0072" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0339 = v_0112*v_0068/v_0072</expbody>
        <expresult> = 0.009</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0340 = v_0338 + v_0339" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0340 = v_0338 + v_0339</expbody>
        <expresult> = 0.093</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0341 = v_0338 - v_0339" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0341 = v_0338 - v_0339</expbody>
        <expresult> = 0.076</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0342 = v_0340*((v_0068^3 - v_0070^3)/(3*v_0066) - (v_0068^2 - v_0070^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0342 = v_0340*((v_0068^3 - v_0070^3)/(3*v_0066) - (v_0068^2 - v_0070^2)/2)</expbody>
        <expresult> = 0.111</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0343 = v_0340*(v_0068^2 - v_0070^2)/(2*v_0066)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0343 = v_0340*(v_0068^2 - v_0070^2)/(2*v_0066)</expbody>
        <expresult> = 0.121</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0344 = Sqrt(6*v_0342/(v_0040*v_0035))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0344 = Sqrt(6*v_0342/(v_0040*v_0035))</expbody>
        <expresult> = 0.115</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 thickness bending [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0345 = v_0343/(v_0042*0.58*v_0035)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0345 = v_0343/(v_0042*0.58*v_0035)</expbody>
        <expresult> = 0.004</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 thickness shear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0346 = Max(v_0344, v_0345, v_0037 + 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0346 = Max(v_0344, v_0345, v_0037 + 0.0625)</expbody>
        <expresult> = 0.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Bending, shear and conservative weld-edge allowance; revise/recalculate after selecting thickness [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0347 = v_0342/v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0347 = v_0342/v_0034</expbody>
        <expresult> = 0.148</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Top/bottom weld couple separated conservatively by plate thickness [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0348 = Sqrt((v_0343/2)^2 + v_0347^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0348 = Sqrt((v_0343/2)^2 + v_0347^2)</expbody>
        <expresult> = 0.160</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Per fillet: half vertical shear + full radial couple force [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0349 = v_0069 + Sqrt(2)*v_0348/(v_0041*0.6*v_0038)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0349 = v_0069 + Sqrt(2)*v_0348/(v_0041*0.6*v_0038)</expbody>
        <expresult> = 0.069</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 weld strength leg [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0350 = Max(v_0349, v_0083)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0350 = Max(v_0349, v_0083)</expbody>
        <expresult> = 0.312</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength and minimum detailing; revise/recalculate after selecting weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0351 = v_0090 + (2 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0351 = v_0090 + (2 - 1)*v_0006</expbody>
        <expresult> = 76.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 2 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0352 = v_0090 + (2 - 1.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0352 = v_0090 + (2 - 1.5)*v_0006</expbody>
        <expresult> = 46.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 2 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0353 = v_0090 + (2 - 0.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0353 = v_0090 + (2 - 0.5)*v_0006</expbody>
        <expresult> = 106.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 2 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0354 = v_0353 - v_0352" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0354 = v_0353 - v_0352</expbody>
        <expresult> = 60.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 2 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0355 = v_0354*v_0324*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0355 = v_0354*v_0324*v_0003/1728</expbody>
        <expresult> = 45.000</expresult>
