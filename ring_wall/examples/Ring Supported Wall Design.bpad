    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Worst radial tolerance plus nominal centroid offset [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0131 = v_0128*v_0130" mathlayout="on" showformula="True" showresult="True" showsteps="False">
