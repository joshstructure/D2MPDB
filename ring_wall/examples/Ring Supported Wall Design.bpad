    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 5 4 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0652 = v_0021*v_0651" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0652 = v_0021*v_0651</expbody>
        <expresult> = 9.724</expresult>
