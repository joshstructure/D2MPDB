    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Selected diameter; regenerate native sheet after bar-size changes [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0042 = 0.31" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0042 = 0.31</expbody>
        <expresult> = 0.310</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bar area [in²]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0043 = Max(0.11, Min(0.6, 1.3*v_0003*v_0002/(2*(v_0003 + v_0002)*v_0016)))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0043 = Max(0.11, Min(0.6, 1.3*v_0003*v_0002/(2*(v_0003 + v_0002)*v_0016)))</expbody>
        <expresult> = 0.334</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">steel L [in²/ft]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0044 = Max(0.11, Min(0.6, 1.3*v_0003*v_0004/(2*(v_0003 + v_0004)*v_0016)))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0044 = Max(0.11, Min(0.6, 1.3*v_0003*v_0004/(2*(v_0003 + v_0004)*v_0016)))</expbody>
        <expresult> = 0.323</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">steel H [in²/ft]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0045 = Max(v_0043, v_0044)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0045 = Max(v_0043, v_0044)</expbody>
        <expresult> = 0.334</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Both directions / each face; gross-section envelope [in²/ft]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0046 = Min(1.5*v_0003, If(v_0003 &gt; 36, 12, 18))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0046 = Min(1.5*v_0003, If(v_0003 &gt; 36, 12, 18))</expbody>
        <expresult> = 18.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Conservative wall/slab and thick-member spacing envelope [in]</paragraph>
