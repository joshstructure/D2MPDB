      <dynexp formula="v_0120 = v_0092 + (1 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0120 = v_0092 + (1 - 1)*v_0006</expbody>
        <expresult> = 19.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0121 = 0" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0121 = 0</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0122 = v_0092 + (1 - 0.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0122 = v_0092 + (1 - 0.5)*v_0006</expbody>
        <expresult> = 49.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0123 = v_0122 - v_0121" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0123 = v_0122 - v_0121</expbody>
        <expresult> = 49.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0124 = v_0123*v_0118*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0124 = v_0123*v_0118*v_0003/1728</expbody>
        <expresult> = 24.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0125 = v_0021*v_0124" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0125 = v_0021*v_0124</expbody>
        <expresult> = 3.712</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0126 = v_0022*v_0125" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0126 = v_0022*v_0125</expbody>
        <expresult> = 4.641</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0127 = (v_0121 + v_0122)/2 - v_0120" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0127 = (v_0121 + v_0122)/2 - v_0120</expbody>
        <expresult> = 5.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Retained for whole-wall equilibrium; carried by the wall, not the ring [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0128 = v_0126*(Abs(v_0127) + v_0011)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0128 = v_0126*(Abs(v_0127) + v_0011)</expbody>
        <expresult> = 38.285</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Superseded tributary-eccentricity basis (D-070); comparison only [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0129 = v_0119*v_0107*v_0112*Abs(v_0120 - v_0109)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0129 = v_0119*v_0107*v_0112*Abs(v_0120 - v_0109)</expbody>
        <expresult> = 0.242</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Rigid-body axial redistribution; sign taken to increase the ring force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0130 = v_0126 + v_0129" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0130 = v_0126 + v_0129</expbody>
        <expresult> = 4.882</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 design force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0131 = v_0114/v_0130" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0131 = v_0114/v_0130</expbody>
        <expresult> = 1.105</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0132 = v_0130/v_0073" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0132 = v_0130/v_0073</expbody>
        <expresult> = 0.060</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0133 = v_0114*v_0070/v_0074" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0133 = v_0114*v_0070/v_0074</expbody>
        <expresult> = 0.013</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0134 = v_0132 + v_0133" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0134 = v_0132 + v_0133</expbody>
        <expresult> = 0.073</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0135 = v_0132 - v_0133" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0135 = v_0132 - v_0133</expbody>
        <expresult> = 0.047</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0136 = v_0134*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0136 = v_0134*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)</expbody>
        <expresult> = 0.086</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0137 = v_0134*(v_0070^2 - v_0072^2)/(2*v_0068)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0137 = v_0134*(v_0070^2 - v_0072^2)/(2*v_0068)</expbody>
        <expresult> = 0.094</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0138 = Sqrt(6*v_0136/(v_0040*v_0035))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0138 = Sqrt(6*v_0136/(v_0040*v_0035))</expbody>
        <expresult> = 0.102</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 thickness bending [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0139 = v_0137/(v_0042*0.58*v_0035)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0139 = v_0137/(v_0042*0.58*v_0035)</expbody>
        <expresult> = 0.003</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 thickness shear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0140 = Max(v_0138, v_0139, v_0037 + 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0140 = Max(v_0138, v_0139, v_0037 + 0.0625)</expbody>
        <expresult> = 0.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Bending, shear and conservative weld-edge allowance; revise/recalculate after selecting thickness [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0141 = v_0136/v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0141 = v_0136/v_0034</expbody>
        <expresult> = 0.173</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Top/bottom weld couple separated conservatively by plate thickness [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0142 = Sqrt((v_0137/2)^2 + v_0141^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0142 = Sqrt((v_0137/2)^2 + v_0141^2)</expbody>
        <expresult> = 0.179</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Per fillet: half vertical shear + full radial couple force [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0143 = v_0071 + Sqrt(2)*v_0142/(v_0041*0.6*v_0038)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0143 = v_0071 + Sqrt(2)*v_0142/(v_0041*0.6*v_0038)</expbody>
        <expresult> = 0.070</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 weld strength leg [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0144 = Max(v_0143, v_0085)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0144 = Max(v_0143, v_0085)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength and minimum detailing; revise/recalculate after selecting weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0145 = Round(16*v_0144, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0145 = Round(16*v_0144, 0)</expbody>
        <expresult> = 4.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Nearest whole number of sixteenths [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0146 = If(v_0145 &gt;= 16*v_0144, v_0145, v_0145 + 1)/16" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0146 = If(v_0145 &gt;= 16*v_0144, v_0145, v_0145 + 1)/16</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Trial leg rounded up to the next 1/16 in [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0147 = v_0092 + (2 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0147 = v_0092 + (2 - 1)*v_0006</expbody>
        <expresult> = 79.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0148 = v_0092 + (2 - 1.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0148 = v_0092 + (2 - 1.5)*v_0006</expbody>
        <expresult> = 49.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0149 = v_0092 + (2 - 0.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0149 = v_0092 + (2 - 0.5)*v_0006</expbody>
        <expresult> = 109.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0150 = v_0149 - v_0148" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0150 = v_0149 - v_0148</expbody>
        <expresult> = 60.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0151 = v_0150*v_0118*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0151 = v_0150*v_0118*v_0003/1728</expbody>
        <expresult> = 30.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0152 = v_0021*v_0151" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0152 = v_0021*v_0151</expbody>
        <expresult> = 4.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0153 = v_0022*v_0152" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0153 = v_0022*v_0152</expbody>
        <expresult> = 5.625</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0154 = (v_0148 + v_0149)/2 - v_0147" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0154 = (v_0148 + v_0149)/2 - v_0147</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Retained for whole-wall equilibrium; carried by the wall, not the ring [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0155 = v_0153*(Abs(v_0154) + v_0011)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0155 = v_0153*(Abs(v_0154) + v_0011)</expbody>
        <expresult> = 16.875</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Superseded tributary-eccentricity basis (D-070); comparison only [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0156 = v_0119*v_0107*v_0112*Abs(v_0147 - v_0109)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0156 = v_0119*v_0107*v_0112*Abs(v_0147 - v_0109)</expbody>
        <expresult> = 0.081</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Rigid-body axial redistribution; sign taken to increase the ring force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0157 = v_0153 + v_0156" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0157 = v_0153 + v_0156</expbody>
        <expresult> = 5.706</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 design force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0158 = v_0114/v_0157" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0158 = v_0114/v_0157</expbody>
        <expresult> = 0.946</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0159 = v_0157/v_0073" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0159 = v_0157/v_0073</expbody>
        <expresult> = 0.070</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0160 = v_0114*v_0070/v_0074" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0160 = v_0114*v_0070/v_0074</expbody>
        <expresult> = 0.013</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0161 = v_0159 + v_0160" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0161 = v_0159 + v_0160</expbody>
        <expresult> = 0.083</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0162 = v_0159 - v_0160" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0162 = v_0159 - v_0160</expbody>
        <expresult> = 0.057</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0163 = v_0161*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0163 = v_0161*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)</expbody>
        <expresult> = 0.098</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0164 = v_0161*(v_0070^2 - v_0072^2)/(2*v_0068)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0164 = v_0161*(v_0070^2 - v_0072^2)/(2*v_0068)</expbody>
        <expresult> = 0.107</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0165 = Sqrt(6*v_0163/(v_0040*v_0035))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0165 = Sqrt(6*v_0163/(v_0040*v_0035))</expbody>
        <expresult> = 0.109</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 thickness bending [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0166 = v_0164/(v_0042*0.58*v_0035)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0166 = v_0164/(v_0042*0.58*v_0035)</expbody>
        <expresult> = 0.004</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 thickness shear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0167 = Max(v_0165, v_0166, v_0037 + 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0167 = Max(v_0165, v_0166, v_0037 + 0.0625)</expbody>
        <expresult> = 0.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Bending, shear and conservative weld-edge allowance; revise/recalculate after selecting thickness [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0168 = v_0163/v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0168 = v_0163/v_0034</expbody>
        <expresult> = 0.197</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Top/bottom weld couple separated conservatively by plate thickness [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0169 = Sqrt((v_0164/2)^2 + v_0168^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0169 = Sqrt((v_0164/2)^2 + v_0168^2)</expbody>
        <expresult> = 0.204</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Per fillet: half vertical shear + full radial couple force [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0170 = v_0071 + Sqrt(2)*v_0169/(v_0041*0.6*v_0038)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0170 = v_0071 + Sqrt(2)*v_0169/(v_0041*0.6*v_0038)</expbody>
        <expresult> = 0.071</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 2 weld strength leg [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0171 = Max(v_0170, v_0085)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0171 = Max(v_0170, v_0085)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength and minimum detailing; revise/recalculate after selecting weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0172 = Round(16*v_0171, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0172 = Round(16*v_0171, 0)</expbody>
        <expresult> = 4.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Nearest whole number of sixteenths [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0173 = If(v_0172 &gt;= 16*v_0171, v_0172, v_0172 + 1)/16" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0173 = If(v_0172 &gt;= 16*v_0171, v_0172, v_0172 + 1)/16</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Trial leg rounded up to the next 1/16 in [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0174 = v_0092 + (3 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0174 = v_0092 + (3 - 1)*v_0006</expbody>
        <expresult> = 139.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0175 = v_0092 + (3 - 1.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0175 = v_0092 + (3 - 1.5)*v_0006</expbody>
        <expresult> = 109.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0176 = v_0092 + (3 - 0.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0176 = v_0092 + (3 - 0.5)*v_0006</expbody>
        <expresult> = 169.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0177 = v_0176 - v_0175" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0177 = v_0176 - v_0175</expbody>
        <expresult> = 60.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0178 = v_0177*v_0118*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0178 = v_0177*v_0118*v_0003/1728</expbody>
        <expresult> = 30.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0179 = v_0021*v_0178" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0179 = v_0021*v_0178</expbody>
        <expresult> = 4.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0180 = v_0022*v_0179" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0180 = v_0022*v_0179</expbody>
        <expresult> = 5.625</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0181 = (v_0175 + v_0176)/2 - v_0174" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0181 = (v_0175 + v_0176)/2 - v_0174</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Retained for whole-wall equilibrium; carried by the wall, not the ring [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0182 = v_0180*(Abs(v_0181) + v_0011)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0182 = v_0180*(Abs(v_0181) + v_0011)</expbody>
        <expresult> = 16.875</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Superseded tributary-eccentricity basis (D-070); comparison only [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0183 = v_0119*v_0107*v_0112*Abs(v_0174 - v_0109)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0183 = v_0119*v_0107*v_0112*Abs(v_0174 - v_0109)</expbody>
        <expresult> = 0.081</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Rigid-body axial redistribution; sign taken to increase the ring force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0184 = v_0180 + v_0183" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0184 = v_0180 + v_0183</expbody>
        <expresult> = 5.706</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 design force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0185 = v_0114/v_0184" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0185 = v_0114/v_0184</expbody>
        <expresult> = 0.946</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0186 = v_0184/v_0073" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0186 = v_0184/v_0073</expbody>
        <expresult> = 0.070</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0187 = v_0114*v_0070/v_0074" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0187 = v_0114*v_0070/v_0074</expbody>
        <expresult> = 0.013</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0188 = v_0186 + v_0187" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0188 = v_0186 + v_0187</expbody>
        <expresult> = 0.083</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0189 = v_0186 - v_0187" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0189 = v_0186 - v_0187</expbody>
        <expresult> = 0.057</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0190 = v_0188*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0190 = v_0188*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)</expbody>
        <expresult> = 0.098</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0191 = v_0188*(v_0070^2 - v_0072^2)/(2*v_0068)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0191 = v_0188*(v_0070^2 - v_0072^2)/(2*v_0068)</expbody>
        <expresult> = 0.107</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0192 = Sqrt(6*v_0190/(v_0040*v_0035))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0192 = Sqrt(6*v_0190/(v_0040*v_0035))</expbody>
        <expresult> = 0.109</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 thickness bending [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0193 = v_0191/(v_0042*0.58*v_0035)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0193 = v_0191/(v_0042*0.58*v_0035)</expbody>
        <expresult> = 0.004</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 thickness shear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0194 = Max(v_0192, v_0193, v_0037 + 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0194 = Max(v_0192, v_0193, v_0037 + 0.0625)</expbody>
        <expresult> = 0.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Bending, shear and conservative weld-edge allowance; revise/recalculate after selecting thickness [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0195 = v_0190/v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0195 = v_0190/v_0034</expbody>
        <expresult> = 0.197</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Top/bottom weld couple separated conservatively by plate thickness [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0196 = Sqrt((v_0191/2)^2 + v_0195^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0196 = Sqrt((v_0191/2)^2 + v_0195^2)</expbody>
        <expresult> = 0.204</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Per fillet: half vertical shear + full radial couple force [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0197 = v_0071 + Sqrt(2)*v_0196/(v_0041*0.6*v_0038)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0197 = v_0071 + Sqrt(2)*v_0196/(v_0041*0.6*v_0038)</expbody>
        <expresult> = 0.071</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 weld strength leg [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0198 = Max(v_0197, v_0085)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0198 = Max(v_0197, v_0085)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength and minimum detailing; revise/recalculate after selecting weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0199 = Round(16*v_0198, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0199 = Round(16*v_0198, 0)</expbody>
        <expresult> = 4.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Nearest whole number of sixteenths [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0200 = If(v_0199 &gt;= 16*v_0198, v_0199, v_0199 + 1)/16" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0200 = If(v_0199 &gt;= 16*v_0198, v_0199, v_0199 + 1)/16</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Trial leg rounded up to the next 1/16 in [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0201 = v_0092 + (4 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0201 = v_0092 + (4 - 1)*v_0006</expbody>
        <expresult> = 199.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0202 = v_0092 + (4 - 1.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0202 = v_0092 + (4 - 1.5)*v_0006</expbody>
        <expresult> = 169.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0203 = v_0002" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0203 = v_0002</expbody>
        <expresult> = 219.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0204 = v_0203 - v_0202" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0204 = v_0203 - v_0202</expbody>
        <expresult> = 49.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0205 = v_0204*v_0118*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0205 = v_0204*v_0118*v_0003/1728</expbody>
        <expresult> = 24.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0206 = v_0021*v_0205" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0206 = v_0021*v_0205</expbody>
        <expresult> = 3.712</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0207 = v_0022*v_0206" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0207 = v_0022*v_0206</expbody>
        <expresult> = 4.641</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0208 = (v_0202 + v_0203)/2 - v_0201" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0208 = (v_0202 + v_0203)/2 - v_0201</expbody>
        <expresult> = -5.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Retained for whole-wall equilibrium; carried by the wall, not the ring [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0209 = v_0207*(Abs(v_0208) + v_0011)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0209 = v_0207*(Abs(v_0208) + v_0011)</expbody>
        <expresult> = 38.285</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Superseded tributary-eccentricity basis (D-070); comparison only [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0210 = v_0119*v_0107*v_0112*Abs(v_0201 - v_0109)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0210 = v_0119*v_0107*v_0112*Abs(v_0201 - v_0109)</expbody>
        <expresult> = 0.242</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Rigid-body axial redistribution; sign taken to increase the ring force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0211 = v_0207 + v_0210" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0211 = v_0207 + v_0210</expbody>
        <expresult> = 4.882</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 design force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0212 = v_0114/v_0211" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0212 = v_0114/v_0211</expbody>
        <expresult> = 1.105</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0213 = v_0211/v_0073" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0213 = v_0211/v_0073</expbody>
        <expresult> = 0.060</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0214 = v_0114*v_0070/v_0074" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0214 = v_0114*v_0070/v_0074</expbody>
        <expresult> = 0.013</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0215 = v_0213 + v_0214" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0215 = v_0213 + v_0214</expbody>
        <expresult> = 0.073</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0216 = v_0213 - v_0214" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0216 = v_0213 - v_0214</expbody>
        <expresult> = 0.047</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0217 = v_0215*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0217 = v_0215*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)</expbody>
        <expresult> = 0.086</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0218 = v_0215*(v_0070^2 - v_0072^2)/(2*v_0068)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0218 = v_0215*(v_0070^2 - v_0072^2)/(2*v_0068)</expbody>
        <expresult> = 0.094</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0219 = Sqrt(6*v_0217/(v_0040*v_0035))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0219 = Sqrt(6*v_0217/(v_0040*v_0035))</expbody>
        <expresult> = 0.102</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 thickness bending [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0220 = v_0218/(v_0042*0.58*v_0035)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0220 = v_0218/(v_0042*0.58*v_0035)</expbody>
        <expresult> = 0.003</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 thickness shear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0221 = Max(v_0219, v_0220, v_0037 + 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0221 = Max(v_0219, v_0220, v_0037 + 0.0625)</expbody>
        <expresult> = 0.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Bending, shear and conservative weld-edge allowance; revise/recalculate after selecting thickness [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0222 = v_0217/v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0222 = v_0217/v_0034</expbody>
        <expresult> = 0.173</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Top/bottom weld couple separated conservatively by plate thickness [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0223 = Sqrt((v_0218/2)^2 + v_0222^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0223 = Sqrt((v_0218/2)^2 + v_0222^2)</expbody>
        <expresult> = 0.179</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Per fillet: half vertical shear + full radial couple force [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0224 = v_0071 + Sqrt(2)*v_0223/(v_0041*0.6*v_0038)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0224 = v_0071 + Sqrt(2)*v_0223/(v_0041*0.6*v_0038)</expbody>
        <expresult> = 0.070</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 weld strength leg [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0225 = Max(v_0224, v_0085)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0225 = Max(v_0224, v_0085)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength and minimum detailing; revise/recalculate after selecting weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0226 = Round(16*v_0225, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0226 = Round(16*v_0225, 0)</expbody>
        <expresult> = 4.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Nearest whole number of sixteenths [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0227 = If(v_0226 &gt;= 16*v_0225, v_0226, v_0226 + 1)/16" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0227 = If(v_0226 &gt;= 16*v_0225, v_0226, v_0226 + 1)/16</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Trial leg rounded up to the next 1/16 in [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0228 = v_0023 + (2 - 1.5)*v_0024" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0228 = v_0023 + (2 - 1.5)*v_0024</expbody>
        <expresult> = 24.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 2 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0229 = v_0023 + (2 - 0.5)*v_0024" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0229 = v_0023 + (2 - 0.5)*v_0024</expbody>
        <expresult> = 60.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 2 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0230 = v_0229 - v_0228" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0230 = v_0229 - v_0228</expbody>
        <expresult> = 36.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 2 height [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0231 = v_0230/v_0004" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0231 = v_0230/v_0004</expbody>
        <expresult> = 0.185</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Row tributary fraction of the wall height [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0232 = v_0092 + (1 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0232 = v_0092 + (1 - 1)*v_0006</expbody>
        <expresult> = 19.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0233 = 0" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0233 = 0</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0234 = v_0092 + (1 - 0.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0234 = v_0092 + (1 - 0.5)*v_0006</expbody>
        <expresult> = 49.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0235 = v_0234 - v_0233" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0235 = v_0234 - v_0233</expbody>
        <expresult> = 49.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0236 = v_0235*v_0230*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0236 = v_0235*v_0230*v_0003/1728</expbody>
        <expresult> = 37.125</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0237 = v_0021*v_0236" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0237 = v_0021*v_0236</expbody>
        <expresult> = 5.569</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0238 = v_0022*v_0237" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0238 = v_0022*v_0237</expbody>
        <expresult> = 6.961</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0239 = (v_0233 + v_0234)/2 - v_0232" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0239 = (v_0233 + v_0234)/2 - v_0232</expbody>
        <expresult> = 5.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Retained for whole-wall equilibrium; carried by the wall, not the ring [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0240 = v_0238*(Abs(v_0239) + v_0011)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0240 = v_0238*(Abs(v_0239) + v_0011)</expbody>
        <expresult> = 57.428</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Superseded tributary-eccentricity basis (D-070); comparison only [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0241 = v_0231*v_0107*v_0112*Abs(v_0232 - v_0109)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0241 = v_0231*v_0107*v_0112*Abs(v_0232 - v_0109)</expbody>
        <expresult> = 0.362</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Rigid-body axial redistribution; sign taken to increase the ring force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0242 = v_0238 + v_0241" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0242 = v_0238 + v_0241</expbody>
        <expresult> = 7.323</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 design force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0243 = v_0114/v_0242" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0243 = v_0114/v_0242</expbody>
        <expresult> = 0.737</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0244 = v_0242/v_0073" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0244 = v_0242/v_0073</expbody>
        <expresult> = 0.090</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0245 = v_0114*v_0070/v_0074" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0245 = v_0114*v_0070/v_0074</expbody>
        <expresult> = 0.013</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0246 = v_0244 + v_0245" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0246 = v_0244 + v_0245</expbody>
        <expresult> = 0.103</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0247 = v_0244 - v_0245" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0247 = v_0244 - v_0245</expbody>
        <expresult> = 0.077</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0248 = v_0246*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0248 = v_0246*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)</expbody>
        <expresult> = 0.122</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0249 = v_0246*(v_0070^2 - v_0072^2)/(2*v_0068)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0249 = v_0246*(v_0070^2 - v_0072^2)/(2*v_0068)</expbody>
        <expresult> = 0.133</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0250 = Sqrt(6*v_0248/(v_0040*v_0035))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0250 = Sqrt(6*v_0248/(v_0040*v_0035))</expbody>
        <expresult> = 0.121</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 thickness bending [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0251 = v_0249/(v_0042*0.58*v_0035)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0251 = v_0249/(v_0042*0.58*v_0035)</expbody>
        <expresult> = 0.005</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 thickness shear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0252 = Max(v_0250, v_0251, v_0037 + 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0252 = Max(v_0250, v_0251, v_0037 + 0.0625)</expbody>
        <expresult> = 0.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Bending, shear and conservative weld-edge allowance; revise/recalculate after selecting thickness [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0253 = v_0248/v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0253 = v_0248/v_0034</expbody>
        <expresult> = 0.244</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Top/bottom weld couple separated conservatively by plate thickness [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0254 = Sqrt((v_0249/2)^2 + v_0253^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0254 = Sqrt((v_0249/2)^2 + v_0253^2)</expbody>
        <expresult> = 0.253</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Per fillet: half vertical shear + full radial couple force [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0255 = v_0071 + Sqrt(2)*v_0254/(v_0041*0.6*v_0038)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0255 = v_0071 + Sqrt(2)*v_0254/(v_0041*0.6*v_0038)</expbody>
        <expresult> = 0.073</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 weld strength leg [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0256 = Max(v_0255, v_0085)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0256 = Max(v_0255, v_0085)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength and minimum detailing; revise/recalculate after selecting weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0257 = Round(16*v_0256, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0257 = Round(16*v_0256, 0)</expbody>
        <expresult> = 4.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Nearest whole number of sixteenths [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0258 = If(v_0257 &gt;= 16*v_0256, v_0257, v_0257 + 1)/16" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0258 = If(v_0257 &gt;= 16*v_0256, v_0257, v_0257 + 1)/16</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Trial leg rounded up to the next 1/16 in [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0259 = v_0092 + (2 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0259 = v_0092 + (2 - 1)*v_0006</expbody>
        <expresult> = 79.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 2 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0260 = v_0092 + (2 - 1.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0260 = v_0092 + (2 - 1.5)*v_0006</expbody>
        <expresult> = 49.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 2 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0261 = v_0092 + (2 - 0.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0261 = v_0092 + (2 - 0.5)*v_0006</expbody>
        <expresult> = 109.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 2 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0262 = v_0261 - v_0260" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0262 = v_0261 - v_0260</expbody>
        <expresult> = 60.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 2 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0263 = v_0262*v_0230*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0263 = v_0262*v_0230*v_0003/1728</expbody>
        <expresult> = 45.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 2 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0264 = v_0021*v_0263" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0264 = v_0021*v_0263</expbody>
        <expresult> = 6.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 2 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0265 = v_0022*v_0264" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0265 = v_0022*v_0264</expbody>
        <expresult> = 8.438</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 2 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0266 = (v_0260 + v_0261)/2 - v_0259" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0266 = (v_0260 + v_0261)/2 - v_0259</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Retained for whole-wall equilibrium; carried by the wall, not the ring [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0267 = v_0265*(Abs(v_0266) + v_0011)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0267 = v_0265*(Abs(v_0266) + v_0011)</expbody>
        <expresult> = 25.312</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Superseded tributary-eccentricity basis (D-070); comparison only [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0268 = v_0231*v_0107*v_0112*Abs(v_0259 - v_0109)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0268 = v_0231*v_0107*v_0112*Abs(v_0259 - v_0109)</expbody>
        <expresult> = 0.121</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Rigid-body axial redistribution; sign taken to increase the ring force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0269 = v_0265 + v_0268" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0269 = v_0265 + v_0268</expbody>
        <expresult> = 8.558</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 2 design force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0270 = v_0114/v_0269" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0270 = v_0114/v_0269</expbody>
        <expresult> = 0.631</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0271 = v_0269/v_0073" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0271 = v_0269/v_0073</expbody>
        <expresult> = 0.105</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 2 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0272 = v_0114*v_0070/v_0074" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0272 = v_0114*v_0070/v_0074</expbody>
        <expresult> = 0.013</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 2 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0273 = v_0271 + v_0272" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0273 = v_0271 + v_0272</expbody>
        <expresult> = 0.118</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 2 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0274 = v_0271 - v_0272" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0274 = v_0271 - v_0272</expbody>
        <expresult> = 0.092</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 2 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0275 = v_0273*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0275 = v_0273*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)</expbody>
        <expresult> = 0.140</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0276 = v_0273*(v_0070^2 - v_0072^2)/(2*v_0068)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0276 = v_0273*(v_0070^2 - v_0072^2)/(2*v_0068)</expbody>
        <expresult> = 0.153</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 2 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0277 = Sqrt(6*v_0275/(v_0040*v_0035))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0277 = Sqrt(6*v_0275/(v_0040*v_0035))</expbody>
        <expresult> = 0.130</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 2 thickness bending [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0278 = v_0276/(v_0042*0.58*v_0035)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0278 = v_0276/(v_0042*0.58*v_0035)</expbody>
        <expresult> = 0.005</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 2 thickness shear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0279 = Max(v_0277, v_0278, v_0037 + 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0279 = Max(v_0277, v_0278, v_0037 + 0.0625)</expbody>
        <expresult> = 0.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Bending, shear and conservative weld-edge allowance; revise/recalculate after selecting thickness [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0280 = v_0275/v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0280 = v_0275/v_0034</expbody>
        <expresult> = 0.280</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Top/bottom weld couple separated conservatively by plate thickness [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0281 = Sqrt((v_0276/2)^2 + v_0280^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0281 = Sqrt((v_0276/2)^2 + v_0280^2)</expbody>
        <expresult> = 0.290</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Per fillet: half vertical shear + full radial couple force [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0282 = v_0071 + Sqrt(2)*v_0281/(v_0041*0.6*v_0038)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0282 = v_0071 + Sqrt(2)*v_0281/(v_0041*0.6*v_0038)</expbody>
        <expresult> = 0.075</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 2 weld strength leg [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0283 = Max(v_0282, v_0085)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0283 = Max(v_0282, v_0085)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength and minimum detailing; revise/recalculate after selecting weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0284 = Round(16*v_0283, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0284 = Round(16*v_0283, 0)</expbody>
        <expresult> = 4.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Nearest whole number of sixteenths [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0285 = If(v_0284 &gt;= 16*v_0283, v_0284, v_0284 + 1)/16" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0285 = If(v_0284 &gt;= 16*v_0283, v_0284, v_0284 + 1)/16</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Trial leg rounded up to the next 1/16 in [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0286 = v_0092 + (3 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0286 = v_0092 + (3 - 1)*v_0006</expbody>
        <expresult> = 139.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 3 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0287 = v_0092 + (3 - 1.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0287 = v_0092 + (3 - 1.5)*v_0006</expbody>
        <expresult> = 109.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 3 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0288 = v_0092 + (3 - 0.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0288 = v_0092 + (3 - 0.5)*v_0006</expbody>
        <expresult> = 169.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 3 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0289 = v_0288 - v_0287" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0289 = v_0288 - v_0287</expbody>
        <expresult> = 60.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 3 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0290 = v_0289*v_0230*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0290 = v_0289*v_0230*v_0003/1728</expbody>
        <expresult> = 45.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 3 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0291 = v_0021*v_0290" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0291 = v_0021*v_0290</expbody>
        <expresult> = 6.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 3 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0292 = v_0022*v_0291" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0292 = v_0022*v_0291</expbody>
        <expresult> = 8.438</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 3 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0293 = (v_0287 + v_0288)/2 - v_0286" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0293 = (v_0287 + v_0288)/2 - v_0286</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Retained for whole-wall equilibrium; carried by the wall, not the ring [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0294 = v_0292*(Abs(v_0293) + v_0011)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0294 = v_0292*(Abs(v_0293) + v_0011)</expbody>
        <expresult> = 25.312</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Superseded tributary-eccentricity basis (D-070); comparison only [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0295 = v_0231*v_0107*v_0112*Abs(v_0286 - v_0109)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0295 = v_0231*v_0107*v_0112*Abs(v_0286 - v_0109)</expbody>
        <expresult> = 0.121</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Rigid-body axial redistribution; sign taken to increase the ring force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0296 = v_0292 + v_0295" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0296 = v_0292 + v_0295</expbody>
        <expresult> = 8.558</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 3 design force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0297 = v_0114/v_0296" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0297 = v_0114/v_0296</expbody>
        <expresult> = 0.631</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0298 = v_0296/v_0073" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0298 = v_0296/v_0073</expbody>
        <expresult> = 0.105</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 3 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0299 = v_0114*v_0070/v_0074" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0299 = v_0114*v_0070/v_0074</expbody>
        <expresult> = 0.013</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 3 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0300 = v_0298 + v_0299" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0300 = v_0298 + v_0299</expbody>
        <expresult> = 0.118</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 3 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0301 = v_0298 - v_0299" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0301 = v_0298 - v_0299</expbody>
        <expresult> = 0.092</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 3 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0302 = v_0300*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0302 = v_0300*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)</expbody>
        <expresult> = 0.140</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0303 = v_0300*(v_0070^2 - v_0072^2)/(2*v_0068)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0303 = v_0300*(v_0070^2 - v_0072^2)/(2*v_0068)</expbody>
        <expresult> = 0.153</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 3 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0304 = Sqrt(6*v_0302/(v_0040*v_0035))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0304 = Sqrt(6*v_0302/(v_0040*v_0035))</expbody>
        <expresult> = 0.130</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 3 thickness bending [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0305 = v_0303/(v_0042*0.58*v_0035)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0305 = v_0303/(v_0042*0.58*v_0035)</expbody>
        <expresult> = 0.005</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 3 thickness shear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0306 = Max(v_0304, v_0305, v_0037 + 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0306 = Max(v_0304, v_0305, v_0037 + 0.0625)</expbody>
        <expresult> = 0.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Bending, shear and conservative weld-edge allowance; revise/recalculate after selecting thickness [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0307 = v_0302/v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0307 = v_0302/v_0034</expbody>
        <expresult> = 0.280</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Top/bottom weld couple separated conservatively by plate thickness [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0308 = Sqrt((v_0303/2)^2 + v_0307^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0308 = Sqrt((v_0303/2)^2 + v_0307^2)</expbody>
        <expresult> = 0.290</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Per fillet: half vertical shear + full radial couple force [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0309 = v_0071 + Sqrt(2)*v_0308/(v_0041*0.6*v_0038)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0309 = v_0071 + Sqrt(2)*v_0308/(v_0041*0.6*v_0038)</expbody>
        <expresult> = 0.075</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 3 weld strength leg [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0310 = Max(v_0309, v_0085)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0310 = Max(v_0309, v_0085)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength and minimum detailing; revise/recalculate after selecting weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0311 = Round(16*v_0310, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0311 = Round(16*v_0310, 0)</expbody>
        <expresult> = 4.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Nearest whole number of sixteenths [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0312 = If(v_0311 &gt;= 16*v_0310, v_0311, v_0311 + 1)/16" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0312 = If(v_0311 &gt;= 16*v_0310, v_0311, v_0311 + 1)/16</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Trial leg rounded up to the next 1/16 in [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0313 = v_0092 + (4 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0313 = v_0092 + (4 - 1)*v_0006</expbody>
        <expresult> = 199.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0314 = v_0092 + (4 - 1.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0314 = v_0092 + (4 - 1.5)*v_0006</expbody>
        <expresult> = 169.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0315 = v_0002" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0315 = v_0002</expbody>
        <expresult> = 219.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0316 = v_0315 - v_0314" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0316 = v_0315 - v_0314</expbody>
        <expresult> = 49.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0317 = v_0316*v_0230*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0317 = v_0316*v_0230*v_0003/1728</expbody>
        <expresult> = 37.125</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0318 = v_0021*v_0317" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0318 = v_0021*v_0317</expbody>
        <expresult> = 5.569</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0319 = v_0022*v_0318" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0319 = v_0022*v_0318</expbody>
        <expresult> = 6.961</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0320 = (v_0314 + v_0315)/2 - v_0313" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0320 = (v_0314 + v_0315)/2 - v_0313</expbody>
        <expresult> = -5.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Retained for whole-wall equilibrium; carried by the wall, not the ring [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0321 = v_0319*(Abs(v_0320) + v_0011)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0321 = v_0319*(Abs(v_0320) + v_0011)</expbody>
        <expresult> = 57.428</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Superseded tributary-eccentricity basis (D-070); comparison only [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0322 = v_0231*v_0107*v_0112*Abs(v_0313 - v_0109)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0322 = v_0231*v_0107*v_0112*Abs(v_0313 - v_0109)</expbody>
        <expresult> = 0.362</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Rigid-body axial redistribution; sign taken to increase the ring force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0323 = v_0319 + v_0322" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0323 = v_0319 + v_0322</expbody>
        <expresult> = 7.323</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 design force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0324 = v_0114/v_0323" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0324 = v_0114/v_0323</expbody>
        <expresult> = 0.737</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0325 = v_0323/v_0073" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0325 = v_0323/v_0073</expbody>
        <expresult> = 0.090</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0326 = v_0114*v_0070/v_0074" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0326 = v_0114*v_0070/v_0074</expbody>
        <expresult> = 0.013</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0327 = v_0325 + v_0326" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0327 = v_0325 + v_0326</expbody>
        <expresult> = 0.103</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0328 = v_0325 - v_0326" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0328 = v_0325 - v_0326</expbody>
        <expresult> = 0.077</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0329 = v_0327*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0329 = v_0327*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)</expbody>
        <expresult> = 0.122</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0330 = v_0327*(v_0070^2 - v_0072^2)/(2*v_0068)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0330 = v_0327*(v_0070^2 - v_0072^2)/(2*v_0068)</expbody>
        <expresult> = 0.133</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0331 = Sqrt(6*v_0329/(v_0040*v_0035))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0331 = Sqrt(6*v_0329/(v_0040*v_0035))</expbody>
        <expresult> = 0.121</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 thickness bending [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0332 = v_0330/(v_0042*0.58*v_0035)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0332 = v_0330/(v_0042*0.58*v_0035)</expbody>
        <expresult> = 0.005</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 thickness shear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0333 = Max(v_0331, v_0332, v_0037 + 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0333 = Max(v_0331, v_0332, v_0037 + 0.0625)</expbody>
        <expresult> = 0.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Bending, shear and conservative weld-edge allowance; revise/recalculate after selecting thickness [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0334 = v_0329/v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0334 = v_0329/v_0034</expbody>
        <expresult> = 0.244</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Top/bottom weld couple separated conservatively by plate thickness [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0335 = Sqrt((v_0330/2)^2 + v_0334^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0335 = Sqrt((v_0330/2)^2 + v_0334^2)</expbody>
        <expresult> = 0.253</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Per fillet: half vertical shear + full radial couple force [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0336 = v_0071 + Sqrt(2)*v_0335/(v_0041*0.6*v_0038)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0336 = v_0071 + Sqrt(2)*v_0335/(v_0041*0.6*v_0038)</expbody>
        <expresult> = 0.073</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 4 weld strength leg [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0337 = Max(v_0336, v_0085)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0337 = Max(v_0336, v_0085)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength and minimum detailing; revise/recalculate after selecting weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0338 = Round(16*v_0337, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0338 = Round(16*v_0337, 0)</expbody>
        <expresult> = 4.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Nearest whole number of sixteenths [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0339 = If(v_0338 &gt;= 16*v_0337, v_0338, v_0338 + 1)/16" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0339 = If(v_0338 &gt;= 16*v_0337, v_0338, v_0338 + 1)/16</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Trial leg rounded up to the next 1/16 in [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0340 = v_0023 + (3 - 1.5)*v_0024" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0340 = v_0023 + (3 - 1.5)*v_0024</expbody>
        <expresult> = 60.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 3 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0341 = v_0023 + (3 - 0.5)*v_0024" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0341 = v_0023 + (3 - 0.5)*v_0024</expbody>
        <expresult> = 96.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 3 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0342 = v_0341 - v_0340" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0342 = v_0341 - v_0340</expbody>
        <expresult> = 36.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 3 height [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0343 = v_0342/v_0004" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0343 = v_0342/v_0004</expbody>
        <expresult> = 0.185</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Row tributary fraction of the wall height [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0344 = v_0092 + (1 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0344 = v_0092 + (1 - 1)*v_0006</expbody>
        <expresult> = 19.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0345 = 0" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0345 = 0</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0346 = v_0092 + (1 - 0.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0346 = v_0092 + (1 - 0.5)*v_0006</expbody>
        <expresult> = 49.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0347 = v_0346 - v_0345" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0347 = v_0346 - v_0345</expbody>
        <expresult> = 49.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0348 = v_0347*v_0342*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0348 = v_0347*v_0342*v_0003/1728</expbody>
        <expresult> = 37.125</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0349 = v_0021*v_0348" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0349 = v_0021*v_0348</expbody>
        <expresult> = 5.569</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0350 = v_0022*v_0349" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0350 = v_0022*v_0349</expbody>
        <expresult> = 6.961</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0351 = (v_0345 + v_0346)/2 - v_0344" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0351 = (v_0345 + v_0346)/2 - v_0344</expbody>
        <expresult> = 5.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Retained for whole-wall equilibrium; carried by the wall, not the ring [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0352 = v_0350*(Abs(v_0351) + v_0011)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0352 = v_0350*(Abs(v_0351) + v_0011)</expbody>
        <expresult> = 57.428</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Superseded tributary-eccentricity basis (D-070); comparison only [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0353 = v_0343*v_0107*v_0112*Abs(v_0344 - v_0109)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0353 = v_0343*v_0107*v_0112*Abs(v_0344 - v_0109)</expbody>
        <expresult> = 0.362</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Rigid-body axial redistribution; sign taken to increase the ring force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0354 = v_0350 + v_0353" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0354 = v_0350 + v_0353</expbody>
        <expresult> = 7.323</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 design force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0355 = v_0114/v_0354" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0355 = v_0114/v_0354</expbody>
        <expresult> = 0.737</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0356 = v_0354/v_0073" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0356 = v_0354/v_0073</expbody>
        <expresult> = 0.090</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0357 = v_0114*v_0070/v_0074" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0357 = v_0114*v_0070/v_0074</expbody>
        <expresult> = 0.013</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0358 = v_0356 + v_0357" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0358 = v_0356 + v_0357</expbody>
        <expresult> = 0.103</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0359 = v_0356 - v_0357" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0359 = v_0356 - v_0357</expbody>
        <expresult> = 0.077</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0360 = v_0358*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0360 = v_0358*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)</expbody>
        <expresult> = 0.122</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0361 = v_0358*(v_0070^2 - v_0072^2)/(2*v_0068)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0361 = v_0358*(v_0070^2 - v_0072^2)/(2*v_0068)</expbody>
        <expresult> = 0.133</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0362 = Sqrt(6*v_0360/(v_0040*v_0035))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0362 = Sqrt(6*v_0360/(v_0040*v_0035))</expbody>
        <expresult> = 0.121</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 thickness bending [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0363 = v_0361/(v_0042*0.58*v_0035)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0363 = v_0361/(v_0042*0.58*v_0035)</expbody>
        <expresult> = 0.005</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 thickness shear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0364 = Max(v_0362, v_0363, v_0037 + 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0364 = Max(v_0362, v_0363, v_0037 + 0.0625)</expbody>
        <expresult> = 0.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Bending, shear and conservative weld-edge allowance; revise/recalculate after selecting thickness [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0365 = v_0360/v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0365 = v_0360/v_0034</expbody>
        <expresult> = 0.244</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Top/bottom weld couple separated conservatively by plate thickness [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0366 = Sqrt((v_0361/2)^2 + v_0365^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0366 = Sqrt((v_0361/2)^2 + v_0365^2)</expbody>
        <expresult> = 0.253</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Per fillet: half vertical shear + full radial couple force [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0367 = v_0071 + Sqrt(2)*v_0366/(v_0041*0.6*v_0038)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0367 = v_0071 + Sqrt(2)*v_0366/(v_0041*0.6*v_0038)</expbody>
        <expresult> = 0.073</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 1 weld strength leg [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0368 = Max(v_0367, v_0085)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0368 = Max(v_0367, v_0085)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength and minimum detailing; revise/recalculate after selecting weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0369 = Round(16*v_0368, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0369 = Round(16*v_0368, 0)</expbody>
        <expresult> = 4.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Nearest whole number of sixteenths [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0370 = If(v_0369 &gt;= 16*v_0368, v_0369, v_0369 + 1)/16" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0370 = If(v_0369 &gt;= 16*v_0368, v_0369, v_0369 + 1)/16</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Trial leg rounded up to the next 1/16 in [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0371 = v_0092 + (2 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0371 = v_0092 + (2 - 1)*v_0006</expbody>
        <expresult> = 79.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 2 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0372 = v_0092 + (2 - 1.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0372 = v_0092 + (2 - 1.5)*v_0006</expbody>
        <expresult> = 49.500</expresult>
