    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Retained for whole-wall equilibrium; carried by the wall, not the ring [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0433 = v_0431*(Abs(v_0432) + v_0011)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0433 = v_0431*(Abs(v_0432) + v_0011)</expbody>
        <expresult> = 57.428</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Superseded tributary-eccentricity basis (D-070); comparison only [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0434 = v_0343*v_0107*v_0112*Abs(v_0425 - v_0109)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0434 = v_0343*v_0107*v_0112*Abs(v_0425 - v_0109)</expbody>
        <expresult> = 0.362</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Rigid-body axial redistribution; sign taken to increase the ring force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0435 = v_0431 + v_0434" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0435 = v_0431 + v_0434</expbody>
        <expresult> = 7.323</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 4 design force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0436 = v_0114/v_0435" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0436 = v_0114/v_0435</expbody>
        <expresult> = 0.737</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0437 = v_0435/v_0073" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0437 = v_0435/v_0073</expbody>
        <expresult> = 0.090</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 4 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0438 = v_0114*v_0070/v_0074" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0438 = v_0114*v_0070/v_0074</expbody>
        <expresult> = 0.013</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 4 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0439 = v_0437 + v_0438" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0439 = v_0437 + v_0438</expbody>
        <expresult> = 0.103</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 4 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0440 = v_0437 - v_0438" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0440 = v_0437 - v_0438</expbody>
        <expresult> = 0.077</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 4 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0441 = v_0439*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0441 = v_0439*((v_0070^3 - v_0072^3)/(3*v_0068) - (v_0070^2 - v_0072^2)/2)</expbody>
        <expresult> = 0.122</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0442 = v_0439*(v_0070^2 - v_0072^2)/(2*v_0068)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0442 = v_0439*(v_0070^2 - v_0072^2)/(2*v_0068)</expbody>
        <expresult> = 0.133</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 4 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0443 = Sqrt(6*v_0441/(v_0040*v_0035))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0443 = Sqrt(6*v_0441/(v_0040*v_0035))</expbody>
        <expresult> = 0.121</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 4 thickness bending [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0444 = v_0442/(v_0042*0.58*v_0035)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0444 = v_0442/(v_0042*0.58*v_0035)</expbody>
        <expresult> = 0.005</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 4 thickness shear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0445 = Max(v_0443, v_0444, v_0037 + 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0445 = Max(v_0443, v_0444, v_0037 + 0.0625)</expbody>
        <expresult> = 0.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Bending, shear and conservative weld-edge allowance; revise/recalculate after selecting thickness [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0446 = v_0441/v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0446 = v_0441/v_0034</expbody>
        <expresult> = 0.244</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Top/bottom weld couple separated conservatively by plate thickness [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0447 = Sqrt((v_0442/2)^2 + v_0446^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0447 = Sqrt((v_0442/2)^2 + v_0446^2)</expbody>
        <expresult> = 0.253</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Per fillet: half vertical shear + full radial couple force [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0448 = v_0071 + Sqrt(2)*v_0447/(v_0041*0.6*v_0038)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0448 = v_0071 + Sqrt(2)*v_0447/(v_0041*0.6*v_0038)</expbody>
        <expresult> = 0.073</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 3 4 weld strength leg [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0449 = Max(v_0448, v_0085)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0449 = Max(v_0448, v_0085)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength and minimum detailing; revise/recalculate after selecting weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0450 = Round(16*v_0449, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0450 = Round(16*v_0449, 0)</expbody>
        <expresult> = 4.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Nearest whole number of sixteenths [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0451 = If(v_0450 &gt;= 16*v_0449, v_0450, v_0450 + 1)/16" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0451 = If(v_0450 &gt;= 16*v_0449, v_0450, v_0450 + 1)/16</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Trial leg rounded up to the next 1/16 in [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0452 = v_0023 + (4 - 1.5)*v_0024" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0452 = v_0023 + (4 - 1.5)*v_0024</expbody>
        <expresult> = 96.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 4 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0453 = v_0023 + (4 - 0.5)*v_0024" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0453 = v_0023 + (4 - 0.5)*v_0024</expbody>
        <expresult> = 132.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 4 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0454 = v_0453 - v_0452" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0454 = v_0453 - v_0452</expbody>
        <expresult> = 36.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 4 height [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0455 = v_0454/v_0004" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0455 = v_0454/v_0004</expbody>
        <expresult> = 0.185</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Row tributary fraction of the wall height [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0456 = v_0092 + (1 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0456 = v_0092 + (1 - 1)*v_0006</expbody>
        <expresult> = 19.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 1 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0457 = 0" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0457 = 0</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 1 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0458 = v_0092 + (1 - 0.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0458 = v_0092 + (1 - 0.5)*v_0006</expbody>
        <expresult> = 49.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 1 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0459 = v_0458 - v_0457" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0459 = v_0458 - v_0457</expbody>
        <expresult> = 49.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 1 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0460 = v_0459*v_0454*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0460 = v_0459*v_0454*v_0003/1728</expbody>
        <expresult> = 37.125</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 1 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0461 = v_0021*v_0460" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0461 = v_0021*v_0460</expbody>
        <expresult> = 5.569</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 1 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0462 = v_0022*v_0461" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0462 = v_0022*v_0461</expbody>
        <expresult> = 6.961</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 1 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0463 = (v_0457 + v_0458)/2 - v_0456" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0463 = (v_0457 + v_0458)/2 - v_0456</expbody>
        <expresult> = 5.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Retained for whole-wall equilibrium; carried by the wall, not the ring [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0464 = v_0462*(Abs(v_0463) + v_0011)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0464 = v_0462*(Abs(v_0463) + v_0011)</expbody>
        <expresult> = 57.428</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Superseded tributary-eccentricity basis (D-070); comparison only [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0465 = v_0455*v_0107*v_0112*Abs(v_0456 - v_0109)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
