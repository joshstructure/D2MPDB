    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 5 3 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0627 = (v_0621 + v_0622)/2 - v_0620" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0627 = (v_0621 + v_0622)/2 - v_0620</expbody>
        <expresult> = 0.000</expresult>
