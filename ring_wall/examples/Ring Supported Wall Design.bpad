    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bar area [in²]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0047 = Max(0.11, Min(0.6, 1.3*v_0003*v_0002/(2*(v_0003 + v_0002)*v_0020)))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0047 = Max(0.11, Min(0.6, 1.3*v_0003*v_0002/(2*(v_0003 + v_0002)*v_0020)))</expbody>
        <expresult> = 0.334</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">steel L [in²/ft]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0048 = Max(0.11, Min(0.6, 1.3*v_0003*v_0004/(2*(v_0003 + v_0004)*v_0020)))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0048 = Max(0.11, Min(0.6, 1.3*v_0003*v_0004/(2*(v_0003 + v_0004)*v_0020)))</expbody>
        <expresult> = 0.323</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">steel H [in²/ft]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0049 = Max(v_0047, v_0048)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0049 = Max(v_0047, v_0048)</expbody>
        <expresult> = 0.334</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Both directions / each face; gross-section envelope [in²/ft]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0050 = Min(1.5*v_0003, If(v_0003 &gt; 36, 12, 18))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0050 = Min(1.5*v_0003, If(v_0003 &gt; 36, 12, 18))</expbody>
        <expresult> = 18.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Conservative wall/slab and thick-member spacing envelope [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0051 = Min(v_0050, v_0029)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0051 = Min(v_0050, v_0029)</expbody>
        <expresult> = 12.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">pitch limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0052 = 11" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0052 = 11</expbody>
        <expresult> = 11.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Adopted pitch; fixed input in distilled sheets [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0053 = 12*v_0046/v_0052" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0053 = 12*v_0046/v_0052</expbody>
        <expresult> = 0.338</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">steel provided [in²/ft]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0054 = Max(1.5, 1.5*v_0045, 1.5*v_0018)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0054 = Max(1.5, 1.5*v_0045, 1.5*v_0018)</expbody>
        <expresult> = 1.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">clear required [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0055 = v_0052 - v_0045" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0055 = v_0052 - v_0045</expbody>
        <expresult> = 10.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">clear provided [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0056 = 1" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0056 = 1</expbody>
        <expresult> = 1.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">coating factor [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0057 = 0.17*v_0045*(v_0020/(1.97*v_0019^0.25))^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0057 = 0.17*v_0045*(v_0020/(1.97*v_0019^0.25))^2</expbody>
        <expresult> = 42.026</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Normalweight; no confinement credit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0058 = Max(12, v_0057*Min(1.7, 1.3*v_0056))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0058 = Max(12, v_0057*Min(1.7, 1.3*v_0056))</expbody>
        <expresult> = 54.634</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Conservative top-cast factor [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0059 = Max(12, v_0057*v_0056)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0059 = Max(12, v_0057*v_0056)</expbody>
        <expresult> = 42.026</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ld vertical [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0060 = 1.3*v_0058" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0060 = 1.3*v_0058</expbody>
        <expresult> = 71.024</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">lap horizontal [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0061 = 1.3*v_0059" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0061 = 1.3*v_0059</expbody>
        <expresult> = 54.634</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">lap vertical [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0062 = If(v_0026 &lt;= 8, 6, 8)*v_0045 + 2*v_0045" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0062 = If(v_0026 &lt;= 8, 6, 8)*v_0045 + 2*v_0045</expbody>
        <expresult> = 5.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bend envelope [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0063 = v_0003 - 2*v_0016" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0063 = v_0003 - 2*v_0016</expbody>
        <expresult> = 30.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">u width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0064 = v_0002 - 2*v_0016 - 2*v_0045" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0064 = v_0002 - 2*v_0016 - 2*v_0045</expbody>
        <expresult> = 205.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">u leg available [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0065 = v_0004 - 2*v_0016 - 2*v_0045" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0065 = v_0004 - 2*v_0016 - 2*v_0045</expbody>
        <expresult> = 165.125</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">vertical available [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0066 = v_0007/2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0066 = v_0007/2</expbody>
        <expresult> = 10.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">pipe radius [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0067 = v_0032/2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0067 = v_0032/2</expbody>
        <expresult> = 10.062</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">inner radius [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0068 = v_0033/2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0068 = v_0033/2</expbody>
        <expresult> = 11.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">outer radius [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0069 = v_0067 - v_0066" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0069 = v_0067 - v_0066</expbody>
        <expresult> = 0.062</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">root gap [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0070 = Max(v_0067, v_0066 + v_0037)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0070 = Max(v_0067, v_0066 + v_0037)</expbody>
        <expresult> = 10.312</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Horizontal bearing excludes upper weld footprint [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0071 = v_0044*(v_0068^2 - v_0070^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0071 = v_0044*(v_0068^2 - v_0070^2)</expbody>
        <expresult> = 81.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bearing area [in²]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0072 = v_0044*(v_0068^4 - v_0070^4)/4" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0072 = v_0044*(v_0068^4 - v_0070^4)/4</expbody>
        <expresult> = 4853.948</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bearing inertia [in⁴]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0073 = v_0039*0.85*v_0019" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0073 = v_0039*0.85*v_0019</expbody>
        <expresult> = 3.272</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">No supporting-area enhancement; m = 1 [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0074 = v_0040*v_0035*v_0034^2/6" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0074 = v_0040*v_0035*v_0034^2/6</expbody>
        <expresult> = 4.688</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Elastic radial cantilever strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0075 = v_0042*0.58*v_0035*v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0075 = v_0042*0.58*v_0035*v_0034</expbody>
        <expresult> = 21.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">plate shear capacity [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0076 = (v_0037 - v_0069)/Sqrt(2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0076 = (v_0037 - v_0069)/Sqrt(2)</expbody>
        <expresult> = 0.177</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Conservative fit-up allowance; WPS must permit gap [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0077 = v_0041*0.6*v_0038*v_0076" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0077 = v_0041*0.6*v_0038*v_0076</expbody>
        <expresult> = 5.940</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">One continuous fillet; no directional enhancement [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0078 = Max(v_0034, v_0008)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0078 = Max(v_0034, v_0008)</expbody>
        <expresult> = 0.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">thicker part [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0079 = If(v_0078 &lt;= 0.75, 0.25, 0.3125)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0079 = If(v_0078 &lt;= 0.75, 0.25, 0.3125)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum thick weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0080 = If(v_0078 &lt;= 0.5, 0.1875, v_0079)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0080 = If(v_0078 &lt;= 0.5, 0.1875, v_0079)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum mid weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0081 = If(v_0078 &lt;= 0.25, 0.125, v_0080)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0081 = If(v_0078 &lt;= 0.25, 0.125, v_0080)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum table weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0082 = Min(v_0081, v_0034, v_0008)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0082 = Min(v_0081, v_0034, v_0008)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">weld minimum [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0083 = v_0082 + v_0069" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0083 = v_0082 + v_0069</expbody>
        <expresult> = 0.312</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">weld min gap [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0084 = If(v_0034 &lt; 0.25, v_0034, v_0034 - 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0084 = If(v_0034 &lt; 0.25, v_0034, v_0034 - 0.0625)</expbody>
        <expresult> = 0.688</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Ring edge limit; pipe is a face, not free edge [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0085 = 2*v_0044*v_0066" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0085 = 2*v_0044*v_0066</expbody>
        <expresult> = 62.832</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Each of two continuous circumferential welds [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0086 = Max(4*v_0037, 1.5)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0086 = Max(4*v_0037, 1.5)</expbody>
        <expresult> = 1.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">weld length min [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0087 = v_0043*0.58*v_0036*v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0087 = v_0043*0.58*v_0036*v_0034</expbody>
        <expresult> = 22.620</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring base capacity [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0088 = v_0043*0.58*v_0010*v_0008" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0088 = v_0043*0.58*v_0010*v_0008</expbody>
        <expresult> = 14.326</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">pipe base capacity [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0089 = v_0042*0.58*v_0009*v_0008" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0089 = v_0042*0.58*v_0009*v_0008</expbody>
        <expresult> = 13.775</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">pipe yield capacity [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0090 = (v_0002 - (v_0005 - 1)*v_0006)/2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0090 = (v_0002 - (v_0005 - 1)*v_0006)/2</expbody>
        <expresult> = 16.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">end offset [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0091 = v_0090 - v_0068 - v_0011" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0091 = v_0090 - v_0068 - v_0011</expbody>
        <expresult> = 2.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">end clear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0092 = v_0003/2 - v_0068 - v_0011" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0092 = v_0003/2 - v_0068 - v_0011</expbody>
        <expresult> = 3.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">face clear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0093 = v_0003/2 - v_0016 - 2*v_0045 - v_0068 - v_0011" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0093 = v_0003/2 - v_0016 - 2*v_0045 - v_0068 - v_0011</expbody>
        <expresult> = -0.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">grid gap [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0094 = Max(1, 1.5*v_0018)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0094 = Max(1, 1.5*v_0018)</expbody>
        <expresult> = 1.125</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring grid required [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0095 = v_0023 - v_0034 - v_0037" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0095 = v_0023 - v_0034 - v_0037</expbody>
        <expresult> = 4.938</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bottom ring cover [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0096 = v_0004 - v_0023 - (v_0025 - 1)*v_0024 - v_0037" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0096 = v_0004 - v_0023 - (v_0025 - 1)*v_0024 - v_0037</expbody>
        <expresult> = 22.062</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">top ring cover [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0097 = v_0006 - v_0033 - 2*v_0011" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0097 = v_0006 - v_0033 - 2*v_0011</expbody>
        <expresult> = 31.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">between rings [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0098 = v_0021*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0098 = v_0021*v_0003/1728</expbody>
        <expresult> = 0.003</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Gross concrete prism; no pipe/plate displacement deduction [kip/in²]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0099 = v_0022*v_0098" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0099 = v_0022*v_0098</expbody>
        <expresult> = 0.004</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored density [kip/in²]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0100 = v_0098*v_0002*v_0004" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0100 = v_0098*v_0002*v_0004</expbody>
        <expresult> = 114.737</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">total service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0101 = v_0022*v_0100" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0101 = v_0022*v_0100</expbody>
        <expresult> = 143.421</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">total factored [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0102 = v_0066 - v_0008" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0102 = v_0066 - v_0008</expbody>
        <expresult> = 9.525</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Effective pipe wall [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0103 = v_0044*(v_0066^2 - v_0102^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0103 = v_0044*(v_0066^2 - v_0102^2)</expbody>
        <expresult> = 29.136</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">pipe area [in²]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0104 = v_0044*(v_0066^4 - v_0102^4)/4" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0104 = v_0044*(v_0066^4 - v_0102^4)/4</expbody>
        <expresult> = 1389.260</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">pipe inertia [in⁴]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0105 = v_0103*v_0012/v_0014" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0105 = v_0103*v_0012/v_0014</expbody>
        <expresult> = 1408.255</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Axial spring over the entered effective length [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0106 = 4*v_0012*v_0104/v_0013" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0106 = 4*v_0012*v_0104/v_0013</expbody>
        <expresult> = 1268930.536</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Head translation restrained; bound of the fixed-base cantilever family [kip-in/rad]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0107 = v_0090 + (v_0005 - 1)*v_0006/2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0107 = v_0090 + (v_0005 - 1)*v_0006/2</expbody>
        <expresult> = 106.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">group centroid [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0108 = v_0006^2*v_0005*(v_0005^2 - 1)/12" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0108 = v_0006^2*v_0005*(v_0005^2 - 1)/12</expbody>
        <expresult> = 18000.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Equally spaced piles; zero for one pile [in²]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0109 = v_0101*v_0011/(v_0105*v_0108 + v_0005*v_0106)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0109 = v_0101*v_0011/(v_0105*v_0108 + v_0005*v_0106)</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Pile group displaced by the tolerance relative to the wall centroid [rad]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0110 = v_0109 + v_0015" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0110 = v_0109 + v_0015</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Applied to every pile head [rad]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0111 = v_0106*v_0110" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0111 = v_0106*v_0110</expbody>
        <expresult> = 17.945</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compatibility moment at one pile head [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0112 = v_0111/v_0025" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0112 = v_0111/v_0025</expbody>
        <expresult> = 3.589</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Shared equally by the ring rows; no shaft-bearing credit [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0113 = v_0072/(v_0071*v_0068)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0113 = v_0072/(v_0071*v_0068)</expbody>
        <expresult> = 5.187</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Equivalent eccentricity at which full contact is lost [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0114 = 0" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0114 = 0</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 1 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0115 = v_0023 + (1 - 0.5)*v_0024" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0115 = v_0023 + (1 - 0.5)*v_0024</expbody>
        <expresult> = 24.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 1 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0116 = v_0115 - v_0114" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0116 = v_0115 - v_0114</expbody>
        <expresult> = 24.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 1 height [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0117 = v_0116/v_0004" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0117 = v_0116/v_0004</expbody>
        <expresult> = 0.139</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Row tributary fraction of the wall height [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0118 = v_0090 + (1 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0118 = v_0090 + (1 - 1)*v_0006</expbody>
        <expresult> = 16.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0119 = 0" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0119 = 0</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0120 = v_0090 + (1 - 0.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0120 = v_0090 + (1 - 0.5)*v_0006</expbody>
        <expresult> = 46.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0121 = v_0120 - v_0119" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0121 = v_0120 - v_0119</expbody>
        <expresult> = 46.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0122 = v_0121*v_0116*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0122 = v_0121*v_0116*v_0003/1728</expbody>
        <expresult> = 23.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0123 = v_0021*v_0122" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0123 = v_0021*v_0122</expbody>
        <expresult> = 3.487</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0124 = v_0022*v_0123" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0124 = v_0022*v_0123</expbody>
        <expresult> = 4.359</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0125 = (v_0119 + v_0120)/2 - v_0118" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0125 = (v_0119 + v_0120)/2 - v_0118</expbody>
        <expresult> = 6.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Retained for whole-wall equilibrium; carried by the wall, not the ring [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0126 = v_0124*(Abs(v_0125) + v_0011)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0126 = v_0124*(Abs(v_0125) + v_0011)</expbody>
        <expresult> = 42.504</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Superseded tributary-eccentricity basis (D-070); comparison only [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0127 = v_0117*v_0105*v_0110*Abs(v_0118 - v_0107)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0127 = v_0117*v_0105*v_0110*Abs(v_0118 - v_0107)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Rigid-body axial redistribution; sign taken to increase the ring force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0128 = v_0124 + v_0127" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0128 = v_0124 + v_0127</expbody>
        <expresult> = 4.609</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 design force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0129 = v_0112/v_0128" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0129 = v_0112/v_0128</expbody>
        <expresult> = 0.779</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0130 = v_0128/v_0071" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0130 = v_0128/v_0071</expbody>
        <expresult> = 0.057</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0131 = v_0112*v_0068/v_0072" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0131 = v_0112*v_0068/v_0072</expbody>
        <expresult> = 0.009</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0132 = v_0130 + v_0131" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0132 = v_0130 + v_0131</expbody>
        <expresult> = 0.065</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0133 = v_0130 - v_0131" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0133 = v_0130 - v_0131</expbody>
        <expresult> = 0.048</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0134 = v_0132*((v_0068^3 - v_0070^3)/(3*v_0066) - (v_0068^2 - v_0070^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0134 = v_0132*((v_0068^3 - v_0070^3)/(3*v_0066) - (v_0068^2 - v_0070^2)/2)</expbody>
        <expresult> = 0.077</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0135 = v_0132*(v_0068^2 - v_0070^2)/(2*v_0066)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0135 = v_0132*(v_0068^2 - v_0070^2)/(2*v_0066)</expbody>
        <expresult> = 0.084</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0136 = Sqrt(6*v_0134/(v_0040*v_0035))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0136 = Sqrt(6*v_0134/(v_0040*v_0035))</expbody>
        <expresult> = 0.096</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 1 thickness bending [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0137 = v_0135/(v_0042*0.58*v_0035)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0137 = v_0135/(v_0042*0.58*v_0035)</expbody>
        <expresult> = 0.003</expresult>
