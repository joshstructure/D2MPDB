    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 4 3 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0486 = v_0022*v_0485" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0486 = v_0022*v_0485</expbody>
        <expresult> = 8.438</expresult>
