    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Rigid-body axial redistribution; sign taken to increase the ring force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0657 = v_0653 + v_0656" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0657 = v_0653 + v_0656</expbody>
        <expresult> = 12.788</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 5 4 design force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0658 = v_0112/v_0657" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0658 = v_0112/v_0657</expbody>
        <expresult> = 0.422</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0659 = v_0657/v_0071" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0659 = v_0657/v_0071</expbody>
        <expresult> = 0.157</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 5 4 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0660 = v_0112*v_0068/v_0072" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0660 = v_0112*v_0068/v_0072</expbody>
        <expresult> = 0.013</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 5 4 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0661 = v_0659 + v_0660" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0661 = v_0659 + v_0660</expbody>
        <expresult> = 0.170</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 5 4 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0662 = v_0659 - v_0660" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0662 = v_0659 - v_0660</expbody>
        <expresult> = 0.144</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 5 4 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0663 = v_0661*((v_0068^3 - v_0070^3)/(3*v_0066) - (v_0068^2 - v_0070^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0663 = v_0661*((v_0068^3 - v_0070^3)/(3*v_0066) - (v_0068^2 - v_0070^2)/2)</expbody>
        <expresult> = 0.202</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0664 = v_0661*(v_0068^2 - v_0070^2)/(2*v_0066)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0664 = v_0661*(v_0068^2 - v_0070^2)/(2*v_0066)</expbody>
        <expresult> = 0.220</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 5 4 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0665 = Sqrt(6*v_0663/(v_0040*v_0035))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0665 = Sqrt(6*v_0663/(v_0040*v_0035))</expbody>
        <expresult> = 0.156</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 5 4 thickness bending [in]</paragraph>
