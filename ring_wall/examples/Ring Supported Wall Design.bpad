      <dynexp formula="v_0118 = v_0117 - v_0116" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0118 = v_0117 - v_0116</expbody>
        <expresult> = 24.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 1 height [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0119 = v_0118/v_0004" mathlayout="on" showformula="True" showresult="True" showsteps="False">
