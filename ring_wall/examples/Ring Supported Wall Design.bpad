    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0182 = v_0180*((v_0064^3 - v_0066^3)/(3*v_0062) - (v_0064^2 - v_0066^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0182 = v_0180*((v_0064^3 - v_0066^3)/(3*v_0062) - (v_0064^2 - v_0066^2)/2)</expbody>
        <expresult> = 0.183</expresult>
