      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0180 = v_0178/v_0071" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0180 = v_0178/v_0071</expbody>
        <expresult> = 0.070</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0181 = v_0112*v_0068/v_0072" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0181 = v_0112*v_0068/v_0072</expbody>
        <expresult> = 0.009</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0182 = v_0180 + v_0181" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0182 = v_0180 + v_0181</expbody>
        <expresult> = 0.079</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0183 = v_0180 - v_0181" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0183 = v_0180 - v_0181</expbody>
        <expresult> = 0.062</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0184 = v_0182*((v_0068^3 - v_0070^3)/(3*v_0066) - (v_0068^2 - v_0070^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0184 = v_0182*((v_0068^3 - v_0070^3)/(3*v_0066) - (v_0068^2 - v_0070^2)/2)</expbody>
        <expresult> = 0.093</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0185 = v_0182*(v_0068^2 - v_0070^2)/(2*v_0066)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0185 = v_0182*(v_0068^2 - v_0070^2)/(2*v_0066)</expbody>
        <expresult> = 0.102</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0186 = Sqrt(6*v_0184/(v_0040*v_0035))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0186 = Sqrt(6*v_0184/(v_0040*v_0035))</expbody>
        <expresult> = 0.106</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 thickness bending [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0187 = v_0185/(v_0042*0.58*v_0035)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0187 = v_0185/(v_0042*0.58*v_0035)</expbody>
        <expresult> = 0.004</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 thickness shear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0188 = Max(v_0186, v_0187, v_0037 + 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0188 = Max(v_0186, v_0187, v_0037 + 0.0625)</expbody>
        <expresult> = 0.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Bending, shear and conservative weld-edge allowance; revise/recalculate after selecting thickness [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0189 = v_0184/v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0189 = v_0184/v_0034</expbody>
        <expresult> = 0.125</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Top/bottom weld couple separated conservatively by plate thickness [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0190 = Sqrt((v_0185/2)^2 + v_0189^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0190 = Sqrt((v_0185/2)^2 + v_0189^2)</expbody>
        <expresult> = 0.135</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Per fillet: half vertical shear + full radial couple force [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0191 = v_0069 + Sqrt(2)*v_0190/(v_0041*0.6*v_0038)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0191 = v_0069 + Sqrt(2)*v_0190/(v_0041*0.6*v_0038)</expbody>
        <expresult> = 0.068</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 3 weld strength leg [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0192 = Max(v_0191, v_0083)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0192 = Max(v_0191, v_0083)</expbody>
        <expresult> = 0.312</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength and minimum detailing; revise/recalculate after selecting weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0193 = v_0090 + (4 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0193 = v_0090 + (4 - 1)*v_0006</expbody>
        <expresult> = 196.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0194 = v_0090 + (4 - 1.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0194 = v_0090 + (4 - 1.5)*v_0006</expbody>
        <expresult> = 166.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0195 = v_0002" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0195 = v_0002</expbody>
        <expresult> = 213.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0196 = v_0195 - v_0194" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0196 = v_0195 - v_0194</expbody>
        <expresult> = 46.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 width [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0197 = v_0196*v_0116*v_0003/1728" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0197 = v_0196*v_0116*v_0003/1728</expbody>
        <expresult> = 23.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 volume [ft³]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0198 = v_0021*v_0197" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0198 = v_0021*v_0197</expbody>
        <expresult> = 3.487</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 service [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0199 = v_0022*v_0198" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0199 = v_0022*v_0198</expbody>
        <expresult> = 4.359</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0200 = (v_0194 + v_0195)/2 - v_0193" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0200 = (v_0194 + v_0195)/2 - v_0193</expbody>
        <expresult> = -6.750</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Retained for whole-wall equilibrium; carried by the wall, not the ring [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0201 = v_0199*(Abs(v_0200) + v_0011)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0201 = v_0199*(Abs(v_0200) + v_0011)</expbody>
        <expresult> = 42.504</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Superseded tributary-eccentricity basis (D-070); comparison only [kip-in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0202 = v_0117*v_0105*v_0110*Abs(v_0193 - v_0107)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0202 = v_0117*v_0105*v_0110*Abs(v_0193 - v_0107)</expbody>
        <expresult> = 0.250</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Rigid-body axial redistribution; sign taken to increase the ring force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0203 = v_0199 + v_0202" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0203 = v_0199 + v_0202</expbody>
        <expresult> = 4.609</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 design force [kip]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0204 = v_0112/v_0203" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0204 = v_0112/v_0203</expbody>
        <expresult> = 0.779</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Compare with the kern limit [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0205 = v_0203/v_0071" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0205 = v_0203/v_0071</expbody>
        <expresult> = 0.057</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 qavg [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0206 = v_0112*v_0068/v_0072" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0206 = v_0112*v_0068/v_0072</expbody>
        <expresult> = 0.009</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 qmoment [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0207 = v_0205 + v_0206" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0207 = v_0205 + v_0206</expbody>
        <expresult> = 0.065</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 qmax [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0208 = v_0205 - v_0206" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0208 = v_0205 - v_0206</expbody>
        <expresult> = 0.048</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 qmin [ksi]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0209 = v_0207*((v_0068^3 - v_0070^3)/(3*v_0066) - (v_0068^2 - v_0070^2)/2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0209 = v_0207*((v_0068^3 - v_0070^3)/(3*v_0066) - (v_0068^2 - v_0070^2)/2)</expbody>
        <expresult> = 0.077</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Peak pressure over full radial strip [kip-in/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0210 = v_0207*(v_0068^2 - v_0070^2)/(2*v_0066)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0210 = v_0207*(v_0068^2 - v_0070^2)/(2*v_0066)</expbody>
        <expresult> = 0.084</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 root shear [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0211 = Sqrt(6*v_0209/(v_0040*v_0035))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0211 = Sqrt(6*v_0209/(v_0040*v_0035))</expbody>
        <expresult> = 0.096</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 thickness bending [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0212 = v_0210/(v_0042*0.58*v_0035)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0212 = v_0210/(v_0042*0.58*v_0035)</expbody>
        <expresult> = 0.003</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 thickness shear [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0213 = Max(v_0211, v_0212, v_0037 + 0.0625)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0213 = Max(v_0211, v_0212, v_0037 + 0.0625)</expbody>
        <expresult> = 0.375</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Bending, shear and conservative weld-edge allowance; revise/recalculate after selecting thickness [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0214 = v_0209/v_0034" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0214 = v_0209/v_0034</expbody>
        <expresult> = 0.103</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Top/bottom weld couple separated conservatively by plate thickness [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0215 = Sqrt((v_0210/2)^2 + v_0214^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0215 = Sqrt((v_0210/2)^2 + v_0214^2)</expbody>
        <expresult> = 0.111</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Per fillet: half vertical shear + full radial couple force [kip/in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0216 = v_0069 + Sqrt(2)*v_0215/(v_0041*0.6*v_0038)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0216 = v_0069 + Sqrt(2)*v_0215/(v_0041*0.6*v_0038)</expbody>
        <expresult> = 0.067</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 1 4 weld strength leg [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0217 = Max(v_0216, v_0083)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0217 = Max(v_0216, v_0083)</expbody>
        <expresult> = 0.312</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength and minimum detailing; revise/recalculate after selecting weld [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0218 = v_0023 + (2 - 1.5)*v_0024" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0218 = v_0023 + (2 - 1.5)*v_0024</expbody>
        <expresult> = 24.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 2 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0219 = v_0023 + (2 - 0.5)*v_0024" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0219 = v_0023 + (2 - 0.5)*v_0024</expbody>
        <expresult> = 60.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 2 hi [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0220 = v_0219 - v_0218" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0220 = v_0219 - v_0218</expbody>
        <expresult> = 36.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">row 2 height [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0221 = v_0220/v_0004" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0221 = v_0220/v_0004</expbody>
        <expresult> = 0.209</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Row tributary fraction of the wall height [—]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0222 = v_0090 + (1 - 1)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0222 = v_0090 + (1 - 1)*v_0006</expbody>
        <expresult> = 16.500</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 x [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0223 = 0" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0223 = 0</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ring 2 1 lo [in]</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="v_0224 = v_0090 + (1 - 0.5)*v_0006" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>v_0224 = v_0090 + (1 - 0.5)*v_0006</expbody>
        <expresult> = 46.500</expresult>
