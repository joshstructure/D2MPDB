    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">4. Pile spacing</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="S_min = 3*D_pile to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>S_min = 3*D_pile to in</expbody>
        <expresult> = 60.000 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum center-to-center spacing, 3.0 diameters (SDG 3.5.4)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="s_over_D = S_pile/D_pile" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>s_over_D = S_pile/D_pile</expbody>
        <expresult> = 3.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">provided spacing in pile diameters</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_sp = S_min/S_pile" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_sp = S_min/S_pile</expbody>
        <expresult> = 1.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">spacing D/C</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" pagebreakbefore="break">5. Pipe section</paragraph>
    <embed spacingbefore="4" spacingafter="5">
      <canvas name="Figure1Section" title="Pile section" unit="in" size="6.5 in; 4.2 in; scaletofit">
        <include target="Library.Geometry"/>
        <planecontainer origin="0.15,4.05,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#29333D">
          <textvalue>PIPE SECTION — 20 in x 0.48 in wall, Fy = 45 ksi</textvalue>
        </planecontainer>
        <circle center="3, 2.2, 0" normal="0, 0, 1" radius="1.35" linethickness="1.6" linecolor="#29333D" fillcolor="#C9D3DC"/>
        <circle center="3, 2.2, 0" normal="0, 0, 1" radius="1.285" linethickness="1" linecolor="#29333D" fillcolor="#FFFFFF"/>
        <lineardim startpoint="1.65, 0.75, 0" endpoint="4.35, 0.75, 0" pointondimline="3, 0.35, 0" formula="PileDesignPier.D_out" linecolor="#5D6F80" textcolor="#5D6F80" linethickness="0.7" fontsize="9">
          <num>20.000 in</num>
        </lineardim>
        <planecontainer origin="4.55,2.4,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#B35012">
          <textvalue>design wall t =</textvalue>
        </planecontainer>
        <planecontainer origin="5.531,2.4,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#B35012" formula="PileDesignPier.t_des/(1 in)">
          <num>0.480</num>
        </planecontainer>
        <planecontainer origin="5.902,2.4,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#B35012">
          <textvalue>in</textvalue>
        </planecontainer>
        <planecontainer origin="4.55,2.2,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#7B8993">
          <textvalue>after the corrosion allowance</textvalue>
        </planecontainer>
      </canvas>
    </embed>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Figure 1. Pipe cross-section: outside diameter and design wall thickness after the corrosion allowance. The ring is a picture; the outside diameter and the design wall thickness are live.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="t_des = t_wall - t_corr to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>t_des = t_wall - t_corr to in</expbody>
        <expresult> = 0.480 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">design wall thickness after corrosion allowance</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="D_i = D_out - 2*t_des to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>D_i = D_out - 2*t_des to in</expbody>
        <expresult> = 19.040 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">inside diameter</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_g = 0.785398163397448*(D_out^2 - D_i^2) to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_g = 0.785398163397448*(D_out^2 - D_i^2) to in^2</expbody>
        <expresult> = 29.435 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">gross area</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="I_g = 0.0490873852123405*(D_out^4 - D_i^4) to in^4" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>I_g = 0.0490873852123405*(D_out^4 - D_i^4) to in^4</expbody>
        <expresult> = 1402.824 in^4</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">moment of inertia</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="S_g = I_g/(D_out/2) to in^3" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>S_g = I_g/(D_out/2) to in^3</expbody>
        <expresult> = 140.282 in^3</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">elastic section modulus</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Z_p = (D_out^3 - D_i^3)/6 to in^3" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>Z_p = (D_out^3 - D_i^3)/6 to in^3</expbody>
        <expresult> = 182.931 in^3</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">plastic section modulus</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="r_g = Sqrt(I_g/A_g) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>r_g = Sqrt(I_g/A_g) to in</expbody>
        <expresult> = 6.903 in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">radius of gyration</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="D_t = D_out/t_des" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>D_t = D_out/t_des</expbody>
        <expresult> = 41.667</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">diameter-to-thickness ratio</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">6. Axial compression (LRFD 6.9.4.1, 6.9.4.2.2c, 10.7.3.13.4)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6">Fully embedded piles take no buckling reduction beyond the effective length K (Lu + Lf), Lf the depth to fixity (C10.7.3.13.4). The FBMP P-delta analysis is the preferred second-order check; this is the LRFD column check.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="lam_r = 0.11*E_s/Fy" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>lam_r = 0.11*E_s/Fy</expbody>
        <expresult> = 70.889</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">nonslender limit 0.11 E/Fy</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="A_eff = If(D_t &lt;= lam_r, A_g, (0.038*E_s/(Fy*D_t) + 2/3)*A_g) to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>A_eff = If(D_t &lt;= lam_r, A_g, (0.038*E_s/(Fy*D_t) + 2/3)*A_g) to in^2</expbody>
        <expresult> = 29.435 in^2</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">effective area</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="P_o = Fy*A_eff to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>P_o = Fy*A_eff to kip</expbody>
        <expresult> = 1324.596 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">squash load</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="E_soil = 0.465*(S_u/(1 kip/ft^2))*(1 ksi) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>E_soil = 0.465*(S_u/(1 kip/ft^2))*(1 ksi) to ksi</expbody>
        <expresult> = 0.465 ksi</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">clay soil modulus 0.465 Su (used for clay only)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="L_fix = If(soil_type == 1, 1.4*(E_s*I_g/E_soil)^0.25, 1.8*(E_s*I_g/n_h)^0.2) to ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>L_fix = If(soil_type == 1, 1.4*(E_s*I_g/E_soil)^0.25, 1.8*(E_s*I_g/n_h)^0.2) to ft</expbody>
        <expresult> = 9.221 ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">depth to fixity below ground</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="KL = K_eff*(L_unsupported + L_fix) to ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>KL = K_eff*(L_unsupported + L_fix) to ft</expbody>
        <expresult> = 24.943 ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">effective length</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="KL_r = KL/r_g" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>KL_r = KL/r_g</expbody>
        <expresult> = 43.357</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">slenderness ratio</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="P_e = 9.869604401089358*E_s*A_g/KL_r^2 to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>P_e = 9.869604401089358*E_s*A_g/KL_r^2 to kip</expbody>
        <expresult> = 4481.688 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">elastic buckling load</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Pe_Po = P_e/P_o" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>Pe_Po = P_e/P_o</expbody>
        <expresult> = 3.383</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Pe / Po</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="P_n = If(Pe_Po &gt;= 0.44, 0.658^(P_o/P_e)*P_o, 0.877*P_e) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>P_n = If(Pe_Po &gt;= 0.44, 0.658^(P_o/P_e)*P_o, 0.877*P_e) to kip</expbody>
        <expresult> = 1170.466 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">nominal axial resistance, 6.9.4.1.1</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="P_r_axial = phi_c_axial*P_n to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>P_r_axial = phi_c_axial*P_n to kip</expbody>
        <expresult> = 819.326 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored axial resistance</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="P_r_comb = phi_c_comb*P_n to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>P_r_comb = phi_c_comb*P_n to kip</expbody>
        <expresult> = 936.373 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored axial resistance, combined loading</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="P_u_axial = P_u_1 to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>P_u_axial = P_u_1 to kip</expbody>
        <expresult> = 265.580 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">largest factored compression incl. drag load</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_slender = D_t/(0.45*E_s/Fy)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_slender = D_t/(0.45*E_s/Fy)</expbody>
        <expresult> = 0.144</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">D/t against the 0.45 E/Fy limit</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_klr = KL_r/120" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_klr = KL_r/120</expbody>
        <expresult> = 0.361</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">KL/r against 120, 6.9.3</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_axial = P_u_axial/P_r_axial" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_axial = P_u_axial/P_r_axial</expbody>
        <expresult> = 0.324</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">axial compression D/C</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">7. Flexure (LRFD 6.12.2.2.3)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="lam_p = 0.07*E_s/Fy" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>lam_p = 0.07*E_s/Fy</expbody>
        <expresult> = 45.111</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">compact limit 0.07 E/Fy</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="lam_nc = 0.31*E_s/Fy" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>lam_nc = 0.31*E_s/Fy</expbody>
        <expresult> = 199.778</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">noncompact limit 0.31 E/Fy</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_p = Fy*Z_p to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_p = Fy*Z_p to kip*ft</expbody>
        <expresult> = 685.993 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">plastic moment</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_nc = (0.021*E_s/D_t + Fy)*S_g" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_nc = (0.021*E_s/D_t + Fy)*S_g</expbody>
        <expresult> = 8363.074 kip*in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">noncompact: (0.021 E/(D/t) + Fy) S</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_sl = 0.33*E_s/D_t*S_g" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_sl = 0.33*E_s/D_t*S_g</expbody>
        <expresult> = 32220.055 kip*in</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">slender: 0.33 E/(D/t) S</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_n = If(D_t &lt;= lam_p, M_p, Min(M_p, If(D_t &lt;= lam_nc, M_nc, M_sl))) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_n = If(D_t &lt;= lam_p, M_p, Min(M_p, If(D_t &lt;= lam_nc, M_nc, M_sl))) to kip*ft</expbody>
        <expresult> = 685.993 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">nominal flexural resistance</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_r = φ_f*M_n to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_r = φ_f*M_n to kip*ft</expbody>
        <expresult> = 685.993 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored flexural resistance</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" pagebreakbefore="break">8. Combined axial load and flexure (LRFD 6.9.2.2.1) and tension (6.8.2.1)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6">Governing combined record (record 2). The resultant moment is checked against Mr (axisymmetric section). A net uplift uses the tension resistance in place of the compression resistance.</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="P_u_comb = P_u_2 to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>P_u_comb = P_u_2 to kip</expbody>
        <expresult> = 265.580 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored axial load, compression positive</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_u_comb = M_res_2 to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_u_comb = M_res_2 to kip*ft</expbody>
        <expresult> = 133.984 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">resultant moment</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="P_r_t = phi_y*Fy*A_g to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>P_r_t = phi_y*Fy*A_g to kip</expbody>
        <expresult> = 1258.366 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored tension resistance, yielding of the gross section</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_t = T_u/P_r_t" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_t = T_u/P_r_t</expbody>
        <expresult> = 0.009</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">tension D/C, maximum strength uplift</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="P_abs = Abs(P_u_comb) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>P_abs = Abs(P_u_comb) to kip</expbody>
        <expresult> = 265.580 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">magnitude of the axial force</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="P_rc = If(P_u_comb &gt;= 0 kip, P_r_comb, P_r_t) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>P_rc = If(P_u_comb &gt;= 0 kip, P_r_comb, P_r_t) to kip</expbody>
        <expresult> = 936.373 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">matching axial resistance</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Pu_Pr = P_abs/P_rc" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>Pu_Pr = P_abs/P_rc</expbody>
        <expresult> = 0.284</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Pu / Pr</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_comb = If(Pu_Pr &gt;= 0.2, Pu_Pr + 8/9*M_u_comb/M_r, Pu_Pr/2 + M_u_comb/M_r)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_comb = If(Pu_Pr &gt;= 0.2, Pu_Pr + 8/9*M_u_comb/M_r, Pu_Pr/2 + M_u_comb/M_r)</expbody>
        <expresult> = 0.457</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">interaction, Eq. 6.9.2.2.1-1 (Pu/Pr &gt;= 0.2) or -2</paragraph>
    <embed spacingbefore="4" spacingafter="5">
      <canvas name="Figure2Interaction" title="Combined axial load and flexure" unit="in" size="6.5 in; 5.1 in; scaletofit">
        <include target="Library.Geometry"/>
        <planecontainer origin="0.15,4.92,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#29333D">
          <textvalue>COMBINED AXIAL LOAD AND FLEXURE — LRFD 6.9.2.2.1 envelope, live corner values</textvalue>
        </planecontainer>
        <plot formula="PlotLines([0.95,6.3,6.3,0.95,0.95],[1.55,1.55,4.5,4.5,1.55])" linecolor="#29333D" linethickness="1"/>
        <plot formula="PlotLines([0.95,0.95],[1.55,4.5])" linecolor="#E3E8EC" linethickness="0.5"/>
