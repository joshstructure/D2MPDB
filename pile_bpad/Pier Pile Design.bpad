    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_ymax = Max(1.2, 1.1*Max(DC_slender, DC_klr, DC_axial, DC_comb, DC_shear, DC_t, DC_sp))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_ymax = Max(1.2, 1.1*Max(DC_slender, DC_klr, DC_axial, DC_comb, DC_shear, DC_t, DC_sp))</expbody>
        <expresult> = 1.200</expresult>
      </dynexp>
    </paragraph>
