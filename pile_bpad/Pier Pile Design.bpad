          <textvalue>combined: Pu</textvalue>
        </planecontainer>
        <planecontainer origin="5.262,0.8,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D" formula="PileDesignPier.P_u_2/(1 kip)">
          <num>265.580</num>
        </planecontainer>
        <planecontainer origin="5.709,0.8,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D">
