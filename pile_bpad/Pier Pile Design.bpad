        <plot formula="PlotLines([0.95+(PileDesignPier.M_res_1/(1 kip*ft))*0.006687,0.95+(PileDesignPier.M_res_1/(1 kip*ft))*0.006687],[3.025+(PileDesignPier.P_u_1/(1 kip))*0.000983-0.07,3.025+(PileDesignPier.P_u_1/(1 kip))*0.000983+0.07])" linecolor="#6C3483" linethickness="1.8"/>
        <plot formula="PlotLines([0.95+(PileDesignPier.M_res_2/(1 kip*ft))*0.006687-0.07,0.95+(PileDesignPier.M_res_2/(1 kip*ft))*0.006687+0.07],[3.025+(PileDesignPier.P_u_2/(1 kip))*0.000983,3.025+(PileDesignPier.P_u_2/(1 kip))*0.000983])" linecolor="#C8372D" linethickness="1.8"/>
        <plot formula="PlotLines([0.95+(PileDesignPier.M_res_2/(1 kip*ft))*0.006687,0.95+(PileDesignPier.M_res_2/(1 kip*ft))*0.006687],[3.025+(PileDesignPier.P_u_2/(1 kip))*0.000983-0.07,3.025+(PileDesignPier.P_u_2/(1 kip))*0.000983+0.07])" linecolor="#C8372D" linethickness="1.8"/>
        <plot formula="PlotLines([0.95+(PileDesignPier.M_res_4/(1 kip*ft))*0.006687-0.07,0.95+(PileDesignPier.M_res_4/(1 kip*ft))*0.006687+0.07],[3.025+(PileDesignPier.P_u_4/(1 kip))*0.000983,3.025+(PileDesignPier.P_u_4/(1 kip))*0.000983])" linecolor="#117A65" linethickness="1.8"/>
        <plot formula="PlotLines([0.95+(PileDesignPier.M_res_4/(1 kip*ft))*0.006687,0.95+(PileDesignPier.M_res_4/(1 kip*ft))*0.006687],[3.025+(PileDesignPier.P_u_4/(1 kip))*0.000983-0.07,3.025+(PileDesignPier.P_u_4/(1 kip))*0.000983+0.07])" linecolor="#117A65" linethickness="1.8"/>
        <plot formula="PlotLines([0.5,0.9],[1.03,1.03])" linecolor="#1766A0" linethickness="1.8"/>
        <planecontainer origin="1,1,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D">
          <textvalue>compression: Pr</textvalue>
        </planecontainer>
        <planecontainer origin="1.878,1,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D" formula="PileDesignPier.P_r_comb/(1 kip)">
          <num>936.373</num>
        </planecontainer>
        <planecontainer origin="2.324,1,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D">
          <textvalue>kip, Mr</textvalue>
        </planecontainer>
        <planecontainer origin="2.761,1,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D" formula="PileDesignPier.M_r/(1 kip*ft)">
          <num>685.993</num>
