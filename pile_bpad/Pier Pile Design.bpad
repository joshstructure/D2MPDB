        <planecontainer origin="0.5,0.6,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#7B8993">
          <textvalue>envelope corner at 0.9 Mr and 0.2 Pr (Eqs. 6.9.2.2.1-1 and -2 agree there)</textvalue>
        </planecontainer>
        <plot formula="PlotLines([4.1,4.45],[1.03,1.03])" linecolor="#6C3483" linethickness="1.8"/>
