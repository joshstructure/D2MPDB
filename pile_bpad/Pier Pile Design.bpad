    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="FDL_fbmp = 224.63 kip" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input">
        <expbody>FDL_fbmp = 224.63 kip</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Factored Design Load: maximum strength head compression, FBMP (no downdrag)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="T_u = 11.81 kip" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input">
        <expbody>T_u = 11.81 kip</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">maximum strength uplift anywhere along the pile, FBMP</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DD = DD_tons*2*(1 kip) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DD = DD_tons*2*(1 kip) to kip</expbody>
        <expresult> = 0.000 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">downdrag (drag load DR) per pile, nominal</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DR_str = gamma_DR_str*DD to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DR_str = gamma_DR_str*DD to kip</expbody>
        <expresult> = 0.000 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">drag load, strength limit states</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DR_ser = gamma_DR_ser*DD to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DR_ser = gamma_DR_ser*DD to kip</expbody>
        <expresult> = 0.000 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">drag load, Service I</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="gamma_g_1 = gamma_DR_str" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>gamma_g_1 = gamma_DR_str</expbody>
        <expresult> = 1.100</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">drag-load factor of each record</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="P_u_1 = P_fbmp_1 + gamma_g_1*DD to kip" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>P_u_1 = P_fbmp_1 + gamma_g_1*DD to kip</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored axial load incl. drag load</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Records 2 to 4: the same equations, collapsed.</paragraph>
    <section name="Records2toN_1" capture="False" hide="true">
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="gamma_g_2 = gamma_DR_str" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>gamma_g_2 = gamma_DR_str</expbody>
          <expresult> = 1.100</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">drag-load factor of each record</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="P_u_2 = P_fbmp_2 + gamma_g_2*DD to kip" mathlayout="on" showformula="True" showresult="False" showsteps="False">
