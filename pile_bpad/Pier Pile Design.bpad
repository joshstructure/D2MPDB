        <planecontainer origin="3.207,1,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D">
          <textvalue>kip-ft</textvalue>
        </planecontainer>
        <plot formula="PlotLines([0.5,0.9],[0.83,0.83])" linecolor="#2C7FB8" linethickness="1.8"/>
        <planecontainer origin="1,0.8,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D">
          <textvalue>tension: Pr,t</textvalue>
        </planecontainer>
        <planecontainer origin="1.768,0.8,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D" formula="PileDesignPier.P_r_t/(1 kip)">
          <num>1258.366</num>
        </planecontainer>
        <planecontainer origin="2.269,0.8,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D">
