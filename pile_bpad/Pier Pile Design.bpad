        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">drag-load factor of each record</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="P_u_3 = P_fbmp_3 + gamma_g_3*DD to kip" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>P_u_3 = P_fbmp_3 + gamma_g_3*DD to kip</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored axial load incl. drag load</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="gamma_g_4 = gamma_DR_str" mathlayout="on" showformula="True" showresult="True" showsteps="False">
          <expbody>gamma_g_4 = gamma_DR_str</expbody>
          <expresult> = 1.100</expresult>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">drag-load factor of each record</paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
        <dynexp formula="P_u_4 = P_fbmp_4 + gamma_g_4*DD to kip" mathlayout="on" showformula="True" showresult="False" showsteps="False">
          <expbody>P_u_4 = P_fbmp_4 + gamma_g_4*DD to kip</expbody>
        </dynexp>
      </paragraph>
      <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored axial load incl. drag load</paragraph>
    </section>
    <embed spacingbefore="5" spacingafter="8">
      <table name="DemandResults" capture="False" colwidths="1:150, 2:90, 3:100, 4:90, 5:90">
        <stylerule range="A1:E5" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/>
