				<region region-id="146500" left="6" top="4215" width="271.5" height="15" align-x="59.25" align-y="4224" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<math optimize="false" disable-calc="false">
