				<region region-id="178224" left="6" top="951" width="156.75" height="11.25" align-x="22.5" align-y="960" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">strength reduction for bent GFRP bars</p>
					</text>
				</region>
				<region region-id="178225" left="180" top="942" width="174.75" height="32.25" align-x="207.75" align-y="960" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="bend">ϕ</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">min</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:mult/>
												<ml:real>0.05</ml:real>
												<ml:apply>
													<ml:div/>
													<ml:id xml:space="preserve" subscript="b.GFRP">r</ml:id>
													<ml:id xml:space="preserve" subscript="b.GFRP">d</ml:id>
