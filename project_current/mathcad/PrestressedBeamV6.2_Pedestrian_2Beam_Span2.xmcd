				</region>
				<region region-id="141038" left="6" top="9062.25" width="431.25" height="13.5" align-x="14.25" align-y="9072" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<region region-id="144381" left="6" top="9063" width="23.25" height="12.75" align-x="16.5" align-y="9072" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" xmlns:ml="http://schemas.mathsoft.com/math30">Bond</ml:id>
								</math>
							</region>
							<sp count="2"/>function defines an adjustment factor for the shielding and development of prestressing steel</p>
					</text>
				</region>
				<region region-id="141039" left="6" top="9087" width="334.5" height="103.5" align-x="81.75" align-y="9096" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">Bond</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve" subscript="1">L</ml:id>
									<ml:id xml:space="preserve" subscript="2">L</ml:id>
									<ml:id xml:space="preserve">loc</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:or/>
										<ml:apply>
											<ml:lessOrEqual/>
											<ml:id xml:space="preserve">loc</ml:id>
											<ml:id xml:space="preserve" subscript="1">L</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:greaterOrEqual/>
											<ml:id xml:space="preserve">loc</ml:id>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve" subscript="beam">L</ml:id>
												<ml:id xml:space="preserve" subscript="1">L</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:real>0</ml:real>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:lessThan/>
										<ml:apply>
											<ml:lessThan/>
											<ml:id xml:space="preserve" subscript="1">L</ml:id>
											<ml:id xml:space="preserve">loc</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:plus/>
											<ml:id xml:space="preserve" subscript="1">L</ml:id>
											<ml:id xml:space="preserve" subscript="2">L</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve">loc</ml:id>
											<ml:id xml:space="preserve" subscript="1">L</ml:id>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="2">L</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:lessThan/>
										<ml:apply>
											<ml:lessThan/>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve" subscript="beam">L</ml:id>
												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve" subscript="1">L</ml:id>
														<ml:id xml:space="preserve" subscript="2">L</ml:id>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:id xml:space="preserve">loc</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve" subscript="beam">L</ml:id>
											<ml:id xml:space="preserve" subscript="1">L</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve" subscript="beam">L</ml:id>
												<ml:id xml:space="preserve" subscript="1">L</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve">loc</ml:id>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="2">L</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:otherwise>
									<ml:real>1</ml:real>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="144383" left="6" top="9213" width="194.25" height="11.25" align-x="25.5" align-y="9222" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Parameters for Mn along the length of the beam</p>
					</text>
				</region>
				<region region-id="27387" left="6" top="9249" width="234.75" height="18.75" align-x="51" align-y="9258" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="ps.ult">A</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">pi</ml:id>
									<ml:id xml:space="preserve">n</ml:id>
								</ml:sequence>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
									<ml:id xml:space="preserve">pi</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:id xml:space="preserve">Bond</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
											<ml:id xml:space="preserve">pi</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="d">L</ml:id>
											<ml:id xml:space="preserve">pi</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">Location</ml:id>
											<ml:id xml:space="preserve">n</ml:id>
										</ml:apply>
									</ml:sequence>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="27385" left="6" top="9285" width="154.5" height="18.75" align-x="122.25" align-y="9294" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="ps.ult">A</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:minus/>
										<ml:apply>
											<ml:id xml:space="preserve">length</ml:id>
											<ml:id xml:space="preserve">PSGroupIndex</ml:id>
										</ml:apply>
										<ml:real>1</ml:real>
									</ml:apply>
									<ml:id xml:space="preserve">n</ml:id>
								</ml:sequence>
							</ml:apply>
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="s.long">A</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
						</ml:define>
