				<region region-id="175943" left="426" top="9159" width="89.25" height="15" align-x="488.25" align-y="9168" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
