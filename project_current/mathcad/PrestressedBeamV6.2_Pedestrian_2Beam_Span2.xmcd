					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">tendon yield strength,<sp count="2"/>
						</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">0.9*f<sub>pu</sub>
							<sp count="2"/>for low-lax </p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">0.85*f<sub>pu </sub> for stress relieved<sp count="3"/>
						</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<c val="#800000">(LRFD 5.4.4.1)</c>
						</p>
