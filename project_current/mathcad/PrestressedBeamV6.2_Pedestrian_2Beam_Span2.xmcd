												<ml:id xml:space="preserve">min</ml:id>
												<ml:id xml:space="preserve" subscript="t">L</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:real>1</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">Location</ml:id>
											<ml:id xml:space="preserve">hc</ml:id>
