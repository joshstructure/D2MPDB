				<region region-id="146463" left="6" top="2559" width="261.75" height="11.25" align-x="6" align-y="2568" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Distribution factors for interior beam moments</p>
					</text>
				</region>
				<region region-id="150340" left="6" top="2586" width="389.25" height="180.75" align-x="112.5" align-y="2610" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffc6c6" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="mom.interior.one.lane">f_g</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">idx</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">gmom</ml:id>
										<ml:apply>
											<ml:plus/>
											<ml:real>0.06</ml:real>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:pow/>
														<ml:parens>
															<ml:apply>
																<ml:div/>
																<ml:id xml:space="preserve">S</ml:id>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>14</ml:real>
																	<ml:id xml:space="preserve">ft</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
														<ml:real>0.4</ml:real>
													</ml:apply>
													<ml:apply>
														<ml:pow/>
														<ml:parens>
															<ml:apply>
																<ml:div/>
																<ml:id xml:space="preserve">S</ml:id>
																<ml:id xml:space="preserve" subscript="s">L</ml:id>
															</ml:apply>
														</ml:parens>
														<ml:real>0.3</ml:real>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:pow/>
													<ml:parens>
														<ml:apply>
															<ml:div/>
															<ml:id xml:space="preserve" subscript="g">K</ml:id>
															<ml:apply>
																<ml:mult/>
																<ml:id xml:space="preserve" subscript="s">L</ml:id>
																<ml:apply>
																	<ml:pow/>
																	<ml:id xml:space="preserve" subscript="s">t</ml:id>
																	<ml:real>3</ml:real>
																</ml:apply>
															</ml:apply>
														</ml:apply>
													</ml:parens>
													<ml:real>0.1</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
									<ml:localDefine>
