				<region region-id="45964" left="6" top="6924.75" width="241.5" height="72.75" align-x="33.75" align-y="6960" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="ll">ε</ml:id>
								<ml:sequence>
									<ml:real>0</ml:real>
									<ml:id xml:space="preserve">n</ml:id>
								</ml:sequence>
							</ml:apply>
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:mult/>
									<ml:parens>
										<ml:apply>
											<ml:summation/>
											<ml:lambda>
												<ml:boundVars>
													<ml:id xml:space="preserve">nc</ml:id>
												</ml:boundVars>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="tr">B</ml:id>
													<ml:sequence>
														<ml:id xml:space="preserve">nc</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:sequence>
												</ml:apply>
											</ml:lambda>
										</ml:apply>
									</ml:parens>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="live.service">M</ml:id>
										<ml:id xml:space="preserve">n</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve" subscript="c">E</ml:id>
									<ml:parens>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:mult/>
												<ml:parens>
													<ml:apply>
														<ml:summation/>
														<ml:lambda>
															<ml:boundVars>
																<ml:id xml:space="preserve">nc</ml:id>
															</ml:boundVars>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="tr">A</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">nc</ml:id>
																	<ml:id xml:space="preserve">n</ml:id>
																</ml:sequence>
															</ml:apply>
														</ml:lambda>
													</ml:apply>
												</ml:parens>
												<ml:parens>
													<ml:apply>
														<ml:summation/>
														<ml:lambda>
															<ml:boundVars>
																<ml:id xml:space="preserve">nc</ml:id>
															</ml:boundVars>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="tr">I</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">nc</ml:id>
																	<ml:id xml:space="preserve">n</ml:id>
																</ml:sequence>
															</ml:apply>
														</ml:lambda>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:apply>
												<ml:pow/>
												<ml:parens>
													<ml:apply>
														<ml:summation/>
														<ml:lambda>
															<ml:boundVars>
																<ml:id xml:space="preserve">nc</ml:id>
															</ml:boundVars>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="tr">B</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">nc</ml:id>
																	<ml:id xml:space="preserve">n</ml:id>
																</ml:sequence>
															</ml:apply>
														</ml:lambda>
													</ml:apply>
												</ml:parens>
												<ml:real>2</ml:real>
											</ml:apply>
										</ml:apply>
									</ml:parens>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="45965" left="306" top="6951" width="137.25" height="18.75" align-x="338.25" align-y="6960" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="bot.ll">ε</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:minus/>
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve" subscript="ll">ε</ml:id>
									<ml:sequence>
										<ml:real>0</ml:real>
										<ml:id xml:space="preserve">n</ml:id>
									</ml:sequence>
								</ml:apply>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve" subscript="beam.bot">y</ml:id>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="ll">κ</ml:id>
										<ml:sequence>
											<ml:real>0</ml:real>
											<ml:id xml:space="preserve">n</ml:id>
										</ml:sequence>
									</ml:apply>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="45966" left="6" top="7027.5" width="282.75" height="43.5" align-x="42.75" align-y="7050" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="top.ll">ΔL</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:summation/>
									<ml:lambda>
										<ml:boundVars>
											<ml:id xml:space="preserve">nz</ml:id>
										</ml:boundVars>
										<ml:parens>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="ll">ε</ml:id>
													<ml:sequence>
														<ml:real>0</ml:real>
														<ml:id xml:space="preserve">nz</ml:id>
													</ml:sequence>
												</ml:apply>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:minus/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Location</ml:id>
															<ml:apply>
																<ml:plus/>
																<ml:id xml:space="preserve">nz</ml:id>
																<ml:real>1</ml:real>
															</ml:apply>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Location</ml:id>
															<ml:apply>
																<ml:minus/>
																<ml:id xml:space="preserve">nz</ml:id>
																<ml:real>1</ml:real>
															</ml:apply>
														</ml:apply>
													</ml:apply>
													<ml:real>2</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:parens>
									</ml:lambda>
									<ml:bounds>
										<ml:real>1</ml:real>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve">nmax</ml:id>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:bounds>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>-0.054962808367105646</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="45968" left="6" top="7099.5" width="282" height="43.5" align-x="42.75" align-y="7122" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="bot.ll">ΔL</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:summation/>
									<ml:lambda>
										<ml:boundVars>
											<ml:id xml:space="preserve">nz</ml:id>
										</ml:boundVars>
										<ml:parens>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="bot.ll">ε</ml:id>
													<ml:id xml:space="preserve">nz</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:minus/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Location</ml:id>
															<ml:apply>
																<ml:plus/>
																<ml:id xml:space="preserve">nz</ml:id>
																<ml:real>1</ml:real>
															</ml:apply>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Location</ml:id>
															<ml:apply>
																<ml:minus/>
																<ml:id xml:space="preserve">nz</ml:id>
																<ml:real>1</ml:real>
															</ml:apply>
														</ml:apply>
													</ml:apply>
													<ml:real>2</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:parens>
									</ml:lambda>
									<ml:bounds>
										<ml:real>1</ml:real>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve">nmax</ml:id>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:bounds>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>0.11333320749691593</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="142890" left="6" top="7173" width="161.25" height="15" align-x="65.25" align-y="7182" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#e3d282" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="limit">user_defl</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">PedMode</ml:id>
									<ml:real>1000</ml:real>
									<ml:real>800</ml:real>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="142891" left="438" top="7179" width="84" height="11.25" align-x="449.25" align-y="7188" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">PL: RFQ L/1000</p>
					</text>
				</region>
				<region region-id="142892" left="6" top="7200" width="304.5" height="32.25" align-x="89.25" align-y="7218" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">CheckLLDeflection</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:lessOrEqual/>
										<ml:apply>
											<ml:id xml:space="preserve">max</ml:id>
											<ml:apply>
												<ml:neg/>
												<ml:id xml:space="preserve" subscript="ll">Defl</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve" subscript="span">L</ml:id>
											<ml:id xml:space="preserve" subscript="limit">user_defl</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:str xml:space="preserve">OK</ml:str>
									<ml:str xml:space="preserve">No Good</ml:str>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="142893" left="390" top="7209" width="119.25" height="12.75" align-x="471.75" align-y="7218" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">CheckLLDeflection</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:str xml:space="preserve">OK</ml:str>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="136283" left="6" top="7260" width="528" height="261.75" align-x="6" align-y="7260" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f1f1f1" tag="">
					<plot disable-calc="false" item-idref="706"/>
				</region>
				<region region-id="29727" left="6" top="7533" width="528.75" height="11.25" align-x="6" align-y="7542" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Note the beam weight is included in the camber calculation and so is not included in the non-composite dead load deflections</p>
					</text>
				</region>
				<region region-id="26665" left="6" top="7572.75" width="134.25" height="14.25" align-x="6" align-y="7584" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="heading" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Summary of Slope Data</p>
					</text>
				</region>
				<region region-id="182869" left="6" top="7615.5" width="521.25" height="327.75" align-x="60" align-y="7782" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">Slope&amp;Defl</ml:id>
							<ml:matrix rows="10" cols="5">
								<ml:str xml:space="preserve">Stage</ml:str>
								<ml:str xml:space="preserve">Release</ml:str>
								<ml:str xml:space="preserve">30 Days</ml:str>
								<ml:str xml:space="preserve">60 Days</ml:str>
								<ml:str xml:space="preserve">90 Days</ml:str>
								<ml:str xml:space="preserve">120   Days</ml:str>
								<ml:str xml:space="preserve">240 Days</ml:str>
								<ml:str xml:space="preserve">Non-comp DL</ml:str>
								<ml:str xml:space="preserve">Comp DL</ml:str>
								<ml:str xml:space="preserve">LL</ml:str>
								<ml:str xml:space="preserve">ΔL @ Beam Top (in)</ml:str>
								<ml:apply>
									<ml:div/>
									<ml:id xml:space="preserve" subscript="top.rel">ΔL</ml:id>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:div/>
									<ml:id xml:space="preserve" subscript="top.30">ΔL</ml:id>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:div/>
									<ml:id xml:space="preserve" subscript="top.60">ΔL</ml:id>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:div/>
									<ml:id xml:space="preserve" subscript="top.90">ΔL</ml:id>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:div/>
									<ml:id xml:space="preserve" subscript="top.120">ΔL</ml:id>
