						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Longitudinal Reinforcement Check, HL-93:</p>
					</text>
				</region>
				<region region-id="179747" left="210" top="6545.25" width="78.75" height="11.25" align-x="210" align-y="6554.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(LRFD C5.8.3.3-1)</p>
					</text>
				</region>
				<region region-id="178462" left="6" top="6581.25" width="531" height="42.75" align-x="44.25" align-y="6590.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="s.prov">V</ml:id>
								<ml:id xml:space="preserve">hs</ml:id>
							</ml:apply>
							<ml:program>
								<ml:ifThen>
									<ml:parens>
										<ml:apply>
											<ml:plus/>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">MildReinfType</ml:id>
													<ml:str xml:space="preserve">Carbon Steel</ml:str>
												</ml:apply>
											</ml:parens>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">MildReinfType</ml:id>
													<ml:str xml:space="preserve">Stainless Steel</ml:str>
												</ml:apply>
											</ml:parens>
										</ml:apply>
									</ml:parens>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="v.prov">A</ml:id>
													<ml:id xml:space="preserve">hs</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve" subscript="y">f</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="v">d</ml:id>
												<ml:id xml:space="preserve">hs</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve">cot</ml:id>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="long.StrengthI">θ</ml:id>
												<ml:id xml:space="preserve">hs</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
								</ml:ifThen>
								<ml:otherwise>
									<ml:apply>
										<ml:id xml:space="preserve">min</ml:id>
										<ml:sequence>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="v.prov">A</ml:id>
															<ml:id xml:space="preserve">hs</ml:id>
														</ml:apply>
														<ml:id xml:space="preserve" subscript="fv">f</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="v">d</ml:id>
														<ml:id xml:space="preserve">hs</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:id xml:space="preserve">cot</ml:id>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="long.StrengthI">θ</ml:id>
														<ml:id xml:space="preserve">hs</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:real>0.25</ml:real>
														<ml:apply>
															<ml:sqrt/>
															<ml:apply>
																<ml:mult/>
																<ml:id xml:space="preserve" subscript="c.beam">f</ml:id>
																<ml:id xml:space="preserve">ksi</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="v">b</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="v">d</ml:id>
													<ml:id xml:space="preserve">hs</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:sequence>
									</ml:apply>
								</ml:otherwise>
							</ml:program>
						</ml:define>
