				<region region-id="180875" left="6" top="1443" width="560.25" height="134.25" align-x="165" align-y="1452" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#80ffff" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">fDeflection</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve" subscript="stage">C1</ml:id>
									<ml:id xml:space="preserve" subscript="stage">C2</ml:id>
									<ml:id xml:space="preserve">constants</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">n</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:id xml:space="preserve">last</ml:id>
											<ml:id xml:space="preserve">Location</ml:id>
										</ml:apply>
									</ml:range>
									<ml:for>
										<ml:id xml:space="preserve">j</ml:id>
										<ml:range>
											<ml:real>0</ml:real>
											<ml:id xml:space="preserve">eqd</ml:id>
										</ml:range>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">deflect</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:apply>
															<ml:plus/>
															<ml:id xml:space="preserve" subscript="stage">C2</ml:id>
															<ml:apply>
																<ml:mult/>
																<ml:id xml:space="preserve" subscript="stage">C1</ml:id>
																<ml:apply>
																	<ml:div/>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve">Location</ml:id>
																		<ml:id xml:space="preserve">n</ml:id>
																	</ml:apply>
																	<ml:id xml:space="preserve">ft</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:apply>
														<ml:parens>
															<ml:apply>
																<ml:summation/>
																<ml:lambda>
																	<ml:boundVars>
																		<ml:id xml:space="preserve">j</ml:id>
																	</ml:boundVars>
																	<ml:parens>
																		<ml:apply>
																			<ml:mult/>
																			<ml:apply>
																				<ml:indexer/>
																				<ml:id xml:space="preserve">constants</ml:id>
																				<ml:id xml:space="preserve">j</ml:id>
																			</ml:apply>
																			<ml:apply>
																				<ml:div/>
																				<ml:apply>
																					<ml:pow/>
																					<ml:parens>
																						<ml:apply>
																							<ml:div/>
																							<ml:apply>
																								<ml:indexer/>
																								<ml:id xml:space="preserve">Location</ml:id>
																								<ml:id xml:space="preserve">n</ml:id>
																							</ml:apply>
																							<ml:id xml:space="preserve">ft</ml:id>
																						</ml:apply>
																					</ml:parens>
																					<ml:apply>
																						<ml:plus/>
																						<ml:id xml:space="preserve">j</ml:id>
																						<ml:real>2</ml:real>
																					</ml:apply>
																				</ml:apply>
																				<ml:apply>
																					<ml:summation/>
																					<ml:lambda>
																						<ml:boundVars>
																							<ml:id xml:space="preserve">r</ml:id>
																						</ml:boundVars>
																						<ml:parens>
																							<ml:apply>
																								<ml:mult/>
																								<ml:real>2</ml:real>
																								<ml:parens>
																									<ml:apply>
																										<ml:plus/>
																										<ml:id xml:space="preserve">r</ml:id>
																										<ml:real>1</ml:real>
																									</ml:apply>
																								</ml:parens>
																							</ml:apply>
																						</ml:parens>
																					</ml:lambda>
																					<ml:bounds>
																						<ml:real>0</ml:real>
																						<ml:id xml:space="preserve">j</ml:id>
																					</ml:bounds>
																				</ml:apply>
																			</ml:apply>
																		</ml:apply>
																	</ml:parens>
																</ml:lambda>
																<ml:bounds>
																	<ml:real>0</ml:real>
																	<ml:id xml:space="preserve">eqd</ml:id>
																</ml:bounds>
															</ml:apply>
														</ml:parens>
													</ml:apply>
												</ml:parens>
												<ml:id xml:space="preserve">ft</ml:id>
											</ml:apply>
										</ml:localDefine>
									</ml:for>
								</ml:for>
								<ml:id xml:space="preserve">deflect</ml:id>
							</ml:program>
						</ml:define>
					</math>
