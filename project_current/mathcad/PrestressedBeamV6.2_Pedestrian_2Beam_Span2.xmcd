				<region region-id="201185" left="6" top="2427" width="331.5" height="11.25" align-x="6" align-y="2436" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">Case 1: Check maximum prestress force as per FDOT Standard Plans Instructions</p>
					</text>
				</region>
				<region region-id="201208" left="6" top="2460" width="459" height="30" align-x="73.5" align-y="2478" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">fMess</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve" subscript="f">P</ml:id>
									<ml:id xml:space="preserve" subscript="std">P</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:id xml:space="preserve">concat</ml:id>
								<ml:sequence>
									<ml:str xml:space="preserve">No Good, </ml:str>
									<ml:str xml:space="preserve">P = </ml:str>
									<ml:apply>
										<ml:id xml:space="preserve">num2str</ml:id>
										<ml:apply>
											<ml:id xml:space="preserve">ceil</ml:id>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve" subscript="f">P</ml:id>
												<ml:id xml:space="preserve">kip</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:str xml:space="preserve"> kips</ml:str>
									<ml:str xml:space="preserve"> &gt; P Standard = </ml:str>
									<ml:apply>
										<ml:id xml:space="preserve">num2str</ml:id>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve" subscript="std">P</ml:id>
											<ml:id xml:space="preserve">kip</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="201211" left="6" top="2517" width="390.75" height="540" align-x="47.25" align-y="2526" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="r.standard">P</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve" subscript="r.standard">P</ml:id>
									<ml:apply>
										<ml:mult/>
										<ml:real>1</ml:real>
										<ml:id xml:space="preserve">kip</ml:id>
									</ml:apply>
								</ml:localDefine>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">BeamType</ml:id>
										<ml:str xml:space="preserve">FIB36</ml:str>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve" subscript="r.standard">P</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:real>1450</ml:real>
											<ml:id xml:space="preserve">kip</ml:id>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:parens>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">BeamType</ml:id>
											<ml:str xml:space="preserve">FIB45</ml:str>
