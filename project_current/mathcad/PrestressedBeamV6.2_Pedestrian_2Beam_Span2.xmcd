				<region region-id="177791" left="6" top="8790" width="225.75" height="32.25" align-x="51" align-y="8808" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
