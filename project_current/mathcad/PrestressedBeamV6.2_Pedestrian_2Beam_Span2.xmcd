				</region>
				<region region-id="132163" left="366" top="1209" width="64.5" height="15" align-x="403.5" align-y="1218" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
