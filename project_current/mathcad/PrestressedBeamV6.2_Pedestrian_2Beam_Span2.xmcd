				<region region-id="177182" left="6" top="2301" width="442.5" height="45.75" align-x="73.5" align-y="2310" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">MildReinfType</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:program>
									<ml:ifThen>
										<ml:apply>
											<ml:or/>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">inpMildReinfType</ml:id>
												<ml:real>0</ml:real>
											</ml:apply>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">inpMildReinfType</ml:id>
												<ml:real>3</ml:real>
											</ml:apply>
										</ml:apply>
										<ml:str xml:space="preserve">Carbon Steel</ml:str>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:or/>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">inpMildReinfType</ml:id>
												<ml:real>1</ml:real>
											</ml:apply>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">inpMildReinfType</ml:id>
												<ml:real>4</ml:real>
											</ml:apply>
										</ml:apply>
										<ml:str xml:space="preserve">Stainless Steel</ml:str>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">inpMildReinfType</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
										<ml:str xml:space="preserve">Glass Fiber Reinforced Polymer</ml:str>
									</ml:ifThen>
								</ml:program>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:str xml:space="preserve">Carbon Steel</ml:str>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="202293" left="6" top="2367" width="43.5" height="15" align-x="18.75" align-y="2376" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="y">f</ml:id>
							<ml:unitOverride>
								<ml:id xml:space="preserve">ksi</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>60</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="kips_per_sq_inch"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="177183" left="6" top="2391" width="181.5" height="11.25" align-x="6" align-y="2400" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">mild reinforcement modulus of elasticity</p>
					</text>
				</region>
				<region region-id="177179" left="6" top="2409" width="322.5" height="52.5" align-x="21.75" align-y="2418" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="s">E</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:program>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">MildReinfType</ml:id>
											<ml:str xml:space="preserve">Carbon Steel</ml:str>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="s.carbon">E</ml:id>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">MildReinfType</ml:id>
											<ml:str xml:space="preserve">Stainless Steel</ml:str>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="s.SS">E</ml:id>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">MildReinfType</ml:id>
											<ml:str xml:space="preserve">Glass Fiber Reinforced Polymer</ml:str>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="f">E</ml:id>
									</ml:ifThen>
								</ml:program>
								<ml:unitOverride>
									<ml:id xml:space="preserve">ksi</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>29000</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="kips_per_sq_inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
						<resultFormat numeric-only="true">
							<general precision="0" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="6"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="181806" left="246" top="2487" width="258.75" height="22.5" align-x="246" align-y="2496" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">area of longitudinal deck reinforcement per unit width of deck, both layers combined </p>
					</text>
				</region>
				<region region-id="177070" left="6" top="2480.25" width="228" height="33.75" align-x="54.75" align-y="2502" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="deck.reinf">As</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:id xml:space="preserve">str2num</ml:id>
										<ml:id xml:space="preserve">inpAsDeckReinf</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">in</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
										<ml:id xml:space="preserve">ft</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:unitOverride>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">in</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
										<ml:id xml:space="preserve">ft</ml:id>
									</ml:apply>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>0.62</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="foot" power-numerator="-1"/>
											<unitReference unit="inch" power-numerator="2"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="177071" left="6" top="2529" width="202.5" height="15" align-x="62.25" align-y="2538" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
