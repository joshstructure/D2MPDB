												<ml:indexer/>
												<ml:id xml:space="preserve">width</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve">k</ml:id>
														<ml:real>2</ml:real>
													</ml:apply>
													<ml:real>0</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">TrapShapes</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">k</ml:id>
													<ml:real>0</ml:real>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">width</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve">k</ml:id>
														<ml:real>2</ml:real>
													</ml:apply>
													<ml:real>1</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">TrapShapes</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve">k</ml:id>
														<ml:real>1</ml:real>
													</ml:apply>
													<ml:real>0</ml:real>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
