				<region region-id="150964" left="6" top="1977" width="352.5" height="178.5" align-x="39" align-y="1986" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="s.long">A</ml:id>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">n</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:id xml:space="preserve">last</ml:id>
											<ml:id xml:space="preserve">Location</ml:id>
										</ml:apply>
									</ml:range>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:plus/>
												<ml:parens>
													<ml:apply>
														<ml:lessThan/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Location</ml:id>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:apply>
														<ml:id xml:space="preserve" subscript="d.long">L</ml:id>
													</ml:apply>
												</ml:parens>
												<ml:parens>
													<ml:apply>
														<ml:greaterThan/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Location</ml:id>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:minus/>
															<ml:id xml:space="preserve" subscript="beam">L</ml:id>
															<ml:id xml:space="preserve" subscript="d.long">L</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:program>
												<ml:ifThen>
													<ml:apply>
														<ml:lessThan/>
														<ml:id xml:space="preserve">n</ml:id>
														<ml:real>50</ml:real>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Aslong</ml:id>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:id xml:space="preserve" subscript="slong">A</ml:id>
															<ml:apply>
																<ml:div/>
																<ml:apply>
																	<ml:minus/>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve">Location</ml:id>
																		<ml:id xml:space="preserve">n</ml:id>
																	</ml:apply>
																	<ml:id xml:space="preserve">EndCover</ml:id>
																</ml:apply>
																<ml:id xml:space="preserve" subscript="d.long">L</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:localDefine>
												</ml:ifThen>
												<ml:otherwise>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Aslong</ml:id>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:id xml:space="preserve" subscript="slong">A</ml:id>
															<ml:apply>
																<ml:div/>
																<ml:apply>
																	<ml:minus/>
																	<ml:apply>
																		<ml:minus/>
																		<ml:id xml:space="preserve" subscript="beam">L</ml:id>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve">Location</ml:id>
																			<ml:id xml:space="preserve">n</ml:id>
																		</ml:apply>
																	</ml:apply>
																	<ml:id xml:space="preserve">EndCover</ml:id>
																</ml:apply>
																<ml:id xml:space="preserve" subscript="d.long">L</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:localDefine>
												</ml:otherwise>
											</ml:program>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Aslong</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve" subscript="slong">A</ml:id>
											</ml:localDefine>
										</ml:otherwise>
										<ml:ifThen>
											<ml:apply>
												<ml:lessThan/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Aslong</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:real>0</ml:real>
													<ml:apply>
														<ml:pow/>
														<ml:id xml:space="preserve">in</ml:id>
														<ml:real>2</ml:real>
													</ml:apply>
												</ml:apply>
											</ml:apply>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Aslong</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:real>0</ml:real>
													<ml:apply>
														<ml:pow/>
														<ml:id xml:space="preserve">in</ml:id>
														<ml:real>2</ml:real>
													</ml:apply>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
									</ml:program>
								</ml:for>
								<ml:id xml:space="preserve">Aslong</ml:id>
							</ml:program>
						</ml:define>
					</math>
