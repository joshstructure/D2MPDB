				</region>
				<region region-id="80775" left="6" top="10185" width="383.25" height="223.5" align-x="36.75" align-y="10194" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="tendon">x</ml:id>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">h</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:real>9</ml:real>
									</ml:range>
									<ml:program>
										<ml:localDefine>
											<ml:id xml:space="preserve">z</ml:id>
											<ml:real>0</ml:real>
										</ml:localDefine>
										<ml:for>
											<ml:id xml:space="preserve">i</ml:id>
											<ml:range>
												<ml:real>0</ml:real>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:id xml:space="preserve">rows</ml:id>
														<ml:id xml:space="preserve">tendsect</ml:id>
													</ml:apply>
													<ml:real>1</ml:real>
												</ml:apply>
											</ml:range>
											<ml:program>
												<ml:for>
													<ml:id xml:space="preserve">j</ml:id>
													<ml:range>
														<ml:real>0</ml:real>
														<ml:apply>
															<ml:minus/>
															<ml:apply>
																<ml:id xml:space="preserve">cols</ml:id>
																<ml:id xml:space="preserve">tendsect</ml:id>
															</ml:apply>
															<ml:real>1</ml:real>
														</ml:apply>
													</ml:range>
													<ml:ifThen>
														<ml:apply>
															<ml:equal/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">tendsect</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">i</ml:id>
																	<ml:id xml:space="preserve">j</ml:id>
																</ml:sequence>
															</ml:apply>
															<ml:id xml:space="preserve">h</ml:id>
														</ml:apply>
														<ml:localDefine>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">xloc</ml:id>
																<ml:sequence>
																	<ml:real>0</ml:real>
																	<ml:apply>
																		<ml:plus/>
																		<ml:id xml:space="preserve">z</ml:id>
																		<ml:id xml:space="preserve">j</ml:id>
																	</ml:apply>
																</ml:sequence>
															</ml:apply>
															<ml:apply>
																<ml:plus/>
																<ml:id xml:space="preserve" subscript="strand.side">Cover</ml:id>
																<ml:parens>
																	<ml:apply>
																		<ml:mult/>
																		<ml:id xml:space="preserve" subscript="strand">Spacing</ml:id>
																		<ml:id xml:space="preserve">j</ml:id>
																	</ml:apply>
																</ml:parens>
															</ml:apply>
														</ml:localDefine>
													</ml:ifThen>
												</ml:for>
												<ml:localDefine>
													<ml:id xml:space="preserve">z</ml:id>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve">z</ml:id>
														<ml:apply>
															<ml:id xml:space="preserve" font="1">cols</ml:id>
															<ml:id xml:space="preserve">tendsect</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:localDefine>
											</ml:program>
										</ml:for>
									</ml:program>
								</ml:for>
								<ml:for>
									<ml:id xml:space="preserve">h</ml:id>
									<ml:range>
										<ml:real>10</ml:real>
										<ml:real>12</ml:real>
									</ml:range>
									<ml:program>
										<ml:localDefine>
											<ml:id xml:space="preserve">z</ml:id>
											<ml:real>0</ml:real>
										</ml:localDefine>
										<ml:for>
											<ml:id xml:space="preserve">i</ml:id>
											<ml:range>
												<ml:real>0</ml:real>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:id xml:space="preserve">rows</ml:id>
														<ml:id xml:space="preserve">tendsect</ml:id>
													</ml:apply>
													<ml:real>1</ml:real>
												</ml:apply>
											</ml:range>
											<ml:program>
												<ml:for>
													<ml:id xml:space="preserve">j</ml:id>
													<ml:range>
														<ml:real>0</ml:real>
														<ml:apply>
															<ml:minus/>
															<ml:apply>
																<ml:id xml:space="preserve">cols</ml:id>
																<ml:id xml:space="preserve">tendsect</ml:id>
															</ml:apply>
															<ml:real>1</ml:real>
														</ml:apply>
													</ml:range>
													<ml:ifThen>
														<ml:apply>
															<ml:equal/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">tendsect</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">i</ml:id>
																	<ml:id xml:space="preserve">j</ml:id>
																</ml:sequence>
															</ml:apply>
															<ml:id xml:space="preserve">h</ml:id>
														</ml:apply>
														<ml:localDefine>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">xloc</ml:id>
																<ml:sequence>
																	<ml:apply>
																		<ml:minus/>
																		<ml:id xml:space="preserve">h</ml:id>
																		<ml:real>9</ml:real>
																	</ml:apply>
																	<ml:apply>
																		<ml:plus/>
																		<ml:id xml:space="preserve">z</ml:id>
																		<ml:id xml:space="preserve">j</ml:id>
																	</ml:apply>
																</ml:sequence>
															</ml:apply>
															<ml:apply>
																<ml:plus/>
																<ml:id xml:space="preserve" subscript="strand.side">Cover</ml:id>
																<ml:parens>
																	<ml:apply>
																		<ml:mult/>
																		<ml:id xml:space="preserve" subscript="strand">Spacing</ml:id>
																		<ml:id xml:space="preserve">j</ml:id>
																	</ml:apply>
																</ml:parens>
															</ml:apply>
														</ml:localDefine>
													</ml:ifThen>
												</ml:for>
												<ml:localDefine>
													<ml:id xml:space="preserve">z</ml:id>
