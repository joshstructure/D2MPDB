												</ml:apply>
											</ml:apply>
										</ml:parens>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="prestress.rel">N</ml:id>
											<ml:id xml:space="preserve">n</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:minus/>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="tr.initial">A</ml:id>
											<ml:sequence>
												<ml:real>0</ml:real>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:sequence>
										</ml:apply>
