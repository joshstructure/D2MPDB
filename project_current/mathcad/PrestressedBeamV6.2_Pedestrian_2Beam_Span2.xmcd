								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="201514" left="6" top="105" width="179.25" height="127.5" align-x="60" align-y="114" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
