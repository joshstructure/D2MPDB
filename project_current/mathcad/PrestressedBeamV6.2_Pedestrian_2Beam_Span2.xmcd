				<region region-id="11750" left="6" top="2069.25" width="218.25" height="11.25" align-x="6" align-y="2078.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Functions used to determine moments and shears</p>
					</text>
				</region>
				<region region-id="11751" left="6" top="2093.25" width="415.5" height="69.75" align-x="144.75" align-y="2114.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="int">fM</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">P</ml:id>
									<ml:id xml:space="preserve">a</ml:id>
									<ml:id xml:space="preserve">b</ml:id>
									<ml:id xml:space="preserve">loc</ml:id>
									<ml:id xml:space="preserve">brg</ml:id>
									<ml:id xml:space="preserve">sl</ml:id>
									<ml:id xml:space="preserve">M</ml:id>
									<ml:id xml:space="preserve">n</ml:id>
									<ml:id xml:space="preserve">z</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:lessThan/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">a</ml:id>
											<ml:id xml:space="preserve">n</ml:id>
										</ml:apply>
										<ml:parens>
											<ml:apply>
												<ml:minus/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">loc</ml:id>
													<ml:id xml:space="preserve">z</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve">brg</ml:id>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">Ans</ml:id>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">P</ml:id>
															<ml:id xml:space="preserve">z</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">a</ml:id>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:parens>
														<ml:apply>
															<ml:minus/>
															<ml:id xml:space="preserve">sl</ml:id>
															<ml:parens>
																<ml:apply>
																	<ml:minus/>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve">loc</ml:id>
																		<ml:id xml:space="preserve">z</ml:id>
																	</ml:apply>
																	<ml:id xml:space="preserve">brg</ml:id>
																</ml:apply>
															</ml:parens>
														</ml:apply>
													</ml:parens>
												</ml:apply>
												<ml:id xml:space="preserve">sl</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">M</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:otherwise>
									<ml:localDefine>
										<ml:id xml:space="preserve">Ans</ml:id>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">P</ml:id>
															<ml:id xml:space="preserve">z</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">b</ml:id>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:parens>
														<ml:apply>
															<ml:minus/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">loc</ml:id>
																<ml:id xml:space="preserve">z</ml:id>
															</ml:apply>
															<ml:id xml:space="preserve">brg</ml:id>
														</ml:apply>
													</ml:parens>
												</ml:apply>
												<ml:id xml:space="preserve">sl</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">M</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="11752" left="6" top="2177.25" width="385.5" height="69.75" align-x="124.5" align-y="2198.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="int">fV</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">P</ml:id>
									<ml:id xml:space="preserve">loc</ml:id>
									<ml:id xml:space="preserve">brg</ml:id>
									<ml:id xml:space="preserve">sl</ml:id>
									<ml:id xml:space="preserve">SZ</ml:id>
									<ml:id xml:space="preserve">n</ml:id>
									<ml:id xml:space="preserve">z</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:lessThan/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">a</ml:id>
											<ml:id xml:space="preserve">n</ml:id>
										</ml:apply>
										<ml:parens>
											<ml:apply>
												<ml:minus/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">loc</ml:id>
													<ml:id xml:space="preserve">z</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve">brg</ml:id>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">Ans</ml:id>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">P</ml:id>
														<ml:id xml:space="preserve">z</ml:id>
													</ml:apply>
													<ml:parens>
														<ml:apply>
															<ml:minus/>
															<ml:id xml:space="preserve">sl</ml:id>
															<ml:parens>
																<ml:apply>
																	<ml:minus/>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve">loc</ml:id>
																		<ml:id xml:space="preserve">z</ml:id>
																	</ml:apply>
																	<ml:id xml:space="preserve">brg</ml:id>
																</ml:apply>
															</ml:parens>
														</ml:apply>
													</ml:parens>
												</ml:apply>
												<ml:id xml:space="preserve">sl</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">SZ</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:otherwise>
									<ml:localDefine>
										<ml:id xml:space="preserve">Ans</ml:id>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">P</ml:id>
														<ml:id xml:space="preserve">z</ml:id>
													</ml:apply>
													<ml:parens>
														<ml:apply>
															<ml:minus/>
															<ml:id xml:space="preserve">brg</ml:id>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">loc</ml:id>
																<ml:id xml:space="preserve">z</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:parens>
												</ml:apply>
												<ml:id xml:space="preserve">sl</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">SZ</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="11753" left="6" top="2267.25" width="368.25" height="54.75" align-x="149.25" align-y="2276.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="start">fM</ml:id>
								<ml:boundVars>
