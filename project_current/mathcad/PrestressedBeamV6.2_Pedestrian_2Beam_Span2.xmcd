											<ml:real>0</ml:real>
											<ml:id xml:space="preserve">kip</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:id xml:space="preserve">str2num</ml:id>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">inpDiaphLoad</ml:id>
													<ml:real>4</ml:real>
												</ml:apply>
											</ml:apply>
											<ml:id xml:space="preserve">kip</ml:id>
										</ml:apply>
									</ml:sequence>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">kip</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>0</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="kip"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="146822" left="6" top="648.75" width="165.75" height="14.25" align-x="6" align-y="660" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="heading" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Dead Loads</p>
					</text>
				</region>
				<region region-id="146823" left="6" top="675" width="48.75" height="12.75" align-x="33" align-y="684" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#e3d282" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">nmax</ml:id>
							<ml:real>102</ml:real>
						</ml:define>
					</math>
				</region>
				<region region-id="140596" left="96" top="675" width="148.5" height="11.25" align-x="96" align-y="684" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">nmax sets the number of sections</p>
					</text>
				</region>
				<region region-id="146824" left="6" top="699" width="52.5" height="12.75" align-x="18" align-y="708" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">n</ml:id>
							<ml:range>
								<ml:real>0</ml:real>
								<ml:id xml:space="preserve">nmax</ml:id>
							</ml:range>
						</ml:define>
					</math>
				</region>
				<region region-id="140598" left="96" top="699" width="57" height="12.75" align-x="112.5" align-y="708" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define warning="WarnRedefinedBIUnit" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">ns</ml:id>
							<ml:range>
								<ml:real>2</ml:real>
								<ml:id xml:space="preserve">nmax</ml:id>
							</ml:range>
						</ml:define>
					</math>
				</region>
				<region region-id="148339" left="6" top="741" width="122.25" height="15" align-x="99.75" align-y="750" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f1f1f1" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="release">SupportLocation</ml:id>
							<ml:apply>
								<ml:mult/>
								<ml:real>0</ml:real>
								<ml:id xml:space="preserve">ft</ml:id>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="148340" left="132" top="741" width="277.5" height="22.5" align-x="148.5" align-y="750" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#80ff80" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<inlineAttr underline="false">distance supports are located from the end of the beam after release;</inlineAttr>
						</p>
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<inlineAttr underline="false">may be used to check lifting points immediately after transfer</inlineAttr>
						</p>
					</text>
				</region>
				<region region-id="150861" left="6" top="789" width="78" height="15" align-x="48" align-y="798" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f1f1f1" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="b.ps.temp">d</ml:id>
							<ml:apply>
								<ml:mult/>
								<ml:real>0.6</ml:real>
								<ml:id xml:space="preserve">in</ml:id>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="150863" left="108" top="789" width="308.25" height="11.25" align-x="122.25" align-y="798" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">assume a diameter of strand =0.6 inches for calculating the Location vector</p>
					</text>
				</region>
				<region region-id="150870" left="6" top="825" width="526.5" height="22.5" align-x="6" align-y="834" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">The Location vector defines the x location of the sections investigated relative to the start of the beam.<sp count="2"/>At the beam ends, the Location vector is not in even increments</p>
					</text>
				</region>
				<region region-id="146834" left="6" top="873" width="75" height="18" align-x="52.5" align-y="882" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">Location</ml:id>
								<ml:real>0</ml:real>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:real>0</ml:real>
								<ml:id xml:space="preserve">ft</ml:id>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="146835" left="102" top="873" width="162.75" height="18" align-x="148.5" align-y="882" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">Location</ml:id>
								<ml:real>1</ml:real>
							</ml:apply>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:id xml:space="preserve">BearingDistance</ml:id>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>0.75</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="foot"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="146830" left="6" top="906" width="192.75" height="30" align-x="56.25" align-y="924" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">Location</ml:id>
								<ml:id xml:space="preserve">ns</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="span">L</ml:id>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve">nmax</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:parens>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve">ns</ml:id>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:parens>
								</ml:apply>
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve">Location</ml:id>
									<ml:real>1</ml:real>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="146836" left="228" top="915" width="90" height="18" align-x="288.75" align-y="924" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">Location</ml:id>
								<ml:id xml:space="preserve">nmax</ml:id>
							</ml:apply>
							<ml:id xml:space="preserve" subscript="beam">L</ml:id>
						</ml:define>
					</math>
				</region>
				<region region-id="150869" left="6" top="951" width="118.5" height="15" align-x="37.5" align-y="960" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="t.temp">L</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:real>60</ml:real>
									<ml:id xml:space="preserve" subscript="b.ps.temp">d</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>36</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="150867" left="162" top="951" width="95.25" height="11.25" align-x="162" align-y="960" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">(LRFD 5.9.4.3.1)</p>
					</text>
				</region>
				<region region-id="150868" left="252" top="951" width="210" height="11.25" align-x="252" align-y="960" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">strand transfer length assuming 0.55" strand </p>
					</text>
				</region>
				<region region-id="140268" left="6" top="987" width="330.75" height="15" align-x="38.25" align-y="996" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#80ff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="critical">L</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:greaterOrEqual/>
											<ml:id xml:space="preserve" subscript="t.temp">L</ml:id>
											<ml:id xml:space="preserve" subscript="release">SupportLocation</ml:id>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="t.temp">L</ml:id>
										<ml:id xml:space="preserve" subscript="release">SupportLocation</ml:id>
									</ml:sequence>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>36</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="140214" left="6" top="1023" width="181.5" height="67.5" align-x="48" align-y="1032" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#80ff80" tag="">
