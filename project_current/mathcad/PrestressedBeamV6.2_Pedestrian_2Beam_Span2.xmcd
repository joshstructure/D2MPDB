				<region region-id="150465" left="126" top="3939" width="231.75" height="15" align-x="205.5" align-y="3948" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="mom.exterior.one.lane">g</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve" subscript="mom.exterior.one.lane">f_g</ml:id>
									<ml:id xml:space="preserve" font="1">index</ml:id>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:real>0.7397413491786089</ml:real>
								</result>
							</ml:eval>
						</ml:define>
