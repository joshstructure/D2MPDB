				<region region-id="177809" left="6" top="8979" width="235.5" height="18.75" align-x="49.5" align-y="8988" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="d.CFRP">L</ml:id>
								<ml:id xml:space="preserve">pi</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:parens>
									<ml:apply>
										<ml:plus/>
										<ml:id xml:space="preserve" subscript="t">L</ml:id>
										<ml:id xml:space="preserve" subscript="b.CFRP">L</ml:id>
									</ml:apply>
								</ml:parens>
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
