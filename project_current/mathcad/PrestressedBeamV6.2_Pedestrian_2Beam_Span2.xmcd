						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="186582" left="6" top="18273" width="125.25" height="11.25" align-x="25.5" align-y="18282" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Allowable reinforcement stress</p>
					</text>
				</region>
				<region region-id="186583" left="156" top="18273" width="49.5" height="11.25" align-x="162.75" align-y="18282" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="LRFD" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">C.5.9.2.3.1b</p>
					</text>
				</region>
				<region region-id="188206" left="6" top="18291" width="141" height="12.75" align-x="72" align-y="18300" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">MildReinfType</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:str xml:space="preserve">Carbon Steel</ml:str>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="188217" left="6" top="18315" width="424.5" height="15" align-x="35.25" align-y="18324" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="s.long">f</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">min</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:mult/>
											<ml:real>0.5</ml:real>
											<ml:apply>
												<ml:id xml:space="preserve">if</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:equal/>
														<ml:id xml:space="preserve">MildReinfType</ml:id>
														<ml:str xml:space="preserve">Glass Fiber Reinforced Polymer</ml:str>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="fd.long.end.top">f</ml:id>
													<ml:id xml:space="preserve" subscript="y">f</ml:id>
												</ml:sequence>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:real>30</ml:real>
											<ml:id xml:space="preserve">ksi</ml:id>
										</ml:apply>
									</ml:sequence>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">ksi</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>30</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="kips_per_sq_inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="186585" left="6" top="18351" width="240.75" height="11.25" align-x="24.75" align-y="18360" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Amount of longitudinal reinforcement required vs provided</p>
					</text>
				</region>
				<region region-id="186586" left="6" top="18366" width="171" height="32.25" align-x="100.5" align-y="18384" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="s.long.end.top.reqd.LRFD">A</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:div/>
									<ml:id xml:space="preserve" subscript="force">T</ml:id>
									<ml:id xml:space="preserve" subscript="s.long">f</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve">in</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>0.73051026726377721</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch" power-numerator="2"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="186587" left="6" top="18411" width="126.75" height="21" align-x="94.5" align-y="18426" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="s.long.end.top.reqd.SDG">A</ml:id>
							<ml:unitOverride>
								<ml:apply>
									<ml:pow/>
									<ml:id xml:space="preserve">in</ml:id>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>1.5</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="inch" power-numerator="2"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="true" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="186588" left="6" top="18448.5" width="249" height="33.75" align-x="78.75" align-y="18468" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="s.long.end.top.reqd">A</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">min</ml:id>
									<ml:matrix rows="2" cols="1">
										<ml:id xml:space="preserve" subscript="s.long.end.top.reqd.LRFD">A</ml:id>
										<ml:id xml:space="preserve" subscript="s.long.end.top.reqd.SDG">A</ml:id>
									</ml:matrix>
								</ml:apply>
								<ml:unitOverride>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve">in</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>0.73051026726377721</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch" power-numerator="2"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="true" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="186589" left="6" top="18501" width="246" height="21" align-x="79.5" align-y="18516" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="s.long.end.top.prov">A</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:plus/>
									<ml:id xml:space="preserve" subscript="s.mild.long.end.top">A</ml:id>
									<ml:id xml:space="preserve" subscript="ps.long.top">A</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve">in</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>1.9200000000000004</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch" power-numerator="2"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="186590" left="6" top="18543" width="405.75" height="15" align-x="123" align-y="18552" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="s.beam.end.top.long.reinf">CheckA</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:lessOrEqual/>
											<ml:id xml:space="preserve" subscript="s.long.end.top.reqd">A</ml:id>
											<ml:id xml:space="preserve" subscript="s.long.end.top.prov">A</ml:id>
										</ml:apply>
										<ml:str xml:space="preserve">OK</ml:str>
										<ml:str xml:space="preserve">No Good</ml:str>
									</ml:sequence>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:str xml:space="preserve">OK</ml:str>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="186591" left="6" top="18573" width="425.25" height="11.25" align-x="21.75" align-y="18582" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Assume length of longitudinal reinforcement required is locations with tensile stress at the top at release</p>
					</text>
				</region>
				<region region-id="186592" left="6" top="18603" width="261" height="51.75" align-x="53.25" align-y="18612" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="As.long.req">L</ml:id>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:real>50</ml:real>
									</ml:range>
									<ml:ifThen>
										<ml:apply>
											<ml:greaterThan/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="top.beam.rel">f</ml:id>
												<ml:id xml:space="preserve">i</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:real>0</ml:real>
												<ml:id xml:space="preserve">psi</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:localDefine>
											<ml:id xml:space="preserve">Length</ml:id>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">Location</ml:id>
												<ml:id xml:space="preserve">i</ml:id>
											</ml:apply>
										</ml:localDefine>
									</ml:ifThen>
								</ml:for>
								<ml:id xml:space="preserve">Length</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="186593" left="330" top="18609" width="83.25" height="15" align-x="375.75" align-y="18618" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="As.long.req">L</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>8.952</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="foot"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="201485" left="6" top="18675" width="79.5" height="15" align-x="54.75" align-y="18684" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="long.end.top">L</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>16</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="foot"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="186595" left="6" top="18711" width="506.25" height="15" align-x="138.75" align-y="18720" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="beam.end.top.long.reinf">CheckLength</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:or/>
											<ml:apply>
												<ml:lessOrEqual/>
												<ml:id xml:space="preserve" subscript="As.long.req">L</ml:id>
												<ml:id xml:space="preserve" subscript="long.end.top">L</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:greaterThan/>
												<ml:id xml:space="preserve" subscript="ps.long.top">A</ml:id>
												<ml:id xml:space="preserve" subscript="s.long.end.top.reqd">A</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:str xml:space="preserve">OK</ml:str>
										<ml:str xml:space="preserve">No Good</ml:str>
									</ml:sequence>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:str xml:space="preserve">OK</ml:str>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="186596" left="6" top="18747" width="561" height="15" align-x="135" align-y="18756" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">CheckBeamEndTopLongReinf</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:mult/>
										<ml:parens>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve" subscript="s.beam.end.top.long.reinf">CheckA</ml:id>
												<ml:str xml:space="preserve">OK</ml:str>
											</ml:apply>
										</ml:parens>
										<ml:parens>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve" subscript="beam.end.top.long.reinf">CheckLength</ml:id>
												<ml:str xml:space="preserve">OK</ml:str>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:str xml:space="preserve">OK</ml:str>
									<ml:str xml:space="preserve">NoGood</ml:str>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="186597" left="6" top="18783" width="165" height="12.75" align-x="133.5" align-y="18792" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">CheckBeamEndTopLongReinf</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:str xml:space="preserve">OK</ml:str>
							</result>
						</ml:eval>
					</math>
				</region>
			</area>
			<rendering item-idref="657"/>
		</region>
