		<region region-id="182680" left="108" top="873" width="423" height="79.5" align-x="121.5" align-y="882" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<b>
						<u>Category and Beams</u>
					</b>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">I-Beams:<tab/>
					<tab/>Florida I-Beams (FIBs) and formerly used Florida Bulb Tee and AASHTO Beams</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Slab Beams:<tab/>Florida Slab Beams (FSBs)</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">U-Beams:<tab/>Florida U-Beams (FUBs)</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Flat Slab<tab/>Previously used Florida Flat Slab Beams, superceded by FSBs</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Inverted Tee:<tab/>Former FDOT Standard Inverted Tee Beams</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Double Tee:<tab/>Former FDOT Standard Double Tee Beams from the 1990's</p>
			</text>
		</region>
		<region region-id="182681" left="6" top="975" width="81" height="12" align-x="16.5" align-y="984" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
