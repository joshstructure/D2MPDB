				<region region-id="174409" left="6" top="6015" width="527.25" height="22.5" align-x="6" align-y="6024" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#efefef" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">5.<sp count="2"/>For simple span precast, pretensioned girders, debonding length from the beam end should be limited to 20 percent of the span length or one half the span length minus the development length, whichever is less.</p>
					</text>
				</region>
