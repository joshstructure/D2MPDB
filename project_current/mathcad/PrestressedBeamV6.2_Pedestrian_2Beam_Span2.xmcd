								<ml:sequence>
									<ml:real>1</ml:real>
									<ml:real>3</ml:real>
								</ml:sequence>
							</ml:apply>
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve" subscript="net">B</ml:id>
									<ml:real>51</ml:real>
