		<region region-id="202206" left="6" top="12075" width="246.75" height="18.75" align-x="16.5" align-y="12084.75" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Crital Location for Principal Stress: <region region-id="200877" left="156" top="12075.75" width="96" height="18" align-x="218.25" align-y="12084.75" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
						<math optimize="false" disable-calc="false">
							<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve">Location</ml:id>
									<ml:id xml:space="preserve">ishear</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>46.089</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
							<resultFormat numeric-only="true">
								<general precision="1" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
								<matrix display-style="auto" expand-nested-arrays="false"/>
								<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
							</resultFormat>
						</math>
						<rendering item-idref="710"/>
					</region>
				</p>
			</text>
		</region>
		<region region-id="202205" left="282" top="12075.75" width="105" height="15" align-x="357.75" align-y="12084.75" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:apply>
						<ml:id xml:space="preserve">max</ml:id>
