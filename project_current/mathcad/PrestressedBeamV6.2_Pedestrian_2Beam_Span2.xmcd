				</region>
				<region region-id="187665" left="6" top="8415" width="261.75" height="15" align-x="78.75" align-y="8424" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="total.partial.ps">Force</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve" subscript="partial.ps">NoStrands</ml:id>
									<ml:id xml:space="preserve" subscript="strand.partial.ps">Force</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">kip</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>40</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="kip"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="187724" left="282" top="8415" width="145.5" height="11.25" align-x="294.75" align-y="8424" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
