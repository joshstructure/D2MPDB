										<ml:parens>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">idx</ml:id>
												<ml:real>2</ml:real>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">min</ml:id>
