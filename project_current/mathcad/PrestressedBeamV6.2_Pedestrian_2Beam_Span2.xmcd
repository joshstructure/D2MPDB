				<region region-id="179770" left="6" top="5528.25" width="267" height="464.25" align-x="111" align-y="5544" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffd2d2" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">f_εse</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">E</ml:id>
									<ml:id xml:space="preserve">fp</ml:id>
									<ml:id xml:space="preserve">strandtype</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve" subscript="i">ε</ml:id>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve">fp</ml:id>
										<ml:id xml:space="preserve">E</ml:id>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">dif</ml:id>
									<ml:real>2</ml:real>
								</ml:localDefine>
								<ml:while>
									<ml:apply>
										<ml:greaterThan/>
										<ml:apply>
											<ml:absval/>
											<ml:id xml:space="preserve">dif</ml:id>
										</ml:apply>
										<ml:real>.75</ml:real>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">strandtype</ml:id>
												<ml:real>0</ml:real>
											</ml:apply>
											<ml:program>
