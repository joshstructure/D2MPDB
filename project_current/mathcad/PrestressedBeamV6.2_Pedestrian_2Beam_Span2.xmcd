				<region region-id="150667" left="6" top="471" width="149.25" height="15" align-x="21.75" align-y="480" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffc6c6" tag="">
					<math optimize="false" disable-calc="false">
