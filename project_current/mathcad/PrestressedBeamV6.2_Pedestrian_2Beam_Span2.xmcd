				<region region-id="174386" left="6" top="4257" width="477.75" height="11.25" align-x="6" align-y="4266" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#efefef" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">1.<sp count="2"/>The number of strands debonded per row shall not exceed 45 percent of the strands provided in that row.</p>
					</text>
				</region>
				<region region-id="174387" left="6" top="4281" width="494.25" height="201.75" align-x="99.75" align-y="4290" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">chkDebondedPerRow</ml:id>
							<ml:parens>
								<ml:program>
									<ml:for>
										<ml:id xml:space="preserve">i</ml:id>
										<ml:range>
											<ml:real>0</ml:real>
											<ml:apply>
												<ml:minus/>
												<ml:apply>
													<ml:id xml:space="preserve">rows</ml:id>
													<ml:id xml:space="preserve">tendsect</ml:id>
												</ml:apply>
												<ml:real>1</ml:real>
											</ml:apply>
										</ml:range>
										<ml:program>
											<ml:ifThen>
												<ml:apply>
													<ml:equal/>
													<ml:apply>
														<ml:id xml:space="preserve">min</ml:id>
														<ml:apply>
															<ml:matcol/>
															<ml:parens>
																<ml:apply>
																	<ml:transpose/>
																	<ml:id xml:space="preserve">tendsect</ml:id>
																</ml:apply>
															</ml:parens>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:real>12</ml:real>
												</ml:apply>
												<ml:return>
													<ml:apply>
														<ml:id xml:space="preserve">augment</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">percent</ml:id>
															<ml:apply>
																<ml:id xml:space="preserve">augment</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">#Bonded</ml:id>
																	<ml:id xml:space="preserve">#Debonded</ml:id>
																</ml:sequence>
															</ml:apply>
														</ml:sequence>
													</ml:apply>
												</ml:return>
											</ml:ifThen>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">#Bonded</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
												<ml:real>0</ml:real>
											</ml:localDefine>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">#Debonded</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
												<ml:real>0</ml:real>
											</ml:localDefine>
											<ml:for>
												<ml:id xml:space="preserve">j</ml:id>
												<ml:range>
													<ml:real>0</ml:real>
													<ml:apply>
														<ml:minus/>
														<ml:apply>
															<ml:id xml:space="preserve">cols</ml:id>
															<ml:id xml:space="preserve">tendsect</ml:id>
														</ml:apply>
														<ml:real>1</ml:real>
													</ml:apply>
												</ml:range>
												<ml:program>
													<ml:ifThen>
														<ml:apply>
															<ml:or/>
															<ml:apply>
																<ml:equal/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">tendsect</ml:id>
																	<ml:sequence>
																		<ml:id xml:space="preserve">i</ml:id>
																		<ml:id xml:space="preserve">j</ml:id>
																	</ml:sequence>
																</ml:apply>
																<ml:real>10</ml:real>
															</ml:apply>
															<ml:apply>
																<ml:equal/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">tendsect</ml:id>
																	<ml:sequence>
																		<ml:id xml:space="preserve">i</ml:id>
																		<ml:id xml:space="preserve">j</ml:id>
																	</ml:sequence>
																</ml:apply>
																<ml:real>11</ml:real>
															</ml:apply>
														</ml:apply>
														<ml:localDefine>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">#Bonded</ml:id>
																<ml:id xml:space="preserve">i</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:plus/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">#Bonded</ml:id>
																	<ml:id xml:space="preserve">i</ml:id>
																</ml:apply>
																<ml:real>1</ml:real>
															</ml:apply>
														</ml:localDefine>
													</ml:ifThen>
													<ml:ifThen>
														<ml:apply>
															<ml:lessOrEqual/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">tendsect</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">i</ml:id>
																	<ml:id xml:space="preserve">j</ml:id>
																</ml:sequence>
															</ml:apply>
															<ml:real>9</ml:real>
														</ml:apply>
														<ml:localDefine>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">#Debonded</ml:id>
																<ml:id xml:space="preserve">i</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:plus/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">#Debonded</ml:id>
																	<ml:id xml:space="preserve">i</ml:id>
																</ml:apply>
																<ml:real>1</ml:real>
															</ml:apply>
														</ml:localDefine>
													</ml:ifThen>
												</ml:program>
											</ml:for>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">percent</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">#Debonded</ml:id>
														<ml:id xml:space="preserve">i</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:plus/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">#Bonded</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">#Debonded</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:localDefine>
										</ml:program>
									</ml:for>
									<ml:apply>
										<ml:id xml:space="preserve">augment</ml:id>
										<ml:sequence>
											<ml:id xml:space="preserve">percent</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">augment</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">#Bonded</ml:id>
													<ml:id xml:space="preserve">#Debonded</ml:id>
												</ml:sequence>
											</ml:apply>
										</ml:sequence>
									</ml:apply>
								</ml:program>
							</ml:parens>
						</ml:define>
					</math>
				</region>
