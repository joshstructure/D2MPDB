				</region>
				<region region-id="178241" left="6" top="1197" width="107.25" height="15" align-x="70.5" align-y="1206" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:id xml:space="preserve">max</ml:id>
								<ml:id xml:space="preserve" subscript="s.prov.shr">V</ml:id>
							</ml:apply>
							<ml:unitOverride>
								<ml:id xml:space="preserve">kip</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>420.4863103051614</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="kip"/>
									</unitMonomial>
								</unitedValue>
							</result>
