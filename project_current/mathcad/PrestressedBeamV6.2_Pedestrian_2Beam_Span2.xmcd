				<region region-id="178515" left="6" top="6309" width="159.75" height="62.25" align-x="29.25" align-y="6318" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">mpf</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:program>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">#Lanes</ml:id>
											<ml:real>1</ml:real>
										</ml:apply>
										<ml:real>1.20</ml:real>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">#Lanes</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
										<ml:real>1.00</ml:real>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">#Lanes</ml:id>
											<ml:real>3</ml:real>
										</ml:apply>
										<ml:real>0.85</ml:real>
									</ml:ifThen>
									<ml:otherwise>
										<ml:real>0.65</ml:real>
									</ml:otherwise>
								</ml:program>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:real>0.65</ml:real>
								</result>
							</ml:eval>
						</ml:define>
