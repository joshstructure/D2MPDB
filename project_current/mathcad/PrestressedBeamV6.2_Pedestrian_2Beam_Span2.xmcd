				<region region-id="176089" left="6" top="7887" width="544.5" height="33.75" align-x="6" align-y="7896" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Stage 4.<sp count="2"/>Stresses final support condition with final prestress forces.</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<inlineAttr underline="false" line-through="false">
								<c val="#00f">(This stage would not be of interest if the initial tension limit was constant along the beam.<sp count="2"/>The check is shown only as a point of interest and should not control the design (the tension and compression checks are </c>
							</inlineAttr>
							<u>
								<inlineAttr line-through="false">
									<c val="#00f">not</c>
								</inlineAttr>
							</u>
							<inlineAttr underline="false" line-through="false">
								<c val="#00f"> added to the final check).</c>
							</inlineAttr>
						</p>
					</text>
				</region>
				<region region-id="188201" left="6" top="7935" width="29.25" height="12.75" align-x="17.25" align-y="7944" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">λ</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
