										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:minus/>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:id xml:space="preserve">max</ml:id>
												<ml:apply>
													<ml:matcol/>
													<ml:id xml:space="preserve" subscript="beam">Coord</ml:id>
													<ml:real>0</ml:real>
												</ml:apply>
											</ml:apply>
											<ml:real>2</ml:real>
										</ml:apply>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve" subscript="bf">Width</ml:id>
