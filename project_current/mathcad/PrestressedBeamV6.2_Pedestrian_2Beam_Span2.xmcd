				<region region-id="181171" left="6" top="6855" width="235.5" height="15" align-x="27.75" align-y="6864" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<math optimize="false" disable-calc="false">
