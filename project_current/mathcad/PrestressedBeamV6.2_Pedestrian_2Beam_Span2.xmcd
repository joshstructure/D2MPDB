																		<ml:id xml:space="preserve">dif</ml:id>
																		<ml:real>0.5</ml:real>
																	</ml:apply>
																	<ml:id xml:space="preserve">fp</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
													</ml:apply>
												</ml:localDefine>
											</ml:program>
										</ml:ifThen>
