				<region region-id="146937" left="6" top="3117" width="238.5" height="18.75" align-x="36.75" align-y="3126" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
