												<ml:id xml:space="preserve" subscript="beam">L</ml:id>
												<ml:id xml:space="preserve">BearingDistance</ml:id>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">res</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:neg/>
													<ml:id xml:space="preserve" subscript="beam">Weight</ml:id>
												</ml:apply>
												<ml:real>0.5</ml:real>
											</ml:apply>
											<ml:parens>
												<ml:apply>
													<ml:minus/>
													<ml:id xml:space="preserve" subscript="beam">L</ml:id>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">Location</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
							</ml:program>
						</ml:define>
