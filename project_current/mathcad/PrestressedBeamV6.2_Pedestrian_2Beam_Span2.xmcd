					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">f_εse</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">E</ml:id>
									<ml:id xml:space="preserve">fp</ml:id>
									<ml:id xml:space="preserve">strandtype</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve" subscript="i">ε</ml:id>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve">fp</ml:id>
