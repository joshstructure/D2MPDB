						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">concrete density modification factor for lightweight concrere</p>
					</text>
				</region>
				<region region-id="184514" left="6" top="6919.5" width="545.25" height="56.25" align-x="61.5" align-y="6930" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80ff" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="all.tension.rel">f</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:mult/>
											<ml:parens>
												<ml:apply>
													<ml:lessThan/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">Location</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:real>0.15</ml:real>
														<ml:id xml:space="preserve" subscript="beam">L</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:parens>
											<ml:id xml:space="preserve">StrandShape</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:parens>
												<ml:apply>
													<ml:greaterThan/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">Location</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:real>0.85</ml:real>
														<ml:id xml:space="preserve" subscript="beam">L</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:parens>
											<ml:id xml:space="preserve">StrandShape</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">str</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:real>0.24</ml:real>
											<ml:apply>
												<ml:mult style="auto-select"/>
												<ml:id xml:space="preserve">λ</ml:id>
												<ml:apply>
													<ml:sqrt/>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve" subscript="ci.beam">f</ml:id>
														<ml:id xml:space="preserve">ksi</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:otherwise>
									<ml:localDefine>
										<ml:id xml:space="preserve">str</ml:id>
										<ml:apply>
											<ml:id xml:space="preserve">min</ml:id>
											<ml:sequence>
												<ml:apply>
													<ml:mult/>
													<ml:real>0.2</ml:real>
													<ml:id xml:space="preserve">ksi</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult style="auto-select"/>
													<ml:apply>
														<ml:mult/>
														<ml:real>0.0948</ml:real>
														<ml:id xml:space="preserve">λ</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:sqrt/>
														<ml:apply>
															<ml:mult/>
															<ml:id xml:space="preserve" subscript="ci.beam">f</ml:id>
															<ml:id xml:space="preserve">ksi</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:sequence>
										</ml:apply>
									</ml:localDefine>
								</ml:otherwise>
								<ml:id xml:space="preserve">str</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
