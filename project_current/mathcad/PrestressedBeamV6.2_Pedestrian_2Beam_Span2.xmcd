				<region region-id="132427" left="378" top="4503" width="147" height="33.75" align-x="378" align-y="4512" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Location vector defines the x location of the sections investigated relative to the start of the beam</p>
					</text>
				</region>
				<region region-id="11714" left="6" top="4536" width="190.5" height="30" align-x="56.25" align-y="4554" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">Location</ml:id>
								<ml:id xml:space="preserve">ns</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="c.c.bearings">L</ml:id>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve">nmax</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:parens>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve">ns</ml:id>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:parens>
								</ml:apply>
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve">Location</ml:id>
									<ml:real>1</ml:real>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
					<rendering item-idref="335"/>
				</region>
				<region region-id="132428" left="282" top="4545" width="90" height="18" align-x="342.75" align-y="4554" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">Location</ml:id>
								<ml:id xml:space="preserve">nmax</ml:id>
							</ml:apply>
							<ml:id xml:space="preserve" subscript="beam">L</ml:id>
						</ml:define>
					</math>
					<rendering item-idref="336"/>
				</region>
				<region region-id="132429" left="396" top="4545" width="112.5" height="22.5" align-x="396" align-y="4554" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">The Location vector need not be in even increments</p>
					</text>
				</region>
				<region region-id="11721" left="6" top="4593" width="141.75" height="18" align-x="21.75" align-y="4602" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">a</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:minus/>
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve">Location</ml:id>
									<ml:id xml:space="preserve">n</ml:id>
								</ml:apply>
								<ml:id xml:space="preserve">BearingDistance</ml:id>
							</ml:apply>
						</ml:define>
