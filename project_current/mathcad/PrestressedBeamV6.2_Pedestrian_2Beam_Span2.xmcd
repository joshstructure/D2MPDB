											</ml:apply>
											<ml:program>
												<ml:localDefine>
													<ml:id xml:space="preserve">fpt</ml:id>
													<ml:apply>
														<ml:id xml:space="preserve" subscript="p.SS">f_f</ml:id>
														<ml:id xml:space="preserve" subscript="i">ε</ml:id>
													</ml:apply>
												</ml:localDefine>
												<ml:localDefine>
													<ml:id xml:space="preserve">dif</ml:id>
													<ml:apply>
														<ml:minus/>
														<ml:id xml:space="preserve">fpt</ml:id>
