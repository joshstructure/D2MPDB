				<region region-id="148480" left="6" top="2583" width="228" height="15" align-x="81.75" align-y="2592" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
