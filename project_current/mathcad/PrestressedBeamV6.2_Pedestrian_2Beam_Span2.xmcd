																								<ml:id xml:space="preserve">i</ml:id>
																								<ml:real>1</ml:real>
																							</ml:apply>
																						</ml:parens>
																						<ml:real>1</ml:real>
																					</ml:sequence>
																				</ml:apply>
																				<ml:apply>
																					<ml:indexer/>
																					<ml:id xml:space="preserve">q</ml:id>
																					<ml:sequence>
																						<ml:id xml:space="preserve">i</ml:id>
																						<ml:real>1</ml:real>
																					</ml:sequence>
																				</ml:apply>
																			</ml:apply>
																		</ml:apply>
																		<ml:parens>
																			<ml:apply>
																				<ml:minus/>
																				<ml:apply>
																					<ml:indexer/>
																					<ml:id xml:space="preserve">q</ml:id>
																					<ml:sequence>
																						<ml:parens>
