						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">set valiable names and units</p>
					</text>
				</region>
				<region region-id="188006" left="6" top="14621.25" width="387.75" height="15" align-x="113.25" align-y="14630.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="Lightweight">AggregateType</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">inpAggregateTypeLW</ml:id>
											<ml:real>0</ml:real>
										</ml:apply>
										<ml:str xml:space="preserve">Standard</ml:str>
										<ml:str xml:space="preserve">Florida</ml:str>
									</ml:sequence>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:str xml:space="preserve">Florida</ml:str>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="188007" left="354" top="14620.5" width="178.5" height="25.5" align-x="354" align-y="14630.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Either <region region-id="34184" left="384" top="17439" width="39" height="12.75" align-x="384" align-y="17448" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:str xml:space="preserve" xmlns:ml="http://schemas.mathsoft.com/math30">Florida</ml:str>
								</math>
							</region> or <region region-id="34185" left="438" top="17439" width="47.25" height="12.75" align-x="438" align-y="17448" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:str xml:space="preserve" xmlns:ml="http://schemas.mathsoft.com/math30">Standard</ml:str>
								</math>
							</region> depending on the type of course aggregate used.</p>
					</text>
				</region>
				<region region-id="188025" left="6" top="14650.5" width="231.75" height="33.75" align-x="69" align-y="14666.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="deck.lightweight">γ</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:id xml:space="preserve">str2num</ml:id>
										<ml:id xml:space="preserve">inpγdeckLW</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve">kip</ml:id>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">ft</ml:id>
											<ml:real>3</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:apply>
