				<region region-id="176087" left="6" top="7785" width="291" height="11.25" align-x="6" align-y="7794" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Stage 3.<sp count="2"/>Change in support location from end to centerline bearing</p>
					</text>
				</region>
				<region region-id="176088" left="6" top="7809" width="552" height="61.5" align-x="48.75" align-y="7818" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="sup.chg">M</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:lessOrEqual/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">Location</ml:id>
											<ml:id xml:space="preserve">n</ml:id>
										</ml:apply>
										<ml:id xml:space="preserve">BearingDistance</ml:id>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">res</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:neg/>
													<ml:id xml:space="preserve" subscript="beam">Weight</ml:id>
												</ml:apply>
												<ml:real>0.5</ml:real>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">Location</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:mult/>
										<ml:parens>
											<ml:apply>
												<ml:greaterThan/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Location</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve">BearingDistance</ml:id>
											</ml:apply>
										</ml:parens>
										<ml:parens>
											<ml:apply>
												<ml:lessThan/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Location</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:parens>
													<ml:apply>
														<ml:minus/>
														<ml:id xml:space="preserve" subscript="beam">L</ml:id>
														<ml:id xml:space="preserve">BearingDistance</ml:id>
													</ml:apply>
												</ml:parens>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">res</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:neg/>
													<ml:id xml:space="preserve" subscript="beam">Weight</ml:id>
												</ml:apply>
												<ml:real>0.5</ml:real>
											</ml:apply>
											<ml:id xml:space="preserve">BearingDistance</ml:id>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:greaterOrEqual/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">Location</ml:id>
											<ml:id xml:space="preserve">n</ml:id>
										</ml:apply>
										<ml:parens>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve" subscript="beam">L</ml:id>
												<ml:id xml:space="preserve">BearingDistance</ml:id>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">res</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:neg/>
													<ml:id xml:space="preserve" subscript="beam">Weight</ml:id>
												</ml:apply>
												<ml:real>0.5</ml:real>
											</ml:apply>
											<ml:parens>
												<ml:apply>
													<ml:minus/>
													<ml:id xml:space="preserve" subscript="beam">L</ml:id>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">Location</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="176089" left="6" top="7887" width="544.5" height="33.75" align-x="6" align-y="7896" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Stage 4.<sp count="2"/>Stresses final support condition with final prestress forces.</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<inlineAttr underline="false" line-through="false">
								<c val="#00f">(This stage would not be of interest if the initial tension limit was constant along the beam.<sp count="2"/>The check is shown only as a point of interest and should not control the design (the tension and compression checks are </c>
							</inlineAttr>
							<u>
								<inlineAttr line-through="false">
									<c val="#00f">not</c>
								</inlineAttr>
							</u>
							<inlineAttr underline="false" line-through="false">
								<c val="#00f"> added to the final check).</c>
							</inlineAttr>
						</p>
					</text>
				</region>
				<region region-id="188201" left="6" top="7935" width="29.25" height="12.75" align-x="17.25" align-y="7944" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
