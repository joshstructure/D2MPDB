	<regions>
		<region region-id="203000" left="6" top="12.75" width="534" height="14.25" align-x="6" align-y="24" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="heading" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Pedestrian live-load modification</p>
			</text>
		</region>
		<region region-id="203001" left="6" top="45" width="534" height="11.25" align-x="6" align-y="54" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">FDOT Prestressed Beam Program v6.2 - project modification dated September 21, 2026. This added mode is not an FDOT release.</p>
			</text>
		</region>
		<region region-id="203002" left="6" top="93" width="99.75" height="12.75" align-x="45" align-y="102" show-border="false" show-highlight="true" is-protected="false" z-order="0" background-color="#e3d282" tag="Pedestrian modification">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">LLmode</ml:id>
					<ml:str xml:space="preserve">Pedestrian</ml:str>
				</ml:define>
			</math>
			<rendering item-idref="3"/>
		</region>
		<region region-id="203003" left="258" top="99" width="279.75" height="11.25" align-x="258" align-y="108" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Enter "Pedestrian" or "Vehicle".</p>
			</text>
		</region>
		<region region-id="203004" left="6" top="134.25" width="95.25" height="33.75" align-x="27" align-y="150" show-border="false" show-highlight="true" is-protected="false" z-order="0" background-color="#e3d282" tag="Pedestrian modification">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="PL">q</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:apply>
							<ml:div/>
							<ml:apply>
								<ml:mult/>
								<ml:real>90</ml:real>
								<ml:id xml:space="preserve">lbf</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:pow/>
								<ml:id xml:space="preserve">ft</ml:id>
								<ml:real>2</ml:real>
							</ml:apply>
						</ml:apply>
						<ml:unitOverride>
							<ml:id xml:space="preserve">psf</ml:id>
						</ml:unitOverride>
						<result xmlns="http://schemas.mathsoft.com/math30">
							<unitedValue>
								<ml:real>89.999999999999986</ml:real>
								<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
									<unitReference unit="pounds_per_sq_foot"/>
								</unitMonomial>
							</unitedValue>
						</result>
					</ml:eval>
				</ml:define>
			</math>
			<rendering item-idref="4"/>
		</region>
		<region region-id="203005" left="258" top="147" width="279.75" height="11.25" align-x="258" align-y="156" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Uniform pedestrian pressure.</p>
			</text>
		</region>
		<region region-id="203006" left="6" top="189" width="52.5" height="15" align-x="31.5" align-y="198" show-border="false" show-highlight="true" is-protected="false" z-order="0" background-color="#e3d282" tag="Pedestrian modification">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="PL">W</ml:id>
					<ml:apply>
						<ml:mult/>
						<ml:real>12</ml:real>
						<ml:id xml:space="preserve">ft</ml:id>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="5"/>
		</region>
		<region region-id="203007" left="258" top="189" width="279.75" height="11.25" align-x="258" align-y="198" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Loaded pedestrian width, independent of deck overhang.</p>
			</text>
		</region>
		<region region-id="203008" left="6" top="243" width="390" height="12.75" align-x="51.75" align-y="252" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">PedMode</ml:id>
					<ml:apply>
						<ml:id xml:space="preserve">if</ml:id>
						<ml:sequence>
							<ml:apply>
								<ml:equal/>
								<ml:id xml:space="preserve">LLmode</ml:id>
								<ml:str xml:space="preserve">Pedestrian</ml:str>
							</ml:apply>
							<ml:real>1</ml:real>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">LLmode</ml:id>
										<ml:str xml:space="preserve">Vehicle</ml:str>
									</ml:apply>
									<ml:real>0</ml:real>
									<ml:apply>
										<ml:id xml:space="preserve">error</ml:id>
										<ml:str xml:space="preserve">Invalid LLmode</ml:str>
									</ml:apply>
								</ml:sequence>
							</ml:apply>
						</ml:sequence>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="6"/>
		</region>
		<region region-id="203009" left="6" top="297" width="534" height="22.5" align-x="6" align-y="306" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Use the normal FDOT Open File control to load your FIB36 project .dat file. Pedestrian mode loads 2 in the Number of Beams box and selects Exterior. The box now accepts a minimum of 2; this pedestrian model requires exactly 2.</p>
			</text>
		</region>
		<region region-id="203010" left="6" top="357" width="534" height="22.5" align-x="6" align-y="366" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Project geometry in PSBeam Program.pdf: FIB36, beam length 107.35 ft, bearing offset 9.5 in, beam spacing 8.583 ft, overhang 2.5 ft, d.e = 1.708 ft. Load the project data file to retain its concrete, strands, reinforcement and other inputs.</p>
			</text>
		</region>
		<region region-id="203011" left="6" top="417" width="534" height="33.75" align-x="6" align-y="426" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Model: simple span between bearing centers; equal sharing of full-width pedestrian load. w.PL = q.PL x W.PL / 2 = 0.540 kip/ft for these inputs. Shear uses longitudinal pattern loading with its associated moment. No vehicular impact or multiple-presence factor applies to PL.</p>
			</text>
		</region>
		<region region-id="203012" left="6" top="477" width="534" height="22.5" align-x="6" align-y="486" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Deflection uses the full-span pedestrian moment and existing composite-section curvature integration. L/1000 is mandatory in Pedestrian mode (RFQ Addendum 5, Structures criteria, item 27). Service and strength load factors are retained.</p>
			</text>
		</region>
		<region region-id="203013" left="6" top="531" width="534" height="33.75" align-x="6" align-y="540" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Separate checks remain necessary for maintenance-vehicle access/loading, transverse load patterns, end overhangs, wind fatigue and vibration. Legacy vehicular fatigue, permit Strength II and HL-93 rating outputs do not establish those checks in Pedestrian mode.</p>
			</text>
		</region>
		<region region-id="203014" left="6" top="591" width="534" height="22.5" align-x="6" align-y="600" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Save this .xmcd to retain LLmode, q.PL and W.PL; the legacy .dat format does not store these three new settings. After switching mode, reopen the intended data file and recalculate. Vehicle mode retains the original vehicle equations and applicability limits.</p>
			</text>
		</region>
		<region region-id="203015" left="6" top="651" width="534" height="22.5" align-x="6" align-y="660" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Verification: XML and independent equation checks only. Native Mathcad recalculation and print layout still require checking in Mathcad with the installed FDOT data files.</p>
			</text>
		</region>
		<region region-id="182018" left="0" top="710.25" width="540" height="4.5" align-x="0" align-y="714" show-border="true" show-highlight="true" is-protected="true" z-order="0" background-color="#000080" tag="">
			<text use-page-width="true" push-down="true" lock-width="true">
				<p style="heading" margin-left="0" margin-right="0" text-indent="0" text-align="center" list-style-type="none" tabs="inherit">
					<f family="Small Fonts" charset="0" size="4">
						<b>
							<inlineAttr underline="false" line-through="false">
								<c val="#000080">FDOT</c>
							</inlineAttr>
						</b>
					</f>
				</p>
			</text>
		</region>
		<region region-id="182016" left="18" top="720" width="144.75" height="87" align-x="18" align-y="720" show-border="true" show-highlight="true" is-protected="true" z-order="2" background-color="#0000a0" tag="">
			<picture>
				<png item-idref="7" display-width="132.75" display-height="75"/>
			</picture>
			<rendering item-idref="8"/>
		</region>
		<region region-id="200913" left="0" top="734.25" width="540" height="59.25" align-x="0" align-y="738" show-border="true" show-highlight="true" is-protected="true" z-order="0" background-color="#000080" tag="">
			<text use-page-width="true" push-down="true" lock-width="true">
				<p style="heading" margin-left="0" margin-right="0" text-indent="0" text-align="center" list-style-type="none" tabs="inherit">
