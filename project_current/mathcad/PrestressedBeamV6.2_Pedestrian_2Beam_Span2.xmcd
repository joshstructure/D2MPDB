				</region>
				<region region-id="143977" left="240" top="2736" width="289.5" height="265.5" align-x="240" align-y="2736" show-border="true" show-highlight="true" is-protected="true" z-order="0" background-color="#c0c0c0" tag="">
					<picture>
						<png item-idref="524" display-width="277.5" display-height="253.5"/>
					</picture>
				</region>
				<region region-id="143978" left="6" top="2738.25" width="219.75" height="15.75" align-x="6" align-y="2748" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<region region-id="143981" left="6" top="2739" width="21.75" height="15" align-x="15.75" align-y="2748" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" subscript="trap" xmlns:ml="http://schemas.mathsoft.com/math30">W</ml:id>
								</math>
							</region> is defines the width properties</p>
					</text>
				</region>
				<region region-id="143979" left="6" top="2751" width="222" height="33.75" align-x="14.25" align-y="2760" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">For FSB, this is conservative since it neglects the pocket concrete if the neutral axis is below the top of the beam. </p>
					</text>
				</region>
				<region region-id="143980" left="6" top="2793" width="210.75" height="176.25" align-x="33.75" align-y="2802" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="trap">W</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">width</ml:id>
										<ml:sequence>
											<ml:real>0</ml:real>
											<ml:real>0</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:id xml:space="preserve" subscript="e">b</ml:id>
								</ml:localDefine>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">width</ml:id>
										<ml:sequence>
											<ml:real>0</ml:real>
											<ml:real>1</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:id xml:space="preserve" subscript="e">b</ml:id>
								</ml:localDefine>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">width</ml:id>
										<ml:sequence>
											<ml:real>1</ml:real>
											<ml:real>0</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:id xml:space="preserve" subscript="buildup">Width</ml:id>
								</ml:localDefine>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">width</ml:id>
										<ml:sequence>
											<ml:real>1</ml:real>
											<ml:real>1</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:id xml:space="preserve" subscript="buildup">Width</ml:id>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">slen</ml:id>
									<ml:apply>
										<ml:minus/>
										<ml:apply>
											<ml:id xml:space="preserve">rows</ml:id>
											<ml:id xml:space="preserve">TrapShapes</ml:id>
										</ml:apply>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">k</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:id xml:space="preserve">slen</ml:id>
									</ml:range>
									<ml:program>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">width</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve">k</ml:id>
														<ml:real>2</ml:real>
													</ml:apply>
													<ml:real>0</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">TrapShapes</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">k</ml:id>
													<ml:real>0</ml:real>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">width</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve">k</ml:id>
														<ml:real>2</ml:real>
													</ml:apply>
													<ml:real>1</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">TrapShapes</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve">k</ml:id>
														<ml:real>1</ml:real>
													</ml:apply>
													<ml:real>0</ml:real>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:for>
								<ml:id xml:space="preserve">width</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="143956" left="6" top="3045" width="233.25" height="11.25" align-x="6" align-y="3054" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
