											<ml:real>120000</ml:real>
											<ml:id xml:space="preserve" subscript="1">K</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:pow/>
											<ml:parens>
												<ml:apply>
													<ml:mult/>
													<ml:id xml:space="preserve" subscript="c">w</ml:id>
