				<region region-id="176019" left="252" top="11823" width="208.5" height="15" align-x="289.5" align-y="11832" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="limit">Plot</ml:id>
