				<region region-id="25983" left="168" top="3057" width="63.75" height="11.25" align-x="168" align-y="3066" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(LRFD 5.7.2.6)</p>
					</text>
				</region>
				<region region-id="179734" left="6" top="3080.25" width="484.5" height="324" align-x="117" align-y="3096" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">fChkStirrupSpacing</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve" subscript="prov">s</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">k</ml:id>
									<ml:range>
										<ml:real>1</ml:real>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:id xml:space="preserve">last</ml:id>
													<ml:id xml:space="preserve">Location</ml:id>
												</ml:apply>
												<ml:real>2</ml:real>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:range>
									<ml:program>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="u">v</ml:id>
												<ml:id xml:space="preserve">k</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="u.Strength">V</ml:id>
														<ml:id xml:space="preserve">k</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve" subscript="shr">ϕ</ml:id>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="p">V</ml:id>
															<ml:id xml:space="preserve">k</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve" subscript="shr">ϕ</ml:id>
														<ml:id xml:space="preserve" subscript="v">b</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="v">d</ml:id>
														<ml:id xml:space="preserve">k</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
										<ml:ifThen>
											<ml:apply>
												<ml:lessThan/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="u">v</ml:id>
													<ml:id xml:space="preserve">k</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:real>0.125</ml:real>
													<ml:id xml:space="preserve" subscript="c.beam">f</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:program>
												<ml:localDefine>
													<ml:id xml:space="preserve" subscript="max">s</ml:id>
													<ml:apply>
														<ml:mult/>
														<ml:real>0.8</ml:real>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="v">d</ml:id>
															<ml:id xml:space="preserve">k</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:localDefine>
												<ml:ifThen>
													<ml:apply>
														<ml:greaterThan/>
														<ml:id xml:space="preserve" subscript="max">s</ml:id>
														<ml:apply>
															<ml:mult/>
															<ml:real>2</ml:real>
															<ml:id xml:space="preserve">ft</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:localDefine>
														<ml:id xml:space="preserve" subscript="max">s</ml:id>
														<ml:apply>
															<ml:mult/>
															<ml:real>2</ml:real>
															<ml:id xml:space="preserve">ft</ml:id>
														</ml:apply>
													</ml:localDefine>
												</ml:ifThen>
											</ml:program>
										</ml:ifThen>
										<ml:otherwise>
											<ml:program>
												<ml:localDefine>
													<ml:id xml:space="preserve" subscript="max">s</ml:id>
													<ml:apply>
														<ml:mult/>
														<ml:real>0.4</ml:real>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="v">d</ml:id>
															<ml:id xml:space="preserve">k</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:localDefine>
												<ml:ifThen>
													<ml:apply>
														<ml:greaterThan/>
														<ml:id xml:space="preserve" subscript="max">s</ml:id>
														<ml:apply>
															<ml:mult/>
															<ml:real>1</ml:real>
															<ml:id xml:space="preserve">ft</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:localDefine>
														<ml:id xml:space="preserve" subscript="max">s</ml:id>
														<ml:apply>
															<ml:mult/>
															<ml:real>1</ml:real>
															<ml:id xml:space="preserve">ft</ml:id>
														</ml:apply>
													</ml:localDefine>
												</ml:ifThen>
											</ml:program>
										</ml:otherwise>
										<ml:ifThen>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">MildReinfType</ml:id>
												<ml:str xml:space="preserve">Glass Fiber Reinforced Polymer</ml:str>
											</ml:apply>
											<ml:localDefine>
												<ml:id xml:space="preserve" subscript="max">s</ml:id>
												<ml:apply>
													<ml:id xml:space="preserve">min</ml:id>
													<ml:sequence>
														<ml:apply>
															<ml:mult style="auto-select"/>
															<ml:real>0.5</ml:real>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="v">d</ml:id>
																<ml:id xml:space="preserve">k</ml:id>
															</ml:apply>
														</ml:apply>
														<ml:apply>
															<ml:mult style="auto-select"/>
															<ml:real>24</ml:real>
															<ml:id xml:space="preserve">in</ml:id>
														</ml:apply>
													</ml:sequence>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
										<ml:ifThen>
											<ml:apply>
												<ml:greaterOrEqual/>
												<ml:id xml:space="preserve" subscript="max">s</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="prov">s</ml:id>
														<ml:id xml:space="preserve">k</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve">ft</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="chk">s</ml:id>
													<ml:id xml:space="preserve">k</ml:id>
												</ml:apply>
												<ml:real>0</ml:real>
											</ml:localDefine>
										</ml:ifThen>
										<ml:ifThen>
											<ml:apply>
												<ml:lessThan/>
												<ml:id xml:space="preserve" subscript="max">s</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="prov">s</ml:id>
														<ml:id xml:space="preserve">k</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve">ft</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="chk">s</ml:id>
													<ml:id xml:space="preserve">k</ml:id>
												</ml:apply>
												<ml:real>1</ml:real>
											</ml:localDefine>
										</ml:ifThen>
										<ml:ifThen>
											<ml:apply>
												<ml:lessOrEqual/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="u.Strength">V</ml:id>
													<ml:id xml:space="preserve">k</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult style="auto-select"/>
														<ml:real>0.5</ml:real>
														<ml:id xml:space="preserve" subscript="shr">ϕ</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="c">V</ml:id>
														<ml:id xml:space="preserve">k</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:apply>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="chk">s</ml:id>
													<ml:id xml:space="preserve">k</ml:id>
												</ml:apply>
												<ml:real>0</ml:real>
											</ml:localDefine>
										</ml:ifThen>
										<ml:ifThen>
											<ml:apply>
												<ml:lessThan/>
												<ml:id xml:space="preserve">k</ml:id>
												<ml:id xml:space="preserve">ishear</ml:id>
											</ml:apply>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="chk">s</ml:id>
													<ml:id xml:space="preserve">k</ml:id>
												</ml:apply>
												<ml:real>0</ml:real>
											</ml:localDefine>
										</ml:ifThen>
									</ml:program>
								</ml:for>
								<ml:id xml:space="preserve" subscript="chk">s</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="141486" left="6" top="3414" width="200.25" height="30" align-x="87.75" align-y="3432" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
