				<region region-id="176117" left="6" top="9723" width="357" height="11.25" align-x="12" align-y="9732" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">Fatigue I: top beam stress evaluated against compression limit of 0.45 f`c</p>
					</text>
				</region>
				<region region-id="176118" left="6" top="9750.75" width="473.25" height="72.75" align-x="75" align-y="9786" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="top.beam.FatigueI">f</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:mult/>
									<ml:real>0.5</ml:real>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="top.beam.stage6">f</ml:id>
										<ml:id xml:space="preserve">n</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:mult/>
										<ml:parens>
											<ml:apply>
												<ml:minus/>
												<ml:apply>
													<ml:summation/>
													<ml:lambda>
														<ml:boundVars>
															<ml:id xml:space="preserve">nc</ml:id>
														</ml:boundVars>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="tr">B</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">nc</ml:id>
																<ml:id xml:space="preserve">n</ml:id>
															</ml:sequence>
														</ml:apply>
													</ml:lambda>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:id xml:space="preserve" subscript="beam.top">y</ml:id>
													<ml:apply>
														<ml:summation/>
														<ml:lambda>
															<ml:boundVars>
																<ml:id xml:space="preserve">nc</ml:id>
															</ml:boundVars>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="tr">A</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">nc</ml:id>
																	<ml:id xml:space="preserve">n</ml:id>
																</ml:sequence>
															</ml:apply>
														</ml:lambda>
													</ml:apply>
												</ml:apply>
											</ml:apply>
										</ml:parens>
										<ml:parens>
											<ml:apply>
												<ml:plus/>
												<ml:apply>
													<ml:mult/>
													<ml:real>0.5</ml:real>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="dl.comp">M</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:mult style="auto-select"/>
													<ml:real>1.5</ml:real>
