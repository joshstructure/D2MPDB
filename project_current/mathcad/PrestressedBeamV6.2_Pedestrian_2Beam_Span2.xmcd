				<region region-id="177919" left="6" top="1050" width="122.25" height="32.25" align-x="21.75" align-y="1068" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
