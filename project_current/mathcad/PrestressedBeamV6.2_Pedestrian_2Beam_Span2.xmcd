					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="shear.interior.multilane">f_g</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">idx</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">gshr</ml:id>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:plus/>
												<ml:real>0.2</ml:real>
												<ml:apply>
													<ml:div/>
													<ml:id xml:space="preserve">S</ml:id>
													<ml:apply>
														<ml:mult/>
														<ml:real>12</ml:real>
														<ml:id xml:space="preserve">ft</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:pow/>
												<ml:parens>
													<ml:apply>
														<ml:div/>
														<ml:id xml:space="preserve">S</ml:id>
														<ml:apply>
															<ml:mult/>
															<ml:real>35</ml:real>
															<ml:id xml:space="preserve">ft</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:parens>
												<ml:real>2</ml:real>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:greaterOrEqual/>
												<ml:apply>
													<ml:div/>
													<ml:id xml:space="preserve" subscript="dist">b</ml:id>
													<ml:apply>
														<ml:mult style="auto-select"/>
														<ml:real>48</ml:real>
														<ml:id xml:space="preserve">in</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:real>1</ml:real>
											</ml:apply>
											<ml:localDefine>
												<ml:id xml:space="preserve">gshr</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:mult/>
															<ml:apply>
																<ml:pow/>
																<ml:parens>
																	<ml:apply>
																		<ml:div/>
																		<ml:apply>
																			<ml:div/>
																			<ml:id xml:space="preserve" subscript="dist">b</ml:id>
																			<ml:id xml:space="preserve">in</ml:id>
																		</ml:apply>
																		<ml:real>156</ml:real>
																	</ml:apply>
																</ml:parens>
																<ml:real>0.4</ml:real>
															</ml:apply>
															<ml:apply>
																<ml:pow/>
																<ml:parens>
																	<ml:apply>
																		<ml:div/>
																		<ml:id xml:space="preserve" subscript="dist">b</ml:id>
																		<ml:id xml:space="preserve" subscript="s">L</ml:id>
																	</ml:apply>
																</ml:parens>
																<ml:real>0.1</ml:real>
															</ml:apply>
														</ml:apply>
														<ml:apply>
