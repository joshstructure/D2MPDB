					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="Lightweight">AggregateType</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">inpAggregateTypeLW</ml:id>
											<ml:real>0</ml:real>
										</ml:apply>
										<ml:str xml:space="preserve">Standard</ml:str>
										<ml:str xml:space="preserve">Florida</ml:str>
									</ml:sequence>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:str xml:space="preserve">Florida</ml:str>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="188007" left="354" top="14618.25" width="178.5" height="25.5" align-x="354" align-y="14628" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Either <region region-id="34184" left="384" top="14619" width="39" height="12.75" align-x="384" align-y="14628" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
