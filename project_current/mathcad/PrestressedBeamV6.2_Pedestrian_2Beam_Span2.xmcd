										<ml:str xml:space="preserve">debonded strands terminations too long</ml:str>
									</ml:sequence>
								</ml:apply>
							</ml:define>
						</ml:provenance>
					</math>
				</region>
				<region region-id="174413" left="6" top="6261" width="120" height="12.75" align-x="88.5" align-y="6270" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ffff80" tag="">
