				<region region-id="147218" left="6" top="7949.25" width="523.5" height="15" align-x="109.5" align-y="7958.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="loadrating">CheckLongReinf</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:mult style="auto-select"/>
										<ml:parens>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve" subscript="StrengthI">CheckLongReinf</ml:id>
												<ml:str xml:space="preserve">OK</ml:str>
											</ml:apply>
										</ml:parens>
										<ml:parens>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve" subscript="StrengthII">CheckLongReinf</ml:id>
												<ml:str xml:space="preserve">OK</ml:str>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:str xml:space="preserve">OK</ml:str>
									<ml:str xml:space="preserve">no good, add reinf.</ml:str>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="145352" left="6" top="7985.25" width="201.75" height="11.25" align-x="6" align-y="7994.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
