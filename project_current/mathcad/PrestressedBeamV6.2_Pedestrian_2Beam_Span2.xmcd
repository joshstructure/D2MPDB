				<region region-id="147021" left="6" top="5343" width="55.5" height="15" align-x="35.25" align-y="5352" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="pES">Δf</ml:id>
							<ml:unitOverride>
								<ml:id xml:space="preserve">ksi</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
