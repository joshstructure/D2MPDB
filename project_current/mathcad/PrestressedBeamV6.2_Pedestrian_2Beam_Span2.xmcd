				<region region-id="40774" left="6" top="6441" width="258" height="293.25" align-x="55.5" align-y="6450" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#80ffff" tag="">
					<math optimize="false" disable-calc="false">
