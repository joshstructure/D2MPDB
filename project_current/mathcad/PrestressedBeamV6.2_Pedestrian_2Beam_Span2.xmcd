				<region region-id="146484" left="6" top="3543" width="237.75" height="11.25" align-x="6" align-y="3552" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">distribution factors for exterior beam moments</p>
					</text>
				</region>
				<region region-id="146485" left="6" top="3561" width="387.75" height="11.25" align-x="6" align-y="3570" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">No intermediate diaphragms are considered in the exterior beam distribution factor.</p>
					</text>
				</region>
				<region region-id="150386" left="6" top="3585" width="435" height="11.25" align-x="12.75" align-y="3594" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Uses lever rule for Florida I-Beam (FIB), Inverted-T, Double-Tee and Florida U-Beam (FUB)</p>
					</text>
				</region>
				<region region-id="150378" left="6" top="3615" width="510" height="249.75" align-x="113.25" align-y="3624" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffc6c6" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="mom.exterior.one.lane">f_g</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">idx</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:lessThan/>
												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:apply>
															<ml:mult/>
															<ml:real>2</ml:real>
															<ml:id xml:space="preserve">ft</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:real>6</ml:real>
															<ml:id xml:space="preserve">ft</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:parens>
												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve" subscript="e">d</ml:id>
														<ml:id xml:space="preserve">S</ml:id>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:localDefine>
												<ml:id xml:space="preserve">gmom</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:real>1.2</ml:real>
													<ml:parens>
														<ml:apply>
															<ml:div/>
															<ml:apply>
																<ml:minus/>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>2</ml:real>
																	<ml:parens>
																		<ml:apply>
																			<ml:plus/>
																			<ml:id xml:space="preserve">S</ml:id>
																			<ml:id xml:space="preserve" subscript="e">d</ml:id>
																		</ml:apply>
																	</ml:parens>
																</ml:apply>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>10</ml:real>
																	<ml:id xml:space="preserve">ft</ml:id>
																</ml:apply>
															</ml:apply>
															<ml:apply>
																<ml:mult/>
																<ml:real>2</ml:real>
																<ml:id xml:space="preserve">S</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:parens>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:id xml:space="preserve">gmom</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:real>1.2</ml:real>
													<ml:parens>
														<ml:apply>
															<ml:div/>
															<ml:apply>
																<ml:minus/>
																<ml:apply>
																	<ml:plus/>
																	<ml:id xml:space="preserve">S</ml:id>
																	<ml:id xml:space="preserve" subscript="e">d</ml:id>
																</ml:apply>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>2</ml:real>
																	<ml:id xml:space="preserve">ft</ml:id>
																</ml:apply>
															</ml:apply>
															<ml:apply>
																<ml:mult/>
																<ml:real>2</ml:real>
																<ml:id xml:space="preserve">S</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:parens>
												</ml:apply>
											</ml:localDefine>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:greaterOrEqual/>
												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:real>1.125</ml:real>
														<ml:apply>
															<ml:div/>
															<ml:id xml:space="preserve" subscript="e">d</ml:id>
															<ml:apply>
																<ml:mult/>
																<ml:real>30</ml:real>
																<ml:id xml:space="preserve">ft</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:apply>
												</ml:parens>
												<ml:real>1</ml:real>
											</ml:apply>
											<ml:localDefine>
												<ml:id xml:space="preserve">gmom</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:id xml:space="preserve" subscript="mom.interior.one.lane">g</ml:id>
													<ml:parens>
														<ml:apply>
															<ml:plus/>
															<ml:real>1.125</ml:real>
															<ml:apply>
																<ml:div/>
																<ml:id xml:space="preserve" subscript="e">d</ml:id>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>30</ml:real>
																	<ml:id xml:space="preserve">ft</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:apply>
													</ml:parens>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:id xml:space="preserve">gmom</ml:id>
												<ml:id xml:space="preserve" subscript="mom.interior.one.lane">g</ml:id>
											</ml:localDefine>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:lessThan/>
												<ml:apply>
													<ml:mult/>
													<ml:real>8</ml:real>
													<ml:id xml:space="preserve">ft</ml:id>
												</ml:apply>
												<ml:parens>
													<ml:apply>
														<ml:minus/>
														<ml:apply>
															<ml:plus/>
															<ml:apply>
																<ml:plus/>
																<ml:id xml:space="preserve">S</ml:id>
																<ml:id xml:space="preserve" subscript="half.fub">W</ml:id>
															</ml:apply>
															<ml:id xml:space="preserve" subscript="e">d</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:real>9</ml:real>
															<ml:id xml:space="preserve">in</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:localDefine>
												<ml:id xml:space="preserve">gmom</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:real>1.2</ml:real>
													<ml:apply>
														<ml:div/>
														<ml:apply>
															<ml:minus/>
															<ml:apply>
																<ml:mult/>
																<ml:real>2</ml:real>
																<ml:parens>
																	<ml:apply>
																		<ml:plus/>
																		<ml:apply>
																			<ml:plus/>
																			<ml:id xml:space="preserve">S</ml:id>
																			<ml:id xml:space="preserve" subscript="half.fub">W</ml:id>
																		</ml:apply>
																		<ml:id xml:space="preserve" subscript="e">d</ml:id>
																	</ml:apply>
																</ml:parens>
															</ml:apply>
															<ml:apply>
																<ml:mult/>
																<ml:real>11.5</ml:real>
																<ml:id xml:space="preserve">ft</ml:id>
															</ml:apply>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:real>2</ml:real>
															<ml:id xml:space="preserve">S</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:id xml:space="preserve">gmom</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:real>1.2</ml:real>
													<ml:apply>
														<ml:div/>
														<ml:apply>
															<ml:minus/>
															<ml:apply>
																<ml:plus/>
																<ml:apply>
																	<ml:plus/>
																	<ml:id xml:space="preserve">S</ml:id>
																	<ml:id xml:space="preserve" subscript="half.fub">W</ml:id>
																</ml:apply>
																<ml:id xml:space="preserve" subscript="e">d</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:mult/>
																<ml:real>2.75</ml:real>
																<ml:id xml:space="preserve">ft</ml:id>
															</ml:apply>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:real>2</ml:real>
															<ml:id xml:space="preserve">S</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:localDefine>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:id xml:space="preserve">gmom</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="150462" left="66" top="3884.25" width="301.5" height="40.5" align-x="78" align-y="3894" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f2f2f2" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
