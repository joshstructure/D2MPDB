				</region>
				<region region-id="150388" left="6" top="3966" width="441" height="149.25" align-x="117" align-y="3984" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffc6c6" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="mom.exterior.multilane">f_g</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">idx</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">gmom</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:id xml:space="preserve" subscript="mom.interior.multilane">g</ml:id>
											<ml:parens>
												<ml:apply>
													<ml:plus/>
													<ml:real>0.77</ml:real>
													<ml:apply>
														<ml:div/>
														<ml:id xml:space="preserve" subscript="e">d</ml:id>
														<ml:apply>
															<ml:mult/>
															<ml:real>9.1</ml:real>
															<ml:id xml:space="preserve">ft</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:greaterOrEqual/>
												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:real>1.04</ml:real>
														<ml:apply>
															<ml:div/>
															<ml:id xml:space="preserve" subscript="e">d</ml:id>
															<ml:apply>
																<ml:mult/>
																<ml:real>25</ml:real>
																<ml:id xml:space="preserve">ft</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:apply>
												</ml:parens>
												<ml:real>1</ml:real>
											</ml:apply>
											<ml:localDefine>
												<ml:id xml:space="preserve">gmom</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:id xml:space="preserve" subscript="mom.interior.multilane">g</ml:id>
													<ml:parens>
														<ml:apply>
															<ml:plus/>
															<ml:real>1.04</ml:real>
															<ml:apply>
																<ml:div/>
																<ml:id xml:space="preserve" subscript="e">d</ml:id>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>25</ml:real>
																	<ml:id xml:space="preserve">ft</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:apply>
													</ml:parens>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:id xml:space="preserve">gmom</ml:id>
												<ml:id xml:space="preserve" subscript="mom.interior.multilane">g</ml:id>
											</ml:localDefine>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">gmom</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:id xml:space="preserve" subscript="mom.interior.multilane">g</ml:id>
											<ml:parens>
												<ml:apply>
													<ml:plus/>
													<ml:real>0.97</ml:real>
													<ml:apply>
														<ml:div/>
														<ml:id xml:space="preserve" subscript="e">d</ml:id>
														<ml:apply>
															<ml:mult/>
															<ml:real>28.5</ml:real>
															<ml:id xml:space="preserve">ft</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:id xml:space="preserve">gmom</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="150468" left="66" top="4130.25" width="301.5" height="40.5" align-x="78" align-y="4140" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f2f2f2" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<region region-id="150534" left="66" top="4131" width="294" height="12.75" align-x="93" align-y="4140" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f2f2f2" tag="">
								<math optimize="false" disable-calc="false">
									<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
										<ml:equal/>
										<ml:id xml:space="preserve">Index</ml:id>
										<ml:localDefine>
											<ml:real>0</ml:real>
											<ml:parens>
												<ml:sequence>
													<ml:apply>
														<ml:equal/>
														<ml:id xml:space="preserve">BeamCategory</ml:id>
														<ml:str xml:space="preserve">I-Beam</ml:str>
													</ml:apply>
													<ml:str xml:space="preserve">InvTBeams</ml:str>
													<ml:str xml:space="preserve">DblTBeams</ml:str>
												</ml:sequence>
											</ml:parens>
										</ml:localDefine>
									</ml:apply>
								</math>
							</region>
						</p>
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<region region-id="150535" left="66" top="4143" width="211.5" height="12.75" align-x="111.75" align-y="4152" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f2f2f2" tag="">
								<math optimize="false" disable-calc="false">
									<ml:localDefine xmlns:ml="http://schemas.mathsoft.com/math30">
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">Index</ml:id>
											<ml:real>1</ml:real>
										</ml:apply>
										<ml:sequence>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">BeamCategory</ml:id>
												<ml:str xml:space="preserve">FSB</ml:str>
											</ml:apply>
											<ml:str xml:space="preserve">SlabBeams</ml:str>
										</ml:sequence>
									</ml:localDefine>
								</math>
							</region>
						</p>
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<region region-id="150536" left="66" top="4161" width="154.5" height="12.75" align-x="111.75" align-y="4170" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f2f2f2" tag="">
								<math optimize="false" disable-calc="false">
									<ml:localDefine xmlns:ml="http://schemas.mathsoft.com/math30">
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">Index</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">BeamCategory</ml:id>
											<ml:str xml:space="preserve">FUB</ml:str>
										</ml:apply>
