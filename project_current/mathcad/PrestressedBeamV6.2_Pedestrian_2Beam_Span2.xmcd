					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">3.<sp count="2"/>Longitudinal spacing of debonding termination locations shall be at least 60db (3 feet) apart.</p>
					</text>
