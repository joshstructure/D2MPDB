					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Longitudinal Reinforcement Check, Permit:</p>
					</text>
				</region>
				<region region-id="179749" left="204" top="7263" width="78.75" height="11.25" align-x="204" align-y="7272" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(LRFD C5.8.3.3-1)</p>
					</text>
				</region>
				<region region-id="178471" left="6" top="7287" width="551.25" height="42.75" align-x="44.25" align-y="7296" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="s.prov">V</ml:id>
								<ml:id xml:space="preserve">hs</ml:id>
							</ml:apply>
							<ml:program>
								<ml:ifThen>
									<ml:parens>
										<ml:apply>
											<ml:plus/>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">MildReinfType</ml:id>
													<ml:str xml:space="preserve">Carbon Steel</ml:str>
												</ml:apply>
											</ml:parens>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">MildReinfType</ml:id>
													<ml:str xml:space="preserve">Stainless Steel</ml:str>
												</ml:apply>
											</ml:parens>
										</ml:apply>
									</ml:parens>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="v.prov">A</ml:id>
													<ml:id xml:space="preserve">hs</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve" subscript="y">f</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="v">d</ml:id>
												<ml:id xml:space="preserve">hs</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve">cot</ml:id>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="long.StrengthII">θ</ml:id>
												<ml:id xml:space="preserve">hs</ml:id>
