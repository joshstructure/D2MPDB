				<region region-id="201127" left="168" top="4827" width="370.5" height="101.25" align-x="270" align-y="4836" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="splitting.LRFD.slab.beam">D/C</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">DC</ml:id>
									<ml:str xml:space="preserve">N/A</ml:str>
								</ml:localDefine>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:id xml:space="preserve">substr</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:real>0</ml:real>
												<ml:real>3</ml:real>
											</ml:sequence>
										</ml:apply>
										<ml:str xml:space="preserve">FSB</ml:str>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">DC</ml:id>
