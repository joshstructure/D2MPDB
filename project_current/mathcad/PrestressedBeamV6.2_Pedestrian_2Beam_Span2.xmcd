				<region region-id="39776" left="6" top="8663.25" width="243" height="46.5" align-x="32.25" align-y="8672.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="e.fsb">b</ml:id>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">BeamPosition</ml:id>
										<ml:str xml:space="preserve">Interior</ml:str>
									</ml:apply>
									<ml:apply>
										<ml:plus/>
										<ml:id xml:space="preserve" subscript="beam">Width</ml:id>
										<ml:id xml:space="preserve">Gap</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:otherwise>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve" subscript="beam">Width</ml:id>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:div/>
													<ml:real>1</ml:real>
													<ml:real>2</ml:real>
												</ml:apply>
												<ml:id xml:space="preserve">in</ml:id>
											</ml:apply>
										</ml:apply>
