				<region region-id="175942" left="6" top="9159" width="387.75" height="15" align-x="69.75" align-y="9168" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="true">
