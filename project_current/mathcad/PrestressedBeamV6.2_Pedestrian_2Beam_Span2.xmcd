																		<ml:mult/>
																		<ml:id xml:space="preserve">dif</ml:id>
																		<ml:real>0.5</ml:real>
																	</ml:apply>
																	<ml:id xml:space="preserve">fp</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
													</ml:apply>
												</ml:localDefine>
											</ml:program>
										</ml:ifThen>
										<ml:ifThen>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">strandtype</ml:id>
												<ml:real>3</ml:real>
											</ml:apply>
											<ml:program>
												<ml:localDefine>
													<ml:id xml:space="preserve">fpt</ml:id>
													<ml:apply>
														<ml:id xml:space="preserve" subscript="p.CFRP">f_f</ml:id>
														<ml:id xml:space="preserve" subscript="i">ε</ml:id>
													</ml:apply>
