				<region region-id="176269" left="378" top="992.25" width="112.5" height="33.75" align-x="444.75" align-y="1014" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
