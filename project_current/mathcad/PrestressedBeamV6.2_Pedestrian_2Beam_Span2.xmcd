							</originRef>
							<parentRef doc-id="3E277193-677B-46D0-829A-FE821489AE31" version-id="E680BD53-0FE8-4B33-BB0A-431771AD576F" branch-id="00000000-0000-0000-0000-000000000000" revision-num="301165324" is-modified="true" region-id="0" href="C:\FDOT Structures\Programs\LRFDPBeamV3.31\LRFDpsbeam-GreenStepp.xmcd" xmlns="http://schemas.mathsoft.com/provenance10">
