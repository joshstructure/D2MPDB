					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">CheckMaxCapacity</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:lessThan/>
										<ml:apply>
											<ml:id xml:space="preserve">max</ml:id>
											<ml:id xml:space="preserve" subscript="MaxShearCapacity">DC</ml:id>
										</ml:apply>
										<ml:real>1</ml:real>
									</ml:apply>
									<ml:str xml:space="preserve">OK</ml:str>
									<ml:str xml:space="preserve">No Good, larger section required!</ml:str>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
