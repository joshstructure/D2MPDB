				<region region-id="175862" left="6" top="1494.75" width="146.25" height="14.25" align-x="6" align-y="1506" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<f size="12">
								<b>Concrete:</b>
							</f>
						</p>
					</text>
				</region>
				<region region-id="175865" left="6" top="1527" width="168.75" height="15" align-x="35.25" align-y="1536" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="c.deck">f</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:id xml:space="preserve">str2num</ml:id>
										<ml:id xml:space="preserve">inpfcdeck</ml:id>
									</ml:apply>
									<ml:id xml:space="preserve">ksi</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">ksi</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>4.5</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="kips_per_sq_inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="175866" left="204" top="1527" width="190.5" height="11.25" align-x="204" align-y="1536" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">strength of deck or WS concrete</p>
					</text>
				</region>
				<region region-id="175867" left="6" top="1557" width="172.5" height="15" align-x="37.5" align-y="1566" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="c.beam">f</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:id xml:space="preserve">str2num</ml:id>
										<ml:id xml:space="preserve">inpfcbeam</ml:id>
									</ml:apply>
									<ml:id xml:space="preserve">ksi</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">ksi</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>8.5</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="kips_per_sq_inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="175868" left="204" top="1557" width="181.5" height="11.25" align-x="204" align-y="1566" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">strength of beam or slab concrete</p>
					</text>
				</region>
				<region region-id="175869" left="6" top="1587" width="170.25" height="15" align-x="39.75" align-y="1596" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="ci.beam">f</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:id xml:space="preserve">str2num</ml:id>
										<ml:id xml:space="preserve">inpfcibeam</ml:id>
									</ml:apply>
									<ml:id xml:space="preserve">ksi</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">ksi</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>6</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="kips_per_sq_inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="175870" left="204" top="1587" width="141.75" height="11.25" align-x="204" align-y="1596" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">release beam or slab strength</p>
					</text>
				</region>
				<region region-id="175871" left="336" top="1587" width="75" height="11.25" align-x="336" align-y="1596" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(SDG<sp count="2"/>4.3.1.D)</p>
					</text>
				</region>
				<region region-id="175876" left="6" top="1623" width="304.5" height="45.75" align-x="64.5" align-y="1632" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">Environment</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:program>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">inpEnvironment</ml:id>
											<ml:real>0</ml:real>
										</ml:apply>
										<ml:str xml:space="preserve">Slightly</ml:str>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">inpEnvironment</ml:id>
											<ml:real>1</ml:real>
										</ml:apply>
										<ml:str xml:space="preserve">Moderately</ml:str>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">inpEnvironment</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
										<ml:str xml:space="preserve">Extremely</ml:str>
									</ml:ifThen>
								</ml:program>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:str xml:space="preserve">Moderately</ml:str>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="175877" left="324" top="1622.25" width="201" height="13.5" align-x="324" align-y="1632" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Either <region region-id="34186" left="354" top="1623" width="42" height="12.75" align-x="354" align-y="1632" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:str xml:space="preserve" xmlns:ml="http://schemas.mathsoft.com/math30">Slightly</ml:str>
								</math>
							</region>, <region region-id="34187" left="402" top="1623" width="57.75" height="12.75" align-x="402" align-y="1632" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:str xml:space="preserve" xmlns:ml="http://schemas.mathsoft.com/math30">Moderately</ml:str>
								</math>
							</region> or <region region-id="34188" left="474" top="1623" width="49.5" height="12.75" align-x="474" align-y="1632" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:str xml:space="preserve" xmlns:ml="http://schemas.mathsoft.com/math30">Extremely</ml:str>
								</math>
							</region>
						</p>
					</text>
				</region>
				<region region-id="175878" left="6" top="1689" width="59.25" height="11.25" align-x="6" align-y="1698" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Loads Note:</p>
					</text>
				</region>
				<region region-id="175879" left="6" top="1707" width="509.25" height="58.5" align-x="6" align-y="1716" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Dead loads follow the original FDOT inputs and formulas. LLmode selects vehicle or pedestrian gravity live load. Pedestrian mode replaces the design M/V/reaction/deflection paths and excludes the permit Strength II design case. Maintenance vehicles require a separate case.</p>
					</text>
				</region>
				<region region-id="175880" left="6" top="1791" width="93.75" height="11.25" align-x="19.5" align-y="1800" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#80ffff" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<i>Permit Truck Data</i>
						</p>
					</text>
				</region>
				<region region-id="175881" left="6" top="1815" width="225.75" height="12.75" align-x="60" align-y="1824" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">PermitAxles</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">str2num</ml:id>
									<ml:id xml:space="preserve">inpNumberOfPermitAxles</ml:id>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:real>3</ml:real>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="175882" left="6" top="1838.25" width="255" height="27.75" align-x="80.25" align-y="1854" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">PermitUniformLL</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:id xml:space="preserve">str2num</ml:id>
										<ml:id xml:space="preserve">inpPermitUniformLL</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve">lbf</ml:id>
										<ml:id xml:space="preserve">ft</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:unitOverride>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve">lbf</ml:id>
										<ml:id xml:space="preserve">ft</ml:id>
									</ml:apply>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>0</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="foot" power-numerator="-1"/>
											<unitReference unit="pound_force"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="175883" left="6" top="1881" width="285.75" height="11.25" align-x="6" align-y="1890" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Indexes used to identify values in the P and d vectors</p>
					</text>
				</region>
				<region region-id="175884" left="6" top="1899" width="103.5" height="12.75" align-x="18" align-y="1908" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">q</ml:id>
							<ml:range>
								<ml:real>0</ml:real>
								<ml:parens>
									<ml:apply>
										<ml:minus/>
										<ml:id xml:space="preserve">PermitAxles</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
								</ml:parens>
							</ml:range>
						</ml:define>
					</math>
				</region>
				<region region-id="175885" left="138" top="1899" width="82.5" height="12.75" align-x="153" align-y="1908" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define warning="WarnRedefinedBIFunction" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">qt</ml:id>
							<ml:range>
								<ml:real>0</ml:real>
								<ml:id xml:space="preserve">PermitAxles</ml:id>
							</ml:range>
						</ml:define>
					</math>
				</region>
				<region region-id="175886" left="6" top="1928.25" width="102.75" height="27.75" align-x="78.75" align-y="1944" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">PermitUniformLL</ml:id>
							<ml:unitOverride>
								<ml:apply>
									<ml:div/>
									<ml:id xml:space="preserve">lbf</ml:id>
									<ml:id xml:space="preserve">ft</ml:id>
								</ml:apply>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>0</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="foot" power-numerator="-1"/>
										<unitReference unit="pound_force"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="175887" left="150" top="1935" width="377.25" height="11.25" align-x="150" align-y="1944" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Uniform live load to be considered in conjunction with the Permit Vehicle (per lane)</p>
					</text>
				</region>
				<region region-id="175888" left="384" top="2007" width="141.75" height="33.75" align-x="384" align-y="2016" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#80ffff" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Removing default FL-120<sp count="2"/>axles will change Permit load rating results</p>
					</text>
				</region>
				<region region-id="175889" left="6" top="2019" width="318" height="72.75" align-x="76.5" align-y="2028" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">PermitAxleLoad</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:program>
										<ml:for>
											<ml:id xml:space="preserve">i</ml:id>
											<ml:range>
												<ml:real>0</ml:real>
												<ml:real>10</ml:real>
											</ml:range>
											<ml:program>
												<ml:localDefine>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">load</ml:id>
														<ml:id xml:space="preserve">i</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:id xml:space="preserve">str2num</ml:id>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">inpPermitAxleLoad</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:localDefine>
												<ml:ifThen>
													<ml:apply>
														<ml:greaterThan/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">load</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:mult style="auto-select"/>
															<ml:real>0</ml:real>
															<ml:id xml:space="preserve">kip</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">pload</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">load</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
													</ml:localDefine>
												</ml:ifThen>
											</ml:program>
										</ml:for>
										<ml:id xml:space="preserve">pload</ml:id>
									</ml:program>
									<ml:id xml:space="preserve">kip</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">kip</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>0</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="kip"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="175890" left="378" top="2132.25" width="154.5" height="61.5" align-x="378" align-y="2142" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#e3d282" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">The <region region-id="35364" left="396" top="2133" width="75.75" height="12.75" align-x="432.75" align-y="2142" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" xmlns:ml="http://schemas.mathsoft.com/math30">PermitAxleSpacing</ml:id>
								</math>
							</region>
							<sp count="2"/>vector<sp count="2"/>contains the spacings between the concentrated loads.<sp count="2"/>The first and last values are place holders and should always be zero</p>
					</text>
				</region>
				<region region-id="175891" left="6" top="2151" width="311.25" height="51" align-x="87.75" align-y="2160" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math error="This value must be a vector." optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">PermitAxleSpacing</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:program>
										<ml:for>
											<ml:id xml:space="preserve">i</ml:id>
											<ml:range>
												<ml:real>1</ml:real>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:id xml:space="preserve">last</ml:id>
														<ml:id xml:space="preserve">PermitAxleLoad</ml:id>
													</ml:apply>
													<ml:real>1</ml:real>
												</ml:apply>
											</ml:range>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">spa</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:id xml:space="preserve">str2num</ml:id>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">inpPermitAxleSpacing</ml:id>
														<ml:id xml:space="preserve">i</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:localDefine>
										</ml:for>
										<ml:id xml:space="preserve">spa</ml:id>
									</ml:program>
									<ml:id xml:space="preserve">ft</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">ft</ml:id>
								</ml:unitOverride>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="175892" left="6" top="2241" width="246" height="76.5" align-x="90.75" align-y="2250" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math error="This variable is undefined." optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">LocationPermitAxle</ml:id>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:id xml:space="preserve">PermitAxles</ml:id>
									</ml:range>
									<ml:localDefine>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">loc</ml:id>
											<ml:id xml:space="preserve">j</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:summation/>
											<ml:lambda>
												<ml:boundVars>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:boundVars>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">PermitAxleSpacing</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
											</ml:lambda>
											<ml:bounds>
												<ml:real>0</ml:real>
												<ml:id xml:space="preserve">j</ml:id>
											</ml:bounds>
										</ml:apply>
									</ml:localDefine>
								</ml:for>
								<ml:id xml:space="preserve">loc</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="175893" left="6" top="2334" width="496.5" height="140.25" align-x="6" align-y="2334" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f1f1f1" tag="">
