				<region region-id="182635" left="6" top="825" width="582" height="15" align-x="120" align-y="834" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">ControllingShearLimitState</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:id xml:space="preserve">PedMode</ml:id>
										<ml:str xml:space="preserve">Strength I</ml:str>
										<ml:apply>
											<ml:id xml:space="preserve">if</ml:id>
											<ml:sequence>
												<ml:apply>
													<ml:greaterThan/>
													<ml:apply>
														<ml:id xml:space="preserve">max</ml:id>
														<ml:id xml:space="preserve" subscript="pos.StrengthI">V</ml:id>
													</ml:apply>
