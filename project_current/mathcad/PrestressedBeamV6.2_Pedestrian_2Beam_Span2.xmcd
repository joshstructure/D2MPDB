				<region region-id="132875" left="6" top="6734.25" width="528.75" height="45.75" align-x="57.75" align-y="6756" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="top.beam.rel">f</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:plus/>
									<ml:apply>
										<ml:mult/>
										<ml:parens>
											<ml:apply>
												<ml:minus/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="tr.initial">B</ml:id>
													<ml:sequence>
														<ml:real>0</ml:real>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:sequence>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:id xml:space="preserve" subscript="beam.top">y</ml:id>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="tr.initial">A</ml:id>
														<ml:sequence>
															<ml:real>0</ml:real>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:sequence>
													</ml:apply>
												</ml:apply>
											</ml:apply>
										</ml:parens>
										<ml:parens>
											<ml:apply>
												<ml:plus/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="prestress.rel">M</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="release">M</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:parens>
											<ml:apply>
												<ml:minus/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="tr.initial">I</ml:id>
													<ml:sequence>
														<ml:real>0</ml:real>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:sequence>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:id xml:space="preserve" subscript="beam.top">y</ml:id>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="tr.initial">B</ml:id>
														<ml:sequence>
															<ml:real>0</ml:real>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:sequence>
													</ml:apply>
												</ml:apply>
											</ml:apply>
										</ml:parens>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="prestress.rel">N</ml:id>
											<ml:id xml:space="preserve">n</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:minus/>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="tr.initial">A</ml:id>
											<ml:sequence>
												<ml:real>0</ml:real>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:sequence>
										</ml:apply>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="tr.initial">I</ml:id>
											<ml:sequence>
												<ml:real>0</ml:real>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:sequence>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:pow/>
										<ml:parens>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="tr.initial">B</ml:id>
												<ml:sequence>
