				<region region-id="32081" left="6" top="437.25" width="325.5" height="11.25" align-x="6" align-y="446.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Area of draped Prestressing Strands below mid-depth of composite section</p>
					</text>
				</region>
				<region region-id="32082" left="6" top="461.25" width="393" height="216.75" align-x="33.75" align-y="470.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="psds">A</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:while>
									<ml:apply>
										<ml:lessThan/>
										<ml:id xml:space="preserve">j</ml:id>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:id xml:space="preserve">last</ml:id>
												<ml:id xml:space="preserve">Location</ml:id>
											</ml:apply>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:program>
										<ml:for>
											<ml:id xml:space="preserve">i</ml:id>
											<ml:range>
												<ml:real>0</ml:real>
												<ml:apply>
													<ml:id xml:space="preserve">last</ml:id>
													<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
												</ml:apply>
											</ml:range>
											<ml:program>
												<ml:ifThen>
													<ml:apply>
														<ml:mult/>
														<ml:parens>
															<ml:apply>
																<ml:lessThan/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
																	<ml:sequence>
																		<ml:id xml:space="preserve">i</ml:id>
																		<ml:id xml:space="preserve">j</ml:id>
																	</ml:sequence>
																</ml:apply>
																<ml:id xml:space="preserve">MidDepth</ml:id>
															</ml:apply>
														</ml:parens>
														<ml:parens>
															<ml:apply>
																<ml:notEqual/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
																	<ml:sequence>
																		<ml:id xml:space="preserve">i</ml:id>
																		<ml:id xml:space="preserve">j</ml:id>
																	</ml:sequence>
																</ml:apply>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
																	<ml:sequence>
																		<ml:id xml:space="preserve">i</ml:id>
																		<ml:apply>
																			<ml:plus/>
																			<ml:id xml:space="preserve">j</ml:id>
																			<ml:real>1</ml:real>
																		</ml:apply>
																	</ml:sequence>
																</ml:apply>
															</ml:apply>
														</ml:parens>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">apsds</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
													</ml:localDefine>
												</ml:ifThen>
												<ml:otherwise>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">apsds</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:real>0</ml:real>
															<ml:apply>
																<ml:pow/>
																<ml:id xml:space="preserve">in</ml:id>
																<ml:real>2</ml:real>
															</ml:apply>
														</ml:apply>
													</ml:localDefine>
												</ml:otherwise>
											</ml:program>
										</ml:for>
										<ml:localDefine>
											<ml:id xml:space="preserve">endi</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">last</ml:id>
												<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="psds">a</ml:id>
												<ml:id xml:space="preserve">j</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:summation/>
												<ml:lambda>
													<ml:boundVars>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:boundVars>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">apsds</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
												</ml:lambda>
												<ml:bounds>
													<ml:real>0</ml:real>
													<ml:apply>
														<ml:id xml:space="preserve">last</ml:id>
														<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
													</ml:apply>
												</ml:bounds>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve">j</ml:id>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve">j</ml:id>
												<ml:real>1</ml:real>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:while>
								<ml:id xml:space="preserve" subscript="psds">a</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="32066" left="384" top="671.25" width="75.75" height="21" align-x="432.75" align-y="686.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
