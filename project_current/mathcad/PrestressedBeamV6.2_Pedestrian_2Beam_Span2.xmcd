									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>0</ml:real>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:id xml:space="preserve">str2num</ml:id>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">inpW</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">i</ml:id>
													<ml:real>0</ml:real>
												</ml:sequence>
											</ml:apply>
										</ml:apply>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
								</ml:sequence>
							</ml:apply>
						</ml:define>
