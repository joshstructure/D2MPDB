						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="matrix" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="177745" left="168" top="6159.75" width="72" height="95.25" align-x="184.5" align-y="6210" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="se">ε</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="6" cols="1">
									<ml:real>0.0062507929484262132</ml:real>
									<ml:real>0.0062507929484262132</ml:real>
									<ml:real>0.0062507929484262132</ml:real>
									<ml:real>0.0062507929484262132</ml:real>
									<ml:real>0.0062507929484262132</ml:real>
									<ml:real>0</ml:real>
								</ml:matrix>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="5" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="8"/>
							<matrix display-style="matrix" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="177746" left="246" top="6159.75" width="78" height="95.25" align-x="263.25" align-y="6210" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="cp">ε</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="6" cols="1">
									<ml:real>-0.00054384110709737013</ml:real>
									<ml:real>-0.00054384110709737013</ml:real>
									<ml:real>-0.00050464122724989632</ml:real>
									<ml:real>-0.00050464122724989632</ml:real>
									<ml:real>-0.00046544158260123118</ml:real>
									<ml:real>0.00010295561679249974</ml:real>
								</ml:matrix>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="5" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="6"/>
							<matrix display-style="matrix" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="25338" left="6" top="6326.25" width="546" height="42.75" align-x="6" align-y="6336" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">The <region region-id="144427" left="24" top="6327" width="29.25" height="15" align-x="37.5" align-y="6336" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" subscript="trap" xmlns:ml="http://schemas.mathsoft.com/math30">fVol</ml:id>
								</math>
							</region>
							<sp count="2"/>function calculates the volume of a trapezoidal shape with a parabolic surface.<sp count="2"/>The trapezoidal shape is defined by: w1 -&gt; the length at the top,<sp count="2"/>w2 -&gt; the length at the bottom and T -&gt; the width.<sp count="2"/>The parabolic surface is of the<sp count="2"/>form :</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">a* x<sup>2</sup>
							<sp count="2"/>+ b*x<sp count="2"/>+ c. </p>
					</text>
				</region>
				<region region-id="25336" left="6" top="6374.25" width="480" height="27.75" align-x="114.75" align-y="6390" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="trap">fVol</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">w1</ml:id>
									<ml:id xml:space="preserve">w2</ml:id>
									<ml:id xml:space="preserve">a</ml:id>
									<ml:id xml:space="preserve">b</ml:id>
									<ml:id xml:space="preserve">c</ml:id>
									<ml:id xml:space="preserve">T</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:mult/>
									<ml:parens>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:plus/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:div/>
															<ml:real>1</ml:real>
															<ml:real>4</ml:real>
														</ml:apply>
														<ml:id xml:space="preserve">a</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:pow/>
														<ml:id xml:space="preserve">T</ml:id>
														<ml:real>3</ml:real>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:div/>
															<ml:real>1</ml:real>
															<ml:real>2</ml:real>
														</ml:apply>
														<ml:id xml:space="preserve">c</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve">T</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:div/>
														<ml:real>1</ml:real>
														<ml:real>3</ml:real>
													</ml:apply>
													<ml:id xml:space="preserve">b</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:pow/>
													<ml:id xml:space="preserve">T</ml:id>
													<ml:real>2</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:apply>
									</ml:parens>
									<ml:id xml:space="preserve">w1</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:mult/>
									<ml:parens>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:plus/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:div/>
															<ml:real>1</ml:real>
															<ml:real>2</ml:real>
														</ml:apply>
														<ml:id xml:space="preserve">c</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve">T</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:div/>
															<ml:real>1</ml:real>
															<ml:real>12</ml:real>
														</ml:apply>
														<ml:id xml:space="preserve">a</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:pow/>
														<ml:id xml:space="preserve">T</ml:id>
														<ml:real>3</ml:real>
													</ml:apply>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:div/>
														<ml:real>1</ml:real>
														<ml:real>6</ml:real>
													</ml:apply>
													<ml:id xml:space="preserve">b</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:pow/>
													<ml:id xml:space="preserve">T</ml:id>
													<ml:real>2</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:apply>
									</ml:parens>
									<ml:id xml:space="preserve">w2</ml:id>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="25337" left="6" top="6410.25" width="468" height="27.75" align-x="6" align-y="6420" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">The <region region-id="144428" left="24" top="6411" width="50.25" height="15" align-x="48" align-y="6420" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" subscript="trap" xmlns:ml="http://schemas.mathsoft.com/math30">fCentroid</ml:id>
								</math>
							</region>
							<sp count="3"/>function calculates the centroid of a trapezoidal shape with a parabolic surface.<sp count="2"/>The variables are the same as the TVol function.</p>
					</text>
				</region>
				<region region-id="25309" left="6" top="6452.25" width="552" height="39.75" align-x="135.75" align-y="6474" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="trap">fCentroid</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">w1</ml:id>
									<ml:id xml:space="preserve">w2</ml:id>
									<ml:id xml:space="preserve">a</ml:id>
									<ml:id xml:space="preserve">b</ml:id>
									<ml:id xml:space="preserve">c</ml:id>
									<ml:id xml:space="preserve">T</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:div/>
										<ml:real>1</ml:real>
										<ml:real>5</ml:real>
									</ml:apply>
									<ml:id xml:space="preserve">T</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:plus/>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:plus/>
														<ml:apply>
															<ml:mult/>
															<ml:apply>
																<ml:mult/>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>12</ml:real>
																	<ml:id xml:space="preserve">a</ml:id>
																</ml:apply>
																<ml:id xml:space="preserve">w1</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:pow/>
																<ml:id xml:space="preserve">T</ml:id>
																<ml:real>2</ml:real>
															</ml:apply>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:apply>
																<ml:mult/>
																<ml:real>20</ml:real>
																<ml:id xml:space="preserve">c</ml:id>
															</ml:apply>
															<ml:id xml:space="preserve">w1</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:mult/>
															<ml:real>10</ml:real>
															<ml:id xml:space="preserve">w2</ml:id>
														</ml:apply>
														<ml:id xml:space="preserve">c</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:mult/>
															<ml:real>3</ml:real>
															<ml:id xml:space="preserve">a</ml:id>
														</ml:apply>
														<ml:id xml:space="preserve">w2</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:pow/>
														<ml:id xml:space="preserve">T</ml:id>
														<ml:real>2</ml:real>
													</ml:apply>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:real>5</ml:real>
														<ml:id xml:space="preserve">w2</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve">b</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve">T</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:real>15</ml:real>
													<ml:id xml:space="preserve">b</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve">w1</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve">T</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:plus/>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:plus/>
														<ml:apply>
															<ml:mult/>
															<ml:apply>
																<ml:mult/>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>3</ml:real>
																	<ml:id xml:space="preserve">a</ml:id>
																</ml:apply>
																<ml:id xml:space="preserve">w1</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:pow/>
																<ml:id xml:space="preserve">T</ml:id>
																<ml:real>2</ml:real>
															</ml:apply>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:apply>
																<ml:mult/>
																<ml:real>6</ml:real>
																<ml:id xml:space="preserve">c</ml:id>
															</ml:apply>
															<ml:id xml:space="preserve">w1</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:mult/>
															<ml:real>6</ml:real>
															<ml:id xml:space="preserve">w2</ml:id>
														</ml:apply>
														<ml:id xml:space="preserve">c</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve">a</ml:id>
														<ml:id xml:space="preserve">w2</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:pow/>
														<ml:id xml:space="preserve">T</ml:id>
														<ml:real>2</ml:real>
													</ml:apply>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:real>2</ml:real>
														<ml:id xml:space="preserve">w2</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve">b</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve">T</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:real>4</ml:real>
													<ml:id xml:space="preserve">b</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve">w1</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve">T</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="25310" left="6" top="6500.25" width="445.5" height="37.5" align-x="6" align-y="6510" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">The <region region-id="144429" left="24" top="6501" width="14.25" height="12.75" align-x="30" align-y="6510" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" xmlns:ml="http://schemas.mathsoft.com/math30">f_a</ml:id>
								</math>
							</region>
							<sp count="2"/>and <region region-id="144430" left="66" top="6501" width="15" height="12.75" align-x="72.75" align-y="6510" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" xmlns:ml="http://schemas.mathsoft.com/math30">f_b</ml:id>
								</math>
							</region>
							<sp count="2"/>functions calculate the a and b coefficients<sp count="2"/>for the parabolic function required to curve fit a shape defined by a value of h1 at one end, h3 at the<sp count="2"/>other and h2 at the<sp count="2"/>midpoint.<sp count="2"/>The c value is equal to h1 </p>
					</text>
				</region>
				<region region-id="25311" left="6" top="6542.25" width="175.5" height="33.75" align-x="82.5" align-y="6558" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">f_a</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">h1</ml:id>
									<ml:id xml:space="preserve">h2</ml:id>
									<ml:id xml:space="preserve">h3</ml:id>
									<ml:id xml:space="preserve">T</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:mult/>
									<ml:real>2</ml:real>
									<ml:parens>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve">h1</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:real>2</ml:real>
													<ml:id xml:space="preserve">h2</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:id xml:space="preserve">h3</ml:id>
										</ml:apply>
									</ml:parens>
								</ml:apply>
								<ml:apply>
									<ml:pow/>
									<ml:id xml:space="preserve">T</ml:id>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="25312" left="234" top="6542.25" width="168.75" height="27.75" align-x="311.25" align-y="6558" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">f_b</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">h1</ml:id>
									<ml:id xml:space="preserve">h2</ml:id>
									<ml:id xml:space="preserve">h3</ml:id>
									<ml:id xml:space="preserve">T</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:minus/>
									<ml:apply>
										<ml:minus/>
										<ml:apply>
											<ml:mult/>
											<ml:real>4</ml:real>
											<ml:id xml:space="preserve">h2</ml:id>
										</ml:apply>
										<ml:id xml:space="preserve">h3</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>3</ml:real>
										<ml:id xml:space="preserve">h1</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:id xml:space="preserve">T</ml:id>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="183825" left="300" top="6600" width="188.25" height="212.25" align-x="300" align-y="6600" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<picture>
						<png item-idref="527" display-width="186.75" display-height="210.75"/>
					</picture>
				</region>
				<region region-id="183760" left="6" top="6656.25" width="259.5" height="63.75" align-x="6" align-y="6666" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">The <region region-id="144196" left="24" top="6657" width="25.5" height="12.75" align-x="36" align-y="6666" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" xmlns:ml="http://schemas.mathsoft.com/math30">fLoop</ml:id>
								</math>
							</region>
							<sp count="2"/>function is basically a subroutine of the <region region-id="144197" left="234" top="6657" width="24" height="15" align-x="245.25" align-y="6666" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" subscript="force" xmlns:ml="http://schemas.mathsoft.com/math30">fC</ml:id>
								</math>
							</region>
							<sp count="2"/>function that follows it.<sp count="2"/>This function calculates the stress level at each end of a section and in the middle and then uses this data to calculate the compressive force and its centroid by using the TVol and CentVol functions above.</p>
					</text>
				</region>
				<region region-id="181989" left="6" top="6825" width="566.25" height="601.5" align-x="123" align-y="6834" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">fLoop</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve" subscript="c">f</ml:id>
									<ml:id xml:space="preserve">cna</ml:id>
									<ml:id xml:space="preserve">thk</ml:id>
									<ml:id xml:space="preserve">w</ml:id>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:id xml:space="preserve" subscript="cu">ε</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">StackValues</ml:id>
									<ml:matrix rows="1" cols="2">
										<ml:real>0</ml:real>
										<ml:real>0</ml:real>
									</ml:matrix>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">cforce</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">centroid</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:id xml:space="preserve">i</ml:id>
									</ml:range>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:greaterThan/>
												<ml:id xml:space="preserve">j</ml:id>
												<ml:real>0</ml:real>
											</ml:apply>
											<ml:localDefine>
												<ml:id xml:space="preserve" subscript="sum">thk</ml:id>
												<ml:apply>
													<ml:summation/>
													<ml:lambda>
														<ml:boundVars>
															<ml:id xml:space="preserve">p</ml:id>
														</ml:boundVars>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">thk</ml:id>
															<ml:id xml:space="preserve">p</ml:id>
														</ml:apply>
													</ml:lambda>
													<ml:bounds>
														<ml:real font="0">0</ml:real>
														<ml:apply>
															<ml:minus/>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>1</ml:real>
														</ml:apply>
													</ml:bounds>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:id xml:space="preserve" subscript="sum">thk</ml:id>
												<ml:real>0</ml:real>
											</ml:localDefine>
										</ml:otherwise>
										<ml:for>
											<ml:id xml:space="preserve">n</ml:id>
											<ml:range>
												<ml:real>0</ml:real>
												<ml:real>4</ml:real>
											</ml:range>
											<ml:program>
												<ml:localDefine>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">ConcStress</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:id xml:space="preserve" font="1">n</ml:id>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:id xml:space="preserve" subscript="c">f_f</ml:id>
														<ml:sequence>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="c">f</ml:id>
																<ml:id xml:space="preserve">j</ml:id>
															</ml:apply>
															<ml:parens>
																<ml:apply>
																	<ml:mult/>
																	<ml:apply>
																		<ml:div/>
																		<ml:apply>
																			<ml:minus/>
																			<ml:id xml:space="preserve">cna</ml:id>
																			<ml:parens>
																				<ml:apply>
																					<ml:plus/>
																					<ml:id xml:space="preserve" subscript="sum">thk</ml:id>
																					<ml:apply>
																						<ml:mult/>
																						<ml:apply>
																							<ml:div/>
																							<ml:id xml:space="preserve">n</ml:id>
																							<ml:real>4</ml:real>
																						</ml:apply>
																						<ml:apply>
																							<ml:indexer/>
																							<ml:id xml:space="preserve">thk</ml:id>
																							<ml:id xml:space="preserve">j</ml:id>
																						</ml:apply>
																					</ml:apply>
																				</ml:apply>
																			</ml:parens>
																		</ml:apply>
																		<ml:id xml:space="preserve">cna</ml:id>
																	</ml:apply>
																	<ml:id xml:space="preserve" subscript="cu">ε</ml:id>
																</ml:apply>
															</ml:parens>
															<ml:apply>
																<ml:id xml:space="preserve" subscript="fac">Adjust</ml:id>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve" subscript="c">f</ml:id>
																	<ml:id xml:space="preserve">j</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:sequence>
													</ml:apply>
												</ml:localDefine>
												<ml:localDefine>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="stress">y</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:sequence>
													</ml:apply>
													<ml:parens>
														<ml:apply>
															<ml:plus/>
															<ml:id xml:space="preserve" subscript="sum">thk</ml:id>
															<ml:apply>
																<ml:mult/>
																<ml:apply>
																	<ml:div/>
																	<ml:id xml:space="preserve">n</ml:id>
																	<ml:real>4</ml:real>
																</ml:apply>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">thk</ml:id>
																	<ml:id xml:space="preserve">j</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:apply>
													</ml:parens>
												</ml:localDefine>
											</ml:program>
										</ml:for>
										<ml:localDefine>
											<ml:id xml:space="preserve">StackValues</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">stack</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">StackValues</ml:id>
													<ml:matrix rows="1" cols="2">
														<ml:id xml:space="preserve" subscript="stress">y</ml:id>
														<ml:id xml:space="preserve">ConcStress</ml:id>
													</ml:matrix>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="int">w</ml:id>
											<ml:apply>
												<ml:mult/>
												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">w</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">j</ml:id>
																<ml:real>0</ml:real>
															</ml:sequence>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">w</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">j</ml:id>
																<ml:real>1</ml:real>
															</ml:sequence>
														</ml:apply>
													</ml:apply>
												</ml:parens>
												<ml:real>0.5</ml:real>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="bot.stress">a</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">f_a</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">ConcStress</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>4</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">ConcStress</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>3</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">ConcStress</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>2</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">thk</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:apply>
														<ml:real>0.5</ml:real>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="bot.stress">b</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">f_b</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">ConcStress</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>4</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">ConcStress</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>3</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">ConcStress</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>2</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">thk</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:apply>
														<ml:real>0.5</ml:real>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="bot.stress">c</ml:id>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">ConcStress</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">j</ml:id>
													<ml:real>4</ml:real>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="top.stress">a</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">f_a</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">ConcStress</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>2</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">ConcStress</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>1</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">ConcStress</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>0</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">thk</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:apply>
														<ml:real>0.5</ml:real>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="top.stress">b</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">f_b</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">ConcStress</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>2</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">ConcStress</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>1</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">ConcStress</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>0</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">thk</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:apply>
														<ml:real>0.5</ml:real>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="top.stress">c</ml:id>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">ConcStress</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">j</ml:id>
													<ml:real>2</ml:real>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="bot">cforce</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve" subscript="trap">fVol</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve" subscript="int">w</ml:id>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">w</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>1</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="bot.stress">a</ml:id>
													<ml:id xml:space="preserve" subscript="bot.stress">b</ml:id>
													<ml:id xml:space="preserve" subscript="bot.stress">c</ml:id>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">thk</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:apply>
														<ml:real>0.5</ml:real>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="bot">centroid</ml:id>
											<ml:apply>
												<ml:minus/>
												<ml:apply>
													<ml:plus/>
													<ml:id xml:space="preserve" subscript="sum">thk</ml:id>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">thk</ml:id>
														<ml:id xml:space="preserve">j</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:id xml:space="preserve" subscript="trap">fCentroid</ml:id>
													<ml:sequence>
														<ml:id xml:space="preserve" subscript="int">w</ml:id>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">w</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">j</ml:id>
																<ml:real>1</ml:real>
															</ml:sequence>
														</ml:apply>
														<ml:id xml:space="preserve" subscript="bot.stress">a</ml:id>
														<ml:id xml:space="preserve" subscript="bot.stress">b</ml:id>
														<ml:id xml:space="preserve" subscript="bot.stress">c</ml:id>
														<ml:apply>
															<ml:mult/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">thk</ml:id>
																<ml:id xml:space="preserve">j</ml:id>
															</ml:apply>
															<ml:real>0.5</ml:real>
														</ml:apply>
													</ml:sequence>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="top">cforce</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve" subscript="trap">fVol</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">w</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>0</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="int">w</ml:id>
													<ml:id xml:space="preserve" subscript="top.stress">a</ml:id>
													<ml:id xml:space="preserve" subscript="top.stress">b</ml:id>
													<ml:id xml:space="preserve" subscript="top.stress">c</ml:id>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">thk</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:apply>
														<ml:real>0.5</ml:real>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="top">centroid</ml:id>
											<ml:apply>
												<ml:minus/>
												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve" subscript="sum">thk</ml:id>
														<ml:apply>
															<ml:mult/>
															<ml:apply>
