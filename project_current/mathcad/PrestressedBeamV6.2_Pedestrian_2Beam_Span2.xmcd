				<region region-id="141101" left="6" top="171" width="211.5" height="18.75" align-x="65.25" align-y="180" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="ps.developed">A</ml:id>
								<ml:id xml:space="preserve">pi</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
									<ml:id xml:space="preserve">pi</ml:id>
								</ml:apply>
								<ml:parens>
									<ml:apply>
										<ml:id xml:space="preserve">if</ml:id>
										<ml:sequence>
											<ml:apply>
												<ml:greaterThan/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
													<ml:id xml:space="preserve">pi</ml:id>
												</ml:apply>
												<ml:real>0</ml:real>
											</ml:apply>
											<ml:real>0</ml:real>
											<ml:real>1</ml:real>
										</ml:sequence>
									</ml:apply>
								</ml:parens>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="141100" left="294" top="165" width="166.5" height="30" align-x="348.75" align-y="180" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="tot.developed">A</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:vectorSum/>
									<ml:id xml:space="preserve" subscript="ps.developed">A</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve">in</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>6.727</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch" power-numerator="2"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="144230" left="6" top="213" width="168" height="12.75" align-x="58.5" align-y="222" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">StrandType</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:str xml:space="preserve">Carbon Steel - Low Lax</ml:str>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="177761" left="6" top="237" width="399.75" height="45.75" align-x="152.25" align-y="246" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">PSGroupIndex</ml:id>
								<ml:apply>
									<ml:id xml:space="preserve">length</ml:id>
									<ml:id xml:space="preserve">PSGroupIndex</ml:id>
								</ml:apply>
							</ml:apply>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">MildReinfType</ml:id>
										<ml:str xml:space="preserve">Carbon Steel</ml:str>
									</ml:apply>
									<ml:real>4</ml:real>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">MildReinfType</ml:id>
										<ml:str xml:space="preserve">Stainless Steel</ml:str>
									</ml:apply>
									<ml:real>5</ml:real>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">MildReinfType</ml:id>
										<ml:str xml:space="preserve">Glass Fiber Reinforced Polymer</ml:str>
									</ml:apply>
									<ml:real>6</ml:real>
								</ml:ifThen>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="30341" left="6" top="297" width="69.75" height="15" align-x="36" align-y="306" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="strand">d</ml:id>
							<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
						</ml:define>
					</math>
				</region>
				<region region-id="30342" left="300" top="297" width="141.75" height="18.75" align-x="414.75" align-y="306" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define warning="WarnRedefinedUDScalar" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="strand">d</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:minus/>
										<ml:apply>
											<ml:id xml:space="preserve">length</ml:id>
											<ml:id xml:space="preserve">PSGroupIndex</ml:id>
										</ml:apply>
										<ml:real>1</ml:real>
									</ml:apply>
									<ml:id xml:space="preserve">n</ml:id>
								</ml:sequence>
							</ml:apply>
							<ml:id xml:space="preserve" subscript="long">d</ml:id>
						</ml:define>
					</math>
				</region>
				<region region-id="30349" left="6" top="327" width="172.5" height="18.75" align-x="136.5" align-y="336" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="ps.developed">A</ml:id>
								<ml:apply>
									<ml:minus/>
									<ml:apply>
										<ml:id xml:space="preserve">length</ml:id>
										<ml:id xml:space="preserve">PSGroupIndex</ml:id>
									</ml:apply>
									<ml:real>1</ml:real>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="s.long">A</ml:id>
								<ml:real>50</ml:real>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="30351" left="300" top="327" width="109.5" height="15" align-x="318" align-y="336" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">pn</ml:id>
							<ml:range>
								<ml:real>0</ml:real>
								<ml:apply>
									<ml:plus/>
									<ml:apply>
										<ml:id xml:space="preserve">last</ml:id>
										<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
									</ml:apply>
									<ml:real>1</ml:real>
								</ml:apply>
							</ml:range>
						</ml:define>
					</math>
				</region>
				<region region-id="135088" left="0" top="357.75" width="540" height="3.75" align-x="0" align-y="360" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#000082" tag="">
					<text use-page-width="true" push-down="true" lock-width="true">
						<p style="Small Lines" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">.</p>
					</text>
				</region>
				<region region-id="145957" left="6" top="399" width="636.75" height="78" align-x="70.5" align-y="408" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8040" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="1.2">Check_SDG</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">display</ml:id>
										<ml:sequence>
											<ml:real>0</ml:real>
											<ml:real>0</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">concat</ml:id>
										<ml:sequence>
											<ml:str xml:space="preserve">Check Live-Load Deflection--</ml:str>
											<ml:id xml:space="preserve">CheckLLDeflection</ml:id>
										</ml:sequence>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">display</ml:id>
										<ml:sequence>
											<ml:real>1</ml:real>
											<ml:real>0</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">concat</ml:id>
										<ml:sequence>
											<ml:str xml:space="preserve">Span vs. Depth Ratio--</ml:str>
											<ml:id xml:space="preserve">CheckSpanToDepth</ml:id>
										</ml:sequence>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">display</ml:id>
										<ml:sequence>
											<ml:real>2</ml:real>
											<ml:real>0</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">if</ml:id>
										<ml:sequence>
											<ml:id xml:space="preserve">PedMode</ml:id>
											<ml:id xml:space="preserve">CheckLLDeflection</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">if</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:plus/>
														<ml:parens>
															<ml:apply>
																<ml:equal/>
																<ml:id xml:space="preserve">CheckLLDeflection</ml:id>
																<ml:str xml:space="preserve">OK</ml:str>
															</ml:apply>
														</ml:parens>
														<ml:parens>
															<ml:apply>
																<ml:equal/>
																<ml:id xml:space="preserve">CheckSpanToDepth</ml:id>
																<ml:str xml:space="preserve">OK</ml:str>
															</ml:apply>
														</ml:parens>
													</ml:apply>
													<ml:str xml:space="preserve">OK</ml:str>
													<ml:str xml:space="preserve">No Good</ml:str>
												</ml:sequence>
											</ml:apply>
										</ml:sequence>
									</ml:apply>
								</ml:localDefine>
								<ml:id xml:space="preserve">display</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="145955" left="486" top="399" width="42.75" height="11.25" align-x="486" align-y="408" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">SDG 1.2</p>
					</text>
				</region>
				<region region-id="145958" left="6" top="496.5" width="230.25" height="45.75" align-x="69" align-y="522" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="1.2">Check_SDG</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="3" cols="1">
									<ml:str xml:space="preserve">Check Live-Load Deflection--OK</ml:str>
									<ml:str xml:space="preserve">Span vs. Depth Ratio--No Good</ml:str>
									<ml:str xml:space="preserve">OK</ml:str>
								</ml:matrix>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="174583" left="6" top="555" width="390" height="18.75" align-x="145.5" align-y="564" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">CheckDeflectionOrSpanToDepth</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:id xml:space="preserve">PedMode</ml:id>
										<ml:id xml:space="preserve">CheckLLDeflection</ml:id>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="1.2">Check_SDG</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:sequence>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:str xml:space="preserve">OK</ml:str>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="144703" left="6" top="582.75" width="226.5" height="14.25" align-x="6" align-y="594" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="heading" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Strength Limit State Moments</p>
					</text>
				</region>
				<region region-id="144699" left="6" top="615" width="386.25" height="18.75" align-x="66" align-y="624" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="pos.StrengthI">M</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:mult/>
									<ml:real>1.75</ml:real>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="dist.live.pos">M</ml:id>
										<ml:id xml:space="preserve">n</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:parens>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:mult/>
											<ml:parens>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="dl.non.comp">M</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="dl.comp.str">M</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:parens>
											<ml:real>1.25</ml:real>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="dl.future.ws">M</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
											<ml:real>1.5</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:parens>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="144700" left="6" top="645" width="825" height="18.75" align-x="68.25" align-y="654" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8040" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="pos.StrengthII">M</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">PedMode</ml:id>
									<ml:parens>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:mult/>
												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="dl.non.comp">M</ml:id>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="dl.comp.str">M</ml:id>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:parens>
												<ml:real>1.25</ml:real>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="dl.future.ws">M</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:real>1.5</ml:real>
											</ml:apply>
										</ml:apply>
									</ml:parens>
									<ml:apply>
										<ml:plus/>
										<ml:parens>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:parens>
														<ml:apply>
															<ml:plus/>
															<ml:apply>
																<ml:mult/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve" subscript="permit.pos">M</ml:id>
																	<ml:id xml:space="preserve">n</ml:id>
																</ml:apply>
																<ml:parens>
																	<ml:real>1.33</ml:real>
																</ml:parens>
															</ml:apply>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="lane.permit.pos">M</ml:id>
																<ml:id xml:space="preserve">n</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:parens>
													<ml:id xml:space="preserve" subscript="mom">g</ml:id>
												</ml:apply>
												<ml:real>1.35</ml:real>
											</ml:apply>
										</ml:parens>
										<ml:parens>
											<ml:apply>
												<ml:plus/>
												<ml:apply>
													<ml:mult/>
													<ml:parens>
														<ml:apply>
															<ml:plus/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="dl.non.comp">M</ml:id>
																<ml:id xml:space="preserve">n</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="dl.comp.str">M</ml:id>
																<ml:id xml:space="preserve">n</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:parens>
													<ml:real>1.25</ml:real>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="dl.future.ws">M</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
													<ml:real>1.5</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:parens>
									</ml:apply>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="144702" left="6" top="708.75" width="226.5" height="14.25" align-x="6" align-y="720" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
