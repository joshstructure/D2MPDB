				<region region-id="181520" left="6" top="2349" width="312" height="15" align-x="74.25" align-y="2358" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffd5d5" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">CheckD/CLong</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">fCheckDCLong</ml:id>
								<ml:sequence>
									<ml:str xml:space="preserve">Longitudinal Reinf.</ml:str>
									<ml:id xml:space="preserve" subscript="long.reqd">V</ml:id>
									<ml:id xml:space="preserve" subscript="long.prov">V</ml:id>
