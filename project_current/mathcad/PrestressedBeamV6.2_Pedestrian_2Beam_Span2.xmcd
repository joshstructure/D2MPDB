				<region region-id="175932" left="6" top="8697" width="138" height="15" align-x="61.5" align-y="8706" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="buildup">Width</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:id xml:space="preserve" subscript="flange">Width</ml:id>
								<ml:unitOverride>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>47.999999999999993</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
