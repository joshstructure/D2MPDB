						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Bar Number<sp count="7"/>3,<sp count="9"/>4,<sp count="8"/>5,<sp count="9"/>6,<sp count="9"/>7,<sp count="7"/>8,<sp count="8"/>9 ,<sp count="7"/>10,<sp count="6"/>11 </p>
					</text>
				</region>
				<region region-id="176793" left="336" top="234.75" width="60" height="36" align-x="336" align-y="246" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f2f2f2" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
