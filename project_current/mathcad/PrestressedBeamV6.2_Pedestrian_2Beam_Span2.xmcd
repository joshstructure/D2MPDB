				<region region-id="26952" left="6" top="3950.25" width="519" height="362.25" align-x="6" align-y="3950.25" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f1f1f1" tag="">
					<plot disable-calc="false" item-idref="330"/>
				</region>
				<region region-id="29035" left="78" top="4319.25" width="101.25" height="15" align-x="142.5" align-y="4328.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:id xml:space="preserve">max</ml:id>
								<ml:id xml:space="preserve" subscript="truck.pos">M</ml:id>
							</ml:apply>
							<ml:unitOverride>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve">kip</ml:id>
									<ml:id xml:space="preserve">ft</ml:id>
								</ml:apply>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>0</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="foot"/>
										<unitReference unit="kip"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
