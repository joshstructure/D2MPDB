				<region region-id="146502" left="6" top="4293" width="329.25" height="11.25" align-x="6" align-y="4302" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Check acceptability of AASHTO distribution factors for interior beam shears</p>
					</text>
				</region>
				<region region-id="146503" left="366" top="4293" width="105.75" height="11.25" align-x="366" align-y="4302" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">LRFD Table 4.6.2.2.3a-1</p>
					</text>
				</region>
				<region region-id="150396" left="6" top="4329" width="548.25" height="273" align-x="100.5" align-y="4338" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffc6c6" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="shear.interior">fRange</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">idx</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:parens>
															<ml:apply>
																<ml:lessOrEqual/>
																<ml:apply>
																	<ml:lessOrEqual/>
																	<ml:apply>
																		<ml:mult/>
																		<ml:real>3.5</ml:real>
																		<ml:id xml:space="preserve">ft</ml:id>
																	</ml:apply>
																	<ml:id xml:space="preserve">S</ml:id>
																</ml:apply>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>16</ml:real>
																	<ml:id xml:space="preserve">ft</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
														<ml:parens>
															<ml:apply>
																<ml:lessOrEqual/>
																<ml:apply>
																	<ml:lessOrEqual/>
																	<ml:apply>
																		<ml:mult/>
																		<ml:real>4.5</ml:real>
																		<ml:id xml:space="preserve">in</ml:id>
																	</ml:apply>
																	<ml:id xml:space="preserve" subscript="s">t</ml:id>
																</ml:apply>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>12.0</ml:real>
																	<ml:id xml:space="preserve">in</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
													</ml:apply>
													<ml:parens>
														<ml:apply>
															<ml:lessOrEqual/>
															<ml:apply>
																<ml:lessOrEqual/>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>20</ml:real>
																	<ml:id xml:space="preserve">ft</ml:id>
																</ml:apply>
																<ml:id xml:space="preserve" subscript="s">L</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:mult/>
																<ml:real>240</ml:real>
																<ml:id xml:space="preserve">ft</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:parens>
												</ml:apply>
												<ml:parens>
													<ml:apply>
														<ml:greaterOrEqual/>
														<ml:id xml:space="preserve">#Beams</ml:id>
														<ml:real>4</ml:real>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:program>
												<ml:localDefine>
													<ml:id xml:space="preserve">chk</ml:id>
													<ml:str xml:space="preserve">OK</ml:str>
												</ml:localDefine>
												<ml:str xml:space="preserve"/>
											</ml:program>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:id xml:space="preserve">chk</ml:id>
												<ml:str xml:space="preserve">No Good</ml:str>
											</ml:localDefine>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:parens>
														<ml:apply>
															<ml:equal/>
															<ml:id xml:space="preserve" subscript="mom.interior">Range</ml:id>
															<ml:str xml:space="preserve">OK</ml:str>
														</ml:apply>
													</ml:parens>
													<ml:parens>
														<ml:apply>
															<ml:lessOrEqual/>
															<ml:apply>
																<ml:lessOrEqual/>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>5700</ml:real>
																	<ml:apply>
																		<ml:pow/>
																		<ml:id xml:space="preserve">in</ml:id>
																		<ml:real>4</ml:real>
																	</ml:apply>
																</ml:apply>
																<ml:id xml:space="preserve" subscript="dist">I</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:mult/>
																<ml:real>610000</ml:real>
																<ml:apply>
																	<ml:pow/>
																	<ml:id xml:space="preserve">in</ml:id>
																	<ml:real>4</ml:real>
																</ml:apply>
															</ml:apply>
														</ml:apply>
													</ml:parens>
												</ml:apply>
												<ml:parens>
													<ml:apply>
														<ml:lessOrEqual/>
														<ml:apply>
															<ml:lessOrEqual/>
															<ml:apply>
																<ml:mult/>
																<ml:real>25000</ml:real>
																<ml:apply>
																	<ml:pow/>
																	<ml:id xml:space="preserve">in</ml:id>
																	<ml:real>4</ml:real>
																</ml:apply>
															</ml:apply>
															<ml:id xml:space="preserve" subscript="dist">J</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:real>610000</ml:real>
															<ml:apply>
																<ml:pow/>
																<ml:id xml:space="preserve">in</ml:id>
																<ml:real>4</ml:real>
															</ml:apply>
														</ml:apply>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:program>
												<ml:localDefine>
													<ml:id xml:space="preserve">chk</ml:id>
													<ml:str xml:space="preserve">OK</ml:str>
												</ml:localDefine>
												<ml:str xml:space="preserve"/>
											</ml:program>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:id xml:space="preserve">chk</ml:id>
												<ml:str xml:space="preserve">No Good</ml:str>
											</ml:localDefine>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve" subscript="mom.interior">Range</ml:id>
												<ml:str xml:space="preserve">OK</ml:str>
											</ml:apply>
											<ml:program>
												<ml:localDefine>
													<ml:id xml:space="preserve">chk</ml:id>
													<ml:str xml:space="preserve">OK</ml:str>
												</ml:localDefine>
												<ml:str xml:space="preserve"/>
											</ml:program>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:id xml:space="preserve">chk</ml:id>
												<ml:str xml:space="preserve">No Good</ml:str>
											</ml:localDefine>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:id xml:space="preserve">chk</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="150475" left="66" top="4616.25" width="301.5" height="40.5" align-x="78" align-y="4626" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f2f2f2" tag="">
