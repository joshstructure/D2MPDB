				<region region-id="150291" left="360" top="1047" width="93.75" height="11.25" align-x="360" align-y="1056" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(LRFD 4.6.2.2.1-1)</p>
					</text>
				</region>
				<region region-id="150296" left="6" top="1053" width="312" height="12" align-x="14.25" align-y="1062" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<sp/>
							<b>LRFD Cross Section F</b>: Florida Slab Beams, Flat Slab Beams </p>
					</text>
				</region>
				<region region-id="150279" left="6" top="1095" width="549" height="177" align-x="49.5" align-y="1104" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffc6c6" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="g">f_e</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">cat</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">eg</ml:id>
									<ml:apply>
										<ml:mult/>
										<ml:real>0</ml:real>
										<ml:id xml:space="preserve">ft</ml:id>
									</ml:apply>
								</ml:localDefine>
								<ml:ifThen>
									<ml:apply>
										<ml:plus/>
										<ml:parens>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">cat</ml:id>
												<ml:str xml:space="preserve">I-Beam</ml:str>
											</ml:apply>
										</ml:parens>
										<ml:parens>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">cat</ml:id>
												<ml:str xml:space="preserve">InvTBeams</ml:str>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">eg</ml:id>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:mult/>
															<ml:id xml:space="preserve" subscript="e">b</ml:id>
															<ml:id xml:space="preserve" subscript="deck">t</ml:id>
														</ml:apply>
														<ml:parens>
															<ml:apply>
																<ml:plus/>
																<ml:apply>
																	<ml:div/>
																	<ml:id xml:space="preserve" subscript="deck">t</ml:id>
																	<ml:real>2</ml:real>
																</ml:apply>
																<ml:id xml:space="preserve" subscript="buildup">h</ml:id>
															</ml:apply>
														</ml:parens>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:div/>
															<ml:apply>
																<ml:pow/>
																<ml:id xml:space="preserve" subscript="buildup">h</ml:id>
																<ml:real>2</ml:real>
															</ml:apply>
															<ml:real>2</ml:real>
														</ml:apply>
														<ml:id xml:space="preserve" subscript="flange">Width</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve" subscript="e">b</ml:id>
														<ml:id xml:space="preserve" subscript="deck">t</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve" subscript="buildup">h</ml:id>
														<ml:id xml:space="preserve" subscript="flange">Width</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:apply>
											<ml:id xml:space="preserve" subscript="beam.centroid">d</ml:id>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">cat</ml:id>
										<ml:str xml:space="preserve">DblTBeams</ml:str>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">eg</ml:id>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve" subscript="deck">t</ml:id>
												<ml:real>2</ml:real>
											</ml:apply>
											<ml:id xml:space="preserve" subscript="beam.centroid">d</ml:id>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">cat</ml:id>
										<ml:str xml:space="preserve">FUB</ml:str>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">eg</ml:id>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:mult/>
															<ml:id xml:space="preserve" subscript="e">b</ml:id>
															<ml:id xml:space="preserve" subscript="deck">t</ml:id>
														</ml:apply>
														<ml:parens>
															<ml:apply>
																<ml:plus/>
																<ml:apply>
																	<ml:div/>
																	<ml:id xml:space="preserve" subscript="deck">t</ml:id>
																	<ml:real>2</ml:real>
																</ml:apply>
																<ml:id xml:space="preserve" subscript="buildup">h</ml:id>
															</ml:apply>
														</ml:parens>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:div/>
															<ml:apply>
																<ml:pow/>
																<ml:id xml:space="preserve" subscript="buildup">h</ml:id>
																<ml:real>2</ml:real>
															</ml:apply>
															<ml:real>2</ml:real>
														</ml:apply>
														<ml:id xml:space="preserve" subscript="flange">Width</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve" subscript="e">b</ml:id>
														<ml:id xml:space="preserve" subscript="deck">t</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve" subscript="buildup">h</ml:id>
														<ml:id xml:space="preserve" subscript="flange">Width</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">BeamProps</ml:id>
													<ml:real>6</ml:real>
												</ml:apply>
												<ml:id xml:space="preserve">in</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:id xml:space="preserve">eg</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="150284" left="6" top="1299" width="144.75" height="15" align-x="21" align-y="1308" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="g">e</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve" subscript="g">f_e</ml:id>
									<ml:id xml:space="preserve">BeamCategory</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>23.197495000859892</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch"/>
										</unitMonomial>
