				<region region-id="147410" left="6" top="183" width="519" height="22.5" align-x="23.25" align-y="192" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">location for principal stress check: at the neutral axis of the composite section or at the web-top flange intersection where the neutral axis is located in the top flange</p>
					</text>
				</region>
				<region region-id="147411" left="6" top="219" width="146.25" height="15" align-x="30" align-y="228" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="web">y</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">min</ml:id>
									<ml:sequence>
										<ml:id xml:space="preserve" subscript="comp">y</ml:id>
										<ml:apply>
											<ml:neg/>
											<ml:id xml:space="preserve" subscript="jct">d</ml:id>
										</ml:apply>
									</ml:sequence>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>-11.384274618203245</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="147412" left="6" top="249" width="469.5" height="11.25" align-x="20.25" align-y="258" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Section properties function for area and centroid of the area above the location where principal stress is checked </p>
					</text>
				</region>
				<region region-id="147413" left="6" top="273" width="270" height="273" align-x="89.25" align-y="282" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">PropWebCheck</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">q</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">nr</ml:id>
									<ml:apply>
										<ml:id xml:space="preserve">rows</ml:id>
										<ml:id xml:space="preserve">q</ml:id>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">s</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">m1</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">a</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:parens>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve">nr</ml:id>
												<ml:real>2</ml:real>
											</ml:apply>
										</ml:parens>
									</ml:range>
									<ml:program>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">q</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">i</ml:id>
													<ml:real>1</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:apply>
												<ml:id xml:space="preserve">max</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">q</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">i</ml:id>
															<ml:real>1</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:div/>
														<ml:id xml:space="preserve" subscript="web">y</ml:id>
														<ml:id xml:space="preserve">in</ml:id>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">q</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve">i</ml:id>
														<ml:real>1</ml:real>
													</ml:apply>
													<ml:real>1</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:apply>
												<ml:id xml:space="preserve">max</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">q</ml:id>
														<ml:sequence>
															<ml:apply>
																<ml:plus/>
																<ml:id xml:space="preserve">i</ml:id>
																<ml:real>1</ml:real>
															</ml:apply>
															<ml:real>1</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:div/>
														<ml:id xml:space="preserve" subscript="web">y</ml:id>
														<ml:id xml:space="preserve">in</ml:id>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve">s</ml:id>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">q</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">i</ml:id>
																<ml:real>0</ml:real>
															</ml:sequence>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">q</ml:id>
															<ml:sequence>
																<ml:apply>
																	<ml:plus/>
																	<ml:id xml:space="preserve">i</ml:id>
																	<ml:real>1</ml:real>
																</ml:apply>
																<ml:real>1</ml:real>
															</ml:sequence>
														</ml:apply>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">q</ml:id>
															<ml:sequence>
																<ml:apply>
																	<ml:plus/>
																	<ml:id xml:space="preserve">i</ml:id>
																	<ml:real>1</ml:real>
																</ml:apply>
																<ml:real>0</ml:real>
															</ml:sequence>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">q</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">i</ml:id>
																<ml:real>1</ml:real>
															</ml:sequence>
														</ml:apply>
													</ml:apply>
												</ml:apply>
												<ml:real>2</ml:real>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve">m1</ml:id>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve">m1</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:id xml:space="preserve">s</ml:id>
													<ml:apply>
														<ml:div/>
														<ml:apply>
															<ml:plus/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">q</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">i</ml:id>
																	<ml:real>1</ml:real>
																</ml:sequence>
															</ml:apply>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">q</ml:id>
																<ml:sequence>
																	<ml:apply>
																		<ml:plus/>
																		<ml:id xml:space="preserve">i</ml:id>
																		<ml:real>1</ml:real>
																	</ml:apply>
																	<ml:real>1</ml:real>
																</ml:sequence>
															</ml:apply>
														</ml:apply>
														<ml:real>3</ml:real>
													</ml:apply>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve">a</ml:id>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve">a</ml:id>
												<ml:id xml:space="preserve">s</ml:id>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:for>
								<ml:apply>
									<ml:transpose/>
									<ml:matrix rows="1" cols="2">
										<ml:apply>
											<ml:neg/>
											<ml:id xml:space="preserve">a</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve">m1</ml:id>
											<ml:id xml:space="preserve">a</ml:id>
										</ml:apply>
									</ml:matrix>
								</ml:apply>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="147414" left="6" top="564" width="177.75" height="30" align-x="57.75" align-y="582" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">WebCheck</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">PropWebCheck</ml:id>
								<ml:apply>
									<ml:div/>
									<ml:id xml:space="preserve" subscript="beam">Coord</ml:id>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="147415" left="6" top="615" width="273.75" height="11.25" align-x="15" align-y="624" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Area of beam above the location where principal stress is checked<sp count="2"/>
						</p>
					</text>
				</region>
				<region region-id="147416" left="6" top="633" width="179.25" height="24" align-x="60.75" align-y="648" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="webcheck">Area</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">WebCheck</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve">in</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:apply>
								<ml:unitOverride>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve">in</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>271.43992232742266</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch" power-numerator="2"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="147418" left="6" top="675" width="337.5" height="11.25" align-x="15" align-y="684" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Centroid of the Area of beam above the location where principal stress is checked<sp count="2"/>
						</p>
					</text>
				</region>
				<region region-id="147419" left="6" top="705" width="157.5" height="18" align-x="51.75" align-y="714" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="c.webcheck">y</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">WebCheck</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>-3.4147432653179708</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="147421" left="6" top="735" width="398.25" height="22.5" align-x="6" align-y="744" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">the first moment of area about the neutral axis of gross concrete area above or below the height of the web where the principal tension is being checked </p>
					</text>
				</region>
				<region region-id="147422" left="6" top="765" width="202.5" height="24.75" align-x="32.25" align-y="780" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="g.nc">Q</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve" subscript="webcheck">Area</ml:id>
									<ml:apply>
										<ml:absval/>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve" subscript="c.webcheck">y</ml:id>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="c">y</ml:id>
												<ml:real>0</ml:real>
											</ml:apply>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<ml:unitOverride>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve">in</ml:id>
										<ml:real>3</ml:real>
									</ml:apply>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>4368.9905551355077</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch" power-numerator="3"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
