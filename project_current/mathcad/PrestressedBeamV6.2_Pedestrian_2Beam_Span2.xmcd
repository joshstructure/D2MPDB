					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">#Beams</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:real>2</ml:real>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="178519" left="6" top="6404.25" width="198" height="27.75" align-x="51.75" align-y="6420" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="live.service">g</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:id xml:space="preserve">PedMode</ml:id>
										<ml:real>1</ml:real>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:mult/>
												<ml:id xml:space="preserve">#Lanes</ml:id>
												<ml:id xml:space="preserve">mpf</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve">#Beams</ml:id>
										</ml:apply>
									</ml:sequence>
								</ml:apply>
