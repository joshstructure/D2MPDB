															<ml:apply>
																<ml:minus/>
																<ml:id xml:space="preserve">lgth</ml:id>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>2</ml:real>
																	<ml:id xml:space="preserve">bd</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:apply>
