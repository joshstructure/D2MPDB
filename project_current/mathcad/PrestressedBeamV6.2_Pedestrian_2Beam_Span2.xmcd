											<ml:real>3</ml:real>
										</ml:sequence>
									</ml:apply>
								</ml:localDefine>
								<ml:ifThen>
									<ml:apply>
										<ml:plus split="true"/>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:plus/>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:plus/>
														<ml:parens>
															<ml:apply>
																<ml:equal/>
																<ml:id xml:space="preserve">a</ml:id>
																<ml:str xml:space="preserve">II</ml:str>
															</ml:apply>
														</ml:parens>
														<ml:parens>
															<ml:apply>
																<ml:equal/>
																<ml:id xml:space="preserve">a</ml:id>
																<ml:str xml:space="preserve">III</ml:str>
															</ml:apply>
														</ml:parens>
													</ml:apply>
													<ml:parens>
														<ml:apply>
															<ml:equal/>
															<ml:id xml:space="preserve">a</ml:id>
															<ml:str xml:space="preserve">IV</ml:str>
														</ml:apply>
													</ml:parens>
												</ml:apply>
												<ml:parens>
													<ml:apply>
														<ml:equal/>
														<ml:id xml:space="preserve">a</ml:id>
														<ml:str xml:space="preserve">V</ml:str>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">a</ml:id>
													<ml:str xml:space="preserve">VI</ml:str>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:plus/>
												<ml:apply>
													<ml:plus/>
													<ml:parens>
														<ml:apply>
															<ml:equal/>
															<ml:id xml:space="preserve">a</ml:id>
															<ml:str xml:space="preserve">FBT72</ml:str>
														</ml:apply>
													</ml:parens>
													<ml:parens>
														<ml:apply>
															<ml:equal/>
															<ml:id xml:space="preserve">a</ml:id>
															<ml:str xml:space="preserve">FBT78</ml:str>
														</ml:apply>
													</ml:parens>
												</ml:apply>
												<ml:parens>
													<ml:apply>
														<ml:equal/>
														<ml:id xml:space="preserve">b</ml:id>
														<ml:str xml:space="preserve">FUB</ml:str>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">b</ml:id>
													<ml:str xml:space="preserve">FIB</ml:str>
												</ml:apply>
											</ml:parens>
										</ml:apply>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">R1</ml:id>
										<ml:apply>
											<ml:mult style="auto-select"/>
											<ml:real>0.045</ml:real>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve" subscript="span">L</ml:id>
												<ml:id xml:space="preserve">ft</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:or/>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">b</ml:id>
											<ml:str xml:space="preserve">FLT</ml:str>
										</ml:apply>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">b</ml:id>
											<ml:str xml:space="preserve">FSB</ml:str>
										</ml:apply>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">R1</ml:id>
										<ml:apply>
											<ml:id xml:space="preserve">if</ml:id>
											<ml:sequence>
												<ml:apply>
													<ml:greaterOrEqual/>
													<ml:apply>
														<ml:mult style="auto-select"/>
														<ml:real>0.03</ml:real>
														<ml:apply>
															<ml:div/>
															<ml:id xml:space="preserve" subscript="span">L</ml:id>
															<ml:id xml:space="preserve">ft</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:apply>
														<ml:div/>
														<ml:real>6.5</ml:real>
														<ml:real>12</ml:real>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:mult style="auto-select"/>
													<ml:real>0.03</ml:real>
													<ml:apply>
														<ml:div/>
														<ml:id xml:space="preserve" subscript="span">L</ml:id>
														<ml:id xml:space="preserve">ft</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:div/>
													<ml:real>6.5</ml:real>
													<ml:real>12</ml:real>
												</ml:apply>
											</ml:sequence>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:otherwise>
