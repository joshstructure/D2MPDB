				<region region-id="147216" left="6" top="7913.25" width="330" height="15" align-x="109.5" align-y="7922.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="StrengthII">CheckLongReinf</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:lessThan/>
										<ml:apply>
											<ml:id xml:space="preserve">max</ml:id>
											<ml:id xml:space="preserve" subscript="LongReinf">DC</ml:id>
										</ml:apply>
										<ml:real>1</ml:real>
									</ml:apply>
									<ml:str xml:space="preserve">OK</ml:str>
									<ml:str xml:space="preserve">no good, add reinf.</ml:str>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="147217" left="342" top="7913.25" width="139.5" height="15" align-x="444" align-y="7922.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="StrengthII">CheckLongReinf</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:str xml:space="preserve">OK</ml:str>
							</result>
						</ml:eval>
					</math>
