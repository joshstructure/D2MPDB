				<region region-id="181519" left="6" top="2145" width="483" height="183" align-x="159" align-y="2154" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffd5d5" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">fCheckDCLong</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">Title</ml:id>
									<ml:id xml:space="preserve">Vreqd</ml:id>
									<ml:id xml:space="preserve">Vprov</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">ratio</ml:id>
									<ml:real>.01</ml:real>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:id xml:space="preserve">last</ml:id>
											<ml:id xml:space="preserve">Vprov</ml:id>
										</ml:apply>
									</ml:range>
									<ml:ifThen>
										<ml:apply>
											<ml:greaterThan/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Vreqd</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Vprov</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:id xml:space="preserve">ratio</ml:id>
										</ml:apply>
										<ml:program>
											<ml:localDefine>
												<ml:id xml:space="preserve">index</ml:id>
												<ml:id xml:space="preserve">i</ml:id>
											</ml:localDefine>
											<ml:localDefine>
												<ml:id xml:space="preserve">ratio</ml:id>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">Vreqd</ml:id>
														<ml:id xml:space="preserve">i</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">Vprov</ml:id>
														<ml:id xml:space="preserve">i</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:localDefine>
										</ml:program>
									</ml:ifThen>
								</ml:for>
								<ml:matrix rows="2" cols="4">
									<ml:str xml:space="preserve">CheckType</ml:str>
									<ml:id xml:space="preserve">Title</ml:id>
									<ml:str xml:space="preserve">Location(ft)</ml:str>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">Location</ml:id>
											<ml:id xml:space="preserve">index</ml:id>
										</ml:apply>
										<ml:id xml:space="preserve">ft</ml:id>
									</ml:apply>
									<ml:str xml:space="preserve">V long Req'd (kip)</ml:str>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">Vreqd</ml:id>
											<ml:id xml:space="preserve">index</ml:id>
										</ml:apply>
										<ml:id xml:space="preserve">kip</ml:id>
									</ml:apply>
									<ml:str xml:space="preserve">V long Prov (kip)</ml:str>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">Vprov</ml:id>
											<ml:id xml:space="preserve">index</ml:id>
										</ml:apply>
										<ml:id xml:space="preserve">kip</ml:id>
