																<ml:id xml:space="preserve">loc</ml:id>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">trans</ml:id>
																	<ml:real>0</ml:real>
																</ml:apply>
															</ml:apply>
														</ml:parens>
														<ml:parens>
															<ml:apply>
																<ml:lessThan/>
																<ml:id xml:space="preserve">loc</ml:id>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">trans</ml:id>
																	<ml:real>1</ml:real>
																</ml:apply>
															</ml:apply>
														</ml:parens>
													</ml:apply>
													<ml:apply>
														<ml:div/>
														<ml:apply>
															<ml:minus/>
															<ml:id xml:space="preserve">loc</ml:id>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">trans</ml:id>
																<ml:real>0</ml:real>
															</ml:apply>
														</ml:apply>
														<ml:apply>
															<ml:minus/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">trans</ml:id>
																<ml:real>1</ml:real>
															</ml:apply>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">trans</ml:id>
																<ml:real>0</ml:real>
															</ml:apply>
														</ml:apply>
													</ml:apply>
												</ml:ifThen>
