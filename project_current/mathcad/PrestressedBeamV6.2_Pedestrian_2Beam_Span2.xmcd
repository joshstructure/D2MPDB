														<ml:id xml:space="preserve">#Beams</ml:id>
														<ml:real>1</ml:real>
													</ml:apply>
												</ml:parens>
												<ml:id xml:space="preserve">BeamSpacing</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:real>2</ml:real>
												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve" subscript="e">d</ml:id>
														<ml:apply>
															<ml:mult style="auto-select"/>
															<ml:real>45</ml:real>
															<ml:id xml:space="preserve">in</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:parens>
											</ml:apply>
