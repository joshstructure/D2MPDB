							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="lane.pos">M</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:real>0.64</ml:real>
												<ml:apply>
													<ml:div/>
													<ml:id xml:space="preserve">kip</ml:id>
													<ml:id xml:space="preserve">ft</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">a</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:id xml:space="preserve">ft</ml:id>
									</ml:apply>
									<ml:real>2</ml:real>
								</ml:apply>
								<ml:parens>
									<ml:apply>
										<ml:minus/>
										<ml:id xml:space="preserve" subscript="c.c.bearings">L</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">a</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve">ft</ml:id>
										</ml:apply>
