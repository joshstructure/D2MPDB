		<region region-id="202207" left="408" top="12075.75" width="102.75" height="15" align-x="473.25" align-y="12084.75" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="max.web">Check_f</ml:id>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<ml:str xml:space="preserve">OK</ml:str>
					</result>
				</ml:eval>
			</math>
			<rendering item-idref="712"/>
		</region>
		<region region-id="202646" left="6" top="12099.75" width="527.25" height="33.75" align-x="15.75" align-y="12108.75" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Note: The check for pricipal tensile stresses in webs is only required for pretensioned girders with a compressive strength of concrete for use in design greater than 10 ksi per AASHTO BDS Article 5.9.2.3.3. The check is displayed for all concrete strengths for consideration when optimizing the strands design.</p>
			</text>
		</region>
		<region region-id="200895" left="6" top="12145.5" width="213.75" height="14.25" align-x="6" align-y="12156.75" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="heading" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Splitting Reinforcement: </p>
			</text>
		</region>
		<region region-id="186819" left="6" top="12165.75" width="498" height="11.25" align-x="15" align-y="12174.75" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">FDOT Splitting Rein Demand/Capacity Ratio and Check for FDOT Standard Beam End Reinforcement</p>
			</text>
		</region>
		<region region-id="201427" left="6" top="12189.75" width="80.25" height="15" align-x="45.75" align-y="12198.75" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="r.standard">P</ml:id>
					<ml:unitOverride>
						<ml:id xml:space="preserve">kip</ml:id>
					</ml:unitOverride>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<unitedValue>
							<ml:real>1450</ml:real>
							<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
								<unitReference unit="kip"/>
							</unitMonomial>
						</unitedValue>
					</result>
				</ml:eval>
			</math>
			<rendering item-idref="713"/>
		</region>
		<region region-id="201428" left="108" top="12189.75" width="76.5" height="15" align-x="144" align-y="12198.75" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
