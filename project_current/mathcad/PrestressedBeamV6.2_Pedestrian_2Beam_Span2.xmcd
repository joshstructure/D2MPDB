							<ml:id xml:space="preserve" subscript="A1">StirrupSpacing</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:id xml:space="preserve">str2num</ml:id>
										<ml:id xml:space="preserve" subscript="A1">inpStirrupSpacing</ml:id>
