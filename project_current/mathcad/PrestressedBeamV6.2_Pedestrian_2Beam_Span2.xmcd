										<ml:apply>
											<ml:absval/>
											<ml:id xml:space="preserve">dif</ml:id>
										</ml:apply>
										<ml:real>.75</ml:real>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
