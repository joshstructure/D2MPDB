				<region region-id="177541" left="6" top="2679" width="423.75" height="59.25" align-x="37.5" align-y="2688" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="d.long">L</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:program>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">MildReinfType</ml:id>
											<ml:str xml:space="preserve">Carbon Steel</ml:str>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">Bar</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">BarSizeBottom</ml:id>
													<ml:real>3</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:id xml:space="preserve">in</ml:id>
										</ml:apply>
