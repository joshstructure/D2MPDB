				</region>
				<region region-id="202698" left="6" top="4281" width="285.75" height="128.25" align-x="60.75" align-y="4290" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="s.split.LRFD">A</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve" subscript="s.split">A</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:while>
									<ml:apply>
										<ml:lessOrEqual/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">StirrrupLocation&amp;Area</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">j</ml:id>
													<ml:real>0</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:id xml:space="preserve">ft</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve" subscript="beam">h</ml:id>
											<ml:real>4</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:program>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="s.split">A</ml:id>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve" subscript="s.split">A</ml:id>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">StirrrupLocation&amp;Area</ml:id>
													<ml:sequence>
														<ml:id xml:space="preserve">j</ml:id>
														<ml:real font="0">1</ml:real>
													</ml:sequence>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve">j</ml:id>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve">j</ml:id>
												<ml:real>1</ml:real>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:while>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve" subscript="s.split">A</ml:id>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve">in</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:apply>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="201230" left="6" top="4419" width="91.5" height="21" align-x="59.25" align-y="4434" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
