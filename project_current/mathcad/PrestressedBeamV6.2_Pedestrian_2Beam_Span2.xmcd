										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">MildReinfType</ml:id>
											<ml:str xml:space="preserve">Stainless Steel</ml:str>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="SS">Bar</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">BarSizeBottom</ml:id>
													<ml:real>3</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:id xml:space="preserve">in</ml:id>
										</ml:apply>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">MildReinfType</ml:id>
											<ml:str xml:space="preserve">Glass Fiber Reinforced Polymer</ml:str>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve" subscript="d.GFRP">fL</ml:id>
											<ml:id xml:space="preserve">BarSizeBottom</ml:id>
										</ml:apply>
									</ml:ifThen>
								</ml:program>
								<ml:unitOverride>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>12.347898130260635</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
