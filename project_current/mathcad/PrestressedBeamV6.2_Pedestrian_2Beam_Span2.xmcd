										<ml:apply>
											<ml:mult style="auto-select"/>
											<ml:real>0.045</ml:real>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve" subscript="span">L</ml:id>
												<ml:id xml:space="preserve">ft</ml:id>
											</ml:apply>
										</ml:apply>
