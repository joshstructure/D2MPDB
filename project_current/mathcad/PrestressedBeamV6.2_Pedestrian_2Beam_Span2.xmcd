				<region region-id="30522" left="6" top="7479" width="491.25" height="78.75" align-x="6" align-y="7488" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">The results are<sp count="2"/>contained in a matrix with each row associated with the same numbered section and the columns containing the following data:<sp count="2"/>
							<tab/>Column 0 ---<sp count="2"/>the maximum positive moment</p>
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<tab/>
							<tab/>Column 1 --- the maximum negative moment (if any depending on the Bearing Distance)</p>
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<tab/>
							<tab/>Column 2 --- maximum positive shear</p>
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<tab/>
							<tab/>Column 3 --- moment associated with the maximum positive shear</p>
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<tab/>
							<tab/>Column 4 --- maximum negative shear</p>
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<tab/>
							<tab/>Column 5 --- moment associated with the maximum negative shear</p>
					</text>
				</region>
