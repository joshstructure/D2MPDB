		</region>
		<region region-id="152555" left="6" top="19206" width="331.5" height="78.75" align-x="78.75" align-y="19248" show-border="true" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">ServiceMoments</ml:id>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<ml:matrix rows="5" cols="2">
							<ml:str xml:space="preserve">Load Type </ml:str>
							<ml:str xml:space="preserve">Release Dead Load</ml:str>
							<ml:str xml:space="preserve">Non-Composite DL (incl. beam wt.)</ml:str>
							<ml:str xml:space="preserve">Composite Dead Load</ml:str>
							<ml:str xml:space="preserve">Distributed Live Load</ml:str>
							<ml:str xml:space="preserve">Moment (kip*ft)</ml:str>
							<ml:real>1156.8563667558581</ml:real>
							<ml:real>1938.7293553410273</ml:real>
							<ml:real>563.02452499999993</ml:real>
							<ml:real>724.008675</ml:real>
						</ml:matrix>
					</result>
				</ml:eval>
				<resultFormat numeric-only="true">
					<general precision="0" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="5"/>
					<matrix display-style="auto" expand-nested-arrays="false"/>
					<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
				</resultFormat>
			</math>
			<rendering item-idref="701"/>
		</region>
		<region region-id="82860" left="6" top="19293" width="522.75" height="11.25" align-x="6" align-y="19302" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Stage 1 ---&gt;<sp count="2"/>At release with span length equal to length of the beam. Prestress losses are elastic shortening and overnight relax</p>
			</text>
		</region>
		<region region-id="136774" left="6" top="19311" width="480.75" height="11.25" align-x="6" align-y="19320" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Stage 2 ---&gt;<sp count="2"/>At final, starting with Stage 1 and adding the remaining prestress losses applied to the transformed beam</p>
			</text>
		</region>
		<region region-id="136778" left="6" top="19329" width="512.25" height="11.25" align-x="6" align-y="19338" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Stage 4 ---&gt; Starting with Stage 2 and changing the support locations from the end of the beam to the bearing locations </p>
			</text>
		</region>
		<region region-id="136781" left="6" top="19347" width="471.75" height="11.25" align-x="6" align-y="19356" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Stage 6 ---&gt; Starting with Stage 4 and adding non-composite dead load (excluding beam wt included in Stage 1) </p>
			</text>
		</region>
		<region region-id="137619" left="6" top="19365" width="516" height="11.25" align-x="6" align-y="19374" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Stage 8 ---&gt; Starting with Stage 6 and adding composite dead load and distributed live loads applied to the composite section</p>
			</text>
		</region>
		<region region-id="202054" left="0" top="19392" width="6008.25" align-x="0" align-y="19392" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#c0c0c0" tag="" height="7976.25">
			<area is-collapsed="true" name="   Camber at Release, Short Term Camber, &amp; Summary of Slope Data" show-name="true" show-border="true" show-icon="true" show-timestamp="true" allow-expand="true" is-locked="false" timestamp="" top-lock-id="30929" bottom-lock-id="141416">
				<region region-id="147075" left="6" top="24.75" width="272.25" height="14.25" align-x="6" align-y="36" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="heading" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Camber at Release, Final, and Dead Load </p>
					</text>
				</region>
				<region region-id="29799" left="6" top="57" width="482.25" height="22.5" align-x="6" align-y="66" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Camber at release is estimated by calculating the curvature at the 100 plus points along the beam, curve fitting this data to a 4th order polynomial, and integrating twice to get the deflection.</p>
					</text>
				</region>
				<region region-id="180839" left="6" top="93" width="35.25" height="12.75" align-x="28.5" align-y="102" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">eqd</ml:id>
							<ml:real>4</ml:real>
						</ml:define>
					</math>
				</region>
				<region region-id="180840" left="66" top="93" width="174.75" height="11.25" align-x="66" align-y="102" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">degree of polynomial used for curve fit</p>
					</text>
				</region>
				<region region-id="181029" left="6" top="123" width="81.75" height="11.25" align-x="6" align-y="132" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Camber at Release</p>
					</text>
				</region>
				<region region-id="147076" left="6" top="152.25" width="213.75" height="45.75" align-x="37.5" align-y="174" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="rel">κ</ml:id>
								<ml:sequence>
									<ml:real>0</ml:real>
									<ml:id xml:space="preserve">n</ml:id>
								</ml:sequence>
							</ml:apply>
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:plus/>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="tr">A</ml:id>
											<ml:sequence>
												<ml:real>0</ml:real>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:sequence>
										</ml:apply>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="prestress.rel">M</ml:id>
											<ml:id xml:space="preserve">n</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="tr">B</ml:id>
											<ml:sequence>
												<ml:real>0</ml:real>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:sequence>
										</ml:apply>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="prestress.rel">N</ml:id>
											<ml:id xml:space="preserve">n</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve" subscript="ci">E</ml:id>
									<ml:parens>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="tr">A</ml:id>
													<ml:sequence>
														<ml:real>0</ml:real>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:sequence>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="tr">I</ml:id>
													<ml:sequence>
														<ml:real>0</ml:real>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:sequence>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:pow/>
												<ml:parens>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="tr">B</ml:id>
														<ml:sequence>
															<ml:real>0</ml:real>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:sequence>
													</ml:apply>
												</ml:parens>
												<ml:real>2</ml:real>
											</ml:apply>
										</ml:apply>
									</ml:parens>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="180979" left="6" top="219" width="83.25" height="18.75" align-x="56.25" align-y="228" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#80ffff" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="release">M/EI</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="rel">κ</ml:id>
								<ml:sequence>
									<ml:real>0</ml:real>
									<ml:id xml:space="preserve">n</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="180832" left="6" top="267" width="222" height="177.75" align-x="92.25" align-y="276" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">fConstants</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">x</ml:id>
									<ml:id xml:space="preserve">y</ml:id>
									<ml:id xml:space="preserve">ef</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">N</ml:id>
									<ml:apply>
										<ml:id xml:space="preserve">length</ml:id>
										<ml:id xml:space="preserve">x</ml:id>
									</ml:apply>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:range>
										<ml:real>2</ml:real>
										<ml:id xml:space="preserve">ef</ml:id>
									</ml:range>
									<ml:program>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">q</ml:id>
												<ml:id xml:space="preserve">j</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:vectorize/>
												<ml:apply>
													<ml:pow/>
													<ml:id xml:space="preserve">x</ml:id>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:apply>
												<ml:matcol/>
												<ml:id xml:space="preserve">X</ml:id>
												<ml:id xml:space="preserve">j</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">q</ml:id>
												<ml:id xml:space="preserve">j</ml:id>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:for>
								<ml:localDefine>
									<ml:apply>
										<ml:matcol/>
										<ml:id xml:space="preserve">X</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
									<ml:id xml:space="preserve">x</ml:id>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve">N</ml:id>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:range>
									<ml:localDefine>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">X</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">i</ml:id>
												<ml:real>0</ml:real>
											</ml:sequence>
										</ml:apply>
										<ml:real>1</ml:real>
									</ml:localDefine>
								</ml:for>
								<ml:localDefine>
									<ml:id xml:space="preserve">b</ml:id>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:pow/>
											<ml:parens>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:transpose/>
														<ml:id xml:space="preserve">X</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve">X</ml:id>
												</ml:apply>
											</ml:parens>
											<ml:real>-1</ml:real>
										</ml:apply>
										<ml:parens>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:transpose/>
													<ml:id xml:space="preserve">X</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve">y</ml:id>
											</ml:apply>
										</ml:parens>
									</ml:apply>
								</ml:localDefine>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="180833" left="6" top="464.25" width="225" height="27.75" align-x="48.75" align-y="480" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#80ffff" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="rel">Consts</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">fConstants</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve">Location</ml:id>
										<ml:id xml:space="preserve">ft</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:id xml:space="preserve" subscript="release">M/EI</ml:id>
										<ml:id xml:space="preserve">ft</ml:id>
									</ml:apply>
									<ml:id xml:space="preserve">eqd</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="180981" left="324" top="423" width="120.75" height="108.75" align-x="365.25" align-y="480" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="rel">Consts</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="5" cols="1">
									<ml:real>-0.00013325567001507693</ml:real>
									<ml:real>-2.8663618845970948E-05</ml:real>
									<ml:real>1.0398494731625897E-06</ml:real>
									<ml:real>-1.4615870194370353E-08</ml:real>
									<ml:real>6.9665730192404311E-11</ml:real>
								</ml:matrix>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="181016" left="6" top="549" width="392.25" height="11.25" align-x="25.5" align-y="558" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Curvature function takes the form of the equation shown below. Slope and deflection are similar.</p>
					</text>
				</region>
				<region region-id="181018" left="6" top="567" width="453.75" height="39" align-x="74.25" align-y="594" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:equal/>
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="release">Curvature</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:plus/>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">C</ml:id>
													<ml:real>0</ml:real>
												</ml:apply>
												<ml:id xml:space="preserve">ft</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">C</ml:id>
														<ml:real>1</ml:real>
													</ml:apply>
													<ml:id xml:space="preserve">ft</ml:id>
												</ml:apply>
												<ml:parens>
													<ml:apply>
														<ml:div/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Location</ml:id>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:apply>
														<ml:id xml:space="preserve">ft</ml:id>
													</ml:apply>
												</ml:parens>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">C</ml:id>
													<ml:real>2</ml:real>
												</ml:apply>
												<ml:id xml:space="preserve">ft</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:pow/>
												<ml:parens>
													<ml:apply>
														<ml:div/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Location</ml:id>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:apply>
														<ml:id xml:space="preserve">ft</ml:id>
													</ml:apply>
												</ml:parens>
												<ml:real font="0">2</ml:real>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">C</ml:id>
												<ml:real>3</ml:real>
											</ml:apply>
											<ml:id xml:space="preserve">ft</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:pow/>
											<ml:parens>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">Location</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve">ft</ml:id>
												</ml:apply>
											</ml:parens>
											<ml:real font="0">3</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">C</ml:id>
											<ml:real>4</ml:real>
										</ml:apply>
										<ml:id xml:space="preserve">ft</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:pow/>
										<ml:parens>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Location</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve">ft</ml:id>
											</ml:apply>
										</ml:parens>
										<ml:real font="0">4</ml:real>
									</ml:apply>
								</ml:apply>
							</ml:apply>
						</ml:apply>
					</math>
				</region>
				<region region-id="180868" left="6" top="645" width="320.25" height="97.5" align-x="103.5" align-y="654" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">fCurvature</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">constants</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">n</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:id xml:space="preserve">last</ml:id>
											<ml:id xml:space="preserve">Location</ml:id>
										</ml:apply>
									</ml:range>
									<ml:for>
										<ml:id xml:space="preserve">j</ml:id>
										<ml:range>
											<ml:real>0</ml:real>
											<ml:id xml:space="preserve">eqd</ml:id>
										</ml:range>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">curve</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:summation/>
												<ml:lambda>
													<ml:boundVars>
														<ml:id xml:space="preserve">j</ml:id>
													</ml:boundVars>
													<ml:parens>
														<ml:apply>
															<ml:mult/>
															<ml:apply>
																<ml:div/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">constants</ml:id>
																	<ml:id xml:space="preserve">j</ml:id>
																</ml:apply>
																<ml:id xml:space="preserve">ft</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:pow/>
																<ml:parens>
																	<ml:apply>
																		<ml:div/>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve">Location</ml:id>
																			<ml:id xml:space="preserve">n</ml:id>
																		</ml:apply>
																		<ml:id xml:space="preserve">ft</ml:id>
																	</ml:apply>
																</ml:parens>
																<ml:id xml:space="preserve">j</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:parens>
												</ml:lambda>
												<ml:bounds>
													<ml:real>0</ml:real>
													<ml:id xml:space="preserve">eqd</ml:id>
												</ml:bounds>
											</ml:apply>
										</ml:localDefine>
									</ml:for>
								</ml:for>
								<ml:id xml:space="preserve">curve</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="180870" left="6" top="771" width="149.25" height="15" align-x="60" align-y="780" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="rel">Curvature</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">fCurvature</ml:id>
								<ml:id xml:space="preserve" subscript="rel">Consts</ml:id>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="33638" left="6" top="798" width="525" height="165" align-x="6" align-y="798" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f1f1f1" tag="">
					<plot disable-calc="false" item-idref="702"/>
				</region>
				<region region-id="180842" left="6" top="993" width="228" height="60" align-x="74.25" align-y="1032" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#80ffff" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">fC1</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">constants</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:mult/>
								<ml:real>-1</ml:real>
								<ml:apply>
									<ml:summation/>
									<ml:lambda>
										<ml:boundVars>
											<ml:id xml:space="preserve">j</ml:id>
										</ml:boundVars>
										<ml:parens>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">constants</ml:id>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:pow/>
														<ml:parens>
															<ml:apply>
																<ml:div/>
																<ml:id xml:space="preserve" subscript="beam">L</ml:id>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>2</ml:real>
																	<ml:id xml:space="preserve">ft</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
														<ml:apply>
															<ml:plus/>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>1</ml:real>
														</ml:apply>
													</ml:apply>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve">j</ml:id>
														<ml:real>1</ml:real>
													</ml:apply>
												</ml:apply>
											</ml:apply>
										</ml:parens>
									</ml:lambda>
									<ml:bounds>
										<ml:real>0</ml:real>
										<ml:id xml:space="preserve">eqd</ml:id>
									</ml:bounds>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="180843" left="6" top="1071" width="138" height="15" align-x="30.75" align-y="1080" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="rel">C1</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">fC1</ml:id>
									<ml:id xml:space="preserve" subscript="rel">Consts</ml:id>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:real>0.018525406088626198</ml:real>
								</result>
							</ml:eval>
						</ml:define>
						<resultFormat numeric-only="true">
							<general precision="5" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="181021" left="6" top="1107" width="380.25" height="112.5" align-x="116.25" align-y="1116" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">fSlope</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve" subscript="stage">C1</ml:id>
									<ml:id xml:space="preserve">constants</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">n</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:id xml:space="preserve">last</ml:id>
											<ml:id xml:space="preserve">Location</ml:id>
										</ml:apply>
									</ml:range>
									<ml:for>
										<ml:id xml:space="preserve">j</ml:id>
										<ml:range>
											<ml:real>0</ml:real>
											<ml:id xml:space="preserve">eqd</ml:id>
										</ml:range>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">slope</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve" subscript="stage">C1</ml:id>
												<ml:apply>
													<ml:summation/>
													<ml:lambda>
														<ml:boundVars>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:boundVars>
														<ml:parens>
															<ml:apply>
																<ml:mult/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">constants</ml:id>
																	<ml:id xml:space="preserve">j</ml:id>
																</ml:apply>
																<ml:apply>
																	<ml:div/>
																	<ml:apply>
																		<ml:pow/>
																		<ml:parens>
																			<ml:apply>
																				<ml:div/>
																				<ml:apply>
																					<ml:indexer/>
																					<ml:id xml:space="preserve">Location</ml:id>
																					<ml:id xml:space="preserve">n</ml:id>
																				</ml:apply>
																				<ml:id xml:space="preserve">ft</ml:id>
																			</ml:apply>
																		</ml:parens>
																		<ml:apply>
																			<ml:plus/>
																			<ml:id xml:space="preserve">j</ml:id>
																			<ml:real>1</ml:real>
																		</ml:apply>
																	</ml:apply>
																	<ml:apply>
																		<ml:plus/>
																		<ml:id xml:space="preserve">j</ml:id>
																		<ml:real>1</ml:real>
																	</ml:apply>
																</ml:apply>
															</ml:apply>
														</ml:parens>
													</ml:lambda>
													<ml:bounds>
														<ml:real>0</ml:real>
														<ml:id xml:space="preserve">eqd</ml:id>
													</ml:bounds>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
									</ml:for>
								</ml:for>
								<ml:id xml:space="preserve">slope</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="181022" left="6" top="1239" width="137.25" height="15" align-x="42.75" align-y="1248" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="rel">Slope</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">fSlope</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve" subscript="rel">C1</ml:id>
									<ml:id xml:space="preserve" subscript="rel">Consts</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="181019" left="6" top="1309.5" width="456" height="65.25" align-x="158.25" align-y="1332" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#80ffff" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">fC2</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve" subscript="stage">C1</ml:id>
									<ml:id xml:space="preserve">constants</ml:id>
									<ml:id xml:space="preserve">SpanLength</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:minus/>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:neg/>
										<ml:id xml:space="preserve" subscript="stage">C1</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve">SpanLength</ml:id>
										<ml:id xml:space="preserve">ft</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:summation/>
									<ml:lambda>
										<ml:boundVars>
											<ml:id xml:space="preserve">j</ml:id>
										</ml:boundVars>
										<ml:parens>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">constants</ml:id>
														<ml:id xml:space="preserve">j</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:summation/>
														<ml:lambda>
															<ml:boundVars>
																<ml:id xml:space="preserve">r</ml:id>
															</ml:boundVars>
															<ml:parens>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>2</ml:real>
																	<ml:parens>
																		<ml:apply>
																			<ml:plus/>
																			<ml:id xml:space="preserve">r</ml:id>
																			<ml:real>1</ml:real>
																		</ml:apply>
																	</ml:parens>
																</ml:apply>
															</ml:parens>
														</ml:lambda>
														<ml:bounds>
															<ml:real>0</ml:real>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:bounds>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:pow/>
													<ml:parens>
														<ml:apply>
															<ml:div/>
															<ml:id xml:space="preserve">SpanLength</ml:id>
															<ml:id xml:space="preserve">ft</ml:id>
														</ml:apply>
													</ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve">j</ml:id>
														<ml:real>2</ml:real>
													</ml:apply>
												</ml:apply>
											</ml:apply>
										</ml:parens>
									</ml:lambda>
									<ml:bounds>
										<ml:real>0</ml:real>
										<ml:id xml:space="preserve">eqd</ml:id>
									</ml:bounds>
								</ml:apply>
							</ml:apply>
						</ml:define>
						<resultFormat numeric-only="true">
							<general precision="4" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="181020" left="6" top="1389" width="222.75" height="21" align-x="30.75" align-y="1404" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="rel">C2</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">fC2</ml:id>
									<ml:sequence>
										<ml:id xml:space="preserve" subscript="rel">C1</ml:id>
										<ml:id xml:space="preserve" subscript="rel">Consts</ml:id>
										<ml:id xml:space="preserve" subscript="beam">L</ml:id>
									</ml:sequence>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:real>2.8621549574836536E-13</ml:real>
