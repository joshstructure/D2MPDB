							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="matrix" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="177745" left="168" top="6159.75" width="72" height="95.25" align-x="184.5" align-y="6210" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="se">ε</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="6" cols="1">
									<ml:real>0.0062507929484262132</ml:real>
									<ml:real>0.0062507929484262132</ml:real>
									<ml:real>0.0062507929484262132</ml:real>
									<ml:real>0.0062507929484262132</ml:real>
									<ml:real>0.0062507929484262132</ml:real>
									<ml:real>0</ml:real>
								</ml:matrix>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="5" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="8"/>
							<matrix display-style="matrix" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="177746" left="246" top="6159.75" width="78" height="95.25" align-x="263.25" align-y="6210" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="cp">ε</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="6" cols="1">
									<ml:real>-0.00054384110709737013</ml:real>
									<ml:real>-0.00054384110709737013</ml:real>
									<ml:real>-0.00050464122724989632</ml:real>
									<ml:real>-0.00050464122724989632</ml:real>
									<ml:real>-0.00046544158260123118</ml:real>
									<ml:real>0.00010295561679249974</ml:real>
								</ml:matrix>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="5" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="6"/>
							<matrix display-style="matrix" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
