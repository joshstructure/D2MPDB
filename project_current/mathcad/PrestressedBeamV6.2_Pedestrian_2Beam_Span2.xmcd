				<region region-id="177730" left="6" top="1212" width="237.75" height="30" align-x="63.75" align-y="1230" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="p.CFRP">f_f</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">ε</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:lessOrEqual/>
										<ml:apply>
											<ml:mult/>
											<ml:id xml:space="preserve" subscript="p.CFRP">E</ml:id>
											<ml:id xml:space="preserve">ε</ml:id>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="pu.CFRP">f</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve" subscript="p.CFRP">E</ml:id>
											<ml:id xml:space="preserve">ksi</ml:id>
