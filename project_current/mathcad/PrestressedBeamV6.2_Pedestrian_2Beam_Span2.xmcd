				<region region-id="147022" left="6" top="5367" width="147.75" height="15" align-x="33" align-y="5376" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="pT">Δf</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:plus/>
									<ml:id xml:space="preserve" subscript="pES">Δf</ml:id>
