				<region region-id="201369" left="348" top="5559" width="116.25" height="11.25" align-x="357" align-y="5568" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Demand/Capacity Ratio</p>
					</text>
				</region>
				<region region-id="201370" left="348" top="5578.5" width="152.25" height="33.75" align-x="469.5" align-y="5598" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:matrix rows="2" cols="1">
								<ml:id xml:space="preserve" subscript="splitting.LRFD.Ubeam.horiz">D/C</ml:id>
								<ml:id xml:space="preserve" subscript="splitting.LRFD.Ubeam.vert">D/C</ml:id>
							</ml:matrix>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="2" cols="1">
									<ml:real>0</ml:real>
									<ml:real>0</ml:real>
								</ml:matrix>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="201298" left="6" top="5637" width="481.5" height="81" align-x="102" align-y="5646" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="splitting.Ubeam">CheckD/C</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">chk</ml:id>
									<ml:str xml:space="preserve">N/A</ml:str>
								</ml:localDefine>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:id xml:space="preserve">substr</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:real>0</ml:real>
												<ml:real>3</ml:real>
											</ml:sequence>
										</ml:apply>
										<ml:str xml:space="preserve">FUB</ml:str>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:mult/>
												<ml:parens>
													<ml:apply>
														<ml:lessThan/>
														<ml:id xml:space="preserve" subscript="splitting.LRFD.Ubeam.horiz">D/C</ml:id>
														<ml:real>1.0</ml:real>
													</ml:apply>
												</ml:parens>
												<ml:parens>
													<ml:apply>
														<ml:lessThan/>
														<ml:id xml:space="preserve" subscript="splitting.LRFD.Ubeam.vert">D/C</ml:id>
														<ml:real>1.0</ml:real>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:localDefine>
												<ml:id xml:space="preserve">chk</ml:id>
												<ml:str xml:space="preserve">OK</ml:str>
											</ml:localDefine>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:id xml:space="preserve">chk</ml:id>
												<ml:str xml:space="preserve">No Good</ml:str>
											</ml:localDefine>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:id xml:space="preserve">chk</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="201304" left="354" top="5733" width="135.75" height="15" align-x="448.5" align-y="5742" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="splitting.Ubeam">CheckD/C</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:str xml:space="preserve">N/A</ml:str>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="201179" left="6" top="5763" width="308.25" height="11.25" align-x="22.5" align-y="5772" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Splitting Summary for FDOT Standard Splitting Reinforcement</p>
					</text>
				</region>
				<region region-id="201399" left="6" top="5787" width="95.25" height="12.75" align-x="54" align-y="5796" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">BeamType</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:str xml:space="preserve">FIB36</ml:str>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="201404" left="6" top="5811" width="80.25" height="15" align-x="45.75" align-y="5820" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="r.standard">P</ml:id>
							<ml:unitOverride>
								<ml:id xml:space="preserve">kip</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>1450</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="kip"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="201405" left="108" top="5811" width="76.5" height="15" align-x="144" align-y="5820" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="prestress">P</ml:id>
							<ml:unitOverride>
								<ml:id xml:space="preserve">kip</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>1362.2175</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="kip"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="0" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="201406" left="210" top="5811" width="98.25" height="15" align-x="279" align-y="5820" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="splitting.FDOT">D/C</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:real>0.93946034482758622</ml:real>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="202558" left="6" top="5841" width="131.25" height="15" align-x="99.75" align-y="5850" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="splitting.FDOT">CheckD/C</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:str xml:space="preserve">OK</ml:str>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="202559" left="6" top="5865" width="384" height="66.75" align-x="78.75" align-y="5874" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="splitting">CheckD/C</ml:id>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">MildReinfType</ml:id>
										<ml:str xml:space="preserve">Glass Fiber Reinforced Polymer</ml:str>
									</ml:apply>
									<ml:str xml:space="preserve">Not Checked</ml:str>
								</ml:ifThen>
								<ml:otherwise>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:str xml:space="preserve">Custom</ml:str>
											</ml:apply>
											<ml:id xml:space="preserve" subscript="splitting.case2">CheckD/C</ml:id>
										</ml:ifThen>
										<ml:otherwise>
											<ml:id xml:space="preserve" subscript="splitting.FDOT">CheckD/C</ml:id>
										</ml:otherwise>
									</ml:program>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="202560" left="6" top="5943" width="108.75" height="15" align-x="77.25" align-y="5952" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="splitting">CheckD/C</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:str xml:space="preserve">OK</ml:str>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="26216" left="6" top="5979" width="120.75" height="11.25" align-x="6" align-y="5988" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Confinement Reinforcement</p>
					</text>
				</region>
				<region region-id="130218" left="138" top="5979" width="74.25" height="11.25" align-x="138" align-y="5988" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(LRFD 5.9.4.4.2)</p>
					</text>
				</region>
				<region region-id="130219" left="6" top="6009" width="220.5" height="11.25" align-x="6" align-y="6018" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">approximate using #3 bars spaced at 6 inches</p>
					</text>
				</region>
				<region region-id="26219" left="6" top="6042" width="285" height="30" align-x="95.25" align-y="6060" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">TotalNoConfineBars</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:real>2</ml:real>
									<ml:apply>
										<ml:id xml:space="preserve">ceil</ml:id>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:mult/>
														<ml:real>1.5</ml:real>
														<ml:apply>
															<ml:absval/>
															<ml:id xml:space="preserve" subscript="beam.bot">y</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:id xml:space="preserve">EndSpace</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:real>6</ml:real>
													<ml:id xml:space="preserve">in</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:real>20</ml:real>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="201374" left="360" top="6051" width="110.25" height="12.75" align-x="447.75" align-y="6060" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">TotalNoConfineBars</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:real>20</ml:real>
							</result>
						</ml:eval>
					</math>
				</region>
			</area>
			<rendering item-idref="707"/>
		</region>
		<region region-id="200892" left="6" top="11821.5" width="213.75" height="14.25" align-x="6" align-y="11832.75" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
