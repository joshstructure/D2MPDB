				<region region-id="179710" left="6" top="1659" width="592.5" height="160.5" align-x="67.5" align-y="1668" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="BarsE.reqd">Spa</ml:id>
								<ml:id xml:space="preserve">hs</ml:id>
							</ml:apply>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:id xml:space="preserve">substr</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:real>0</ml:real>
												<ml:real>3</ml:real>
											</ml:sequence>
										</ml:apply>
										<ml:str xml:space="preserve">FSB</ml:str>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:lessOrEqual/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="ss.Ser1">f</ml:id>
													<ml:id xml:space="preserve">hs</ml:id>
												</ml:apply>
												<ml:real>0</ml:real>
											</ml:apply>
											<ml:apply>
												<ml:mult style="auto-select"/>
												<ml:real>10000</ml:real>
												<ml:id xml:space="preserve">in</ml:id>
											</ml:apply>
										</ml:ifThen>
										<ml:otherwise>
											<ml:program>
												<ml:ifThen>
													<ml:apply>
														<ml:plus/>
														<ml:parens>
															<ml:apply>
																<ml:equal/>
																<ml:id xml:space="preserve">MildReinfType</ml:id>
																<ml:str xml:space="preserve">Carbon Steel</ml:str>
															</ml:apply>
														</ml:parens>
														<ml:parens>
															<ml:apply>
																<ml:equal/>
																<ml:id xml:space="preserve">MildReinfType</ml:id>
																<ml:str xml:space="preserve">Stainless Steel</ml:str>
															</ml:apply>
														</ml:parens>
													</ml:apply>
													<ml:parens>
														<ml:apply>
															<ml:minus/>
															<ml:apply>
																<ml:div/>
																<ml:apply>
																	<ml:mult/>
																	<ml:apply>
																		<ml:mult/>
																		<ml:real>700</ml:real>
																		<ml:id xml:space="preserve" subscript="e">γ</ml:id>
																	</ml:apply>
																	<ml:apply>
																		<ml:div/>
																		<ml:id xml:space="preserve">kip</ml:id>
																		<ml:id xml:space="preserve">in</ml:id>
																	</ml:apply>
																</ml:apply>
																<ml:apply>
																	<ml:mult/>
																	<ml:id xml:space="preserve" subscript="s">β</ml:id>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve" subscript="ss.Ser1">f</ml:id>
																		<ml:id xml:space="preserve">hs</ml:id>
																	</ml:apply>
																</ml:apply>
															</ml:apply>
															<ml:apply>
																<ml:mult/>
																<ml:real>2</ml:real>
																<ml:id xml:space="preserve" subscript="c">d</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:parens>
												</ml:ifThen>
												<ml:ifThen>
													<ml:apply>
														<ml:equal/>
														<ml:id xml:space="preserve">MildReinfType</ml:id>
														<ml:str xml:space="preserve">Glass Fiber Reinforced Polymer</ml:str>
													</ml:apply>
													<ml:apply>
														<ml:id xml:space="preserve">min</ml:id>
														<ml:sequence>
															<ml:apply>
																<ml:minus/>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>1.15</ml:real>
																	<ml:apply>
																		<ml:div/>
																		<ml:apply>
																			<ml:mult/>
																			<ml:apply>
																				<ml:mult/>
																				<ml:id xml:space="preserve" subscript="b">C</ml:id>
																				<ml:id xml:space="preserve" subscript="f">E</ml:id>
																			</ml:apply>
																			<ml:id xml:space="preserve" subscript="max">w</ml:id>
																		</ml:apply>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve" subscript="ss.Ser1">f</ml:id>
																			<ml:id xml:space="preserve">hs</ml:id>
																		</ml:apply>
																	</ml:apply>
																</ml:apply>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>2.5</ml:real>
																	<ml:id xml:space="preserve" subscript="c">c</ml:id>
																</ml:apply>
															</ml:apply>
															<ml:apply>
																<ml:mult/>
																<ml:real>0.92</ml:real>
																<ml:apply>
																	<ml:div/>
																	<ml:apply>
																		<ml:mult/>
																		<ml:apply>
																			<ml:mult/>
																			<ml:id xml:space="preserve" subscript="b">C</ml:id>
																			<ml:id xml:space="preserve" subscript="f">E</ml:id>
																		</ml:apply>
																		<ml:id xml:space="preserve" subscript="max">w</ml:id>
																	</ml:apply>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve" subscript="ss.Ser1">f</ml:id>
																		<ml:id xml:space="preserve">hs</ml:id>
																	</ml:apply>
																</ml:apply>
															</ml:apply>
														</ml:sequence>
													</ml:apply>
												</ml:ifThen>
											</ml:program>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:otherwise>
									<ml:real>0</ml:real>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
