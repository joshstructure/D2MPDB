					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">b<sp count="2"/>Bond the outer-most strands in all rows located within the full-width section of the flange (0=OK 1=NoGood).</p>
					</text>
