										<ml:div/>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="nh.reqd">V</ml:id>
												<ml:id xml:space="preserve">hs</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:id xml:space="preserve">c</ml:id>
												<ml:id xml:space="preserve" subscript="cv">A</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:id xml:space="preserve">μ</ml:id>
											<ml:id xml:space="preserve" subscript="y.d.stirrup">f</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:matrix>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="176267" left="378" top="932.25" width="98.25" height="33.75" align-x="430.5" align-y="954" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
