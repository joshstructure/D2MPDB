					</math>
				</region>
				<region region-id="147029" left="186" top="5367" width="66" height="11.25" align-x="186" align-y="5376" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">LRFD 5.9.3.1-1</p>
					</text>
				</region>
				<region region-id="147030" left="270" top="5358" width="68.25" height="32.25" align-x="298.5" align-y="5376" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:div/>
								<ml:id xml:space="preserve" subscript="pT">Δf</ml:id>
								<ml:id xml:space="preserve" subscript="pj">f</ml:id>
							</ml:apply>
							<ml:unitOverride>
								<ml:id xml:space="preserve">%</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:real>-12.318979346414427</ml:real>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="1" show-trailing-zeros="true" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="6"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="147023" left="6" top="5409" width="498.75" height="11.25" align-x="6" align-y="5418" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">check prestress prior to transfer and at service (LRFD Table 5.9.3-1) and calculate losses as a % of initial prestress</p>
					</text>
				</region>
				<region region-id="173539" left="6" top="5439" width="487.5" height="108.75" align-x="51.75" align-y="5448" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="pt">Check_f</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:program>
									<ml:localDefine>
										<ml:id xml:space="preserve" subscript="pt">check_f</ml:id>
										<ml:str xml:space="preserve">No Good</ml:str>
									</ml:localDefine>
									<ml:ifThen>
										<ml:apply>
											<ml:plus/>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">StrandType</ml:id>
													<ml:str xml:space="preserve">Carbon Steel - Low Lax</ml:str>
												</ml:apply>
											</ml:parens>
											<ml:parens>
												<ml:apply>
													<ml:lessOrEqual/>
													<ml:id xml:space="preserve" subscript="pj">f</ml:id>
													<ml:apply>
														<ml:mult/>
														<ml:real font="0">0.75</ml:real>
														<ml:id xml:space="preserve" subscript="pu">f</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="pt">check_f</ml:id>
											<ml:str xml:space="preserve">OK</ml:str>
										</ml:localDefine>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:plus/>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">StrandType</ml:id>
													<ml:str xml:space="preserve">Carbon Steel - Stress Relieved</ml:str>
												</ml:apply>
											</ml:parens>
											<ml:parens>
												<ml:apply>
													<ml:lessOrEqual/>
													<ml:id xml:space="preserve" subscript="pj">f</ml:id>
													<ml:apply>
														<ml:mult/>
														<ml:real font="0">0.70</ml:real>
														<ml:id xml:space="preserve" subscript="pu">f</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="pt">check_f</ml:id>
											<ml:str xml:space="preserve">OK</ml:str>
										</ml:localDefine>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:plus/>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">StrandType</ml:id>
													<ml:str xml:space="preserve">Stainless Steel</ml:str>
												</ml:apply>
											</ml:parens>
											<ml:parens>
												<ml:apply>
													<ml:lessOrEqual/>
													<ml:id xml:space="preserve" subscript="pj">f</ml:id>
													<ml:apply>
														<ml:mult/>
														<ml:real font="0">0.65</ml:real>
														<ml:id xml:space="preserve" subscript="pu">f</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="pt">check_f</ml:id>
											<ml:str xml:space="preserve">OK</ml:str>
										</ml:localDefine>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:plus/>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">StrandType</ml:id>
													<ml:str xml:space="preserve">Carbon Fiber Reinforced Polymer</ml:str>
												</ml:apply>
											</ml:parens>
											<ml:parens>
												<ml:apply>
													<ml:lessOrEqual/>
													<ml:id xml:space="preserve" subscript="pj">f</ml:id>
													<ml:apply>
														<ml:mult/>
														<ml:real font="0">0.70</ml:real>
														<ml:id xml:space="preserve" subscript="pu">f</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="pt">check_f</ml:id>
											<ml:str xml:space="preserve">OK</ml:str>
										</ml:localDefine>
									</ml:ifThen>
									<ml:id xml:space="preserve" subscript="pt">check_f</ml:id>
								</ml:program>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:str xml:space="preserve">OK</ml:str>
								</result>
							</ml:eval>
						</ml:define>
						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="5"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="177573" left="6" top="5583" width="118.5" height="15" align-x="23.25" align-y="5592" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="pe">f</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:plus/>
									<ml:id xml:space="preserve" subscript="pj">f</ml:id>
									<ml:id xml:space="preserve" subscript="pT">Δf</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">ksi</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>177.55406682351079</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="kips_per_sq_inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="177574" left="198" top="5580" width="79.5" height="32.25" align-x="238.5" align-y="5598" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:minus/>
									<ml:id xml:space="preserve" subscript="pj">f</ml:id>
									<ml:id xml:space="preserve" subscript="pe">f</ml:id>
								</ml:apply>
								<ml:id xml:space="preserve" subscript="pj">f</ml:id>
							</ml:apply>
							<ml:unitOverride>
								<ml:id xml:space="preserve">%</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:real>12.318979346414423</ml:real>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="177575" left="342" top="5589" width="72.75" height="15" align-x="372.75" align-y="5598" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:mult/>
								<ml:real font="0">0.8</ml:real>
								<ml:id xml:space="preserve" subscript="py">f</ml:id>
							</ml:apply>
							<ml:unitOverride>
								<ml:id xml:space="preserve">ksi</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>194.4</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="kips_per_sq_inch"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="177579" left="6" top="5625" width="489.75" height="108.75" align-x="52.5" align-y="5634" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="pe">Check_f</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:program>
									<ml:localDefine>
										<ml:id xml:space="preserve" subscript="pe">check_f</ml:id>
										<ml:str xml:space="preserve">No Good</ml:str>
									</ml:localDefine>
									<ml:ifThen>
										<ml:apply>
											<ml:plus/>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">StrandType</ml:id>
													<ml:str xml:space="preserve">Carbon Steel - Low Lax</ml:str>
												</ml:apply>
