				<region region-id="141487" left="6" top="3453" width="387" height="12.75" align-x="100.5" align-y="3462" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
