									<hash/>
								</originRef>
								<parentRef doc-id="D14AEA97-1625-4217-BE58-378E1140B5F1" version-id="F91DD217-7E9B-42F1-B7A5-9AC553CE101B" branch-id="00000000-0000-0000-0000-000000000000" revision-num="1615755108" is-modified="false" region-id="0" href="C:\March2020-Programs\PrestressedBeamApril 2020\StrandChecks.xmcd" xmlns="http://schemas.mathsoft.com/provenance10">
									<hash/>
								</parentRef>
								<comment xmlns="http://schemas.mathsoft.com/provenance10"/>
								<originComment xmlns="http://schemas.mathsoft.com/provenance10"/>
