				<region region-id="141039" left="6" top="9087" width="334.5" height="103.5" align-x="81.75" align-y="9096" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">Bond</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve" subscript="1">L</ml:id>
									<ml:id xml:space="preserve" subscript="2">L</ml:id>
									<ml:id xml:space="preserve">loc</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:or/>
										<ml:apply>
											<ml:lessOrEqual/>
											<ml:id xml:space="preserve">loc</ml:id>
											<ml:id xml:space="preserve" subscript="1">L</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:greaterOrEqual/>
											<ml:id xml:space="preserve">loc</ml:id>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve" subscript="beam">L</ml:id>
												<ml:id xml:space="preserve" subscript="1">L</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:real>0</ml:real>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:lessThan/>
										<ml:apply>
											<ml:lessThan/>
											<ml:id xml:space="preserve" subscript="1">L</ml:id>
											<ml:id xml:space="preserve">loc</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:plus/>
											<ml:id xml:space="preserve" subscript="1">L</ml:id>
											<ml:id xml:space="preserve" subscript="2">L</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve">loc</ml:id>
											<ml:id xml:space="preserve" subscript="1">L</ml:id>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="2">L</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:lessThan/>
										<ml:apply>
											<ml:lessThan/>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve" subscript="beam">L</ml:id>
												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve" subscript="1">L</ml:id>
														<ml:id xml:space="preserve" subscript="2">L</ml:id>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:id xml:space="preserve">loc</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve" subscript="beam">L</ml:id>
											<ml:id xml:space="preserve" subscript="1">L</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve" subscript="beam">L</ml:id>
												<ml:id xml:space="preserve" subscript="1">L</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve">loc</ml:id>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="2">L</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:otherwise>
									<ml:real>1</ml:real>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
