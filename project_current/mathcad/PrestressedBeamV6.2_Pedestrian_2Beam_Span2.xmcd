												<ml:id xml:space="preserve">hs</ml:id>
											</ml:apply>
											<ml:parens>
												<ml:apply>
													<ml:minus/>
													<ml:id xml:space="preserve" subscript="ps.midspan">f</ml:id>
													<ml:id xml:space="preserve" subscript="pe">f</ml:id>
												</ml:apply>
											</ml:parens>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="psds">A</ml:id>
											<ml:id xml:space="preserve">hs</ml:id>
										</ml:apply>
										<ml:parens>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve" subscript="pe">f</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:parens>
														<ml:apply>
															<ml:minus/>
															<ml:id xml:space="preserve" subscript="ps.midspan">f</ml:id>
															<ml:id xml:space="preserve" subscript="pe">f</ml:id>
														</ml:apply>
													</ml:parens>
