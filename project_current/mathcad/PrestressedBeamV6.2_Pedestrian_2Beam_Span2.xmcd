				<region region-id="176254" left="6" top="618" width="290.25" height="32.25" align-x="66" align-y="636" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="nh.reqd">CheckV</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:lessThan/>
											<ml:apply>
												<ml:id xml:space="preserve">max</ml:id>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve" subscript="nh.reqd">V</ml:id>
														<ml:id xml:space="preserve">ft</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="nh.max">V</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
										<ml:str xml:space="preserve">OK</ml:str>
										<ml:str xml:space="preserve">No Good</ml:str>
									</ml:sequence>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:str xml:space="preserve">OK</ml:str>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="176255" left="6" top="663" width="307.5" height="15" align-x="66" align-y="672" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define warning="WarnRedefinedUDScalar" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="nh.reqd">CheckV</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:id xml:space="preserve">substr</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:real>0</ml:real>
												<ml:real>3</ml:real>
											</ml:sequence>
										</ml:apply>
										<ml:str xml:space="preserve">FLT</ml:str>
									</ml:apply>
									<ml:str xml:space="preserve">N.A.</ml:str>
									<ml:id xml:space="preserve" subscript="nh.reqd">CheckV</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="176256" left="378" top="663" width="96" height="15" align-x="436.5" align-y="672" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
