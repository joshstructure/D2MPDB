		<region region-id="30614" left="0" top="20985" width="6000" align-x="6000" align-y="20994" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#c0c0c0" tag="" height="5546.25">
			<area is-collapsed="false" name="   Shear Resistance" show-name="true" show-border="true" show-icon="true" show-timestamp="true" allow-expand="false" is-locked="false" timestamp="" top-lock-id="30614" bottom-lock-id="30651" bottom-tag="">
				<region region-id="32092" left="6" top="21021" width="207" height="11.25" align-x="6" align-y="21030" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Area of straight, undraped Prestressing Strands</p>
					</text>
				</region>
				<region region-id="32079" left="6" top="21051" width="464.25" height="315.75" align-x="30" align-y="21060" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="pss">A</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:while>
									<ml:apply>
										<ml:lessThan/>
										<ml:id xml:space="preserve">j</ml:id>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:id xml:space="preserve">last</ml:id>
												<ml:id xml:space="preserve">Location</ml:id>
											</ml:apply>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:program>
										<ml:for>
											<ml:id xml:space="preserve">i</ml:id>
											<ml:range>
												<ml:real>0</ml:real>
												<ml:apply>
													<ml:id xml:space="preserve">last</ml:id>
													<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
												</ml:apply>
											</ml:range>
											<ml:program>
												<ml:ifThen>
													<ml:apply>
														<ml:equal/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">i</ml:id>
																<ml:id xml:space="preserve">j</ml:id>
															</ml:sequence>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">i</ml:id>
																<ml:apply>
																	<ml:plus/>
																	<ml:id xml:space="preserve">j</ml:id>
																	<ml:real>1</ml:real>
																</ml:apply>
															</ml:sequence>
														</ml:apply>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">apss</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
													</ml:localDefine>
												</ml:ifThen>
												<ml:otherwise>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">apss</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:real>0</ml:real>
															<ml:apply>
																<ml:pow/>
																<ml:id xml:space="preserve">in</ml:id>
																<ml:real>2</ml:real>
															</ml:apply>
														</ml:apply>
													</ml:localDefine>
												</ml:otherwise>
												<ml:ifThen>
													<ml:apply>
														<ml:lessThan/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Location</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">PercentTrans</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:real>0</ml:real>
													</ml:localDefine>
												</ml:ifThen>
												<ml:ifThen>
													<ml:apply>
														<ml:mult/>
														<ml:parens>
															<ml:apply>
																<ml:greaterOrEqual/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">Location</ml:id>
																	<ml:id xml:space="preserve">j</ml:id>
																</ml:apply>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
																	<ml:id xml:space="preserve">i</ml:id>
																</ml:apply>
