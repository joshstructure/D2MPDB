												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve" subscript="e">d</ml:id>
														<ml:apply>
															<ml:mult style="auto-select"/>
															<ml:real>42.75</ml:real>
															<ml:id xml:space="preserve">in</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:parens>
											</ml:apply>
										</ml:apply>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">BeamType</ml:id>
											<ml:str xml:space="preserve">FUB72</ml:str>
