						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Bearing Reactions</p>
					</text>
				</region>
				<region region-id="28279" left="6" top="8501.25" width="412.5" height="249" align-x="125.25" align-y="8510.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="trk.reaction">f</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">trk</ml:id>
									<ml:id xml:space="preserve">asp</ml:id>
									<ml:id xml:space="preserve">bd</ml:id>
									<ml:id xml:space="preserve">lgth</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">stop</ml:id>
									<ml:apply>
										<ml:id xml:space="preserve">last</ml:id>
										<ml:id xml:space="preserve">trk</ml:id>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">react</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:id xml:space="preserve">stop</ml:id>
									</ml:range>
									<ml:program>
										<ml:localDefine>
											<ml:id xml:space="preserve">sum</ml:id>
											<ml:real>0</ml:real>
										</ml:localDefine>
										<ml:for>
											<ml:id xml:space="preserve">j</ml:id>
											<ml:range>
												<ml:id xml:space="preserve">i</ml:id>
												<ml:id xml:space="preserve">stop</ml:id>
											</ml:range>
											<ml:program>
