				<region region-id="175945" left="426" top="9183" width="72.75" height="15" align-x="476.25" align-y="9192" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
