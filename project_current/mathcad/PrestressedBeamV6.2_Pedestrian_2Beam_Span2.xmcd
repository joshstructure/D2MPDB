												<ml:localDefine>
													<ml:id xml:space="preserve">dif</ml:id>
													<ml:apply>
														<ml:minus/>
														<ml:id xml:space="preserve">fpt</ml:id>
														<ml:id xml:space="preserve">fp</ml:id>
													</ml:apply>
												</ml:localDefine>
												<ml:localDefine>
													<ml:id xml:space="preserve" subscript="i">ε</ml:id>
													<ml:apply>
														<ml:mult style="auto-select"/>
														<ml:id xml:space="preserve" subscript="i">ε</ml:id>
														<ml:parens>
															<ml:apply>
																<ml:minus/>
																<ml:real>1</ml:real>
																<ml:apply>
																	<ml:div/>
																	<ml:apply>
																		<ml:mult/>
																		<ml:id xml:space="preserve">dif</ml:id>
																		<ml:real>0.5</ml:real>
																	</ml:apply>
																	<ml:id xml:space="preserve">fp</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
													</ml:apply>
												</ml:localDefine>
											</ml:program>
										</ml:ifThen>
										<ml:otherwise>
											<ml:program>
												<ml:localDefine>
													<ml:id xml:space="preserve" subscript="i">ε</ml:id>
													<ml:real>0</ml:real>
												</ml:localDefine>
												<ml:localDefine>
													<ml:id xml:space="preserve">dif</ml:id>
													<ml:real>0</ml:real>
												</ml:localDefine>
											</ml:program>
										</ml:otherwise>
									</ml:program>
								</ml:while>
								<ml:id xml:space="preserve" subscript="i">ε</ml:id>
							</ml:program>
