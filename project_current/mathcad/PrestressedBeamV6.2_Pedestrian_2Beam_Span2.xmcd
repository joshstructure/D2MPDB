							</ml:apply>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="1" cols="7">
									<ml:real>2</ml:real>
									<ml:real>2</ml:real>
									<ml:real>12</ml:real>
									<ml:real>30</ml:real>
									<ml:real>20</ml:real>
									<ml:real>5</ml:real>
