									<ml:str xml:space="preserve">Location(ft)</ml:str>
									<ml:real>4.8093333333333339</ml:real>
									<ml:str xml:space="preserve">Vu (kip)</ml:str>
									<ml:real>156.23463458280526</ml:real>
									<ml:str xml:space="preserve">Vr (kip)</ml:str>
									<ml:real>323.05736652384979</ml:real>
								</ml:matrix>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="true" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
