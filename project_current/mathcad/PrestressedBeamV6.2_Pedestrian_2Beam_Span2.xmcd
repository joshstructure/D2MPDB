								<ml:str xml:space="preserve">Release Dead Load</ml:str>
								<ml:str xml:space="preserve">Non-Composite DL (incl. beam wt.)</ml:str>
								<ml:str xml:space="preserve">Composite Dead Load</ml:str>
								<ml:str xml:space="preserve">Distributed Live Load</ml:str>
								<ml:str xml:space="preserve">Moment (kip*ft)</ml:str>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="release">M</ml:id>
										<ml:real>51</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:id xml:space="preserve">kip</ml:id>
										<ml:id xml:space="preserve">ft</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="dl.non.comp">M</ml:id>
										<ml:real>51</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:id xml:space="preserve">kip</ml:id>
										<ml:id xml:space="preserve">ft</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="dl.comp">M</ml:id>
										<ml:real>51</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:id xml:space="preserve">kip</ml:id>
										<ml:id xml:space="preserve">ft</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="dist.live.pos">M</ml:id>
										<ml:real>51</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:id xml:space="preserve">kip</ml:id>
										<ml:id xml:space="preserve">ft</ml:id>
									</ml:apply>
								</ml:apply>
							</ml:matrix>
						</ml:define>
					</math>
				</region>
				<region region-id="181929" left="6" top="15522" width="331.5" height="78.75" align-x="78.75" align-y="15564" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">ServiceMoments</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="5" cols="2">
									<ml:str xml:space="preserve">Load Type </ml:str>
									<ml:str xml:space="preserve">Release Dead Load</ml:str>
									<ml:str xml:space="preserve">Non-Composite DL (incl. beam wt.)</ml:str>
									<ml:str xml:space="preserve">Composite Dead Load</ml:str>
									<ml:str xml:space="preserve">Distributed Live Load</ml:str>
									<ml:str xml:space="preserve">Moment (kip*ft)</ml:str>
									<ml:real>1156.8563667558581</ml:real>
									<ml:real>1938.7293553410273</ml:real>
									<ml:real>563.02452499999993</ml:real>
									<ml:real>724.008675</ml:real>
								</ml:matrix>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="186535" left="6" top="15636.75" width="434.25" height="14.25" align-x="6" align-y="15648" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="heading" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Longitudinal Reinforcement Requirements for Allowable Tension at Release</p>
					</text>
				</region>
				<region region-id="186600" left="444" top="15638.25" width="87.75" height="12" align-x="444" align-y="15648" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(LRFD <f family="Arial" charset="0">C5.9.2.3.1b</f>)</p>
					</text>
				</region>
				<region region-id="186537" left="6" top="15666" width="526.5" height="112.5" align-x="6" align-y="15666" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#c0c0c0" tag="">
					<picture>
						<png item-idref="651" display-width="525" display-height="111"/>
					</picture>
				</region>
				<region region-id="202703" left="0" top="15798" width="346.5" height="311.25" align-x="0" align-y="15798" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<picture>
						<png item-idref="652" display-width="345" display-height="309.75"/>
					</picture>
				</region>
				<region region-id="202728" left="348" top="15801" width="172.5" height="191.25" align-x="351.75" align-y="15810" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">C5.9.2.3.1b:<sp count="2"/>Where bonded reinforcement is provided to allow use of the increased tensile limiting stress in areas with bonded reinforcement, the tensile force must be computed. The first step in computing the tensile force, T, is to determine the depth of the tensile zone using the extreme fiber stresses at the location being considered, fci top and fci bot. An area is then defined over which the average tensile stress is assumed to act. The tensile force is computed as the product of the average tensile stress and the computed area, as illustrated below. The required area of reinforcement, As, is computed by dividing the tensile force by the permitted stress in the reinforcement.</p>
					</text>
				</region>
				<region region-id="202720" left="306" top="16026" width="123.75" height="32.25" align-x="350.25" align-y="16044" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:equal/>
							<ml:apply>
								<ml:div/>
								<ml:id xml:space="preserve">x</ml:id>
								<ml:id xml:space="preserve" subscript="ci.top.max">f</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:div/>
								<ml:id xml:space="preserve" subscript="beam">H</ml:id>
								<ml:apply>
									<ml:minus/>
									<ml:id xml:space="preserve" subscript="ci.top.max">f</ml:id>
									<ml:id xml:space="preserve" subscript="ci.bot">f</ml:id>
								</ml:apply>
							</ml:apply>
						</ml:apply>
					</math>
				</region>
				<region region-id="202721" left="444" top="16026" width="88.5" height="32.25" align-x="453" align-y="16044" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:equal/>
							<ml:id xml:space="preserve">x</ml:id>
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve" subscript="beam">H</ml:id>
									<ml:id xml:space="preserve" subscript="ci.top.max">f</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:minus/>
									<ml:id xml:space="preserve" subscript="ci.top.max">f</ml:id>
									<ml:id xml:space="preserve" subscript="ci.bot">f</ml:id>
								</ml:apply>
							</ml:apply>
						</ml:apply>
					</math>
				</region>
				<region region-id="186542" left="66" top="16122" width="405.75" height="172.5" align-x="66" align-y="16122" show-border="true" show-highlight="true" is-protected="true" z-order="0" background-color="#c0c0c0" tag="">
					<picture>
						<png item-idref="653" display-width="393.75" display-height="160.5"/>
					</picture>
				</region>
				<region region-id="186543" left="102" top="16305" width="343.5" height="11.25" align-x="117" align-y="16314" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Typical mild reinforcement in ends of 54" Florida I-Beam (Bar 5A shown in blue)</p>
					</text>
				</region>
				<region region-id="186602" left="6" top="16329" width="50.25" height="11.25" align-x="16.5" align-y="16338" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Input values</p>
					</text>
				</region>
				<region region-id="186544" left="6" top="16353" width="111" height="21" align-x="78.75" align-y="16368" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#80ff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="s.mild.long.end.top">A</ml:id>
							<ml:unitOverride>
								<ml:apply>
									<ml:pow/>
									<ml:id xml:space="preserve">in</ml:id>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>1.5800000000000003</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="inch" power-numerator="2"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="true" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="187692" left="174" top="16359" width="100.5" height="15" align-x="240.75" align-y="16368" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#80ff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="strand.partial.ps">Dia</ml:id>
							<ml:unitOverride>
								<ml:id xml:space="preserve">in</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>0.37499999999999994</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="inch"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="186546" left="6" top="16383" width="79.5" height="15" align-x="54.75" align-y="16392" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#80ff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="long.end.top">L</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>16</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="foot"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="187693" left="174" top="16383" width="94.5" height="15" align-x="250.5" align-y="16392" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#80ff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="partial.ps">NoStrands</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:real>4</ml:real>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="186547" left="6" top="16407" width="90.75" height="15" align-x="78.75" align-y="16416" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#80ff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="long.end.top">BarSize</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:real>5</ml:real>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="187694" left="174" top="16400.25" width="362.25" height="27.75" align-x="222.75" align-y="16416" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="ps.long.top">A</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve" subscript="partial.ps">NoStrands</ml:id>
									<ml:apply>
										<ml:id xml:space="preserve">if</ml:id>
										<ml:sequence>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve" subscript="strand.partial.ps">Dia</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:div/>
														<ml:real>3</ml:real>
														<ml:real>8</ml:real>
													</ml:apply>
													<ml:id xml:space="preserve">in</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:real>0.085</ml:real>
												<ml:apply>
													<ml:pow/>
													<ml:id xml:space="preserve">in</ml:id>
													<ml:real>2</ml:real>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:real>0.153</ml:real>
												<ml:apply>
													<ml:pow/>
													<ml:id xml:space="preserve">in</ml:id>
													<ml:real>2</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:sequence>
									</ml:apply>
								</ml:apply>
								<ml:unitOverride>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve">in</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>0.34</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch" power-numerator="2"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="186604" left="6" top="16449" width="378.75" height="11.25" align-x="24" align-y="16458" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Florida specific minimum reinforcement requirements from the Structures Design Guidelines. </p>
					</text>
				</region>
				<region region-id="187705" left="6" top="16470" width="339" height="91.5" align-x="6" align-y="16470" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<picture>
						<png item-idref="654" display-width="337.5" display-height="90"/>
					</picture>
				</region>
				<region region-id="186548" left="6" top="16569" width="544.5" height="131.25" align-x="37.5" align-y="16584" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="s.min">A</ml:id>
							<ml:program>
								<ml:ifThen>
									<ml:parens>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">BeamType</ml:id>
											<ml:str xml:space="preserve">TypeII</ml:str>
										</ml:apply>
									</ml:parens>
									<ml:apply>
										<ml:mult/>
										<ml:real>0.79</ml:real>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">in</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:plus/>
												<ml:parens>
													<ml:apply>
														<ml:equal/>
														<ml:id xml:space="preserve">BeamType</ml:id>
														<ml:str xml:space="preserve">FIB36</ml:str>
													</ml:apply>
												</ml:parens>
												<ml:parens>
													<ml:apply>
														<ml:equal/>
														<ml:id xml:space="preserve">BeamType</ml:id>
														<ml:str xml:space="preserve">FIB45</ml:str>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">BeamType</ml:id>
													<ml:str xml:space="preserve">FIB54</ml:str>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:parens>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:str xml:space="preserve">FIB63</ml:str>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>1.50</ml:real>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">in</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:plus/>
										<ml:parens>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:str xml:space="preserve">FIB72</ml:str>
											</ml:apply>
										</ml:parens>
										<ml:parens>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:str xml:space="preserve">FIB78</ml:str>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>2.10</ml:real>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">in</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:plus/>
										<ml:parens>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:str xml:space="preserve">FIB84</ml:str>
											</ml:apply>
										</ml:parens>
										<ml:parens>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:str xml:space="preserve">FIB96</ml:str>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>2.30</ml:real>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">in</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:plus/>
												<ml:parens>
													<ml:apply>
														<ml:equal/>
														<ml:id xml:space="preserve">BeamType</ml:id>
														<ml:str xml:space="preserve">FUB48</ml:str>
													</ml:apply>
												</ml:parens>
												<ml:parens>
													<ml:apply>
														<ml:equal/>
														<ml:id xml:space="preserve">BeamType</ml:id>
														<ml:str xml:space="preserve">FUB54</ml:str>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">BeamType</ml:id>
													<ml:str xml:space="preserve">FUB63</ml:str>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:parens>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:str xml:space="preserve">FUB72</ml:str>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>2.70</ml:real>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">in</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:ifThen>
								<ml:otherwise>
									<ml:apply>
										<ml:mult/>
										<ml:real>100</ml:real>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">in</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="186549" left="6" top="16719" width="161.25" height="21" align-x="96" align-y="16734" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="s.long.end.top.reqd.SDG">A</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:id xml:space="preserve" subscript="s.min">A</ml:id>
								<ml:unitOverride>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve">in</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>1.5</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch" power-numerator="2"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="186550" left="6" top="16761" width="53.25" height="15" align-x="32.25" align-y="16770" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="beam">h</ml:id>
							<ml:unitOverride>
								<ml:id xml:space="preserve">in</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>36</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="inch"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="186551" left="6" top="16784.25" width="200.25" height="39.75" align-x="58.5" align-y="16806" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="top.beam.rel">c</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">max</ml:id>
								<ml:sequence>
									<ml:real>0</ml:real>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:mult/>
											<ml:id xml:space="preserve" subscript="beam">h</ml:id>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="top.beam.rel">f</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="top.beam.rel">f</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="bot.beam.rel">f</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="186552" left="6" top="16842" width="510" height="134.25" align-x="6" align-y="16842" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f1f1f1" tag="">
					<plot disable-calc="false" item-idref="655"/>
				</region>
				<region region-id="186553" left="6" top="16989" width="255" height="11.25" align-x="25.5" align-y="16998" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Determine the location of the maximum tensile stress at release</p>
					</text>
				</region>
				<region region-id="186554" left="6" top="17007" width="105.75" height="15" align-x="75" align-y="17016" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:id xml:space="preserve">max</ml:id>
								<ml:id xml:space="preserve" subscript="top.beam.rel">f</ml:id>
							</ml:apply>
							<ml:unitOverride>
								<ml:id xml:space="preserve">psi</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>308.36089613572432</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="pounds_per_sq_inch"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="0" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="186555" left="6" top="17037" width="284.25" height="35.25" align-x="106.5" align-y="17046" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">IndexMaxStressTopRel</ml:id>
							<ml:for>
								<ml:id xml:space="preserve">i</ml:id>
								<ml:range>
									<ml:real>0</ml:real>
									<ml:real>50</ml:real>
								</ml:range>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="top.beam.rel">f</ml:id>
											<ml:id xml:space="preserve">i</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve">max</ml:id>
											<ml:id xml:space="preserve" subscript="top.beam.rel">f</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:return>
										<ml:id xml:space="preserve">i</ml:id>
									</ml:return>
								</ml:ifThen>
							</ml:for>
						</ml:define>
					</math>
				</region>
				<region region-id="186556" left="312" top="17037" width="117" height="12.75" align-x="411" align-y="17046" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">IndexMaxStressTopRel</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:real>3</ml:real>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="186557" left="6" top="17085" width="266.25" height="18" align-x="101.25" align-y="17094" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="max.stress.top.rel">Location</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve">Location</ml:id>
									<ml:id xml:space="preserve">IndexMaxStressTopRel</ml:id>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>2.7380000000000004</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="foot"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="186558" left="6" top="17127" width="411.75" height="11.25" align-x="25.5" align-y="17136" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Determine values at location of maximum tensile stress at release - for inspection / checking purposes</p>
					</text>
				</region>
				<region region-id="186559" left="6" top="17151" width="142.5" height="12.75" align-x="24" align-y="17160" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">idx</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:id xml:space="preserve">IndexMaxStressTopRel</ml:id>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:real>3</ml:real>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="186560" left="6" top="17181" width="143.25" height="18.75" align-x="48.75" align-y="17190" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="ci.top.max">f</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve" subscript="top.beam.rel">f</ml:id>
									<ml:id xml:space="preserve">idx</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">psi</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>308.36089613572432</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="pounds_per_sq_inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
						<resultFormat numeric-only="true">
							<general precision="0" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="186561" left="6" top="17211" width="111.75" height="18.75" align-x="19.5" align-y="17220" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="i">c</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve" subscript="top.beam.rel">c</ml:id>
									<ml:id xml:space="preserve">idx</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>3.367734036046242</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="186562" left="6" top="17253" width="156" height="11.25" align-x="13.5" align-y="17262" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Use an average stress over 3 locations</p>
					</text>
				</region>
				<region region-id="186563" left="6" top="17275.5" width="282.75" height="58.5" align-x="61.5" align-y="17322" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="ci.top.max.avg">f</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:tryCatch>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:summation/>
											<ml:lambda>
												<ml:boundVars>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:boundVars>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="top.beam.rel">f</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
											</ml:lambda>
											<ml:bounds>
												<ml:apply>
													<ml:minus/>
													<ml:id xml:space="preserve">idx</ml:id>
													<ml:real>1</ml:real>
												</ml:apply>
												<ml:apply>
													<ml:plus/>
													<ml:id xml:space="preserve">idx</ml:id>
													<ml:real>1</ml:real>
												</ml:apply>
											</ml:bounds>
										</ml:apply>
										<ml:real>3</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="top.beam.rel">f</ml:id>
										<ml:id xml:space="preserve">idx</ml:id>
									</ml:apply>
								</ml:tryCatch>
								<ml:unitOverride>
									<ml:id xml:space="preserve">psi</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>271.14309630927852</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="pounds_per_sq_inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
						<resultFormat numeric-only="true">
							<general precision="0" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="186566" left="6" top="17358" width="514.5" height="176.25" align-x="6" align-y="17358" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f1f1f1" tag="">
					<plot disable-calc="false" item-idref="656"/>
				</region>
				<region region-id="186567" left="6" top="17547" width="350.25" height="11.25" align-x="22.5" align-y="17556" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">determine the tensile force in the beam at location of maximum tensile stress at release</p>
					</text>
				</region>
				<region region-id="186568" left="6" top="17569.5" width="398.25" height="514.5" align-x="66.75" align-y="17604" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:matrix rows="4" cols="1">
								<ml:id xml:space="preserve">Tforce</ml:id>
								<ml:id xml:space="preserve">Ttrapizoid</ml:id>
								<ml:id xml:space="preserve" subscript="trapizoid">fci</ml:id>
								<ml:id xml:space="preserve">ytrapizoid</ml:id>
							</ml:matrix>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve" subscript="force">T</ml:id>
									<ml:apply>
										<ml:mult/>
										<ml:real>0</ml:real>
										<ml:id xml:space="preserve">kip</ml:id>
									</ml:apply>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:range>
										<ml:real>1</ml:real>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:id xml:space="preserve">rows</ml:id>
												<ml:id xml:space="preserve">TrapShapes</ml:id>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:range>
									<ml:program>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">yend</ml:id>
												<ml:id xml:space="preserve">j</ml:id>
											</ml:apply>
											<ml:parens>
												<ml:apply>
													<ml:summation/>
													<ml:lambda>
														<ml:boundVars>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:boundVars>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">TrapShapes</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">i</ml:id>
																<ml:real>1</ml:real>
															</ml:sequence>
														</ml:apply>
													</ml:lambda>
													<ml:bounds>
														<ml:real>0</ml:real>
														<ml:id xml:space="preserve">j</ml:id>
													</ml:bounds>
												</ml:apply>
											</ml:parens>
										</ml:localDefine>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">ymid</ml:id>
												<ml:id xml:space="preserve">j</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:plus/>
												<ml:parens>
													<ml:apply>
														<ml:summation/>
														<ml:lambda>
															<ml:boundVars>
																<ml:id xml:space="preserve">i</ml:id>
															</ml:boundVars>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">TrapShapes</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">i</ml:id>
																	<ml:real>1</ml:real>
																</ml:sequence>
															</ml:apply>
														</ml:lambda>
														<ml:bounds>
															<ml:real>0</ml:real>
															<ml:apply>
																<ml:minus/>
																<ml:id xml:space="preserve">j</ml:id>
																<ml:real>1</ml:real>
															</ml:apply>
														</ml:bounds>
													</ml:apply>
