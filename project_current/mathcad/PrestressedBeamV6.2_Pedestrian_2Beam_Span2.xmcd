												<ml:id xml:space="preserve">substr</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">BeamType</ml:id>
													<ml:real>6</ml:real>
													<ml:real>2</ml:real>
												</ml:sequence>
											</ml:apply>
										</ml:apply>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
									<ml:real>0</ml:real>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="175941" left="426" top="9135" width="73.5" height="15" align-x="472.5" align-y="9144" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
