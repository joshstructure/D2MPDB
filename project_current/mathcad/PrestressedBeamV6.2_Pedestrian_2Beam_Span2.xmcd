				<region region-id="183461" left="6" top="13563" width="372" height="107.25" align-x="141.75" align-y="13572" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">IsSectionNonCompControlled?</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
