				<region region-id="183911" left="6" top="10863" width="186" height="108" align-x="62.25" align-y="10872" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
