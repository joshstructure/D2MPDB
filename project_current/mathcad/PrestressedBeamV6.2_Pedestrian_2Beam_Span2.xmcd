				<region region-id="145327" left="6" top="8561.25" width="507" height="180" align-x="82.5" align-y="8570.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="Operating.Shear">HL93</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">r</ml:id>
									<ml:apply>
										<ml:indexer/>
										<ml:apply>
											<ml:id xml:space="preserve">fFindMinShearRF</ml:id>
											<ml:id xml:space="preserve" subscript="shear.StrengthI.op">RF</ml:id>
										</ml:apply>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:localDefine>
								<ml:matrix rows="4" cols="3">
									<ml:str xml:space="preserve">φC</ml:str>
									<ml:str xml:space="preserve">γDL</ml:str>
									<ml:str xml:space="preserve">γLL</ml:str>
									<ml:str xml:space="preserve">RF</ml:str>
									<ml:apply>
										<ml:id xml:space="preserve">Round</ml:id>
										<ml:sequence>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:mult/>
															<ml:id xml:space="preserve" subscript="c">ϕ</ml:id>
															<ml:id xml:space="preserve" subscript="s">ϕ</ml:id>
														</ml:apply>
														<ml:id xml:space="preserve" subscript="shr">ϕ</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="n.StrengthI">V</ml:id>
														<ml:id xml:space="preserve">r</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:id xml:space="preserve">kip</ml:id>
											</ml:apply>
											<ml:real>0.1</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">Round</ml:id>
										<ml:sequence>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:div/>
													<ml:real>1</ml:real>
													<ml:id xml:space="preserve">kip</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:vectorSum/>
													<ml:matrix rows="3" cols="1">
														<ml:apply>
															<ml:mult/>
															<ml:real>1.25</ml:real>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="dl.non.comp">V</ml:id>
																<ml:id xml:space="preserve">r</ml:id>
															</ml:apply>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:real>1.25</ml:real>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="dl.comp.str">V</ml:id>
																<ml:id xml:space="preserve">r</ml:id>
															</ml:apply>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:real>1.50</ml:real>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="dl.future.ws">V</ml:id>
																<ml:id xml:space="preserve">r</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:matrix>
												</ml:apply>
											</ml:apply>
											<ml:real>0.1</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">Round</ml:id>
										<ml:sequence>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:mult/>
													<ml:real>1.35</ml:real>
													<ml:parens>
														<ml:apply>
															<ml:mult/>
															<ml:parens>
																<ml:apply>
																	<ml:plus/>
																	<ml:apply>
																		<ml:mult/>
																		<ml:real>1.33</ml:real>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve" subscript="truck.pos">V</ml:id>
																			<ml:id xml:space="preserve">r</ml:id>
																		</ml:apply>
																	</ml:apply>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve" subscript="lane.pos">V</ml:id>
																		<ml:id xml:space="preserve">r</ml:id>
																	</ml:apply>
																</ml:apply>
															</ml:parens>
															<ml:id xml:space="preserve" subscript="shear">g</ml:id>
														</ml:apply>
													</ml:parens>
												</ml:apply>
												<ml:id xml:space="preserve">kip</ml:id>
											</ml:apply>
											<ml:real>0.1</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="shear.StrengthI.op">RF</ml:id>
										<ml:id xml:space="preserve">r</ml:id>
									</ml:apply>
									<ml:str xml:space="preserve">factored resistance (kip)........</ml:str>
									<ml:str xml:space="preserve">factored dead load (kip).......</ml:str>
									<ml:str xml:space="preserve">factored live load (kip)..........</ml:str>
									<ml:str xml:space="preserve">HL93 operating rating factor</ml:str>
								</ml:matrix>
							</ml:program>
