				<region region-id="177549" left="6" top="5216.25" width="522" height="27.75" align-x="12" align-y="5226" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">The first term in the equation <region region-id="140879" left="132" top="5217" width="25.5" height="15" align-x="144" align-y="5226" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" subscript="pLT" xmlns:ml="http://schemas.mathsoft.com/math30">Δf</ml:id>
								</math>
							</region> estimates creep, the second estimates shrinkage and the last estimates total relaxation loss. </p>
					</text>
				</region>
				<region region-id="150980" left="444" top="5235" width="80.25" height="11.25" align-x="444" align-y="5244" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#f00" tag="">
