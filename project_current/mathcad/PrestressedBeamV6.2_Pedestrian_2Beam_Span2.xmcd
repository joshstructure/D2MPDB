				<region region-id="134698" left="396" top="4599" width="128.25" height="33.75" align-x="396" align-y="4608" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">b vector gives the distance from the section to the center line of the last bearing</p>
					</text>
				</region>
				<region region-id="203016" left="6" top="4650.75" width="534" height="14.25" align-x="6" align-y="4662" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="heading" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Pedestrian load per beam - simple span and longitudinal envelopes</p>
					</text>
				</region>
				<region region-id="203017" left="6" top="4683" width="534" height="33.75" align-x="6" align-y="4692" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">PL is applied only between bearing centers. Positive/negative shear envelopes load the corresponding adverse influence-line portion. Mshr.PL is the moment from that same load pattern. The original vehicle generator below remains available in Vehicle mode.</p>
					</text>
				</region>
				<region region-id="203050" left="6" top="4764" width="445.5" height="30" align-x="28.5" align-y="4782" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="PL">w</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:id xml:space="preserve">PedMode</ml:id>
										<ml:apply>
											<ml:id xml:space="preserve">if</ml:id>
											<ml:sequence>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">#Beams</ml:id>
													<ml:real>2</ml:real>
												</ml:apply>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve" subscript="PL">q</ml:id>
														<ml:id xml:space="preserve" subscript="PL">W</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve">#Beams</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:id xml:space="preserve">error</ml:id>
													<ml:str xml:space="preserve">Pedestrian mode requires 2 beams</ml:str>
												</ml:apply>
											</ml:sequence>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:real>0</ml:real>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve">kip</ml:id>
												<ml:id xml:space="preserve">ft</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:sequence>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">plf</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>540</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="pounds_force_per_linear_foot"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
					<rendering item-idref="339"/>
				</region>
				<region region-id="203019" left="6" top="4803" width="282" height="18.75" align-x="29.25" align-y="4812" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="PL">x</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">min</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:id xml:space="preserve">max</ml:id>
											<ml:sequence>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">Location</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve">BearingDistance</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:real>0</ml:real>
													<ml:id xml:space="preserve">ft</ml:id>
												</ml:apply>
											</ml:sequence>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="c.c.bearings">L</ml:id>
									</ml:sequence>
								</ml:apply>
							</ml:eval>
						</ml:define>
						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="true"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
					<rendering item-idref="340"/>
				</region>
				<region region-id="203020" left="6" top="4832.25" width="192" height="33.75" align-x="47.25" align-y="4854" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#ffc0cb" tag="Pedestrian modification">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="PL.pos">M</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult/>
											<ml:id xml:space="preserve" subscript="PL">w</ml:id>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="PL">x</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:parens>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve" subscript="c.c.bearings">L</ml:id>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="PL">x</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:eval>
						</ml:define>
					</math>
					<rendering item-idref="341"/>
				</region>
				<region region-id="203021" left="6" top="4893" width="78.75" height="18.75" align-x="47.25" align-y="4902" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="PL.neg">M</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:real>0</ml:real>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve">kip</ml:id>
									<ml:id xml:space="preserve">ft</ml:id>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
					<rendering item-idref="342"/>
				</region>
				<region region-id="203022" left="6" top="4916.25" width="493.5" height="42" align-x="44.25" align-y="4944" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="PL.pos">V</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:or/>
										<ml:apply>
											<ml:lessThan/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">Location</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve">BearingDistance</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:greaterThan/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">Location</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve">BearingDistance</ml:id>
												<ml:id xml:space="preserve" subscript="c.c.bearings">L</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>0</ml:real>
										<ml:id xml:space="preserve">kip</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:mult/>
											<ml:id xml:space="preserve" subscript="PL">w</ml:id>
											<ml:apply>
												<ml:pow/>
												<ml:parens>
													<ml:apply>
														<ml:minus/>
														<ml:id xml:space="preserve" subscript="c.c.bearings">L</ml:id>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="PL">x</ml:id>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:parens>
												<ml:real>2</ml:real>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:real>2</ml:real>
											<ml:id xml:space="preserve" subscript="c.c.bearings">L</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
