				<region region-id="175967" left="186" top="10293" width="161.25" height="123.75" align-x="186" align-y="10302" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">fProp(q) function produces the following information based on the reference axis at zero</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<inlineAttr underline="false" line-through="false">
								<c val="#00f">
									<sp count="11"/>Area</c>
							</inlineAttr>
						</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<inlineAttr underline="false" line-through="false">
								<c val="#00f">
									<sp count="11"/>First Moment Area</c>
							</inlineAttr>
						</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<inlineAttr underline="false" line-through="false">
								<c val="#00f">
									<sp count="11"/>Inertia</c>
							</inlineAttr>
						</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<inlineAttr underline="false" line-through="false">
								<c val="#00f">
									<sp count="12"/>perimeter</c>
							</inlineAttr>
						</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<inlineAttr underline="false" line-through="false">
								<c val="#00f">
									<sp count="11"/>highest elevation</c>
							</inlineAttr>
						</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<c val="#00f">
								<inlineAttr underline="false" line-through="false">
									<sp count="11"/>lowest elevation</inlineAttr>
							</c>
						</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<inlineAttr underline="false" line-through="false">
								<c val="#00f">
									<sp count="11"/>distance to centroid from origin</c>
							</inlineAttr>
						</p>
