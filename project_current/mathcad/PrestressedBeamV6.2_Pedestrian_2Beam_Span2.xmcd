					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Since there are two sections that make up the comp beam, the beam and the slab.</p>
					</text>
				</region>
				<region region-id="175927" left="6" top="8487" width="166.5" height="15" align-x="29.25" align-y="8496" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
