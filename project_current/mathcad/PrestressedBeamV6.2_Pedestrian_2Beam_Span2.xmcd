															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="tr">B</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">nc</ml:id>
																	<ml:id xml:space="preserve">n</ml:id>
																</ml:sequence>
															</ml:apply>
														</ml:lambda>
													</ml:apply>
												</ml:parens>
												<ml:real>2</ml:real>
											</ml:apply>
										</ml:apply>
									</ml:apply>
								</ml:parens>
								<ml:apply>
									<ml:pow/>
									<ml:id xml:space="preserve" subscript="d">n</ml:id>
