							</region> or <region region-id="34185" left="438" top="14619" width="47.25" height="12.75" align-x="438" align-y="14628" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:str xml:space="preserve" xmlns:ml="http://schemas.mathsoft.com/math30">Standard</ml:str>
								</math>
							</region> depending on the type of course aggregate used.</p>
					</text>
				</region>
				<region region-id="188025" left="6" top="14648.25" width="231.75" height="33.75" align-x="69" align-y="14664" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="deck.lightweight">γ</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:id xml:space="preserve">str2num</ml:id>
										<ml:id xml:space="preserve">inpγdeckLW</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve">kip</ml:id>
										<ml:apply>
											<ml:pow/>
