								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="pos.StrengthI">Mshr</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:mult/>
									<ml:real>1.75</ml:real>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="dist.live.pos">Mshr</ml:id>
										<ml:id xml:space="preserve">n</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:parens>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:mult/>
											<ml:parens>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="dl.non.comp">M</ml:id>
