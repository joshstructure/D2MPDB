								<ml:parens>
									<ml:apply>
										<ml:id xml:space="preserve">if</ml:id>
										<ml:sequence>
											<ml:apply>
												<ml:greaterThan/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
													<ml:id xml:space="preserve">pi</ml:id>
												</ml:apply>
												<ml:real>0</ml:real>
											</ml:apply>
											<ml:real>0</ml:real>
											<ml:real>1</ml:real>
										</ml:sequence>
