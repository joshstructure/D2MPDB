													<ml:str xml:space="preserve">Stainless Steel</ml:str>
												</ml:apply>
											</ml:parens>
										</ml:apply>
									</ml:parens>
									<ml:parens>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
