					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(The number of S4 stirrups will be calculated<sp count="2"/>internally to extend the stirrups the full length of the beam)</p>
					</text>
				</region>
				<region region-id="149184" left="6" top="2648.25" width="315" height="62.25" align-x="70.5" align-y="2682" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
