				<region region-id="203023" left="6" top="4970.25" width="447" height="42" align-x="44.25" align-y="4998" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="PL.neg">V</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:or/>
										<ml:apply>
											<ml:lessThan/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">Location</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve">BearingDistance</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:greaterThan/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">Location</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve">BearingDistance</ml:id>
												<ml:id xml:space="preserve" subscript="c.c.bearings">L</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
