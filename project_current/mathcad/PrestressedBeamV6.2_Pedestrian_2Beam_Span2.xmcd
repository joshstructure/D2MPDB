													</ml:apply>
												</ml:parens>
												<ml:id xml:space="preserve">BeamSpacing</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:real>2</ml:real>
												<ml:id xml:space="preserve" subscript="e">d</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:otherwise>
								</ml:program>
