				<region region-id="174429" left="6" top="7485" width="360.75" height="33.75" align-x="6" align-y="7494" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#efefef" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">7.<sp count="2"/>For multi-web sections having bottom flanges (voided slab, box beams and U-beams):</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<tab/>a. Strands shall be bonded within 1.0 times the web width projection.<tab/>
						</p>
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">
							<tab/>b. Bond the outer-most strands within the section.</p>
					</text>
				</region>
				<region region-id="174699" left="6" top="7545" width="360.75" height="11.25" align-x="6" align-y="7554" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#efefef" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">a. Strands shall be bonded within 1.0 times the web width projection.<tab/>
						</p>
					</text>
				</region>
				<region region-id="174653" left="6" top="7563" width="69" height="12.75" align-x="39.75" align-y="7572" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">jstartu</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:real>0</ml:real>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:real>0</ml:real>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="174654" left="6" top="7593" width="82.5" height="12.75" align-x="36.75" align-y="7602" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">jendu</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:minus/>
									<ml:real>2</ml:real>
									<ml:real>1</ml:real>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:real>1</ml:real>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="174655" left="6" top="7629" width="288.75" height="111" align-x="120" align-y="7638" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">chkWebDebondedUGirder</ml:id>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:id xml:space="preserve">rows</ml:id>
												<ml:id xml:space="preserve">tendsect</ml:id>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:range>
									<ml:for>
										<ml:id xml:space="preserve">j</ml:id>
										<ml:range>
											<ml:id xml:space="preserve">jstartu</ml:id>
											<ml:id xml:space="preserve">jendu</ml:id>
										</ml:range>
										<ml:program>
											<ml:ifThen>
												<ml:apply>
													<ml:greaterOrEqual/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">tendsect</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">i</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:sequence>
													</ml:apply>
													<ml:real>12</ml:real>
												</ml:apply>
												<ml:continue/>
											</ml:ifThen>
											<ml:ifThen>
												<ml:apply>
													<ml:greaterOrEqual/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">tendsect</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">i</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:sequence>
													</ml:apply>
													<ml:real>10</ml:real>
												</ml:apply>
												<ml:localDefine>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">chk</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">i</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:sequence>
													</ml:apply>
													<ml:real>0</ml:real>
												</ml:localDefine>
											</ml:ifThen>
											<ml:otherwise>
												<ml:localDefine>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">chk</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">i</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:sequence>
													</ml:apply>
													<ml:real>1</ml:real>
												</ml:localDefine>
											</ml:otherwise>
										</ml:program>
									</ml:for>
								</ml:for>
								<ml:id xml:space="preserve">chk</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="174665" left="6" top="7764.75" width="154.5" height="29.25" align-x="118.5" align-y="7782" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">chkWebDebondedUGirder</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="2" cols="2">
									<ml:real>0</ml:real>
									<ml:real>0</ml:real>
									<ml:real>1</ml:real>
									<ml:real>0</ml:real>
								</ml:matrix>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="174663" left="6" top="7833" width="618" height="12.75" align-x="96.75" align-y="7842" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">ChkWebDebondedU</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">fChkMessage</ml:id>
									<ml:sequence>
										<ml:id xml:space="preserve">chkWebDebondedUGirder</ml:id>
										<ml:str xml:space="preserve">debonded strands under the web</ml:str>
									</ml:sequence>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:str xml:space="preserve">No Good, debonded strands under the web</ml:str>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="174702" left="6" top="7875" width="360.75" height="11.25" align-x="6" align-y="7884" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#efefef" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">b. Bond the outer-most strands within the section.</p>
					</text>
				</region>
				<region region-id="174705" left="6" top="7899" width="144" height="12.75" align-x="112.5" align-y="7908" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">ChkBondedAtEndOfRow</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:str xml:space="preserve">OK</ml:str>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="202500" left="6" top="7929" width="343.5" height="33.75" align-x="6" align-y="7938" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#efefef" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">8.<sp count="2"/>For all other sections: (Double T's and slab beams)</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<tab/>a. Debond uniformly across the width of the section.</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<tab/>b. Bond the outer-most strands located within the section, stem, or web.</p>
					</text>
				</region>
				<region region-id="202501" left="6" top="7983" width="141.75" height="12.75" align-x="24.75" align-y="7992" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">BC</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:id xml:space="preserve">BeamCategory</ml:id>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:str xml:space="preserve">I-Beam</ml:str>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="202510" left="6" top="8007" width="367.5" height="45.75" align-x="90" align-y="8016" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">CheckWebPattern</ml:id>
								<ml:real>0</ml:real>
							</ml:apply>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:plus/>
										<ml:parens>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">BC</ml:id>
												<ml:str xml:space="preserve">I-Beam</ml:str>
											</ml:apply>
										</ml:parens>
										<ml:parens>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">BC</ml:id>
												<ml:str xml:space="preserve">InvTBeams</ml:str>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:id xml:space="preserve">ChkWebDebondedI</ml:id>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">BC</ml:id>
										<ml:str xml:space="preserve">FUB</ml:str>
									</ml:apply>
									<ml:id xml:space="preserve">ChkWebDebondedU</ml:id>
								</ml:ifThen>
								<ml:otherwise>
									<ml:str xml:space="preserve">OK</ml:str>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="202503" left="6" top="8073" width="120" height="18" align-x="88.5" align-y="8082" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">CheckWebPattern</ml:id>
								<ml:real>0</ml:real>
							</ml:apply>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:str xml:space="preserve">OK</ml:str>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="202504" left="6" top="8109" width="193.5" height="18" align-x="90" align-y="8118" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">CheckWebPattern</ml:id>
								<ml:real>1</ml:real>
							</ml:apply>
							<ml:id xml:space="preserve">ChkBondedAtEndOfRow</ml:id>
						</ml:define>
					</math>
				</region>
				<region region-id="202505" left="6" top="8139" width="120" height="18" align-x="88.5" align-y="8148" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">CheckWebPattern</ml:id>
								<ml:real>1</ml:real>
							</ml:apply>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:str xml:space="preserve">OK</ml:str>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="173686" left="276" top="8181" width="135.75" height="30" align-x="312.75" align-y="8196" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="ps.total">A</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:vectorSum/>
									<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve">in</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>8.463</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch" power-numerator="2"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="31095" left="6" top="8160" width="81.75" height="78.75" align-x="44.25" align-y="8202" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:matrix rows="5" cols="1">
										<ml:real>5</ml:real>
										<ml:real>0</ml:real>
										<ml:real>10</ml:real>
										<ml:real>0</ml:real>
										<ml:real>0</ml:real>
									</ml:matrix>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="foot"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="31096" left="132" top="8160" width="90" height="78.75" align-x="171" align-y="8202" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
							<ml:unitOverride>
								<ml:apply>
									<ml:pow/>
									<ml:id xml:space="preserve">in</ml:id>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:matrix rows="5" cols="1">
										<ml:real>0.868</ml:real>
										<ml:real>2.821</ml:real>
										<ml:real>0.868</ml:real>
										<ml:real>2.821</ml:real>
										<ml:real>1.085</ml:real>
									</ml:matrix>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="inch" power-numerator="2"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="173683" left="414" top="8277" width="120" height="22.5" align-x="414" align-y="8286" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">strand shape = 1 for straight and 0 for depressed strands</p>
					</text>
				</region>
				<region region-id="173680" left="6" top="8283" width="254.25" height="75.75" align-x="63.75" align-y="8292" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">StrandShape</ml:id>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:id xml:space="preserve">last</ml:id>
											<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
										</ml:apply>
									</ml:range>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:equal/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
													<ml:sequence>
														<ml:id xml:space="preserve">j</ml:id>
														<ml:real>0</ml:real>
													</ml:sequence>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
													<ml:sequence>
														<ml:id xml:space="preserve">j</ml:id>
														<ml:real>1</ml:real>
													</ml:sequence>
												</ml:apply>
											</ml:apply>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">val</ml:id>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:apply>
												<ml:real>1</ml:real>
											</ml:localDefine>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">val</ml:id>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:apply>
												<ml:real>0</ml:real>
											</ml:localDefine>
										</ml:otherwise>
									</ml:program>
								</ml:for>
								<ml:apply>
									<ml:id xml:space="preserve">min</ml:id>
									<ml:id xml:space="preserve">val</ml:id>
								</ml:apply>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="173684" left="336" top="8283" width="74.25" height="12.75" align-x="392.25" align-y="8292" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">StrandShape</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:real>1</ml:real>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="187646" left="6" top="8382.75" width="268.5" height="14.25" align-x="6" align-y="8394" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="heading" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<f size="12">
								<b>Partially Stressed Tendons ("Strand N") </b>
							</f>
						</p>
