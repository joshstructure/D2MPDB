									<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
										<ml:equal/>
										<ml:id xml:space="preserve">Index</ml:id>
										<ml:localDefine>
											<ml:real>0</ml:real>
											<ml:parens>
												<ml:sequence>
													<ml:apply>
														<ml:equal/>
														<ml:id xml:space="preserve">BeamCategory</ml:id>
														<ml:str xml:space="preserve">I-Beam</ml:str>
													</ml:apply>
													<ml:str xml:space="preserve">InvTBeams</ml:str>
													<ml:str xml:space="preserve">DblTBeams</ml:str>
												</ml:sequence>
											</ml:parens>
										</ml:localDefine>
									</ml:apply>
								</math>
							</region>
						</p>
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<region region-id="150532" left="66" top="3897" width="211.5" height="12.75" align-x="111.75" align-y="3906" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f2f2f2" tag="">
								<math optimize="false" disable-calc="false">
									<ml:localDefine xmlns:ml="http://schemas.mathsoft.com/math30">
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">Index</ml:id>
											<ml:real>1</ml:real>
										</ml:apply>
										<ml:sequence>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">BeamCategory</ml:id>
												<ml:str xml:space="preserve">FSB</ml:str>
											</ml:apply>
											<ml:str xml:space="preserve">SlabBeams</ml:str>
										</ml:sequence>
									</ml:localDefine>
								</math>
							</region>
						</p>
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<region region-id="150533" left="66" top="3915" width="154.5" height="12.75" align-x="111.75" align-y="3924" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f2f2f2" tag="">
								<math optimize="false" disable-calc="false">
									<ml:localDefine xmlns:ml="http://schemas.mathsoft.com/math30">
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">Index</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">BeamCategory</ml:id>
											<ml:str xml:space="preserve">FUB</ml:str>
										</ml:apply>
									</ml:localDefine>
								</math>
							</region>
						</p>
					</text>
				</region>
				<region region-id="150463" left="6" top="3897" width="44.25" height="12.75" align-x="32.25" align-y="3906" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:provenance expr-id="1">
