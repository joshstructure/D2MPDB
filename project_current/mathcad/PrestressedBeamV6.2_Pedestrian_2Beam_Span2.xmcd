								<ml:id xml:space="preserve">nt</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:summation/>
								<ml:lambda>
									<ml:boundVars>
										<ml:id xml:space="preserve">qt</ml:id>
									</ml:boundVars>
									<ml:apply>
										<ml:indexer/>
										<ml:parens>
											<ml:apply>
												<ml:matcol/>
												<ml:id xml:space="preserve">d</ml:id>
												<ml:id xml:space="preserve">nt</ml:id>
											</ml:apply>
										</ml:parens>
										<ml:id xml:space="preserve">qt</ml:id>
									</ml:apply>
								</ml:lambda>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="31299" left="138" top="1811.25" width="111.75" height="22.5" align-x="138" align-y="1820.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">total length of the </p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">concentrated load system</p>
					</text>
				</region>
				<region region-id="31300" left="270" top="1804.5" width="155.25" height="50.25" align-x="296.25" align-y="1820.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">inc</ml:id>
								<ml:id xml:space="preserve">nt</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">floor</ml:id>
								<ml:apply>
									<ml:div/>
									<ml:real>300</ml:real>
									<ml:apply>
										<ml:plus/>
										<ml:parens>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:indexer/>
