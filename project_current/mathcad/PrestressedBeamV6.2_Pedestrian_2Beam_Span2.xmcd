				</region>
				<region region-id="148484" left="6" top="3357" width="254.25" height="51" align-x="74.25" align-y="3366" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">InterfaceFactor</ml:id>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:real>6</ml:real>
									</ml:range>
									<ml:localDefine>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">factor</ml:id>
											<ml:id xml:space="preserve">j</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve">str2num</ml:id>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">outStirrupData</ml:id>
												<ml:sequence>
													<ml:real font="0">3</ml:real>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:sequence>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:for>
								<ml:id xml:space="preserve">factor</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="148488" left="312" top="3357.75" width="185.25" height="18" align-x="384" align-y="3372" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:transpose/>
								<ml:id xml:space="preserve">InterfaceFactor</ml:id>
							</ml:apply>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="1" cols="7">
									<ml:real>0.25</ml:real>
									<ml:real>0.5</ml:real>
									<ml:real>1</ml:real>
									<ml:real>1</ml:real>
									<ml:real>1</ml:real>
									<ml:real>1</ml:real>
									<ml:real>1</ml:real>
								</ml:matrix>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="32152" left="6" top="3441" width="174" height="11.25" align-x="6" align-y="3450" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Stirrup sizes and spacings used in analysis</p>
					</text>
				</region>
				<region region-id="30701" left="6" top="3459" width="418.5" height="11.25" align-x="6" align-y="3468" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">The number of spaces for the S4 stirrup is calculated by the program to complete the half beam length.</p>
					</text>
				</region>
				<region region-id="27875" left="6" top="3477" width="43.5" height="11.25" align-x="6" align-y="3486" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">A1 stirrup </p>
					</text>
				</region>
				<region region-id="27876" left="6" top="3495" width="43.5" height="11.25" align-x="6" align-y="3504" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">A2 stirrup </p>
					</text>
				</region>
				<region region-id="27877" left="6" top="3513" width="43.5" height="11.25" align-x="6" align-y="3522" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">A3 stirrup </p>
					</text>
				</region>
				<region region-id="148481" left="156" top="3475.5" width="101.25" height="111.75" align-x="222" align-y="3534" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f1f1f1" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">NumberSpaces</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="7" cols="1">
									<ml:real>2</ml:real>
									<ml:real>2</ml:real>
									<ml:real>12</ml:real>
									<ml:real>30</ml:real>
									<ml:real>20</ml:real>
									<ml:real>5</ml:real>
									<ml:real>8</ml:real>
								</ml:matrix>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="148482" left="282" top="3475.5" width="83.25" height="111.75" align-x="314.25" align-y="3534" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f1f1f1" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="stirrup">A</ml:id>
							<ml:unitOverride>
								<ml:apply>
									<ml:pow/>
									<ml:id xml:space="preserve">in</ml:id>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:matrix rows="7" cols="1">
										<ml:real>1.24</ml:real>
										<ml:real>0.62</ml:real>
										<ml:real>0.31</ml:real>
										<ml:real>0.31</ml:real>
										<ml:real>0.31</ml:real>
										<ml:real>0.31</ml:real>
										<ml:real>0.31</ml:real>
									</ml:matrix>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="inch" power-numerator="2"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="148494" left="384" top="3475.5" width="108.75" height="111.75" align-x="450.75" align-y="3534" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f1f1f1" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">InterfaceFactor</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="7" cols="1">
									<ml:real>0.25</ml:real>
									<ml:real>0.5</ml:real>
									<ml:real>1</ml:real>
									<ml:real>1</ml:real>
									<ml:real>1</ml:real>
									<ml:real>1</ml:real>
									<ml:real>1</ml:real>
								</ml:matrix>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="27878" left="6" top="3531" width="40.5" height="11.25" align-x="6" align-y="3540" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">S1 stirrup</p>
					</text>
				</region>
				<region region-id="27919" left="78" top="3481.5" width="51.75" height="111.75" align-x="87.75" align-y="3540" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f1f1f1" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">s</ml:id>
							<ml:unitOverride>
								<ml:id xml:space="preserve">in</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:matrix rows="7" cols="1">
										<ml:real>3.5</ml:real>
										<ml:real>3.5</ml:real>
										<ml:real>2.9999999999999996</ml:real>
										<ml:real>5.9999999999999991</ml:real>
										<ml:real>9</ml:real>
										<ml:real>11.999999999999998</ml:real>
										<ml:real>18</ml:real>
									</ml:matrix>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="inch"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="27879" left="6" top="3549" width="40.5" height="11.25" align-x="6" align-y="3558" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">S2 stirrup</p>
					</text>
				</region>
				<region region-id="27880" left="6" top="3567" width="40.5" height="11.25" align-x="6" align-y="3576" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">S3 stirrup</p>
					</text>
				</region>
				<region region-id="27881" left="6" top="3585" width="40.5" height="11.25" align-x="6" align-y="3594" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">S4 stirrup</p>
					</text>
				</region>
				<region region-id="148496" left="456" top="3597" width="68.25" height="12.75" align-x="501.75" align-y="3606" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f1f1f1" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">EndSpace</ml:id>
							<ml:unitOverride>
								<ml:id xml:space="preserve">in</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>2.9999999999999996</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="inch"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
			</area>
			<rendering item-idref="657"/>
		</region>
		<region region-id="202681" left="0" top="10356.75" width="6008.25" align-x="0" align-y="10356.75" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#c0c0c0" tag="" height="3518.25">
			<area is-collapsed="true" name="   Shear Demand/Capacity and Longitudinal Steel Demand/Capacity" show-name="true" show-border="true" show-icon="true" show-timestamp="true" allow-expand="false" is-locked="false" timestamp="" top-lock-id="30755" bottom-lock-id="30757">
				<region region-id="176206" left="6" top="27" width="242.25" height="11.25" align-x="6" align-y="36" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">stirrup area and spacing per Location n (up to half span)</p>
					</text>
				</region>
				<region region-id="179731" left="6" top="57" width="341.25" height="167.25" align-x="39.75" align-y="66" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="v.prov">A</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">y</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:range>
										<ml:real>1</ml:real>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:id xml:space="preserve">last</ml:id>
													<ml:id xml:space="preserve">Location</ml:id>
												</ml:apply>
												<ml:real>2</ml:real>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:range>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:greaterThan/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Location</ml:id>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:summation/>
														<ml:lambda>
															<ml:boundVars>
																<ml:id xml:space="preserve">x</ml:id>
															</ml:boundVars>
															<ml:parens>
																<ml:apply>
																	<ml:mult/>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve">s</ml:id>
																		<ml:id xml:space="preserve">x</ml:id>
																	</ml:apply>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve">NumberSpaces</ml:id>
																		<ml:id xml:space="preserve">x</ml:id>
																	</ml:apply>
																</ml:apply>
															</ml:parens>
														</ml:lambda>
														<ml:bounds>
															<ml:real>0</ml:real>
															<ml:id xml:space="preserve">y</ml:id>
														</ml:bounds>
													</ml:apply>
													<ml:id xml:space="preserve">EndSpace</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:localDefine>
												<ml:id xml:space="preserve">y</ml:id>
												<ml:apply>
													<ml:plus/>
													<ml:id xml:space="preserve">y</ml:id>
													<ml:real>1</ml:real>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
										<ml:localDefine>
											<ml:id xml:space="preserve">y</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">min</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">y</ml:id>
													<ml:apply>
														<ml:id xml:space="preserve">last</ml:id>
														<ml:id xml:space="preserve">s</ml:id>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">stirarea</ml:id>
												<ml:id xml:space="preserve">j</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="stirrup">A</ml:id>
													<ml:id xml:space="preserve">y</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">s</ml:id>
													<ml:id xml:space="preserve">y</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:for>
								<ml:id xml:space="preserve">stirarea</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="176208" left="282" top="249" width="249" height="33.75" align-x="282" align-y="258" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">use the shear reinforcement provided at the critical shear location for the reinforcement between the beam end and the critical shear location.</p>
					</text>
				</region>
				<region region-id="176209" left="6" top="255" width="209.25" height="18.75" align-x="58.5" align-y="264" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="v.prov.shr">A</ml:id>
								<ml:id xml:space="preserve">hs</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:lessThan/>
										<ml:id xml:space="preserve">hs</ml:id>
										<ml:id xml:space="preserve">ishear</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="v.prov">A</ml:id>
										<ml:id xml:space="preserve">ishear</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="v.prov">A</ml:id>
										<ml:id xml:space="preserve">hs</ml:id>
									</ml:apply>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="176210" left="6" top="300" width="516" height="161.25" align-x="6" align-y="300" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f1f1f1" tag="">
					<plot disable-calc="false" item-idref="658"/>
				</region>
				<region region-id="179732" left="6" top="489" width="332.25" height="146.25" align-x="30.75" align-y="498" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="prov">s</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">y</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:range>
										<ml:real>1</ml:real>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:id xml:space="preserve">last</ml:id>
													<ml:id xml:space="preserve">Location</ml:id>
												</ml:apply>
												<ml:real>2</ml:real>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:range>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:greaterThan/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Location</ml:id>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:summation/>
														<ml:lambda>
															<ml:boundVars>
																<ml:id xml:space="preserve">x</ml:id>
															</ml:boundVars>
															<ml:parens>
																<ml:apply>
																	<ml:mult/>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve">s</ml:id>
																		<ml:id xml:space="preserve">x</ml:id>
																	</ml:apply>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve">NumberSpaces</ml:id>
																		<ml:id xml:space="preserve">x</ml:id>
																	</ml:apply>
																</ml:apply>
															</ml:parens>
														</ml:lambda>
														<ml:bounds>
															<ml:real>0</ml:real>
