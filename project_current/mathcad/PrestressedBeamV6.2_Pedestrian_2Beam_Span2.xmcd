				<region region-id="181213" left="6" top="3135" width="356.25" height="66.75" align-x="51" align-y="3144" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">fDefl</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">Cr</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">n</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:id xml:space="preserve">last</ml:id>
											<ml:id xml:space="preserve">Location</ml:id>
										</ml:apply>
									</ml:range>
									<ml:localDefine>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">Defl</ml:id>
											<ml:id xml:space="preserve">n</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:plus/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="final">Defl</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:parens>
														<ml:apply>
															<ml:div/>
															<ml:apply>
																<ml:plus/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve" subscript="final">Defl</ml:id>
																	<ml:id xml:space="preserve">n</ml:id>
																</ml:apply>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve" subscript="rel">Defl</ml:id>
																	<ml:id xml:space="preserve">n</ml:id>
																</ml:apply>
															</ml:apply>
															<ml:real>2</ml:real>
														</ml:apply>
													</ml:parens>
													<ml:id xml:space="preserve">Cr</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="bmwt">Defl</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:real>1</ml:real>
														<ml:id xml:space="preserve">Cr</ml:id>
													</ml:apply>
												</ml:parens>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:for>
								<ml:id xml:space="preserve">Defl</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
