									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:parens>
											<ml:apply>
												<ml:minus/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="tr.initial">I</ml:id>
													<ml:sequence>
														<ml:real>0</ml:real>
