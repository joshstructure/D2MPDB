								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:lessThan/>
										<ml:apply>
											<ml:id xml:space="preserve">max</ml:id>
											<ml:id xml:space="preserve" subscript="max.web">DC_f</ml:id>
										</ml:apply>
										<ml:real>1.0</ml:real>
									</ml:apply>
									<ml:str xml:space="preserve">OK</ml:str>
									<ml:str xml:space="preserve">No Good!</ml:str>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
