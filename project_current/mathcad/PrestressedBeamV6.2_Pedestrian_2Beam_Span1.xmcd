				</region>
				<region region-id="135581" left="6" top="93" width="46.5" height="15" align-x="21" align-y="102" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
