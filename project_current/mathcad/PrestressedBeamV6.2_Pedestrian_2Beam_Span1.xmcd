				<region region-id="145350" left="6" top="8001" width="490.5" height="11.25" align-x="6" align-y="8010" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">QUICK CHECK: Factored Components of the Rating Factor Equation for Design Operating Rating</p>
					</text>
				</region>
				<region region-id="145323" left="6" top="8031" width="432" height="123" align-x="96" align-y="8040" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="Operating.Service.III">HL93</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">r</ml:id>
									<ml:apply>
										<ml:indexer/>
										<ml:apply>
											<ml:id xml:space="preserve">fFindMinMomentRF</ml:id>
											<ml:id xml:space="preserve" subscript="tension.ServiceIII.inv">RF</ml:id>
										</ml:apply>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:localDefine>
								<ml:matrix rows="4" cols="3">
									<ml:str xml:space="preserve">C</ml:str>
									<ml:str xml:space="preserve">DL</ml:str>
									<ml:str xml:space="preserve">LL</ml:str>
									<ml:str xml:space="preserve">RF</ml:str>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="R.ten.design.op.permit">f</ml:id>
											<ml:id xml:space="preserve">r</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">ksi</ml:id>
											<ml:real>-1</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:parens>
											<ml:apply>
												<ml:plus/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="bot.beam.DC">f</ml:id>
													<ml:id xml:space="preserve">r</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="bot.beam.DW">f</ml:id>
													<ml:id xml:space="preserve">r</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:parens>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">ksi</ml:id>
											<ml:real>-1</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult/>
											<ml:real>0.8</ml:real>
											<ml:parens>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="bot.beam.LL">f</ml:id>
													<ml:id xml:space="preserve">r</ml:id>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">ksi</ml:id>
											<ml:real>-1</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="tension.ServiceIII.op">RF</ml:id>
										<ml:id xml:space="preserve">r</ml:id>
									</ml:apply>
									<ml:str xml:space="preserve">resistance, operating (ksi).....</ml:str>
									<ml:str xml:space="preserve">factored dead load (ksi)........</ml:str>
									<ml:str xml:space="preserve">factored live load (ksi)...........</ml:str>
									<ml:str xml:space="preserve">HL93 operating rating factor</ml:str>
								</ml:matrix>
							</ml:program>
						</ml:define>
						<resultFormat numeric-only="true">
							<general precision="3" show-trailing-zeros="true" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="145339" left="6" top="8174.25" width="296.25" height="62.25" align-x="94.5" align-y="8208" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="Operating.Service.III">HL93</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="4" cols="3">
									<ml:str xml:space="preserve">C</ml:str>
									<ml:str xml:space="preserve">DL</ml:str>
									<ml:str xml:space="preserve">LL</ml:str>
									<ml:str xml:space="preserve">RF</ml:str>
									<ml:real>0.69146583429696651</ml:real>
									<ml:real>-0.33803545096078752</ml:real>
									<ml:real>0.57998029360982</ml:real>
									<ml:real>1.7750625264353344</ml:real>
									<ml:str xml:space="preserve">resistance, operating (ksi).....</ml:str>
									<ml:str xml:space="preserve">factored dead load (ksi)........</ml:str>
									<ml:str xml:space="preserve">factored live load (ksi)...........</ml:str>
									<ml:str xml:space="preserve">HL93 operating rating factor</ml:str>
								</ml:matrix>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="145325" left="6" top="8259" width="503.25" height="180" align-x="90.75" align-y="8268" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="Operating.Moment">HL93</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">r</ml:id>
									<ml:apply>
										<ml:indexer/>
										<ml:apply>
											<ml:id xml:space="preserve">fFindMinMomentRF</ml:id>
											<ml:id xml:space="preserve" subscript="moment.StrengthI..op">RF</ml:id>
										</ml:apply>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:localDefine>
								<ml:matrix rows="4" cols="3">
									<ml:str xml:space="preserve">φC</ml:str>
									<ml:str xml:space="preserve">γDL</ml:str>
									<ml:str xml:space="preserve">γLL</ml:str>
									<ml:str xml:space="preserve">RF</ml:str>
									<ml:apply>
										<ml:id xml:space="preserve">round</ml:id>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve" subscript="c">ϕ</ml:id>
														<ml:id xml:space="preserve" subscript="s">ϕ</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="mom">ϕ</ml:id>
														<ml:id xml:space="preserve">r</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="n">M</ml:id>
													<ml:id xml:space="preserve">r</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:id xml:space="preserve">kip</ml:id>
												<ml:id xml:space="preserve">ft</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">round</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:div/>
												<ml:real>1</ml:real>
												<ml:apply>
													<ml:mult/>
													<ml:id xml:space="preserve">kip</ml:id>
													<ml:id xml:space="preserve">ft</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:vectorSum/>
												<ml:matrix rows="3" cols="1">
													<ml:apply>
														<ml:mult/>
														<ml:real>1.25</ml:real>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="dl.non.comp">M</ml:id>
															<ml:id xml:space="preserve">r</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:real>1.25</ml:real>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="dl.comp.str">M</ml:id>
															<ml:id xml:space="preserve">r</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:real>1.50</ml:real>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="dl.future.ws">M</ml:id>
															<ml:id xml:space="preserve">r</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:matrix>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">round</ml:id>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:mult/>
												<ml:real>1.35</ml:real>
												<ml:parens>
													<ml:apply>
														<ml:mult/>
														<ml:parens>
															<ml:apply>
																<ml:plus/>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>1.33</ml:real>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve" subscript="truck.pos">M</ml:id>
																		<ml:id xml:space="preserve">r</ml:id>
																	</ml:apply>
																</ml:apply>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve" subscript="lane.pos">M</ml:id>
																	<ml:id xml:space="preserve">r</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
														<ml:id xml:space="preserve" subscript="mom">g</ml:id>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
