									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">Bar</ml:id>
										<ml:real>10</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>98.2</ml:real>
										<ml:id xml:space="preserve">kip</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:otherwise>
									<ml:apply>
										<ml:mult/>
										<ml:real>0</ml:real>
										<ml:id xml:space="preserve">kip</ml:id>
									</ml:apply>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="176744" left="228" top="1113" width="171" height="11.25" align-x="242.25" align-y="1122" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Tensile Strength of GFRP reinforcing bars</p>
					</text>
				</region>
				<region region-id="176745" left="228" top="1134" width="93" height="30" align-x="273.75" align-y="1152" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="fu">f_f</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">Bar</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:id xml:space="preserve" subscript="T">fP</ml:id>
									<ml:id xml:space="preserve">Bar</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:id xml:space="preserve">fA</ml:id>
									<ml:id xml:space="preserve">Bar</ml:id>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="176746" left="6" top="1161" width="162" height="22.5" align-x="13.5" align-y="1170" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Diameter of GFRP reinforcing bars [FDOT Specs 932]</p>
					</text>
				</region>
				<region region-id="176747" left="228" top="1179" width="93.75" height="11.25" align-x="241.5" align-y="1188" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Design tensile strength</p>
					</text>
				</region>
				<region region-id="176748" left="6" top="1197" width="146.25" height="60.75" align-x="49.5" align-y="1206" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">f_d</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">Bar</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">Bar</ml:id>
										<ml:real>9</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>1.128</ml:real>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">Bar</ml:id>
										<ml:real>10</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>1.27</ml:real>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:otherwise>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve">Bar</ml:id>
											<ml:real>8</ml:real>
										</ml:apply>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="176749" left="228" top="1203" width="112.5" height="15" align-x="273.75" align-y="1212" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="fd">f_f</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">Bar</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:mult/>
								<ml:id xml:space="preserve" subscript="E">C</ml:id>
								<ml:apply>
									<ml:id xml:space="preserve" subscript="fu">f_f</ml:id>
									<ml:id xml:space="preserve">Bar</ml:id>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="176750" left="228" top="1239" width="81.75" height="11.25" align-x="244.5" align-y="1248" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Development length</p>
					</text>
				</region>
				<region region-id="176751" left="228" top="1257" width="126" height="15" align-x="291" align-y="1266" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="d.GFRP">fL</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">Bar</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:mult/>
								<ml:real>50</ml:real>
								<ml:apply>
									<ml:id xml:space="preserve">f_d</ml:id>
									<ml:id xml:space="preserve">Bar</ml:id>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="176752" left="6" top="1287" width="201" height="22.5" align-x="13.5" align-y="1296" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Bend radius of GFRP reinforcing bars [FDOT Developmental Standards D21310]</p>
					</text>
				</region>
				<region region-id="176753" left="6" top="1323" width="145.5" height="161.25" align-x="47.25" align-y="1332" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">f_r</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">Bar</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">Bar</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>1.5</ml:real>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">Bar</ml:id>
										<ml:real>3</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>2.25</ml:real>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">Bar</ml:id>
										<ml:real>4</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>2.25</ml:real>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">Bar</ml:id>
										<ml:real>5</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>2.25</ml:real>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">Bar</ml:id>
										<ml:real>6</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>2.25</ml:real>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">Bar</ml:id>
										<ml:real>7</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>3</ml:real>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">Bar</ml:id>
										<ml:real>8</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>3</ml:real>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">Bar</ml:id>
										<ml:real>9</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>4.5</ml:real>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">Bar</ml:id>
										<ml:real>10</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>5</ml:real>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:otherwise>
									<ml:apply>
										<ml:mult/>
										<ml:real>0</ml:real>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="176823" left="6" top="1514.25" width="206.25" height="12" align-x="6" align-y="1524" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
