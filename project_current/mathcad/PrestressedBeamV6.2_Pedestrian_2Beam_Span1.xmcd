										</ml:apply>
										<ml:real>1</ml:real>
									</ml:sequence>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:real>0.3</ml:real>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="178226" left="6" top="981" width="153" height="22.5" align-x="6" align-y="990" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">design tensile strength of GFRP reinforcing bar</p>
					</text>
				</region>
				<region region-id="178227" left="180" top="987" width="144" height="15" align-x="217.5" align-y="996" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="fd.stirrup">f</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve" subscript="fd">f_f</ml:id>
									<ml:id xml:space="preserve">StirrupSize</ml:id>
