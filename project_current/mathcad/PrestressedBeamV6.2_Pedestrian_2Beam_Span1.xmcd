								<contentHash xmlns="http://schemas.mathsoft.com/provenance10">b960826b894f887b7d057a4002a7bc77</contentHash>
								<ml:id xml:space="preserve" subscript="barrier">Weight</ml:id>
							</ml:provenance>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
