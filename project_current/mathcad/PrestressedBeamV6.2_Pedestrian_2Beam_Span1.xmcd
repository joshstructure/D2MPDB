				<region region-id="181680" left="6" top="1988.25" width="286.5" height="39.75" align-x="64.5" align-y="2010" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="max.web">DC_f</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:plus/>
										<ml:parens>
											<ml:apply>
												<ml:lessThan/>
												<ml:id xml:space="preserve">n</ml:id>
												<ml:id xml:space="preserve">ishear</ml:id>
											</ml:apply>
										</ml:parens>
										<ml:parens>
											<ml:apply>
												<ml:greaterThan/>
												<ml:id xml:space="preserve">n</ml:id>
												<ml:apply>
													<ml:minus/>
													<ml:id xml:space="preserve">nmax</ml:id>
													<ml:id xml:space="preserve">ishear</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:real>0.1</ml:real>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="max.SerIII">f</ml:id>
											<ml:id xml:space="preserve">n</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="max.all">f</ml:id>
											<ml:id xml:space="preserve">n</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
