				<region region-id="187836" left="300" top="3975" width="112.5" height="49.5" align-x="300" align-y="3984" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">tendon yield strength,<sp count="2"/>
						</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">0.9*f<sub>pu</sub>
							<sp count="2"/>for low-lax </p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">0.85*f<sub>pu </sub> for stress relieved<sp count="3"/>
						</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<c val="#800000">(LRFD 5.4.4.1)</c>
						</p>
					</text>
				</region>
				<region region-id="177118" left="6" top="3981" width="277.5" height="69" align-x="24" align-y="3990" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="py">f</ml:id>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">StrandType</ml:id>
										<ml:str xml:space="preserve">Carbon Steel - Low Lax</ml:str>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>0.9</ml:real>
										<ml:id xml:space="preserve" subscript="pu">f</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">StrandType</ml:id>
										<ml:str xml:space="preserve">Carbon Steel - Stress Relieved</ml:str>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>0.85</ml:real>
										<ml:id xml:space="preserve" subscript="pu">f</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">StrandType</ml:id>
										<ml:str xml:space="preserve">Stainless Steel</ml:str>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>0.90</ml:real>
										<ml:id xml:space="preserve" subscript="pu">f</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">StrandType</ml:id>
										<ml:str xml:space="preserve">Carbon Fiber Reinforced Polymer</ml:str>
									</ml:apply>
									<ml:real>0</ml:real>
								</ml:ifThen>
							</ml:program>
						</ml:define>
						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="5"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
