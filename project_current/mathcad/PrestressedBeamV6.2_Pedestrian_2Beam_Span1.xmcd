				<region region-id="147295" left="6" top="1431" width="261" height="18.75" align-x="39" align-y="1440" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
