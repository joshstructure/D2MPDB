				<region region-id="176003" left="450" top="11115" width="61.5" height="22.5" align-x="462.75" align-y="11124" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">LRFD Table 2.5.2.6.3-1</p>
					</text>
				</region>
				<region region-id="176004" left="6" top="11265" width="389.25" height="15" align-x="94.5" align-y="11274" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">CheckSpanToDepth</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:greaterOrEqual/>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve" subscript="deck.top">y</ml:id>
												<ml:id xml:space="preserve" subscript="beam.bot">y</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:id xml:space="preserve" subscript="min">Depth</ml:id>
												<ml:id xml:space="preserve">ft</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:str xml:space="preserve">OK</ml:str>
										<ml:str xml:space="preserve">No Good</ml:str>
									</ml:sequence>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:str xml:space="preserve">No Good</ml:str>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="176005" left="6" top="11307" width="284.25" height="15" align-x="94.5" align-y="11316" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define warning="WarnRedefinedUDScalar" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">CheckSpanToDepth</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve" subscript="min">Depth</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
									<ml:str xml:space="preserve">N.A.</ml:str>
									<ml:id xml:space="preserve">CheckSpanToDepth</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="176006" left="390" top="11307" width="147" height="12.75" align-x="477" align-y="11316" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">CheckSpanToDepth</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:str xml:space="preserve">No Good</ml:str>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="176007" left="276" top="11373" width="216" height="22.5" align-x="276" align-y="11382" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">X2 is used to graphically display the beam and slab in the condensed file</p>
					</text>
				</region>
				<region region-id="176008" left="6" top="11364.75" width="245.25" height="35.25" align-x="24" align-y="11388" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">X2</ml:id>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:matcol/>
									<ml:id xml:space="preserve" subscript="beam">Coord</ml:id>
									<ml:real>0</ml:real>
								</ml:apply>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:minus/>
										<ml:parens>
											<ml:apply>
												<ml:id xml:space="preserve">max</ml:id>
												<ml:apply>
													<ml:matcol/>
													<ml:id xml:space="preserve">Slab</ml:id>
													<ml:real>0</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:parens>
										<ml:parens>
											<ml:apply>
												<ml:id xml:space="preserve">max</ml:id>
												<ml:apply>
													<ml:matcol/>
													<ml:id xml:space="preserve" subscript="beam">Coord</ml:id>
													<ml:real>0</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="176009" left="6" top="11421" width="302.25" height="95.25" align-x="65.25" align-y="11430" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="plus">Overhang</ml:id>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:id xml:space="preserve">substr</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:real>0</ml:real>
												<ml:real>3</ml:real>
											</ml:sequence>
										</ml:apply>
										<ml:str xml:space="preserve">FDT</ml:str>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:id xml:space="preserve">BeamSpacing</ml:id>
										<ml:real>0.5</ml:real>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">BeamType</ml:id>
										<ml:str xml:space="preserve">FUB48</ml:str>
									</ml:apply>
									<ml:apply>
										<ml:plus/>
										<ml:id xml:space="preserve">Overhang</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:real>40</ml:real>
											<ml:id xml:space="preserve">in</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">BeamType</ml:id>
										<ml:str xml:space="preserve">FUB54</ml:str>
									</ml:apply>
									<ml:apply>
										<ml:plus/>
										<ml:id xml:space="preserve">Overhang</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:real>41.5</ml:real>
											<ml:id xml:space="preserve">in</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">BeamType</ml:id>
										<ml:str xml:space="preserve">FUB63</ml:str>
									</ml:apply>
									<ml:apply>
										<ml:plus/>
										<ml:id xml:space="preserve">Overhang</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:real>43.75</ml:real>
											<ml:id xml:space="preserve">in</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">BeamType</ml:id>
										<ml:str xml:space="preserve">FUB72</ml:str>
									</ml:apply>
									<ml:apply>
										<ml:plus/>
										<ml:id xml:space="preserve">Overhang</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:real>46</ml:real>
											<ml:id xml:space="preserve">in</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:ifThen>
								<ml:otherwise>
									<ml:id xml:space="preserve">Overhang</ml:id>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="176010" left="342" top="11421" width="90.75" height="15" align-x="399.75" align-y="11430" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
