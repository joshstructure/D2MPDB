				<region region-id="146978" left="6" top="3849" width="165" height="39" align-x="19.5" align-y="3870" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:provenance expr-id="1" xmlns:ml="http://schemas.mathsoft.com/math30">
							<originRef doc-id="1A2712E2-88ED-4349-8216-2E89E4E637F6" version-id="E12DD5B5-D445-4E83-BD02-2192A38CC8EC" branch-id="00000000-0000-0000-0000-000000000000" revision-num="1615754668" is-modified="true" region-id="0" href="C:\FDOT Structures\Programs\LRFDPBeamV3.32\LRFDpsbeam-Revised Stress Equations.xmcd" xmlns="http://schemas.mathsoft.com/provenance10">
