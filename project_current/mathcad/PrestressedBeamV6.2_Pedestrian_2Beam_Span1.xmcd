						</ml:define>
					</math>
				</region>
				<region region-id="150292" left="204" top="1299" width="115.5" height="12.75" align-x="267.75" align-y="1308" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">BeamCategory</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:str xml:space="preserve">I-Beam</ml:str>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="150285" left="6" top="1329" width="176.25" height="21" align-x="23.25" align-y="1344" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="g">K</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve" subscript="d">n</ml:id>
									<ml:parens>
										<ml:apply>
											<ml:plus/>
											<ml:id xml:space="preserve" subscript="beam">I</ml:id>
											<ml:apply>
												<ml:mult/>
												<ml:id xml:space="preserve" subscript="beam">A</ml:id>
												<ml:apply>
													<ml:pow/>
													<ml:parens>
														<ml:id xml:space="preserve" subscript="g">e</ml:id>
													</ml:parens>
													<ml:real>2</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:apply>
									</ml:parens>
								</ml:apply>
								<ml:unitOverride>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve">in</ml:id>
										<ml:real>4</ml:real>
									</ml:apply>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
