					<math optimize="false" disable-calc="false">
						<ml:define warning="WarnRedefinedBIUnit" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">s</ml:id>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:real>6</ml:real>
									</ml:range>
									<ml:localDefine>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">spacing</ml:id>
											<ml:id xml:space="preserve">j</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve">str2num</ml:id>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">outStirrupData</ml:id>
												<ml:sequence>
													<ml:real font="0">0</ml:real>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:sequence>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:for>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve">spacing</ml:id>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:apply>
							</ml:program>
