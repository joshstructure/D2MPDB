													<ml:id xml:space="preserve">n</ml:id>
												</ml:sequence>
											</ml:apply>
										</ml:parens>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="132876" left="6" top="6800.25" width="528.75" height="45.75" align-x="57.75" align-y="6822" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
