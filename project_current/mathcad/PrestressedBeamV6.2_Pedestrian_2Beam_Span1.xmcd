				<region region-id="141594" left="6" top="1088.25" width="255" height="39.75" align-x="37.5" align-y="1116" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define warning="WarnRedefinedUDScalar" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="c.deck">E</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:real>120000</ml:real>
												<ml:id xml:space="preserve" subscript="1">K</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:pow/>
												<ml:parens>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve" subscript="c.deck">w</ml:id>
														<ml:apply>
															<ml:div/>
															<ml:apply>
																<ml:pow/>
																<ml:id xml:space="preserve">ft</ml:id>
																<ml:real>3</ml:real>
															</ml:apply>
															<ml:id xml:space="preserve">kip</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:parens>
												<ml:real>2</ml:real>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:pow/>
											<ml:parens>
												<ml:apply>
													<ml:div/>
													<ml:id xml:space="preserve" subscript="c.deck">f</ml:id>
