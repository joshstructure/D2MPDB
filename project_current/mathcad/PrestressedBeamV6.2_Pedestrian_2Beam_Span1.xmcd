						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">CheckMinSSLimit</ml:id>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">StrandType</ml:id>
										<ml:str xml:space="preserve">Stainless Steel</ml:str>
									</ml:apply>
									<ml:program>
										<ml:localDefine>
											<ml:id xml:space="preserve">mincd</ml:id>
											<ml:real>10</ml:real>
										</ml:localDefine>
										<ml:for>
											<ml:id xml:space="preserve">mn</ml:id>
											<ml:range>
												<ml:id xml:space="preserve">startmn</ml:id>
												<ml:id xml:space="preserve">endmn</ml:id>
											</ml:range>
											<ml:ifThen>
												<ml:apply>
													<ml:equal/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">FailureMode</ml:id>
														<ml:id xml:space="preserve">mn</ml:id>
													</ml:apply>
													<ml:str xml:space="preserve">Strand Rupture</ml:str>
												</ml:apply>
												<ml:ifThen>
													<ml:apply>
														<ml:lessThan/>
														<ml:apply>
															<ml:div/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="na">c</ml:id>
																<ml:id xml:space="preserve">mn</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="t">d</ml:id>
																<ml:id xml:space="preserve">mn</ml:id>
															</ml:apply>
														</ml:apply>
														<ml:id xml:space="preserve">mincd</ml:id>
													</ml:apply>
													<ml:localDefine>
														<ml:id xml:space="preserve">mincd</ml:id>
														<ml:apply>
															<ml:div/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="na">c</ml:id>
																<ml:id xml:space="preserve">mn</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="t">d</ml:id>
																<ml:id xml:space="preserve">mn</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:localDefine>
												</ml:ifThen>
											</ml:ifThen>
										</ml:for>
										<ml:ifThen>
											<ml:apply>
												<ml:greaterOrEqual/>
												<ml:id xml:space="preserve">mincd</ml:id>
												<ml:id xml:space="preserve">MinSSLimit</ml:id>
											</ml:apply>
											<ml:str xml:space="preserve">OK</ml:str>
										</ml:ifThen>
										<ml:ifThen>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">mincd</ml:id>
												<ml:real>10</ml:real>
											</ml:apply>
											<ml:str xml:space="preserve">N.A.</ml:str>
										</ml:ifThen>
										<ml:otherwise>
											<ml:str xml:space="preserve">No Good!</ml:str>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:otherwise>
									<ml:str xml:space="preserve">N.A.</ml:str>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
