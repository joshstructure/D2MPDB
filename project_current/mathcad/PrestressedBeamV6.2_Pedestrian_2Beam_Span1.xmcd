				<region region-id="177118" left="6" top="3981" width="277.5" height="69" align-x="24" align-y="3990" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="py">f</ml:id>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">StrandType</ml:id>
										<ml:str xml:space="preserve">Carbon Steel - Low Lax</ml:str>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>0.9</ml:real>
										<ml:id xml:space="preserve" subscript="pu">f</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">StrandType</ml:id>
										<ml:str xml:space="preserve">Carbon Steel - Stress Relieved</ml:str>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>0.85</ml:real>
										<ml:id xml:space="preserve" subscript="pu">f</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">StrandType</ml:id>
										<ml:str xml:space="preserve">Stainless Steel</ml:str>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>0.90</ml:real>
										<ml:id xml:space="preserve" subscript="pu">f</ml:id>
									</ml:apply>
								</ml:ifThen>
								<ml:ifThen>
