									<ml:id xml:space="preserve">r</ml:id>
									<ml:apply>
										<ml:indexer/>
										<ml:apply>
											<ml:id xml:space="preserve">fFindMinMomentRF</ml:id>
											<ml:id xml:space="preserve" subscript="shear.StrengthI.op">RF</ml:id>
										</ml:apply>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:localDefine>
								<ml:matrix rows="5" cols="2">
									<ml:str xml:space="preserve">DL.nc</ml:str>
									<ml:str xml:space="preserve">DL.c</ml:str>
									<ml:str xml:space="preserve">DL.fws</ml:str>
									<ml:str xml:space="preserve">LLwIM</ml:str>
									<ml:str xml:space="preserve">DF</ml:str>
									<ml:apply>
										<ml:id xml:space="preserve">Round</ml:id>
										<ml:sequence>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="dl.non.comp">V</ml:id>
													<ml:id xml:space="preserve">r</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:pow/>
													<ml:id xml:space="preserve">kip</ml:id>
													<ml:real>-1</ml:real>
												</ml:apply>
											</ml:apply>
											<ml:real>0.1</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">Round</ml:id>
										<ml:sequence>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="dl.comp.str">V</ml:id>
													<ml:id xml:space="preserve">r</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:pow/>
													<ml:id xml:space="preserve">kip</ml:id>
													<ml:real>-1</ml:real>
												</ml:apply>
											</ml:apply>
											<ml:real>0.1</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">Round</ml:id>
										<ml:sequence>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="dl.future.ws">V</ml:id>
													<ml:id xml:space="preserve">r</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:pow/>
													<ml:id xml:space="preserve">kip</ml:id>
													<ml:real>-1</ml:real>
												</ml:apply>
											</ml:apply>
											<ml:real>0.1</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">Round</ml:id>
										<ml:sequence>
											<ml:apply>
												<ml:mult/>
												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:apply>
															<ml:mult/>
															<ml:real>1.33</ml:real>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="truck.pos">V</ml:id>
																<ml:id xml:space="preserve">r</ml:id>
															</ml:apply>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="lane.pos">V</ml:id>
															<ml:id xml:space="preserve">r</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:parens>
												<ml:apply>
													<ml:pow/>
													<ml:id xml:space="preserve">kip</ml:id>
													<ml:real>-1</ml:real>
												</ml:apply>
											</ml:apply>
											<ml:real>0.1</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:id xml:space="preserve" subscript="shear">g</ml:id>
								</ml:matrix>
							</ml:program>
						</ml:define>
