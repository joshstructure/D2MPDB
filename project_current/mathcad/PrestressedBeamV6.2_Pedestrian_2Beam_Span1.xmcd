				<region region-id="147646" left="6" top="1460.25" width="177.75" height="36" align-x="52.5" align-y="1482" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
