				<region region-id="200789" left="168" top="471" width="160.5" height="11.25" align-x="168" align-y="480" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">vertical &amp; horizontal strand spacing</p>
					</text>
				</region>
				<region region-id="200791" left="6" top="498" width="305.25" height="135" align-x="69" align-y="516" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="true">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">MirrorStrands</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">maxj</ml:id>
									<ml:apply>
										<ml:id xml:space="preserve">floor</ml:id>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve" subscript="bottom.flg">Width</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:real>2</ml:real>
														<ml:id xml:space="preserve" subscript="strand.side">Cover</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve">in</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:id xml:space="preserve" subscript="strand">Spacing</ml:id>
												<ml:id xml:space="preserve">in</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">midj</ml:id>
									<ml:apply>
										<ml:minus/>
										<ml:apply>
											<ml:id xml:space="preserve">ceil</ml:id>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve">maxj</ml:id>
												<ml:real>2</ml:real>
											</ml:apply>
										</ml:apply>
										<ml:real>1</ml:real>
									</ml:apply>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:id xml:space="preserve">rows</ml:id>
												<ml:id xml:space="preserve">tendsect</ml:id>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:range>
									<ml:for>
										<ml:id xml:space="preserve">j</ml:id>
										<ml:range>
											<ml:real>0</ml:real>
											<ml:id xml:space="preserve">midj</ml:id>
										</ml:range>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">tendsect</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">i</ml:id>
													<ml:apply>
														<ml:minus/>
														<ml:id xml:space="preserve">maxj</ml:id>
														<ml:id xml:space="preserve">j</ml:id>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">tendsect</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">i</ml:id>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
									</ml:for>
								</ml:for>
								<ml:id xml:space="preserve">tendsect</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="200799" left="342" top="507" width="95.25" height="12.75" align-x="390" align-y="516" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">BeamType</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:str xml:space="preserve">FIB36</ml:str>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="200803" left="342" top="525" width="198" height="33.75" align-x="354.75" align-y="534" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Mirror strands to center of beam bottom flange for "Custom" beams. For all other types, this is done inside the Strand Generator. </p>
					</text>
				</region>
				<region region-id="200793" left="6" top="651" width="263.25" height="12.75" align-x="47.25" align-y="660" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="true">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">tendsect</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">BeamType</ml:id>
										<ml:str xml:space="preserve">Custom</ml:str>
									</ml:apply>
									<ml:id xml:space="preserve">MirrorStrands</ml:id>
									<ml:id xml:space="preserve">tendsect</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="200796" left="6" top="675" width="500.25" height="144.75" align-x="45.75" align-y="750" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
