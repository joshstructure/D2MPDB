				<region region-id="188263" left="144" top="2811" width="63.75" height="11.25" align-x="144" align-y="2820" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(LRFD 5.7.2.5)</p>
					</text>
				</region>
				<region region-id="188264" left="222" top="2811" width="112.5" height="11.25" align-x="222" align-y="2820" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(AASHTO GFRP 2.7.2.4)</p>
					</text>
				</region>
				<region region-id="184520" left="6" top="2838" width="513.75" height="68.25" align-x="36" align-y="2856" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80ff" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="vmin">A</ml:id>
							<ml:program>
								<ml:ifThen>
									<ml:parens>
										<ml:apply>
											<ml:plus/>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">MildReinfType</ml:id>
													<ml:str xml:space="preserve">Carbon Steel</ml:str>
												</ml:apply>
											</ml:parens>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">MildReinfType</ml:id>
													<ml:str xml:space="preserve">Stainless Steel</ml:str>
												</ml:apply>
											</ml:parens>
										</ml:apply>
									</ml:parens>
									<ml:parens>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:real>0.0316</ml:real>
													<ml:id xml:space="preserve">λ</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:sqrt/>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve" subscript="c.beam">f</ml:id>
														<ml:id xml:space="preserve">ksi</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve" subscript="v">b</ml:id>
												<ml:id xml:space="preserve" subscript="y">f</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:parens>
								</ml:ifThen>
								<ml:otherwise>
									<ml:parens>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:real>0.05</ml:real>
												<ml:apply>
													<ml:div/>
													<ml:id xml:space="preserve" subscript="v">b</ml:id>
													<ml:id xml:space="preserve" subscript="fv">f</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:id xml:space="preserve">ksi</ml:id>
										</ml:apply>
									</ml:parens>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="141461" left="6" top="2919" width="211.5" height="75" align-x="70.5" align-y="2928" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="StirrupArea">D/C</ml:id>
								<ml:id xml:space="preserve">hs</ml:id>
							</ml:apply>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:lessThan/>
										<ml:id xml:space="preserve">hs</ml:id>
										<ml:id xml:space="preserve">ishear</ml:id>
									</ml:apply>
									<ml:real>0</ml:real>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:lessOrEqual/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="u.Strength">V</ml:id>
											<ml:id xml:space="preserve">hs</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult style="auto-select"/>
												<ml:real>0.5</ml:real>
												<ml:id xml:space="preserve" subscript="shr">ϕ</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="c">V</ml:id>
												<ml:id xml:space="preserve">hs</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:real>0</ml:real>
								</ml:ifThen>
								<ml:otherwise>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="vmin">A</ml:id>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="v.prov.shr">A</ml:id>
											<ml:id xml:space="preserve">hs</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="188261" left="396" top="2912.25" width="69.75" height="33.75" align-x="424.5" align-y="2934" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="vmin">A</ml:id>
							<ml:unitOverride>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve">in</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
									<ml:id xml:space="preserve">ft</ml:id>
								</ml:apply>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>0.12898065591397812</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="foot" power-numerator="-1"/>
										<unitReference unit="inch" power-numerator="2"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="true" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="188128" left="402" top="2973" width="112.5" height="15" align-x="480.75" align-y="2982" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:id xml:space="preserve">max</ml:id>
								<ml:id xml:space="preserve" subscript="StirrupArea">D/C</ml:id>
							</ml:apply>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:real>0.41606663198057459</ml:real>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="3" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="32095" left="6" top="3015" width="374.25" height="15" align-x="87" align-y="3024" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">CheckMinStirArea</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:lessThan/>
											<ml:apply>
												<ml:id xml:space="preserve">max</ml:id>
												<ml:id xml:space="preserve" subscript="StirrupArea">D/C</ml:id>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
										<ml:str xml:space="preserve">OK</ml:str>
										<ml:str xml:space="preserve">No Good, increase area!</ml:str>
									</ml:sequence>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:str xml:space="preserve">OK</ml:str>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="25982" left="6" top="3057" width="138.75" height="11.25" align-x="6" align-y="3066" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">check maximum stirrup spacing</p>
					</text>
				</region>
				<region region-id="25983" left="168" top="3057" width="63.75" height="11.25" align-x="168" align-y="3066" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(LRFD 5.7.2.6)</p>
					</text>
				</region>
				<region region-id="179734" left="6" top="3080.25" width="484.5" height="324" align-x="117" align-y="3096" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">fChkStirrupSpacing</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve" subscript="prov">s</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">k</ml:id>
									<ml:range>
										<ml:real>1</ml:real>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:id xml:space="preserve">last</ml:id>
													<ml:id xml:space="preserve">Location</ml:id>
												</ml:apply>
												<ml:real>2</ml:real>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:range>
									<ml:program>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="u">v</ml:id>
												<ml:id xml:space="preserve">k</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="u.Strength">V</ml:id>
														<ml:id xml:space="preserve">k</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve" subscript="shr">ϕ</ml:id>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="p">V</ml:id>
															<ml:id xml:space="preserve">k</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve" subscript="shr">ϕ</ml:id>
														<ml:id xml:space="preserve" subscript="v">b</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="v">d</ml:id>
														<ml:id xml:space="preserve">k</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
