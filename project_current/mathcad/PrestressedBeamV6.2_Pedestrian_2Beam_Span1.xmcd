				<region region-id="146966" left="6" top="3435" width="105.75" height="15" align-x="69" align-y="3444" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
