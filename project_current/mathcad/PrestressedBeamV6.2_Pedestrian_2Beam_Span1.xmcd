				<region region-id="32281" left="6" top="9561" width="534" height="15" align-x="54.75" align-y="9570" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">MidDepth</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:or/>
										<ml:apply>
											<ml:equal/>
											<ml:apply>
												<ml:id xml:space="preserve">substr</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">BeamType</ml:id>
													<ml:real>0</ml:real>
													<ml:real>3</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:str xml:space="preserve">FLT</ml:str>
										</ml:apply>
										<ml:apply>
											<ml:equal/>
											<ml:apply>
												<ml:id xml:space="preserve">substr</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">BeamType</ml:id>
													<ml:real>0</ml:real>
													<ml:real>3</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:str xml:space="preserve">FSB</ml:str>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:minus/>
										<ml:apply>
											<ml:mult/>
											<ml:real>0</ml:real>
											<ml:id xml:space="preserve">in</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:real>0.001</ml:real>
											<ml:id xml:space="preserve">in</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:parens>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve" subscript="beam.bot">y</ml:id>
												<ml:id xml:space="preserve" subscript="deck.top">y</ml:id>
											</ml:apply>
										</ml:parens>
										<ml:real>0.5</ml:real>
									</ml:apply>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="32282" left="6" top="9582" width="220.5" height="30" align-x="76.5" align-y="9600" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">HalfBeamCoord</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">HalfBeam</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve">MidDepth</ml:id>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="beam">Coord</ml:id>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="145026" left="6" top="9615.75" width="277.5" height="20.25" align-x="42" align-y="9630" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="x">Range</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:minus/>
									<ml:apply>
										<ml:id xml:space="preserve">max</ml:id>
										<ml:apply>
											<ml:matcol/>
											<ml:id xml:space="preserve">HalfBeamCoord</ml:id>
											<ml:real>0</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">min</ml:id>
										<ml:apply>
											<ml:matcol/>
											<ml:id xml:space="preserve">HalfBeamCoord</ml:id>
											<ml:real>0</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
