										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">ft</ml:id>
											<ml:real>3</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:unitOverride>
							</ml:eval>
						</ml:define>
