				<region region-id="176252" left="6" top="568.5" width="191.25" height="33.75" align-x="41.25" align-y="588" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="nh.max">V</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">min</ml:id>
									<ml:matrix rows="2" cols="1">
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:id xml:space="preserve" subscript="1">K</ml:id>
													<ml:id xml:space="preserve" subscript="c.deck">f</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve" subscript="cv">A</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve">ft</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:id xml:space="preserve" subscript="2">K</ml:id>
												<ml:id xml:space="preserve" subscript="cv">A</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve">ft</ml:id>
										</ml:apply>
									</ml:matrix>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">kip</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>777.59999999999991</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="kip"/>
										</unitMonomial>
