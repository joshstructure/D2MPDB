				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">*4 </p>
			</text>
		</region>
		<region region-id="187470" left="6" top="5237.25" width="531.75" height="49.5" align-x="6" align-y="5246.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">*1 - Area of longitudinal deck reinf. per unit width of deck, both layers combined. Typically one #5 Bar top &amp; bottom for 8" decks.</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">*2 - Distance measured from top of deck to centroid of deck longitudinal reinforcement, positive value.</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">*3 - Distance measured from top of beam, positive value.</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">*4 - Size of bars used to create <region region-id="185524" left="132" top="5271.75" width="27" height="15" align-x="144.75" align-y="5280.75" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
						<math optimize="false" disable-calc="false">
							<ml:id xml:space="preserve" subscript="s.long" xmlns:ml="http://schemas.mathsoft.com/math30">A</ml:id>
						</math>
						<rendering item-idref="412"/>
					</region> needed to calculate development length.</p>
			</text>
		</region>
		<region region-id="175654" left="6" top="5289" width="122.25" height="14.25" align-x="6" align-y="5300.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
