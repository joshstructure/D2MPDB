				<region region-id="147293" left="6" top="1326.75" width="376.5" height="72.75" align-x="51" align-y="1362" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
