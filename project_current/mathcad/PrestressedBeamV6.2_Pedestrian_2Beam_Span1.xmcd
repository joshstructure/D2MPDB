				<region region-id="201290" left="6" top="5452.5" width="285" height="135.75" align-x="129" align-y="5472" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:matrix rows="2" cols="1">
								<ml:id xml:space="preserve" subscript="splitting.LRFD.Ubeam.horiz">D/C</ml:id>
								<ml:id xml:space="preserve" subscript="splitting.LRFD.Ubeam.vert">D/C</ml:id>
							</ml:matrix>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">DC</ml:id>
									<ml:str xml:space="preserve">N/A</ml:str>
								</ml:localDefine>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:id xml:space="preserve">substr</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:real>0</ml:real>
												<ml:real>3</ml:real>
											</ml:sequence>
										</ml:apply>
										<ml:str xml:space="preserve">FUB</ml:str>
									</ml:apply>
									<ml:program>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="horiz">DC</ml:id>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve" subscript="f.LRFD">P</ml:id>
												<ml:id xml:space="preserve" subscript="r.LRFD.Ubeam.horiz">P</ml:id>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve" subscript="vert">DC</ml:id>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve" subscript="f.LRFD">P</ml:id>
												<ml:id xml:space="preserve" subscript="r.LRFD.Ubeam.vert">P</ml:id>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:ifThen>
								<ml:apply>
									<ml:transpose/>
									<ml:matrix rows="1" cols="2">
										<ml:id xml:space="preserve" subscript="horiz">DC</ml:id>
										<ml:id xml:space="preserve" subscript="vert">DC</ml:id>
									</ml:matrix>
								</ml:apply>
							</ml:program>
						</ml:define>
					</math>
				</region>
