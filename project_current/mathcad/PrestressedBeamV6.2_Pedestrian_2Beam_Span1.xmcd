				</region>
				<region region-id="175933" left="6" top="8733" width="276.75" height="94.5" align-x="69.75" align-y="8742" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="bottom.flg">Width</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">ans</ml:id>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">TrapShapes</ml:id>
										<ml:sequence>
											<ml:parens>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:id xml:space="preserve">rows</ml:id>
														<ml:id xml:space="preserve">TrapShapes</ml:id>
													</ml:apply>
													<ml:real>1</ml:real>
												</ml:apply>
											</ml:parens>
											<ml:real>0</ml:real>
										</ml:sequence>
									</ml:apply>
								</ml:localDefine>
								<ml:ifThen>
									<ml:apply>
										<ml:lessThan/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">TrapShapes</ml:id>
											<ml:sequence>
												<ml:parens>
													<ml:apply>
														<ml:minus/>
														<ml:apply>
															<ml:id xml:space="preserve">rows</ml:id>
															<ml:id xml:space="preserve">TrapShapes</ml:id>
														</ml:apply>
														<ml:real>1</ml:real>
													</ml:apply>
												</ml:parens>
												<ml:real>1</ml:real>
											</ml:sequence>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:real>1.5</ml:real>
											<ml:id xml:space="preserve">in</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:program>
										<ml:localDefine>
											<ml:id xml:space="preserve">chamfer</ml:id>
											<ml:real>1</ml:real>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve">ans</ml:id>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">TrapShapes</ml:id>
												<ml:sequence>
													<ml:parens>
														<ml:apply>
															<ml:minus/>
															<ml:apply>
																<ml:id xml:space="preserve">rows</ml:id>
																<ml:id xml:space="preserve">TrapShapes</ml:id>
															</ml:apply>
															<ml:real>2</ml:real>
														</ml:apply>
													</ml:parens>
													<ml:real>0</ml:real>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:ifThen>
								<ml:id xml:space="preserve">ans</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="175934" left="318" top="8739" width="89.25" height="15" align-x="380.25" align-y="8748" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="bottom.flg">Width</ml:id>
							<ml:unitOverride>
								<ml:id xml:space="preserve">in</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>38.000000000000007</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="inch"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="175935" left="276" top="8852.25" width="216" height="63" align-x="276" align-y="8862" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<region region-id="14556" left="276" top="8853" width="30" height="12.75" align-x="290.25" align-y="8862" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" xmlns:ml="http://schemas.mathsoft.com/math30">EffSlab</ml:id>
								</math>
							</region>
							<b>
								<inlineAttr font-style="normal" underline="false" line-through="false">
									<c val="#00f">
										<sp/>
									</c>
								</inlineAttr>
							</b> is the transformed slab section using the modular ratio of the slab to beam modulus of elasticity.<sp count="2"/>The<b>
								<inlineAttr font-style="normal" underline="false" line-through="false">
									<c val="#00f">
										<sp/>
									</c>
								</inlineAttr>
							</b>
							<region region-id="14557" left="342" top="8877" width="30" height="12.75" align-x="356.25" align-y="8886" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" xmlns:ml="http://schemas.mathsoft.com/math30">EffSlab</ml:id>
								</math>
							</region>
							<b>
								<inlineAttr font-style="normal" underline="false" line-through="false">
									<c val="#00f">
										<sp/>
									</c>
								</inlineAttr>
							</b>is used to calculate the composite section properties that define the final stresses</p>
					</text>
				</region>
				<region region-id="175936" left="6" top="8853.75" width="184.5" height="240" align-x="30" align-y="8976" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">Slab</ml:id>
							<ml:matrix rows="9" cols="2">
								<ml:apply>
									<ml:minus/>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="e">b</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="buildup">Width</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:minus/>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="e">b</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="buildup">Width</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:apply>
								<ml:real>0</ml:real>
								<ml:real>0</ml:real>
								<ml:id xml:space="preserve" subscript="e">b</ml:id>
								<ml:id xml:space="preserve" subscript="e">b</ml:id>
								<ml:apply>
									<ml:plus/>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="e">b</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="buildup">Width</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:plus/>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="e">b</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="buildup">Width</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:minus/>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="e">b</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="buildup">Width</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:apply>
								<ml:real>0</ml:real>
								<ml:id xml:space="preserve" subscript="buildup">h</ml:id>
								<ml:id xml:space="preserve" subscript="buildup">h</ml:id>
								<ml:apply>
									<ml:plus/>
									<ml:id xml:space="preserve" subscript="deck">t</ml:id>
									<ml:id xml:space="preserve" subscript="buildup">h</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:plus/>
									<ml:id xml:space="preserve" subscript="deck">t</ml:id>
									<ml:id xml:space="preserve" subscript="buildup">h</ml:id>
								</ml:apply>
								<ml:id xml:space="preserve" subscript="buildup">h</ml:id>
								<ml:id xml:space="preserve" subscript="buildup">h</ml:id>
								<ml:real>0</ml:real>
								<ml:real>0</ml:real>
							</ml:matrix>
						</ml:define>
					</math>
				</region>
				<region region-id="175937" left="276" top="8973" width="61.5" height="12.75" align-x="312" align-y="8982" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">EffSlab</ml:id>
							<ml:id xml:space="preserve">Slab</ml:id>
						</ml:define>
					</math>
				</region>
				<region region-id="175938" left="276" top="8994" width="171.75" height="32.25" align-x="323.25" align-y="9012" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:matcol/>
								<ml:id xml:space="preserve">EffSlab</ml:id>
								<ml:real>0</ml:real>
							</ml:apply>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:div/>
										<ml:real>1</ml:real>
										<ml:id xml:space="preserve" subscript="d">n</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:matcol/>
										<ml:id xml:space="preserve">Slab</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:mult style="auto-select"/>
									<ml:real>0.5</ml:real>
									<ml:parens>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve" subscript="e">b</ml:id>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve" subscript="e">b</ml:id>
												<ml:id xml:space="preserve" subscript="d">n</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:parens>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="175939" left="6" top="9110.25" width="105.75" height="12" align-x="33.75" align-y="9120" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="subheading" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Modifications for FSBs</p>
					</text>
				</region>
				<region region-id="175940" left="6" top="9135" width="372" height="15" align-x="54" align-y="9144" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="true">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="beam">Width</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:id xml:space="preserve">substr</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">BeamType</ml:id>
