														</ml:apply>
														<ml:apply>
															<ml:mult style="auto-select"/>
															<ml:apply>
																<ml:mult/>
																<ml:real>2</ml:real>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve" subscript="ss.Ser1">f</ml:id>
																	<ml:id xml:space="preserve">hs</ml:id>
																</ml:apply>
															</ml:apply>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">ζ</ml:id>
																<ml:id xml:space="preserve">hs</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:apply>
												</ml:localDefine>
											</ml:program>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:otherwise>
									<ml:localDefine>
										<ml:id xml:space="preserve">dcmax</ml:id>
										<ml:real>0</ml:real>
									</ml:localDefine>
								</ml:otherwise>
								<ml:id xml:space="preserve">dcmax</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="179713" left="252" top="1929" width="71.25" height="11.25" align-x="266.25" align-y="1938" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
