				<region region-id="152384" left="6" top="984" width="491.25" height="42" align-x="69.75" align-y="1002" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffd2d2" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="p.stainless">f_f</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">ε</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:lessThan/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:div/>
													<ml:id xml:space="preserve" subscript="p.SS">E</ml:id>
													<ml:id xml:space="preserve">ksi</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve">ε</ml:id>
											</ml:apply>
											<ml:parens>
												<ml:apply>
													<ml:plus/>
													<ml:real>0.08</ml:real>
													<ml:apply>
														<ml:div/>
														<ml:real>0.92</ml:real>
														<ml:apply>
															<ml:pow/>
															<ml:parens>
																<ml:apply>
																	<ml:plus/>
																	<ml:real>1</ml:real>
																	<ml:apply>
																		<ml:pow/>
																		<ml:parens>
																			<ml:apply>
																				<ml:mult/>
																				<ml:real>99</ml:real>
																				<ml:id xml:space="preserve">ε</ml:id>
																			</ml:apply>
																		</ml:parens>
																		<ml:real>8</ml:real>
																	</ml:apply>
																</ml:apply>
															</ml:parens>
															<ml:real>0.125</ml:real>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve" subscript="pu.SS">f</ml:id>
											<ml:id xml:space="preserve">ksi</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve" subscript="p.SS">E</ml:id>
												<ml:id xml:space="preserve">ksi</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve">ε</ml:id>
										</ml:apply>
										<ml:parens>
											<ml:apply>
												<ml:plus/>
												<ml:real>0.08</ml:real>
												<ml:apply>
													<ml:div/>
													<ml:real>0.92</ml:real>
													<ml:apply>
														<ml:pow/>
														<ml:parens>
															<ml:apply>
																<ml:plus/>
																<ml:real>1</ml:real>
																<ml:apply>
																	<ml:pow/>
																	<ml:parens>
																		<ml:apply>
																			<ml:mult/>
																			<ml:real>99</ml:real>
																			<ml:id xml:space="preserve">ε</ml:id>
																		</ml:apply>
																	</ml:parens>
																	<ml:real>8</ml:real>
																</ml:apply>
