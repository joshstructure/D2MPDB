													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">a</ml:id>
													<ml:str xml:space="preserve">VI</ml:str>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:plus/>
												<ml:apply>
													<ml:plus/>
													<ml:parens>
														<ml:apply>
															<ml:equal/>
															<ml:id xml:space="preserve">a</ml:id>
															<ml:str xml:space="preserve">FBT72</ml:str>
														</ml:apply>
													</ml:parens>
													<ml:parens>
														<ml:apply>
															<ml:equal/>
															<ml:id xml:space="preserve">a</ml:id>
															<ml:str xml:space="preserve">FBT78</ml:str>
														</ml:apply>
													</ml:parens>
												</ml:apply>
												<ml:parens>
													<ml:apply>
														<ml:equal/>
														<ml:id xml:space="preserve">b</ml:id>
														<ml:str xml:space="preserve">FUB</ml:str>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">b</ml:id>
													<ml:str xml:space="preserve">FIB</ml:str>
												</ml:apply>
											</ml:parens>
										</ml:apply>
									</ml:apply>
									<ml:localDefine>
