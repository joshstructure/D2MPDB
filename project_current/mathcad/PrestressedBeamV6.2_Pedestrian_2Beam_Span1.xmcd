		<region region-id="202050" left="246" top="19971" width="111.75" height="11.25" align-x="257.25" align-y="19980" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="LRFD" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">SDG 4.3.2.D &amp; 4.4.3.A</p>
			</text>
		</region>
		<region region-id="202051" left="6" top="20001" width="286.5" height="15" align-x="58.5" align-y="20010" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">NetCamber</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:apply>
							<ml:plus/>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:id xml:space="preserve">max</ml:id>
									<ml:id xml:space="preserve" subscript="120day">Defl</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:id xml:space="preserve">min</ml:id>
									<ml:id xml:space="preserve" subscript="dl.nc">Defl</ml:id>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">min</ml:id>
								<ml:id xml:space="preserve" subscript="dl.c">Defl</ml:id>
							</ml:apply>
						</ml:apply>
						<ml:unitOverride>
							<ml:id xml:space="preserve">in</ml:id>
						</ml:unitOverride>
						<result xmlns="http://schemas.mathsoft.com/math30">
							<unitedValue>
								<ml:real>0.030455438593645807</ml:real>
								<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
									<unitReference unit="inch"/>
								</unitMonomial>
							</unitedValue>
						</result>
					</ml:eval>
				</ml:define>
			</math>
			<rendering item-idref="712"/>
		</region>
		<region region-id="202052" left="6" top="20037" width="240.75" height="12.75" align-x="82.5" align-y="20046" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">CheckNetCamber</ml:id>
					<ml:apply>
						<ml:id xml:space="preserve">if</ml:id>
						<ml:sequence>
							<ml:apply>
								<ml:greaterThan/>
								<ml:id xml:space="preserve">NetCamber</ml:id>
								<ml:real>0</ml:real>
							</ml:apply>
							<ml:str xml:space="preserve">OK</ml:str>
							<ml:str xml:space="preserve">No Good</ml:str>
						</ml:sequence>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="713"/>
		</region>
		<region region-id="202053" left="390" top="20037" width="112.5" height="12.75" align-x="465" align-y="20046" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ffff80" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">CheckNetCamber</ml:id>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<ml:str xml:space="preserve">OK</ml:str>
					</result>
				</ml:eval>
			</math>
			<rendering item-idref="714"/>
		</region>
