										<ml:div/>
										<ml:real>-1</ml:real>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve" subscript="pi">n</ml:id>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:apply>
