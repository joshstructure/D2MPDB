				<region region-id="140853" left="6" top="3881.25" width="159" height="15" align-x="73.5" align-y="3890.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">pos_m_fatigue</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">compl</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve" subscript="truck">M</ml:id>
