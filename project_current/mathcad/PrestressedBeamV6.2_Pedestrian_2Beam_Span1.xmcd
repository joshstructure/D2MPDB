					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">total#Debonded</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:vectorSum/>
									<ml:id xml:space="preserve">chk#DebondedInGroup</ml:id>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:real>8</ml:real>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="202319" left="228" top="4977" width="214.5" height="12.75" align-x="292.5" align-y="4986" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">maxDebonded</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:lessOrEqual/>
											<ml:id xml:space="preserve">total#Debonded</ml:id>
											<ml:real>10</ml:real>
										</ml:apply>
										<ml:real>4</ml:real>
										<ml:real>6</ml:real>
									</ml:sequence>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:real>4</ml:real>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="174396" left="6" top="5019" width="545.25" height="12.75" align-x="108.75" align-y="5028" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">Chk#DebondedInGroup</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:lessOrEqual/>
										<ml:apply>
											<ml:id xml:space="preserve">max</ml:id>
											<ml:id xml:space="preserve">chk#DebondedInGroup</ml:id>
										</ml:apply>
										<ml:id xml:space="preserve">maxDebonded</ml:id>
									</ml:apply>
									<ml:str xml:space="preserve">OK</ml:str>
									<ml:str xml:space="preserve">No Good, &gt; 6 or 4 debonded strands in 1 group.</ml:str>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
