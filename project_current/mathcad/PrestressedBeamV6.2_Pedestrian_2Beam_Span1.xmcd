				<region region-id="177560" left="6" top="5127" width="349.5" height="64.5" align-x="33" align-y="5136" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="pR">Δf</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:program>
									<ml:ifThen>
