				<region region-id="201988" left="6" top="3387" width="310.5" height="144" align-x="39" align-y="3396" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="s.split">A</ml:id>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:range>
										<ml:real>1</ml:real>
										<ml:real>3</ml:real>
									</ml:range>
									<ml:program>
										<ml:localDefine>
											<ml:id xml:space="preserve">j</ml:id>
											<ml:real>0</ml:real>
										</ml:localDefine>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="split">As</ml:id>
												<ml:id xml:space="preserve">i</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:real>0</ml:real>
												<ml:apply>
													<ml:pow/>
													<ml:id xml:space="preserve">in</ml:id>
													<ml:real>2</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
										<ml:while>
											<ml:apply>
												<ml:lessOrEqual/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">StirrrupLocation&amp;Area</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>0</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:id xml:space="preserve">ft</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="zone">L</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:program>
												<ml:localDefine>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="split">As</ml:id>
														<ml:id xml:space="preserve">i</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:plus/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="split">As</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">StirrrupLocation&amp;Area</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">j</ml:id>
																	<ml:real font="0">1</ml:real>
																</ml:sequence>
															</ml:apply>
															<ml:apply>
																<ml:pow/>
																<ml:id xml:space="preserve">in</ml:id>
																<ml:real>2</ml:real>
															</ml:apply>
														</ml:apply>
													</ml:apply>
												</ml:localDefine>
												<ml:localDefine>
													<ml:id xml:space="preserve">j</ml:id>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve">j</ml:id>
														<ml:real>1</ml:real>
													</ml:apply>
												</ml:localDefine>
											</ml:program>
										</ml:while>
									</ml:program>
								</ml:for>
								<ml:id xml:space="preserve" subscript="split">As</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
