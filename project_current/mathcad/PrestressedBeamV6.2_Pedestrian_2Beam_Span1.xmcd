											<ml:apply>
												<ml:minus/>
												<ml:apply>
													<ml:summation/>
													<ml:lambda>
														<ml:boundVars>
															<ml:id xml:space="preserve">nc</ml:id>
														</ml:boundVars>
														<ml:apply>
															<ml:indexer/>
