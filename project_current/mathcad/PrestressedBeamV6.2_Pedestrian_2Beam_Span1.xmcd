								<ml:id xml:space="preserve">fCheckDC</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">Title</ml:id>
									<ml:id xml:space="preserve">Vu</ml:id>
									<ml:id xml:space="preserve">Vr</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">ratio</ml:id>
									<ml:real>.01</ml:real>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:id xml:space="preserve">last</ml:id>
											<ml:id xml:space="preserve">Vr</ml:id>
										</ml:apply>
									</ml:range>
									<ml:ifThen>
										<ml:apply>
											<ml:mult/>
											<ml:parens>
												<ml:apply>
													<ml:greaterThan/>
													<ml:apply>
														<ml:div/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Vu</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Vr</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:id xml:space="preserve">ratio</ml:id>
												</ml:apply>
											</ml:parens>
											<ml:parens>
												<ml:apply>
													<ml:greaterOrEqual/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">Location</ml:id>
														<ml:id xml:space="preserve">i</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">Location</ml:id>
														<ml:id xml:space="preserve">ishear</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:program>
											<ml:localDefine>
												<ml:id xml:space="preserve">index</ml:id>
												<ml:id xml:space="preserve">i</ml:id>
											</ml:localDefine>
											<ml:localDefine>
												<ml:id xml:space="preserve">ratio</ml:id>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">Vu</ml:id>
														<ml:id xml:space="preserve">i</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">Vr</ml:id>
														<ml:id xml:space="preserve">i</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:localDefine>
										</ml:program>
									</ml:ifThen>
								</ml:for>
								<ml:matrix rows="2" cols="4">
									<ml:str xml:space="preserve">CheckType</ml:str>
									<ml:id xml:space="preserve">Title</ml:id>
									<ml:str xml:space="preserve">Location(ft)</ml:str>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">Location</ml:id>
											<ml:id xml:space="preserve">index</ml:id>
										</ml:apply>
										<ml:id xml:space="preserve">ft</ml:id>
									</ml:apply>
									<ml:str xml:space="preserve">Vu (kip)</ml:str>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">Vu</ml:id>
											<ml:id xml:space="preserve">index</ml:id>
										</ml:apply>
										<ml:id xml:space="preserve">kip</ml:id>
									</ml:apply>
									<ml:str xml:space="preserve">Vr (kip)</ml:str>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">Vr</ml:id>
											<ml:id xml:space="preserve">index</ml:id>
										</ml:apply>
										<ml:id xml:space="preserve">kip</ml:id>
									</ml:apply>
								</ml:matrix>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="184230" left="6" top="2559" width="219.75" height="15" align-x="80.25" align-y="2568" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffd5d5" tag="">
