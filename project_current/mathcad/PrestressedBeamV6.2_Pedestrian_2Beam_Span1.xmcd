				</region>
				<region region-id="187012" left="6" top="3027" width="454.5" height="59.25" align-x="62.25" align-y="3036" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="d.long.end.bot">L</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:program>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">MildReinfType</ml:id>
											<ml:str xml:space="preserve">Carbon Steel</ml:str>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">Bar</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">BarSizeLongEndBot</ml:id>
													<ml:real>3</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:id xml:space="preserve">in</ml:id>
										</ml:apply>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">MildReinfType</ml:id>
											<ml:str xml:space="preserve">Stainless Steel</ml:str>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="SS">Bar</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">BarSizeLongEndBot</ml:id>
													<ml:real>3</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:id xml:space="preserve">in</ml:id>
										</ml:apply>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">MildReinfType</ml:id>
											<ml:str xml:space="preserve">Glass Fiber Reinforced Polymer</ml:str>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve" subscript="d.GFRP">fL</ml:id>
											<ml:id xml:space="preserve">BarSizeLongEndBot</ml:id>
										</ml:apply>
									</ml:ifThen>
								</ml:program>
								<ml:unitOverride>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>0</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="187010" left="6" top="3099" width="200.25" height="15" align-x="62.25" align-y="3108" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
