				<region region-id="39826" left="6" top="10547.25" width="246.75" height="46.5" align-x="36" align-y="10556.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="e.slab">b</ml:id>
							<ml:program>
