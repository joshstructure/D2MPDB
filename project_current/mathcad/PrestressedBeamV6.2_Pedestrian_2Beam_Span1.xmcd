				<region region-id="16097" left="6" top="3785.25" width="192" height="12.75" align-x="64.5" align-y="3794.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
