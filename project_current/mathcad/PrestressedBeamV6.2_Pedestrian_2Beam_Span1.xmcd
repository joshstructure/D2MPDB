				</region>
				<region region-id="147412" left="6" top="249" width="469.5" height="11.25" align-x="20.25" align-y="258" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Section properties function for area and centroid of the area above the location where principal stress is checked </p>
					</text>
				</region>
				<region region-id="147413" left="6" top="273" width="270" height="273" align-x="89.25" align-y="282" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">PropWebCheck</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">q</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">nr</ml:id>
									<ml:apply>
										<ml:id xml:space="preserve">rows</ml:id>
										<ml:id xml:space="preserve">q</ml:id>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">s</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">m1</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">a</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:parens>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve">nr</ml:id>
												<ml:real>2</ml:real>
											</ml:apply>
										</ml:parens>
									</ml:range>
									<ml:program>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">q</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">i</ml:id>
													<ml:real>1</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:apply>
												<ml:id xml:space="preserve">max</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">q</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">i</ml:id>
															<ml:real>1</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:div/>
														<ml:id xml:space="preserve" subscript="web">y</ml:id>
														<ml:id xml:space="preserve">in</ml:id>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">q</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve">i</ml:id>
														<ml:real>1</ml:real>
													</ml:apply>
													<ml:real>1</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:apply>
												<ml:id xml:space="preserve">max</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">q</ml:id>
														<ml:sequence>
															<ml:apply>
																<ml:plus/>
																<ml:id xml:space="preserve">i</ml:id>
																<ml:real>1</ml:real>
															</ml:apply>
															<ml:real>1</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:div/>
														<ml:id xml:space="preserve" subscript="web">y</ml:id>
														<ml:id xml:space="preserve">in</ml:id>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve">s</ml:id>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">q</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">i</ml:id>
																<ml:real>0</ml:real>
															</ml:sequence>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">q</ml:id>
															<ml:sequence>
																<ml:apply>
																	<ml:plus/>
																	<ml:id xml:space="preserve">i</ml:id>
																	<ml:real>1</ml:real>
																</ml:apply>
																<ml:real>1</ml:real>
															</ml:sequence>
														</ml:apply>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">q</ml:id>
															<ml:sequence>
																<ml:apply>
																	<ml:plus/>
																	<ml:id xml:space="preserve">i</ml:id>
																	<ml:real>1</ml:real>
																</ml:apply>
																<ml:real>0</ml:real>
															</ml:sequence>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">q</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">i</ml:id>
																<ml:real>1</ml:real>
															</ml:sequence>
														</ml:apply>
													</ml:apply>
												</ml:apply>
												<ml:real>2</ml:real>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve">m1</ml:id>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve">m1</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:id xml:space="preserve">s</ml:id>
													<ml:apply>
														<ml:div/>
														<ml:apply>
															<ml:plus/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">q</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">i</ml:id>
																	<ml:real>1</ml:real>
																</ml:sequence>
															</ml:apply>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">q</ml:id>
																<ml:sequence>
																	<ml:apply>
																		<ml:plus/>
																		<ml:id xml:space="preserve">i</ml:id>
																		<ml:real>1</ml:real>
																	</ml:apply>
																	<ml:real>1</ml:real>
																</ml:sequence>
															</ml:apply>
														</ml:apply>
														<ml:real>3</ml:real>
													</ml:apply>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve">a</ml:id>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve">a</ml:id>
												<ml:id xml:space="preserve">s</ml:id>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:for>
								<ml:apply>
									<ml:transpose/>
									<ml:matrix rows="1" cols="2">
										<ml:apply>
											<ml:neg/>
											<ml:id xml:space="preserve">a</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve">m1</ml:id>
											<ml:id xml:space="preserve">a</ml:id>
										</ml:apply>
									</ml:matrix>
								</ml:apply>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="147414" left="6" top="564" width="177.75" height="30" align-x="57.75" align-y="582" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">WebCheck</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">PropWebCheck</ml:id>
								<ml:apply>
									<ml:div/>
									<ml:id xml:space="preserve" subscript="beam">Coord</ml:id>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="147415" left="6" top="615" width="273.75" height="11.25" align-x="15" align-y="624" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Area of beam above the location where principal stress is checked<sp count="2"/>
						</p>
					</text>
				</region>
				<region region-id="147416" left="6" top="633" width="179.25" height="24" align-x="60.75" align-y="648" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="webcheck">Area</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:apply>
