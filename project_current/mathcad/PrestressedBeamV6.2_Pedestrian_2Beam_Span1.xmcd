				<region region-id="80578" left="6" top="9984" width="198" height="117.75" align-x="22.5" align-y="10002" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">vs</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">d</ml:id>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
										<ml:id xml:space="preserve">in</ml:id>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">nr</ml:id>
									<ml:apply>
										<ml:minus/>
										<ml:apply>
											<ml:id xml:space="preserve">rows</ml:id>
											<ml:id xml:space="preserve">d</ml:id>
										</ml:apply>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:localDefine>
								<ml:ifThen>
									<ml:apply>
										<ml:greaterThan/>
										<ml:apply>
											<ml:plus/>
											<ml:id xml:space="preserve">nr</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
										<ml:real>1</ml:real>
									</ml:apply>
									<ml:for>
										<ml:id xml:space="preserve">i</ml:id>
										<ml:range>
											<ml:real>0</ml:real>
											<ml:id xml:space="preserve">nr</ml:id>
										</ml:range>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">p</ml:id>
												<ml:id xml:space="preserve">i</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:minus/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">d</ml:id>
													<ml:sequence>
														<ml:apply>
															<ml:plus/>
															<ml:id xml:space="preserve">i</ml:id>
															<ml:real>1</ml:real>
														</ml:apply>
														<ml:real>51</ml:real>
													</ml:sequence>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">d</ml:id>
													<ml:sequence>
														<ml:id xml:space="preserve">i</ml:id>
														<ml:real>51</ml:real>
													</ml:sequence>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
									</ml:for>
								</ml:ifThen>
								<ml:otherwise>
									<ml:localDefine>
										<ml:id xml:space="preserve">p</ml:id>
										<ml:real>0</ml:real>
									</ml:localDefine>
								</ml:otherwise>
								<ml:apply>
									<ml:id xml:space="preserve">max</ml:id>
									<ml:id xml:space="preserve">p</ml:id>
								</ml:apply>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="80763" left="288" top="10029" width="135.75" height="15" align-x="327" align-y="10038" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
