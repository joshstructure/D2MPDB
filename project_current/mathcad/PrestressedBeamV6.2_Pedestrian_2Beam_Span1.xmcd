											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:for>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve">area</ml:id>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve">in</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:apply>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="147655" left="312" top="3291" width="220.5" height="21" align-x="349.5" align-y="3306" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
