				<region region-id="174432" left="6" top="4155" width="153.75" height="11.25" align-x="22.5" align-y="4164" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">function to check strand pattern rules</p>
					</text>
				</region>
				<region region-id="174385" left="6" top="4185" width="373.5" height="45.75" align-x="130.5" align-y="4194" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:provenance expr-id="1" xmlns:ml="http://schemas.mathsoft.com/math30">
							<originRef doc-id="D14AEA97-1625-4217-BE58-378E1140B5F1" version-id="F91DD217-7E9B-42F1-B7A5-9AC553CE101B" branch-id="00000000-0000-0000-0000-000000000000" revision-num="301173484" is-modified="false" region-id="0" href="C:\March2020-Programs\PrestressedBeamApril 2020\StrandChecks.xmcd" xmlns="http://schemas.mathsoft.com/provenance10">
								<hash/>
							</originRef>
							<parentRef doc-id="D14AEA97-1625-4217-BE58-378E1140B5F1" version-id="F91DD217-7E9B-42F1-B7A5-9AC553CE101B" branch-id="00000000-0000-0000-0000-000000000000" revision-num="301173764" is-modified="false" region-id="0" href="C:\March2020-Programs\PrestressedBeamApril 2020\StrandChecks.xmcd" xmlns="http://schemas.mathsoft.com/provenance10">
								<hash/>
							</parentRef>
							<comment xmlns="http://schemas.mathsoft.com/provenance10"/>
							<originComment xmlns="http://schemas.mathsoft.com/provenance10"/>
							<contentHash xmlns="http://schemas.mathsoft.com/provenance10">dbf7b2b4896ae9bdf1ce863d5fb5a1ad</contentHash>
							<ml:define>
								<ml:function>
									<ml:id xml:space="preserve">fChkMessage</ml:id>
									<ml:boundVars>
										<ml:id xml:space="preserve">chk</ml:id>
										<ml:id xml:space="preserve">message</ml:id>
									</ml:boundVars>
								</ml:function>
								<ml:program>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:apply>
												<ml:id xml:space="preserve">max</ml:id>
												<ml:id xml:space="preserve">chk</ml:id>
											</ml:apply>
											<ml:real>0</ml:real>
										</ml:apply>
										<ml:localDefine>
											<ml:id xml:space="preserve">mess</ml:id>
											<ml:str xml:space="preserve">OK</ml:str>
										</ml:localDefine>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:apply>
												<ml:id xml:space="preserve">max</ml:id>
												<ml:id xml:space="preserve">chk</ml:id>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
										<ml:localDefine>
											<ml:id xml:space="preserve">mess</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">concat</ml:id>
												<ml:sequence>
													<ml:str xml:space="preserve">No Good, </ml:str>
													<ml:id xml:space="preserve">message</ml:id>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
									</ml:ifThen>
									<ml:id xml:space="preserve">mess</ml:id>
								</ml:program>
							</ml:define>
						</ml:provenance>
					</math>
				</region>
				<region region-id="174386" left="6" top="4257" width="477.75" height="11.25" align-x="6" align-y="4266" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#efefef" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">1.<sp count="2"/>The number of strands debonded per row shall not exceed 45 percent of the strands provided in that row.</p>
					</text>
				</region>
				<region region-id="174387" left="6" top="4281" width="494.25" height="201.75" align-x="99.75" align-y="4290" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">chkDebondedPerRow</ml:id>
							<ml:parens>
								<ml:program>
									<ml:for>
										<ml:id xml:space="preserve">i</ml:id>
										<ml:range>
											<ml:real>0</ml:real>
											<ml:apply>
												<ml:minus/>
												<ml:apply>
													<ml:id xml:space="preserve">rows</ml:id>
													<ml:id xml:space="preserve">tendsect</ml:id>
												</ml:apply>
												<ml:real>1</ml:real>
											</ml:apply>
										</ml:range>
										<ml:program>
											<ml:ifThen>
												<ml:apply>
													<ml:equal/>
													<ml:apply>
														<ml:id xml:space="preserve">min</ml:id>
														<ml:apply>
															<ml:matcol/>
															<ml:parens>
																<ml:apply>
																	<ml:transpose/>
																	<ml:id xml:space="preserve">tendsect</ml:id>
																</ml:apply>
															</ml:parens>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:real>12</ml:real>
												</ml:apply>
												<ml:return>
													<ml:apply>
														<ml:id xml:space="preserve">augment</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">percent</ml:id>
															<ml:apply>
																<ml:id xml:space="preserve">augment</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">#Bonded</ml:id>
																	<ml:id xml:space="preserve">#Debonded</ml:id>
																</ml:sequence>
															</ml:apply>
														</ml:sequence>
													</ml:apply>
												</ml:return>
											</ml:ifThen>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">#Bonded</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
												<ml:real>0</ml:real>
											</ml:localDefine>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">#Debonded</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
												<ml:real>0</ml:real>
											</ml:localDefine>
											<ml:for>
												<ml:id xml:space="preserve">j</ml:id>
												<ml:range>
													<ml:real>0</ml:real>
													<ml:apply>
														<ml:minus/>
														<ml:apply>
															<ml:id xml:space="preserve">cols</ml:id>
															<ml:id xml:space="preserve">tendsect</ml:id>
