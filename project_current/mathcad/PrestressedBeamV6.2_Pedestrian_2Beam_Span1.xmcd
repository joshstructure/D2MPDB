														<ml:real>0.94</ml:real>
														<ml:apply>
															<ml:pow/>
															<ml:parens>
																<ml:apply>
																	<ml:plus/>
																	<ml:real>1</ml:real>
																	<ml:apply>
																		<ml:pow/>
																		<ml:parens>
																			<ml:apply>
																				<ml:mult/>
																				<ml:real>101</ml:real>
																				<ml:id xml:space="preserve">ε</ml:id>
																			</ml:apply>
																		</ml:parens>
																		<ml:real>6.45</ml:real>
																	</ml:apply>
																</ml:apply>
															</ml:parens>
															<ml:real>0.155</ml:real>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:apply>
