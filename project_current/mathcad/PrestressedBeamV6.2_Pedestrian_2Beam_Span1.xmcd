					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="mom.exterior.multilane">f_g</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">idx</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">gmom</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:id xml:space="preserve" subscript="mom.interior.multilane">g</ml:id>
											<ml:parens>
												<ml:apply>
													<ml:plus/>
													<ml:real>0.77</ml:real>
													<ml:apply>
														<ml:div/>
														<ml:id xml:space="preserve" subscript="e">d</ml:id>
														<ml:apply>
															<ml:mult/>
															<ml:real>9.1</ml:real>
															<ml:id xml:space="preserve">ft</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:greaterOrEqual/>
												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:real>1.04</ml:real>
														<ml:apply>
															<ml:div/>
															<ml:id xml:space="preserve" subscript="e">d</ml:id>
															<ml:apply>
																<ml:mult/>
																<ml:real>25</ml:real>
																<ml:id xml:space="preserve">ft</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:apply>
												</ml:parens>
												<ml:real>1</ml:real>
											</ml:apply>
											<ml:localDefine>
												<ml:id xml:space="preserve">gmom</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:id xml:space="preserve" subscript="mom.interior.multilane">g</ml:id>
													<ml:parens>
														<ml:apply>
															<ml:plus/>
															<ml:real>1.04</ml:real>
															<ml:apply>
																<ml:div/>
																<ml:id xml:space="preserve" subscript="e">d</ml:id>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>25</ml:real>
																	<ml:id xml:space="preserve">ft</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:apply>
													</ml:parens>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:id xml:space="preserve">gmom</ml:id>
												<ml:id xml:space="preserve" subscript="mom.interior.multilane">g</ml:id>
											</ml:localDefine>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
									<ml:localDefine>
