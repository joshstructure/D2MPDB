				</region>
				<region region-id="188140" left="6" top="1101" width="231.75" height="11.25" align-x="24" align-y="1110" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">overwrite sections from end of beam to inside face of pad </p>
					</text>
				</region>
				<region region-id="188331" left="6" top="1136.25" width="166.5" height="33" align-x="47.25" align-y="1152" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="long">iFace</ml:id>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:id xml:space="preserve">round</ml:id>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:mult/>
											<ml:real>0.5</ml:real>
											<ml:id xml:space="preserve">PadWidth</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">a</ml:id>
												<ml:real>2</ml:real>
											</ml:apply>
											<ml:id xml:space="preserve">ft</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<ml:real>1</ml:real>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="188332" left="222" top="1143" width="57.75" height="15" align-x="261.75" align-y="1152" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="long">iFace</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:real>1</ml:real>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="188333" left="6" top="1185" width="75.75" height="15" align-x="27" align-y="1194" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">hs2</ml:id>
							<ml:range>
								<ml:real>0</ml:real>
								<ml:id xml:space="preserve" subscript="long">iFace</ml:id>
							</ml:range>
						</ml:define>
					</math>
				</region>
				<region region-id="188334" left="156" top="1185" width="85.5" height="18.75" align-x="207.75" align-y="1194" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="long.reqd">V</ml:id>
								<ml:id xml:space="preserve">hs2</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:real>0</ml:real>
								<ml:id xml:space="preserve">kip</ml:id>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="32518" left="6" top="1221" width="390" height="11.25" align-x="25.5" align-y="1230" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Determine Percentage of strand development for fully bonded tendons (used for draped strands)</p>
					</text>
				</region>
				<region region-id="32522" left="6" top="1239" width="196.5" height="83.25" align-x="67.5" align-y="1248" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">PercentDev</ml:id>
								<ml:id xml:space="preserve">hs</ml:id>
							</ml:apply>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:lessThan/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">Location</ml:id>
											<ml:id xml:space="preserve">hs</ml:id>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="t">L</ml:id>
									</ml:apply>
									<ml:real>0</ml:real>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:greaterThan/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">Location</ml:id>
											<ml:id xml:space="preserve">hs</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="d">L</ml:id>
											<ml:real>0</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:real>1</ml:real>
								</ml:ifThen>
								<ml:otherwise>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">Location</ml:id>
												<ml:id xml:space="preserve">hs</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve" subscript="t">L</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="d">L</ml:id>
												<ml:real>0</ml:real>
											</ml:apply>
											<ml:id xml:space="preserve" subscript="t">L</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="32525" left="6" top="1335" width="427.5" height="11.25" align-x="25.5" align-y="1344" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Determine effective area of developed straight strands (fully bonded &amp; debonded) beyond transfer length</p>
					</text>
				</region>
				<region region-id="32526" left="6" top="1353" width="519" height="319.5" align-x="42.75" align-y="1362" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="pss.dev">A</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:while>
									<ml:apply>
										<ml:lessThan/>
										<ml:id xml:space="preserve">j</ml:id>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:id xml:space="preserve">last</ml:id>
												<ml:id xml:space="preserve">Location</ml:id>
											</ml:apply>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:program>
										<ml:for>
											<ml:id xml:space="preserve">i</ml:id>
											<ml:range>
												<ml:real>0</ml:real>
												<ml:apply>
													<ml:id xml:space="preserve">last</ml:id>
													<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
												</ml:apply>
											</ml:range>
											<ml:program>
												<ml:ifThen>
													<ml:apply>
														<ml:equal/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">i</ml:id>
																<ml:id xml:space="preserve">j</ml:id>
															</ml:sequence>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">i</ml:id>
																<ml:apply>
																	<ml:plus/>
																	<ml:id xml:space="preserve">j</ml:id>
																	<ml:real>1</ml:real>
																</ml:apply>
															</ml:sequence>
														</ml:apply>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">apss</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
													</ml:localDefine>
												</ml:ifThen>
												<ml:otherwise>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">apss</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:mult style="auto-select"/>
															<ml:real>0</ml:real>
															<ml:apply>
																<ml:pow/>
																<ml:id xml:space="preserve">in</ml:id>
																<ml:real>2</ml:real>
															</ml:apply>
														</ml:apply>
													</ml:localDefine>
												</ml:otherwise>
												<ml:ifThen>
													<ml:apply>
														<ml:lessThan/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Location</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:plus/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
																<ml:id xml:space="preserve">i</ml:id>
															</ml:apply>
															<ml:id xml:space="preserve" subscript="t">L</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">PercentDev</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:real>0</ml:real>
													</ml:localDefine>
												</ml:ifThen>
												<ml:ifThen>
													<ml:apply>
														<ml:mult/>
														<ml:parens>
															<ml:apply>
																<ml:greaterOrEqual/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">Location</ml:id>
																	<ml:id xml:space="preserve">j</ml:id>
																</ml:apply>
																<ml:apply>
																	<ml:plus/>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
																		<ml:id xml:space="preserve">i</ml:id>
																	</ml:apply>
																	<ml:id xml:space="preserve" subscript="t">L</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
														<ml:parens>
															<ml:apply>
																<ml:lessThan/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">Location</ml:id>
																	<ml:id xml:space="preserve">j</ml:id>
																</ml:apply>
																<ml:apply>
																	<ml:plus/>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
																		<ml:id xml:space="preserve">i</ml:id>
																	</ml:apply>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve" subscript="d">L</ml:id>
																		<ml:id xml:space="preserve">i</ml:id>
																	</ml:apply>
																</ml:apply>
															</ml:apply>
														</ml:parens>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">PercentDev</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:div/>
															<ml:apply>
																<ml:minus/>
																<ml:apply>
																	<ml:minus/>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve">Location</ml:id>
																		<ml:id xml:space="preserve">j</ml:id>
																	</ml:apply>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
																		<ml:id xml:space="preserve">i</ml:id>
																	</ml:apply>
																</ml:apply>
																<ml:id xml:space="preserve" subscript="t">L</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:minus/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve" subscript="d">L</ml:id>
																	<ml:id xml:space="preserve">i</ml:id>
																</ml:apply>
																<ml:id xml:space="preserve" subscript="t">L</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:localDefine>
												</ml:ifThen>
												<ml:ifThen>
													<ml:apply>
														<ml:greaterOrEqual/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Location</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:plus/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
																<ml:id xml:space="preserve">i</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="d">L</ml:id>
																<ml:id xml:space="preserve">i</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">PercentDev</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:real>1</ml:real>
													</ml:localDefine>
												</ml:ifThen>
												<ml:localDefine>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">apss</ml:id>
														<ml:id xml:space="preserve">i</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">apss</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">PercentDev</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:localDefine>
											</ml:program>
										</ml:for>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="pss">a</ml:id>
												<ml:id xml:space="preserve">j</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:vectorSum/>
												<ml:id xml:space="preserve">apss</ml:id>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve">j</ml:id>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve">j</ml:id>
												<ml:real>1</ml:real>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:while>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="pss">a</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:mult style="auto-select"/>
										<ml:real>0.001</ml:real>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">in</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:localDefine>
								<ml:id xml:space="preserve" subscript="pss">a</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="178389" left="6" top="1701" width="191.25" height="11.25" align-x="19.5" align-y="1710" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Design strenth of longitudinal mild reinforcing</p>
					</text>
				</region>
				<region region-id="188284" left="6" top="1725" width="141" height="12.75" align-x="72" align-y="1734" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">MildReinfType</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:str xml:space="preserve">Carbon Steel</ml:str>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="188273" left="6" top="1761" width="350.25" height="15" align-x="42" align-y="1770" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="y.d.long">f</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:parens>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">MildReinfType</ml:id>
												<ml:str xml:space="preserve">Glass Fiber Reinforced Polymer</ml:str>
											</ml:apply>
										</ml:parens>
										<ml:id xml:space="preserve" subscript="fd.long">f</ml:id>
										<ml:id xml:space="preserve" subscript="y">f</ml:id>
									</ml:sequence>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">ksi</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>60</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="kips_per_sq_inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="188272" left="372" top="1761" width="150" height="22.5" align-x="384.75" align-y="1770" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">design strength for full length bottom longitudinal reinforcing</p>
					</text>
				</region>
				<region region-id="188276" left="414" top="1791" width="123.75" height="33.75" align-x="426.75" align-y="1800" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">design strength for beam end bottom longitudinal reinforcing</p>
					</text>
				</region>
				<region region-id="188277" left="6" top="1803" width="399.75" height="15" align-x="66.75" align-y="1812" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="y.d.long.end.bot">f</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:parens>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">MildReinfType</ml:id>
												<ml:str xml:space="preserve">Glass Fiber Reinforced Polymer</ml:str>
											</ml:apply>
										</ml:parens>
										<ml:id xml:space="preserve" subscript="fd.long.end.bot">f</ml:id>
										<ml:id xml:space="preserve" subscript="y">f</ml:id>
									</ml:sequence>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">ksi</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>60</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="kips_per_sq_inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="188148" left="6" top="1845" width="447.75" height="36" align-x="54.75" align-y="1854" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
