													<ml:apply>
														<ml:mult style="auto-select"/>
														<ml:id xml:space="preserve" subscript="i">ε</ml:id>
														<ml:parens>
															<ml:apply>
																<ml:minus/>
																<ml:real>1</ml:real>
																<ml:apply>
																	<ml:div/>
																	<ml:apply>
																		<ml:mult/>
																		<ml:id xml:space="preserve">dif</ml:id>
																		<ml:real>0.5</ml:real>
																	</ml:apply>
																	<ml:id xml:space="preserve">fp</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
													</ml:apply>
												</ml:localDefine>
											</ml:program>
										</ml:ifThen>
										<ml:ifThen>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">strandtype</ml:id>
												<ml:real>3</ml:real>
											</ml:apply>
											<ml:program>
												<ml:localDefine>
													<ml:id xml:space="preserve">fpt</ml:id>
													<ml:apply>
														<ml:id xml:space="preserve" subscript="p.CFRP">f_f</ml:id>
														<ml:id xml:space="preserve" subscript="i">ε</ml:id>
													</ml:apply>
												</ml:localDefine>
												<ml:localDefine>
													<ml:id xml:space="preserve">dif</ml:id>
													<ml:apply>
														<ml:minus/>
														<ml:id xml:space="preserve">fpt</ml:id>
														<ml:id xml:space="preserve">fp</ml:id>
													</ml:apply>
												</ml:localDefine>
												<ml:localDefine>
													<ml:id xml:space="preserve" subscript="i">ε</ml:id>
													<ml:apply>
														<ml:mult style="auto-select"/>
														<ml:id xml:space="preserve" subscript="i">ε</ml:id>
														<ml:parens>
															<ml:apply>
																<ml:minus/>
																<ml:real>1</ml:real>
																<ml:apply>
																	<ml:div/>
																	<ml:apply>
																		<ml:mult/>
																		<ml:id xml:space="preserve">dif</ml:id>
																		<ml:real>0.5</ml:real>
																	</ml:apply>
																	<ml:id xml:space="preserve">fp</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
													</ml:apply>
												</ml:localDefine>
											</ml:program>
										</ml:ifThen>
										<ml:otherwise>
											<ml:program>
												<ml:localDefine>
													<ml:id xml:space="preserve" subscript="i">ε</ml:id>
													<ml:real>0</ml:real>
												</ml:localDefine>
												<ml:localDefine>
													<ml:id xml:space="preserve">dif</ml:id>
													<ml:real>0</ml:real>
												</ml:localDefine>
											</ml:program>
										</ml:otherwise>
									</ml:program>
								</ml:while>
								<ml:id xml:space="preserve" subscript="i">ε</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="152470" left="6" top="6009" width="59.25" height="15" align-x="21" align-y="6018" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="p">E</ml:id>
							<ml:unitOverride>
								<ml:id xml:space="preserve">ksi</ml:id>
