				<region region-id="132178" left="6" top="981" width="228" height="35.25" align-x="85.5" align-y="1002" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">PercentTransfer</ml:id>
								<ml:id xml:space="preserve">hc</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:lessThan/>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">Location</ml:id>
												<ml:id xml:space="preserve">hc</ml:id>
											</ml:apply>
