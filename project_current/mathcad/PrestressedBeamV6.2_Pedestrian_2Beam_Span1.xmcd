												<ml:real>0</ml:real>
												<ml:apply>
													<ml:pow/>
													<ml:id xml:space="preserve">in</ml:id>
													<ml:real>2</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
										<ml:while>
											<ml:apply>
												<ml:lessOrEqual/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">StirrrupLocation&amp;Area</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">j</ml:id>
															<ml:real>0</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:id xml:space="preserve">ft</ml:id>
												</ml:apply>
