				<region region-id="177565" left="6" top="5244" width="281.25" height="32.25" align-x="37.5" align-y="5262" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="pLT">Δf</ml:id>
							<ml:apply>
								<ml:neg/>
								<ml:parens>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:real>10</ml:real>
														<ml:apply>
															<ml:div/>
															<ml:apply>
																<ml:mult/>
																<ml:id xml:space="preserve" subscript="pj">f</ml:id>
																<ml:id xml:space="preserve" subscript="ps.total">A</ml:id>
															</ml:apply>
															<ml:id xml:space="preserve" subscript="beam">A</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="h">γ</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve" subscript="st">γ</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:parens>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:mult/>
															<ml:real>12</ml:real>
															<ml:id xml:space="preserve" subscript="h">γ</ml:id>
														</ml:apply>
														<ml:id xml:space="preserve" subscript="st">γ</ml:id>
													</ml:apply>
												</ml:parens>
												<ml:id xml:space="preserve">ksi</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="pR">Δf</ml:id>
									</ml:apply>
								</ml:parens>
							</ml:apply>
						</ml:define>
						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="5"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
