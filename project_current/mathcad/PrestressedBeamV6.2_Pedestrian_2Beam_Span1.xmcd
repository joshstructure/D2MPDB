				<region region-id="174392" left="6" top="4683" width="427.5" height="11.25" align-x="9" align-y="4692" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">If NoGood, the number of strands debonded per row exceeds 45% of the strands provided in that row.</p>
					</text>
				</region>
				<region region-id="174393" left="6" top="4713" width="524.25" height="22.5" align-x="6" align-y="4722" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#efefef" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">2<sp count="2"/>Debonding shall not be terminated for more than six strands in any given section. When a total of ten or fewer strands are debonded, debonding shall not be terminated for more than four strands in any given section.</p>
					</text>
				</region>
				<region region-id="174394" left="6" top="4755" width="310.5" height="105.75" align-x="107.25" align-y="4764" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">chk#DebondedInGroup</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">Count</ml:id>
										<ml:real>8</ml:real>
									</ml:apply>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:id xml:space="preserve">rows</ml:id>
												<ml:id xml:space="preserve">tendsect</ml:id>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:range>
									<ml:for>
										<ml:id xml:space="preserve">j</ml:id>
										<ml:range>
											<ml:real>0</ml:real>
											<ml:apply>
												<ml:minus/>
												<ml:apply>
													<ml:id xml:space="preserve">cols</ml:id>
													<ml:id xml:space="preserve">tendsect</ml:id>
												</ml:apply>
												<ml:real>1</ml:real>
											</ml:apply>
										</ml:range>
										<ml:for>
											<ml:id xml:space="preserve">n</ml:id>
											<ml:range>
												<ml:real>0</ml:real>
												<ml:real>9</ml:real>
											</ml:range>
											<ml:ifThen>
												<ml:apply>
													<ml:equal/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">tendsect</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">i</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:sequence>
													</ml:apply>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:localDefine>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">Count</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:plus/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Count</ml:id>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:apply>
														<ml:real>1</ml:real>
													</ml:apply>
												</ml:localDefine>
											</ml:ifThen>
										</ml:for>
									</ml:for>
								</ml:for>
								<ml:id xml:space="preserve">Count</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="174395" left="6" top="4869" width="130.5" height="144.75" align-x="105.75" align-y="4944" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
