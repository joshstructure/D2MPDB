				<region region-id="176689" left="6" top="2274.75" width="146.25" height="14.25" align-x="6" align-y="2286" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<f size="12">
								<b>Mild Reinforcement:</b>
							</f>
						</p>
					</text>
				</region>
				<region region-id="177182" left="6" top="2301" width="442.5" height="45.75" align-x="73.5" align-y="2310" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">MildReinfType</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:program>
									<ml:ifThen>
										<ml:apply>
											<ml:or/>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">inpMildReinfType</ml:id>
												<ml:real>0</ml:real>
											</ml:apply>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">inpMildReinfType</ml:id>
												<ml:real>3</ml:real>
											</ml:apply>
										</ml:apply>
										<ml:str xml:space="preserve">Carbon Steel</ml:str>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:or/>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">inpMildReinfType</ml:id>
												<ml:real>1</ml:real>
											</ml:apply>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">inpMildReinfType</ml:id>
												<ml:real>4</ml:real>
											</ml:apply>
										</ml:apply>
										<ml:str xml:space="preserve">Stainless Steel</ml:str>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">inpMildReinfType</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
										<ml:str xml:space="preserve">Glass Fiber Reinforced Polymer</ml:str>
									</ml:ifThen>
								</ml:program>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:str xml:space="preserve">Carbon Steel</ml:str>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="202293" left="6" top="2367" width="43.5" height="15" align-x="18.75" align-y="2376" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="y">f</ml:id>
							<ml:unitOverride>
								<ml:id xml:space="preserve">ksi</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>60</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="kips_per_sq_inch"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="177183" left="6" top="2391" width="181.5" height="11.25" align-x="6" align-y="2400" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">mild reinforcement modulus of elasticity</p>
					</text>
				</region>
				<region region-id="177179" left="6" top="2409" width="322.5" height="52.5" align-x="21.75" align-y="2418" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="s">E</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:program>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">MildReinfType</ml:id>
											<ml:str xml:space="preserve">Carbon Steel</ml:str>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="s.carbon">E</ml:id>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">MildReinfType</ml:id>
											<ml:str xml:space="preserve">Stainless Steel</ml:str>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="s.SS">E</ml:id>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">MildReinfType</ml:id>
											<ml:str xml:space="preserve">Glass Fiber Reinforced Polymer</ml:str>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="f">E</ml:id>
									</ml:ifThen>
								</ml:program>
								<ml:unitOverride>
									<ml:id xml:space="preserve">ksi</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>29000</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="kips_per_sq_inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
						<resultFormat numeric-only="true">
							<general precision="0" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="6"/>
