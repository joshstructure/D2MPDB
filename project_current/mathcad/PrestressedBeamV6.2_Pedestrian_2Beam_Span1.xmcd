				<region region-id="146574" left="6" top="7089" width="258.75" height="11.25" align-x="6" align-y="7098" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<f family="Arial" charset="0" size="10">
								<inlineAttr font-weight="normal">Correction Factors for Shear Live Load Distribution Factors</inlineAttr>
							</f>
						</p>
					</text>
				</region>
				<region region-id="202841" left="282" top="7095" width="161.25" height="11.25" align-x="282" align-y="7104" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">LRFD Table 4.6.2.2.3c-1</p>
					</text>
				</region>
				<region region-id="202844" left="6" top="7113" width="523.5" height="56.25" align-x="9.75" align-y="7122" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<f family="Arial" charset="0" size="10">LRFD BDS 4.6.2.2.3c: Shear in bridge girders </f>
							<f family="Arial" charset="0" size="10">
								<u>shall</u>
							</f>
							<f family="Arial" charset="0" size="10"> be adjusted when the line of support is skewed. The value of the correction factor shall be applied to the live load distribution factors, g, for exterior beams at the obtuse corner of the span, and interior beams.<sp count="2"/>If the beams are well connected and behave as a unit, only the exterior and first interior beam need to be adjusted.<sp count="2"/>
							</f>
							<f family="Arial" charset="0">The equal treatment of all beams in a multibeam bridge (box beams and deck girders) is conservative regarding positive reaction and shear.</f>
						</p>
					</text>
				</region>
				<region region-id="202848" left="6" top="7185" width="429" height="11.25" align-x="30" align-y="7194" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Calculations for shear correction factors are conservatively applied to all interior and exterior beams.</p>
					</text>
				</region>
				<region region-id="150512" left="6" top="7212" width="351" height="132" align-x="103.5" align-y="7242" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffc6c6" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">fCorrectionFactor</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">idx</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">factor</ml:id>
										<ml:apply>
											<ml:plus/>
											<ml:real>1.0</ml:real>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:real>0.20</ml:real>
													<ml:apply>
														<ml:pow/>
														<ml:parens>
															<ml:apply>
																<ml:div/>
																<ml:apply>
																	<ml:mult/>
																	<ml:id xml:space="preserve" subscript="s">L</ml:id>
																	<ml:apply>
																		<ml:pow/>
																		<ml:id xml:space="preserve" subscript="s">t</ml:id>
																		<ml:real>3</ml:real>
																	</ml:apply>
																</ml:apply>
																<ml:id xml:space="preserve" subscript="g">K</ml:id>
															</ml:apply>
														</ml:parens>
														<ml:real>0.3</ml:real>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:id xml:space="preserve">tan</ml:id>
													<ml:id xml:space="preserve">Skew</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">factor</ml:id>
										<ml:apply>
											<ml:plus/>
											<ml:real>1.0</ml:real>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:div/>
													<ml:id xml:space="preserve" subscript="s">L</ml:id>
													<ml:apply>
														<ml:mult/>
														<ml:real>90</ml:real>
														<ml:id xml:space="preserve" subscript="dist.ubeam">d</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:parens>
													<ml:apply>
														<ml:sqrt/>
														<ml:apply>
															<ml:id xml:space="preserve">tan</ml:id>
															<ml:id xml:space="preserve">Skew</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:parens>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">factor</ml:id>
										<ml:apply>
											<ml:plus/>
											<ml:real>1.0</ml:real>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:sqrt/>
														<ml:apply>
															<ml:mult/>
															<ml:id xml:space="preserve" subscript="s">L</ml:id>
															<ml:id xml:space="preserve" subscript="dist.ubeam">d</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:real>6</ml:real>
														<ml:id xml:space="preserve">S</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:id xml:space="preserve">tan</ml:id>
													<ml:id xml:space="preserve">Skew</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:id xml:space="preserve">factor</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="150521" left="66" top="7364.25" width="301.5" height="40.5" align-x="78" align-y="7374" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f2f2f2" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
