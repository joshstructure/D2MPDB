				<region region-id="150472" left="6" top="4254" width="192" height="30" align-x="80.25" align-y="4272" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="mom.exterior.fatigue">g</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
