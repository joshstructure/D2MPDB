				<region region-id="140854" left="228" top="3870.75" width="207" height="29.25" align-x="294.75" align-y="3890.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="fatiguetruck.pos">M</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
