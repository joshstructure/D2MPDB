													<ml:div/>
													<ml:apply>
														<ml:mult/>
														<ml:parens>
															<ml:apply>
																<ml:minus/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">Location</ml:id>
																	<ml:id xml:space="preserve">n</ml:id>
																</ml:apply>
																<ml:id xml:space="preserve">EndCover</ml:id>
															</ml:apply>
														</ml:parens>
														<ml:id xml:space="preserve" subscript="s.long.end.bot">A</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="d.long.end.bot">L</ml:id>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
										<ml:ifThen>
											<ml:apply>
												<ml:greaterThan/>
												<ml:apply>
