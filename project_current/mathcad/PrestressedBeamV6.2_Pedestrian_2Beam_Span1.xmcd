																<ml:apply>
																	<ml:minus/>
																	<ml:apply>
																		<ml:minus/>
																		<ml:id xml:space="preserve" subscript="pu.CFRP">ε</ml:id>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve">εse</ml:id>
																			<ml:id xml:space="preserve">i</ml:id>
																		</ml:apply>
																	</ml:apply>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve">εcp</ml:id>
																		<ml:id xml:space="preserve">i</ml:id>
																	</ml:apply>
																</ml:apply>
															</ml:parens>
															<ml:apply>
																<ml:div/>
																<ml:id xml:space="preserve">cna</ml:id>
																<ml:apply>
																	<ml:minus/>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:parens>
																			<ml:apply>
																				<ml:neg/>
																				<ml:id xml:space="preserve">d</ml:id>
																			</ml:apply>
																		</ml:parens>
																		<ml:id xml:space="preserve">i</ml:id>
																	</ml:apply>
																	<ml:id xml:space="preserve">cna</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:apply>
													</ml:localDefine>
												</ml:ifThen>
												<ml:otherwise>
													<ml:localDefine>
