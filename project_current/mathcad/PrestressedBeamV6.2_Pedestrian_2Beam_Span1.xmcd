							<contentHash xmlns="http://schemas.mathsoft.com/provenance10">b2189f09049a70ad52e0a097586a627a</contentHash>
							<ml:define>
								<ml:id xml:space="preserve" subscript="critical">Loc</ml:id>
								<ml:eval placeholderMultiplicationStyle="default">
									<ml:program>
										<ml:localDefine>
											<ml:id xml:space="preserve">i</ml:id>
											<ml:real>0</ml:real>
										</ml:localDefine>
										<ml:while>
											<ml:apply>
												<ml:lessOrEqual/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Location</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve" subscript="critical">L</ml:id>
											</ml:apply>
											<ml:localDefine>
												<ml:id xml:space="preserve">i</ml:id>
												<ml:apply>
													<ml:plus/>
													<ml:id xml:space="preserve">i</ml:id>
													<ml:real>1</ml:real>
												</ml:apply>
											</ml:localDefine>
										</ml:while>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve">i</ml:id>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:program>
									<result xmlns="http://schemas.mathsoft.com/math30">
										<ml:real>3</ml:real>
									</result>
								</ml:eval>
							</ml:define>
