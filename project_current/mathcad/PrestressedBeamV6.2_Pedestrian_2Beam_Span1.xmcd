																</ml:apply>
															</ml:parens>
															<ml:id xml:space="preserve" subscript="shear">g</ml:id>
														</ml:apply>
													</ml:parens>
												</ml:apply>
												<ml:id xml:space="preserve">kip</ml:id>
											</ml:apply>
											<ml:real>0.1</ml:real>
