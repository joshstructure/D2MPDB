				<region region-id="175944" left="6" top="9183" width="328.5" height="15" align-x="57.75" align-y="9192" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
