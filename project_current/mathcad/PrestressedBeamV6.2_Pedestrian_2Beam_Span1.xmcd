											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve">kip</ml:id>
												<ml:apply>
													<ml:pow/>
													<ml:id xml:space="preserve">ft</ml:id>
													<ml:real>3</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>1.3</ml:real>
										<ml:id xml:space="preserve">ksi</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>1.8</ml:real>
										<ml:id xml:space="preserve">ksi</ml:id>
									</ml:apply>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
