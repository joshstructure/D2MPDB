					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Lane Load Maximum Moments, Maximum Shears, and Moments associated with Maximum Shears </p>
					</text>
				</region>
				<region region-id="13837" left="6" top="4399.5" width="192.75" height="42.75" align-x="50.25" align-y="4430.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
