				<region region-id="133899" left="6" top="2253" width="359.25" height="15" align-x="70.5" align-y="2262" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">CheckStirArea</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:lessThan/>
											<ml:apply>
												<ml:id xml:space="preserve">max</ml:id>
												<ml:id xml:space="preserve" subscript="StirArea">DC</ml:id>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
										<ml:str xml:space="preserve">OK</ml:str>
										<ml:str xml:space="preserve">No Good, increase stirrups!</ml:str>
									</ml:sequence>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:str xml:space="preserve">OK</ml:str>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="13783" left="6" top="2276.25" width="177.75" height="39.75" align-x="51" align-y="2298" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="shear">D/C</ml:id>
