				<region region-id="32046" left="6" top="9075" width="272.25" height="11.25" align-x="6" align-y="9084" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Area of Concrete Beam in Tension (used in shear calculations)</p>
					</text>
