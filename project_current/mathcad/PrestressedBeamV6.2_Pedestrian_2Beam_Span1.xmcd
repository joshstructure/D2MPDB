				<region region-id="150863" left="108" top="789" width="308.25" height="11.25" align-x="122.25" align-y="798" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">assume a diameter of strand =0.6 inches for calculating the Location vector</p>
					</text>
				</region>
				<region region-id="150870" left="6" top="825" width="526.5" height="22.5" align-x="6" align-y="834" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">The Location vector defines the x location of the sections investigated relative to the start of the beam.<sp count="2"/>At the beam ends, the Location vector is not in even increments</p>
					</text>
				</region>
				<region region-id="146834" left="6" top="873" width="75" height="18" align-x="52.5" align-y="882" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">Location</ml:id>
								<ml:real>0</ml:real>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:real>0</ml:real>
								<ml:id xml:space="preserve">ft</ml:id>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="146835" left="102" top="873" width="162.75" height="18" align-x="148.5" align-y="882" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">Location</ml:id>
								<ml:real>1</ml:real>
							</ml:apply>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:id xml:space="preserve">BearingDistance</ml:id>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>0.66666666666666663</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="foot"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="146830" left="6" top="906" width="192.75" height="30" align-x="56.25" align-y="924" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">Location</ml:id>
								<ml:id xml:space="preserve">ns</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="span">L</ml:id>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve">nmax</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:parens>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve">ns</ml:id>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:parens>
								</ml:apply>
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve">Location</ml:id>
									<ml:real>1</ml:real>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="146836" left="228" top="915" width="90" height="18" align-x="288.75" align-y="924" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">Location</ml:id>
								<ml:id xml:space="preserve">nmax</ml:id>
							</ml:apply>
							<ml:id xml:space="preserve" subscript="beam">L</ml:id>
						</ml:define>
					</math>
				</region>
				<region region-id="150869" left="6" top="951" width="118.5" height="15" align-x="37.5" align-y="960" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
