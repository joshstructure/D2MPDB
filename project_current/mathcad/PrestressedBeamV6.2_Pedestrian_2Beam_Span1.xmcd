				<region region-id="183744" left="6" top="7436.25" width="507" height="27.75" align-x="6" align-y="7446" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">The <region region-id="144195" left="24" top="7437" width="24" height="15" align-x="35.25" align-y="7446" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" subscript="force" xmlns:ml="http://schemas.mathsoft.com/math30">fC</ml:id>
								</math>
							</region>
							<sp count="2"/>function calculates the compressive force assuming a maximum strain of 0.003.<sp count="2"/>It returns a two value vector containing this force and its distance from the top of the section.</p>
					</text>
				</region>
				<region region-id="183745" left="6" top="7473" width="353.25" height="405" align-x="150.75" align-y="7482" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="force">fC</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve" subscript="trap">w</ml:id>
									<ml:id xml:space="preserve" subscript="c">f</ml:id>
									<ml:id xml:space="preserve" subscript="trap">t</ml:id>
									<ml:id xml:space="preserve" subscript="traps">n</ml:id>
									<ml:id xml:space="preserve">cna</ml:id>
									<ml:id xml:space="preserve" subscript="cu">ε</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">thk</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="trap">t</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">w</ml:id>
										<ml:sequence>
											<ml:real>0</ml:real>
											<ml:real>0</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="trap">w</ml:id>
										<ml:sequence>
											<ml:real>0</ml:real>
											<ml:real>0</ml:real>
										</ml:sequence>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">w</ml:id>
										<ml:sequence>
											<ml:real>0</ml:real>
											<ml:real>1</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="trap">w</ml:id>
										<ml:sequence>
											<ml:real>0</ml:real>
											<ml:real>1</ml:real>
										</ml:sequence>
									</ml:apply>
								</ml:localDefine>
								<ml:while>
									<ml:apply>
										<ml:mult/>
										<ml:parens>
											<ml:apply>
												<ml:lessThan/>
												<ml:apply>
													<ml:summation/>
													<ml:lambda>
														<ml:boundVars>
															<ml:id xml:space="preserve">p</ml:id>
														</ml:boundVars>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="trap">t</ml:id>
															<ml:id xml:space="preserve">p</ml:id>
														</ml:apply>
													</ml:lambda>
													<ml:bounds>
														<ml:real font="0">0</ml:real>
														<ml:id xml:space="preserve">i</ml:id>
													</ml:bounds>
												</ml:apply>
												<ml:id xml:space="preserve">cna</ml:id>
											</ml:apply>
										</ml:parens>
										<ml:parens>
											<ml:apply>
												<ml:lessOrEqual/>
												<ml:id xml:space="preserve">i</ml:id>
												<ml:id xml:space="preserve" subscript="traps">n</ml:id>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:program>
										<ml:localDefine>
											<ml:id xml:space="preserve">i</ml:id>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve">i</ml:id>
												<ml:real>1</ml:real>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">thk</ml:id>
												<ml:id xml:space="preserve">i</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="trap">t</ml:id>
												<ml:id xml:space="preserve">i</ml:id>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">w</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">i</ml:id>
													<ml:real>0</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="trap">w</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">i</ml:id>
													<ml:real>0</ml:real>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">w</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">i</ml:id>
													<ml:real>1</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="trap">w</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">i</ml:id>
													<ml:real>1</ml:real>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:while>
								<ml:ifThen>
									<ml:apply>
										<ml:greaterThan/>
										<ml:id xml:space="preserve">i</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">Tlast</ml:id>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve">cna</ml:id>
											<ml:apply>
												<ml:summation/>
												<ml:lambda>
													<ml:boundVars>
														<ml:id xml:space="preserve">p</ml:id>
													</ml:boundVars>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">thk</ml:id>
														<ml:id xml:space="preserve">p</ml:id>
													</ml:apply>
												</ml:lambda>
												<ml:bounds>
													<ml:real font="0">0</ml:real>
													<ml:apply>
														<ml:minus/>
														<ml:id xml:space="preserve">i</ml:id>
														<ml:real>1</ml:real>
													</ml:apply>
												</ml:bounds>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:ifThen>
								<ml:otherwise>
									<ml:localDefine>
										<ml:id xml:space="preserve">Tlast</ml:id>
										<ml:id xml:space="preserve">cna</ml:id>
									</ml:localDefine>
								</ml:otherwise>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">w</ml:id>
										<ml:sequence>
											<ml:id xml:space="preserve">i</ml:id>
											<ml:real>1</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:mult/>
											<ml:id xml:space="preserve">Tlast</ml:id>
											<ml:apply>
												<ml:div/>
												<ml:parens>
													<ml:apply>
														<ml:minus/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">w</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">i</ml:id>
																<ml:real>1</ml:real>
															</ml:sequence>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">w</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">i</ml:id>
																<ml:real>0</ml:real>
															</ml:sequence>
														</ml:apply>
													</ml:apply>
												</ml:parens>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">thk</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">w</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">i</ml:id>
												<ml:real>0</ml:real>
											</ml:sequence>
										</ml:apply>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">thk</ml:id>
										<ml:id xml:space="preserve">i</ml:id>
									</ml:apply>
