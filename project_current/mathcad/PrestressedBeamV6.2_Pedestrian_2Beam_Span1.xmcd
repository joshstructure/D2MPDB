															<ml:sequence>
																<ml:id xml:space="preserve">i</ml:id>
																<ml:id xml:space="preserve">j</ml:id>
															</ml:sequence>
														</ml:apply>
														<ml:real>12</ml:real>
													</ml:apply>
													<ml:continue/>
												</ml:ifThen>
												<ml:ifThen>
													<ml:apply>
														<ml:or/>
														<ml:apply>
															<ml:equal/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">tendsect</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">i</ml:id>
																	<ml:id xml:space="preserve">j</ml:id>
																</ml:sequence>
															</ml:apply>
															<ml:real>10</ml:real>
														</ml:apply>
														<ml:apply>
															<ml:equal/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">tendsect</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">i</ml:id>
																	<ml:id xml:space="preserve">j</ml:id>
																</ml:sequence>
															</ml:apply>
															<ml:real>11</ml:real>
														</ml:apply>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">chk</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:real>0</ml:real>
													</ml:localDefine>
												</ml:ifThen>
												<ml:otherwise>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">chk</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:real>1</ml:real>
													</ml:localDefine>
												</ml:otherwise>
												<ml:break/>
											</ml:program>
										</ml:for>
									</ml:for>
									<ml:id xml:space="preserve">chk</ml:id>
								</ml:program>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:matrix rows="2" cols="1">
										<ml:real>0</ml:real>
										<ml:real>0</ml:real>
									</ml:matrix>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
