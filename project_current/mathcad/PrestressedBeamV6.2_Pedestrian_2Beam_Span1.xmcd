									<ml:apply>
										<ml:plus/>
										<ml:id xml:space="preserve" subscript="vf.provided">TotalA</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:real>0.001</ml:real>
											<ml:apply>
												<ml:pow/>
												<ml:id xml:space="preserve">in</ml:id>
												<ml:real>2</ml:real>
											</ml:apply>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:real>0</ml:real>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="176290" left="6" top="1893" width="366" height="12.75" align-x="95.25" align-y="1902" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define warning="WarnRedefinedUDScalar" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">CheckInterfaceReinf</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:id xml:space="preserve">substr</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:real>0</ml:real>
												<ml:real>3</ml:real>
											</ml:sequence>
										</ml:apply>
										<ml:str xml:space="preserve">FLT</ml:str>
									</ml:apply>
									<ml:str xml:space="preserve">N.A.</ml:str>
									<ml:id xml:space="preserve">CheckInterfaceReinf</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="184267" left="390" top="1893" width="125.25" height="12.75" align-x="477.75" align-y="1902" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
