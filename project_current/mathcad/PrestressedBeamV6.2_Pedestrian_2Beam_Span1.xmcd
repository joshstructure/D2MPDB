				</region>
				<region region-id="177527" left="6" top="8547" width="357.75" height="11.25" align-x="6" align-y="8556" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">distance from top of beam to center of gravity of strands at midspan and at beam end </p>
					</text>
				</region>
				<region region-id="177528" left="6" top="8574.75" width="251.25" height="63" align-x="42.75" align-y="8610" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="cgp.mid">y</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:summation/>
										<ml:lambda>
											<ml:boundVars>
												<ml:id xml:space="preserve">pi</ml:id>
											</ml:boundVars>
											<ml:parens>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">pi</ml:id>
															<ml:apply>
																<ml:div/>
																<ml:apply>
																	<ml:id xml:space="preserve">last</ml:id>
																	<ml:id xml:space="preserve">Location</ml:id>
																</ml:apply>
																<ml:real>2</ml:real>
															</ml:apply>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
														<ml:id xml:space="preserve">pi</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:lambda>
									</ml:apply>
									<ml:apply>
										<ml:vectorSum/>
										<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>-31.615383384615384</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="true" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="177529" left="6" top="8637" width="309" height="74.25" align-x="41.25" align-y="8676" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="cgp.end">y</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:summation/>
										<ml:lambda>
											<ml:boundVars>
												<ml:id xml:space="preserve">pi</ml:id>
											</ml:boundVars>
											<ml:parens>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">pi</ml:id>
															<ml:real>0</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:id xml:space="preserve">if</ml:id>
														<ml:sequence>
															<ml:apply>
																<ml:equal/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
																	<ml:id xml:space="preserve">pi</ml:id>
																</ml:apply>
																<ml:real>0</ml:real>
															</ml:apply>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
																<ml:id xml:space="preserve">pi</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:mult/>
																<ml:real>0</ml:real>
																<ml:apply>
																	<ml:pow/>
																	<ml:id xml:space="preserve">in</ml:id>
																	<ml:real>2</ml:real>
																</ml:apply>
															</ml:apply>
														</ml:sequence>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:lambda>
									</ml:apply>
									<ml:apply>
										<ml:summation/>
										<ml:lambda>
											<ml:boundVars>
												<ml:id xml:space="preserve">pi</ml:id>
											</ml:boundVars>
											<ml:apply>
												<ml:id xml:space="preserve">if</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:equal/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
															<ml:id xml:space="preserve">pi</ml:id>
														</ml:apply>
														<ml:real>0</ml:real>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
														<ml:id xml:space="preserve">pi</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:real>0</ml:real>
														<ml:apply>
															<ml:pow/>
															<ml:id xml:space="preserve">in</ml:id>
															<ml:real>2</ml:real>
														</ml:apply>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
										</ml:lambda>
									</ml:apply>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">in</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>-31.516128000000002</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="true" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="177530" left="6" top="8727" width="368.25" height="13.5" align-x="6" align-y="8736" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">determine distance from top of beam to center of gravity of Prestressing strands <inlineAttr underline="false" line-through="false">
								<c val="#00f">y</c>
							</inlineAttr>
							<inlineAttr underline="false" line-through="false">
								<c val="#00f">
									<sub>cgp</sub>
								</c>
							</inlineAttr>
						</p>
					</text>
				</region>
				<region region-id="177531" left="6" top="8756.25" width="488.25" height="287.25" align-x="28.5" align-y="8772" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="cgp">y</ml:id>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:id xml:space="preserve">last</ml:id>
												<ml:id xml:space="preserve">Location</ml:id>
											</ml:apply>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:range>
									<ml:program>
										<ml:for>
											<ml:id xml:space="preserve">i</ml:id>
											<ml:range>
												<ml:real>0</ml:real>
												<ml:apply>
													<ml:id xml:space="preserve">last</ml:id>
													<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
												</ml:apply>
											</ml:range>
											<ml:program>
												<ml:ifThen>
													<ml:apply>
														<ml:lessThan/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Location</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Aps</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:real>0</ml:real>
															<ml:apply>
																<ml:pow/>
																<ml:id xml:space="preserve">mm</ml:id>
																<ml:real>2</ml:real>
															</ml:apply>
														</ml:apply>
													</ml:localDefine>
												</ml:ifThen>
												<ml:ifThen>
													<ml:apply>
														<ml:mult/>
														<ml:parens>
															<ml:apply>
																<ml:greaterOrEqual/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">Location</ml:id>
																	<ml:id xml:space="preserve">j</ml:id>
																</ml:apply>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
																	<ml:id xml:space="preserve">i</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
														<ml:parens>
															<ml:apply>
																<ml:lessThan/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">Location</ml:id>
																	<ml:id xml:space="preserve">j</ml:id>
																</ml:apply>
																<ml:apply>
																	<ml:plus/>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
																		<ml:id xml:space="preserve">i</ml:id>
																	</ml:apply>
																	<ml:id xml:space="preserve" subscript="t">L</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Aps</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
																<ml:id xml:space="preserve">i</ml:id>
															</ml:apply>
															<ml:parens>
																<ml:apply>
																	<ml:div/>
																	<ml:apply>
																		<ml:minus/>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve">Location</ml:id>
																			<ml:id xml:space="preserve">j</ml:id>
																		</ml:apply>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
																			<ml:id xml:space="preserve">i</ml:id>
																		</ml:apply>
																	</ml:apply>
																	<ml:id xml:space="preserve" subscript="t">L</ml:id>
																</ml:apply>
															</ml:parens>
														</ml:apply>
													</ml:localDefine>
												</ml:ifThen>
												<ml:ifThen>
													<ml:apply>
														<ml:greaterOrEqual/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Location</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:plus/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
																<ml:id xml:space="preserve">i</ml:id>
															</ml:apply>
															<ml:id xml:space="preserve" subscript="t">L</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Aps</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
													</ml:localDefine>
												</ml:ifThen>
											</ml:program>
										</ml:for>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">ycgp</ml:id>
												<ml:id xml:space="preserve">j</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:summation/>
													<ml:lambda>
														<ml:boundVars>
															<ml:id xml:space="preserve">z</ml:id>
														</ml:boundVars>
														<ml:parens>
															<ml:apply>
																<ml:mult/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
																	<ml:sequence>
																		<ml:id xml:space="preserve">z</ml:id>
																		<ml:id xml:space="preserve">j</ml:id>
																	</ml:sequence>
																</ml:apply>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">Aps</ml:id>
																	<ml:id xml:space="preserve">z</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
													</ml:lambda>
													<ml:bounds>
														<ml:real>0</ml:real>
														<ml:apply>
															<ml:id xml:space="preserve">last</ml:id>
															<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
														</ml:apply>
													</ml:bounds>
												</ml:apply>
												<ml:apply>
													<ml:vectorSum/>
													<ml:id xml:space="preserve">Aps</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:for>
								<ml:for>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:range>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:id xml:space="preserve">last</ml:id>
