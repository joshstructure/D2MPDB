				<region region-id="183912" left="6" top="10983" width="183.75" height="108" align-x="60" align-y="10992" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
