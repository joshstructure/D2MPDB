				<region region-id="145988" left="6" top="2121" width="120.75" height="11.25" align-x="6" align-y="2130" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">area of fully bonded strands:</p>
					</text>
				</region>
				<region region-id="145989" left="6" top="2139" width="224.25" height="69.75" align-x="42.75" align-y="2148" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="ps.split">A</ml:id>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:id xml:space="preserve">last</ml:id>
											<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
										</ml:apply>
									</ml:range>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
												<ml:id xml:space="preserve">j</ml:id>
											</ml:apply>
											<ml:real>0</ml:real>
										</ml:apply>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="ps.split">A</ml:id>
												<ml:id xml:space="preserve">j</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
												<ml:id xml:space="preserve">j</ml:id>
											</ml:apply>
										</ml:localDefine>
									</ml:ifThen>
								</ml:for>
								<ml:apply>
									<ml:vectorSum/>
									<ml:id xml:space="preserve" subscript="ps.split">A</ml:id>
								</ml:apply>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="184674" left="288" top="2139" width="73.5" height="21" align-x="323.25" align-y="2154" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="ps.split">A</ml:id>
							<ml:unitOverride>
								<ml:apply>
									<ml:pow/>
									<ml:id xml:space="preserve">in</ml:id>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>6.727</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="inch" power-numerator="2"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="146016" left="6" top="2223" width="192" height="11.25" align-x="15" align-y="2232" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">total prestressing force on beam end at transfer</p>
					</text>
				</region>
				<region region-id="146017" left="6" top="2247" width="140.25" height="15" align-x="43.5" align-y="2256" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
