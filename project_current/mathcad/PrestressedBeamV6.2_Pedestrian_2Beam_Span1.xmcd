					</math>
				</region>
				<region region-id="144686" left="360" top="2295" width="84" height="15" align-x="419.25" align-y="2304" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
