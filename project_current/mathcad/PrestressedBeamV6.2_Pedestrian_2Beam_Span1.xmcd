				<region region-id="141618" left="6" top="531" width="234" height="11.25" align-x="15" align-y="540" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Area and spacing of Bars E per location (up to half span)</p>
					</text>
				</region>
				<region region-id="141634" left="6" top="554.25" width="113.25" height="27.75" align-x="22.5" align-y="570" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">hs</ml:id>
							<ml:range>
								<ml:real>0</ml:real>
								<ml:apply>
									<ml:minus/>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:id xml:space="preserve">last</ml:id>
											<ml:id xml:space="preserve">Location</ml:id>
										</ml:apply>
										<ml:real>2</ml:real>
									</ml:apply>
									<ml:real>1</ml:real>
								</ml:apply>
							</ml:range>
						</ml:define>
					</math>
				</region>
				<region region-id="141635" left="6" top="597" width="346.5" height="101.25" align-x="60.75" align-y="606" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="BarsE.prov">A</ml:id>
								<ml:id xml:space="preserve">hs</ml:id>
							</ml:apply>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:id xml:space="preserve">substr</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:real>0</ml:real>
												<ml:real>3</ml:real>
											</ml:sequence>
										</ml:apply>
										<ml:str xml:space="preserve">FSB</ml:str>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:lessOrEqual/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Location</ml:id>
													<ml:id xml:space="preserve">hs</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:id xml:space="preserve" subscript="BarsE.NearEnds">n</ml:id>
													<ml:id xml:space="preserve" subscript="BarsE.NearEnds">s</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve" subscript="BarsE">A</ml:id>
												<ml:id xml:space="preserve" subscript="BarsE.NearEnds">s</ml:id>
											</ml:apply>
										</ml:ifThen>
										<ml:otherwise>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve" subscript="BarsE">A</ml:id>
												<ml:id xml:space="preserve" subscript="BarsE">s</ml:id>
											</ml:apply>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:otherwise>
									<ml:real>0</ml:real>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="141755" left="6" top="717" width="340.5" height="69.75" align-x="57.75" align-y="726" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="BarsE.prov">s</ml:id>
								<ml:id xml:space="preserve">hs</ml:id>
							</ml:apply>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:id xml:space="preserve">substr</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:real>0</ml:real>
												<ml:real>3</ml:real>
											</ml:sequence>
										</ml:apply>
										<ml:str xml:space="preserve">FSB</ml:str>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:lessOrEqual/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Location</ml:id>
													<ml:id xml:space="preserve">hs</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:id xml:space="preserve" subscript="BarsE.NearEnds">n</ml:id>
													<ml:id xml:space="preserve" subscript="BarsE.NearEnds">s</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:id xml:space="preserve" subscript="BarsE.NearEnds">s</ml:id>
										</ml:ifThen>
										<ml:otherwise>
											<ml:id xml:space="preserve" subscript="BarsE">s</ml:id>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:otherwise>
									<ml:real>0</ml:real>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="177899" left="6" top="806.25" width="90.75" height="46.5" align-x="31.5" align-y="822" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">ratio</ml:id>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:div/>
									<ml:real>100</ml:real>
									<ml:apply>
										<ml:sqrt/>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve" subscript="span">L</ml:id>
											<ml:id xml:space="preserve">ft</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:div/>
									<ml:real>1</ml:real>
									<ml:real>100</ml:real>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="177900" left="264" top="831" width="54" height="11.25" align-x="275.25" align-y="840" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">LRFD 9.7.3.2</p>
					</text>
				</region>
				<region region-id="141531" left="6" top="867" width="129" height="12.75" align-x="31.5" align-y="876" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define warning="WarnRedefinedUDScalar" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">ratio</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:lessOrEqual/>
										<ml:id xml:space="preserve">ratio</ml:id>
										<ml:real>0.5</ml:real>
									</ml:apply>
									<ml:id xml:space="preserve">ratio</ml:id>
									<ml:real>0.5</ml:real>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="141751" left="264" top="867" width="48.75" height="12.75" align-x="288" align-y="876" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">ratio</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:real>0.097120951240923473</ml:real>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="141536" left="6" top="894" width="225" height="32.25" align-x="79.5" align-y="912" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="transverse.pos.Ser1">M</ml:id>
							<ml:apply>
								<ml:mult style="auto-select"/>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:mult/>
										<ml:id xml:space="preserve">ratio</ml:id>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:plus/>
												<ml:id xml:space="preserve" subscript="dist.live.pos">M</ml:id>
												<ml:id xml:space="preserve" subscript="dl.comp">M</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve" subscript="e">b</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:real>1</ml:real>
								</ml:apply>
								<ml:id xml:space="preserve">ft</ml:id>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="141693" left="258" top="903" width="147" height="15" align-x="352.5" align-y="912" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:id xml:space="preserve">max</ml:id>
								<ml:id xml:space="preserve" subscript="transverse.pos.Ser1">M</ml:id>
							</ml:apply>
							<ml:unitOverride>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve">kip</ml:id>
									<ml:id xml:space="preserve">ft</ml:id>
								</ml:apply>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>19.286201704444867</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="foot"/>
										<unitReference unit="kip"/>
									</unitMonomial>
								</unitedValue>
							</result>
