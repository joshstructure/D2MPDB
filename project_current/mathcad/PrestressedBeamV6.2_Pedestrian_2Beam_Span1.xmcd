				<region region-id="146964" left="6" top="3411" width="387.75" height="11.25" align-x="6" align-y="3420" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">estimate stress in strand after transfer (assume 5% of jacking for elastic shortening loss)</p>
					</text>
				</region>
				<region region-id="146965" left="402" top="3411" width="74.25" height="15" align-x="438.75" align-y="3420" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
