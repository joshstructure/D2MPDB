													<ml:pow/>
													<ml:parens>
														<ml:apply>
															<ml:mult/>
															<ml:real>2</ml:real>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="web.stage6">τ</ml:id>
