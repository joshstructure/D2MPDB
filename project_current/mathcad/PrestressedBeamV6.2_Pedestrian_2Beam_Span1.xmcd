				<region region-id="146454" left="6" top="2139" width="361.5" height="11.25" align-x="6" align-y="2148" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Check acceptability of AASHTO distribution factors for interior beam moments</p>
					</text>
				</region>
				<region region-id="146455" left="354" top="2139" width="105" height="11.25" align-x="354" align-y="2148" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">LRFD Table 4.6.2.2.2b-1</p>
					</text>
				</region>
				<region region-id="146456" left="474" top="2139" width="53.25" height="11.25" align-x="474" align-y="2148" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">SDG 2.9.A</p>
					</text>
				</region>
				<region region-id="150306" left="6" top="2169" width="613.5" height="273" align-x="57.75" align-y="2178" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffc6c6" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="m.int">fR</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">idx</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:mult/>
															<ml:parens>
																<ml:apply>
																	<ml:lessOrEqual/>
																	<ml:apply>
																		<ml:lessOrEqual/>
																		<ml:apply>
																			<ml:mult/>
																			<ml:real>3.5</ml:real>
																			<ml:id xml:space="preserve">ft</ml:id>
																		</ml:apply>
																		<ml:id xml:space="preserve">S</ml:id>
																	</ml:apply>
																	<ml:apply>
																		<ml:mult/>
																		<ml:real>16</ml:real>
																		<ml:id xml:space="preserve">ft</ml:id>
																	</ml:apply>
																</ml:apply>
															</ml:parens>
															<ml:parens>
																<ml:apply>
																	<ml:lessOrEqual/>
																	<ml:apply>
																		<ml:lessOrEqual/>
																		<ml:apply>
																			<ml:mult/>
																			<ml:real>4.5</ml:real>
																			<ml:id xml:space="preserve">in</ml:id>
																		</ml:apply>
																		<ml:id xml:space="preserve" subscript="s">t</ml:id>
																	</ml:apply>
																	<ml:apply>
																		<ml:mult/>
																		<ml:real>12.0</ml:real>
																		<ml:id xml:space="preserve">in</ml:id>
																	</ml:apply>
																</ml:apply>
															</ml:parens>
														</ml:apply>
														<ml:parens>
															<ml:apply>
																<ml:lessOrEqual/>
																<ml:apply>
																	<ml:lessOrEqual/>
																	<ml:apply>
																		<ml:mult/>
																		<ml:real>20</ml:real>
																		<ml:id xml:space="preserve">ft</ml:id>
																	</ml:apply>
																	<ml:id xml:space="preserve" subscript="s">L</ml:id>
																</ml:apply>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>240</ml:real>
																	<ml:id xml:space="preserve">ft</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
													</ml:apply>
													<ml:parens>
														<ml:apply>
															<ml:greaterOrEqual/>
															<ml:id xml:space="preserve">#Beams</ml:id>
															<ml:real>4</ml:real>
														</ml:apply>
													</ml:parens>
												</ml:apply>
												<ml:parens>
													<ml:apply>
														<ml:lessOrEqual/>
														<ml:apply>
															<ml:lessOrEqual/>
															<ml:apply>
																<ml:mult/>
																<ml:real>10000</ml:real>
																<ml:apply>
																	<ml:pow/>
																	<ml:id xml:space="preserve">in</ml:id>
																	<ml:real>4</ml:real>
																</ml:apply>
															</ml:apply>
															<ml:id xml:space="preserve" subscript="g">K</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:apply>
																<ml:mult/>
																<ml:real>85</ml:real>
																<ml:apply>
																	<ml:pow/>
																	<ml:real>10</ml:real>
																	<ml:real>5</ml:real>
																</ml:apply>
															</ml:apply>
															<ml:apply>
																<ml:pow/>
																<ml:id xml:space="preserve">in</ml:id>
																<ml:real>4</ml:real>
															</ml:apply>
														</ml:apply>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:program>
												<ml:localDefine>
													<ml:id xml:space="preserve">chk</ml:id>
													<ml:str xml:space="preserve">OK</ml:str>
												</ml:localDefine>
												<ml:str xml:space="preserve"/>
											</ml:program>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:id xml:space="preserve">chk</ml:id>
												<ml:str xml:space="preserve">No Good</ml:str>
											</ml:localDefine>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:parens>
														<ml:apply>
															<ml:lessOrEqual/>
															<ml:apply>
																<ml:lessOrEqual/>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>29</ml:real>
																	<ml:id xml:space="preserve">in</ml:id>
																</ml:apply>
																<ml:id xml:space="preserve" subscript="dist">b</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:mult/>
																<ml:real>60</ml:real>
																<ml:id xml:space="preserve">in</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:parens>
													<ml:parens>
														<ml:apply>
															<ml:lessOrEqual/>
															<ml:apply>
																<ml:lessOrEqual/>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>20</ml:real>
																	<ml:id xml:space="preserve">ft</ml:id>
																</ml:apply>
																<ml:id xml:space="preserve" subscript="s">L</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:mult/>
																<ml:real>120</ml:real>
																<ml:id xml:space="preserve">ft</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:parens>
												</ml:apply>
												<ml:parens>
													<ml:apply>
														<ml:lessOrEqual/>
														<ml:apply>
															<ml:lessOrEqual/>
															<ml:real>4</ml:real>
															<ml:id xml:space="preserve">#Beams</ml:id>
														</ml:apply>
														<ml:real>20</ml:real>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:program>
												<ml:localDefine>
													<ml:id xml:space="preserve">chk</ml:id>
													<ml:str xml:space="preserve">OK</ml:str>
												</ml:localDefine>
												<ml:str xml:space="preserve"/>
											</ml:program>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:id xml:space="preserve">chk</ml:id>
												<ml:str xml:space="preserve">No Good</ml:str>
											</ml:localDefine>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:parens>
															<ml:apply>
																<ml:lessOrEqual/>
																<ml:apply>
																	<ml:lessOrEqual/>
																	<ml:apply>
																		<ml:mult/>
																		<ml:real>6</ml:real>
																		<ml:id xml:space="preserve">ft</ml:id>
																	</ml:apply>
																	<ml:id xml:space="preserve">S</ml:id>
																</ml:apply>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>18</ml:real>
																	<ml:id xml:space="preserve">ft</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
														<ml:parens>
															<ml:apply>
																<ml:lessOrEqual/>
																<ml:apply>
																	<ml:lessOrEqual/>
																	<ml:apply>
																		<ml:mult/>
																		<ml:real>18</ml:real>
																		<ml:id xml:space="preserve">in</ml:id>
																	</ml:apply>
																	<ml:id xml:space="preserve" subscript="dist.ubeam">d</ml:id>
																</ml:apply>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>72</ml:real>
																	<ml:id xml:space="preserve">in</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
													</ml:apply>
													<ml:parens>
														<ml:apply>
															<ml:lessOrEqual/>
															<ml:apply>
																<ml:lessOrEqual/>
																<ml:apply>
																	<ml:mult/>
																	<ml:real>20</ml:real>
																	<ml:id xml:space="preserve">ft</ml:id>
																</ml:apply>
																<ml:id xml:space="preserve" subscript="s">L</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:mult/>
																<ml:real>170</ml:real>
																<ml:id xml:space="preserve">ft</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:parens>
												</ml:apply>
												<ml:parens>
													<ml:apply>
														<ml:greaterOrEqual/>
														<ml:id xml:space="preserve">#Beams</ml:id>
														<ml:real>3</ml:real>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:program>
												<ml:localDefine>
													<ml:id xml:space="preserve">chk</ml:id>
													<ml:str xml:space="preserve">OK</ml:str>
												</ml:localDefine>
												<ml:str xml:space="preserve"/>
											</ml:program>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:id xml:space="preserve">chk</ml:id>
												<ml:str xml:space="preserve">No Good</ml:str>
											</ml:localDefine>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:id xml:space="preserve">chk</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
