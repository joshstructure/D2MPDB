							<ml:id xml:space="preserve" subscript="conc.midspan">σ</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">n</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:id xml:space="preserve">rows</ml:id>
												<ml:id xml:space="preserve" subscript="conc">σ</ml:id>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:range>
									<ml:for>
										<ml:id xml:space="preserve">j</ml:id>
										<ml:range>
											<ml:real>0</ml:real>
											<ml:apply>
												<ml:minus/>
												<ml:apply>
													<ml:id xml:space="preserve">cols</ml:id>
													<ml:id xml:space="preserve" subscript="conc">σ</ml:id>
												</ml:apply>
												<ml:real>1</ml:real>
											</ml:apply>
										</ml:range>
