				<region region-id="201000" left="6" top="4015.5" width="176.25" height="52.5" align-x="72" align-y="4044" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="splitting.case2">D/C</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">max</ml:id>
									<ml:matrix rows="3" cols="1">
										<ml:id xml:space="preserve" subscript="zone1">DC</ml:id>
										<ml:id xml:space="preserve" subscript="zone2">DC</ml:id>
										<ml:id xml:space="preserve" subscript="zone3">DC</ml:id>
									</ml:matrix>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
