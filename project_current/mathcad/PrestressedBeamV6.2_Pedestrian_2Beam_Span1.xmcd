					</text>
				</region>
				<region region-id="30578" left="6" top="2019" width="91.5" height="18.75" align-x="38.25" align-y="2028" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
