												<ml:id xml:space="preserve" subscript="f">P</ml:id>
												<ml:id xml:space="preserve">kip</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:str xml:space="preserve"> kips</ml:str>
									<ml:str xml:space="preserve"> &gt; P Standard = </ml:str>
									<ml:apply>
										<ml:id xml:space="preserve">num2str</ml:id>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve" subscript="std">P</ml:id>
											<ml:id xml:space="preserve">kip</ml:id>
										</ml:apply>
									</ml:apply>
