				<region region-id="183318" left="6" top="5283" width="435.75" height="147.75" align-x="114.75" align-y="5292" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">fFindMinMomentRF</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">RF</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">ans</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
									<ml:real>100</ml:real>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:id xml:space="preserve">rows</ml:id>
												<ml:id xml:space="preserve">RF</ml:id>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:range>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:lessOrEqual/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">RF</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
												<ml:real>0</ml:real>
											</ml:apply>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">RF</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
												<ml:real>100</ml:real>
											</ml:localDefine>
										</ml:ifThen>
										<ml:ifThen>
											<ml:apply>
												<ml:lessThan/>
												<ml:apply>
													<ml:id xml:space="preserve">Round</ml:id>
													<ml:sequence>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">RF</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:real>0.0001</ml:real>
													</ml:sequence>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">ans</ml:id>
													<ml:real>0</ml:real>
												</ml:apply>
											</ml:apply>
											<ml:localDefine>
												<ml:id xml:space="preserve">ans</ml:id>
												<ml:matrix rows="3" cols="1">
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">RF</ml:id>
														<ml:id xml:space="preserve">i</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:div/>
														<ml:apply>
															<ml:minus/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">Location</ml:id>
																<ml:id xml:space="preserve">i</ml:id>
															</ml:apply>
															<ml:id xml:space="preserve">BearingDistance</ml:id>
														</ml:apply>
														<ml:id xml:space="preserve">ft</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:matrix>
											</ml:localDefine>
										</ml:ifThen>
									</ml:program>
								</ml:for>
								<ml:id xml:space="preserve">ans</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="183342" left="6" top="5445" width="358.5" height="120.75" align-x="103.5" align-y="5454" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
