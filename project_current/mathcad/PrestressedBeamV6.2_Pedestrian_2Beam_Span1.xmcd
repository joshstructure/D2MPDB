					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">chkBondedAtEndOfRow</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:program>
									<ml:for>
										<ml:id xml:space="preserve">i</ml:id>
										<ml:range>
											<ml:real>0</ml:real>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve">rowsFullWidthFlange</ml:id>
												<ml:real>1</ml:real>
											</ml:apply>
										</ml:range>
										<ml:for>
											<ml:id xml:space="preserve">j</ml:id>
											<ml:range>
												<ml:real>0</ml:real>
