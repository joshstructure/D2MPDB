												<ml:program>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">arr</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">count</ml:id>
																<ml:real>1</ml:real>
															</ml:sequence>
														</ml:apply>
														<ml:id xml:space="preserve">d</ml:id>
													</ml:localDefine>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">arr</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">count</ml:id>
																<ml:real>0</ml:real>
															</ml:sequence>
														</ml:apply>
														<ml:apply>
															<ml:plus/>
															<ml:apply>
																<ml:mult/>
																<ml:apply>
																	<ml:div/>
																	<ml:apply>
																		<ml:minus/>
																		<ml:id xml:space="preserve">d</ml:id>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve">q</ml:id>
																			<ml:sequence>
																				<ml:parens>
																					<ml:apply>
																						<ml:minus/>
																						<ml:id xml:space="preserve">i</ml:id>
																						<ml:real>1</ml:real>
																					</ml:apply>
																				</ml:parens>
																				<ml:real>1</ml:real>
																			</ml:sequence>
																		</ml:apply>
																	</ml:apply>
																	<ml:apply>
																		<ml:minus/>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve">q</ml:id>
																			<ml:sequence>
																				<ml:id xml:space="preserve">i</ml:id>
																				<ml:real>1</ml:real>
																			</ml:sequence>
																		</ml:apply>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve">q</ml:id>
																			<ml:sequence>
																				<ml:parens>
																					<ml:apply>
																						<ml:minus/>
																						<ml:id xml:space="preserve">i</ml:id>
																						<ml:real>1</ml:real>
																					</ml:apply>
																				</ml:parens>
																				<ml:real>1</ml:real>
																			</ml:sequence>
																		</ml:apply>
																	</ml:apply>
																</ml:apply>
																<ml:parens>
																	<ml:apply>
																		<ml:minus/>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve">q</ml:id>
																			<ml:sequence>
																				<ml:id xml:space="preserve">i</ml:id>
