					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Stress equations use the top of the beam as the origin, not the centroid and so the equations must utilize the first moment area.<sp count="2"/>For a reference to this equation see "Time Effects in Concrete Structures" by R. I. Gilbert pages 113-114</p>
					</text>
				</region>
				<region region-id="132874" left="6" top="6693" width="259.5" height="11.25" align-x="6" align-y="6702" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
