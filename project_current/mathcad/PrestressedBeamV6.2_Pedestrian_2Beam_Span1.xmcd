				<region region-id="150295" left="6" top="1035" width="349.5" height="12" align-x="14.25" align-y="1044" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<b>LRFD Cro</b>
							<b>ss Section K</b> :I-Beams, Inverted Tee Beams, Double Tee Beams</p>
