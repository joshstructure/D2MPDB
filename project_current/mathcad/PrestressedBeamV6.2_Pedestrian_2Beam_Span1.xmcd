		</region>
		<region region-id="203058" left="0" top="4233" width="6008.25" align-x="0" align-y="4233" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#c0c0c0" tag="" height="10994.25">
			<area is-collapsed="true" name="   Live Load Moments and Shears" show-name="true" show-border="true" show-icon="true" show-timestamp="true" allow-expand="true" is-locked="false" timestamp="" top-lock-id="29028" bottom-lock-id="29041">
				<region region-id="146838" left="6" top="20.25" width="162.75" height="30" align-x="117" align-y="38.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">WRITEPRN</ml:id>
								<ml:boundVars>
									<ml:str xml:space="preserve">coord.dat</ml:str>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:div/>
								<ml:id xml:space="preserve" subscript="beam">Coord</ml:id>
								<ml:id xml:space="preserve">ft</ml:id>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="14372" left="6" top="69" width="180" height="14.25" align-x="6" align-y="80.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="heading" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Live Load Moments and Shears</p>
					</text>
				</region>
				<region region-id="12287" left="78" top="104.25" width="429" height="104.25" align-x="78" align-y="104.25" show-border="true" show-highlight="true" is-protected="true" z-order="0" background-color="#f1f1f1" tag="">
					<picture>
						<png item-idref="329" display-width="417" display-height="92.25"/>
					</picture>
				</region>
				<region region-id="23173" left="186" top="209.25" width="72" height="33.75" align-x="186" align-y="218.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Distance between</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">the center line of </p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">bearings</p>
					</text>
				</region>
				<region region-id="11707" left="6" top="215.25" width="162" height="15" align-x="53.25" align-y="224.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="c.c.bearings">L</ml:id>
							<ml:apply>
								<ml:minus/>
								<ml:id xml:space="preserve" subscript="beam">L</ml:id>
								<ml:apply>
									<ml:mult/>
									<ml:real>2</ml:real>
									<ml:id xml:space="preserve">BearingDistance</ml:id>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="11711" left="6" top="269.25" width="120.75" height="18" align-x="52.5" align-y="278.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">Location</ml:id>
								<ml:real>1</ml:real>
							</ml:apply>
							<ml:id xml:space="preserve">BearingDistance</ml:id>
						</ml:define>
					</math>
				</region>
				<region region-id="132426" left="282" top="269.25" width="69" height="18" align-x="328.5" align-y="278.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">Location</ml:id>
								<ml:real>0</ml:real>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:real>0</ml:real>
								<ml:id xml:space="preserve">ft</ml:id>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="132427" left="378" top="269.25" width="147" height="33.75" align-x="378" align-y="278.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Location vector defines the x location of the sections investigated relative to the start of the beam</p>
					</text>
				</region>
				<region region-id="11714" left="6" top="302.25" width="190.5" height="30" align-x="56.25" align-y="320.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">Location</ml:id>
								<ml:id xml:space="preserve">ns</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="c.c.bearings">L</ml:id>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve">nmax</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:parens>
										<ml:apply>
											<ml:minus/>
											<ml:id xml:space="preserve">ns</ml:id>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:parens>
								</ml:apply>
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve">Location</ml:id>
									<ml:real>1</ml:real>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="132428" left="282" top="311.25" width="90" height="18" align-x="342.75" align-y="320.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">Location</ml:id>
								<ml:id xml:space="preserve">nmax</ml:id>
							</ml:apply>
							<ml:id xml:space="preserve" subscript="beam">L</ml:id>
						</ml:define>
					</math>
				</region>
				<region region-id="132429" left="396" top="311.25" width="112.5" height="22.5" align-x="396" align-y="320.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">The Location vector need not be in even increments</p>
					</text>
				</region>
				<region region-id="11721" left="6" top="359.25" width="141.75" height="18" align-x="21.75" align-y="368.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">a</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:minus/>
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve">Location</ml:id>
									<ml:id xml:space="preserve">n</ml:id>
								</ml:apply>
								<ml:id xml:space="preserve">BearingDistance</ml:id>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="134693" left="162" top="359.25" width="136.5" height="33.75" align-x="162" align-y="368.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">a vector gives the section x coordinate relative to the center line of the first bearing</p>
					</text>
				</region>
				<region region-id="134697" left="300" top="365.25" width="87" height="18" align-x="317.25" align-y="374.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">b</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:minus/>
								<ml:id xml:space="preserve" subscript="c.c.bearings">L</ml:id>
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve">a</ml:id>
									<ml:id xml:space="preserve">n</ml:id>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="134698" left="396" top="365.25" width="128.25" height="33.75" align-x="396" align-y="374.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">b vector gives the distance from the section to the center line of the last bearing</p>
					</text>
				</region>
				<region region-id="203016" left="6" top="417" width="534" height="14.25" align-x="6" align-y="428.25" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="heading" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Pedestrian load per beam - simple span and longitudinal envelopes</p>
					</text>
				</region>
				<region region-id="203017" left="6" top="449.25" width="534" height="33.75" align-x="6" align-y="458.25" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">PL is applied only between bearing centers. Positive/negative shear envelopes load the corresponding adverse influence-line portion. Mshr.PL is the moment from that same load pattern. The original vehicle generator below remains available in Vehicle mode.</p>
					</text>
				</region>
				<region region-id="203050" left="6" top="530.25" width="445.5" height="30" align-x="28.5" align-y="548.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="PL">w</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:id xml:space="preserve">PedMode</ml:id>
										<ml:apply>
											<ml:id xml:space="preserve">if</ml:id>
											<ml:sequence>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">#Beams</ml:id>
													<ml:real>2</ml:real>
												</ml:apply>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve" subscript="PL">q</ml:id>
														<ml:id xml:space="preserve" subscript="PL">W</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve">#Beams</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:id xml:space="preserve">error</ml:id>
													<ml:str xml:space="preserve">Pedestrian mode requires 2 beams</ml:str>
												</ml:apply>
											</ml:sequence>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:real>0</ml:real>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve">kip</ml:id>
												<ml:id xml:space="preserve">ft</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:sequence>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">plf</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>540</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="pounds_force_per_linear_foot"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="203019" left="6" top="569.25" width="282" height="18.75" align-x="29.25" align-y="578.25" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="PL">x</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">min</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:id xml:space="preserve">max</ml:id>
											<ml:sequence>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">Location</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve">BearingDistance</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:real>0</ml:real>
													<ml:id xml:space="preserve">ft</ml:id>
												</ml:apply>
											</ml:sequence>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="c.c.bearings">L</ml:id>
									</ml:sequence>
								</ml:apply>
							</ml:eval>
						</ml:define>
						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="true"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="203020" left="6" top="598.5" width="192" height="33.75" align-x="47.25" align-y="620.25" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="#ffc0cb" tag="Pedestrian modification">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="PL.pos">M</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
