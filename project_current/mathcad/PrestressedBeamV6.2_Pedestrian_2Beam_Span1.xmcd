				<region region-id="176121" left="6" top="10653" width="433.5" height="185.25" align-x="120" align-y="10662" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffd5d5" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">fCheckStress</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">Title</ml:id>
									<ml:id xml:space="preserve">σ</ml:id>
									<ml:id xml:space="preserve" subscript="all">σ</ml:id>
