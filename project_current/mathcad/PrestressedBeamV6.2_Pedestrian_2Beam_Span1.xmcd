				<region region-id="179732" left="6" top="489" width="332.25" height="146.25" align-x="30.75" align-y="498" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="prov">s</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">y</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:range>
										<ml:real>1</ml:real>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:id xml:space="preserve">last</ml:id>
													<ml:id xml:space="preserve">Location</ml:id>
												</ml:apply>
												<ml:real>2</ml:real>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:range>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:greaterThan/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Location</ml:id>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:summation/>
														<ml:lambda>
															<ml:boundVars>
																<ml:id xml:space="preserve">x</ml:id>
															</ml:boundVars>
															<ml:parens>
																<ml:apply>
																	<ml:mult/>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve">s</ml:id>
																		<ml:id xml:space="preserve">x</ml:id>
																	</ml:apply>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve">NumberSpaces</ml:id>
																		<ml:id xml:space="preserve">x</ml:id>
																	</ml:apply>
																</ml:apply>
															</ml:parens>
														</ml:lambda>
														<ml:bounds>
															<ml:real>0</ml:real>
															<ml:id xml:space="preserve">y</ml:id>
														</ml:bounds>
													</ml:apply>
													<ml:id xml:space="preserve">EndSpace</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:localDefine>
												<ml:id xml:space="preserve">y</ml:id>
												<ml:apply>
													<ml:plus/>
													<ml:id xml:space="preserve">y</ml:id>
													<ml:real>1</ml:real>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
										<ml:localDefine>
											<ml:id xml:space="preserve">y</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">min</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">y</ml:id>
													<ml:apply>
														<ml:id xml:space="preserve">last</ml:id>
														<ml:id xml:space="preserve">s</ml:id>
													</ml:apply>
												</ml:sequence>
											</ml:apply>
										</ml:localDefine>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">spac</ml:id>
												<ml:id xml:space="preserve">j</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">s</ml:id>
												<ml:id xml:space="preserve">y</ml:id>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:for>
								<ml:id xml:space="preserve">spac</ml:id>
							</ml:program>
						</ml:define>
					</math>
