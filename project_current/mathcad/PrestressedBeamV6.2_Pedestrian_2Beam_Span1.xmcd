										</ml:apply>
									</ml:parens>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="146938" left="6" top="3147" width="296.25" height="18.75" align-x="35.25" align-y="3156" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
