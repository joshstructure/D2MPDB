				<region region-id="146968" left="6" top="3471" width="395.25" height="189.75" align-x="106.5" align-y="3480" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">StrandTrans</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">trans</ml:id>
									<ml:id xml:space="preserve">loc</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:lessOrEqual/>
										<ml:id xml:space="preserve">loc</ml:id>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">trans</ml:id>
											<ml:real>0</ml:real>
										</ml:apply>
									</ml:apply>
