		<region region-id="202304" left="0" top="16640.25" width="6008.25" align-x="0" align-y="16640.25" show-border="true" show-highlight="true" is-protected="true" z-order="0" background-color="#c0c0c0" tag="" height="2552.25">
			<area is-collapsed="true" name="Botom Longitudinal Reinf. (LRFD 5.7.3.5)" show-name="true" show-border="false" show-icon="true" show-timestamp="true" allow-expand="false" is-locked="false" timestamp="" top-lock-id="30776" bottom-lock-id="30778">
				<region region-id="145539" left="6" top="30.75" width="162" height="14.25" align-x="6" align-y="42" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="heading" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Longitudinal Reinforcement </p>
					</text>
				</region>
				<region region-id="186172" left="180" top="33" width="63.75" height="11.25" align-x="180" align-y="42" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(LRFD 5.7.3.5)</p>
					</text>
				</region>
				<region region-id="186614" left="120" top="57" width="303.75" height="22.5" align-x="128.25" align-y="66" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Longitudinal mild reinforcing area at the end of the beam in the bottom flange or bottom half for a flat slab</p>
					</text>
				</region>
				<region region-id="186160" left="6" top="57" width="83.25" height="21" align-x="62.25" align-y="72" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ececec" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="s.long.end.bot">A</ml:id>
							<ml:unitOverride>
								<ml:apply>
									<ml:pow/>
									<ml:id xml:space="preserve">in</ml:id>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>0</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="inch" power-numerator="2"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="186162" left="6" top="93" width="75" height="15" align-x="54.75" align-y="102" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ececec" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="long.end.bot">L</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>0</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="foot"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="186616" left="114" top="93" width="327.75" height="11.25" align-x="135" align-y="102" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Length of longitudinal mild reinforcing bars from the End of Beam</p>
					</text>
				</region>
				<region region-id="186163" left="6" top="117" width="103.5" height="12.75" align-x="91.5" align-y="126" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ececec" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">BarSizeLongEndBot</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:real>0</ml:real>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="188130" left="6" top="153" width="438.75" height="11.25" align-x="6" align-y="162" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">This adjustment accounts for the development length of the mild reinforcing</p>
					</text>
				</region>
				<region region-id="188131" left="6" top="176.25" width="594" height="171.75" align-x="63.75" align-y="192" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define warning="WarnRedefinedUDScalar" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="s.long.end.bot">A</ml:id>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">n</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:id xml:space="preserve">last</ml:id>
												<ml:id xml:space="preserve">Location</ml:id>
											</ml:apply>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:range>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:lessThan/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Location</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve" subscript="d.long.end.bot">L</ml:id>
											</ml:apply>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Aslong</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:mult/>
														<ml:parens>
															<ml:apply>
																<ml:minus/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">Location</ml:id>
																	<ml:id xml:space="preserve">n</ml:id>
																</ml:apply>
																<ml:id xml:space="preserve">EndCover</ml:id>
															</ml:apply>
														</ml:parens>
														<ml:id xml:space="preserve" subscript="s.long.end.bot">A</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="d.long.end.bot">L</ml:id>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
										<ml:ifThen>
											<ml:apply>
												<ml:greaterThan/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Location</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve" subscript="long.end.bot">L</ml:id>
														<ml:id xml:space="preserve">EndCover</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="d.long.end.bot">L</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Aslong</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:mult/>
														<ml:parens>
															<ml:apply>
																<ml:minus/>
																<ml:apply>
																	<ml:plus/>
																	<ml:id xml:space="preserve" subscript="long.end.bot">L</ml:id>
																	<ml:id xml:space="preserve">EndCover</ml:id>
																</ml:apply>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">Location</ml:id>
																	<ml:id xml:space="preserve">n</ml:id>
																</ml:apply>
															</ml:apply>
														</ml:parens>
														<ml:id xml:space="preserve" subscript="s.long.end.bot">A</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="d.long.end.bot">L</ml:id>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Aslong</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve" subscript="s.long.end.bot">A</ml:id>
											</ml:localDefine>
										</ml:otherwise>
										<ml:ifThen>
											<ml:apply>
												<ml:lessThan/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Aslong</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:real>0</ml:real>
													<ml:apply>
														<ml:pow/>
														<ml:id xml:space="preserve">in</ml:id>
														<ml:real>2</ml:real>
													</ml:apply>
												</ml:apply>
											</ml:apply>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Aslong</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:real>0</ml:real>
													<ml:apply>
														<ml:pow/>
														<ml:id xml:space="preserve">in</ml:id>
														<ml:real>2</ml:real>
													</ml:apply>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
									</ml:program>
								</ml:for>
								<ml:id xml:space="preserve">Aslong</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="188134" left="6" top="366" width="528" height="200.25" align-x="6" align-y="366" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#f1f1f1" tag="">
					<plot disable-calc="false" item-idref="767"/>
				</region>
				<region region-id="184426" left="6" top="600" width="319.5" height="32.25" align-x="99.75" align-y="618" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:greaterOrEqual/>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve" subscript="s.long">A</ml:id>
									<ml:id xml:space="preserve" subscript="y">f</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve" subscript="ps">A</ml:id>
									<ml:id xml:space="preserve" subscript="ps">f</ml:id>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:plus/>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="u">M</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:id xml:space="preserve" subscript="v">d</ml:id>
											<ml:id xml:space="preserve">ϕ</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>0.5</ml:real>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve" subscript="u">N</ml:id>
											<ml:id xml:space="preserve">ϕ</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:mult/>
									<ml:parens>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve" subscript="u">V</ml:id>
												<ml:id xml:space="preserve" subscript="shr">ϕ</ml:id>
											</ml:apply>
											<ml:parens>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:mult/>
														<ml:real>0.5</ml:real>
														<ml:id xml:space="preserve" subscript="s">V</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="p">V</ml:id>
												</ml:apply>
											</ml:parens>
										</ml:apply>
									</ml:parens>
									<ml:apply>
										<ml:id xml:space="preserve">cot</ml:id>
										<ml:id xml:space="preserve">θ</ml:id>
									</ml:apply>
								</ml:apply>
							</ml:apply>
						</ml:apply>
					</math>
				</region>
				<region region-id="184427" left="324" top="609" width="81" height="11.25" align-x="324" align-y="618" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">governing equation</p>
					</text>
				</region>
				<region region-id="184429" left="420" top="609" width="76.5" height="11.25" align-x="420" align-y="618" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(LRFD 5.7.3.5-1)</p>
					</text>
				</region>
				<region region-id="19077" left="6" top="651" width="499.5" height="11.25" align-x="6" align-y="660" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">use the actual reinforcement provided (bursting and shear) to calculate the resistance for longitudinal reinforcement</p>
					</text>
				</region>
				<region region-id="188160" left="6" top="687" width="48" height="12.75" align-x="36" align-y="696" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">ishear</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:real>4</ml:real>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="188157" left="90" top="687" width="58.5" height="12.75" align-x="103.5" align-y="696" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">i2</ml:id>
							<ml:range>
								<ml:real>0</ml:real>
								<ml:id xml:space="preserve">ishear</ml:id>
							</ml:range>
						</ml:define>
					</math>
				</region>
				<region region-id="188158" left="174" top="687" width="54" height="18" align-x="192.75" align-y="696" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">θ</ml:id>
								<ml:id xml:space="preserve">i2</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">θ</ml:id>
								<ml:id xml:space="preserve">ishear</ml:id>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="188265" left="6" top="729" width="78.75" height="11.25" align-x="6" align-y="738" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(LRFD 5.7.3.3)</p>
					</text>
				</region>
				<region region-id="188266" left="84" top="729" width="150" height="11.25" align-x="84" align-y="738" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(AASHTO GFRP 2.7.3.5 &amp; 2.7.2.5)</p>
					</text>
				</region>
				<region region-id="178312" left="6" top="753" width="514.5" height="42.75" align-x="44.25" align-y="762" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="s.prov">V</ml:id>
								<ml:id xml:space="preserve">hs</ml:id>
							</ml:apply>
							<ml:program>
								<ml:ifThen>
									<ml:parens>
										<ml:apply>
											<ml:plus/>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">MildReinfType</ml:id>
													<ml:str xml:space="preserve">Carbon Steel</ml:str>
												</ml:apply>
											</ml:parens>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">MildReinfType</ml:id>
													<ml:str xml:space="preserve">Stainless Steel</ml:str>
												</ml:apply>
											</ml:parens>
										</ml:apply>
									</ml:parens>
									<ml:parens>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="v.prov">A</ml:id>
														<ml:id xml:space="preserve">hs</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="y">f</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="v">d</ml:id>
													<ml:id xml:space="preserve">hs</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:id xml:space="preserve">cot</ml:id>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">θ</ml:id>
													<ml:id xml:space="preserve">hs</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:apply>
									</ml:parens>
								</ml:ifThen>
								<ml:otherwise>
									<ml:apply>
										<ml:id xml:space="preserve">min</ml:id>
										<ml:sequence>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="v.prov">A</ml:id>
															<ml:id xml:space="preserve">hs</ml:id>
														</ml:apply>
														<ml:id xml:space="preserve" subscript="fv">f</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="v">d</ml:id>
														<ml:id xml:space="preserve">hs</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:id xml:space="preserve">cot</ml:id>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">θ</ml:id>
														<ml:id xml:space="preserve">hs</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:real>0.25</ml:real>
														<ml:apply>
															<ml:sqrt/>
															<ml:apply>
																<ml:mult/>
																<ml:id xml:space="preserve" subscript="c.beam">f</ml:id>
																<ml:id xml:space="preserve">ksi</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="v">b</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="v">d</ml:id>
													<ml:id xml:space="preserve">hs</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:sequence>
									</ml:apply>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="178333" left="6" top="813" width="99.75" height="15" align-x="58.5" align-y="822" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
