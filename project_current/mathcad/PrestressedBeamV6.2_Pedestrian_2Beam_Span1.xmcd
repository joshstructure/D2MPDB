				<region region-id="147652" left="6" top="3279" width="211.5" height="57" align-x="39.75" align-y="3288" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="stirrup">A</ml:id>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:real>6</ml:real>
									</ml:range>
									<ml:localDefine>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">area</ml:id>
											<ml:id xml:space="preserve">j</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve">str2num</ml:id>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">outStirrupData</ml:id>
												<ml:sequence>
													<ml:real font="0">2</ml:real>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:sequence>
											</ml:apply>
										</ml:apply>
									</ml:localDefine>
								</ml:for>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve">area</ml:id>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve">in</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:apply>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="147655" left="312" top="3291" width="220.5" height="21" align-x="349.5" align-y="3306" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:transpose/>
								<ml:id xml:space="preserve" subscript="stirrup">A</ml:id>
							</ml:apply>
							<ml:unitOverride>
								<ml:apply>
									<ml:pow/>
									<ml:id xml:space="preserve">in</ml:id>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:matrix rows="1" cols="7">
										<ml:real>1.24</ml:real>
										<ml:real>0.62</ml:real>
										<ml:real>0.31</ml:real>
