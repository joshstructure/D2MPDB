										<ml:id xml:space="preserve">R1</ml:id>
										<ml:apply>
											<ml:id xml:space="preserve">if</ml:id>
											<ml:sequence>
												<ml:apply>
													<ml:greaterOrEqual/>
													<ml:apply>
														<ml:mult style="auto-select"/>
														<ml:real>0.03</ml:real>
														<ml:apply>
															<ml:div/>
															<ml:id xml:space="preserve" subscript="span">L</ml:id>
															<ml:id xml:space="preserve">ft</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:apply>
														<ml:div/>
														<ml:real>6.5</ml:real>
														<ml:real>12</ml:real>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:mult style="auto-select"/>
													<ml:real>0.03</ml:real>
													<ml:apply>
														<ml:div/>
														<ml:id xml:space="preserve" subscript="span">L</ml:id>
														<ml:id xml:space="preserve">ft</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:div/>
													<ml:real>6.5</ml:real>
													<ml:real>12</ml:real>
