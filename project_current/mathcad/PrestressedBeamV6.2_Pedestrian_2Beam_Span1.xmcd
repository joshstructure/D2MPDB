									<hash/>
								</parentRef>
								<comment xmlns="http://schemas.mathsoft.com/provenance10"/>
								<originComment xmlns="http://schemas.mathsoft.com/provenance10"/>
								<contentHash xmlns="http://schemas.mathsoft.com/provenance10">4f0ec3c746f45fd5dacc13321de32018</contentHash>
								<ml:apply>
									<ml:id xml:space="preserve">reverse</ml:id>
									<ml:id xml:space="preserve">Strands/Group/Row</ml:id>
								</ml:apply>
							</ml:provenance>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="5" cols="1">
									<ml:real>5</ml:real>
									<ml:real>13</ml:real>
									<ml:real>4</ml:real>
									<ml:real>13</ml:real>
									<ml:real>4</ml:real>
								</ml:matrix>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="matrix" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="177331" left="6" top="2751" width="367.5" height="11.25" align-x="17.25" align-y="2760" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<inlineAttr underline="false">Verify changes under 'Section and Strand Properties Summary'<sp count="2"/>below...</inlineAttr>
						</p>
					</text>
				</region>
				<region region-id="143031" left="6" top="2799" width="511.5" height="67.5" align-x="6" align-y="2808" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">A suggested method of iteration is to fill single web beams with tendons beginning in the middle of the bottom row, filling the row outward, then continuing on to the middle of the next lowest row (Note: for U-beams, strands should be more concentrated under the exterior web; and for slab units evenly distributed). Typically ,the minimum number of tendons is reached when midspan tensile stress is below the LRFD Service III Limit stress.<sp count="2"/>Next, tendons should be debonded in pairs according to the Structures Design Guidelines until the end compression stresses are below the LRFD Service I Limit stress.<sp count="2"/>These two limits typically control the design (see graph below). </p>
					</text>
				</region>
				<region region-id="143844" left="6" top="2882.25" width="534" height="27.75" align-x="13.5" align-y="2892" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">When there are only one row of strands without any debonding, <region region-id="143845" left="282" top="2883" width="34.5" height="15" align-x="298.5" align-y="2892" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" subscript="ps.group" xmlns:ml="http://schemas.mathsoft.com/math30">A</ml:id>
								</math>
							</region> and <region region-id="143846" left="336" top="2883" width="33.75" height="15" align-x="351.75" align-y="2892" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" subscript="shielding" xmlns:ml="http://schemas.mathsoft.com/math30">L</ml:id>
								</math>
							</region> are read in as scalars. The following functions convert them to vectors.<sp count="2"/>
						</p>
					</text>
				</region>
				<region region-id="143840" left="6" top="2925" width="214.5" height="53.25" align-x="46.5" align-y="2934" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define warning="WarnRedefinedUDScalar" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">A</ml:id>
									<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
								</ml:localDefine>
								<ml:tryCatch>
									<ml:apply>
										<ml:id xml:space="preserve">last</ml:id>
										<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
									</ml:apply>
									<ml:localDefine>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">A</ml:id>
											<ml:real>0</ml:real>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
									</ml:localDefine>
								</ml:tryCatch>
								<ml:id xml:space="preserve">A</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="173742" left="312" top="2925" width="225.75" height="53.25" align-x="351.75" align-y="2934" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define warning="WarnRedefinedUDScalar" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">L</ml:id>
									<ml:apply>
										<ml:mult/>
										<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
										<ml:id xml:space="preserve">ft</ml:id>
									</ml:apply>
								</ml:localDefine>
								<ml:tryCatch>
									<ml:apply>
										<ml:id xml:space="preserve">last</ml:id>
										<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
									</ml:apply>
									<ml:localDefine>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">L</ml:id>
											<ml:real>0</ml:real>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
											<ml:id xml:space="preserve">ft</ml:id>
										</ml:apply>
									</ml:localDefine>
								</ml:tryCatch>
								<ml:id xml:space="preserve">L</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="143842" left="6" top="3009" width="139.5" height="15" align-x="66" align-y="3018" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="prestress.groups">n</ml:id>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:id xml:space="preserve">last</ml:id>
									<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
								</ml:apply>
								<ml:real>1</ml:real>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="173595" left="6" top="3033" width="52.5" height="15" align-x="29.25" align-y="3042" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffd2d2" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="b.ps">d</ml:id>
							<ml:unitOverride>
								<ml:id xml:space="preserve">in</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>0.6</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="inch"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="174521" left="6" top="3057" width="174" height="11.25" align-x="6" align-y="3066" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">total area of Prestressing Reinforcement</p>
					</text>
				</region>
				<region region-id="174522" left="6" top="3081" width="91.5" height="30" align-x="59.25" align-y="3096" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:vectorSum/>
								<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
							</ml:apply>
							<ml:unitOverride>
								<ml:apply>
									<ml:pow/>
									<ml:id xml:space="preserve">in</ml:id>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>8.463</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="inch" power-numerator="2"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="173596" left="6" top="3135" width="90" height="15" align-x="21" align-y="3144" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">pi</ml:id>
							<ml:range>
								<ml:real>0</ml:real>
								<ml:apply>
									<ml:id xml:space="preserve">last</ml:id>
									<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
								</ml:apply>
							</ml:range>
						</ml:define>
					</math>
				</region>
				<region region-id="177469" left="336" top="3183" width="99.75" height="45" align-x="336" align-y="3192" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">0 - low relaxation steel</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">1 - stress relieved steel</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">2 - stainless steel</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">3 - CFRP</p>
					</text>
				</region>
				<region region-id="173606" left="6" top="3207" width="139.5" height="18" align-x="77.25" align-y="3216" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffd2d2" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">PSGroupIndex</ml:id>
								<ml:id xml:space="preserve">pi</ml:id>
							</ml:apply>
							<ml:id xml:space="preserve">inpStrandType</ml:id>
						</ml:define>
					</math>
				</region>
				<region region-id="173609" left="216" top="3174" width="93" height="78.75" align-x="278.25" align-y="3216" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">PSGroupIndex</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="5" cols="1">
									<ml:real>0</ml:real>
									<ml:real>0</ml:real>
									<ml:real>0</ml:real>
									<ml:real>0</ml:real>
									<ml:real>0</ml:real>
								</ml:matrix>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="31222" left="6" top="3297" width="243" height="78.75" align-x="41.25" align-y="3306" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="L">shield</ml:id>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:id xml:space="preserve">rows</ml:id>
												<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:range>
									<ml:program>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="L">shield</ml:id>
												<ml:id xml:space="preserve">i</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
												<ml:id xml:space="preserve">i</ml:id>
											</ml:apply>
										</ml:localDefine>
										<ml:ifThen>
											<ml:apply>
												<ml:lessOrEqual/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:real>0</ml:real>
													<ml:id xml:space="preserve">ft</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="L">shield</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:real>100</ml:real>
													<ml:id xml:space="preserve">ft</ml:id>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
									</ml:program>
								</ml:for>
								<ml:id xml:space="preserve" subscript="L">shield</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="32181" left="6" top="3405" width="410.25" height="174.75" align-x="50.25" align-y="3414" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="term">shield</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve" subscript="group">A</ml:id>
									<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve" subscript="total">A</ml:id>
									<ml:apply>
										<ml:mult/>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">in</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:id xml:space="preserve">last</ml:id>
											<ml:id xml:space="preserve" subscript="group">A</ml:id>
										</ml:apply>
									</ml:range>
									<ml:program>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="group">A</ml:id>
												<ml:id xml:space="preserve">i</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:real>0</ml:real>
												<ml:apply>
													<ml:pow/>
													<ml:id xml:space="preserve">in</ml:id>
													<ml:real>2</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
										<ml:ifThen>
											<ml:apply>
												<ml:notEqual/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:real font="0">0</ml:real>
													<ml:id xml:space="preserve">ft</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:localDefine>
												<ml:id xml:space="preserve" subscript="total">A</ml:id>
												<ml:apply>
													<ml:plus/>
													<ml:id xml:space="preserve" subscript="total">A</ml:id>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
														<ml:id xml:space="preserve">i</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
										<ml:for>
											<ml:id xml:space="preserve">j</ml:id>
											<ml:range>
												<ml:real>0</ml:real>
												<ml:apply>
													<ml:id xml:space="preserve">last</ml:id>
													<ml:id xml:space="preserve" subscript="group">A</ml:id>
												</ml:apply>
											</ml:range>
											<ml:ifThen>
												<ml:apply>
													<ml:mult/>
													<ml:parens>
														<ml:apply>
															<ml:equal/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
																<ml:id xml:space="preserve">j</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
																<ml:id xml:space="preserve">i</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:parens>
													<ml:parens>
														<ml:apply>
															<ml:notEqual/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
																<ml:id xml:space="preserve">i</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:mult/>
																<ml:real font="0">0</ml:real>
																<ml:id xml:space="preserve">ft</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:parens>
												</ml:apply>
												<ml:localDefine>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="group">A</ml:id>
														<ml:id xml:space="preserve">i</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:plus/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="group">A</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:localDefine>
											</ml:ifThen>
										</ml:for>
									</ml:program>
								</ml:for>
								<ml:apply>
									<ml:transpose/>
									<ml:matrix rows="1" cols="2">
										<ml:id xml:space="preserve" subscript="group">A</ml:id>
										<ml:id xml:space="preserve" subscript="total">A</ml:id>
									</ml:matrix>
								</ml:apply>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="173674" left="414" top="3399.75" width="103.5" height="95.25" align-x="456.75" align-y="3450" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
