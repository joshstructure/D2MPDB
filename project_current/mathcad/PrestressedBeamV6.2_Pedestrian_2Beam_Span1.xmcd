				<region region-id="201357" left="360" top="4464" width="140.25" height="32.25" align-x="426" align-y="4482" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="splitting.case3">D/C</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:div/>
									<ml:id xml:space="preserve" subscript="f.LRFD">P</ml:id>
									<ml:id xml:space="preserve" subscript="r.LRFD">P</ml:id>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
