				</region>
				<region region-id="201307" left="6" top="4509" width="331.5" height="97.5" align-x="96.75" align-y="4518" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="splitting.case3">CheckD/C</ml:id>
							<ml:program>
								<ml:ifThen>
									<ml:parens>
										<ml:apply>
											<ml:equal/>
											<ml:apply>
												<ml:id xml:space="preserve">substr</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">BeamType</ml:id>
													<ml:real>0</ml:real>
													<ml:real>3</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:str xml:space="preserve">FSB</ml:str>
										</ml:apply>
									</ml:parens>
									<ml:localDefine>
										<ml:id xml:space="preserve">DC</ml:id>
										<ml:str xml:space="preserve">N/A</ml:str>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:parens>
										<ml:apply>
											<ml:equal/>
											<ml:apply>
												<ml:id xml:space="preserve">substr</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">BeamType</ml:id>
													<ml:real>0</ml:real>
													<ml:real>3</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:str xml:space="preserve">FLT</ml:str>
										</ml:apply>
									</ml:parens>
									<ml:localDefine>
										<ml:id xml:space="preserve">DC</ml:id>
										<ml:str xml:space="preserve">N/A</ml:str>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:parens>
										<ml:apply>
											<ml:equal/>
											<ml:apply>
												<ml:id xml:space="preserve">substr</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">BeamType</ml:id>
													<ml:real>0</ml:real>
													<ml:real>3</ml:real>
												</ml:sequence>
											</ml:apply>
											<ml:str xml:space="preserve">FUB</ml:str>
										</ml:apply>
									</ml:parens>
									<ml:localDefine>
