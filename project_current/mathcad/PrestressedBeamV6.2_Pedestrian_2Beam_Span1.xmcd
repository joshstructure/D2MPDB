					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Area of Concrete Beam in Tension (used in shear calculations)</p>
					</text>
				</region>
				<region region-id="32048" left="6" top="9093" width="423.75" height="435.75" align-x="74.25" align-y="9102" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">HalfBeam</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">d</ml:id>
									<ml:id xml:space="preserve">q</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">nr</ml:id>
									<ml:apply>
										<ml:id xml:space="preserve">rows</ml:id>
										<ml:id xml:space="preserve">q</ml:id>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">count</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">pr</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:parens>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve">nr</ml:id>
												<ml:real>1</ml:real>
											</ml:apply>
										</ml:parens>
									</ml:range>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:lessThan/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">q</ml:id>
													<ml:sequence>
														<ml:id xml:space="preserve">i</ml:id>
														<ml:real>1</ml:real>
													</ml:sequence>
												</ml:apply>
												<ml:id xml:space="preserve">d</ml:id>
											</ml:apply>
											<ml:program>
												<ml:ifThen>
													<ml:apply>
														<ml:greaterThan/>
														<ml:id xml:space="preserve">i</ml:id>
														<ml:real>0</ml:real>
													</ml:apply>
													<ml:ifThen>
														<ml:apply>
															<ml:greaterThan/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">q</ml:id>
																<ml:sequence>
																	<ml:parens>
																		<ml:apply>
																			<ml:minus/>
																			<ml:id xml:space="preserve">i</ml:id>
																			<ml:real>1</ml:real>
																		</ml:apply>
																	</ml:parens>
																	<ml:real>1</ml:real>
																</ml:sequence>
															</ml:apply>
															<ml:id xml:space="preserve">d</ml:id>
														</ml:apply>
