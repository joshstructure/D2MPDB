					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="web.stage6">τ</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:or/>
										<ml:apply>
											<ml:lessThan/>
											<ml:apply>
												<ml:lessThan/>
												<ml:real>0</ml:real>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
