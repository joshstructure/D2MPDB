				</region>
				<region region-id="23181" left="6" top="3689.25" width="180.75" height="12.75" align-x="65.25" align-y="3698.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
