				<region region-id="174448" left="6" top="6291" width="408" height="11.25" align-x="9" align-y="6300" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">If NoGood, increase or decrease debond lengths. </p>
					</text>
				</region>
				<region region-id="174536" left="6" top="6321" width="150" height="18" align-x="70.5" align-y="6330" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">CheckPattern</ml:id>
								<ml:real>4</ml:real>
							</ml:apply>
							<ml:id xml:space="preserve">ChkDebondLength</ml:id>
						</ml:define>
					</math>
				</region>
				<region region-id="187845" left="0" top="6375" width="529.5" height="56.25" align-x="0" align-y="6384" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#efefef" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">6.<sp count="2"/>For single-web flanged sections (I-beams, bulbtees, and inverted-tees):<tab/>
							<tab/>
							<tab/>
							<tab/>
							<tab/>
							<tab/>
							<tab/>
							<sp count="4"/>
							<tab/>
							<tab/>
						</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<tab/>a.<sp count="2"/>Bond all strands within the horizontal limits of the web when the total number of debonded strands exceeds 25 % and bond all strands within the horizontal limits of the web when the bottom flange to web width ratio, bf / bw, exceeds 4.<tab/>
							<tab/>
							<tab/>
							<tab/>
							<tab/>
							<tab/>
							<tab/>
							<tab/>
							<tab/>
							<tab/>
						</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<tab/>b.<sp count="2"/>Bond the outer-most strands in all rows located within the full-width section of the flange.<tab/>
						</p>
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<tab/>c.<sp count="2"/>Position debonded strands furthest from the vertical centerline.</p>
					</text>
				</region>
				<region region-id="187848" left="6" top="6465" width="528" height="22.5" align-x="6" align-y="6474" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#efefef" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">a..Bond all strands within the horizontal limits of the web when the total number of debonded strands exceeds 25 percent and bond all strands within the horizontal limits of the web when the bottom flange to web width ratio, bf / bw, exceeds 4.</p>
					</text>
				</region>
				<region region-id="202408" left="6" top="6504" width="298.5" height="32.25" align-x="75.75" align-y="6522" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">StrandsBotRow</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:plus/>
									<ml:real>1</ml:real>
									<ml:apply>
										<ml:id xml:space="preserve">floor</ml:id>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve" subscript="bottom.flg">Width</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:real>2</ml:real>
