				<region region-id="187919" left="6" top="15123" width="114.75" height="22.5" align-x="6" align-y="15132" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Concrete Modulus of Elasticity Function</p>
					</text>
				</region>
				<region region-id="187907" left="168" top="15110.25" width="236.25" height="39.75" align-x="215.25" align-y="15138" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="c">fE</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve" subscript="c">w</ml:id>
									<ml:id xml:space="preserve" subscript="c">f</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult/>
											<ml:real>120000</ml:real>
											<ml:id xml:space="preserve" subscript="1">K</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:pow/>
											<ml:parens>
												<ml:apply>
													<ml:mult/>
													<ml:id xml:space="preserve" subscript="c">w</ml:id>
													<ml:apply>
														<ml:div/>
														<ml:apply>
															<ml:pow/>
															<ml:id xml:space="preserve">ft</ml:id>
															<ml:real>3</ml:real>
														</ml:apply>
														<ml:id xml:space="preserve">kip</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:parens>
											<ml:real>2.0</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:pow/>
										<ml:parens>
