									<ml:id xml:space="preserve" subscript="ps">f</ml:id>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:plus/>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="u">M</ml:id>
										<ml:apply>
											<ml:mult/>
											<ml:id xml:space="preserve" subscript="v">d</ml:id>
											<ml:id xml:space="preserve">ϕ</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>0.5</ml:real>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve" subscript="u">N</ml:id>
											<ml:id xml:space="preserve">ϕ</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:mult/>
									<ml:parens>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve" subscript="u">V</ml:id>
												<ml:id xml:space="preserve" subscript="shr">ϕ</ml:id>
											</ml:apply>
											<ml:parens>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:mult/>
														<ml:real>0.5</ml:real>
														<ml:id xml:space="preserve" subscript="s">V</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="p">V</ml:id>
												</ml:apply>
											</ml:parens>
										</ml:apply>
									</ml:parens>
									<ml:apply>
										<ml:id xml:space="preserve">cot</ml:id>
										<ml:id xml:space="preserve">θ</ml:id>
									</ml:apply>
								</ml:apply>
							</ml:apply>
						</ml:apply>
					</math>
				</region>
				<region region-id="184427" left="324" top="609" width="81" height="11.25" align-x="324" align-y="618" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">governing equation</p>
					</text>
				</region>
				<region region-id="184429" left="420" top="609" width="76.5" height="11.25" align-x="420" align-y="618" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(LRFD 5.7.3.5-1)</p>
					</text>
				</region>
				<region region-id="19077" left="6" top="651" width="499.5" height="11.25" align-x="6" align-y="660" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">use the actual reinforcement provided (bursting and shear) to calculate the resistance for longitudinal reinforcement</p>
					</text>
				</region>
				<region region-id="188160" left="6" top="687" width="48" height="12.75" align-x="36" align-y="696" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">ishear</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:real>4</ml:real>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="188157" left="90" top="687" width="58.5" height="12.75" align-x="103.5" align-y="696" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">i2</ml:id>
							<ml:range>
								<ml:real>0</ml:real>
								<ml:id xml:space="preserve">ishear</ml:id>
							</ml:range>
						</ml:define>
					</math>
				</region>
				<region region-id="188158" left="174" top="687" width="54" height="18" align-x="192.75" align-y="696" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">θ</ml:id>
								<ml:id xml:space="preserve">i2</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">θ</ml:id>
								<ml:id xml:space="preserve">ishear</ml:id>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="188265" left="6" top="729" width="78.75" height="11.25" align-x="6" align-y="738" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(LRFD 5.7.3.3)</p>
					</text>
				</region>
				<region region-id="188266" left="84" top="729" width="150" height="11.25" align-x="84" align-y="738" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(AASHTO GFRP 2.7.3.5 &amp; 2.7.2.5)</p>
					</text>
				</region>
				<region region-id="178312" left="6" top="753" width="514.5" height="42.75" align-x="44.25" align-y="762" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="s.prov">V</ml:id>
								<ml:id xml:space="preserve">hs</ml:id>
							</ml:apply>
							<ml:program>
								<ml:ifThen>
									<ml:parens>
										<ml:apply>
											<ml:plus/>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">MildReinfType</ml:id>
													<ml:str xml:space="preserve">Carbon Steel</ml:str>
												</ml:apply>
											</ml:parens>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">MildReinfType</ml:id>
													<ml:str xml:space="preserve">Stainless Steel</ml:str>
												</ml:apply>
											</ml:parens>
										</ml:apply>
									</ml:parens>
									<ml:parens>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="v.prov">A</ml:id>
														<ml:id xml:space="preserve">hs</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="y">f</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="v">d</ml:id>
													<ml:id xml:space="preserve">hs</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:id xml:space="preserve">cot</ml:id>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">θ</ml:id>
													<ml:id xml:space="preserve">hs</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:apply>
									</ml:parens>
								</ml:ifThen>
								<ml:otherwise>
									<ml:apply>
										<ml:id xml:space="preserve">min</ml:id>
										<ml:sequence>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="v.prov">A</ml:id>
															<ml:id xml:space="preserve">hs</ml:id>
														</ml:apply>
														<ml:id xml:space="preserve" subscript="fv">f</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="v">d</ml:id>
														<ml:id xml:space="preserve">hs</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:id xml:space="preserve">cot</ml:id>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">θ</ml:id>
														<ml:id xml:space="preserve">hs</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:real>0.25</ml:real>
														<ml:apply>
															<ml:sqrt/>
															<ml:apply>
																<ml:mult/>
																<ml:id xml:space="preserve" subscript="c.beam">f</ml:id>
																<ml:id xml:space="preserve">ksi</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="v">b</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="v">d</ml:id>
													<ml:id xml:space="preserve">hs</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:sequence>
									</ml:apply>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="178333" left="6" top="813" width="99.75" height="15" align-x="58.5" align-y="822" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:id xml:space="preserve">max</ml:id>
								<ml:id xml:space="preserve" subscript="s.prov">V</ml:id>
							</ml:apply>
							<ml:unitOverride>
								<ml:id xml:space="preserve">kip</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>1440.131309111737</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="kip"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="1" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="31480" left="6" top="844.5" width="147" height="58.5" align-x="44.25" align-y="876" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="s.prov">V</ml:id>
								<ml:id xml:space="preserve">hs</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">min</ml:id>
								<ml:matrix rows="2" cols="1">
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="u.Strength.long">V</ml:id>
											<ml:id xml:space="preserve">hs</ml:id>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="shr">ϕ</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="s.prov">V</ml:id>
										<ml:id xml:space="preserve">hs</ml:id>
									</ml:apply>
								</ml:matrix>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="178311" left="372" top="867" width="108" height="18.75" align-x="432.75" align-y="876" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="u.Strength">V</ml:id>
								<ml:id xml:space="preserve">ishear</ml:id>
							</ml:apply>
							<ml:unitOverride>
								<ml:id xml:space="preserve">kip</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>163.37050569710783</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="kip"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="179736" left="6" top="926.25" width="394.5" height="79.5" align-x="54" align-y="948" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="long.reqd">V</ml:id>
								<ml:id xml:space="preserve">hs</ml:id>
							</ml:apply>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:lessOrEqual/>
										<ml:id xml:space="preserve">hs</ml:id>
										<ml:id xml:space="preserve">ishear</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:parens>
											<ml:apply>
												<ml:minus/>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:div/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="u.Strength.long">V</ml:id>
															<ml:id xml:space="preserve">hs</ml:id>
														</ml:apply>
														<ml:id xml:space="preserve" subscript="shr">ϕ</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:real>0.5</ml:real>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="s.prov">V</ml:id>
															<ml:id xml:space="preserve">hs</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="p">V</ml:id>
													<ml:id xml:space="preserve">hs</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:parens>
										<ml:apply>
											<ml:id xml:space="preserve">cot</ml:id>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">θ</ml:id>
												<ml:id xml:space="preserve">ishear</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
								</ml:ifThen>
								<ml:otherwise>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="long">Mshr</ml:id>
												<ml:id xml:space="preserve">hs</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="v">d</ml:id>
													<ml:id xml:space="preserve">hs</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="mom">ϕ</ml:id>
													<ml:id xml:space="preserve">hs</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:parens>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:minus/>
														<ml:apply>
															<ml:div/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="u.Strength.long">V</ml:id>
																<ml:id xml:space="preserve">hs</ml:id>
															</ml:apply>
															<ml:id xml:space="preserve" subscript="shr">ϕ</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:real>0.5</ml:real>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="s.prov">V</ml:id>
																<ml:id xml:space="preserve">hs</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="p">V</ml:id>
														<ml:id xml:space="preserve">hs</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:parens>
											<ml:apply>
												<ml:id xml:space="preserve">cot</ml:id>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">θ</ml:id>
													<ml:id xml:space="preserve">hs</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:apply>
									</ml:apply>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="19045" left="6" top="1035.75" width="135.75" height="35.25" align-x="54" align-y="1056" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="long.reqd">V</ml:id>
								<ml:id xml:space="preserve">hs</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">max</ml:id>
								<ml:matrix rows="2" cols="1">
									<ml:apply>
										<ml:mult/>
										<ml:real>0</ml:real>
										<ml:id xml:space="preserve">kip</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="long.reqd">V</ml:id>
										<ml:id xml:space="preserve">hs</ml:id>
									</ml:apply>
								</ml:matrix>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="25445" left="378" top="1047" width="99.75" height="18" align-x="440.25" align-y="1056" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">Location</ml:id>
								<ml:id xml:space="preserve">ishear</ml:id>
							</ml:apply>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>3.8471666666666668</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="foot"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
