							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="s.long">A</ml:id>
								<ml:real>50</ml:real>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="30351" left="300" top="327" width="109.5" height="15" align-x="318" align-y="336" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">pn</ml:id>
							<ml:range>
								<ml:real>0</ml:real>
								<ml:apply>
									<ml:plus/>
									<ml:apply>
										<ml:id xml:space="preserve">last</ml:id>
										<ml:id xml:space="preserve" subscript="shielding">L</ml:id>
									</ml:apply>
									<ml:real>1</ml:real>
								</ml:apply>
							</ml:range>
						</ml:define>
					</math>
				</region>
				<region region-id="135088" left="0" top="357.75" width="540" height="3.75" align-x="0" align-y="360" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#000082" tag="">
					<text use-page-width="true" push-down="true" lock-width="true">
						<p style="Small Lines" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">.</p>
					</text>
				</region>
				<region region-id="145957" left="6" top="399" width="636.75" height="78" align-x="70.5" align-y="408" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8040" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="1.2">Check_SDG</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">display</ml:id>
										<ml:sequence>
											<ml:real>0</ml:real>
											<ml:real>0</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">concat</ml:id>
										<ml:sequence>
											<ml:str xml:space="preserve">Check Live-Load Deflection--</ml:str>
											<ml:id xml:space="preserve">CheckLLDeflection</ml:id>
										</ml:sequence>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">display</ml:id>
										<ml:sequence>
											<ml:real>1</ml:real>
											<ml:real>0</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">concat</ml:id>
										<ml:sequence>
											<ml:str xml:space="preserve">Span vs. Depth Ratio--</ml:str>
											<ml:id xml:space="preserve">CheckSpanToDepth</ml:id>
										</ml:sequence>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">display</ml:id>
										<ml:sequence>
											<ml:real>2</ml:real>
											<ml:real>0</ml:real>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">if</ml:id>
										<ml:sequence>
											<ml:id xml:space="preserve">PedMode</ml:id>
											<ml:id xml:space="preserve">CheckLLDeflection</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">if</ml:id>
												<ml:sequence>
													<ml:apply>
														<ml:plus/>
														<ml:parens>
															<ml:apply>
																<ml:equal/>
																<ml:id xml:space="preserve">CheckLLDeflection</ml:id>
																<ml:str xml:space="preserve">OK</ml:str>
															</ml:apply>
														</ml:parens>
														<ml:parens>
															<ml:apply>
																<ml:equal/>
																<ml:id xml:space="preserve">CheckSpanToDepth</ml:id>
																<ml:str xml:space="preserve">OK</ml:str>
															</ml:apply>
														</ml:parens>
													</ml:apply>
													<ml:str xml:space="preserve">OK</ml:str>
													<ml:str xml:space="preserve">No Good</ml:str>
												</ml:sequence>
											</ml:apply>
										</ml:sequence>
									</ml:apply>
								</ml:localDefine>
								<ml:id xml:space="preserve">display</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="145955" left="486" top="399" width="42.75" height="11.25" align-x="486" align-y="408" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">SDG 1.2</p>
					</text>
				</region>
				<region region-id="145958" left="6" top="496.5" width="230.25" height="45.75" align-x="69" align-y="522" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="1.2">Check_SDG</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="3" cols="1">
									<ml:str xml:space="preserve">Check Live-Load Deflection--OK</ml:str>
									<ml:str xml:space="preserve">Span vs. Depth Ratio--No Good</ml:str>
									<ml:str xml:space="preserve">OK</ml:str>
								</ml:matrix>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="174583" left="6" top="555" width="390" height="18.75" align-x="145.5" align-y="564" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">CheckDeflectionOrSpanToDepth</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:id xml:space="preserve">PedMode</ml:id>
										<ml:id xml:space="preserve">CheckLLDeflection</ml:id>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="1.2">Check_SDG</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:sequence>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:str xml:space="preserve">OK</ml:str>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="144703" left="6" top="582.75" width="226.5" height="14.25" align-x="6" align-y="594" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="heading" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Strength Limit State Moments</p>
					</text>
				</region>
				<region region-id="144699" left="6" top="615" width="386.25" height="18.75" align-x="66" align-y="624" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="pos.StrengthI">M</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:plus/>
								<ml:apply>
									<ml:mult/>
									<ml:real>1.75</ml:real>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="dist.live.pos">M</ml:id>
										<ml:id xml:space="preserve">n</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:parens>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:mult/>
											<ml:parens>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="dl.non.comp">M</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="dl.comp.str">M</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:parens>
											<ml:real>1.25</ml:real>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="dl.future.ws">M</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
											<ml:real>1.5</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:parens>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="144700" left="6" top="645" width="825" height="18.75" align-x="68.25" align-y="654" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8040" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="pos.StrengthII">M</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">PedMode</ml:id>
									<ml:parens>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:mult/>
												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="dl.non.comp">M</ml:id>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="dl.comp.str">M</ml:id>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:parens>
												<ml:real>1.25</ml:real>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="dl.future.ws">M</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:real>1.5</ml:real>
											</ml:apply>
										</ml:apply>
									</ml:parens>
									<ml:apply>
										<ml:plus/>
										<ml:parens>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:parens>
														<ml:apply>
															<ml:plus/>
															<ml:apply>
																<ml:mult/>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve" subscript="permit.pos">M</ml:id>
																	<ml:id xml:space="preserve">n</ml:id>
																</ml:apply>
																<ml:parens>
																	<ml:real>1.33</ml:real>
																</ml:parens>
															</ml:apply>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="lane.permit.pos">M</ml:id>
																<ml:id xml:space="preserve">n</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:parens>
													<ml:id xml:space="preserve" subscript="mom">g</ml:id>
												</ml:apply>
												<ml:real>1.35</ml:real>
											</ml:apply>
										</ml:parens>
										<ml:parens>
											<ml:apply>
												<ml:plus/>
												<ml:apply>
													<ml:mult/>
													<ml:parens>
														<ml:apply>
															<ml:plus/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="dl.non.comp">M</ml:id>
																<ml:id xml:space="preserve">n</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="dl.comp.str">M</ml:id>
																<ml:id xml:space="preserve">n</ml:id>
															</ml:apply>
														</ml:apply>
													</ml:parens>
													<ml:real>1.25</ml:real>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="dl.future.ws">M</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
													<ml:real>1.5</ml:real>
												</ml:apply>
											</ml:apply>
										</ml:parens>
									</ml:apply>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="144702" left="6" top="708.75" width="226.5" height="14.25" align-x="6" align-y="720" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="heading" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Nominal Moment Capacity</p>
					</text>
				</region>
				<region region-id="70305" left="6" top="740.25" width="254.25" height="12" align-x="6" align-y="750" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="subheading" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Function to Calculate Strand Stress for a Given Strain</p>
					</text>
				</region>
				<region region-id="184026" left="270" top="747" width="261" height="11.25" align-x="270" align-y="756" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">"Prestressed Concrete Structures" by Collins &amp; Mitchell, 1991</p>
					</text>
				</region>
				<region region-id="184037" left="6" top="771" width="153.75" height="11.25" align-x="14.25" align-y="780" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Carbon Steel Strand - Low relaxation</p>
					</text>
				</region>
				<region region-id="184036" left="180" top="771" width="81" height="15" align-x="216.75" align-y="780" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="p.carbon">E</ml:id>
							<ml:unitOverride>
								<ml:id xml:space="preserve">ksi</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>28500</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="kips_per_sq_inch"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="0" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="7"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="184035" left="288" top="771" width="73.5" height="15" align-x="326.25" align-y="780" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="pu.carbon">f</ml:id>
							<ml:unitOverride>
								<ml:id xml:space="preserve">ksi</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>270</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="kips_per_sq_inch"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="184034" left="378" top="771" width="34.5" height="11.25" align-x="384" align-y="780" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Eq. 3-26</p>
					</text>
				</region>
				<region region-id="179753" left="6" top="798" width="537" height="42" align-x="64.5" align-y="816" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffd2d2" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="p.lowlax">f_f</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">ε</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:lessThan/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:div/>
													<ml:id xml:space="preserve" subscript="p.carbon">E</ml:id>
													<ml:id xml:space="preserve">ksi</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve">ε</ml:id>
											</ml:apply>
											<ml:parens>
												<ml:apply>
													<ml:plus/>
													<ml:real>0.025</ml:real>
													<ml:apply>
														<ml:div/>
														<ml:real>0.975</ml:real>
														<ml:apply>
															<ml:pow/>
															<ml:parens>
																<ml:apply>
																	<ml:plus/>
																	<ml:real>1</ml:real>
																	<ml:apply>
																		<ml:pow/>
																		<ml:parens>
																			<ml:apply>
																				<ml:mult/>
																				<ml:real>118</ml:real>
																				<ml:id xml:space="preserve">ε</ml:id>
																			</ml:apply>
																		</ml:parens>
																		<ml:real>10</ml:real>
																	</ml:apply>
																</ml:apply>
															</ml:parens>
															<ml:real>0.1</ml:real>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve" subscript="pu.carbon">f</ml:id>
											<ml:id xml:space="preserve">ksi</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve" subscript="p.carbon">E</ml:id>
												<ml:id xml:space="preserve">ksi</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve">ε</ml:id>
										</ml:apply>
										<ml:parens>
											<ml:apply>
												<ml:plus/>
												<ml:real>0.025</ml:real>
												<ml:apply>
													<ml:div/>
													<ml:real>0.975</ml:real>
													<ml:apply>
														<ml:pow/>
														<ml:parens>
															<ml:apply>
																<ml:plus/>
																<ml:real>1</ml:real>
																<ml:apply>
																	<ml:pow/>
