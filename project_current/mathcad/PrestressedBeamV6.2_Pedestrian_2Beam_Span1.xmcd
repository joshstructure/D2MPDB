				</region>
				<region region-id="188075" left="120" top="14266.5" width="151.5" height="33.75" align-x="175.5" align-y="14282.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="true">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="c.deck.normal">w</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve" subscript="c">fw</ml:id>
									<ml:id xml:space="preserve" subscript="c.deck">f</ml:id>
								</ml:apply>
								<ml:unitOverride>
									<ml:apply>
										<ml:div/>
