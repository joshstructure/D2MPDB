									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">category</ml:id>
										<ml:str xml:space="preserve">FSB</ml:str>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">be</ml:id>
										<ml:id xml:space="preserve" subscript="e.fsb">b</ml:id>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">category</ml:id>
										<ml:str xml:space="preserve">FUB</ml:str>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">be</ml:id>
										<ml:id xml:space="preserve" subscript="e.fub">b</ml:id>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">category</ml:id>
										<ml:str xml:space="preserve">SlabBeams</ml:str>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">be</ml:id>
										<ml:id xml:space="preserve" subscript="e.slab">b</ml:id>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">category</ml:id>
