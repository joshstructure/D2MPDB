				<region region-id="176081" left="6" top="7458.75" width="285.75" height="32.25" align-x="60.75" align-y="7470" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="prestress.fin">M</ml:id>
