				<region region-id="176111" left="6" top="9378.75" width="406.5" height="72.75" align-x="72" align-y="9414" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="top.deck.ServiceI">f</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:parens>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:mult/>
											<ml:parens>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:summation/>
														<ml:lambda>
															<ml:boundVars>
																<ml:id xml:space="preserve">nc</ml:id>
															</ml:boundVars>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="tr">B</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">nc</ml:id>
																	<ml:id xml:space="preserve">n</ml:id>
																</ml:sequence>
															</ml:apply>
														</ml:lambda>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:parens>
															<ml:apply>
																<ml:plus/>
																<ml:id xml:space="preserve" subscript="deck">t</ml:id>
																<ml:id xml:space="preserve" subscript="buildup">h</ml:id>
															</ml:apply>
														</ml:parens>
														<ml:apply>
															<ml:summation/>
															<ml:lambda>
																<ml:boundVars>
																	<ml:id xml:space="preserve">nc</ml:id>
																</ml:boundVars>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve" subscript="tr">A</ml:id>
																	<ml:sequence>
																		<ml:id xml:space="preserve">nc</ml:id>
																		<ml:id xml:space="preserve">n</ml:id>
																	</ml:sequence>
																</ml:apply>
															</ml:lambda>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:parens>
											<ml:parens>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="dl.comp">M</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="dist.live.pos">M</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:mult/>
												<ml:parens>
													<ml:apply>
														<ml:summation/>
														<ml:lambda>
															<ml:boundVars>
																<ml:id xml:space="preserve">nc</ml:id>
															</ml:boundVars>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="tr">A</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">nc</ml:id>
																	<ml:id xml:space="preserve">n</ml:id>
																</ml:sequence>
															</ml:apply>
														</ml:lambda>
													</ml:apply>
												</ml:parens>
												<ml:parens>
													<ml:apply>
														<ml:summation/>
														<ml:lambda>
															<ml:boundVars>
																<ml:id xml:space="preserve">nc</ml:id>
															</ml:boundVars>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve" subscript="tr">I</ml:id>
																<ml:sequence>
																	<ml:id xml:space="preserve">nc</ml:id>
																	<ml:id xml:space="preserve">n</ml:id>
																</ml:sequence>
															</ml:apply>
														</ml:lambda>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:apply>
												<ml:pow/>
