				<region region-id="203027" left="6" top="5184" width="176.25" height="36" align-x="45.75" align-y="5208" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="Pedestrian modification">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="PL">Mmax</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
