				<region region-id="177045" left="234" top="1593" width="91.5" height="15" align-x="290.25" align-y="1602" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
