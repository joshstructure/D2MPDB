				<region region-id="175942" left="6" top="9159" width="387.75" height="15" align-x="69.75" align-y="9168" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="true">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="beam">Thickness</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:id xml:space="preserve">substr</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:real>0</ml:real>
												<ml:real>3</ml:real>
											</ml:sequence>
										</ml:apply>
										<ml:str xml:space="preserve">FSB</ml:str>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
