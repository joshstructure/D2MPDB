			<rendering item-idref="976"/>
		</region>
		<region region-id="152537" left="6" top="28233" width="429" height="36" align-x="6" align-y="28242" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Typically shear reinforcement is extended up into the deck slab.</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">These calculations are based on shear reinforcement functioning as interface reinforcing.</p>
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">The<f family="Times New Roman" charset="0">
						<inlineAttr underline="false" line-through="false">
							<c val="#00f">
								<sp/>
							</c>
						</inlineAttr>
					</f>
					<region region-id="24579" left="23.25" top="28256.25" width="64.5" height="12.75" align-x="54.75" align-y="28265.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
						<math optimize="false" disable-calc="false">
							<ml:id xml:space="preserve" xmlns:ml="http://schemas.mathsoft.com/math30">interface_factor</ml:id>
						</math>
						<rendering item-idref="977"/>
					</region>
					<f family="Times New Roman" charset="0">
						<inlineAttr underline="false" line-through="false">
							<c val="#00f">
								<sp count="2"/>
							</c>
						</inlineAttr>
					</f>can<sp count="2"/>be used to adjust this assumption.</p>
			</text>
		</region>
		<region region-id="184252" left="270" top="28278.75" width="234" height="24.75" align-x="270" align-y="28290" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">If max(Avf.min) or max(Avf.des) is greater than 0 in<sup>2</sup>/ft, interface reinforcement is required.</p>
			</text>
		</region>
		<region region-id="202200" left="6" top="28274.25" width="126.75" height="33.75" align-x="87" align-y="28296" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:apply>
						<ml:id xml:space="preserve">max</ml:id>
						<ml:id xml:space="preserve" subscript="vf.min.required">A</ml:id>
					</ml:apply>
					<ml:unitOverride>
						<ml:apply>
							<ml:div/>
							<ml:apply>
								<ml:pow/>
								<ml:id xml:space="preserve">in</ml:id>
								<ml:real>2</ml:real>
							</ml:apply>
							<ml:id xml:space="preserve">ft</ml:id>
						</ml:apply>
					</ml:unitOverride>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<unitedValue>
							<ml:real>0</ml:real>
							<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
								<unitReference unit="foot" power-numerator="-1"/>
								<unitReference unit="inch" power-numerator="2"/>
							</unitMonomial>
						</unitedValue>
					</result>
				</ml:eval>
				<resultFormat numeric-only="true">
					<general precision="3" show-trailing-zeros="true" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="3"/>
					<matrix display-style="auto" expand-nested-arrays="false"/>
					<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
				</resultFormat>
			</math>
			<rendering item-idref="978"/>
		</region>
