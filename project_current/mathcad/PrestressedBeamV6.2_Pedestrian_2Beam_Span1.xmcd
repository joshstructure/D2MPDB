							<ml:define>
								<ml:function>
									<ml:id xml:space="preserve">fChkMessage</ml:id>
									<ml:boundVars>
										<ml:id xml:space="preserve">chk</ml:id>
										<ml:id xml:space="preserve">message</ml:id>
									</ml:boundVars>
								</ml:function>
								<ml:program>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
