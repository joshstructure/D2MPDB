				<region region-id="146418" left="6" top="500.25" width="481.5" height="52.5" align-x="18" align-y="510" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">When calculating Live Load Distribution Factors, group beam together according to AASHO Section 4 </p>
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<region region-id="39602" left="6" top="513" width="294" height="12.75" align-x="33" align-y="522" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
										<ml:equal/>
										<ml:id xml:space="preserve">Index</ml:id>
										<ml:localDefine>
											<ml:real>0</ml:real>
											<ml:parens>
												<ml:sequence>
													<ml:apply>
														<ml:equal/>
														<ml:id xml:space="preserve">BeamCategory</ml:id>
														<ml:str xml:space="preserve">I-Beam</ml:str>
													</ml:apply>
													<ml:str xml:space="preserve">InvTBeams</ml:str>
													<ml:str xml:space="preserve">DblTBeams</ml:str>
												</ml:sequence>
											</ml:parens>
										</ml:localDefine>
									</ml:apply>
								</math>
							</region>
						</p>
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<region region-id="39603" left="6" top="525" width="211.5" height="12.75" align-x="51.75" align-y="534" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:localDefine xmlns:ml="http://schemas.mathsoft.com/math30">
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">Index</ml:id>
											<ml:real>1</ml:real>
										</ml:apply>
										<ml:sequence>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">BeamCategory</ml:id>
												<ml:str xml:space="preserve">FSB</ml:str>
											</ml:apply>
											<ml:str xml:space="preserve">SlabBeams</ml:str>
										</ml:sequence>
									</ml:localDefine>
								</math>
							</region>
						</p>
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<region region-id="39604" left="6" top="543" width="154.5" height="12.75" align-x="51.75" align-y="552" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:localDefine xmlns:ml="http://schemas.mathsoft.com/math30">
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">Index</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">BeamCategory</ml:id>
											<ml:str xml:space="preserve">FUB</ml:str>
										</ml:apply>
									</ml:localDefine>
								</math>
							</region>
						</p>
					</text>
				</region>
				<region region-id="150313" left="6" top="561" width="365.25" height="62.25" align-x="33.75" align-y="570" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8040" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">index</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:program>
									<ml:localDefine>
										<ml:id xml:space="preserve">idx</ml:id>
										<ml:real>0</ml:real>
									</ml:localDefine>
									<ml:ifThen>
										<ml:apply>
											<ml:plus/>
											<ml:parens>
												<ml:apply>
													<ml:equal/>
													<ml:id xml:space="preserve">BeamCategory</ml:id>
													<ml:str xml:space="preserve">FSB</ml:str>
												</ml:apply>
											</ml:parens>
											<ml:parens>
												<ml:apply>
