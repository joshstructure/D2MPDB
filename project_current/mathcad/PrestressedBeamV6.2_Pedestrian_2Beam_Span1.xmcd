						<ml:matrix rows="5" cols="4">
							<ml:str xml:space="preserve">Section</ml:str>
							<ml:str xml:space="preserve">Net Beam</ml:str>
							<ml:str xml:space="preserve">Transformed Beam (initial)</ml:str>
							<ml:str xml:space="preserve">Transformed Beam (final)</ml:str>
							<ml:str xml:space="preserve">Composite Section</ml:str>
							<ml:str xml:space="preserve">Area (in^2)    </ml:str>
