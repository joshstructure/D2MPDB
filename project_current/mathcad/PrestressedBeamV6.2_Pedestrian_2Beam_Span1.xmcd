				<region region-id="202093" left="6" top="13833" width="384" height="144.75" align-x="68.25" align-y="13842" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">FailureMode</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">StrandType</ml:id>
										<ml:str xml:space="preserve">Carbon Steel - Low Lax</ml:str>
									</ml:apply>
									<ml:str xml:space="preserve">N.A.</ml:str>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">StrandType</ml:id>
										<ml:str xml:space="preserve">Carbon Steel - Stress Relieved</ml:str>
									</ml:apply>
									<ml:str xml:space="preserve">N.A.</ml:str>
								</ml:ifThen>
								<ml:otherwise>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">StrandType</ml:id>
												<ml:str xml:space="preserve">Stainless Steel</ml:str>
											</ml:apply>
											<ml:localDefine>
												<ml:id xml:space="preserve" subscript="pu">ε</ml:id>
												<ml:id xml:space="preserve" subscript="pu.SS">ε</ml:id>
											</ml:localDefine>
										</ml:ifThen>
										<ml:ifThen>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">StrandType</ml:id>
												<ml:str xml:space="preserve">Carbon Fiber Reinforced Polymer</ml:str>
											</ml:apply>
											<ml:localDefine>
												<ml:id xml:space="preserve" subscript="pu">ε</ml:id>
												<ml:id xml:space="preserve" subscript="pu.CFRP">ε</ml:id>
											</ml:localDefine>
										</ml:ifThen>
										<ml:ifThen>
											<ml:apply>
												<ml:lessThan/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="cu">ε</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:apply>
												<ml:real>0.003</ml:real>
											</ml:apply>
											<ml:str xml:space="preserve">Strand Rupture</ml:str>
										</ml:ifThen>
										<ml:ifThen>
											<ml:apply>
												<ml:and/>
												<ml:apply>
													<ml:lessThan/>
													<ml:apply>
														<ml:id xml:space="preserve">max</ml:id>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="tot">ε</ml:id>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="pu">ε</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:equal/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="cu">ε</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:apply>
													<ml:real>0.003</ml:real>
												</ml:apply>
											</ml:apply>
											<ml:str xml:space="preserve">Concrete Crushing</ml:str>
										</ml:ifThen>
										<ml:otherwise>
											<ml:str xml:space="preserve">Balanced</ml:str>
										</ml:otherwise>
									</ml:program>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
