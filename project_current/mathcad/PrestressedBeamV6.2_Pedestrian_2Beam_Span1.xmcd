						</resultFormat>
					</math>
				</region>
				<region region-id="188191" left="246" top="3207" width="276.75" height="11.25" align-x="262.5" align-y="3216" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
