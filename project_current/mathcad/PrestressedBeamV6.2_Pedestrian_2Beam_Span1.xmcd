				</region>
				<region region-id="181995" left="6" top="7947" width="563.25" height="644.25" align-x="230.25" align-y="7956" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="n">fValuesM</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve" subscript="trap">w</ml:id>
									<ml:id xml:space="preserve" subscript="c">f</ml:id>
									<ml:id xml:space="preserve" subscript="trap">t</ml:id>
									<ml:id xml:space="preserve">sect</ml:id>
									<ml:id xml:space="preserve" subscript="ps">A</ml:id>
									<ml:id xml:space="preserve">d</ml:id>
									<ml:id xml:space="preserve">εcp</ml:id>
									<ml:id xml:space="preserve">εse</ml:id>
									<ml:id xml:space="preserve" subscript="groups">n</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">cna</ml:id>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="trap">t</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">diff</ml:id>
									<ml:real>100</ml:real>
								</ml:localDefine>
								<ml:while>
									<ml:apply>
										<ml:greaterThan/>
										<ml:id xml:space="preserve">diff</ml:id>
										<ml:real>0.1</ml:real>
									</ml:apply>
									<ml:program>
										<ml:for>
											<ml:id xml:space="preserve">i</ml:id>
											<ml:range>
												<ml:real>0</ml:real>
												<ml:apply>
													<ml:minus/>
													<ml:id xml:space="preserve" subscript="groups">n</ml:id>
													<ml:real>2</ml:real>
												</ml:apply>
											</ml:range>
											<ml:program>
												<ml:ifThen>
													<ml:apply>
														<ml:equal/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">PSGroupIndex</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
