				<region region-id="179753" left="6" top="798" width="537" height="42" align-x="64.5" align-y="816" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffd2d2" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="p.lowlax">f_f</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">ε</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:lessThan/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:div/>
													<ml:id xml:space="preserve" subscript="p.carbon">E</ml:id>
													<ml:id xml:space="preserve">ksi</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve">ε</ml:id>
											</ml:apply>
											<ml:parens>
												<ml:apply>
													<ml:plus/>
													<ml:real>0.025</ml:real>
													<ml:apply>
														<ml:div/>
														<ml:real>0.975</ml:real>
														<ml:apply>
															<ml:pow/>
															<ml:parens>
																<ml:apply>
																	<ml:plus/>
																	<ml:real>1</ml:real>
																	<ml:apply>
																		<ml:pow/>
																		<ml:parens>
																			<ml:apply>
																				<ml:mult/>
																				<ml:real>118</ml:real>
																				<ml:id xml:space="preserve">ε</ml:id>
																			</ml:apply>
																		</ml:parens>
																		<ml:real>10</ml:real>
																	</ml:apply>
																</ml:apply>
															</ml:parens>
															<ml:real>0.1</ml:real>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve" subscript="pu.carbon">f</ml:id>
											<ml:id xml:space="preserve">ksi</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:div/>
												<ml:id xml:space="preserve" subscript="p.carbon">E</ml:id>
												<ml:id xml:space="preserve">ksi</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve">ε</ml:id>
										</ml:apply>
										<ml:parens>
											<ml:apply>
												<ml:plus/>
												<ml:real>0.025</ml:real>
												<ml:apply>
													<ml:div/>
													<ml:real>0.975</ml:real>
													<ml:apply>
														<ml:pow/>
														<ml:parens>
															<ml:apply>
																<ml:plus/>
																<ml:real>1</ml:real>
																<ml:apply>
																	<ml:pow/>
																	<ml:parens>
																		<ml:apply>
																			<ml:mult/>
																			<ml:real>118</ml:real>
																			<ml:id xml:space="preserve">ε</ml:id>
																		</ml:apply>
																	</ml:parens>
																	<ml:real>10</ml:real>
																</ml:apply>
															</ml:apply>
														</ml:parens>
														<ml:real>0.1</ml:real>
													</ml:apply>
												</ml:apply>
											</ml:apply>
										</ml:parens>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="pu.carbon">f</ml:id>
										<ml:id xml:space="preserve">ksi</ml:id>
									</ml:apply>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
