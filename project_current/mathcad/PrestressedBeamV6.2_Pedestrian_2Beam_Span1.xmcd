											<ml:id xml:space="preserve">BeamType</ml:id>
											<ml:str xml:space="preserve">FUB54</ml:str>
										</ml:apply>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:mult/>
												<ml:parens>
													<ml:apply>
														<ml:minus/>
														<ml:id xml:space="preserve">#Beams</ml:id>
														<ml:real>1</ml:real>
													</ml:apply>
												</ml:parens>
