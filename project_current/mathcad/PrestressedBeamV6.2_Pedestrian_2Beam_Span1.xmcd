				<region region-id="183436" left="6" top="6747" width="213" height="11.25" align-x="25.5" align-y="6756" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Functions for Trapezoidal Shapes (width, thickness)</p>
					</text>
				</region>
				<region region-id="39733" left="6" top="6765" width="474" height="620.25" align-x="96" align-y="6774" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">fTrapezoids</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">coords</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">count</ml:id>
									<ml:real>0</ml:real>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">ylast</ml:id>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">coords</ml:id>
										<ml:sequence>
											<ml:real>0</ml:real>
											<ml:real>1</ml:real>
										</ml:sequence>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">yset</ml:id>
										<ml:real>0</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">coords</ml:id>
										<ml:sequence>
											<ml:real>0</ml:real>
											<ml:real>1</ml:real>
										</ml:sequence>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">last</ml:id>
									<ml:apply>
										<ml:id xml:space="preserve">rows</ml:id>
										<ml:id xml:space="preserve">coords</ml:id>
									</ml:apply>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">i</ml:id>
									<ml:range>
										<ml:real>1</ml:real>
										<ml:parens>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve">last</ml:id>
												<ml:real>1</ml:real>
											</ml:apply>
										</ml:parens>
									</ml:range>
									<ml:program>
										<ml:localDefine>
											<ml:id xml:space="preserve">set</ml:id>
											<ml:real>0</ml:real>
										</ml:localDefine>
										<ml:for>
											<ml:id xml:space="preserve">j</ml:id>
											<ml:range>
												<ml:real>0</ml:real>
												<ml:parens>
													<ml:apply>
														<ml:minus/>
														<ml:apply>
															<ml:id xml:space="preserve">rows</ml:id>
															<ml:id xml:space="preserve">yset</ml:id>
														</ml:apply>
														<ml:real>1</ml:real>
													</ml:apply>
												</ml:parens>
											</ml:range>
											<ml:ifThen>
												<ml:apply>
													<ml:equal/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">yset</ml:id>
														<ml:id xml:space="preserve">j</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">coords</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">i</ml:id>
															<ml:real>1</ml:real>
														</ml:sequence>
													</ml:apply>
												</ml:apply>
												<ml:localDefine>
													<ml:id xml:space="preserve">set</ml:id>
													<ml:real>1</ml:real>
												</ml:localDefine>
											</ml:ifThen>
										</ml:for>
										<ml:ifThen>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">set</ml:id>
												<ml:real>0</ml:real>
											</ml:apply>
											<ml:program>
												<ml:localDefine>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">yset</ml:id>
														<ml:id xml:space="preserve">count</ml:id>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">coords</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">i</ml:id>
															<ml:real>1</ml:real>
														</ml:sequence>
													</ml:apply>
												</ml:localDefine>
												<ml:localDefine>
													<ml:id xml:space="preserve">count</ml:id>
													<ml:apply>
														<ml:plus/>
														<ml:id xml:space="preserve">count</ml:id>
														<ml:real>1</ml:real>
													</ml:apply>
												</ml:localDefine>
											</ml:program>
										</ml:ifThen>
									</ml:program>
								</ml:for>
								<ml:localDefine>
									<ml:id xml:space="preserve">y</ml:id>
									<ml:apply>
										<ml:id xml:space="preserve">reverse</ml:id>
										<ml:apply>
											<ml:id xml:space="preserve">sort</ml:id>
											<ml:id xml:space="preserve">yset</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:parens>
											<ml:apply>
												<ml:minus/>
												<ml:apply>
													<ml:id xml:space="preserve">rows</ml:id>
													<ml:id xml:space="preserve">yset</ml:id>
												</ml:apply>
												<ml:real>1</ml:real>
											</ml:apply>
										</ml:parens>
									</ml:range>
									<ml:program>
										<ml:localDefine>
											<ml:id xml:space="preserve">count</ml:id>
											<ml:real>0</ml:real>
										</ml:localDefine>
										<ml:for>
											<ml:id xml:space="preserve">i</ml:id>
											<ml:range>
												<ml:real>0</ml:real>
												<ml:parens>
													<ml:apply>
														<ml:minus/>
														<ml:id xml:space="preserve">last</ml:id>
														<ml:real>2</ml:real>
													</ml:apply>
												</ml:parens>
											</ml:range>
											<ml:ifThen>
												<ml:apply>
													<ml:equal/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">coords</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">i</ml:id>
															<ml:real>1</ml:real>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">y</ml:id>
														<ml:id xml:space="preserve">j</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:program>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">xgrp</ml:id>
															<ml:id xml:space="preserve">count</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">coords</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">i</ml:id>
																<ml:real>0</ml:real>
															</ml:sequence>
														</ml:apply>
													</ml:localDefine>
													<ml:localDefine>
														<ml:id xml:space="preserve">count</ml:id>
														<ml:apply>
															<ml:plus/>
															<ml:id xml:space="preserve">count</ml:id>
															<ml:real>1</ml:real>
														</ml:apply>
													</ml:localDefine>
												</ml:program>
											</ml:ifThen>
										</ml:for>
										<ml:ifThen>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">count</ml:id>
												<ml:real>2</ml:real>
											</ml:apply>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">W</ml:id>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:absval/>
													<ml:apply>
														<ml:minus/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">xgrp</ml:id>
															<ml:real>1</ml:real>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">xgrp</ml:id>
															<ml:real>0</ml:real>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
										<ml:otherwise>
											<ml:program>
												<ml:localDefine>
													<ml:id xml:space="preserve">xtmp</ml:id>
													<ml:apply>
														<ml:id xml:space="preserve">sort</ml:id>
														<ml:id xml:space="preserve">xgrp</ml:id>
													</ml:apply>
												</ml:localDefine>
												<ml:localDefine>
													<ml:id xml:space="preserve">q</ml:id>
													<ml:apply>
														<ml:div/>
														<ml:apply>
															<ml:id xml:space="preserve">rows</ml:id>
															<ml:id xml:space="preserve">xgrp</ml:id>
														</ml:apply>
														<ml:real>2</ml:real>
													</ml:apply>
												</ml:localDefine>
												<ml:ifThen>
													<ml:apply>
														<ml:equal/>
														<ml:apply>
															<ml:id xml:space="preserve">substr</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">BeamType</ml:id>
																<ml:real>0</ml:real>
																<ml:real>3</ml:real>
															</ml:sequence>
														</ml:apply>
														<ml:str xml:space="preserve">FUB</ml:str>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">W</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:summation/>
															<ml:lambda>
																<ml:boundVars>
																	<ml:id xml:space="preserve">n</ml:id>
																</ml:boundVars>
																<ml:parens>
																	<ml:apply>
																		<ml:minus/>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve">xtmp</ml:id>
																			<ml:apply>
																				<ml:minus/>
																				<ml:apply>
																					<ml:mult/>
																					<ml:real>2</ml:real>
																					<ml:id xml:space="preserve">n</ml:id>
																				</ml:apply>
																				<ml:real>1</ml:real>
																			</ml:apply>
																		</ml:apply>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve">xtmp</ml:id>
																			<ml:apply>
																				<ml:mult/>
																				<ml:real>2</ml:real>
																				<ml:parens>
																					<ml:apply>
																						<ml:minus/>
																						<ml:id xml:space="preserve">n</ml:id>
																						<ml:real>1</ml:real>
																					</ml:apply>
																				</ml:parens>
																			</ml:apply>
																		</ml:apply>
																	</ml:apply>
																</ml:parens>
															</ml:lambda>
															<ml:bounds>
																<ml:real>1</ml:real>
																<ml:id xml:space="preserve">q</ml:id>
															</ml:bounds>
														</ml:apply>
													</ml:localDefine>
												</ml:ifThen>
												<ml:ifThen>
													<ml:apply>
														<ml:equal/>
														<ml:apply>
															<ml:id xml:space="preserve">substr</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">BeamType</ml:id>
																<ml:real>0</ml:real>
																<ml:real>3</ml:real>
															</ml:sequence>
														</ml:apply>
														<ml:str xml:space="preserve">FDT</ml:str>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">W</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:summation/>
															<ml:lambda>
																<ml:boundVars>
																	<ml:id xml:space="preserve">n</ml:id>
																</ml:boundVars>
																<ml:parens>
																	<ml:apply>
																		<ml:minus/>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve">xtmp</ml:id>
																			<ml:apply>
																				<ml:minus/>
																				<ml:apply>
																					<ml:mult/>
																					<ml:real>2</ml:real>
																					<ml:id xml:space="preserve">n</ml:id>
																				</ml:apply>
																				<ml:real>1</ml:real>
																			</ml:apply>
																		</ml:apply>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve">xtmp</ml:id>
