											<ml:mult style="auto-select"/>
											<ml:real>10</ml:real>
											<ml:id xml:space="preserve">ksi</ml:id>
										</ml:apply>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">StrandType</ml:id>
											<ml:str xml:space="preserve">Stainless Steel</ml:str>
										</ml:apply>
										<ml:apply>
											<ml:mult style="auto-select"/>
											<ml:real>2.4</ml:real>
											<ml:id xml:space="preserve">ksi</ml:id>
										</ml:apply>
									</ml:ifThen>
									<ml:ifThen>
										<ml:apply>
											<ml:equal/>
											<ml:id xml:space="preserve">StrandType</ml:id>
											<ml:str xml:space="preserve">Carbon Fiber Reinforced Polymer</ml:str>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="pR.CFRP">Δf</ml:id>
									</ml:ifThen>
								</ml:program>
								<ml:unitOverride>
									<ml:id xml:space="preserve">ksi</ml:id>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>2.4</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="kips_per_sq_inch"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="5"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="177549" left="6" top="5216.25" width="522" height="27.75" align-x="12" align-y="5226" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">The first term in the equation <region region-id="140879" left="132" top="5217" width="25.5" height="15" align-x="144" align-y="5226" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" subscript="pLT" xmlns:ml="http://schemas.mathsoft.com/math30">Δf</ml:id>
								</math>
							</region> estimates creep, the second estimates shrinkage and the last estimates total relaxation loss. </p>
					</text>
				</region>
				<region region-id="150980" left="444" top="5235" width="80.25" height="11.25" align-x="444" align-y="5244" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#f00" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(LRFD C5.9.3.3)</p>
					</text>
				</region>
				<region region-id="177565" left="6" top="5244" width="281.25" height="32.25" align-x="37.5" align-y="5262" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="pLT">Δf</ml:id>
							<ml:apply>
								<ml:neg/>
								<ml:parens>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:real>10</ml:real>
														<ml:apply>
															<ml:div/>
															<ml:apply>
																<ml:mult/>
																<ml:id xml:space="preserve" subscript="pj">f</ml:id>
																<ml:id xml:space="preserve" subscript="ps.total">A</ml:id>
															</ml:apply>
															<ml:id xml:space="preserve" subscript="beam">A</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="h">γ</ml:id>
												</ml:apply>
												<ml:id xml:space="preserve" subscript="st">γ</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:parens>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:mult/>
															<ml:real>12</ml:real>
															<ml:id xml:space="preserve" subscript="h">γ</ml:id>
														</ml:apply>
														<ml:id xml:space="preserve" subscript="st">γ</ml:id>
													</ml:apply>
												</ml:parens>
												<ml:id xml:space="preserve">ksi</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:id xml:space="preserve" subscript="pR">Δf</ml:id>
									</ml:apply>
								</ml:parens>
							</ml:apply>
						</ml:define>
						<resultFormat numeric-only="true">
							<general precision="2" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="5"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="173688" left="6" top="5295" width="77.25" height="15" align-x="36" align-y="5304" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="pLT">Δf</ml:id>
							<ml:unitOverride>
								<ml:id xml:space="preserve">ksi</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>-24.945933176489216</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="kips_per_sq_inch"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="147020" left="6" top="5318.25" width="201.75" height="15.75" align-x="6" align-y="5328" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<i>
								<u>
									<inlineAttr line-through="false">
										<c val="#00f">total losses (</c>
									</inlineAttr>
								</u>
							</i>
							<region region-id="140884" left="60" top="5319" width="24.75" height="15" align-x="71.25" align-y="5328" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" subscript="pES" xmlns:ml="http://schemas.mathsoft.com/math30">Δf</ml:id>
								</math>
							</region>
							<f family="Arial" charset="0" size="10">
								<i>
									<u>
										<inlineAttr font-weight="normal" line-through="false">
