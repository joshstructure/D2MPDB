				<region region-id="130219" left="6" top="6009" width="220.5" height="11.25" align-x="6" align-y="6018" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">approximate using #3 bars spaced at 6 inches</p>
					</text>
				</region>
				<region region-id="26219" left="6" top="6042" width="285" height="30" align-x="95.25" align-y="6060" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">TotalNoConfineBars</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:real>2</ml:real>
									<ml:apply>
										<ml:id xml:space="preserve">ceil</ml:id>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:mult/>
														<ml:real>1.5</ml:real>
														<ml:apply>
															<ml:absval/>
															<ml:id xml:space="preserve" subscript="beam.bot">y</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:id xml:space="preserve">EndSpace</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:real>6</ml:real>
													<ml:id xml:space="preserve">in</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:real>20</ml:real>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
