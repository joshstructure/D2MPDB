				<region region-id="178511" left="6" top="6147" width="417.75" height="108.75" align-x="44.25" align-y="6156" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
