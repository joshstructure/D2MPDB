				<region region-id="178229" left="180" top="1017" width="109.5" height="15" align-x="195.75" align-y="1026" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="fb">f</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve" subscript="bend">ϕ</ml:id>
									<ml:id xml:space="preserve" subscript="fd.stirrup">f</ml:id>
								</ml:apply>
