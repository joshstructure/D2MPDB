									<ml:id xml:space="preserve">a</ml:id>
									<ml:id xml:space="preserve">ShearMethod</ml:id>
								</ml:localDefine>
								<ml:for>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:id xml:space="preserve">last</ml:id>
													<ml:id xml:space="preserve">Location</ml:id>
												</ml:apply>
												<ml:real>2</ml:real>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
									</ml:range>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">a</ml:id>
												<ml:real>1</ml:real>
											</ml:apply>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">θ</ml:id>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="dir">θ</ml:id>
														<ml:id xml:space="preserve">j</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve">deg</ml:id>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
										<ml:ifThen>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">a</ml:id>
												<ml:real>2</ml:real>
											</ml:apply>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">θ</ml:id>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="2">θ</ml:id>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
										<ml:ifThen>
											<ml:apply>
												<ml:equal/>
												<ml:id xml:space="preserve">a</ml:id>
												<ml:real>3</ml:real>
											</ml:apply>
											<ml:localDefine>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">θ</ml:id>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="smooth">θ</ml:id>
														<ml:id xml:space="preserve">j</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve">deg</ml:id>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
									</ml:program>
								</ml:for>
								<ml:id xml:space="preserve">θ</ml:id>
							</ml:program>
						</ml:define>
					</math>
					<rendering item-idref="845"/>
				</region>
