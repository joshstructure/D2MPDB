				<region region-id="174398" left="6" top="5085" width="287.25" height="11.25" align-x="9" align-y="5094" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">If NoGood, more than four strands are terminated in any given section.</p>
					</text>
				</region>
				<region region-id="174399" left="6" top="5115" width="396" height="11.25" align-x="6" align-y="5124" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#efefef" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="0" text-align="inherit" list-style-type="none" tabs="inherit">3.<sp count="2"/>Longitudinal spacing of debonding termination locations shall be at least 60db (3 feet) apart.</p>
					</text>
				</region>
