				<region region-id="150271" left="6" top="333" width="265.5" height="125.25" align-x="72.75" align-y="342" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffc6c6" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="e">f_b</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">category</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">category</ml:id>
										<ml:str xml:space="preserve">I-Beam</ml:str>
									</ml:apply>
									<ml:localDefine>
										<ml:id xml:space="preserve">be</ml:id>
