			<area is-collapsed="true" name="Botom Longitudinal Reinf. (LRFD 5.7.3.5)" show-name="true" show-border="false" show-icon="true" show-timestamp="true" allow-expand="false" is-locked="false" timestamp="" top-lock-id="30776" bottom-lock-id="30778">
				<region region-id="145539" left="6" top="30.75" width="162" height="14.25" align-x="6" align-y="42" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
