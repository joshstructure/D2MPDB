				<region region-id="201298" left="6" top="5637" width="481.5" height="81" align-x="102" align-y="5646" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="splitting.Ubeam">CheckD/C</ml:id>
							<ml:program>
								<ml:localDefine>
									<ml:id xml:space="preserve">chk</ml:id>
									<ml:str xml:space="preserve">N/A</ml:str>
								</ml:localDefine>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:id xml:space="preserve">substr</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:real>0</ml:real>
												<ml:real>3</ml:real>
											</ml:sequence>
										</ml:apply>
										<ml:str xml:space="preserve">FUB</ml:str>
									</ml:apply>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:mult/>
												<ml:parens>
													<ml:apply>
														<ml:lessThan/>
														<ml:id xml:space="preserve" subscript="splitting.LRFD.Ubeam.horiz">D/C</ml:id>
														<ml:real>1.0</ml:real>
													</ml:apply>
												</ml:parens>
												<ml:parens>
													<ml:apply>
														<ml:lessThan/>
														<ml:id xml:space="preserve" subscript="splitting.LRFD.Ubeam.vert">D/C</ml:id>
														<ml:real>1.0</ml:real>
													</ml:apply>
												</ml:parens>
											</ml:apply>
											<ml:localDefine>
												<ml:id xml:space="preserve">chk</ml:id>
												<ml:str xml:space="preserve">OK</ml:str>
											</ml:localDefine>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:id xml:space="preserve">chk</ml:id>
												<ml:str xml:space="preserve">No Good</ml:str>
											</ml:localDefine>
										</ml:otherwise>
									</ml:program>
								</ml:ifThen>
								<ml:id xml:space="preserve">chk</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="201304" left="354" top="5733" width="135.75" height="15" align-x="448.5" align-y="5742" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ffff80" tag="">
