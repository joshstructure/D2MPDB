							</ml:apply>
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:plus/>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="tr">A</ml:id>
											<ml:sequence>
												<ml:real>0</ml:real>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:sequence>
										</ml:apply>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="prestress.fin">M</ml:id>
											<ml:id xml:space="preserve">n</ml:id>
										</ml:apply>
