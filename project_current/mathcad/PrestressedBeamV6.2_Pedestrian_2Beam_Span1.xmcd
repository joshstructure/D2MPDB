				<region region-id="132184" left="6" top="1035" width="408" height="147" align-x="22.5" align-y="1044" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="p">V</ml:id>
							<ml:program>
								<ml:for>
									<ml:id xml:space="preserve">j</ml:id>
									<ml:range>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:id xml:space="preserve">last</ml:id>
											<ml:id xml:space="preserve">PercentTransfer</ml:id>
										</ml:apply>
									</ml:range>
									<ml:program>
										<ml:for>
											<ml:id xml:space="preserve">i</ml:id>
											<ml:range>
												<ml:real>0</ml:real>
												<ml:apply>
													<ml:id xml:space="preserve">last</ml:id>
													<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
												</ml:apply>
											</ml:range>
											<ml:program>
												<ml:ifThen>
													<ml:apply>
														<ml:notEqual/>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">i</ml:id>
																<ml:apply>
																	<ml:plus/>
																	<ml:id xml:space="preserve">j</ml:id>
																	<ml:real>1</ml:real>
																</ml:apply>
															</ml:sequence>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
															<ml:sequence>
																<ml:id xml:space="preserve">i</ml:id>
																<ml:id xml:space="preserve">j</ml:id>
															</ml:sequence>
														</ml:apply>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Vp</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:apply>
																<ml:mult/>
																<ml:id xml:space="preserve" subscript="pe">f</ml:id>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
																	<ml:id xml:space="preserve">i</ml:id>
																</ml:apply>
															</ml:apply>
															<ml:parens>
																<ml:apply>
																	<ml:div/>
																	<ml:apply>
																		<ml:minus/>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
																			<ml:sequence>
																				<ml:id xml:space="preserve">i</ml:id>
																				<ml:real>0</ml:real>
																			</ml:sequence>
																		</ml:apply>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
																			<ml:sequence>
																				<ml:id xml:space="preserve">i</ml:id>
																				<ml:real>1</ml:real>
																			</ml:sequence>
																		</ml:apply>
																	</ml:apply>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve">Location</ml:id>
																		<ml:real>1</ml:real>
																	</ml:apply>
																</ml:apply>
															</ml:parens>
														</ml:apply>
													</ml:localDefine>
												</ml:ifThen>
												<ml:otherwise>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Vp</ml:id>
															<ml:id xml:space="preserve">i</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:mult/>
															<ml:real>0</ml:real>
															<ml:id xml:space="preserve">kip</ml:id>
														</ml:apply>
													</ml:localDefine>
												</ml:otherwise>
											</ml:program>
										</ml:for>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="p">V</ml:id>
												<ml:id xml:space="preserve">j</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:vectorSum/>
												<ml:id xml:space="preserve">Vp</ml:id>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:for>
								<ml:id xml:space="preserve" subscript="p">V</ml:id>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="132162" left="6" top="1203" width="129.75" height="18.75" align-x="29.25" align-y="1212" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
