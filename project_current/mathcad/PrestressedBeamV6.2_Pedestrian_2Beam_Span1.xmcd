				<region region-id="176801" left="6" top="344.25" width="432" height="27.75" align-x="6" align-y="354" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<region region-id="276" left="6" top="345" width="9" height="15" align-x="9.75" align-y="354" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
								<math optimize="false" disable-calc="false">
									<ml:id xml:space="preserve" subscript="b" xmlns:ml="http://schemas.mathsoft.com/math30">c</ml:id>
								</math>
							</region> =<sp count="2"/>the smaller of the distance from center of bar or wire being developed to the nearest concrete surface and one half the center-to-center spacing of the bars or wires being developed</p>
					</text>
				</region>
