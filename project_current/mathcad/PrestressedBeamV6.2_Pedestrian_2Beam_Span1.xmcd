										<ml:id xml:space="preserve">t</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:pow/>
									<ml:id xml:space="preserve" subscript="j">t</ml:id>
									<ml:real>-0.118</ml:real>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
