				</region>
				<region region-id="186103" left="6" top="2997" width="229.5" height="12.75" align-x="93" align-y="3006" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve">BarSizeLongEndBot</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">str2num</ml:id>
									<ml:id xml:space="preserve">inpBarSizeEndBot</ml:id>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:real>0</ml:real>
								</result>
							</ml:eval>
