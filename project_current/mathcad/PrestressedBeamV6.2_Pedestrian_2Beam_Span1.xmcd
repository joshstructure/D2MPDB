				<region region-id="178495" left="6" top="1509" width="423.75" height="18.75" align-x="52.5" align-y="1518" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80c0" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="web.SerIII">τ</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:or/>
										<ml:apply>
											<ml:lessThan/>
											<ml:apply>
												<ml:lessThan/>
												<ml:real>0</ml:real>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve">ishear</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:lessThan/>
											<ml:apply>
												<ml:lessThan/>
												<ml:apply>
													<ml:minus/>
