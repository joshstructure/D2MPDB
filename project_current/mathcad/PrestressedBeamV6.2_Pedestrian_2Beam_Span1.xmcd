				<region region-id="93071" left="6" top="6923.25" width="358.5" height="18.75" align-x="66" align-y="6932.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#f00" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="live.StrengthII">V</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:absval/>
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:greaterThan/>
