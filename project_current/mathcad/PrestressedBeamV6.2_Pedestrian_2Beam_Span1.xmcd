				<region region-id="128605" left="6" top="291" width="273" height="18.75" align-x="37.5" align-y="300" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="vmin">d</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:lessThan/>
										<ml:apply>
											<ml:mult/>
											<ml:real>0.9</ml:real>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="e">d</ml:id>
												<ml:id xml:space="preserve">n</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:real>0.72</ml:real>
											<ml:apply>
												<ml:absval/>
												<ml:id xml:space="preserve" subscript="beam.bot">y</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>0.72</ml:real>
										<ml:apply>
											<ml:absval/>
											<ml:id xml:space="preserve" subscript="beam.bot">y</ml:id>
										</ml:apply>
									</ml:apply>
