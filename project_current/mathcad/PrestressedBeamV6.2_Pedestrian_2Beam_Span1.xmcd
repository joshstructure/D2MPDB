					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="truck">M</ml:id>
								<ml:id xml:space="preserve">nt</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve" subscript="ll">M</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">a</ml:id>
									<ml:id xml:space="preserve">b</ml:id>
									<ml:parens>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve" subscript="beam">L</ml:id>
											<ml:id xml:space="preserve">ft</ml:id>
										</ml:apply>
									</ml:parens>
