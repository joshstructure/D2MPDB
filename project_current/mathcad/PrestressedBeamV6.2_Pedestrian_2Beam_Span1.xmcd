				</region>
				<region region-id="176254" left="6" top="618" width="290.25" height="32.25" align-x="66" align-y="636" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="nh.reqd">CheckV</ml:id>
							<ml:eval placeholderMultiplicationStyle="default">
								<ml:apply>
									<ml:id xml:space="preserve">if</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:lessThan/>
											<ml:apply>
												<ml:id xml:space="preserve">max</ml:id>
												<ml:apply>
													<ml:div/>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve" subscript="nh.reqd">V</ml:id>
														<ml:id xml:space="preserve">ft</ml:id>
													</ml:apply>
													<ml:id xml:space="preserve" subscript="nh.max">V</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:real>1</ml:real>
										</ml:apply>
										<ml:str xml:space="preserve">OK</ml:str>
										<ml:str xml:space="preserve">No Good</ml:str>
									</ml:sequence>
								</ml:apply>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<ml:str xml:space="preserve">OK</ml:str>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="176255" left="6" top="663" width="307.5" height="15" align-x="66" align-y="672" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define warning="WarnRedefinedUDScalar" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="nh.reqd">CheckV</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:id xml:space="preserve">substr</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:real>0</ml:real>
												<ml:real>3</ml:real>
											</ml:sequence>
										</ml:apply>
										<ml:str xml:space="preserve">FLT</ml:str>
									</ml:apply>
									<ml:str xml:space="preserve">N.A.</ml:str>
									<ml:id xml:space="preserve" subscript="nh.reqd">CheckV</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="176256" left="378" top="663" width="96" height="15" align-x="436.5" align-y="672" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="nh.reqd">CheckV</ml:id>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:str xml:space="preserve">OK</ml:str>
							</result>
						</ml:eval>
					</math>
				</region>
				<region region-id="176257" left="6" top="705" width="368.25" height="11.25" align-x="6" align-y="714" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">the minimum reinforcement requirement may be waived if Vu/Acv is less than 0.21 ksi</p>
					</text>
				</region>
				<region region-id="176258" left="366" top="705" width="71.25" height="11.25" align-x="366" align-y="714" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="LRFD" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">(LRFD 5.7.4.2)</p>
					</text>
				</region>
				<region region-id="176259" left="6" top="722.25" width="209.25" height="36" align-x="61.5" align-y="744" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="vf.min.reqd">A</ml:id>
								<ml:id xml:space="preserve">hs</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:lessThan/>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="uh">V</ml:id>
												<ml:id xml:space="preserve">hs</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve" subscript="cv">A</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:real>0.21</ml:real>
											<ml:id xml:space="preserve">ksi</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:str xml:space="preserve">No</ml:str>
									<ml:str xml:space="preserve">Yes</ml:str>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="176260" left="6" top="771" width="298.5" height="18.75" align-x="61.5" align-y="780" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="vf.min.reqd">A</ml:id>
								<ml:id xml:space="preserve">hs</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:id xml:space="preserve">substr</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:real>0</ml:real>
												<ml:real>3</ml:real>
											</ml:sequence>
										</ml:apply>
										<ml:str xml:space="preserve">FLT</ml:str>
									</ml:apply>
									<ml:str xml:space="preserve">N.A.</ml:str>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve" subscript="vf.min.reqd">A</ml:id>
										<ml:id xml:space="preserve">hs</ml:id>
									</ml:apply>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="176261" left="6" top="801" width="210.75" height="11.25" align-x="6" align-y="810" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">Minimum interface reinforcement, if required </p>
					</text>
				</region>
				<region region-id="176262" left="6" top="830.25" width="434.25" height="36" align-x="72.75" align-y="852" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="vf.min.required">A</ml:id>
								<ml:id xml:space="preserve">hs</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="vf.min.reqd">A</ml:id>
											<ml:id xml:space="preserve">hs</ml:id>
										</ml:apply>
										<ml:str xml:space="preserve">Yes</ml:str>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve" font="1">min</ml:id>
										<ml:sequence>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:mult/>
													<ml:real font="0">0.05</ml:real>
													<ml:id xml:space="preserve" subscript="cv">A</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:div/>
													<ml:id xml:space="preserve">ksi</ml:id>
													<ml:id xml:space="preserve" subscript="y.d.stirrup">f</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:minus/>
													<ml:apply>
														<ml:mult/>
														<ml:real>1.33</ml:real>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve" subscript="nh.reqd">V</ml:id>
															<ml:id xml:space="preserve">hs</ml:id>
														</ml:apply>
													</ml:apply>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve">c</ml:id>
														<ml:id xml:space="preserve" subscript="cv">A</ml:id>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:id xml:space="preserve">μ</ml:id>
													<ml:id xml:space="preserve" subscript="y.d.stirrup">f</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:sequence>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:real>0</ml:real>
										<ml:apply>
											<ml:div/>
											<ml:apply>
												<ml:pow/>
												<ml:id xml:space="preserve">in</ml:id>
												<ml:real>2</ml:real>
											</ml:apply>
											<ml:id xml:space="preserve">ft</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:sequence>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="184286" left="414" top="836.25" width="111" height="33.75" align-x="495" align-y="858" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
