													<ml:id xml:space="preserve" subscript="comp">y</ml:id>
												</ml:apply>
											</ml:parens>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<ml:unitOverride>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve">in</ml:id>
										<ml:real>4</ml:real>
									</ml:apply>
								</ml:unitOverride>
								<result xmlns="http://schemas.mathsoft.com/math30">
									<unitedValue>
										<ml:real>281383.30943217425</ml:real>
										<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
											<unitReference unit="inch" power-numerator="4"/>
										</unitMonomial>
									</unitedValue>
								</result>
							</ml:eval>
						</ml:define>
					</math>
				</region>
				<region region-id="149621" left="6" top="3330.75" width="181.5" height="14.25" align-x="6" align-y="3342" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="heading" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">
							<f size="12">
								<b>Approximate Prestress Losses </b>
							</f>
						</p>
					</text>
				</region>
				<region region-id="150894" left="6" top="3357" width="93.75" height="15" align-x="31.5" align-y="3366" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:equal/>
							<ml:id xml:space="preserve" subscript="pT">Δf</ml:id>
							<ml:apply>
								<ml:plus/>
								<ml:id xml:space="preserve" subscript="pES">Δf</ml:id>
								<ml:id xml:space="preserve" subscript="pLT">Δf</ml:id>
							</ml:apply>
						</ml:apply>
					</math>
				</region>
				<region region-id="150896" left="120" top="3357" width="81" height="11.25" align-x="120" align-y="3366" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">governing equation</p>
					</text>
				</region>
				<region region-id="140871" left="6" top="3381" width="136.5" height="11.25" align-x="13.5" align-y="3390" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="false">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">The loss due to elastic shortening</p>
					</text>
				</region>
				<region region-id="146964" left="6" top="3411" width="387.75" height="11.25" align-x="6" align-y="3420" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">estimate stress in strand after transfer (assume 5% of jacking for elastic shortening loss)</p>
					</text>
				</region>
				<region region-id="146965" left="402" top="3411" width="74.25" height="15" align-x="438.75" align-y="3420" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:mult/>
								<ml:id xml:space="preserve" subscript="pj">f</ml:id>
								<ml:parens>
									<ml:real>.05</ml:real>
								</ml:parens>
							</ml:apply>
							<ml:unitOverride>
								<ml:id xml:space="preserve">ksi</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>10.125</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="kips_per_sq_inch"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="1" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="146966" left="6" top="3435" width="105.75" height="15" align-x="69" align-y="3444" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="p.release.estimate">f</ml:id>
							<ml:apply>
								<ml:mult/>
								<ml:real>0.95</ml:real>
								<ml:id xml:space="preserve" subscript="pj">f</ml:id>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="174164" left="354" top="3441" width="103.5" height="15" align-x="415.5" align-y="3450" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="p.release.estimate">f</ml:id>
							<ml:unitOverride>
								<ml:id xml:space="preserve">ksi</ml:id>
							</ml:unitOverride>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<unitedValue>
									<ml:real>192.375</ml:real>
									<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
										<unitReference unit="kips_per_sq_inch"/>
									</unitMonomial>
								</unitedValue>
							</result>
						</ml:eval>
						<resultFormat numeric-only="true">
							<general precision="1" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i" exponential-threshold="4"/>
							<matrix display-style="auto" expand-nested-arrays="false"/>
							<unit format-units="false" simplify-units="false" fractional-unit-exponent="false"/>
						</resultFormat>
					</math>
				</region>
				<region region-id="146968" left="6" top="3471" width="395.25" height="189.75" align-x="106.5" align-y="3480" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve">StrandTrans</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve">trans</ml:id>
									<ml:id xml:space="preserve">loc</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:lessOrEqual/>
										<ml:id xml:space="preserve">loc</ml:id>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">trans</ml:id>
											<ml:real>0</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:real>0</ml:real>
								</ml:ifThen>
								<ml:otherwise>
									<ml:program>
										<ml:ifThen>
											<ml:apply>
												<ml:greaterOrEqual/>
												<ml:id xml:space="preserve">loc</ml:id>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">trans</ml:id>
													<ml:real>3</ml:real>
												</ml:apply>
											</ml:apply>
											<ml:real>0</ml:real>
										</ml:ifThen>
										<ml:otherwise>
											<ml:program>
												<ml:ifThen>
													<ml:apply>
														<ml:mult/>
														<ml:parens>
															<ml:apply>
																<ml:greaterThan/>
																<ml:id xml:space="preserve">loc</ml:id>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">trans</ml:id>
																	<ml:real>0</ml:real>
																</ml:apply>
															</ml:apply>
														</ml:parens>
														<ml:parens>
															<ml:apply>
																<ml:lessThan/>
																<ml:id xml:space="preserve">loc</ml:id>
																<ml:apply>
																	<ml:indexer/>
																	<ml:id xml:space="preserve">trans</ml:id>
																	<ml:real>1</ml:real>
																</ml:apply>
															</ml:apply>
														</ml:parens>
													</ml:apply>
													<ml:apply>
														<ml:div/>
														<ml:apply>
															<ml:minus/>
															<ml:id xml:space="preserve">loc</ml:id>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">trans</ml:id>
																<ml:real>0</ml:real>
															</ml:apply>
														</ml:apply>
														<ml:apply>
															<ml:minus/>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">trans</ml:id>
																<ml:real>1</ml:real>
															</ml:apply>
															<ml:apply>
																<ml:indexer/>
																<ml:id xml:space="preserve">trans</ml:id>
																<ml:real>0</ml:real>
															</ml:apply>
														</ml:apply>
													</ml:apply>
												</ml:ifThen>
												<ml:otherwise>
													<ml:program>
														<ml:ifThen>
															<ml:apply>
																<ml:mult/>
																<ml:parens>
																	<ml:apply>
																		<ml:greaterThan/>
																		<ml:id xml:space="preserve">loc</ml:id>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve">trans</ml:id>
																			<ml:real>2</ml:real>
																		</ml:apply>
																	</ml:apply>
																</ml:parens>
																<ml:parens>
																	<ml:apply>
																		<ml:lessThan/>
																		<ml:id xml:space="preserve">loc</ml:id>
																		<ml:apply>
																			<ml:indexer/>
																			<ml:id xml:space="preserve">trans</ml:id>
																			<ml:real>3</ml:real>
																		</ml:apply>
																	</ml:apply>
																</ml:parens>
															</ml:apply>
															<ml:apply>
																<ml:div/>
																<ml:apply>
																	<ml:minus/>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve">trans</ml:id>
																		<ml:real>3</ml:real>
																	</ml:apply>
																	<ml:id xml:space="preserve">loc</ml:id>
																</ml:apply>
																<ml:apply>
																	<ml:minus/>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve">trans</ml:id>
																		<ml:real>3</ml:real>
																	</ml:apply>
																	<ml:apply>
																		<ml:indexer/>
																		<ml:id xml:space="preserve">trans</ml:id>
																		<ml:real>2</ml:real>
																	</ml:apply>
																</ml:apply>
															</ml:apply>
														</ml:ifThen>
														<ml:otherwise>
															<ml:real>1</ml:real>
														</ml:otherwise>
													</ml:program>
												</ml:otherwise>
											</ml:program>
										</ml:otherwise>
									</ml:program>
								</ml:otherwise>
							</ml:program>
						</ml:define>
					</math>
				</region>
				<region region-id="146969" left="6" top="3675" width="357" height="18.75" align-x="155.25" align-y="3684" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve">PrestressReleaseStressEstimate</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">pi</ml:id>
									<ml:id xml:space="preserve">n</ml:id>
								</ml:sequence>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:id xml:space="preserve" subscript="p.release.estimate">f</ml:id>
								<ml:apply>
									<ml:id xml:space="preserve">StrandTrans</ml:id>
									<ml:sequence>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve" subscript="transfer">L</ml:id>
											<ml:id xml:space="preserve">pi</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">Location</ml:id>
											<ml:id xml:space="preserve">n</ml:id>
										</ml:apply>
									</ml:sequence>
								</ml:apply>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="146970" left="6" top="3699" width="287.25" height="11.25" align-x="6" align-y="3708" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="0" margin-right="0" text-indent="0" text-align="left" list-style-type="none" tabs="inherit">estimate moment and axial force about the top of beam at release</p>
					</text>
				</region>
				<region region-id="146971" left="6" top="3720.75" width="322.5" height="32.25" align-x="52.5" align-y="3732" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="ps.rel.est">M</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:summation/>
								<ml:lambda>
									<ml:boundVars>
										<ml:id xml:space="preserve">pi</ml:id>
									</ml:boundVars>
									<ml:parens>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">PrestressReleaseStressEstimate</ml:id>
													<ml:sequence>
														<ml:id xml:space="preserve">pi</ml:id>
														<ml:id xml:space="preserve">n</ml:id>
													</ml:sequence>
												</ml:apply>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
													<ml:id xml:space="preserve">pi</ml:id>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve" subscript="ps.group">d</ml:id>
												<ml:sequence>
													<ml:id xml:space="preserve">pi</ml:id>
													<ml:id xml:space="preserve">n</ml:id>
												</ml:sequence>
											</ml:apply>
										</ml:apply>
									</ml:parens>
								</ml:lambda>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="146972" left="6" top="3762.75" width="279.75" height="32.25" align-x="51" align-y="3774" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="ps.rel.est">N</ml:id>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:neg/>
								<ml:parens>
									<ml:apply>
										<ml:summation/>
										<ml:lambda>
											<ml:boundVars>
												<ml:id xml:space="preserve">pi</ml:id>
											</ml:boundVars>
											<ml:parens>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">PrestressReleaseStressEstimate</ml:id>
														<ml:sequence>
															<ml:id xml:space="preserve">pi</ml:id>
															<ml:id xml:space="preserve">n</ml:id>
														</ml:sequence>
													</ml:apply>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve" subscript="ps.group">A</ml:id>
														<ml:id xml:space="preserve">pi</ml:id>
													</ml:apply>
												</ml:apply>
											</ml:parens>
										</ml:lambda>
									</ml:apply>
								</ml:parens>
							</ml:apply>
						</ml:define>
					</math>
				</region>
				<region region-id="146973" left="6" top="3813" width="138" height="11.25" align-x="6" align-y="3822" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
