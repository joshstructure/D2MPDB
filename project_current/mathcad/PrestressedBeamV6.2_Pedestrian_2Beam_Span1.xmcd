														<ml:real>0</ml:real>
														<ml:real>3</ml:real>
													</ml:sequence>
												</ml:apply>
												<ml:str xml:space="preserve">FDT</ml:str>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:div/>
											<ml:id xml:space="preserve" subscript="beam">h</ml:id>
											<ml:real>8</ml:real>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve">max</ml:id>
											<ml:sequence>
												<ml:apply>
													<ml:mult style="auto-select"/>
													<ml:real>10</ml:real>
													<ml:id xml:space="preserve">in</ml:id>
												</ml:apply>
												<ml:apply>
													<ml:div/>
													<ml:id xml:space="preserve" subscript="beam">h</ml:id>
													<ml:real>8</ml:real>
												</ml:apply>
											</ml:sequence>
										</ml:apply>
									</ml:sequence>
								</ml:apply>
								<ml:unitOverride>
									<ml:id xml:space="preserve">in</ml:id>
