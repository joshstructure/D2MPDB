														<ml:id xml:space="preserve" subscript="dist">b</ml:id>
														<ml:apply>
															<ml:mult style="auto-select"/>
															<ml:real>48</ml:real>
															<ml:id xml:space="preserve">in</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:apply>
											</ml:localDefine>
										</ml:ifThen>
										<ml:otherwise>
											<ml:localDefine>
												<ml:id xml:space="preserve">gshr</ml:id>
												<ml:apply>
													<ml:mult/>
													<ml:apply>
														<ml:mult/>
														<ml:apply>
															<ml:pow/>
															<ml:parens>
																<ml:apply>
																	<ml:div/>
																	<ml:apply>
																		<ml:div/>
																		<ml:id xml:space="preserve" subscript="dist">b</ml:id>
																		<ml:id xml:space="preserve">in</ml:id>
																	</ml:apply>
																	<ml:real>156</ml:real>
																</ml:apply>
															</ml:parens>
															<ml:real>0.4</ml:real>
														</ml:apply>
														<ml:apply>
															<ml:pow/>
															<ml:parens>
																<ml:apply>
																	<ml:div/>
																	<ml:id xml:space="preserve" subscript="dist">b</ml:id>
																	<ml:id xml:space="preserve" subscript="s">L</ml:id>
																</ml:apply>
															</ml:parens>
															<ml:real>0.1</ml:real>
														</ml:apply>
													</ml:apply>
													<ml:apply>
														<ml:pow/>
														<ml:parens>
															<ml:apply>
																<ml:div/>
																<ml:id xml:space="preserve" subscript="dist">I</ml:id>
																<ml:id xml:space="preserve" subscript="dist">J</ml:id>
															</ml:apply>
														</ml:parens>
														<ml:real>0.05</ml:real>
													</ml:apply>
												</ml:apply>
											</ml:localDefine>
										</ml:otherwise>
