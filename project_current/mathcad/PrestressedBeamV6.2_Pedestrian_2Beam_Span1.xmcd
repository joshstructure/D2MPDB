				<region region-id="188342" left="294" top="134.25" width="192.75" height="33.75" align-x="311.25" align-y="150" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff80ff" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:id xml:space="preserve" subscript="2">K</ml:id>
							<ml:apply>
								<ml:id xml:space="preserve">if</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:lessOrEqual/>
										<ml:id xml:space="preserve" subscript="beam">γ</ml:id>
										<ml:apply>
											<ml:mult/>
