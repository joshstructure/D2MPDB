				<region region-id="144423" left="60" top="6159.75" width="93" height="95.25" align-x="122.25" align-y="6210" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
