					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="se">ε</ml:id>
								<ml:id xml:space="preserve">pn</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">f_εse</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="p">E</ml:id>
										<ml:id xml:space="preserve">ksi</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve" subscript="pe">f</ml:id>
										<ml:id xml:space="preserve">ksi</ml:id>
									</ml:apply>
									<ml:apply>
