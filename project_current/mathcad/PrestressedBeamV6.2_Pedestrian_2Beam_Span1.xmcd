				<region region-id="141564" left="6" top="1521" width="240" height="95.25" align-x="45" align-y="1530" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:indexer/>
								<ml:id xml:space="preserve" subscript="ss.Ser1">f</ml:id>
								<ml:id xml:space="preserve">hs</ml:id>
							</ml:apply>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:id xml:space="preserve">substr</ml:id>
											<ml:sequence>
												<ml:id xml:space="preserve">BeamType</ml:id>
												<ml:real>0</ml:real>
												<ml:real>3</ml:real>
											</ml:sequence>
										</ml:apply>
