				<region region-id="188036" left="120" top="14214.75" width="181.5" height="46.5" align-x="154.5" align-y="14240.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="#ff8080" tag="">
					<math optimize="false" disable-calc="true">
						<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:function>
								<ml:id xml:space="preserve" subscript="c">fw</ml:id>
								<ml:boundVars>
									<ml:id xml:space="preserve" subscript="c">f</ml:id>
								</ml:boundVars>
							</ml:function>
							<ml:apply>
								<ml:id xml:space="preserve">max</ml:id>
								<ml:apply>
									<ml:mult/>
									<ml:matrix rows="2" cols="1">
										<ml:real>0.145</ml:real>
										<ml:apply>
											<ml:plus/>
											<ml:real>0.140</ml:real>
											<ml:apply>
												<ml:mult/>
												<ml:real>0.001</ml:real>
												<ml:apply>
													<ml:div/>
													<ml:id xml:space="preserve" subscript="c">f</ml:id>
													<ml:id xml:space="preserve">ksi</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:apply>
									</ml:matrix>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve">kip</ml:id>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve">ft</ml:id>
											<ml:real>3</ml:real>
										</ml:apply>
