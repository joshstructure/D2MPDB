  </embed><table name="FWContentBox9" capture="False" colwidths="1:520">
                <stylerule range="A1:A2" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);"/>
                <stylerule range="A1" background="#DCE7F3" fontweight="bold"/>
                <row>
                    <textcell name="FWBox9Row1" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">TRIBUTARY LENGTH — TWO SIMPLY SUPPORTED SPANS</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox9Row2" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Assume uniform wind loading along both spans.</paragraph> </textcell> </row>
            </table>
  <table name="FWContentBox20" capture="False" colwidths="1:520">
                <stylerule range="A1" background="#F7E6B9" fontweight="bold" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#A78638&quot;);"/>
                <row>
                    <textcell capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" fontweight="bold" spacingbefore="8">LIVE GEOMETRY INPUTS</paragraph> </textcell> </row>
            </table>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C" fontweight="bold" keepwithnext="True">Geometry input route</paragraph><embed spacingbefore="5" spacingafter="8"><table name="FWGeometryInputs" capture="False" colwidths="1:180, 2:180, 3:180"><stylerule range="A1:C6" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/><stylerule range="A1:C1" horzalign="Center" vertalign="Center"/><stylerule range="B2:C6" horzalign="Center" vertalign="Center"/><row><textcell name="FWGeometryInputsR0C0" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Parameter</paragraph></textcell><textcell name="FWGeometryInputsR0C1" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Value</paragraph></textcell><textcell name="FWGeometryInputsR0C2" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Source / meaning</paragraph></textcell></row><row><textcell name="FWGeometryInputsR1C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">h_f</paragraph></textcell><c formula="h_f to in" capture="False" background="#EFF7F1"><num>116.312 in</num></c><textcell name="FWGeometryInputsR1C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">BridgeGeometry.Fence_ht; exposed fence height</paragraph></textcell></row><row><textcell name="FWGeometryInputsR2C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">R_f</paragraph></textcell><c formula="R_f to in" capture="False" background="#EFF7F1"><num>76.000 in</num></c><textcell name="FWGeometryInputsR2C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">Inside parapet spacing and parapet width</paragraph></textcell></row><row><textcell name="FWGeometryInputsR3C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">z_base</paragraph></textcell><c formula="z_base to in" capture="False" background="#EFF7F1"><num>111.562 in</num></c><textcell name="FWGeometryInputsR3C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">Concrete wind centroid + half concrete depth</paragraph></textcell></row><row><textcell name="FWGeometryInputsR4C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">z_mid</paragraph></textcell><c formula="z_mid to in" capture="False" background="#EFF7F1"><num>169.719 in</num></c><textcell name="FWGeometryInputsR4C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">Fence projected-height midpoint</paragraph></textcell></row><row><textcell name="FWGeometryInputsR5C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">L_trib</paragraph></textcell><c formula="L_trib to in" capture="False" background="#EFF7F1"><num>1273.500 in</num></c><textcell name="FWGeometryInputsR5C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">BridgeGeometry.TotalSpan / 2</paragraph></textcell></row></table></embed><section name="FWStrategyWork03" capture="False" hide="false"><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" id="paragraphfwstrategywork03">Step 3. Prescribed LRFD 13.8.2 fence load</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8"> Use the prescribed LRFD 13.8.2 gross-surface pressure to form one fence resultant for the pier tributary length. </paragraph> <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="8" textcolor="#43556B"> Code basis: LRFD 13.8.2 </paragraph> </section><table name="FWSectionIntro3" title="Section introduction" capture="False" colwidths="1:90, 2:430">
                <stylerule range="A1:B3" background="#EDF3F8" fontfamily="Times New Roman" fontsize="10" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#1766A0&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 1, &quot;#CCD9E5&quot;);"/>
                <stylerule range="A1:A3" fontweight="bold"/>
                <row>
                    <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Objective</paragraph></textcell> <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Calculate the prescribed fence resultant.</paragraph></textcell> </row>
                <row>
                    <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Inputs</paragraph></textcell> <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Fence geometry; LRFD 13.8.2 pressure; tributary length.</paragraph></textcell> </row>
                <row>
                    <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Output</paragraph></textcell> <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">One fence force, one fence moment, zero net vertical force, and an equivalent force height.</paragraph></textcell> </row>
                <stylerule range="A1:B1" background="#F1F5FA"/>
                <stylerule range="A2:B2" background="#FFF8E9"/>
                <stylerule range="A3:B3" background="#EFF7F1"/>
            </table>
  <embed spacingbefore="4" spacingafter="5"><canvas title="C. LRFD 13.8.2 one-face projected fence load" name="FWPressureSketch" unit="in" size="6.5 in; 3.9 in; scaletofit">
                <include target="Library.Geometry"/>
                <lines pts="0.05000, 0.05000, 0; 6.45000, 0.05000, 0; 6.45000, 3.85000, 0; 0.05000, 3.85000, 0; 0.05000, 0.05000, 0" linecolor="#D7DFE6" linethickness="1.2" linepattern="Solid"/>
                <planecontainer origin="0.18000, 3.63000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="11"><textvalue>Step 3: LRFD 13.8.2 — one wind-exposed projected fence face</textvalue></planecontainer>
                <planecontainer origin="0.18000, 0.16000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#727B84" fontfamily="Times New Roman" fontsize="8"><textvalue>SCHEMATIC - NOT TO SCALE</textvalue></planecontainer>
                <lines pts="0.92000, 0.99000, 0; 0.92000, 1.73000, 0" linecolor="#29333D" linethickness="1.2" linepattern="Solid"/>
                <lines pts="2.42000, 1.73000, 0; 2.41839, 1.77905, 0; 2.41358, 1.82789, 0; 2.40559, 1.87632, 0; 2.39444, 1.92411, 0; 2.38020, 1.97108, 0; 2.36291, 2.01701, 0; 2.34265, 2.06172, 0; 2.31952, 2.10500, 0; 2.29360, 2.14668, 0; 2.26502, 2.18657, 0; 2.23388, 2.22451, 0; 2.20033, 2.26033, 0; 2.16451, 2.29388, 0; 2.12657, 2.32502, 0; 2.08668, 2.35360, 0; 2.04500, 2.37952, 0; 2.00172, 2.40265, 0; 1.95701, 2.42291, 0; 1.91108, 2.44020, 0; 1.86411, 2.45444, 0; 1.81632, 2.46559, 0; 1.76789, 2.47358, 0; 1.71905, 2.47839, 0; 1.67000, 2.48000, 0; 1.62095, 2.47839, 0; 1.57211, 2.47358, 0; 1.52368, 2.46559, 0; 1.47589, 2.45444, 0; 1.42892, 2.44020, 0; 1.38299, 2.42291, 0; 1.33828, 2.40265, 0; 1.29500, 2.37952, 0; 1.25332, 2.35360, 0; 1.21343, 2.32502, 0; 1.17549, 2.29388, 0; 1.13967, 2.26033, 0; 1.10612, 2.22451, 0; 1.07498, 2.18657, 0; 1.04640, 2.14668, 0; 1.02048, 2.10500, 0; 0.99735, 2.06172, 0; 0.97709, 2.01701, 0; 0.95980, 1.97108, 0; 0.94556, 1.92411, 0; 0.93441, 1.87632, 0; 0.92642, 1.82789, 0; 0.92161, 1.77905, 0; 0.92000, 1.73000, 0" linecolor="#29333D" linethickness="1.2" linepattern="Solid"/>
                <lines pts="2.42000, 1.73000, 0; 2.42000, 0.99000, 0" linecolor="#29333D" linethickness="1.2" linepattern="Solid"/>
                <lines pts="0.92000, 1.73000, 0; 2.42000, 1.73000, 0" linecolor="#727B84" linethickness="1.2" linepattern="Dashes"/>
                <arrowlines pts="0.40000, 1.10000, 0; 0.92000, 1.10000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3"/>
                <arrowlines pts="0.40000, 1.40000, 0; 0.92000, 1.40000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3"/>
                <arrowlines pts="0.40000, 1.95000, 0; 0.96000, 1.95000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3"/>
                <arrowlines pts="0.40000, 2.20000, 0; 1.11000, 2.20000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3"/>
                <arrowlines pts="0.40000, 2.39000, 0; 1.31000, 2.39000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3"/>
                <planecontainer origin="0.38000, 2.72000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#C83C32" fontfamily="Times New Roman" fontsize="10"><textvalue>p_fence = 0.015 ksf</textvalue></planecontainer>
                <planecontainer origin="1.00000, 0.69000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#727B84" fontfamily="Times New Roman" fontsize="9"><textvalue>Wind-exposed face</textvalue></planecontainer>
                <arrowlines pts="2.80000, 1.73000, 0; 4.00000, 1.73000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3"/>
                <planecontainer origin="3.10, 1.82, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#C83C32" fontfamily="Times New Roman" fontsize="10"><textvalue>F_fence</textvalue></planecontainer>
                <planecontainer origin="3.05000, 3.05000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="10"><textvalue>GLOBAL BRIDGE-TRANSFER MODEL</textvalue></planecontainer>
                <planecontainer origin="3.05000, 2.65000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="9"><textvalue>• One gross projected face loaded once</textvalue></planecontainer>
                <planecontainer origin="3.05000, 2.35000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="9"><textvalue>• No simultaneous leeward 15 psf load</textvalue></planecontainer>
                <planecontainer origin="3.05000, 2.05000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="9"><textvalue>• Opposite wind direction reverses sign</textvalue></planecontainer>
                <planecontainer origin="3.05000, 1.35000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#1766A0" fontfamily="Times New Roman" fontsize="9"><textvalue>z_eff = z_mid</textvalue></planecontainer>
                <planecontainer origin="3.05000, 1.05000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#727B84" fontfamily="Times New Roman" fontsize="8"><textvalue>Local member/attachment design is separate</textvalue></planecontainer>
            </canvas>
  </embed><table name="FWContentBox6" capture="False" colwidths="1:520">
                <stylerule range="A1:A5" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);"/>
                <stylerule range="A1" background="#DCE7F3" fontweight="bold"/>
                <row>
                    <textcell capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" spacingbefore="8" fontweight="bold">PRESSURE DIRECTIONS</paragraph> </textcell> </row>
                <row>
                    <textcell capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• The 0.015 ksf pressure acts normal to the entire gross fence surface.</paragraph> </textcell> </row>
                <row>
                    <textcell capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• For global bridge transfer, the 0.015 ksf load is applied once to the wind-exposed projected face for the selected wind direction.</paragraph> </textcell> </row>
                <row>
                    <textcell capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• No second simultaneous leeward 15 psf load or leeward reduction factor is used; the opposite wind direction is a sign-reversed case.</paragraph> </textcell> </row>
                <row>
                    <textcell capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Arrow lengths are schematic; the equations below govern the numerical result.</paragraph> </textcell> </row>
            </table>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="p_fence = 0.015 ksf" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>p_fence = 0.015 ksf</expbody><expresult> = 0.015 ksf</expresult></dynexp><break type="tab"/>Prescribed normal pressure on the metal-fabric fence surface (LRFD 13.8.2)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="a_T_fence = h_f to in" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>a_T_fence = h_f to in</expbody><expresult> = 116.312 in</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Gross projected fence height for one wind direction.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="b_M_fence = a_T_fence*z_mid to ft^2" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>b_M_fence = a_T_fence*z_mid to ft^2</expbody><expresult> = 137.086 ft^2</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">First moment of the one-face gross projected fence area about the cap reference.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="z_eff = b_M_fence/a_T_fence to ft" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>z_eff = b_M_fence/a_T_fence to ft</expbody><expresult> = 14.143 ft</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Equivalent height of the transverse fence resultant above the cap reference.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="w_fence = p_fence*a_T_fence to kip/ft" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>w_fence = p_fence*a_T_fence to kip/ft</expbody><expresult> = 0.145 kip/ft</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Horizontal fence force per foot of bridge.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="F_fence = w_fence*L_trib to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>F_fence = w_fence*L_trib to kip</expbody><expresult> = 15.430 kip</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Total transverse fence force delivered to the intermediate pier.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="M_fence = F_fence*z_eff to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>M_fence = F_fence*z_eff to kip*ft</expbody><expresult> = 218.224 kip*ft</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Fence moment about the longitudinal axis through the cap reference.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="F_V_fence = 0*F_fence to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>F_V_fence = 0*F_fence to kip</expbody><expresult> = 0.000 kip</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Vertical fence component in the global projected-load model.</paragraph><table name="FWFenceResultBox" capture="False" colwidths="1:520">
                <stylerule range="A1:A5" background="#EFF7F1" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#6A9075&quot;);"/>
                <stylerule range="A1" background="#DCECE0" fontweight="bold"/>
                <row>
                    <textcell capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" spacingbefore="8" fontweight="bold">PRESCRIBED FENCE RESULTANT</paragraph> </textcell> </row>
                <row>
                    <textcell capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1"> • <dynexp formula="F_fence"> <expbody>F_fence</expbody>
                                <expresult>15.430 kip</expresult></dynexp> transverse at the pier tributary length. </paragraph> </textcell> </row>
                <row>
                    <textcell capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1"> • <dynexp formula="M_fence"> <expbody>M_fence</expbody>
                                <expresult>218.224 kip*ft</expresult></dynexp> bout the cap-reference longitudinal axis. </paragraph> </textcell> </row>
                <row>
                    <textcell capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• z_eff = M_fence / F_fence locates an equivalent single transverse force.</paragraph> </textcell> </row>
                <row>
                    <textcell capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• The same prescribed fence resultant is used in the displayed Strength III and Service I wind sets.</paragraph> </textcell> </row>
            </table>
  <section name="FWStrategyWork04" capture="False" hide="false"><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" id="paragraphfwstrategywork04">Step 4. Simplified superstructure wind components</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8">Combine the concrete superstructure and prescribed fence resultants, verify the simplified-method limits, and form one simultaneous 100% transverse + 25% longitudinal load set for each limit state.</paragraph> <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="8" textcolor="#43556B"> Code basis: LRFD 3.8.1.2.3a; LRFD Table 3.4.1-1 </paragraph> </section><table name="FWSectionIntro4" title="Section introduction" capture="False" colwidths="1: 90, 2: 504.5">
                <stylerule range="A1:B3" background="#EDF3F8" fontfamily="Times New Roman" fontsize="10" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#1766A0&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 1, &quot;#CCD9E5&quot;);"/>
                <stylerule range="A1:A3" fontweight="bold"/>
                <row>
                    <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Objective</paragraph></textcell> <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Use the LRFD simplified girder-bridge wind components in lieu of an angle sweep.</paragraph></textcell> </row>
                <row>
                    <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Inputs</paragraph></textcell> <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Perpendicular bridge/fence resultant; span and height qualification; 100%/25% factors.</paragraph></textcell> </row>
                <row>
                    <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Output</paragraph></textcell> <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">One simultaneous cap-reference T/L force-and-moment set for Strength III and Service I.</paragraph></textcell> </row>
                <stylerule range="A1:B1" background="#F1F5FA"/>
                <stylerule range="A2:B2" background="#FFF8E9"/>
                <stylerule range="A3:B3" background="#EFF7F1"/>
            </table>
  <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True">Concrete and combined perpendicular wind, Strength III</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="P_Z_III = C001WindLoadOnPedBridgeSuperstructure.P_Z_III to ksf" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>P_Z_III = C001WindLoadOnPedBridgeSuperstructure.P_Z_III to ksf</expbody><expresult> = 0.049 ksf</expresult></dynexp><break type="tab"/>shared value — C001WindLoadOnPedBridgeSuperstructure.P_Z_III; Strength III wind pressure on the concrete superstructure (C001)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Depth_SuperStr = BridgeGeometry_2Beam.Depth_SuperStr to in" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>Depth_SuperStr = BridgeGeometry_2Beam.Depth_SuperStr to in</expbody><expresult> = 85.000 in</expresult></dynexp><break type="tab"/>shared value — BridgeGeometry_2Beam.Depth_SuperStr; Depth of the superstructure exposed to wind</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Dist_windSuperCG_CapCG = BridgeGeometry_2Beam.Dist_windSuperCG_CapCG to in" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>Dist_windSuperCG_CapCG = BridgeGeometry_2Beam.Dist_windSuperCG_CapCG to in</expbody><expresult> = 69.062 in</expresult></dynexp><break type="tab"/>shared value — BridgeGeometry_2Beam.Dist_windSuperCG_CapCG; Superstructure wind centroid above the cap reference</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="F_c_III = P_Z_III*Depth_SuperStr*L_trib to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>F_c_III = P_Z_III*Depth_SuperStr*L_trib to kip</expbody><expresult> = 36.646 kip</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Total Strength III concrete superstructure force delivered across the bridge to the pier.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="M_c_III = F_c_III*Dist_windSuperCG_CapCG to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>M_c_III = F_c_III*Dist_windSuperCG_CapCG to kip*ft</expbody><expresult> = 210.904 kip*ft</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength III moment caused by the concrete superstructure force acting above the cap.</paragraph><paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8" id="paragraphrefreturn0023"> <link address="#FenceWind.FWStrategyStep04;paragraphfwstrategy04">STEP 4 OF 7 | Simplified superstructure wind components</link> </paragraph> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="F_cap_T_III = F_c_III + F_fence to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>F_cap_T_III = F_c_III + F_fence to kip</expbody><expresult> = 52.075 kip</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Total across-bridge force at the cap reference: Strength III, LRFD 13.8.2 fence load. (LRFD 13.8.2)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="M_cap_L_III = M_c_III + M_fence to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>M_cap_L_III = M_c_III + M_fence to kip*ft</expbody><expresult> = 429.128 kip*ft</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Total moment about the longitudinal axis at the cap reference: Strength III, LRFD 13.8.2 fence load. (LRFD 13.8.2)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Apply the cap resultants once; do not also reapply the forces at their original heights.</paragraph> <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True">Concrete and combined perpendicular wind, Service I; simplified-method qualification</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Span_1 = BridgeGeometry_2Beam.Span_1 to ft" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>Span_1 = BridgeGeometry_2Beam.Span_1 to ft</expbody><expresult> = 107.350 ft</expresult></dynexp><break type="tab"/>shared value — BridgeGeometry_2Beam.Span_1; Span 1 length</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Span_2 = BridgeGeometry_2Beam.Span_2 to ft" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>Span_2 = BridgeGeometry_2Beam.Span_2 to ft</expbody><expresult> = 104.900 ft</expresult></dynexp><break type="tab"/>shared value — BridgeGeometry_2Beam.Span_2; Span 2 length</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="P_Z_SI = C001WindLoadOnPedBridgeSuperstructure.P_Z_SI to ksf" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>P_Z_SI = C001WindLoadOnPedBridgeSuperstructure.P_Z_SI to ksf</expbody><expresult> = 0.014 ksf</expresult></dynexp><break type="tab"/>shared value — C001WindLoadOnPedBridgeSuperstructure.P_Z_SI; Service I wind pressure on the concrete superstructure (C001)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="H_bridge = BridgeGeometry_2Beam.Concrete_top_aboveGround to in" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>H_bridge = BridgeGeometry_2Beam.Concrete_top_aboveGround to in</expbody><expresult> = 312.478 in</expresult></dynexp><break type="tab"/>shared value — BridgeGeometry_2Beam.Concrete_top_aboveGround; Top of the concrete superstructure above low ground (simplified-method height limit)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="F_c_SI = P_Z_SI*Depth_SuperStr*L_trib to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>F_c_SI = P_Z_SI*Depth_SuperStr*L_trib to kip</expbody><expresult> = 10.420 kip</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Total Service I concrete superstructure force delivered across the bridge to the pier.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="M_c_SI = F_c_SI*Dist_windSuperCG_CapCG to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>M_c_SI = F_c_SI*Dist_windSuperCG_CapCG to kip*ft</expbody><expresult> = 59.967 kip*ft</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Service I moment caused by the concrete superstructure force acting above the cap.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="F_cap_T_SI = F_c_SI + F_fence to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>F_cap_T_SI = F_c_SI + F_fence to kip</expbody><expresult> = 25.849 kip</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Total across-bridge force at the cap reference: Service I, LRFD 13.8.2 fence load. (LRFD 13.8.2)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="M_cap_L_SI = M_c_SI + M_fence to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>M_cap_L_SI = M_c_SI + M_fence to kip*ft</expbody><expresult> = 278.191 kip*ft</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Total moment about the longitudinal axis at the cap reference: Service I, LRFD 13.8.2 fence load. (LRFD 13.8.2)</paragraph><table name="FWContentBox14" capture="False" colwidths="1:520">
                <stylerule range="A1:A4" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);"/>
                <stylerule range="A1" background="#DCE7F3" fontweight="bold"/>
                <row>
                    <textcell name="FWContentBox14Title" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">SIMPLIFIED-METHOD QUALIFICATION</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWContentBox14Row1" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1"> • Use the LRFD 3.8.1.2.3a simplified components only when the individual-span and bridge-height limits are satisfied. </paragraph> </textcell> </row>
                <row>
                    <textcell name="FWContentBox14Row2" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1"> • The height check is taken to the top of the concrete superstructure. The metal-fabric fence remains a separate LRFD 13.8.2 load in this worksheet. </paragraph> </textcell> </row>
                <row>
                    <textcell name="FWContentBox14Row3" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1"> • Direct wind on the pier remains under LRFD 3.8.1.2.3b and is not included in these cap-reference resultants. </paragraph> </textcell> </row>
            </table>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="L_span_max = Max(Span_1, Span_2) to ft" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>L_span_max = Max(Span_1, Span_2) to ft</expbody><expresult> = 107.350 ft</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Maximum individual span used to qualify the LRFD simplified wind method. (LRFD 3.8.1.2.3a)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="DC_span = L_span_max/(150 ft)" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>DC_span = L_span_max/(150 ft)</expbody><expresult> = 0.716</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Individual span length / 150 ft limit of the simplified method (LRFD 3.8.1.2.3a)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="DC_height = H_bridge/(33 ft)" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>DC_height = H_bridge/(33 ft)</expbody><expresult> = 0.789</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Bridge height above low ground / 33 ft limit of the simplified method (LRFD 3.8.1.2.3a)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="Check_simplified = If(And(L_span_max &lt;= 150 ft, H_bridge &lt;= 33 ft), &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>Check_simplified = If(And(L_span_max &lt;= 150 ft, H_bridge &lt;= 33 ft), "✓ PASS", "⊗ FAIL")</expbody><expresult> = ✓ PASS</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Live check that the bridge satisfies both LRFD 3.8.1.2.3a limits for the simplified wind components. (LRFD 3.8.1.2.3a)</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C" fontweight="bold" keepwithnext="True">Simplified-method qualification</paragraph><embed spacingbefore="5" spacingafter="8"><table name="FWSimplifiedCriteria" capture="False" colwidths="1:180, 2:180, 3:180"><stylerule range="A1:C4" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/><stylerule range="A1:C1" horzalign="Center" vertalign="Center"/><stylerule range="B2:C4" horzalign="Center" vertalign="Center"/><row><textcell name="FWSimplifiedCriteriaR0C0" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Criterion</paragraph></textcell><textcell name="FWSimplifiedCriteriaR0C1" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Actual</paragraph></textcell><textcell name="FWSimplifiedCriteriaR0C2" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Result</paragraph></textcell></row><row><textcell name="FWSimplifiedCriteriaR1C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Individual span ≤ 150 ft</paragraph></textcell><c formula="L_span_max to ft" capture="False" background="#EFF7F1"><num>107.350 ft</num></c><c formula="If(L_span_max &lt;= 150 ft, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="FWSimplifiedCriteriaR2C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Bridge height ≤ 33 ft</paragraph></textcell><c formula="H_bridge to in" capture="False" background="#EFF7F1"><num>312.478 in</num></c><c formula="If(H_bridge &lt;= 33 ft, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="FWSimplifiedCriteriaR3C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Overall simplified-method qualification</paragraph></textcell><textcell name="FWSimplifiedCriteriaR3C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">100% T + 25% L</paragraph></textcell><c formula="Check_simplified" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row></table></embed><table name="FWContentBox16" capture="False" colwidths="1:520">
                <stylerule range="A1:A5" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);"/>
                <stylerule range="A1" background="#DCE7F3" fontweight="bold"/>
                <row>
                    <textcell name="FWContentBox16Title" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">SIMULTANEOUS COMPONENT RULE</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWContentBox16Row1" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Transverse component = 100% of the perpendicular-wind cap resultant.</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWContentBox16Row2" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Longitudinal component = 25% of that transverse component.</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWContentBox16Row3" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Apply the transverse and longitudinal components simultaneously; evaluate both horizontal signs with the corresponding moment signs.</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWContentBox16Row4" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Use WS = 1.0 with the matching Strength III or Service I wind set.</paragraph> </textcell> </row>
            </table>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="F_cap_L_III = 0.25*F_cap_T_III to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>F_cap_L_III = 0.25*F_cap_T_III to kip</expbody><expresult> = 13.019 kip</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Simultaneous longitudinal cap force: Strength III simplified wind case. (LRFD 3.8.1.2.3a)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="M_cap_T_III = 0.25*M_c_III + 0.25*F_fence*z_mid to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>M_cap_T_III = 0.25*M_c_III + 0.25*F_fence*z_mid to kip*ft</expbody><expresult> = 107.282 kip*ft</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Moment about the transverse axis associated with the Strength III longitudinal component.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="F_cap_L_SI = 0.25*F_cap_T_SI to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>F_cap_L_SI = 0.25*F_cap_T_SI to kip</expbody><expresult> = 6.462 kip</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Simultaneous longitudinal cap force: Service I simplified wind case.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="M_cap_T_SI = 0.25*M_c_SI + 0.25*F_fence*z_mid to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>M_cap_T_SI = 0.25*M_c_SI + 0.25*F_fence*z_mid to kip*ft</expbody><expresult> = 69.548 kip*ft</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Moment about the transverse axis associated with the Service I longitudinal component.</paragraph><table name="FWConcurrentRules" capture="False" colwidths="1:520">
                <stylerule range="A1:A5" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);"/>
                <stylerule range="A1" background="#DCE7F3" fontweight="bold"/>
                <row>
                    <textcell name="FWConcurrentRulesTitle" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">CONCURRENT SIMPLIFIED LOAD SET</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWConcurrentRulesRow1" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Each limit-state row below is one simultaneous load set at the cap reference.</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWConcurrentRulesRow2" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• F_T and M_L are the full perpendicular-wind resultants.</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWConcurrentRulesRow3" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• F_L is 25% of F_T; M_T is the cap-reference moment from the corresponding 25% longitudinal concrete and fence force components at their adopted load heights.</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWConcurrentRulesRow4" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1"> • Direct pier wind is listed separately in Step 5 and must be applied consistently with LRFD 3.8.1.2.3b. </paragraph> </textcell> </row>
            </table>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C" fontweight="bold" keepwithnext="True">Strength III cap-reference wind — simplified simultaneous case, WS = 1.0</paragraph><embed spacingbefore="5" spacingafter="8"><table name="FWCapIII" capture="False" colwidths="1:108, 2:108, 3:108, 4:108, 5:108"><stylerule range="A1:E2" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/><stylerule range="A1:E1" horzalign="Center" vertalign="Center"/><stylerule range="B2:E2" horzalign="Center" vertalign="Center"/><row><textcell name="FWCapIIIR0C0" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Case</paragraph></textcell><textcell name="FWCapIIIR0C1" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">F_T (kip)</paragraph></textcell><textcell name="FWCapIIIR0C2" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">F_L (kip)</paragraph></textcell><textcell name="FWCapIIIR0C3" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">M_L (kip-ft)</paragraph></textcell><textcell name="FWCapIIIR0C4" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">M_T (kip-ft)</paragraph></textcell></row><row><textcell name="FWCapIIIR1C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Simplified 100% T + 25% L</paragraph></textcell><c formula="F_cap_T_III to kip" capture="False" background="#EFF7F1"><num>52.075 kip</num></c><c formula="F_cap_L_III to kip" capture="False" background="#EFF7F1"><num>13.019 kip</num></c><c formula="M_cap_L_III to kip*ft" capture="False" background="#EFF7F1"><num>429.128 kip*ft</num></c><c formula="M_cap_T_III to kip*ft" capture="False" background="#EFF7F1"><num>107.282 kip*ft</num></c></row></table></embed><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C" fontweight="bold" keepwithnext="True">Service I cap-reference wind — simplified simultaneous case, WS = 1.0</paragraph><embed spacingbefore="5" spacingafter="8"><table name="FWCapSI" capture="False" colwidths="1:108, 2:108, 3:108, 4:108, 5:108"><stylerule range="A1:E2" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/><stylerule range="A1:E1" horzalign="Center" vertalign="Center"/><stylerule range="B2:E2" horzalign="Center" vertalign="Center"/><row><textcell name="FWCapSIR0C0" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Case</paragraph></textcell><textcell name="FWCapSIR0C1" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">F_T (kip)</paragraph></textcell><textcell name="FWCapSIR0C2" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">F_L (kip)</paragraph></textcell><textcell name="FWCapSIR0C3" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">M_L (kip-ft)</paragraph></textcell><textcell name="FWCapSIR0C4" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">M_T (kip-ft)</paragraph></textcell></row><row><textcell name="FWCapSIR1C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Simplified 100% T + 25% L</paragraph></textcell><c formula="F_cap_T_SI to kip" capture="False" background="#EFF7F1"><num>25.849 kip</num></c><c formula="F_cap_L_SI to kip" capture="False" background="#EFF7F1"><num>6.462 kip</num></c><c formula="M_cap_L_SI to kip*ft" capture="False" background="#EFF7F1"><num>278.191 kip*ft</num></c><c formula="M_cap_T_SI to kip*ft" capture="False" background="#EFF7F1"><num>69.548 kip*ft</num></c></row></table></embed><section name="FWStrategyWork05" capture="False" hide="false"><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" id="paragraphfwstrategywork05">Step 5. Wind acting directly on the pier</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8">Calculate the wind pressure and face-normal forces acting directly on the pier. These loads remain separate from the bridge-and-fence cap rows until matched by wind direction.</paragraph> <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="8" textcolor="#43556B"> Code basis: FDOT SDG 2.4.1.A and Table 2.4.1-1; LRFD Eq. 3.8.1.2.1-1; LRFD 3.8.1.2.3b and Commentary C3.8.1.2.3b </paragraph> </section><table name="FWSectionIntro5" title="Section introduction" capture="False" colwidths="1:90, 2:430">
                <stylerule range="A1:B3" background="#EDF3F8" fontfamily="Times New Roman" fontsize="10" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#1766A0&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 1, &quot;#CCD9E5&quot;);"/>
                <stylerule range="A1:A3" fontweight="bold"/>
                <row>
                    <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Objective</paragraph></textcell> <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Determine direct wind on the pier wall and cap.</paragraph></textcell> </row>
                <row>
                    <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Inputs</paragraph></textcell> <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Wind speed; exposure; gust; substructure drag; pier projected areas.</paragraph></textcell> </row>
                <row>
                    <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Output</paragraph></textcell> <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Strength III and Service I direct wall forces.</paragraph></textcell> </row>
                <stylerule range="A1:B1" background="#F1F5FA"/>
                <stylerule range="A2:B2" background="#FFF8E9"/>
                <stylerule range="A3:B3" background="#EFF7F1"/>
            </table>
  <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8" id="paragraphrefreturn0024"> <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link> </paragraph> <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8" id="paragraphrefreturn0025"> <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link> </paragraph> <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" level="1"> FDOT SDG 2.4.1.B requires Category C unless Category D applies. LRFD 3.8.1.2.1 supplies the height-dependent exposure equations. The common fence-crown exposure height is a project modeling choice. </paragraph> <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="8" level="1"> Reference: LRFD 3.8.1.2.1; FDOT SDG 2.4.1.B </paragraph> <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="0" spacingafter="8" textcolor="#43556B"> Code basis: FDOT SDG 2.4.1.B and LRFD 3.8.1.1.5; LRFD 3.8.1.2.1 and Eqs. 3.8.1.2.1-3 and 3.8.1.2.1-4 </paragraph> <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" level="1"> FDOT SDG 2.4.1.C states: “Use 0.85 for all load combinations and all structures”. This replaces the base LRFD gust-factor rule for the bridge wind calculation; the provision’s commentary treats ancillary supports separately. </paragraph> <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="8" level="1"> Reference: FDOT SDG 2.4.1.C </paragraph> <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="0" spacingafter="8" textcolor="#43556B"> Code basis: FDOT SDG 2.4.1.C </paragraph> <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C" fontweight="bold" keepwithnext="True">Wind input summary</paragraph><embed spacingbefore="5" spacingafter="8"><table name="FWWindInputs" capture="False" colwidths="1:180, 2:180, 3:180"><stylerule range="A1:C4" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/><stylerule range="A1:C1" horzalign="Center" vertalign="Center"/><stylerule range="B2:C4" horzalign="Center" vertalign="Center"/><row><textcell name="FWWindInputsR0C0" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Parameter</paragraph></textcell><textcell name="FWWindInputsR0C1" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Strength III</paragraph></textcell><textcell name="FWWindInputsR0C2" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Service I</paragraph></textcell></row><row><textcell name="FWWindInputsR1C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">V (mph)</paragraph></textcell><c formula="V_III" capture="False" background="#EFF7F1"><num>130.000</num></c><c formula="V_SI" capture="False" background="#EFF7F1"><num>70.000</num></c></row><row><textcell name="FWWindInputsR2C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">K_Z</paragraph></textcell><c formula="K_Z_III" capture="False" background="#EFF7F1"><num>1.020</num></c><c formula="K_Z_SI" capture="False" background="#EFF7F1"><num>1.000</num></c></row><row><textcell name="FWWindInputsR3C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">G_f</paragraph></textcell><c formula="G_f" capture="False" background="#EFF7F1"><num>0.850</num></c><c formula="G_f" capture="False" background="#EFF7F1"><num>0.850</num></c></row></table></embed><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="V_III = C001WindLoadOnPedBridgeSuperstructure.V_III" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>V_III = C001WindLoadOnPedBridgeSuperstructure.V_III</expbody><expresult> = 130.000</expresult></dynexp><break type="tab"/>shared value — C001WindLoadOnPedBridgeSuperstructure.V_III; Strength III wind speed (mph, C001)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="V_SI = C001WindLoadOnPedBridgeSuperstructure.V_SI" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>V_SI = C001WindLoadOnPedBridgeSuperstructure.V_SI</expbody><expresult> = 70.000</expresult></dynexp><break type="tab"/>shared value — C001WindLoadOnPedBridgeSuperstructure.V_SI; Service I wind speed (mph, C001)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="K_Z_III = C001WindLoadOnPedBridgeSuperstructure.K_Z_gov" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>K_Z_III = C001WindLoadOnPedBridgeSuperstructure.K_Z_gov</expbody><expresult> = 1.020</expresult></dynexp><break type="tab"/>shared value — C001WindLoadOnPedBridgeSuperstructure.K_Z_gov; Strength III exposure-and-height coefficient (C001 K_Z_gov)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="K_Z_SI = 1" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>K_Z_SI = 1</expbody><expresult> = 1.000</expresult></dynexp><break type="tab"/>Service I exposure-and-height coefficient</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="G_f = C001WindLoadOnPedBridgeSuperstructure.G_fac" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>G_f = C001WindLoadOnPedBridgeSuperstructure.G_fac</expbody><expresult> = 0.850</expresult></dynexp><break type="tab"/>shared value — C001WindLoadOnPedBridgeSuperstructure.G_fac; Gust-effect factor (C001)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="C_sub = 1.6" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>C_sub = 1.6</expbody><expresult> = 1.600</expresult></dynexp><break type="tab"/>Drag coefficient for wind directly on the substructure</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="PierCap_ht_toTop = BridgeGeometry_2Beam.PierCap_ht_toTop to in" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>PierCap_ht_toTop = BridgeGeometry_2Beam.PierCap_ht_toTop to in</expbody><expresult> = 218.915 in</expresult></dynexp><break type="tab"/>shared value — BridgeGeometry_2Beam.PierCap_ht_toTop; Pier wall and cap height to the cap top (transverse face)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="PierCap_width = BridgeGeometry_2Beam.PierCap_width to in" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>PierCap_width = BridgeGeometry_2Beam.PierCap_width to in</expbody><expresult> = 48.000 in</expresult></dynexp><break type="tab"/>shared value — BridgeGeometry_2Beam.PierCap_width; Pier cap width (transverse face)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Pier_wall_area = BridgeGeometry_2Beam.Pier_wall_area to ft^2" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>Pier_wall_area = BridgeGeometry_2Beam.Pier_wall_area to ft^2</expbody><expresult> = 349.656 ft^2</expresult></dynexp><break type="tab"/>shared value — BridgeGeometry_2Beam.Pier_wall_area; Broad pier-wall face area</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="q_III = 0.00000256*V_III^2*K_Z_III*G_f*1 ksf to ksf" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>q_III = 0.00000256*V_III^2*K_Z_III*G_f*1 ksf to ksf</expbody><expresult> = 0.037 ksf</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength III wind-pressure term before the direct-substructure drag multiplier. (LRFD Eq. 3.8.1.2.1-1)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="q_SI = 0.00000256*V_SI^2*K_Z_SI*G_f*1 ksf to ksf" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>q_SI = 0.00000256*V_SI^2*K_Z_SI*G_f*1 ksf to ksf</expbody><expresult> = 0.011 ksf</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Service I wind-pressure term before the direct-substructure drag multiplier. (LRFD Eq. 3.8.1.2.1-1)</paragraph><paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8" id="paragraphrefreturn0026"> <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link> </paragraph> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="p_sub_III = q_III*C_sub to ksf" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>p_sub_III = q_III*C_sub to ksf</expbody><expresult> = 0.060 ksf</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength III pressure on the pier wall and cap themselves. (LRFD Eq. 3.8.1.2.1-1; LRFD 3.8.1.2.3a)</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="p_sub_SI = q_SI*C_sub to ksf" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>p_sub_SI = q_SI*C_sub to ksf</expbody><expresult> = 0.017 ksf</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Service I pressure on the pier wall and cap themselves. (LRFD Eq. 3.8.1.2.1-1; LRFD 3.8.1.2.3a)</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C" fontweight="bold" keepwithnext="True">Pressure results</paragraph><embed spacingbefore="5" spacingafter="8"><table name="FWDirectPressureResults" capture="False" colwidths="1:180, 2:180, 3:180"><stylerule range="A1:C2" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/><stylerule range="A1:C1" horzalign="Center" vertalign="Center"/><stylerule range="B2:C2" horzalign="Center" vertalign="Center"/><row><textcell name="FWDirectPressureResultsR0C0" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Pressure (ksf)</paragraph></textcell><textcell name="FWDirectPressureResultsR0C1" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Strength III</paragraph></textcell><textcell name="FWDirectPressureResultsR0C2" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Service I</paragraph></textcell></row><row><textcell name="FWDirectPressureResultsR1C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Direct substructure: p_sub</paragraph></textcell><c formula="p_sub_III to ksf" capture="False" background="#EFF7F1"><num>0.060 ksf</num></c><c formula="p_sub_SI to ksf" capture="False" background="#EFF7F1"><num>0.017 ksf</num></c></row></table></embed><table name="FWDirectPressureNotes" capture="False" colwidths="1:520">
                <stylerule range="A1:A3" background="#EFF7F1" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#6A9075&quot;);"/>
                <stylerule range="A1" background="#DCECE0" fontweight="bold"/>
                <row>
                    <textcell name="FWBox8Row6" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold" spacingbefore="8">DIRECT SUBSTRUCTURE PRESSURES — STEP 8</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox8Row7" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1"> • <dynexp formula="p_sub_III" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False"> <expbody>p_sub_III</expbody>
                            </dynexp> — Strength III pressure acting directly on the pier wall and cap, to be multiplied by their own projected areas. </paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox8Row8" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1"> • <dynexp formula="p_sub_SI" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False"> <expbody>p_sub_SI</expbody>
                            </dynexp> — Service I pressure acting directly on the pier wall and cap, to be multiplied by their own projected areas. </paragraph> </textcell> </row>
            </table>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="F_wall_T_III = p_sub_III*PierCap_ht_toTop*PierCap_width to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>F_wall_T_III = p_sub_III*PierCap_ht_toTop*PierCap_width to kip</expbody><expresult> = 4.378 kip</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength III wind force acting directly on the pier’s transverse projected face.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="F_wall_L_III = p_sub_III*Pier_wall_area to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>F_wall_L_III = p_sub_III*Pier_wall_area to kip</expbody><expresult> = 20.979 kip</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Strength III wind force acting directly normal to the broad pier-wall face.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="F_wall_T_SI = p_sub_SI*PierCap_ht_toTop*PierCap_width to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>F_wall_T_SI = p_sub_SI*PierCap_ht_toTop*PierCap_width to kip</expbody><expresult> = 1.245 kip</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Service I wind force acting directly on the pier’s transverse projected face.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="F_wall_L_SI = p_sub_SI*Pier_wall_area to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>F_wall_L_SI = p_sub_SI*Pier_wall_area to kip</expbody><expresult> = 5.965 kip</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Service I wind force acting directly normal to the broad pier-wall face.</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" level="1"> LRFD 3.8.1.2.3b requires the direct-pier components to accompany the superstructure loads for the same wind direction. The full face-normal values retained here are force bounds; the final directional wall cases remain to be established. </paragraph> <table name="FWContentBox27" capture="False" colwidths="1:520">
                <stylerule range="A1" background="#DCECE0" fontweight="bold" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#6A9075&quot;);"/>
                <row>
                    <textcell capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" fontweight="bold" spacingbefore="8">DIRECT SUBSTRUCTURE LOADS — APPLY SEPARATELY</paragraph> </textcell> </row>
            </table>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C" fontweight="bold" keepwithnext="True">Direct substructure loads</paragraph><embed spacingbefore="5" spacingafter="8"><table name="FWWall" capture="False" colwidths="1:180, 2:180, 3:180"><stylerule range="A1:C3" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/><stylerule range="A1:C1" horzalign="Center" vertalign="Center"/><stylerule range="B2:C3" horzalign="Center" vertalign="Center"/><row><textcell name="FWWallR0C0" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Limit state</paragraph></textcell><textcell name="FWWallR0C1" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">F_T (kip)</paragraph></textcell><textcell name="FWWallR0C2" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">F_L (kip)</paragraph></textcell></row><row><textcell name="FWWallR1C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Strength III</paragraph></textcell><c formula="F_wall_T_III to kip" capture="False" background="#EFF7F1"><num>4.378 kip</num></c><c formula="F_wall_L_III to kip" capture="False" background="#EFF7F1"><num>20.979 kip</num></c></row><row><textcell name="FWWallR2C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Service I</paragraph></textcell><c formula="F_wall_T_SI to kip" capture="False" background="#EFF7F1"><num>1.245 kip</num></c><c formula="F_wall_L_SI to kip" capture="False" background="#EFF7F1"><num>5.965 kip</num></c></row></table></embed><table name="FWDirectWallRules" capture="False" colwidths="1:520">
                <stylerule range="A1:A4" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);"/>
                <stylerule range="A1" background="#DCE7F3" fontweight="bold"/>
                <row>
                    <textcell name="FWBox15Row14" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">DIRECT WALL WIND</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox15Row15" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Add wall loads at their wall-load locations.</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox15Row16" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• They are not included in the cap tables.</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox15Row17" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1"> • The full face-normal values are component bounds, not one simultaneous full-force pair. LRFD 3.8.1.2.3b requires direct-pier components to be resolved/applied consistently with the wind direction represented in the structural analysis. </paragraph> </textcell> </row>
            </table>
  <section name="FWStrategyWork06" capture="False" hide="false"><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" id="paragraphfwstrategywork06">Step 6. Transfer to the analysis nodes</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8">Transfer selected concurrent resultants from the cap reference to physical analysis nodes while preserving force and moment equilibrium.</paragraph> <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="8" textcolor="#43556B"> Code basis: LRFD Table 3.4.1-1 </paragraph> </section><embed spacingbefore="4" spacingafter="5"><canvas title="E. Cap-reference loads and wind-angle convention" name="FWLoadTransferSketch" unit="in" size="6.5 in; 4.0 in; scaletofit">
                <include target="Library.Geometry"/>
                <lines pts="0.05000, 0.05000, 0; 6.45000, 0.05000, 0; 6.45000, 3.95000, 0; 0.05000, 3.95000, 0; 0.05000, 0.05000, 0" linecolor="#D7DFE6" linethickness="1.2" linepattern="Solid"/>
                <planecontainer origin="0.18000, 3.73000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="11"><textvalue>Step 6: Cap loads and simplified T/L components</textvalue></planecontainer>
                <planecontainer origin="0.18000, 0.16000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#727B84" fontfamily="Times New Roman" fontsize="8"><textvalue>SCHEMATIC - NOT TO SCALE</textvalue></planecontainer>
                <planecontainer origin="0.31000, 3.46000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="10"><textvalue>TRANSVERSE RESULTANTS</textvalue></planecontainer>
                <lines pts="1.16000, 0.63000, 0; 2.20000, 0.63000, 0; 2.20000, 1.02000, 0; 1.16000, 1.02000, 0; 1.16000, 0.63000, 0" linecolor="#29333D" linethickness="1.2" linepattern="Solid"/>
                <circle center="1.68000, 0.83000, 0" normal="0, 0, 1" radius="0.035" linecolor="#29333D" fillcolor="#FFFFFF" linethickness="1"/>
                <lines pts="1.68000, 0.83000, 0; 1.68000, 3.18000, 0" linecolor="#727B84" linethickness="1.2" linepattern="Dashes"/>
                <arrowlines pts="0.64000, 2.92000, 0; 1.68000, 2.92000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3"/>
                <planecontainer origin="0.42000, 3.07000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#C83C32" fontfamily="Times New Roman" fontsize="10"><textvalue>F_fence</textvalue></planecontainer>
                <arrowlines pts="0.64000, 1.70000, 0; 1.68000, 1.70000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3"/>
                <planecontainer origin="0.35000, 1.90000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#C83C32" fontfamily="Times New Roman" fontsize="10"><textvalue>F_concrete</textvalue></planecontainer>
                <arrowlines pts="1.68000, 0.83000, 0; 2.72000, 0.83000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3"/>
                <planecontainer origin="2.12000, 1.10000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#C83C32" fontfamily="Times New Roman" fontsize="9"><textvalue>F_cap,T</textvalue></planecontainer>
                <arrowlines pts="1.93863, 0.47403, 0; 1.89846, 0.44806, 0; 1.85571, 0.42661, 0; 1.81088, 0.40992, 0; 1.76451, 0.39819, 0; 1.71713, 0.39157, 0; 1.66932, 0.39013, 0; 1.62164, 0.39389, 0; 1.57464, 0.40280, 0; 1.52889, 0.41676, 0; 1.48493, 0.43561, 0; 1.44327, 0.45911, 0; 1.40441, 0.48700, 0; 1.36880, 0.51894, 0; 1.33688, 0.55456, 0; 1.30901, 0.59344, 0; 1.28552, 0.63510, 0; 1.26669, 0.67908, 0; 1.25275, 0.72483, 0; 1.24386, 0.77183, 0; 1.24012, 0.81952, 0; 1.24159, 0.86733, 0; 1.24823, 0.91470, 0; 1.25997, 0.96107, 0; 1.27668, 1.00589, 0; 1.29816, 1.04863, 0; 1.32415, 1.08879, 0; 1.35434, 1.12588, 0; 1.38839, 1.15949, 0; 1.42587, 1.18919, 0; 1.46637, 1.21466, 0; 1.50938, 1.23557, 0; 1.55442, 1.25170, 0; 1.60093, 1.26284, 0; 1.64839, 1.26886, 0; 1.69621, 1.26970, 0; 1.74385, 1.26534, 0; 1.79073, 1.25584, 0; 1.83630, 1.24130, 0; 1.88002, 1.22191, 0; 1.92138, 1.19788, 0; 1.95989, 1.16950, 0; 1.99509, 1.13712, 0; 2.02656, 1.10110, 0; 2.05394, 1.06188, 0; 2.07690, 1.01992, 0; 2.09517, 0.97571, 0; 2.10854, 0.92978, 0; 2.11684, 0.88267, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3"/>
                <planecontainer origin="2.16000, 0.38000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#C83C32" fontfamily="Times New Roman" fontsize="9"><textvalue>M_cap,L</textvalue></planecontainer>
                <lineardim startpoint="1.68000, 0.83000, 0" endpoint="1.68000, 2.92000, 0" pointondimline="2.85000, 1.92000, 0" formula="FenceWind.M_fence/FenceWind.F_fence" linecolor="#1766A0" textcolor="#1766A0" linethickness="0.7" fontsize="9"><num>169.719 in</num></lineardim>
                <planecontainer origin="2.97, 2.69, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#1766A0" fontfamily="Times New Roman" fontsize="9"><textvalue>z_eff</textvalue></planecontainer>
                <planecontainer origin="0.35000, 0.39000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="9"><textvalue>Cap reference</textvalue></planecontainer>
                <planecontainer origin="3.64000, 3.46000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="10"><textvalue>PLAN: SIMPLIFIED COMPONENTS</textvalue></planecontainer>
                <lines pts="4.50000, 1.25000, 0; 5.06000, 1.25000, 0; 5.06000, 2.80000, 0; 4.50000, 2.80000, 0; 4.50000, 1.25000, 0" linecolor="#29333D" linethickness="1.2" linepattern="Solid"/>
                <arrowlines pts="4.78000, 1.05000, 0; 4.78000, 3.12000, 0" linecolor="#1766A0" linethickness="1.2" linepattern="Solid" endarrow="6; 3"/>
                <planecontainer origin="4.93000, 3.04000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#1766A0" fontfamily="Times New Roman" fontsize="10"><textvalue>+L</textvalue></planecontainer>
                <arrowlines pts="3.82000, 1.96000, 0; 6.07000, 1.96000, 0" linecolor="#1766A0" linethickness="1.2" linepattern="Solid" endarrow="6; 3"/>
                <planecontainer origin="5.98000, 1.70000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#1766A0" fontfamily="Times New Roman" fontsize="10"><textvalue>+T</textvalue></planecontainer>
                <planecontainer origin="3.65000, 0.82000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="10"><textvalue>100% T + 25% L</textvalue></planecontainer>
                <planecontainer origin="3.62000, 0.52000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="10"><textvalue>T and L act concurrently</textvalue></planecontainer>
                <arrowlines pts="4.78000, 1.96000, 0; 5.88000, 1.96000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3"/>
                <planecontainer origin="5.18000, 2.10000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#C83C32" fontfamily="Times New Roman" fontsize="9"><textvalue>100% T</textvalue></planecontainer>
                <arrowlines pts="4.78000, 1.96000, 0; 4.78000, 2.82000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3"/>
                <planecontainer origin="4.10000, 2.62000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#C83C32" fontfamily="Times New Roman" fontsize="9"><textvalue>25% L</textvalue></planecontainer>
            </canvas>
  </embed><table name="FWContentBox13" capture="False" colwidths="1:520">
                <stylerule range="A1:A2" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);"/>
                <stylerule range="A1" background="#DCE7F3" fontweight="bold"/>
                <row>
                    <textcell name="FWBox13Row1" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">CAP-LOAD SCHEMATIC</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox13Row2" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1"> • Left: equivalent fence resultant for the LRFD 13.8.2 fence resultant. </paragraph> </textcell> </row>
            </table>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• The equivalent fence force acts at z_eff = z_mid and already reproduces the adopted projected fence moment.</paragraph> <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True">Totals at the cap reference</paragraph><table name="FWContentBox15" capture="False" colwidths="1:520">
                <stylerule range="A1:A9" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);"/>
                <stylerule range="A1" background="#DCE7F3" fontweight="bold"/>
                <row>
                    <textcell name="FWBox15Row1" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" fontweight="bold" spacingbefore="8">LOAD APPLICATION RULES</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox15Row9" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">FACTOR STATUS</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox15Row10" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Select the matching Strength III or Service I wind set and use WS = 1.0. Do not apply a single pressure-ratio multiplier to all wind loads.</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox15Row11" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">REFERENCE POINT</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox15Row12" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Cap tables contain total superstructure-plus-fence resultants at the pier cap reference.</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox15Row13" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Their moments already include eccentricity to that reference.</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox15Row18" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">NODE TRANSFER</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox15Row19" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Distribute the total force once.</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox15Row20" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• For an application elevation z above the cap reference:</paragraph> </textcell> </row>
            </table>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Preserve force and moment equilibrium.</paragraph> <table name="FWContentBox17" capture="False" colwidths="1:520">
                <stylerule range="A1:A4" background="#EFF7F1" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#6A9075&quot;);"/>
                <stylerule range="A1" background="#DCECE0" fontweight="bold"/>
                <row>
                    <textcell name="FWBox17Row1" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">OUTPUT → MODEL INPUT</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox17Row2" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• The live four-bearing decomposition, coordinates and residual moments are collected in Ped Bridge — FBMP Model Loads.</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox17Row3" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Map calculation directions to the analysis-model axes.</paragraph> </textcell> </row>
                <row>
                    <textcell name="FWBox17Row4" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Map cap and wall load locations to the physical analysis nodes.</paragraph> </textcell> </row>
            </table>
  <section name="FWStrategyWork07" capture="False" hide="false"><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" id="paragraphfwstrategywork07">Step 7. Checks and design handoff</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8">Check the simplified fence model, qualification limits, cap-reference bookkeeping, and the 100% transverse / 25% longitudinal component relationships before handoff.</paragraph> <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="8" textcolor="#43556B"> Code basis: RFQ — Governing Regulations; FDOT SDG 10.10.B and 10.10.F; LRFD 3.8.2 </paragraph> </section><table name="FWSectionIntro6" title="Section introduction" capture="False" colwidths="1:90, 2:430">
                <stylerule range="A1:B3" background="#EDF3F8" fontfamily="Times New Roman" fontsize="10" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#1766A0&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 1, &quot;#CCD9E5&quot;);"/>
                <stylerule range="A1:A3" fontweight="bold"/>
                <row>
                    <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Objective</paragraph></textcell> <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Check model consistency and load-transfer bookkeeping.</paragraph></textcell> </row>
                <row>
                    <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Inputs</paragraph></textcell> <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Geometry; tributary length; fence resultant; simplified-method criteria; simultaneous cap components.</paragraph></textcell> </row>
                <row>
                    <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Output</paragraph></textcell> <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Live consistency checks and handoff items.</paragraph></textcell> </row>
                <stylerule range="A1:B1" background="#F1F5FA"/>
                <stylerule range="A2:B2" background="#FFF8E9"/>
                <stylerule range="A3:B3" background="#EFF7F1"/>
            </table>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="Check_geometry = If(And(h_f &gt; 0 ft, R_f &gt; 0 ft, h_tan &gt;= 0 ft, z_base &gt;= 0 ft, L_trib &gt; 0 ft), &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>Check_geometry = If(And(h_f &gt; 0 ft, R_f &gt; 0 ft, h_tan &gt;= 0 ft, z_base &gt;= 0 ft, L_trib &gt; 0 ft), "✓ PASS", "⊗ FAIL")</expbody><expresult> = ✓ PASS</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Check the basic dimensions used by the prescribed fence load model.</paragraph><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="2" spacingbefore="4" fontweight="bold" textcolor="#1766A0" keepwithnext="True" texthighlight="#EDF3F8" id="paragraphrefreturn0027">STEP 7 OF 7 | Check balance and complete the design handoff</paragraph> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="Check_balance = If(And(Abs(M_fence - F_fence*z_eff) &lt; 0.000001 kip*ft, Abs(F_cap_T_III - F_c_III - F_fence) &lt; 0.000001 kip, Abs(M_cap_L_III - M_c_III - M_fence) &lt; 0.000001 kip*ft, Abs(F_cap_T_SI - F_c_SI - F_fence) &lt; 0.000001 kip, Abs(M_cap_L_SI - M_c_SI - M_fence) &lt; 0.000001 kip*ft), &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>Check_balance = If(And(Abs(M_fence - F_fence*z_eff) &lt; 0.000001 kip*ft, Abs(F_cap_T_III - F_c_III - F_fence) &lt; 0.000001 kip, Abs(M_cap_L_III - M_c_III - M_fence) &lt; 0.000001 kip*ft, Abs(F_cap_T_SI - F_c_SI - F_fence) &lt; 0.000001 kip, Abs(M_cap_L_SI - M_c_SI - M_fence) &lt; 0.000001 kip*ft), "✓ PASS", "⊗ FAIL")</expbody><expresult> = ✓ PASS</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Check the fence resultant and cap-reference totals.</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C" fontweight="bold" keepwithnext="True">Consistency checks</paragraph><embed spacingbefore="5" spacingafter="8"><table name="FWChecksTable" capture="False" colwidths="1:270, 2:270"><stylerule range="A1:B4" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/><stylerule range="A1:B1" horzalign="Center" vertalign="Center"/><stylerule range="B2:B4" horzalign="Center" vertalign="Center"/><row><textcell name="FWChecksTableR0C0" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Check</paragraph></textcell><textcell name="FWChecksTableR0C1" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Result</paragraph></textcell></row><row><textcell name="FWChecksTableR1C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Fence/tributary geometry</paragraph></textcell><c formula="Check_geometry" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="FWChecksTableR2C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">LRFD simplified-method qualification</paragraph></textcell><c formula="Check_simplified" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="FWChecksTableR3C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Resultant equilibrium</paragraph></textcell><c formula="Check_balance" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row></table></embed><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C" fontweight="bold" keepwithnext="True">Transfer checks</paragraph><embed spacingbefore="5" spacingafter="8"><table name="FWTransferChecks" capture="False" colwidths="1:270, 2:270"><stylerule range="A1:B3" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/><stylerule range="A1:B1" horzalign="Center" vertalign="Center"/><stylerule range="B2:B3" horzalign="Center" vertalign="Center"/><row><textcell name="FWTransferChecksR0C0" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Verification</paragraph></textcell><textcell name="FWTransferChecksR0C1" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Result</paragraph></textcell></row><row><textcell name="FWTransferChecksR1C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Tributary length = half the sum of spans</paragraph></textcell><c formula="If(Abs(L_trib-(Span_1+Span_2)/2)&lt;0.000001 ft, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="FWTransferChecksR2C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Simplified longitudinal force and moment components follow the 25% rule</paragraph></textcell><c formula="If(And(Abs(F_cap_L_III - 0.25*F_cap_T_III) &lt; 0.000001 kip, Abs(M_cap_T_III - (0.25*M_c_III + 0.25*F_fence*z_mid)) &lt; 0.000001 kip*ft, Abs(F_cap_L_SI - 0.25*F_cap_T_SI) &lt; 0.000001 kip, Abs(M_cap_T_SI - (0.25*M_c_SI + 0.25*F_fence*z_mid)) &lt; 0.000001 kip*ft), &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row></table></embed><table name="FWContentBox18" capture="False" colwidths="1:520">
                <stylerule range="A1:A4" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);"/>
                <stylerule range="A1" background="#DCE7F3" fontweight="bold"/>
                <row>
                    <textcell capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" spacingbefore="8" fontweight="bold">MEANING OF PASS</paragraph> </textcell> </row>
                <row>
                    <textcell capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• These checks establish geometry consistency and load bookkeeping; they do not establish member, connection, bearing, or foundation capacity.</paragraph> </textcell> </row>
                <row>
                    <textcell capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1"> • Confirm LRFD 13.8.2 fence applicability, the simplified-method span/height qualification, hoop geometry, cap reference, direct-pier wind direction mapping, and analysis-model axes before final use. </paragraph> </textcell> </row>
                <row>
                    <textcell capture="False"> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Address attachment resistance, deck uplift, FE analysis, bearings, piles, and foundations in their designated calculations.</paragraph> </textcell> </row>
            </table>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="12" level="1">Handoff status: the live checks verify the identities named in the tables. The physical node list, direction-matched direct wall cases, separate deck uplift load, and component/connection resistance checks must be completed in their designated analysis and design calculations.</paragraph> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6"> <link address="#FBMPPier.FBMPEntryReference;paragraphfbmpentry">Four-bearing node loads and matching wind cases</link> </paragraph> <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">10. Checks</paragraph><embed spacingbefore="5" spacingafter="8"><table name="Checks" capture="False" colwidths="1:250, 2:95, 3:95, 4:60, 5:90"><stylerule range="A1:E6" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/><stylerule range="A1:E1" horzalign="Center" vertalign="Center"/><stylerule range="B2:E6" horzalign="Center" vertalign="Center"/><row><textcell name="ChecksR0C0" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Check</paragraph></textcell><textcell name="ChecksR0C1" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Demand</paragraph></textcell><textcell name="ChecksR0C2" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Capacity / limit</paragraph></textcell><textcell name="ChecksR0C3" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Ratio</paragraph></textcell><textcell name="ChecksR0C4" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Result</paragraph></textcell></row><row><textcell name="ChecksR1C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Individual span ≤ 150 ft (LRFD 3.8.1.2.3a)</paragraph></textcell><c formula="L_span_max to ft" capture="False" background="#EFF7F1"><num>107.350 ft</num></c><textcell name="ChecksR1C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">150 ft</paragraph></textcell><c formula="DC_span" capture="False" background="#EFF7F1"><num>0.716</num></c><c formula="If(DC_span &lt;= 1, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR2C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Bridge height ≤ 33 ft above low ground (LRFD 3.8.1.2.3a)</paragraph></textcell><c formula="H_bridge to in" capture="False" background="#EFF7F1"><num>312.478 in</num></c><textcell name="ChecksR2C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">33 ft</paragraph></textcell><c formula="DC_height" capture="False" background="#EFF7F1"><num>0.789</num></c><c formula="If(DC_height &lt;= 1, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR3C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Overall simplified-method qualification (100 % T + 25 % L)</paragraph></textcell><textcell name="ChecksR3C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR3C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR3C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Check_simplified" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR4C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Fence and tributary geometry</paragraph></textcell><textcell name="ChecksR4C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR4C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR4C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Check_geometry" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR5C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Resultant equilibrium of the fence and cap-reference totals</paragraph></textcell><textcell name="ChecksR5C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR5C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR5C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Check_balance" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row></table></embed><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="Status = If(Or(DC_span &gt; 1, DC_height &gt; 1, Check_simplified == &quot;⊗ FAIL&quot;, Check_geometry == &quot;⊗ FAIL&quot;, Check_balance == &quot;⊗ FAIL&quot;), &quot;⊗ There are FAILURES&quot;, &quot;✓ All Checks Pass&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>Status = If(Or(DC_span &gt; 1, DC_height &gt; 1, Check_simplified == "⊗ FAIL", Check_geometry == "⊗ FAIL", Check_balance == "⊗ FAIL"), "⊗ There are FAILURES", "✓ All Checks Pass")</expbody><expresult> = ✓ All Checks Pass</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Overall status of the recomputed numerical checks.</paragraph></report>
</document>
