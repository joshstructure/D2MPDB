                <lineardim startpoint="1.89500, 1.40000, 0" endpoint="4.58500, 1.40000, 0" pointondimline="3.22000, 2.36000, 0" formula="FenceWind.L_trib" linecolor="#1766A0" textcolor="#1766A0" linethickness="0.7" fontsize="9"><num>1273.500 in</num></lineardim>
