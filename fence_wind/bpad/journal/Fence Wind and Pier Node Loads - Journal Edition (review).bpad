  <report name="FenceWind" title="C002 - Fence Wind and Pier Node Loads" unit="in" pagesize="816,1056" margin="48,48,48,48" bordermargin="0,0,0,0" collapsemargins="False"><include target="Library.Geometry"/><stylerule type="AnyEquation" name="Required Input" texthighlight="#F7E6B9"/><embed spacingbefore="5" spacingafter="8"><table name="ProjectStamp" capture="False" colwidths="1:95, 2:165, 3:95, 4:165"><stylerule range="A1:D4" fontfamily="Times New Roman" fontsize="9" vertalign="Center" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#7189A6&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#7189A6&quot;);"/><row><textcell name="ProjectStampR0C0" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Firm</paragraph></textcell><textcell name="ProjectStampR0C1" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_Firm = ProjectInfo.Firm" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_Firm = ProjectInfo.Firm</expbody><expresult>Parsons Transportation Group Inc</expresult></dynexp></paragraph></textcell><textcell name="ProjectStampR0C2" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Project</paragraph></textcell><textcell name="ProjectStampR0C3" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_Project = ProjectInfo.Project" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_Project = ProjectInfo.Project</expbody><expresult>I-95 Capacity Improvements from South of SR 152 to South of SR 126</expresult></dynexp></paragraph></textcell></row><row><textcell name="ProjectStampR1C0" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Address</paragraph></textcell><textcell name="ProjectStampR1C1" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_Address = ProjectInfo.Address" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_Address = ProjectInfo.Address</expbody><expresult>1203 Governors Square Blvd, Suite 201, Tallahassee FL 32301</expresult></dynexp></paragraph></textcell><textcell name="ProjectStampR1C2" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Job no.</paragraph></textcell><textcell name="ProjectStampR1C3" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_JobNo = ProjectInfo.JobNo" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_JobNo = ProjectInfo.JobNo</expbody><expresult></expresult></dynexp></paragraph></textcell></row><row><textcell name="ProjectStampR2C0" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Designed by</paragraph></textcell><textcell name="ProjectStampR2C1" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_DesignedBy = ProjectInfo.DesignedBy" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_DesignedBy = ProjectInfo.DesignedBy</expbody><expresult>JAT</expresult></dynexp></paragraph></textcell><textcell name="ProjectStampR2C2" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Date</paragraph></textcell><textcell name="ProjectStampR2C3" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_DesignDate = ProjectInfo.DesignDate" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_DesignDate = ProjectInfo.DesignDate</expbody><expresult>10/17/2026</expresult></dynexp></paragraph></textcell></row><row><textcell name="ProjectStampR3C0" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Checked by</paragraph></textcell><textcell name="ProjectStampR3C1" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_CheckedBy = ProjectInfo.CheckedBy" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_CheckedBy = ProjectInfo.CheckedBy</expbody><expresult>MIK</expresult></dynexp></paragraph></textcell><textcell name="ProjectStampR3C2" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0" fontweight="bold">Date</paragraph></textcell><textcell name="ProjectStampR3C3" capture="False" background="#F1F5FA"><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="0"><dynexp formula="Stamp_CheckDate = ProjectInfo.CheckDate" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False"><expbody>Stamp_CheckDate = ProjectInfo.CheckDate</expbody><expresult></expresult></dynexp></paragraph></textcell></row></table></embed><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="8" textcolor="#8A2B1F" background="#FBE9E5">Review copy: the references to other journal modules (Bridge Geometry, Materials, the load modules and ProjectInfo) resolve only inside the project journal (D2_I95_Project_Journal.bpad). Opened on its own, this file shows them as undefined; the values stored in it are the journal values at the time of the build.</paragraph><paragraph fontfamily="Times New Roman" fontsize="16" spacingafter="2" fontweight="bold">D2 I-95 PEDESTRIAN BRIDGE</paragraph><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold">C002 - Fence Wind and Pier Node Loads</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Design basis: AASHTO LRFD Bridge Design Specifications, 10th edition (2024); AASHTO LRFD Guide Specifications for the Design of Pedestrian Bridges; FDOT Structures Manual January 2026 (SDG Volume 1, SDM Volume 2)</paragraph><section name="WorkingNotes" capture="False" hide="true"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="4" fontweight="bold" textcolor="#43505C">Working notes (hidden; not part of the submitted calculation): how this edition was produced, its tool status and the open bookkeeping items.</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" textcolor="#43505C">Journal edition written by calc_common/bpad.py (fence_wind) from the notebook case 464fc5fd2dba. Every definition was evaluated independently and compared with the notebook to 1 part in 10⁹; the inputs the journal owns are live references, compared with the case by the coherence gate before the build.</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" textcolor="#43505C">The calculation was ported from the journal module FenceWind (journal feb1bb316d08); every definition of the module was evaluated independently from the journal file and reproduced by the notebook to 1 part in 10⁹ before this edition was written.</paragraph><paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="5" textcolor="#43505C">A ✓ status covers only the recomputed numerical checks; it is not design acceptance. The equation notes of the calculation are in its report.</paragraph></section><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Inputs are highlighted amber; results are the green tables.</paragraph><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">Overview</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" background="#F1F5FA">Wind loads transferred to the intermediate pier. The fence is loaded by the prescribed LRFD 13.8.2 pressure of 0.015 ksf applied once to the gross projected fence face for the selected wind direction; the opposite direction is a sign-reversed case. The concrete superstructure wind of C001 acts on the pier tributary length, half of each simply supported span.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" background="#F1F5FA">For this girder bridge (individual span not more than 150 ft, concrete top not more than 33 ft above low ground) the simplified wind components of LRFD 3.8.1.2.3a are used in lieu of the plan-angle sweep: the transverse force and moment are the full perpendicular-wind resultants and the longitudinal components are 25 % of them, applied simultaneously with WS = 1.0 in Strength III and Service I. Wind acting directly on the pier wall and cap uses the LRFD pressure equation with the substructure drag coefficient and is listed separately.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" background="#F1F5FA">Outside this calculation: attachment and fence-member design, bearing uplift (C004), the physical node assignment in the analysis model and foundation capacity.</paragraph><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">Overview and scope</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="8" level="0" id="paragraphrefreturn0021"> <link address="#FenceWind.FWStrategyStep01;paragraphfwstrategy01">Code basis and calculation strategy</link> </paragraph> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" background="#FFF8E9" fontweight="bold">GEOMETRY BASIS — Cap and wind datums derive from the selected Type F pad, 6-in pedestal and 36-in cap. Individual seat grades, separate plates, the retained wind envelope, terrain reference and gross pier-face width require final-detail confirmation.</paragraph> <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4">Design basis: LRFD Bridge Design Specifications, 10th Edition (2024); FDOT Structures Manual, January 2026.</paragraph> <table name="FWOverviewIntro" title="Section introduction" capture="False" colwidths="1:90, 2:430">
                <stylerule range="A1:B3" background="#EDF3F8" fontfamily="Times New Roman" fontsize="10" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#1766A0&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 1, &quot;#CCD9E5&quot;);"/>
                <stylerule range="A1:A3" fontweight="bold"/>
                <row>
                    <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Objective</paragraph></textcell> <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Determine the wind loads transferred to the intermediate pier.</paragraph></textcell> </row>
                <row>
                    <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Inputs</paragraph></textcell> <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Fence geometry; tributary length; prescribed LRFD 13.8.2 fence pressure; bridge/direct-pier wind inputs.</paragraph></textcell> </row>
                <row>
                    <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Output</paragraph></textcell> <textcell capture="False"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Concurrent cap forces and moments, plus separate direct wall loads.</paragraph></textcell> </row>
                <stylerule range="A1:B1" background="#F1F5FA"/>
                <stylerule range="A2:B2" background="#FFF8E9"/>
                <stylerule range="A3:B3" background="#EFF7F1"/>
            </table>
