                <lineardim startpoint="3.22000, 1.40000, 0" endpoint="5.95000, 1.40000, 0" pointondimline="4.70000, 0.63000, 0" formula="BridgeGeometry_2Beam.Span_2" linecolor="#1766A0" textcolor="#1766A0" linethickness="0.7" fontsize="9"><num>1258.800 in</num></lineardim>
