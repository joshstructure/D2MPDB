                <lines pts="0.05000, 0.05000, 0; 6.45000, 0.05000, 0; 6.45000, 3.25000, 0; 0.05000, 3.25000, 0; 0.05000, 0.05000, 0" linecolor="#D7DFE6" linethickness="1.2" linepattern="Solid"/>
                <planecontainer origin="0.18000, 3.03000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="11"><textvalue>Step 2: Tributary length — longitudinal elevation</textvalue></planecontainer>
                <planecontainer origin="0.18000, 0.16000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#727B84" fontfamily="Times New Roman" fontsize="8"><textvalue>SCHEMATIC - NOT TO SCALE</textvalue></planecontainer>
