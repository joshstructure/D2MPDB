ound="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">0</paragraph></textcell><textcell name="C006Table278R2C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">0</paragraph></textcell><c formula="V_target to kip" capture="False" background="#EFF7F1"><num>74.458 kip</num></c><c formula="-M_x_target to kip*ft" capture="False" background="#EFF7F1"><num>-1.550 kip*ft</num></c><c formula="-M_y_target to kip*ft" capture="False" background="#EFF7F1"><num>-21.718 kip*ft</num></c><textcell name="C006Table278R2C6" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">0</paragraph></textcell></row></table></embed><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="P_pile_end = R_1+W_a to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>P_pile_end = R_1+W_a to kip</expbody><expresult> = 33.303 kip</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Service wall-plus-fin reaction at either end pile.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="P_pile_int = R_2+R_3+2*W_a to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>P_pile_int = R_2+R_3+2*W_a to kip</expbody><expresult> = 24.204 kip</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Service wall-plus-fin reaction at either interior pile.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="M_pile_end = R_1*r_f+W_p*(D_p/2+a_p/2)+W_s*r_nom to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>M_pile_end = R_1*r_f+W_p*(D_p/2+a_p/2)+W_s*r_nom to kip*ft</expbody><expresult> = 38.437 kip*ft</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Service wall-induced moment magnitude at an end-pile centerline.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="M_pile_int = (R_3-R_2)*r_f to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>M_pile_int = (R_3-R_2)*r_f to kip*ft</expbody><expresult> = 15.201 kip*ft</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Service moment from unequal opposite-fin gravity reactions at an interior pile.</paragraph><paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True">Receiving pile interface — actual wall loads, excluding the bridge background state</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C" fontweight="bold" keepwithnext="True">Receiving pile interface — actual wall loads, excluding the bridge background state</paragraph><embed spacingbefore="5" spacingafter="8"><table name="C006Table283" capture="False" colwidths="1:108, 2:108, 3:108, 4:108, 5:108"><stylerule range="A1:E3" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/><stylerule range="A1:E1" horzalign="Center" vertalign="Center"/><stylerule range="B2:E3" horzalign="Center" vertalign="Center"/><row><textcell name="C006Table283R0C0" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Location</paragraph></textcell><textcell name="C006Table283R0C1" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Service vertical</paragraph></textcell><textcell name="C006Table283R0C2" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Service moment magnitude</paragraph></textcell><textcell name="C006Table283R0C3" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Strength vertical</paragraph></textcell><textcell name="C006Table283R0C4" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Strength moment magnitude</paragraph></textcell></row><row><textcell name="C006Table283R1C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">P1 / P4</paragraph></textcell><c formula="P_pile_end to kip" capture="False" background="#EFF7F1"><num>33.303 kip</num></c><c formula="M_pile_end to kip*ft" capture="False" background="#EFF7F1"><num>38.437 kip*ft</num></c><c formula="γ_DC*P_pile_end to kip" capture="False" background="#EFF7F1"><num>41.628 kip</num></c><c formula="γ_DC*M_pile_end to kip*ft" capture="False" background="#EFF7F1"><num>48.046 kip*ft</num></c></row><row><textcell name="C006Table283R2C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">P2 / P3</paragraph></textcell><c formula="P_pile_int to kip" capture="False" background="#EFF7F1"><num>24.204 kip</num></c><c formula="M_pile_int to kip*ft" capture="False" background="#EFF7F1"><num>15.201 kip*ft</num></c><c formula="γ_DC*P_pile_int to kip" capture="False" background="#EFF7F1"><num>30.255 kip</num></c><c formula="γ_DC*M_pile_int to kip*ft" capture="False" background="#EFF7F1"><num>19.002 kip*ft</num></c></row></table></embed><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#A64A20">Mirror pile moments reverse sign across the wall center. Add these actions only when they replace the existing equivalent wall-load application; do not add the same wall weight twice in FBMP. Local pipe-shell checks require the concurrent bridge axial/bending state and the effective pipe thickness shown in Step 1.</paragraph> <section name="C006Work08" capture="False" hide="false"><paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" id="c006work08">Step 8. Design summary and verification boundaries</paragraph></section><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Local_node_complete = false" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>Local_node_complete = false</expbody><expresult> = false</expresult></dynexp><break type="tab"/>Local hanger/concrete/saddle load-transfer mechanism independently completed?</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Local_pipe_complete = false" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>Local_pipe_complete = false</expbody><expresult> = false</expresult></dynexp><break type="tab"/>Local pipe-shell and concurrent global pile verification independently completed?</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Geometry_confirmed = false" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input"><expbody>Geometry_confirmed = false</expbody><expresult> = false</expresult></dynexp><break type="tab"/>Source wall-bottom elevation, cover/environment, and required pile-position envelope confirmed?</paragraph><section name="step_8_design_summary_and_verification_bRows" capture="False" hide="true"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Working rows (hidden): the row-by-row definitions behind the tables.</paragraph><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="Status_numeric = If(Or(Chk_reactions == &quot;⊗ FAIL&quot;, Chk_model == &quot;⊗ FAIL&quot;, Chk_saddle == &quot;⊗ FAIL&quot;, Chk_hairpin == &quot;⊗ FAIL&quot;, Chk_development == &quot;⊗ FAIL&quot;, Chk_bend == &quot;⊗ FAIL&quot;, Chk_plate_flex == &quot;⊗ FAIL&quot;, Chk_plate_shear == &quot;⊗ FAIL&quot;, Chk_plate_VM == &quot;⊗ FAIL&quot;, Chk_root == &quot;⊗ FAIL&quot;, Chk_strip_flex == &quot;⊗ FAIL&quot;, Chk_strip_shear == &quot;⊗ FAIL&quot;, Chk_service == &quot;⊗ FAIL&quot;, Chk_ST == &quot;⊗ FAIL&quot;, Chk_STMgrid == &quot;⊗ FAIL&quot;, Chk_spacing == &quot;⊗ FAIL&quot;, Chk_fit == &quot;⊗ FAIL&quot;, Chk_joints == &quot;⊗ FAIL&quot;), &quot;⊗ There are FAILURES&quot;, &quot;✓ All Checks Pass&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>Status_numeric = If(Or(Chk_reactions == "⊗ FAIL", Chk_model == "⊗ FAIL", Chk_saddle == "⊗ FAIL", Chk_hairpin == "⊗ FAIL", Chk_development == "⊗ FAIL", Chk_bend == "⊗ FAIL", Chk_plate_flex == "⊗ FAIL", Chk_plate_shear == "⊗ FAIL", Chk_plate_VM == "⊗ FAIL", Chk_root == "⊗ FAIL", Chk_strip_flex == "⊗ FAIL", Chk_strip_shear == "⊗ FAIL", Chk_service == "⊗ FAIL", Chk_ST == "⊗ FAIL", Chk_STMgrid == "⊗ FAIL", Chk_spacing == "⊗ FAIL", Chk_fit == "⊗ FAIL", Chk_joints == "⊗ FAIL"), "⊗ There are FAILURES", "✓ All Checks Pass")</expbody><expresult> = ✓ All Checks Pass</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Status_numeric</paragraph></section><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="Status_C006 = If(Status_numeric==&quot;⊗ There are FAILURES&quot;,&quot;REVISE — NUMERICAL CHECK FAILS&quot;,If(And(Local_node_complete,Local_pipe_complete,Geometry_confirmed),&quot;CHECKS PASS — WELD CHECK SEPARATE&quot;,&quot;PROVISIONAL — LOCAL CHECKS OPEN&quot;))" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>Status_C006 = If(Status_numeric=="⊗ There are FAILURES","REVISE — NUMERICAL CHECK FAILS",If(And(Local_node_complete,Local_pipe_complete,Geometry_confirmed),"CHECKS PASS — WELD CHECK SEPARATE","PROVISIONAL — LOCAL CHECKS OPEN"))</expbody><expresult> = PROVISIONAL — LOCAL CHECKS OPEN</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Live module status; separate weld calculation remains required.</paragraph><paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True">Implemented numerical checks</paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C" fontweight="bold" keepwithnext="True">Implemented numerical checks</paragraph><embed spacingbefore="5" spacingafter="8"><table name="C006Table289" capture="False" colwidths="1:270, 2:270"><stylerule range="A1:B19" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/><stylerule range="A1:B1" horzalign="Center" vertalign="Center"/><stylerule range="B2:B19" horzalign="Center" vertalign="Center"/><row><textcell name="C006Table289R0C0" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Check</paragraph></textcell><textcell name="C006Table289R0C1" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Result</paragraph></textcell></row><row><textcell name="C006Table289R1C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Six wall reactions reproduce the gross wall weight.</paragraph></textcell><c formula="Chk_reactions" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="C006Table289R2C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Validity of the symmetric four-pile/six-fin reaction model.</paragraph></textcell><c formula="Chk_model" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="C006Table289R3C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Selected saddle and hairpin force points fit on the fin projection.</paragraph></textcell><c formula="Chk_saddle" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="C006Table289R4C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Hairpin tensile resistance under assigned actual gravity loads.</paragraph></textcell><c formula="Chk_hairpin" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="C006Table289R5C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Available straight-tail length exceeds the full-yield requirement.</paragraph></textcell><c formula="Chk_development" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="C006Table289R6C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Hairpin inside bend diameter satisfies the general #5 bar minimum.</paragraph></textcell><c formula="Chk_bend" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="C006Table289R7C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Selected fin satisfies adopted biaxial elastic/LTB resistance.</paragraph></textcell><c formula="Chk_plate_flex" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="C006Table289R8C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Selected fin satisfies root shear yielding and rupture.</paragraph></textcell><c formula="Chk_plate_shear" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="C006Table289R9C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Selected fin passes additional conservative combined-stress screen.</paragraph></textcell><c formula="Chk_plate_VM" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="C006Table289R10C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Plate geometry remains valid and inside the source wall.</paragraph></textcell><c formula="Chk_root" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="C006Table289R11C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Wind-strip flexure and minimum flexural reinforcement.</paragraph></textcell><c formula="Chk_strip_flex" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="C006Table289R12C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Wind-strip shear and transverse reinforcement area/spacing.</paragraph></textcell><c formula="Chk_strip_shear" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="C006Table289R13C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Supplementary Service I cracked-section check with FDOT amendment.</paragraph></textcell><c formula="Chk_service" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="C006Table289R14C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Shrinkage/temperature steel and maximum spacing, both directions and faces.</paragraph></textcell><c formula="Chk_ST" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="C006Table289R15C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Adopted disturbed-region grid area and twelve-inch ceiling.</paragraph></textcell><c formula="Chk_STMgrid" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="C006Table289R16C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">General grid clear spacing and selected cross-tie spacing.</paragraph></textcell><c formula="Chk_spacing" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="C006Table289R17C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Selected trial layout fits only within the specified pile-position envelope.</paragraph></textcell><c formula="Chk_fit" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="C006Table289R18C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Wall length does not require an intermediate joint under the 30-foot screen.</paragraph></textcell><c formula="Chk_joints" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row></table></embed><table name="C006Box290" capture="False" colwidths="1:650">
                <stylerule range="A1:A6" background="#F1F5FA" fontfamily="Times New Roman" fontsize="10" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#7189A6&quot;);"/>
                <stylerule range="A1" background="#DCE7F3" fontweight="bold"/>
                <row>
                    <textcell name="C006Box290R0" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" fontweight="bold">EXPLICIT COMPLETION ITEMS — NOT INCLUDED IN AN OVERALL PASS</paragraph> </textcell> </row>
                <row>
                    <textcell name="C006Box290R1" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">1. Local node and wall gravity collection: substantiate the reserved transfer zone, actual struts/nodes, splitting confinement, bar development beyond the relevant separation surfaces, and the round saddle contact/retention detail.</paragraph> </textcell> </row>
                <row>
                    <textcell name="C006Box290R2" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">2. Receiving pipe: check localized shell yielding/plastification, punching/tearing and interaction with the actual concurrent pile stress state at the fin elevation. Use the effective pipe wall, not the nominal 5/8-inch wall. No pipe local-resistance pass is claimed here.</paragraph> </textcell> </row>
                <row>
                    <textcell name="C006Box290R3" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">3. Geometry: confirm source wall-bottom elevation, environmental cover and the tighter wall-region position tolerance. The old source wall quantity has not been silently changed.</paragraph> </textcell> </row>
                <row>
                    <textcell name="C006Box290R4" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">4. Weld: use the exported root cases in the separate weld calculation, including relocation to the actual weld centroid and adjacent base-metal failure paths. No weld design is contained in C006.</paragraph> </textcell> </row>
                <row>
                    <textcell name="C006Box290R5" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">5. Preserve external applicability decisions for collision, seismic, construction and fatigue; resolve differential pile movement/cap-wall restraint consistently with the full substructure model. The one-foot wind strip is not a coupled pier model.</paragraph> </textcell> </row>
            </table>
  <table name="C006Box291" capture="False" colwidths="1:650">
                <stylerule range="A1:A4" background="#F1F5FA" fontfamily="Times New Roman" fontsize="10" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#7189A6&quot;);"/>
                <stylerule range="A1" background="#DCE7F3" fontweight="bold"/>
                <row>
                    <textcell name="C006Box291R0" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" fontweight="bold">SELECTED TRIAL DETAIL</paragraph> </textcell> </row>
                <row>
                    <textcell name="C006Box291R1" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">One upper row; six inward/opposed fin plates total. Two designated #5 hairpins over a round bearing saddle at each fin. Fin and hairpin dimensions remain live in the tables.</paragraph> </textcell> </row>
                <row>
                    <textcell name="C006Box291R2" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Fin-root actions are exported in local right-handed axes with +z downward. Each HY row is a separate connection-development target, not a global bridge load combination.</paragraph> </textcell> </row>
                <row>
                    <textcell name="C006Box291R3" capture="False"> <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Drawings must identify the selected one-row arrangement, the fin/root reference, the designated hairpins, the fitted saddle and the retained source geometry. Local checks listed above must be completed before release.</paragraph> </textcell> </row>
            </table>
  <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">19. Checks</paragraph><embed spacingbefore="5" spacingafter="8"><table name="Checks" capture="False" colwidths="1:250, 2:95, 3:95, 4:60, 5:90"><stylerule range="A1:E19" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/><stylerule range="A1:E1" horzalign="Center" vertalign="Center"/><stylerule range="B2:E19" horzalign="Center" vertalign="Center"/><row><textcell name="ChecksR0C0" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Check</paragraph></textcell><textcell name="ChecksR0C1" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Demand</paragraph></textcell><textcell name="ChecksR0C2" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Capacity / limit</paragraph></textcell><textcell name="ChecksR0C3" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Ratio</paragraph></textcell><textcell name="ChecksR0C4" capture="False" background="#DCECE0"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" fontweight="bold" horzalign="Center">Result</paragraph></textcell></row><row><textcell name="ChecksR1C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Six wall reactions reproduce the gross wall weight.</paragraph></textcell><textcell name="ChecksR1C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR1C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR1C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_reactions" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR2C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Validity of the symmetric four-pile/six-fin reaction model.</paragraph></textcell><textcell name="ChecksR2C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR2C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR2C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_model" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR3C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Selected saddle and hairpin force points fit on the fin projection.</paragraph></textcell><textcell name="ChecksR3C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR3C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR3C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_saddle" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR4C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Hairpin tensile resistance under assigned actual gravity loads.</paragraph></textcell><textcell name="ChecksR4C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR4C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR4C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_hairpin" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR5C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Available straight-tail length exceeds the full-yield requirement.</paragraph></textcell><textcell name="ChecksR5C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR5C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR5C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_development" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR6C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Hairpin inside bend diameter satisfies the general #5 bar minimum. (LRFD Table 5.10.2.3-1)</paragraph></textcell><textcell name="ChecksR6C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR6C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR6C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_bend" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR7C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Selected fin satisfies adopted biaxial elastic/LTB resistance.</paragraph></textcell><textcell name="ChecksR7C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR7C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR7C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_plate_flex" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR8C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Selected fin satisfies root shear yielding and rupture.</paragraph></textcell><textcell name="ChecksR8C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR8C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR8C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_plate_shear" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR9C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Selected fin passes additional conservative combined-stress screen.</paragraph></textcell><textcell name="ChecksR9C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR9C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR9C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_plate_VM" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR10C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Plate geometry remains valid and inside the source wall.</paragraph></textcell><textcell name="ChecksR10C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR10C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR10C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_root" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR11C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Wind-strip flexure and minimum flexural reinforcement.</paragraph></textcell><textcell name="ChecksR11C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR11C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR11C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_strip_flex" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR12C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Wind-strip shear and transverse reinforcement area/spacing.</paragraph></textcell><textcell name="ChecksR12C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR12C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR12C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_strip_shear" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR13C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Supplementary Service I cracked-section check with FDOT amendment.</paragraph></textcell><textcell name="ChecksR13C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR13C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR13C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_service" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR14C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Shrinkage/temperature steel and maximum spacing, both directions and faces.</paragraph></textcell><textcell name="ChecksR14C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR14C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR14C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_ST" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR15C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Adopted disturbed-region grid area and twelve-inch ceiling. (LRFD 5.8.2.6)</paragraph></textcell><textcell name="ChecksR15C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR15C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR15C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_STMgrid" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR16C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">General grid clear spacing and selected cross-tie spacing.</paragraph></textcell><textcell name="ChecksR16C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR16C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR16C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_spacing" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR17C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Selected trial layout fits only within the specified pile-position envelope.</paragraph></textcell><textcell name="ChecksR17C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR17C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR17C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_fit" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row><row><textcell name="ChecksR18C0" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0">Wall length does not require an intermediate joint under the 30-foot screen. (FDOT SDG 3.10.C)</paragraph></textcell><textcell name="ChecksR18C1" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR18C2" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center"/></textcell><textcell name="ChecksR18C3" capture="False" background="#EFF7F1"><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" horzalign="Center">—</paragraph></textcell><c formula="Chk_joints" capture="False" background="#EFF7F1"><textvalue>✓ PASS</textvalue></c></row></table></embed><paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True"><dynexp formula="Status = If(Or(Chk_reactions == &quot;⊗ FAIL&quot;, Chk_model == &quot;⊗ FAIL&quot;, Chk_saddle == &quot;⊗ FAIL&quot;, Chk_hairpin == &quot;⊗ FAIL&quot;, Chk_development == &quot;⊗ FAIL&quot;, Chk_bend == &quot;⊗ FAIL&quot;, Chk_plate_flex == &quot;⊗ FAIL&quot;, Chk_plate_shear == &quot;⊗ FAIL&quot;, Chk_plate_VM == &quot;⊗ FAIL&quot;, Chk_root == &quot;⊗ FAIL&quot;, Chk_strip_flex == &quot;⊗ FAIL&quot;, Chk_strip_shear == &quot;⊗ FAIL&quot;, Chk_service == &quot;⊗ FAIL&quot;, Chk_ST == &quot;⊗ FAIL&quot;, Chk_STMgrid == &quot;⊗ FAIL&quot;, Chk_spacing == &quot;⊗ FAIL&quot;, Chk_fit == &quot;⊗ FAIL&quot;, Chk_joints == &quot;⊗ FAIL&quot;), &quot;⊗ There are FAILURES&quot;, &quot;✓ All Checks Pass&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False"><expbody>Status = If(Or(Chk_reactions == "⊗ FAIL", Chk_model == "⊗ FAIL", Chk_saddle == "⊗ FAIL", Chk_hairpin == "⊗ FAIL", Chk_development == "⊗ FAIL", Chk_bend == "⊗ FAIL", Chk_plate_flex == "⊗ FAIL", Chk_plate_shear == "⊗ FAIL", Chk_plate_VM == "⊗ FAIL", Chk_root == "⊗ FAIL", Chk_strip_flex == "⊗ FAIL", Chk_strip_shear == "⊗ FAIL", Chk_service == "⊗ FAIL", Chk_ST == "⊗ FAIL", Chk_STMgrid == "⊗ FAIL", Chk_spacing == "⊗ FAIL", Chk_fit == "⊗ FAIL", Chk_joints == "⊗ FAIL"), "⊗ There are FAILURES", "✓ All Checks Pass")</expbody><expresult> = ✓ All Checks Pass</expresult></dynexp></paragraph><paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Overall status of the recomputed numerical checks.</paragraph></report>
