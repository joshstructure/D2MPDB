  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="y_P2 = 9.109577178955078 in" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>y_P2 = 9.109577178955078 in</expbody></dynexp><break type="tab"/>bottom row 2 from the bottom face</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="y_B1 = 4.922077178955078 in" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>y_B1 = 4.922077178955078 in</expbody></dynexp><break type="tab"/>added row 1 from the bottom face</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="y_B2 = 8.922077178955078 in" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>y_B2 = 8.922077178955078 in</expbody></dynexp><break type="tab"/>added row 2 from the bottom face</paragraph>
