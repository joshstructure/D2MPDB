    <dynexp formula="φ_v = CapDesignBasis.φ_v" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>φ_v = CapDesignBasis.φ_v</expbody>
      <expresult> = 0.900</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shared journal value — CapDesignBasis.φ_v</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="γ_e = CapDesignBasis.γ_e" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>γ_e = CapDesignBasis.γ_e</expbody>
      <expresult> = 1.000</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shared journal value — CapDesignBasis.γ_e</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="λ = CapDesignBasis.λ" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>λ = CapDesignBasis.λ</expbody>
      <expresult> = 1.000</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shared journal value — CapDesignBasis.λ</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="φ_a = CapDesignBasis.φ_a" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>φ_a = CapDesignBasis.φ_a</expbody>
      <expresult> = 0.900</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shared journal value — CapDesignBasis.φ_a</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="L_cap = BridgeGeometry_2Beam.EndBentCage_envelope to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>L_cap = BridgeGeometry_2Beam.EndBentCage_envelope to in</expbody>
      <expresult> = 251.000 in</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shared journal value — BridgeGeometry_2Beam.EndBentCage_envelope</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="s_proj = CapDesignBasis.s_proj to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>s_proj = CapDesignBasis.s_proj to in</expbody>
      <expresult> = 12.000 in</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shared journal value — CapDesignBasis.s_proj</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="3" fontweight="bold" spacingbefore="4" keepwithnext="True">Actions (cap tool inputs from the analysis envelope)</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Mu_N = 79.3 kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>Mu_N = 79.3 kip*ft</expbody></dynexp><break type="tab"/>Strength moment, N</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="MI_N = 53.3 kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>MI_N = 53.3 kip*ft</expbody></dynexp><break type="tab"/>Service I moment, N</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Mu_P = 67.16 kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>Mu_P = 67.16 kip*ft</expbody></dynexp><break type="tab"/>Strength moment, P</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="MI_P = 49.33 kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>MI_P = 49.33 kip*ft</expbody></dynexp><break type="tab"/>Service I moment, P</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Mu_B = 182.09 kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>Mu_B = 182.09 kip*ft</expbody></dynexp><break type="tab"/>Strength moment, B</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="MI_B = 138.47 kip*ft" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>MI_B = 138.47 kip*ft</expbody></dynexp><break type="tab"/>Service I moment, B</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="3" fontweight="bold" spacingbefore="4" keepwithnext="True">Reinforcement</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="Bar_N1 = 6" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>Bar_N1 = 6</expbody></dynexp><break type="tab"/>top row 1 bar</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="n_N1 = 5" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>n_N1 = 5</expbody></dynexp><break type="tab"/>top row 1 count</paragraph>
