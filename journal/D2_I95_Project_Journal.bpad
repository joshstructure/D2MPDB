  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="DC_ymax = Max(1.2, 1.1*Max(DC_axial, DC_bi, DC_rs, DC_shear, DC_t, DC_svc_c, DC_svc_t, DC_pre, DC_fc, DC_size, DC_sp, DC_nbr))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
