            <heading level="1" keepwithnext="True" pagebreakbefore="break">2. Current longitudinal reinforcement</heading>
            <paragraph fontfamily="Times New Roman" fontsize="11" leftindent="0" spacingafter="2" spacingbefore="4" keepwithnext="True">
                <dynexp formula="EBSteel_topCount = CapDesignEndBentOne.n_N1" mathlayout="on" showsteps="False" seplines="False">
