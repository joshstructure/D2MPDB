        <expresult> = 0.859</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">longitudinal tension D/C</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_cr_M = Min(A_dw_M*Min(fy, 100 ksi), V_M/φ_v) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_cr_M = Min(A_dw_M*Min(fy, 100 ksi), V_M/φ_v) to kip</expbody>
        <expresult> = 111.600 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">hoop credit, developed steel</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_sh_M = Max(0 kip, V_M/φ_v - 0.5*V_cr_M) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_sh_M = Max(0 kip, V_M/φ_v - 0.5*V_cr_M) to kip</expbody>
        <expresult> = 79.784 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shear part</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_to_M = If(tor_M &gt; 0, 0.45*p_h_M*T_M/(2*A_o_M*φ_v), 0 kip) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_to_M = If(tor_M &gt; 0, 0.45*p_h_M*T_M/(2*A_o_M*φ_v), 0 kip) to kip</expbody>
        <expresult> = 0.000 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">torsion part</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="φ_m_M = If(tor_M &gt; 0, φ_v, φ_f)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>φ_m_M = If(tor_M &gt; 0, φ_v, φ_f)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">φ on the moment term</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="φ_n_M = If(tor_M &gt; 0, φ_v, φ_a)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>φ_n_M = If(tor_M &gt; 0, φ_v, φ_a)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">φ on the axial term</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_mo_M = Abs(M_M)/(φ_m_M*d_v) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_mo_M = Abs(M_M)/(φ_m_M*d_v) to kip</expbody>
        <expresult> = 63.768 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">moment term</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_ax_M = 0.5*N_M/φ_n_M to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_ax_M = 0.5*N_M/φ_n_M to kip</expbody>
        <expresult> = -5.583 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">axial term</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_di_M = cot_t_M*Sqrt(F_sh_M^2 + F_to_M^2) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_di_M = cot_t_M*Sqrt(F_sh_M^2 + F_to_M^2) to kip</expbody>
        <expresult> = 79.784 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">diagonal term</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_req_M = Max(0 kip, F_mo_M + F_ax_M + F_di_M) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_req_M = Max(0 kip, F_mo_M + F_ax_M + F_di_M) to kip</expbody>
        <expresult> = 137.969 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">required tension</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_cap_M = A_st_M*fy to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_cap_M = A_st_M*fy to kip</expbody>
        <expresult> = 332.834 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">tension capacity A_s f_y</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_L_M = F_req_M/F_cap_M" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_L_M = F_req_M/F_cap_M</expbody>
        <expresult> = 0.415</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">longitudinal tension D/C</paragraph>
  </section>
