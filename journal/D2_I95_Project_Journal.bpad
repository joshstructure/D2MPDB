        <paragraph fontfamily="Times New Roman" fontsize="1" spacingbefore="0" spacingafter="0" pagebreakafter="break"> </paragraph>
        <section name="CodePage08" capture="True" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="40" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" id="paragraphprojectcoderef08C002" textcolor="#155731" texthighlight="#DDEFE3">
                <link address="#CodeReferencesC002.CodePage08;paragraphprojectcoderef08C002">REFERENCE 08 | LRFD Eqs. 3.8.1.2.1-2 through -4</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC002.CodePage08;paragraphprojectcoderef08C002">LRFD Bridge Design Specifications, 10th Edition (2024)</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" textcolor="#536575">Printed 3-52 | Source PDF page 109</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">USED FOR</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Supplies the exposure/elevation equations and the superstructure height definition used to evaluate the wind-pressure coefficient.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Variables: Z; Z_calc; K_Z_B; K_Z_C; K_Z_D; K_Z_gov; K_Z_III</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">SCOPE / REVIEW NOTE</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Existing review item: C001 takes Z from Wind_exposureHeight, whose current formula includes Fence_ht. Confirm that enclosure-crown datum against the source definition of top of superstructure.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC002.CodePage09;paragraphprojectcoderef09C002">Related: LRFD 3.8.1.2.1; Table 3.8.1.2.1-2</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">RETURN TO CALCULATIONS</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0004">C001 | 1.1. Bridge Geometry</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0009">C001 | 3.1. K_Z for Wind Exposure Category B</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0010">C001 | 3.2. K_Z for Wind Exposure Category C</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0011">C001 | 3.3. K_Z for Wind Exposure Category D</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0012">C001 | 3.4. Governing K_Z — Selected by Exposure Category</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind.FWCodeBasis;paragraphfwcodec09">C002 | Design basis</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind;paragraphrefreturn0025">C002 | Wind acting directly on the pier</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
