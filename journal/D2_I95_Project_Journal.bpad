                <planecontainer origin="5.65000, 2.19000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#1766A0" fontfamily="Times New Roman" fontsize="9"><textvalue>z_spring</textvalue></planecontainer>
                <lineardim startpoint="1.90000, 1.90000, 0" endpoint="4.20000, 1.90000, 0" pointondimline="3.05000, 1.27000, 0" formula="2*FenceWind.R_f" linecolor="#1766A0" textcolor="#1766A0" linethickness="0.7" fontsize="9"><num>12 ft 8 in</num></lineardim>
                <planecontainer origin="2.67000, 1.02000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#1766A0" fontfamily="Times New Roman" fontsize="9"><textvalue>2 R_f</textvalue></planecontainer>
                <planecontainer origin="3.75000, 0.50000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="9"><textvalue>Cap reference</textvalue></planecontainer>
                <arrowlines pts="4.05000, 0.64000, 0; 3.16000, 0.70000, 0" linecolor="#727B84" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <planecontainer origin="2.50000, 1.72000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#727B84" fontfamily="Times New Roman" fontsize="9"><textvalue>Parapet top</textvalue></planecontainer>
                <lines pts="4.24000, 2.90000, 0; 4.23857, 2.95839, 0; 4.23427, 3.01664, 0; 4.22712, 3.07461, 0; 4.21713, 3.13216, 0; 4.20434, 3.18915, 0; 4.18876, 3.24544, 0; 4.17044, 3.30090, 0; 4.14942, 3.35539, 0; 4.12575, 3.40879, 0; 4.09949, 3.46096, 0; 4.07070, 3.51178, 0; 4.03945, 3.56113, 0; 4.00582, 3.60888, 0; 3.96988, 3.65493, 0; 3.93173, 3.69916, 0; 3.89146, 3.74146, 0; 3.84916, 3.78173, 0; 3.80493, 3.81988, 0; 3.75888, 3.85582, 0; 3.71113, 3.88945, 0; 3.66178, 3.92070, 0; 3.61096, 3.94949, 0; 3.55879, 3.97575, 0; 3.50539, 3.99942, 0; 3.45090, 4.02044, 0; 3.39544, 4.03876, 0; 3.33915, 4.05434, 0; 3.28216, 4.06713, 0; 3.22461, 4.07712, 0; 3.16664, 4.08427, 0; 3.10839, 4.08857, 0; 3.05000, 4.09000, 0; 2.99161, 4.08857, 0; 2.93336, 4.08427, 0; 2.87539, 4.07712, 0; 2.81784, 4.06713, 0; 2.76085, 4.05434, 0; 2.70456, 4.03876, 0; 2.64910, 4.02044, 0; 2.59461, 3.99942, 0; 2.54121, 3.97575, 0; 2.48904, 3.94949, 0; 2.43822, 3.92070, 0; 2.38887, 3.88945, 0; 2.34112, 3.85582, 0; 2.29507, 3.81988, 0; 2.25084, 3.78173, 0; 2.20854, 3.74146, 0; 2.16827, 3.69916, 0; 2.13012, 3.65493, 0; 2.09418, 3.60888, 0; 2.06055, 3.56113, 0; 2.02930, 3.51178, 0; 2.00051, 3.46096, 0; 1.97425, 3.40879, 0; 1.95058, 3.35539, 0; 1.92956, 3.30090, 0; 1.91124, 3.24544, 0; 1.89566, 3.18915, 0; 1.88287, 3.13216, 0; 1.87288, 3.07461, 0; 1.86573, 3.01664, 0; 1.86143, 2.95839, 0; 1.86000, 2.90000, 0" linecolor="#727B84" linepattern="Solid" linethickness=".6" />
            </canvas>
        </embed>
        <embed spacingbefore="8" spacingafter="12">
            <table name="FWContentBox2" capture="False" colwidths="1:520">
                <stylerule range="A1:A7" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);" />
                <stylerule range="A1" background="#DCE7F3" fontweight="bold" />
                <row>
                    <textcell name="FWBox2Row1" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">GEOMETRY KEY</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox2Row2" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">
                            • 
                            <dynexp formula="h_f" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                                <expbody>h_f</expbody>
                            </dynexp>
                             — Vertical distance from the top of the parapet to the crown of the fence, including the straight leg and the curved rise.
                        </paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox2Row3" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">
                            • 
                            <dynexp formula="h_tan" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                                <expbody>h_tan</expbody>
                            </dynexp>
                             — Height of only the straight upright portion, from the fence base to the point where the semicircle begins.
                        </paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox2Row4" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">
                            • 
                            <dynexp formula="R_f" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                                <expbody>R_f</expbody>
                            </dynexp>
                            — Radius at the post centerline. The gross wind silhouette uses the separate outer hoop rise.
                        </paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox2Row5" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">
                            • 
                            <dynexp formula="z_base" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                                <expbody>z_base</expbody>
                            </dynexp>
                             — Height of the fence base above the cap reference used for moments. The fence base is at the parapet top.
                        </paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox2Row6" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">
                            • 
                            <dynexp formula="z_spring" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                                <expbody>z_spring</expbody>
                            </dynexp>
                             — Height of the hoop center and the start of the curve above the cap reference; it equals fence-base height plus straight-leg height.
                        </paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox2Row7" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Dimension values are live; drawing proportions are schematic.</paragraph>
                    </textcell>
                </row>
            </table>
        </embed>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="8" spacingafter="4" fontweight="bold" keepwithnext="True">Fence dimensions and reference heights</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep02;paragraphfwstrategy02">STEP 2 OF 7 | Fence geometry and tributary length</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="h_f = BridgeGeometry_2Beam.Fence_ht" showsteps="False" seplines="False">
                <expbody>h_f = BridgeGeometry_2Beam.Fence_ht</expbody>
                <expresult> = 9 ft 8 5/16 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Vertical height from the fence base to the top of the hoop.</paragraph>
        <section name="EqNotes_FenceWind_001_h_f" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7">Reference the outer gross fence height from Bridge Geometry_2 Beam. Its base is the parapet top; its crown is the outside hoop surface.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep02;paragraphfwstrategy02">STEP 2 OF 7 | Fence geometry and tributary length</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="R_f = BridgeGeometry_2Beam.Fence_radius" showsteps="False" seplines="False">
                <expbody>R_f = BridgeGeometry_2Beam.Fence_radius</expbody>
                <expresult> = 6 ft 4 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Radius of the semicircular hoop, measured to the post centerline.</paragraph>
        <section name="EqNotes_FenceWind_002_R_f" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7">Reference the post-centerline hoop radius defined in Bridge Geometry_2 Beam. The outer rise used for gross wind height is slightly larger.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep02;paragraphfwstrategy02">STEP 2 OF 7 | Fence geometry and tributary length</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="z_base = BridgeGeometry_2Beam.Fence_base_CapCG" showsteps="False" seplines="False">
                <expbody>z_base = BridgeGeometry_2Beam.Fence_base_CapCG</expbody>
                <expresult> = 9 ft 3.562 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Height of the fence base above the point used for cap moments.</paragraph>
        <section name="EqNotes_FenceWind_003_z_base" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7">Reference the fence-base moment arm from Bridge Geometry_2 Beam. The retained cap-reference and concrete-depth assumptions require confirmation.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep02;paragraphfwstrategy02">STEP 2 OF 7 | Fence geometry and tributary length</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="h_tan = BridgeGeometry_2Beam.Fence_straight_ht" showsteps="False" seplines="False">
                <expbody>h_tan = BridgeGeometry_2Beam.Fence_straight_ht</expbody>
                <expresult> = 3 ft 2 9/16 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Height of each straight vertical fence leg.</paragraph>
        <section name="EqNotes_FenceWind_004_h_tan" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7">Reference the dimensioned straight leg directly. Do not subtract the centerline radius from the outer gross fence height; those dimensions end at different surfaces.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep02;paragraphfwstrategy02">STEP 2 OF 7 | Fence geometry and tributary length</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="z_spring = BridgeGeometry_2Beam.Fence_spring_CapCG" showsteps="False" seplines="False">
                <expbody>z_spring = BridgeGeometry_2Beam.Fence_spring_CapCG</expbody>
                <expresult> = 12 ft 6 1/8 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Height where the straight fence legs begin to curve.</paragraph>
        <section name="EqNotes_FenceWind_005_z_spring" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7">Reference the springline height from the geometry module. It equals the fence-base arm plus the dimensioned straight leg.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep02;paragraphfwstrategy02">STEP 2 OF 7 | Fence geometry and tributary length</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="z_mid = BridgeGeometry_2Beam.Fence_CG_CapCG" showsteps="False" seplines="False">
                <expbody>z_mid = BridgeGeometry_2Beam.Fence_CG_CapCG</expbody>
                <expresult> = 14 ft 1 23/32 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Height used to apply the along-bridge fence force.</paragraph>
        <section name="EqNotes_FenceWind_006_z_mid" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7">Reference the centroid of the gross projected fence outline in the geometry module. The underlying cap-reference arm remains provisional.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="8" spacingafter="4" fontweight="bold" keepwithnext="True">Tributary length delivered to this pier</paragraph>
        <embed spacingafter="8">
            <canvas title="D. Intermediate-pier tributary length - longitudinal elevation" name="FWTributarySketch" unit="in" size="6.5 in; 3.3 in; scaletofit">
                <include target="Library.Geometry" />
                <lines pts="0.05000, 0.05000, 0; 6.45000, 0.05000, 0; 6.45000, 3.25000, 0; 0.05000, 3.25000, 0; 0.05000, 0.05000, 0" linecolor="#D7DFE6" linethickness="1.2" linepattern="Solid" />
                <planecontainer origin="0.18000, 3.03000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="11"><textvalue>Step 2: Tributary length — longitudinal elevation</textvalue></planecontainer>
                <planecontainer origin="0.18000, 0.16000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#727B84" fontfamily="Times New Roman" fontsize="8"><textvalue>SCHEMATIC - NOT TO SCALE</textvalue></planecontainer>
                <lines pts="0.57000, 1.40000, 0; 5.95000, 1.40000, 0" linecolor="#29333D" linethickness="2" linepattern="Solid" />
                <lines pts="0.45000, 1.15000, 0; 0.57000, 1.40000, 0; 0.69000, 1.15000, 0; 0.45000, 1.15000, 0" linecolor="#29333D" linethickness="1.2" linepattern="Solid" />
                <planecontainer origin="0.72, 0.95, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="9"><textvalue>End bent 1</textvalue></planecontainer>
                <lines pts="3.10000, 1.15000, 0; 3.22000, 1.40000, 0; 3.34000, 1.15000, 0; 3.10000, 1.15000, 0" linecolor="#29333D" linethickness="1.2" linepattern="Solid" />
                <planecontainer origin="3.40, 0.95, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="9"><textvalue>Pier</textvalue></planecontainer>
                <lines pts="5.83000, 1.15000, 0; 5.95000, 1.40000, 0; 6.07000, 1.15000, 0; 5.83000, 1.15000, 0" linecolor="#29333D" linethickness="1.2" linepattern="Solid" />
                <planecontainer origin="5.07, 0.95, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="9"><textvalue>End bent 2</textvalue></planecontainer>
                <arrowlines pts="0.72000, 2.04000, 0; 0.72000, 1.55000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="1.09000, 2.04000, 0; 1.09000, 1.55000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="1.46000, 2.04000, 0; 1.46000, 1.55000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="1.83000, 2.04000, 0; 1.83000, 1.55000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="2.20000, 2.04000, 0; 2.20000, 1.55000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="2.57000, 2.04000, 0; 2.57000, 1.55000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="2.94000, 2.04000, 0; 2.94000, 1.55000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="3.31000, 2.04000, 0; 3.31000, 1.55000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="3.68000, 2.04000, 0; 3.68000, 1.55000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="4.05000, 2.04000, 0; 4.05000, 1.55000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="4.42000, 2.04000, 0; 4.42000, 1.55000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="4.79000, 2.04000, 0; 4.79000, 1.55000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="5.16000, 2.04000, 0; 5.16000, 1.55000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="5.53000, 2.04000, 0; 5.53000, 1.55000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="5.90000, 2.04000, 0; 5.90000, 1.55000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <planecontainer origin="1.55000, 2.72000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#C83C32" fontfamily="Times New Roman" fontsize="9"><textvalue>Uniform wind load w along both spans</textvalue></planecontainer>
                <lineardim startpoint="1.89500, 1.40000, 0" endpoint="4.58500, 1.40000, 0" pointondimline="3.22000, 2.36000, 0" formula="FenceWind.L_trib" linecolor="#1766A0" textcolor="#1766A0" linethickness="0.7" fontsize="9"><num>106 ft 1.5 in</num></lineardim>
                <planecontainer origin="1.20, 2.40, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#1766A0" fontfamily="Times New Roman" fontsize="9"><textvalue>L_trib</textvalue></planecontainer>
                <lines pts="1.89500, 1.05000, 0; 1.89500, 2.05000, 0" linecolor="#1766A0" linethickness="1.2" linepattern="Dashes" />
                <lines pts="4.58500, 1.05000, 0; 4.58500, 2.05000, 0" linecolor="#1766A0" linethickness="1.2" linepattern="Dashes" />
                <lineardim startpoint="0.57000, 1.40000, 0" endpoint="3.22000, 1.40000, 0" pointondimline="1.80000, 0.63000, 0" formula="BridgeGeometry_2Beam.Span_1" linecolor="#1766A0" textcolor="#1766A0" linethickness="0.7" fontsize="9"><num>107.34999999999991 ft</num></lineardim>
                <lineardim startpoint="3.22000, 1.40000, 0" endpoint="5.95000, 1.40000, 0" pointondimline="4.70000, 0.63000, 0" formula="BridgeGeometry_2Beam.Span_2" linecolor="#1766A0" textcolor="#1766A0" linethickness="0.7" fontsize="9"><num>104.90000000000009 ft</num></lineardim>
                <planecontainer origin="1.52000, 0.36000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#1766A0" fontfamily="Times New Roman" fontsize="9"><textvalue>Span_1</textvalue></planecontainer>
                <planecontainer origin="4.34000, 0.36000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#1766A0" fontfamily="Times New Roman" fontsize="9"><textvalue>Span_2</textvalue></planecontainer>
            </canvas>
        </embed>
        <embed spacingbefore="8" spacingafter="12">
            <table name="FWContentBox9" capture="False" colwidths="1:520">
                <stylerule range="A1:A2" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);" />
                <stylerule range="A1" background="#DCE7F3" fontweight="bold" />
                <row>
                    <textcell name="FWBox9Row1" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">TRIBUTARY LENGTH — TWO SIMPLY SUPPORTED SPANS</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox9Row2" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Assume uniform wind loading along both spans.</paragraph>
                    </textcell>
                </row>
            </table>
        </embed>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep02;paragraphfwstrategy02">STEP 2 OF 7 | Fence geometry and tributary length</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0" level="1">
            <dynexp mathlayout="on" formula="L_trib = BridgeGeometry_2Beam.Pier_tributaryLength" showsteps="False" seplines="False">
                <expbody>L_trib = BridgeGeometry_2Beam.Pier_tributaryLength</expbody>
                <expresult> = 106 ft 1.5 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Bridge length used to turn a uniform load per foot into a total pier load.</paragraph>
        <section name="EqNotes_FenceWind_007_L_trib" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7">Reference the pier tributary length from the geometry module. It is half the sum of the two simply supported spans.</paragraph>
        </section>
        <embed spacingbefore="8" spacingafter="4">
            <table name="FWContentBox20" capture="False" colwidths="1:520">
                <stylerule range="A1" background="#F7E6B9" fontweight="bold" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#A78638&quot;);" />
                <row>
                    <textcell capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" fontweight="bold" spacingbefore="8">LIVE GEOMETRY INPUTS</paragraph>
                    </textcell>
                </row>
            </table>
        </embed>
        <embed spacingafter="10">
            <table name="FWGeometryInputs" title="Geometry input route" capture="False" colwidths="1:80, 2:125, 3:315">
                <stylerule range="A1:C6" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#B7C2CC&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 1, &quot;#B7C2CC&quot;);" fontfamily="Times New Roman" fontsize="10" />
                <stylerule range="A1:C1" background="#E2EAF1" fontweight="bold" />
                <row>
                    <c capture="False"><textvalue>Parameter</textvalue></c>
                    <c capture="False"><textvalue>Value</textvalue></c>
                    <c capture="False"><textvalue>Source / meaning</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>h_f</textvalue></c>
                    <c capture="False" formula="h_f"><num>9 ft 8 5/16 in</num></c>
                    <c capture="False"><textvalue>BridgeGeometry.Fence_ht; exposed fence height</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>R_f</textvalue></c>
                    <c capture="False" formula="R_f"><num>6 ft 4 in</num></c>
                    <c capture="False"><textvalue>Inside parapet spacing and parapet width</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>z_base</textvalue></c>
                    <c capture="False" formula="z_base"><num>9 ft 3.5619999999999976 in</num></c>
                    <c capture="False"><textvalue>Concrete wind centroid + half concrete depth</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>z_mid</textvalue></c>
                    <c capture="False" formula="z_mid"><num>14 ft 1 23/32 in</num></c>
                    <c capture="False"><textvalue>Fence projected-height midpoint</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>L_trib</textvalue></c>
                    <c capture="False" formula="L_trib"><num>106 ft 1.5 in</num></c>
                    <c capture="False"><textvalue>BridgeGeometry.TotalSpan / 2</textvalue></c>
                </row>
                <stylerule range="A1:C6" background="#FFF8E9" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#A78638&quot;);" />
                <stylerule range="A1:C1" background="#F7E6B9" fontweight="bold" />
            </table>
        </embed>
        <section name="FWStrategyWork03" capture="False" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="4" spacingbefore="12" fontweight="bold" textcolor="#1766A0" keepwithnext="True" id="paragraphfwstrategywork03" texthighlight="#EDF3F8">
                <link address="#FenceWind.FWStrategyStep03;paragraphfwstrategy03">STEP 3 OF 7 | Prescribed LRFD 13.8.2 fence load</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8">
                Use the prescribed
                <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
                gross-surface pressure to form one fence resultant for the pier tributary length.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="8" textcolor="#43556B">
                Code basis:
                <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
            </paragraph>
        </section>
        <embed spacingafter="12">
            <table name="FWSectionIntro3" title="Section introduction" capture="False" colwidths="1:90, 2:430">
                <stylerule range="A1:B3" background="#EDF3F8" fontfamily="Times New Roman" fontsize="10" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#1766A0&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 1, &quot;#CCD9E5&quot;);" />
                <stylerule range="A1:A3" fontweight="bold" />
                <row>
                    <c capture="False"><textvalue>Objective</textvalue></c>
                    <c capture="False"><textvalue>Calculate the prescribed fence resultant.</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Inputs</textvalue></c>
                    <c capture="False"><textvalue>Fence geometry; LRFD 13.8.2 pressure; tributary length.</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Output</textvalue></c>
                    <c capture="False"><textvalue>One fence force, one fence moment, zero net vertical force, and an equivalent force height.</textvalue></c>
                </row>
                <stylerule range="A1:B1" background="#F1F5FA" />
                <stylerule range="A2:B2" background="#FFF8E9" />
                <stylerule range="A3:B3" background="#EFF7F1" />
            </table>
        </embed>
        <embed spacingafter="8">
            <canvas title="C. LRFD 13.8.2 one-face projected fence load" name="FWPressureSketch" unit="in" size="6.5 in; 3.9 in; scaletofit">
                <include target="Library.Geometry" />
                <lines pts="0.05000, 0.05000, 0; 6.45000, 0.05000, 0; 6.45000, 3.85000, 0; 0.05000, 3.85000, 0; 0.05000, 0.05000, 0" linecolor="#D7DFE6" linethickness="1.2" linepattern="Solid" />
                <planecontainer origin="0.18000, 3.63000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="11"><textvalue>Step 3: LRFD 13.8.2 — one wind-exposed projected fence face</textvalue></planecontainer>
                <planecontainer origin="0.18000, 0.16000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#727B84" fontfamily="Times New Roman" fontsize="8"><textvalue>SCHEMATIC - NOT TO SCALE</textvalue></planecontainer>
                <lines pts="0.92000, 0.99000, 0; 0.92000, 1.73000, 0" linecolor="#29333D" linethickness="1.2" linepattern="Solid" />
                <lines pts="2.42000, 1.73000, 0; 2.41839, 1.77905, 0; 2.41358, 1.82789, 0; 2.40559, 1.87632, 0; 2.39444, 1.92411, 0; 2.38020, 1.97108, 0; 2.36291, 2.01701, 0; 2.34265, 2.06172, 0; 2.31952, 2.10500, 0; 2.29360, 2.14668, 0; 2.26502, 2.18657, 0; 2.23388, 2.22451, 0; 2.20033, 2.26033, 0; 2.16451, 2.29388, 0; 2.12657, 2.32502, 0; 2.08668, 2.35360, 0; 2.04500, 2.37952, 0; 2.00172, 2.40265, 0; 1.95701, 2.42291, 0; 1.91108, 2.44020, 0; 1.86411, 2.45444, 0; 1.81632, 2.46559, 0; 1.76789, 2.47358, 0; 1.71905, 2.47839, 0; 1.67000, 2.48000, 0; 1.62095, 2.47839, 0; 1.57211, 2.47358, 0; 1.52368, 2.46559, 0; 1.47589, 2.45444, 0; 1.42892, 2.44020, 0; 1.38299, 2.42291, 0; 1.33828, 2.40265, 0; 1.29500, 2.37952, 0; 1.25332, 2.35360, 0; 1.21343, 2.32502, 0; 1.17549, 2.29388, 0; 1.13967, 2.26033, 0; 1.10612, 2.22451, 0; 1.07498, 2.18657, 0; 1.04640, 2.14668, 0; 1.02048, 2.10500, 0; 0.99735, 2.06172, 0; 0.97709, 2.01701, 0; 0.95980, 1.97108, 0; 0.94556, 1.92411, 0; 0.93441, 1.87632, 0; 0.92642, 1.82789, 0; 0.92161, 1.77905, 0; 0.92000, 1.73000, 0" linecolor="#29333D" linethickness="1.2" linepattern="Solid" />
                <lines pts="2.42000, 1.73000, 0; 2.42000, 0.99000, 0" linecolor="#29333D" linethickness="1.2" linepattern="Solid" />
                <lines pts="0.92000, 1.73000, 0; 2.42000, 1.73000, 0" linecolor="#727B84" linethickness="1.2" linepattern="Dashes" />
                <arrowlines pts="0.40000, 1.10000, 0; 0.92000, 1.10000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="0.40000, 1.40000, 0; 0.92000, 1.40000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="0.40000, 1.95000, 0; 0.96000, 1.95000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="0.40000, 2.20000, 0; 1.11000, 2.20000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <arrowlines pts="0.40000, 2.39000, 0; 1.31000, 2.39000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <planecontainer origin="0.38000, 2.72000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#C83C32" fontfamily="Times New Roman" fontsize="10"><textvalue>p_fence = 0.015 ksf</textvalue></planecontainer>
                <planecontainer origin="1.00000, 0.69000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#727B84" fontfamily="Times New Roman" fontsize="9"><textvalue>Wind-exposed face</textvalue></planecontainer>
                <arrowlines pts="2.80000, 1.73000, 0; 4.00000, 1.73000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <planecontainer origin="3.10, 1.82, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#C83C32" fontfamily="Times New Roman" fontsize="10"><textvalue>F_fence</textvalue></planecontainer>
                <planecontainer origin="3.05000, 3.05000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="10"><textvalue>GLOBAL BRIDGE-TRANSFER MODEL</textvalue></planecontainer>
                <planecontainer origin="3.05000, 2.65000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="9"><textvalue>• One gross projected face loaded once</textvalue></planecontainer>
                <planecontainer origin="3.05000, 2.35000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="9"><textvalue>• No simultaneous leeward 15 psf load</textvalue></planecontainer>
                <planecontainer origin="3.05000, 2.05000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="9"><textvalue>• Opposite wind direction reverses sign</textvalue></planecontainer>
                <planecontainer origin="3.05000, 1.35000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#1766A0" fontfamily="Times New Roman" fontsize="9"><textvalue>z_eff = z_mid</textvalue></planecontainer>
                <planecontainer origin="3.05000, 1.05000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#727B84" fontfamily="Times New Roman" fontsize="8"><textvalue>Local member/attachment design is separate</textvalue></planecontainer>
            </canvas>
        </embed>
        <embed spacingbefore="8" spacingafter="12">
            <table name="FWContentBox6" capture="False" colwidths="1:520">
                <stylerule range="A1:A5" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);" />
                <stylerule range="A1" background="#DCE7F3" fontweight="bold" />
                <row>
                    <textcell capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" spacingbefore="8" fontweight="bold">PRESSURE DIRECTIONS</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• The 0.015 ksf pressure acts normal to the entire gross fence surface.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• For global bridge transfer, the 0.015 ksf load is applied once to the wind-exposed projected face for the selected wind direction.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• No second simultaneous leeward 15 psf load or leeward reduction factor is used; the opposite wind direction is a sign-reversed case.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Arrow lengths are schematic; the equations below govern the numerical result.</paragraph>
                    </textcell>
                </row>
            </table>
        </embed>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="2" spacingbefore="4" fontweight="bold" textcolor="#1766A0" keepwithnext="True" texthighlight="#EDF3F8">
            STEP 3 OF 7 | Prescribed
            <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
            fence load
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0">
            <dynexp mathlayout="on" formula="p_fence = 0.015 ksf" showsteps="False" seplines="False">
                <expbody>p_fence = 0.015 ksf</expbody>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Prescribed normal pressure on the complete metal-fabric fence surface.</paragraph>
        <section name="EqNotes_FenceWind_008_p_fence" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8" level="1">Apply this pressure to the gross fence outline, including the mesh openings. No second solidity/drag-based fence pressure is calculated.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="8" level="1" textcolor="#43556B">
            Code basis:
            <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="2" spacingbefore="4" fontweight="bold" textcolor="#1766A0" keepwithnext="True" texthighlight="#EDF3F8">
            STEP 3 OF 7 | Prescribed
            <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
            fence load
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0">
            <dynexp mathlayout="on" formula="a_T_fence = h_f" showsteps="False" seplines="False">
                <expbody>a_T_fence = h_f</expbody>
                <expresult> = 9 ft 8 5/16 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Gross projected fence height for one wind direction.</paragraph>
        <section name="EqNotes_FenceWind_009_a_T_fence" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8" level="1">For global bridge load transfer, the curved enclosure is represented by its gross projected vertical height for the selected wind direction.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="2" spacingbefore="4" fontweight="bold" textcolor="#1766A0" keepwithnext="True" texthighlight="#EDF3F8">
            STEP 3 OF 7 | Prescribed
            <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
            fence load
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0">
            <dynexp mathlayout="on" formula="b_M_fence = a_T_fence*z_mid" showsteps="False" seplines="False">
                <expbody>b_M_fence = a_T_fence*z_mid</expbody>
                <expresult> = 137.086 ft^2</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">First moment of the one-face gross projected fence area about the cap reference.</paragraph>
        <section name="EqNotes_FenceWind_010_b_M_fence" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8" level="1">The projected global fence load is represented as a uniform horizontal pressure over the full projected fence height, so its first moment equals projected height times z_mid.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="2" spacingbefore="4" fontweight="bold" textcolor="#1766A0" keepwithnext="True" texthighlight="#EDF3F8">
            STEP 3 OF 7 | Prescribed
            <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
            fence load
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0">
            <dynexp mathlayout="on" formula="z_eff = b_M_fence/a_T_fence" showsteps="False" seplines="False">
                <expbody>z_eff = b_M_fence/a_T_fence</expbody>
                <expresult> = 14 9/64 ft</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Equivalent height of the transverse fence resultant above the cap reference.</paragraph>
        <section name="EqNotes_FenceWind_011_z_eff" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8" level="1">A horizontal fence force applied at this projected-area centroid creates the same cap-reference moment as the adopted one-face global fence load.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="2" spacingbefore="4" fontweight="bold" textcolor="#1766A0" keepwithnext="True" texthighlight="#EDF3F8">
            STEP 3 OF 7 | Prescribed
            <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
            fence load
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0">
            <dynexp mathlayout="on" formula="w_fence = p_fence*a_T_fence" showsteps="False" seplines="False">
                <expbody>w_fence = p_fence*a_T_fence</expbody>
                <expresult> = 0.145 ksf*ft</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Horizontal fence force per foot of bridge.</paragraph>
        <section name="EqNotes_FenceWind_012_w_fence" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8" level="1">Multiply the prescribed pressure by the one wind-exposed gross projected fence height. The opposite wind direction is a separate sign-reversed case; no second simultaneous leeward 15 psf load is added.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="2" spacingbefore="4" fontweight="bold" textcolor="#1766A0" keepwithnext="True" texthighlight="#EDF3F8">
            STEP 3 OF 7 | Prescribed
            <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
            fence load
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0">
            <dynexp mathlayout="on" formula="F_fence = w_fence*L_trib" showsteps="False" seplines="False">
                <expbody>F_fence = w_fence*L_trib</expbody>
                <expresult> = 15.430 kip</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Total transverse fence force delivered to the intermediate pier.</paragraph>
        <section name="EqNotes_FenceWind_013_F_fence" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8" level="1">Multiply the fence force per bridge foot by the tributary length carried by the pier.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="2" spacingbefore="4" fontweight="bold" textcolor="#1766A0" keepwithnext="True" texthighlight="#EDF3F8">
            STEP 3 OF 7 | Prescribed
            <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
            fence load
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0">
            <dynexp mathlayout="on" formula="M_fence = F_fence*z_eff" showsteps="False" seplines="False">
                <expbody>M_fence = F_fence*z_eff</expbody>
                <expresult> = 218.224 kip*ft</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Fence moment about the longitudinal axis through the cap reference.</paragraph>
        <section name="EqNotes_FenceWind_014_M_fence" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8" level="1">Use the projected-area centroid so the single horizontal force reproduces the adopted fence moment about the cap reference.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="2" spacingbefore="4" fontweight="bold" textcolor="#1766A0" keepwithnext="True" texthighlight="#EDF3F8">
            STEP 3 OF 7 | Prescribed
            <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
            fence load
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0">
            <dynexp mathlayout="on" formula="F_V_fence = 0*F_fence" showsteps="False" seplines="False">
                <expbody>F_V_fence = 0*F_fence</expbody>
                <expresult> = 0 kip</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Vertical fence component in the global projected-load model.</paragraph>
        <section name="EqNotes_FenceWind_015_F_V_fence" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8" level="1">The global bridge-transfer model uses one horizontal projected fence resultant for each wind direction. No separate vertical fence component is introduced here; local fence-member and attachment design remains a separate check.</paragraph>
        </section>
        <embed spacingbefore="8" spacingafter="12">
            <table name="FWFenceResultBox" capture="False" colwidths="1:520">
                <stylerule range="A1:A5" background="#EFF7F1" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#6A9075&quot;);" />
                <stylerule range="A1" background="#DCECE0" fontweight="bold" />
                <row>
                    <textcell capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" spacingbefore="8" fontweight="bold">PRESCRIBED FENCE RESULTANT</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">
                            • 
                            <dynexp formula="F_fence">
                                <expbody>F_fence</expbody>
                                <expresult> = 15.430 kip</expresult>
                            </dynexp>
                             transverse at the pier tributary length.
                        </paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">
                            • 
                            <dynexp formula="M_fence">
                                <expbody>M_fence</expbody>
                                <expresult> = 218.224 kip*ft</expresult>
                            </dynexp>
                            bout the cap-reference longitudinal axis.
                        </paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• z_eff = M_fence / F_fence locates an equivalent single transverse force.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• The same prescribed fence resultant is used in the displayed Strength III and Service I wind sets.</paragraph>
                    </textcell>
                </row>
            </table>
        </embed>
        <section name="FWStrategyWork04" capture="False" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="4" spacingbefore="12" fontweight="bold" textcolor="#1766A0" keepwithnext="True" id="paragraphfwstrategywork04" texthighlight="#EDF3F8">
                <link address="#FenceWind.FWStrategyStep04;paragraphfwstrategy04">STEP 4 OF 7 | Simplified superstructure wind components</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8">Combine the concrete superstructure and prescribed fence resultants, verify the simplified-method limits, and form one simultaneous 100% transverse + 25% longitudinal load set for each limit state.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="8" textcolor="#43556B">
                Code basis:
                <link address="#CodeReferencesC002.CodePage10;paragraphprojectcoderef10C002">LRFD 3.8.1.2.3a</link>
                ;
                <link address="#CodeReferencesC002.CodePage14;paragraphprojectcoderef14C002">LRFD Table 3.4.1-1</link>
            </paragraph>
        </section>
        <embed spacingafter="12">
            <table name="FWSectionIntro4" title="Section introduction" capture="False" colwidths="1: 90, 2: 504.5">
                <stylerule range="A1:B3" background="#EDF3F8" fontfamily="Times New Roman" fontsize="10" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#1766A0&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 1, &quot;#CCD9E5&quot;);" />
                <stylerule range="A1:A3" fontweight="bold" />
                <row>
                    <c capture="False"><textvalue>Objective</textvalue></c>
                    <c capture="False"><textvalue>Use the LRFD simplified girder-bridge wind components in lieu of an angle sweep.</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Inputs</textvalue></c>
                    <c capture="False"><textvalue>Perpendicular bridge/fence resultant; span and height qualification; 100%/25% factors.</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Output</textvalue></c>
                    <c capture="False"><textvalue>One simultaneous cap-reference T/L force-and-moment set for Strength III and Service I.</textvalue></c>
                </row>
                <stylerule range="A1:B1" background="#F1F5FA" />
                <stylerule range="A2:B2" background="#FFF8E9" />
                <stylerule range="A3:B3" background="#EFF7F1" />
            </table>
        </embed>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="8" spacingafter="4" fontweight="bold" keepwithnext="True">Concrete and combined perpendicular-wind basis — Strength III</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep04;paragraphfwstrategy04">STEP 4 OF 7 | Simplified superstructure wind components</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="F_c_III=C001WindLoadOnPedBridgeSuperstructure.P_Z_III*BridgeGeometry_2Beam.Depth_SuperStr*L_trib" showsteps="False" seplines="False">
                <expbody>F_c_III=C001WindLoadOnPedBridgeSuperstructure.P_Z_III*BridgeGeometry_2Beam.Depth_SuperStr*L_trib</expbody>
                <expresult> = 36.637 kip</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Total Strength III concrete superstructure force delivered across the bridge to the pier.</paragraph>
        <section name="EqNotes_FenceWind_016_F_c_III" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">
                <dynexp formula="C001WindLoadOnPedBridgeSuperstructure.P_Z_III" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>C001WindLoadOnPedBridgeSuperstructure.P_Z_III</expbody>
                </dynexp>
                 is the concrete wind pressure from the main wind module. Multiply it by 
                <dynexp formula="BridgeGeometry_2Beam.Depth_SuperStr" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>BridgeGeometry_2Beam.Depth_SuperStr</expbody>
                </dynexp>
                , the vertical concrete depth seen by the wind, to obtain force per foot along the bridge.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">
                Multiply that line load by 
                <dynexp formula="L_trib" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>L_trib</expbody>
                </dynexp>
                , the equivalent bridge length carried by this pier. Pressure times exposed height times contributing length gives the total concrete force. The fence has its own separate force calculation.
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep04;paragraphfwstrategy04">STEP 4 OF 7 | Simplified superstructure wind components</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="M_c_III=F_c_III*BridgeGeometry_2Beam.Dist_windSuperCG_CapCG" showsteps="False" seplines="False">
                <expbody>M_c_III=F_c_III*BridgeGeometry_2Beam.Dist_windSuperCG_CapCG</expbody>
                <expresult> = 210.856 kip*ft</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Strength III moment caused by the concrete superstructure force acting above the cap.</paragraph>
        <section name="EqNotes_FenceWind_017_M_c_III" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">
                <dynexp formula="F_c_III" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>F_c_III</expbody>
                </dynexp>
                 is the transverse concrete force delivered to the pier. 
                <dynexp formula="BridgeGeometry_2Beam.Dist_windSuperCG_CapCG" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>BridgeGeometry_2Beam.Dist_windSuperCG_CapCG</expbody>
                </dynexp>
                 is the vertical distance from the cap reference to the center of the concrete wind area.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">Multiply force by that distance to obtain its turning effect about the longitudinal axis through the cap reference. The units are force times length, such as kip-feet.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8" id="paragraphrefreturn0023">
            <link address="#FenceWind.FWStrategyStep04;paragraphfwstrategy04">STEP 4 OF 7 | Simplified superstructure wind components</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0" level="1">
            <dynexp mathlayout="on" formula="F_cap_T_III = F_c_III + F_fence" showsteps="False" seplines="False">
                <expbody>F_cap_T_III = F_c_III + F_fence</expbody>
                <expresult> = 52.067 kip</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">
            Total across-bridge force at the cap reference: Strength III,
            <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
            fence load.
        </paragraph>
        <section name="EqNotes_FenceWind_018_F_cap_T_III" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">
                Add 
                <dynexp formula="F_c_III" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>F_c_III</expbody>
                </dynexp>
                , the concrete superstructure force delivered to the pier, to 
                <dynexp formula="F_fence" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>F_fence</expbody>
                </dynexp>
                , the fence force delivered to the same pier for this pressure case.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">Both are total forces in the same direction, so they can be added directly. Direct wind on the pier wall and cap itself is handled separately. This total is applied once, not repeated in full at each analysis node.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep04;paragraphfwstrategy04">STEP 4 OF 7 | Simplified superstructure wind components</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0" level="1">
            <dynexp mathlayout="on" formula="M_cap_L_III = M_c_III + M_fence" showsteps="False" seplines="False">
                <expbody>M_cap_L_III = M_c_III + M_fence</expbody>
                <expresult> = 429.080 kip*ft</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">
            Total moment about the longitudinal axis at the cap reference: Strength III,
            <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
            fence load.
        </paragraph>
        <section name="EqNotes_FenceWind_019_M_cap_L_III" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">
                Add 
                <dynexp formula="M_c_III" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>M_c_III</expbody>
                </dynexp>
                , the concrete superstructure’s moment about the cap reference, to 
                <dynexp formula="M_fence" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>M_fence</expbody>
                </dynexp>
                , the fence moment about that same reference.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">Each term already includes its own force location and resulting turning effect. Use the matching total force from this same pressure case when applying the force-and-moment set.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Apply the cap resultants once; do not also reapply the forces at their original heights.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="8" spacingafter="4" fontweight="bold" keepwithnext="True">Concrete and combined perpendicular-wind basis — Service I</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep04;paragraphfwstrategy04">STEP 4 OF 7 | Simplified superstructure wind components</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="F_c_SI=C001WindLoadOnPedBridgeSuperstructure.P_Z_SI*BridgeGeometry_2Beam.Depth_SuperStr*L_trib" showsteps="False" seplines="False">
                <expbody>F_c_SI=C001WindLoadOnPedBridgeSuperstructure.P_Z_SI*BridgeGeometry_2Beam.Depth_SuperStr*L_trib</expbody>
                <expresult> = 10.420 kip</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Total Service I concrete superstructure force delivered across the bridge to the pier.</paragraph>
        <section name="EqNotes_FenceWind_020_F_c_SI" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">
                <dynexp formula="C001WindLoadOnPedBridgeSuperstructure.P_Z_SI" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>C001WindLoadOnPedBridgeSuperstructure.P_Z_SI</expbody>
                </dynexp>
                 is the concrete wind pressure from the main wind module. Multiply it by 
                <dynexp formula="BridgeGeometry_2Beam.Depth_SuperStr" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>BridgeGeometry_2Beam.Depth_SuperStr</expbody>
                </dynexp>
                , the vertical concrete depth seen by the wind, to obtain force per foot along the bridge.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">
                Multiply that line load by 
                <dynexp formula="L_trib" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>L_trib</expbody>
                </dynexp>
                , the equivalent bridge length carried by this pier. Pressure times exposed height times contributing length gives the total concrete force. The fence has its own separate force calculation.
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep04;paragraphfwstrategy04">STEP 4 OF 7 | Simplified superstructure wind components</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="M_c_SI=F_c_SI*BridgeGeometry_2Beam.Dist_windSuperCG_CapCG" showsteps="False" seplines="False">
                <expbody>M_c_SI=F_c_SI*BridgeGeometry_2Beam.Dist_windSuperCG_CapCG</expbody>
                <expresult> = 59.967 kip*ft</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Service I moment caused by the concrete superstructure force acting above the cap.</paragraph>
        <section name="EqNotes_FenceWind_021_M_c_SI" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">
                <dynexp formula="F_c_SI" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>F_c_SI</expbody>
                </dynexp>
                 is the transverse concrete force delivered to the pier. 
                <dynexp formula="BridgeGeometry_2Beam.Dist_windSuperCG_CapCG" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>BridgeGeometry_2Beam.Dist_windSuperCG_CapCG</expbody>
                </dynexp>
                 is the vertical distance from the cap reference to the center of the concrete wind area.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">Multiply force by that distance to obtain its turning effect about the longitudinal axis through the cap reference. The units are force times length, such as kip-feet.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep04;paragraphfwstrategy04">STEP 4 OF 7 | Simplified superstructure wind components</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="F_cap_T_SI = F_c_SI + F_fence" showsteps="False" seplines="False">
                <expbody>F_cap_T_SI = F_c_SI + F_fence</expbody>
                <expresult> = 25.849 kip</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">
            Total across-bridge force at the cap reference: Service I,
            <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
            fence load.
        </paragraph>
        <section name="EqNotes_FenceWind_022_F_cap_T_SI" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">
                Add 
                <dynexp formula="F_c_SI" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>F_c_SI</expbody>
                </dynexp>
                , the concrete superstructure force delivered to the pier, to 
                <dynexp formula="F_fence" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>F_fence</expbody>
                </dynexp>
                , the fence force delivered to the same pier for this pressure case.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">Both are total forces in the same direction, so they can be added directly. Direct wind on the pier wall and cap itself is handled separately. This total is applied once, not repeated in full at each analysis node.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep04;paragraphfwstrategy04">STEP 4 OF 7 | Simplified superstructure wind components</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="M_cap_L_SI = M_c_SI + M_fence" showsteps="False" seplines="False">
                <expbody>M_cap_L_SI = M_c_SI + M_fence</expbody>
                <expresult> = 278.191 kip*ft</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">
            Total moment about the longitudinal axis at the cap reference: Service I,
            <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
            fence load.
        </paragraph>
        <section name="EqNotes_FenceWind_023_M_cap_L_SI" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">
                Add 
                <dynexp formula="M_c_SI" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>M_c_SI</expbody>
                </dynexp>
                , the concrete superstructure’s moment about the cap reference, to 
                <dynexp formula="M_fence" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>M_fence</expbody>
                </dynexp>
                , the fence moment about that same reference.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">Each term already includes its own force location and resulting turning effect. Use the matching total force from this same pressure case when applying the force-and-moment set.</paragraph>
        </section>
        <embed spacingbefore="8" spacingafter="12">
            <table name="FWContentBox14" capture="False" colwidths="1:520">
                <stylerule range="A1:A4" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);" />
                <stylerule range="A1" background="#DCE7F3" fontweight="bold" />
                <row>
                    <textcell name="FWContentBox14Title" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">SIMPLIFIED-METHOD QUALIFICATION</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWContentBox14Row1" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">
                            • Use the
                            <link address="#CodeReferencesC002.CodePage10;paragraphprojectcoderef10C002">LRFD 3.8.1.2.3a</link>
                            simplified components only when the individual-span and bridge-height limits are satisfied.
                        </paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWContentBox14Row2" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">
                            • The height check is taken to the top of the concrete superstructure. The metal-fabric fence remains a separate
                            <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
                            load in this worksheet.
                        </paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWContentBox14Row3" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">
                            • Direct wind on the pier remains under
                            <link address="#CodeReferencesC002.CodePage10;paragraphprojectcoderef10C002">LRFD 3.8.1.2.3b</link>
                            and is not included in these cap-reference resultants.
                        </paragraph>
                    </textcell>
                </row>
            </table>
        </embed>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep04;paragraphfwstrategy04">STEP 4 OF 7 | Simplified superstructure wind components</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0" level="1">
            <dynexp mathlayout="on" formula="L_span_max=Max(BridgeGeometry_2Beam.Span_1, BridgeGeometry_2Beam.Span_2)" showsteps="False" seplines="False">
                <expbody>L_span_max=Max(BridgeGeometry_2Beam.Span_1, BridgeGeometry_2Beam.Span_2)</expbody>
                <expresult> = 107.35 ft</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Maximum individual span used to qualify the LRFD simplified wind method.</paragraph>
        <section name="EqNotes_FenceWind_024_L_span_max" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">
                Compare the two neighboring simply supported spans and keep the larger.
                <link address="#CodeReferencesC002.CodePage10;paragraphprojectcoderef10C002">LRFD 3.8.1.2.3a</link>
                limits the simplified method to an individual span not more than 150 ft.
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep04;paragraphfwstrategy04">STEP 4 OF 7 | Simplified superstructure wind components</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0" level="1">
            <dynexp mathlayout="on" formula="H_bridge = BridgeGeometry_2Beam.Concrete_top_aboveGround" showsteps="False" seplines="False">
                <expbody>H_bridge = BridgeGeometry_2Beam.Concrete_top_aboveGround</expbody>
                <expresult> = 26 ft 0.045 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Maximum bridge height above low ground used for the simplified-method qualification.</paragraph>
        <section name="EqNotes_FenceWind_025_H_bridge" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7">Reference the concrete-top height above low ground in the geometry module. The numerical simplified-method check is conditional on the retained ground-clearance and concrete-depth assumptions.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep04;paragraphfwstrategy04">STEP 4 OF 7 | Simplified superstructure wind components</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0" level="1">
            <dynexp mathlayout="off" formula="Check_simplified = If(And(L_span_max &lt;= 150 ft, H_bridge &lt;= 33 ft), &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" showsteps="False" seplines="False" style="Result only" showresult="True" showidentifier="False" showformula="False">
                <expresult>✓ PASS</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">
            Live check that the bridge satisfies both
            <link address="#CodeReferencesC002.CodePage10;paragraphprojectcoderef10C002">LRFD 3.8.1.2.3a</link>
            limits for the simplified wind components.
        </paragraph>
        <section name="EqNotes_FenceWind_026_Check_simplified" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">A passing result authorizes the 100% transverse plus 25% longitudinal simultaneous component method used below. If either geometry limit changes and this check fails, the plan-angle method must be restored.</paragraph>
        </section>
        <embed spacingbefore="8" spacingafter="12">
            <table name="FWSimplifiedCriteria" title="Simplified-method qualification" capture="False" colwidths="1:230, 2:140, 3:150">
                <stylerule range="A1:C4" background="#FFF8E9" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#A78638&quot;);" fontfamily="Times New Roman" fontsize="10" />
                <stylerule range="A1:C1" background="#F7E6B9" fontweight="bold" />
                <row>
                    <c capture="False"><textvalue>Criterion</textvalue></c>
                    <c capture="False"><textvalue>Actual</textvalue></c>
                    <c capture="False"><textvalue>Result</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Individual span ≤ 150 ft</textvalue></c>
                    <c capture="False" formula="L_span_max"><num>107.34999999999991 ft</num></c>
                    <c capture="False" formula="If(L_span_max &lt;= 150 ft, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)"><textvalue>✓ PASS</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Bridge height ≤ 33 ft</textvalue></c>
                    <c capture="False" formula="H_bridge"><num>26 ft 0.045000000000015916 in</num></c>
                    <c capture="False" formula="If(H_bridge &lt;= 33 ft, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)"><textvalue>✓ PASS</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Overall simplified-method qualification</textvalue></c>
                    <c capture="False"><textvalue>100% T + 25% L</textvalue></c>
                    <c capture="False" formula="Check_simplified"><textvalue>✓ PASS</textvalue></c>
                </row>
            </table>
        </embed>
        <embed spacingbefore="8" spacingafter="12">
            <table name="FWContentBox16" capture="False" colwidths="1:520">
                <stylerule range="A1:A5" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);" />
                <stylerule range="A1" background="#DCE7F3" fontweight="bold" />
                <row>
                    <textcell name="FWContentBox16Title" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">SIMULTANEOUS COMPONENT RULE</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWContentBox16Row1" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Transverse component = 100% of the perpendicular-wind cap resultant.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWContentBox16Row2" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Longitudinal component = 25% of that transverse component.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWContentBox16Row3" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Apply the transverse and longitudinal components simultaneously; evaluate both horizontal signs with the corresponding moment signs.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWContentBox16Row4" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Use WS = 1.0 with the matching Strength III or Service I wind set.</paragraph>
                    </textcell>
                </row>
            </table>
        </embed>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep04;paragraphfwstrategy04">STEP 4 OF 7 | Simplified superstructure wind components</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0" level="1">
            <dynexp mathlayout="on" formula="F_cap_L_III = 0.25*F_cap_T_III" showsteps="False" seplines="False">
                <expbody>F_cap_L_III = 0.25*F_cap_T_III</expbody>
                <expresult> = 13.017 kip</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Simultaneous longitudinal cap force: Strength III simplified wind case.</paragraph>
        <section name="EqNotes_FenceWind_027_F_cap_L_III" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">
                <link address="#CodeReferencesC002.CodePage10;paragraphprojectcoderef10C002">LRFD 3.8.1.2.3a</link>
                permits the longitudinal component to be taken as 25% of the transverse perpendicular-wind load for a qualifying usual girder bridge. Keep this force with the full transverse force from the same row.
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep04;paragraphfwstrategy04">STEP 4 OF 7 | Simplified superstructure wind components</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0" level="1">
            <dynexp mathlayout="on" formula="M_cap_T_III = 0.25*M_c_III + 0.25*F_fence*z_mid" showsteps="False" seplines="False">
                <expbody>M_cap_T_III = 0.25*M_c_III + 0.25*F_fence*z_mid</expbody>
                <expresult> = 107.270 kip*ft</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Moment about the transverse axis associated with the Strength III longitudinal component.</paragraph>
        <section name="EqNotes_FenceWind_028_M_cap_T_III" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">Apply 25% of the concrete perpendicular-wind force at its existing concrete load height and 25% of the fence force at z_mid, the adopted fence projected-height midpoint. This forms the cap-reference moment associated with the simultaneous longitudinal force using the same projected fence load height for the simultaneous longitudinal component.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep04;paragraphfwstrategy04">STEP 4 OF 7 | Simplified superstructure wind components</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0" level="1">
            <dynexp mathlayout="on" formula="F_cap_L_SI = 0.25*F_cap_T_SI" showsteps="False" seplines="False">
                <expbody>F_cap_L_SI = 0.25*F_cap_T_SI</expbody>
                <expresult> = 6.462 kip</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Simultaneous longitudinal cap force: Service I simplified wind case.</paragraph>
        <section name="EqNotes_FenceWind_029_F_cap_L_SI" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">Use 25% of the Service I transverse cap force as the simultaneous longitudinal component. The Strength III and Service I wind sets remain separate.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep04;paragraphfwstrategy04">STEP 4 OF 7 | Simplified superstructure wind components</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0" level="1">
            <dynexp mathlayout="on" formula="M_cap_T_SI = 0.25*M_c_SI + 0.25*F_fence*z_mid" showsteps="False" seplines="False">
                <expbody>M_cap_T_SI = 0.25*M_c_SI + 0.25*F_fence*z_mid</expbody>
                <expresult> = 69.548 kip*ft</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Moment about the transverse axis associated with the Service I longitudinal component.</paragraph>
        <section name="EqNotes_FenceWind_030_M_cap_T_SI" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">Apply 25% of the Service I concrete perpendicular-wind force at its existing concrete load height and 25% of the fence force at z_mid. This forms the longitudinal-component moment at the cap reference using the same load locations as the corresponding force components.</paragraph>
        </section>
        <embed spacingbefore="8" spacingafter="12">
            <table name="FWConcurrentRules" capture="False" colwidths="1:520">
                <stylerule range="A1:A5" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);" />
                <stylerule range="A1" background="#DCE7F3" fontweight="bold" />
                <row>
                    <textcell name="FWConcurrentRulesTitle" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">CONCURRENT SIMPLIFIED LOAD SET</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWConcurrentRulesRow1" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Each limit-state row below is one simultaneous load set at the cap reference.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWConcurrentRulesRow2" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• F_T and M_L are the full perpendicular-wind resultants.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWConcurrentRulesRow3" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• F_L is 25% of F_T; M_T is the cap-reference moment from the corresponding 25% longitudinal concrete and fence force components at their adopted load heights.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWConcurrentRulesRow4" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">
                            • Direct pier wind is listed separately in Step 5 and must be applied consistently with
                            <link address="#CodeReferencesC002.CodePage10;paragraphprojectcoderef10C002">LRFD 3.8.1.2.3b</link>
                            .
                        </paragraph>
                    </textcell>
                </row>
            </table>
        </embed>
        <embed spacingbefore="8" spacingafter="12">
            <table title="Strength III cap-reference wind — simplified simultaneous case, WS = 1.0" name="FWCapIII" capture="False" colwidths="1:160, 2:90, 3:90, 4:90, 5:90">
                <stylerule range="A1:E2" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#000000&quot;); Border(&quot;BetweenColumns&quot;, &quot;Solid&quot;, 1, &quot;#000000&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 1, &quot;#000000&quot;);" fontfamily="Times New Roman" fontsize="10" />
                <stylerule range="A1:E1" background="#DCECE0" fontweight="bold" />
                <row>
                    <c capture="False"><textvalue>Case</textvalue></c>
                    <c capture="False"><textvalue>F_T (kip)</textvalue></c>
                    <c capture="False"><textvalue>F_L (kip)</textvalue></c>
                    <c capture="False"><textvalue>M_L (kip-ft)</textvalue></c>
                    <c capture="False"><textvalue>M_T (kip-ft)</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Simplified 100% T + 25% L</textvalue></c>
                    <c capture="False" formula="F_cap_T_III"><num>52.067000281736455 kip</num></c>
                    <c capture="False" formula="F_cap_L_III"><num>13.016750070434114 kip</num></c>
                    <c capture="False" formula="M_cap_L_III"><num>429.08007305801607 kip*ft</num></c>
                    <c capture="False" formula="M_cap_T_III"><num>107.27001826450402 kip*ft</num></c>
                </row>
                <stylerule range="A1:E2" background="#EFF7F1" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#6A9075&quot;);" />
                <stylerule range="A1:E1" background="#DCECE0" fontweight="bold" />
            </table>
        </embed>
        <embed spacingbefore="8" spacingafter="12">
            <table title="Service I cap-reference wind — simplified simultaneous case, WS = 1.0" name="FWCapSI" capture="False" colwidths="1:160, 2:90, 3:90, 4:90, 5:90">
                <stylerule range="A1:E2" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#000000&quot;); Border(&quot;BetweenColumns&quot;, &quot;Solid&quot;, 1, &quot;#000000&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 1, &quot;#000000&quot;);" fontfamily="Times New Roman" fontsize="10" />
                <stylerule range="A1:E1" background="#DCECE0" fontweight="bold" />
                <row>
                    <c capture="False"><textvalue>Case</textvalue></c>
                    <c capture="False"><textvalue>F_T (kip)</textvalue></c>
                    <c capture="False"><textvalue>F_L (kip)</textvalue></c>
                    <c capture="False"><textvalue>M_L (kip-ft)</textvalue></c>
                    <c capture="False"><textvalue>M_T (kip-ft)</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Simplified 100% T + 25% L</textvalue></c>
                    <c capture="False" formula="F_cap_T_SI"><num>25.849243878124994 kip</num></c>
                    <c capture="False" formula="F_cap_L_SI"><num>6.462310969531249 kip</num></c>
                    <c capture="False" formula="M_cap_L_SI"><num>278.19142292264803 kip*ft</num></c>
                    <c capture="False" formula="M_cap_T_SI"><num>69.54785573066201 kip*ft</num></c>
                </row>
                <stylerule range="A1:E2" background="#EFF7F1" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#6A9075&quot;);" />
                <stylerule range="A1:E1" background="#DCECE0" fontweight="bold" />
            </table>
        </embed>
        <section name="FWStrategyWork05" capture="False" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="4" spacingbefore="12" fontweight="bold" textcolor="#1766A0" keepwithnext="True" id="paragraphfwstrategywork05" texthighlight="#EDF3F8">
                <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8">Calculate the wind pressure and face-normal forces acting directly on the pier. These loads remain separate from the bridge-and-fence cap rows until matched by wind direction.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="8" textcolor="#43556B">
                Code basis:
                <link address="#CodeReferencesC002.CodePage04;paragraphprojectcoderef04C002">FDOT SDG 2.4.1.A and Table 2.4.1-1</link>
                ;
                <link address="#CodeReferencesC002.CodePage07;paragraphprojectcoderef07C002">LRFD Eq. 3.8.1.2.1-1</link>
                ;
                <link address="#CodeReferencesC002.CodePage10;paragraphprojectcoderef10C002">LRFD 3.8.1.2.3b and Commentary C3.8.1.2.3b</link>
            </paragraph>
        </section>
        <embed spacingafter="12">
            <table name="FWSectionIntro5" title="Section introduction" capture="False" colwidths="1:90, 2:430">
                <stylerule range="A1:B3" background="#EDF3F8" fontfamily="Times New Roman" fontsize="10" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#1766A0&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 1, &quot;#CCD9E5&quot;);" />
                <stylerule range="A1:A3" fontweight="bold" />
                <row>
                    <c capture="False"><textvalue>Objective</textvalue></c>
                    <c capture="False"><textvalue>Determine direct wind on the pier wall and cap.</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Inputs</textvalue></c>
                    <c capture="False"><textvalue>Wind speed; exposure; gust; substructure drag; pier projected areas.</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Output</textvalue></c>
                    <c capture="False"><textvalue>Strength III and Service I direct wall forces.</textvalue></c>
                </row>
                <stylerule range="A1:B1" background="#F1F5FA" />
                <stylerule range="A2:B2" background="#FFF8E9" />
                <stylerule range="A3:B3" background="#EFF7F1" />
            </table>
        </embed>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="V_III=C001WindLoadOnPedBridgeSuperstructure.V_III" showsteps="False" seplines="False">
                <expbody>V_III=C001WindLoadOnPedBridgeSuperstructure.V_III</expbody>
                <expresult> = 130</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Wind speed used for the Strength III direct-pier pressure basis.</paragraph>
        <section name="EqNotes_FenceWind_031_V_III" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">
                Copy 
                <dynexp formula="C001WindLoadOnPedBridgeSuperstructure.V_III" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>C001WindLoadOnPedBridgeSuperstructure.V_III</expbody>
                </dynexp>
                 from the main bridge wind module. The stored number is read as miles per hour by the pressure equation. It is a wind speed, not a force or a multiplier on a completed load.
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="0" spacingafter="8" textcolor="#43556B">
            Code basis: 
            <link address="#CodeReferencesC002.CodePage04;paragraphprojectcoderef04C002">FDOT SDG 2.4.1.A and Table 2.4.1-1</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8" id="paragraphrefreturn0024">
            <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="V_SI=C001WindLoadOnPedBridgeSuperstructure.V_SI" showsteps="False" seplines="False">
                <expbody>V_SI=C001WindLoadOnPedBridgeSuperstructure.V_SI</expbody>
                <expresult> = 70</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Wind speed used for the Service I direct-pier pressure basis.</paragraph>
        <section name="EqNotes_FenceWind_032_V_SI" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">
                Copy 
                <dynexp formula="C001WindLoadOnPedBridgeSuperstructure.V_SI" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>C001WindLoadOnPedBridgeSuperstructure.V_SI</expbody>
                </dynexp>
                 from the main bridge wind module. The stored number is read as miles per hour by the pressure equation. It is a wind speed, not a force or a multiplier on a completed load.
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="0" spacingafter="8" textcolor="#43556B">
            Code basis: 
            <link address="#CodeReferencesC002.CodePage06;paragraphprojectcoderef06C002">LRFD 3.8.1.1.2 and Table 3.8.1.1.2-1</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8" id="paragraphrefreturn0025">
            <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="K_Z_III=C001WindLoadOnPedBridgeSuperstructure.K_Z_gov" showsteps="False" seplines="False">
                <expbody>K_Z_III=C001WindLoadOnPedBridgeSuperstructure.K_Z_gov</expbody>
                <expresult> = 1.019</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" level="1">
            <link address="#CodeReferencesC002.CodePage05;paragraphprojectcoderef05C002">FDOT SDG 2.4.1.B</link>
            requires Category C unless Category D applies.
            <link address="#CodeReferencesC002.CodePage07;paragraphprojectcoderef07C002">LRFD 3.8.1.2.1</link>
            supplies the height-dependent exposure equations. The common fence-crown exposure height is a project modeling choice.
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Exposure-and-height multiplier for Strength III wind.</paragraph>
        <section name="EqNotes_FenceWind_033_K_Z_III" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">
                Copy 
                <dynexp formula="C001WindLoadOnPedBridgeSuperstructure.K_Z_gov" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>C001WindLoadOnPedBridgeSuperstructure.K_Z_gov</expbody>
                </dynexp>
                , the multiplier selected by the main bridge wind module for its terrain exposure and height. This is a dimensionless pressure multiplier; it is not the fence height itself.
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="8" level="1">
            Reference: 
            <link address="#CodeReferencesC002.CodePage08;paragraphprojectcoderef08C002">LRFD 3.8.1.2.1</link>
            ; 
            <link address="#CodeReferencesC002.CodePage05;paragraphprojectcoderef05C002">FDOT SDG 2.4.1.B</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="0" spacingafter="8" textcolor="#43556B">
            Code basis: 
            <link address="#CodeReferencesC002.CodePage05;paragraphprojectcoderef05C002">FDOT SDG 2.4.1.B and LRFD 3.8.1.1.5</link>
            ; 
            <link address="#CodeReferencesC002.CodePage08;paragraphprojectcoderef08C002">LRFD 3.8.1.2.1 and Eqs. 3.8.1.2.1-3 and 3.8.1.2.1-4</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="K_Z_SI = 1.0" showsteps="False" seplines="False">
                <expbody>K_Z_SI = 1.0</expbody>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Exposure-and-height multiplier adopted for Service I wind.</paragraph>
        <section name="EqNotes_FenceWind_034_K_Z_SI" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">The entered value of 1 leaves the squared-speed pressure term unchanged by exposure and height in this Service I calculation. The gust and drag multipliers still apply. This input is separate from the height-dependent Strength III multiplier.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="8" level="1">
            Reference: 
            <link address="#CodeReferencesC002.CodePage08;paragraphprojectcoderef08C002">LRFD 3.8.1.2.1</link>
            ; 
            <link address="#CodeReferencesC002.CodePage05;paragraphprojectcoderef05C002">FDOT SDG 2.4.1.B</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="0" spacingafter="8" textcolor="#43556B">
            Code basis: 
            <link address="#CodeReferencesC002.CodePage08;paragraphprojectcoderef08C002">LRFD 3.8.1.2.1 and Eqs. 3.8.1.2.1-3 and 3.8.1.2.1-4</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="G_f=C001WindLoadOnPedBridgeSuperstructure.G_fac" showsteps="False" seplines="False">
                <expbody>G_f=C001WindLoadOnPedBridgeSuperstructure.G_fac</expbody>
                <expresult> = 0.85</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" level="1">
            <link address="#CodeReferencesC002.CodePage05;paragraphprojectcoderef05C002">FDOT SDG 2.4.1.C</link>
            states: “Use 0.85 for all load combinations and all structures”. This replaces the base LRFD gust-factor rule for the bridge wind calculation; the provision’s commentary treats ancillary supports separately.
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Gust-effect multiplier shared with the bridge wind calculation.</paragraph>
        <section name="EqNotes_FenceWind_035_G_f" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">
                Copy 
                <dynexp formula="C001WindLoadOnPedBridgeSuperstructure.G_fac" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>C001WindLoadOnPedBridgeSuperstructure.G_fac</expbody>
                </dynexp>
                 so the fence uses the same entered gust-effect factor as the main bridge wind module. This multiplier adjusts the wind-pressure term for the gust treatment adopted in that module. It has no units and is used for both wind limit states here.
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="8" level="1">
            Reference: 
            <link address="#CodeReferencesC002.CodePage05;paragraphprojectcoderef05C002">FDOT SDG 2.4.1.C</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="0" spacingafter="8" textcolor="#43556B">
            Code basis: 
            <link address="#CodeReferencesC002.CodePage05;paragraphprojectcoderef05C002">FDOT SDG 2.4.1.C</link>
        </paragraph>
        <embed spacingafter="10">
            <table name="FWWindInputs" title="Wind input summary" capture="False" colwidths="1:220, 2:150, 3:150">
                <stylerule range="A1:C4" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#B7C2CC&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 1, &quot;#B7C2CC&quot;);" fontfamily="Times New Roman" fontsize="10" />
                <stylerule range="A1:C1" background="#E2EAF1" fontweight="bold" />
                <row>
                    <c capture="False"><textvalue>Parameter</textvalue></c>
                    <c capture="False"><textvalue>Strength III</textvalue></c>
                    <c capture="False"><textvalue>Service I</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>V (mph)</textvalue></c>
                    <c capture="False" formula="V_III"><num>130</num></c>
                    <c capture="False" formula="V_SI"><num>70</num></c>
                </row>
                <row>
                    <c capture="False"><textvalue>K_Z</textvalue></c>
                    <c capture="False" formula="K_Z_III"><num>1.0194843296537763</num></c>
                    <c capture="False" formula="K_Z_SI"><num>1</num></c>
                </row>
                <row>
                    <c capture="False"><textvalue>G_f</textvalue></c>
                    <c capture="False" formula="G_f"><num>0.85</num></c>
                    <c capture="False" formula="G_f"><num>0.85</num></c>
                </row>
                <stylerule range="A1:C4" background="#FFF8E9" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#A78638&quot;);" />
                <stylerule range="A1:C1" background="#F7E6B9" fontweight="bold" />
            </table>
        </embed>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0" level="1">
            <dynexp mathlayout="on" formula="q_III = 2.56E-06*V_III^2*K_Z_III*G_f*1 ksf" showsteps="False" seplines="False">
                <expbody>q_III = 2.56E-06*V_III^2*K_Z_III*G_f*1 ksf</expbody>
                <expresult> = 0.0375 ksf</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Strength III wind-pressure term before the direct-substructure drag multiplier.</paragraph>
        <section name="EqNotes_FenceWind_036_q_III" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">
                Square 
                <dynexp formula="V_III" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>V_III</expbody>
                </dynexp>
                , the wind speed in miles per hour: multiply the speed number by itself. Wind pressure in this expression grows with the square of speed, so doubling the speed multiplies this part by four.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">
                Multiply by 
                <dynexp formula="K_Z_III" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>K_Z_III</expbody>
                </dynexp>
                , the exposure-and-height multiplier, and 
                <dynexp formula="G_f" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>G_f</expbody>
                </dynexp>
                , the gust-effect multiplier. The constant 2.56E-06 converts the squared mph number to the pressure scale used here; “1 ksf” supplies units of kips per square foot.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">This result already includes the gust multiplier. Apply the appropriate drag or combined drag-and-area multiplier next, without multiplying by the gust factor again.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="8" level="1">
            Reference: 
            <link address="#CodeReferencesC002.CodePage07;paragraphprojectcoderef07C002">LRFD Eq. 3.8.1.2.1-1</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="0" spacingafter="8" textcolor="#43556B">
            Code basis: 
            <link address="#CodeReferencesC002.CodePage07;paragraphprojectcoderef07C002">LRFD Eq. 3.8.1.2.1-1</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="q_SI = 2.56E-06*V_SI^2*K_Z_SI*G_f*1 ksf" showsteps="False" seplines="False">
                <expbody>q_SI = 2.56E-06*V_SI^2*K_Z_SI*G_f*1 ksf</expbody>
                <expresult> = 0.0107 ksf</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Service I wind-pressure term before the direct-substructure drag multiplier.</paragraph>
        <section name="EqNotes_FenceWind_037_q_SI" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">
                Square 
                <dynexp formula="V_SI" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>V_SI</expbody>
                </dynexp>
                , the wind speed in miles per hour: multiply the speed number by itself. Wind pressure in this expression grows with the square of speed, so doubling the speed multiplies this part by four.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">
                Multiply by 
                <dynexp formula="K_Z_SI" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>K_Z_SI</expbody>
                </dynexp>
                , the exposure-and-height multiplier, and 
                <dynexp formula="G_f" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>G_f</expbody>
                </dynexp>
                , the gust-effect multiplier. The constant 2.56E-06 converts the squared mph number to the pressure scale used here; “1 ksf” supplies units of kips per square foot.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">This result already includes the gust multiplier. Apply the appropriate drag or combined drag-and-area multiplier next, without multiplying by the gust factor again.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="8" level="1">
            Reference: 
            <link address="#CodeReferencesC002.CodePage07;paragraphprojectcoderef07C002">LRFD Eq. 3.8.1.2.1-1</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="0" spacingafter="8" textcolor="#43556B">
            Code basis: 
            <link address="#CodeReferencesC002.CodePage07;paragraphprojectcoderef07C002">LRFD Eq. 3.8.1.2.1-1</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8" id="paragraphrefreturn0026">
            <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="C_sub = 1.6" showsteps="False" seplines="False">
                <expbody>C_sub = 1.6</expbody>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Drag multiplier assigned to wind acting directly on the pier.</paragraph>
        <section name="EqNotes_FenceWind_038_C_sub" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">
                This dimensionless input converts the common wind-pressure term into pressure for the pier wall and cap. It belongs to the direct substructure calculation. The
                <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
                fence load is separate and does not use this direct-pier drag coefficient.
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="8" level="1">
            Reference: 
            <link address="#CodeReferencesC002.CodePage09;paragraphprojectcoderef09C002">LRFD Table 3.8.1.2.1-2</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="0" spacingafter="8" textcolor="#43556B">
            Code basis: 
            <link address="#CodeReferencesC002.CodePage09;paragraphprojectcoderef09C002">LRFD Table 3.8.1.2.1-2</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="p_sub_III = q_III*C_sub" showsteps="False" seplines="False">
                <expbody>p_sub_III = q_III*C_sub</expbody>
                <expresult> = 0.0600 ksf</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Strength III pressure on the pier wall and cap themselves.</paragraph>
        <section name="EqNotes_FenceWind_039_p_sub_III" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">
                Multiply 
                <dynexp formula="q_III" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>q_III</expbody>
                </dynexp>
                , the exposure-and-gust wind-pressure term, by 
                <dynexp formula="C_sub" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>C_sub</expbody>
                </dynexp>
                , the drag multiplier for the substructure. The result is force per square foot of projected wall or cap area.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">These direct pier loads are calculated separately from loads delivered through the bridge superstructure and fence.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="0" spacingafter="8" textcolor="#43556B">
            Code basis: 
            <link address="#CodeReferencesC002.CodePage07;paragraphprojectcoderef07C002">LRFD Eq. 3.8.1.2.1-1</link>
            ; 
            <link address="#CodeReferencesC002.CodePage10;paragraphprojectcoderef10C002">LRFD 3.8.1.2.3b and Commentary C3.8.1.2.3b</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="p_sub_SI = q_SI*C_sub" showsteps="False" seplines="False">
                <expbody>p_sub_SI = q_SI*C_sub</expbody>
                <expresult> = 0.0171 ksf</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Service I pressure on the pier wall and cap themselves.</paragraph>
        <section name="EqNotes_FenceWind_040_p_sub_SI" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">
                Multiply 
                <dynexp formula="q_SI" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>q_SI</expbody>
                </dynexp>
                , the exposure-and-gust wind-pressure term, by 
                <dynexp formula="C_sub" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>C_sub</expbody>
                </dynexp>
                , the drag multiplier for the substructure. The result is force per square foot of projected wall or cap area.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">These direct pier loads are calculated separately from loads delivered through the bridge superstructure and fence.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="0" spacingafter="8" textcolor="#43556B">
            Code basis: 
            <link address="#CodeReferencesC002.CodePage07;paragraphprojectcoderef07C002">LRFD Eq. 3.8.1.2.1-1</link>
            ; 
            <link address="#CodeReferencesC002.CodePage10;paragraphprojectcoderef10C002">LRFD 3.8.1.2.3b and Commentary C3.8.1.2.3b</link>
        </paragraph>
        <embed spacingafter="10">
            <table name="FWDirectPressureResults" title="Pressure results" capture="False" colwidths="1:220, 2:150, 3:150">
                <stylerule range="A1:C2" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#B7C2CC&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 1, &quot;#B7C2CC&quot;);" fontfamily="Times New Roman" fontsize="10" />
                <stylerule range="A1:C2" background="#E2EAF1" fontweight="bold" />
                <stylerule range="A1:C2" background="#EFF7F1" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#6A9075&quot;);" />
                <stylerule range="A1:C2" background="#DCECE0" fontweight="bold" />
                <row>
                    <c capture="False"><textvalue>Pressure (ksf)</textvalue></c>
                    <c capture="False"><textvalue>Strength III</textvalue></c>
                    <c capture="False"><textvalue>Service I</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Direct substructure: p_sub</textvalue></c>
                    <c capture="False" formula="p_sub_III"><num>0.05998547925187175 ksf</num></c>
                    <c capture="False" formula="p_sub_SI"><num>0.01705984 ksf</num></c>
                </row>
            </table>
        </embed>
        <embed spacingbefore="8" spacingafter="12">
            <table name="FWDirectPressureNotes" capture="False" colwidths="1:520">
                <stylerule range="A1:A3" background="#EFF7F1" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#6A9075&quot;);" />
                <stylerule range="A1" background="#DCECE0" fontweight="bold" />
                <row>
                    <textcell name="FWBox8Row6" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold" spacingbefore="8">DIRECT SUBSTRUCTURE PRESSURES — STEP 8</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox8Row7" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">
                            • 
                            <dynexp formula="p_sub_III" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                                <expbody>p_sub_III</expbody>
                            </dynexp>
                             — Strength III pressure acting directly on the pier wall and cap, to be multiplied by their own projected areas.
                        </paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox8Row8" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">
                            • 
                            <dynexp formula="p_sub_SI" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                                <expbody>p_sub_SI</expbody>
                            </dynexp>
                             — Service I pressure acting directly on the pier wall and cap, to be multiplied by their own projected areas.
                        </paragraph>
                    </textcell>
                </row>
            </table>
        </embed>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="F_wall_T_III=p_sub_III*BridgeGeometry_2Beam.PierCap_ht_toTop*BridgeGeometry_2Beam.PierCap_width" showsteps="False" seplines="False">
                <expbody>F_wall_T_III=p_sub_III*BridgeGeometry_2Beam.PierCap_ht_toTop*BridgeGeometry_2Beam.PierCap_width</expbody>
                <expresult> = 4.369 kip</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Strength III wind force acting directly on the pier’s transverse projected face.</paragraph>
        <section name="EqNotes_FenceWind_041_F_wall_T_III" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">
                <dynexp formula="p_sub_III" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>p_sub_III</expbody>
                </dynexp>
                 is the direct substructure pressure. Multiply 
                <dynexp formula="BridgeGeometry_2Beam.PierCap_ht_toTop" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>BridgeGeometry_2Beam.PierCap_ht_toTop</expbody>
                </dynexp>
                , the adopted exposed wall-and-cap height, by 
                <dynexp formula="BridgeGeometry_2Beam.PierCap_width" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>BridgeGeometry_2Beam.PierCap_width</expbody>
                </dynexp>
                , the adopted projected width, to obtain the rectangular area seen by this wind direction.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">Multiply pressure by that area to obtain force. Apply this force at the corresponding wall-load location; it is not included in the superstructure-plus-fence cap totals.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="F_wall_L_III=p_sub_III*BridgeGeometry_2Beam.Pier_wall_area" showsteps="False" seplines="False">
                <expbody>F_wall_L_III=p_sub_III*BridgeGeometry_2Beam.Pier_wall_area</expbody>
                <expresult> = 20.933 kip</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Strength III wind force acting directly normal to the broad pier-wall face.</paragraph>
        <section name="EqNotes_FenceWind_042_F_wall_L_III" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7">Multiply the Strength III direct-substructure wind pressure by the broad-face projected pier area in Bridge Geometry_2 Beam. The geometry variable is an area, not a force.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7">The exposed pier area is retained from the prior model and needs confirmation from the complete revised pier section. Keep this direct-pier force separate from the superstructure-plus-fence cap total.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="F_wall_T_SI=p_sub_SI*BridgeGeometry_2Beam.PierCap_ht_toTop*BridgeGeometry_2Beam.PierCap_width" showsteps="False" seplines="False">
                <expbody>F_wall_T_SI=p_sub_SI*BridgeGeometry_2Beam.PierCap_ht_toTop*BridgeGeometry_2Beam.PierCap_width</expbody>
                <expresult> = 1.242 kip</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Service I wind force acting directly on the pier’s transverse projected face.</paragraph>
        <section name="EqNotes_FenceWind_043_F_wall_T_SI" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">
                <dynexp formula="p_sub_SI" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>p_sub_SI</expbody>
                </dynexp>
                 is the direct substructure pressure. Multiply 
                <dynexp formula="BridgeGeometry_2Beam.PierCap_ht_toTop" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>BridgeGeometry_2Beam.PierCap_ht_toTop</expbody>
                </dynexp>
                , the adopted exposed wall-and-cap height, by 
                <dynexp formula="BridgeGeometry_2Beam.PierCap_width" mathlayout="on" showformula="True" showidentifier="False" showresult="False" showsteps="False">
                    <expbody>BridgeGeometry_2Beam.PierCap_width</expbody>
                </dynexp>
                , the adopted projected width, to obtain the rectangular area seen by this wind direction.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">Multiply pressure by that area to obtain force. Apply this force at the corresponding wall-load location; it is not included in the superstructure-plus-fence cap totals.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="5">
            <dynexp mathlayout="on" formula="F_wall_L_SI=p_sub_SI*BridgeGeometry_2Beam.Pier_wall_area" showsteps="False" seplines="False">
                <expbody>F_wall_L_SI=p_sub_SI*BridgeGeometry_2Beam.Pier_wall_area</expbody>
                <expresult> = 5.953 kip</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" level="1">
            <link address="#CodeReferencesC002.CodePage10;paragraphprojectcoderef10C002">LRFD 3.8.1.2.3b</link>
            requires the direct-pier components to accompany the superstructure loads for the same wind direction. The full face-normal values retained here are force bounds; the final directional wall cases remain to be established.
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Service I wind force acting directly normal to the broad pier-wall face.</paragraph>
        <section name="EqNotes_FenceWind_044_F_wall_L_SI" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7">Multiply the Service I direct-substructure wind pressure by the broad-face projected pier area in Bridge Geometry_2 Beam. The geometry variable is an area, not a force.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7">The exposed pier area is retained from the prior model and needs confirmation from the complete revised pier section. Keep this direct-pier force separate from the superstructure-plus-fence cap total.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep05;paragraphfwstrategy05">STEP 5 OF 7 | Wind acting directly on the pier</link>
             — direct wall force envelope
        </paragraph>
        <embed spacingbefore="8" spacingafter="4">
            <table name="FWContentBox27" capture="False" colwidths="1:520">
                <stylerule range="A1" background="#DCECE0" fontweight="bold" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#6A9075&quot;);" />
                <row>
                    <textcell capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" fontweight="bold" spacingbefore="8">DIRECT SUBSTRUCTURE LOADS — APPLY SEPARATELY</paragraph>
                    </textcell>
                </row>
            </table>
        </embed>
        <embed spacingafter="12">
            <table title="Direct substructure loads" name="FWWall" capture="False" colwidths="1:173.33333333333334, 2:173.33333333333334, 3:173.33333333333334">
                <stylerule range="A1:C3" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#000000&quot;); Border(&quot;BetweenColumns&quot;, &quot;Solid&quot;, 1, &quot;#000000&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 1, &quot;#000000&quot;);" fontfamily="Times New Roman" fontsize="10" />
                <stylerule range="A1:C1" background="#D4D4D4" fontweight="bold" />
                <row>
                    <c capture="False"><textvalue>Limit state</textvalue></c>
                    <c capture="False"><textvalue>F_T (kip)</textvalue></c>
                    <c capture="False"><textvalue>F_L (kip)</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Strength III</textvalue></c>
                    <c capture="False" formula="F_wall_T_III"><num>4.368586491667764 kip</num></c>
                    <c capture="False" formula="F_wall_L_III"><num>20.932810272574702 kip</num></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Service I</textvalue></c>
                    <c capture="False" formula="F_wall_T_SI"><num>1.242423791616 kip</num></c>
                    <c capture="False" formula="F_wall_L_SI"><num>5.953280668159999 kip</num></c>
                </row>
                <stylerule range="A1:C3" background="#EFF7F1" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#6A9075&quot;);" />
                <stylerule range="A1:C1" background="#DCECE0" fontweight="bold" />
            </table>
        </embed>
        <embed spacingbefore="8" spacingafter="12">
            <table name="FWDirectWallRules" capture="False" colwidths="1:520">
                <stylerule range="A1:A4" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);" />
                <stylerule range="A1" background="#DCE7F3" fontweight="bold" />
                <row>
                    <textcell name="FWBox15Row14" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">DIRECT WALL WIND</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox15Row15" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Add wall loads at their wall-load locations.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox15Row16" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• They are not included in the cap tables.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox15Row17" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">
                            • The full face-normal values are component bounds, not one simultaneous full-force pair.
                            <link address="#CodeReferencesC002.CodePage10;paragraphprojectcoderef10C002">LRFD 3.8.1.2.3b</link>
                            requires direct-pier components to be resolved/applied consistently with the wind direction represented in the structural analysis.
                        </paragraph>
                    </textcell>
                </row>
            </table>
        </embed>
        <section name="FWStrategyWork06" capture="False" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="4" spacingbefore="12" fontweight="bold" textcolor="#1766A0" keepwithnext="True" id="paragraphfwstrategywork06" texthighlight="#EDF3F8">
                <link address="#FenceWind.FWStrategyStep06;paragraphfwstrategy06">STEP 6 OF 7 | Prepare the transfer to analysis nodes</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8">Transfer selected concurrent resultants from the cap reference to physical analysis nodes while preserving force and moment equilibrium.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="8" textcolor="#43556B">
                Code basis:
                <link address="#CodeReferencesC002.CodePage14;paragraphprojectcoderef14C002">LRFD Table 3.4.1-1</link>
            </paragraph>
        </section>
        <embed spacingafter="8">
            <canvas title="E. Cap-reference loads and wind-angle convention" name="FWLoadTransferSketch" unit="in" size="6.5 in; 4.0 in; scaletofit">
                <include target="Library.Geometry" />
                <lines pts="0.05000, 0.05000, 0; 6.45000, 0.05000, 0; 6.45000, 3.95000, 0; 0.05000, 3.95000, 0; 0.05000, 0.05000, 0" linecolor="#D7DFE6" linethickness="1.2" linepattern="Solid" />
                <planecontainer origin="0.18000, 3.73000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="11"><textvalue>Step 6: Cap loads and simplified T/L components</textvalue></planecontainer>
                <planecontainer origin="0.18000, 0.16000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#727B84" fontfamily="Times New Roman" fontsize="8"><textvalue>SCHEMATIC - NOT TO SCALE</textvalue></planecontainer>
                <planecontainer origin="0.31000, 3.46000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="10"><textvalue>TRANSVERSE RESULTANTS</textvalue></planecontainer>
                <lines pts="1.16000, 0.63000, 0; 2.20000, 0.63000, 0; 2.20000, 1.02000, 0; 1.16000, 1.02000, 0; 1.16000, 0.63000, 0" linecolor="#29333D" linethickness="1.2" linepattern="Solid" />
                <circle center="1.68000, 0.83000, 0" normal="0, 0, 1" radius="0.035" linecolor="#29333D" fillcolor="#FFFFFF" linethickness="1" />
                <lines pts="1.68000, 0.83000, 0; 1.68000, 3.18000, 0" linecolor="#727B84" linethickness="1.2" linepattern="Dashes" />
                <arrowlines pts="0.64000, 2.92000, 0; 1.68000, 2.92000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <planecontainer origin="0.42000, 3.07000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#C83C32" fontfamily="Times New Roman" fontsize="10"><textvalue>F_fence</textvalue></planecontainer>
                <arrowlines pts="0.64000, 1.70000, 0; 1.68000, 1.70000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <planecontainer origin="0.35000, 1.90000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#C83C32" fontfamily="Times New Roman" fontsize="10"><textvalue>F_concrete</textvalue></planecontainer>
                <arrowlines pts="1.68000, 0.83000, 0; 2.72000, 0.83000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <planecontainer origin="2.12000, 1.10000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#C83C32" fontfamily="Times New Roman" fontsize="9"><textvalue>F_cap,T</textvalue></planecontainer>
                <arrowlines pts="1.93863, 0.47403, 0; 1.89846, 0.44806, 0; 1.85571, 0.42661, 0; 1.81088, 0.40992, 0; 1.76451, 0.39819, 0; 1.71713, 0.39157, 0; 1.66932, 0.39013, 0; 1.62164, 0.39389, 0; 1.57464, 0.40280, 0; 1.52889, 0.41676, 0; 1.48493, 0.43561, 0; 1.44327, 0.45911, 0; 1.40441, 0.48700, 0; 1.36880, 0.51894, 0; 1.33688, 0.55456, 0; 1.30901, 0.59344, 0; 1.28552, 0.63510, 0; 1.26669, 0.67908, 0; 1.25275, 0.72483, 0; 1.24386, 0.77183, 0; 1.24012, 0.81952, 0; 1.24159, 0.86733, 0; 1.24823, 0.91470, 0; 1.25997, 0.96107, 0; 1.27668, 1.00589, 0; 1.29816, 1.04863, 0; 1.32415, 1.08879, 0; 1.35434, 1.12588, 0; 1.38839, 1.15949, 0; 1.42587, 1.18919, 0; 1.46637, 1.21466, 0; 1.50938, 1.23557, 0; 1.55442, 1.25170, 0; 1.60093, 1.26284, 0; 1.64839, 1.26886, 0; 1.69621, 1.26970, 0; 1.74385, 1.26534, 0; 1.79073, 1.25584, 0; 1.83630, 1.24130, 0; 1.88002, 1.22191, 0; 1.92138, 1.19788, 0; 1.95989, 1.16950, 0; 1.99509, 1.13712, 0; 2.02656, 1.10110, 0; 2.05394, 1.06188, 0; 2.07690, 1.01992, 0; 2.09517, 0.97571, 0; 2.10854, 0.92978, 0; 2.11684, 0.88267, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <planecontainer origin="2.16000, 0.38000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#C83C32" fontfamily="Times New Roman" fontsize="9"><textvalue>M_cap,L</textvalue></planecontainer>
                <lineardim startpoint="1.68000, 0.83000, 0" endpoint="1.68000, 2.92000, 0" pointondimline="2.85000, 1.92000, 0" formula="FenceWind.M_fence/FenceWind.F_fence" linecolor="#1766A0" textcolor="#1766A0" linethickness="0.7" fontsize="9"><num>14.143229166666664 ft</num></lineardim>
                <planecontainer origin="2.97, 2.69, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#1766A0" fontfamily="Times New Roman" fontsize="9"><textvalue>z_eff</textvalue></planecontainer>
                <planecontainer origin="0.35000, 0.39000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="9"><textvalue>Cap reference</textvalue></planecontainer>
                <planecontainer origin="3.64000, 3.46000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="10"><textvalue>PLAN: SIMPLIFIED COMPONENTS</textvalue></planecontainer>
                <lines pts="4.50000, 1.25000, 0; 5.06000, 1.25000, 0; 5.06000, 2.80000, 0; 4.50000, 2.80000, 0; 4.50000, 1.25000, 0" linecolor="#29333D" linethickness="1.2" linepattern="Solid" />
                <arrowlines pts="4.78000, 1.05000, 0; 4.78000, 3.12000, 0" linecolor="#1766A0" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <planecontainer origin="4.93000, 3.04000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#1766A0" fontfamily="Times New Roman" fontsize="10"><textvalue>+L</textvalue></planecontainer>
                <arrowlines pts="3.82000, 1.96000, 0; 6.07000, 1.96000, 0" linecolor="#1766A0" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <planecontainer origin="5.98000, 1.70000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#1766A0" fontfamily="Times New Roman" fontsize="10"><textvalue>+T</textvalue></planecontainer>
                <planecontainer origin="3.65000, 0.82000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="10"><textvalue>100% T + 25% L</textvalue></planecontainer>
                <planecontainer origin="3.62000, 0.52000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#29333D" fontfamily="Times New Roman" fontsize="10"><textvalue>T and L act concurrently</textvalue></planecontainer>
                <arrowlines pts="4.78000, 1.96000, 0; 5.88000, 1.96000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <planecontainer origin="5.18000, 2.10000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#C83C32" fontfamily="Times New Roman" fontsize="9"><textvalue>100% T</textvalue></planecontainer>
                <arrowlines pts="4.78000, 1.96000, 0; 4.78000, 2.82000, 0" linecolor="#C83C32" linethickness="1.2" linepattern="Solid" endarrow="6; 3" />
                <planecontainer origin="4.10000, 2.62000, 0" dir="1, 0, 0" normal="0, 0, 1" textcolor="#C83C32" fontfamily="Times New Roman" fontsize="9"><textvalue>25% L</textvalue></planecontainer>
            </canvas>
        </embed>
        <embed spacingbefore="8" spacingafter="12">
            <table name="FWContentBox13" capture="False" colwidths="1:520">
                <stylerule range="A1:A2" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);" />
                <stylerule range="A1" background="#DCE7F3" fontweight="bold" />
                <row>
                    <textcell name="FWBox13Row1" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">CAP-LOAD SCHEMATIC</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox13Row2" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">
                            • Left: equivalent fence resultant for the
                            <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
                            fence resultant.
                        </paragraph>
                    </textcell>
                </row>
            </table>
        </embed>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• The equivalent fence force acts at z_eff = z_mid and already reproduces the adopted projected fence moment.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">TOTALS AT THE CAP REFERENCE</paragraph>
        <embed spacingbefore="8" spacingafter="12">
            <table name="FWContentBox15" capture="False" colwidths="1:520">
                <stylerule range="A1:A9" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);" />
                <stylerule range="A1" background="#DCE7F3" fontweight="bold" />
                <row>
                    <textcell name="FWBox15Row1" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" fontweight="bold" spacingbefore="8">LOAD APPLICATION RULES</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox15Row9" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">FACTOR STATUS</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox15Row10" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Select the matching Strength III or Service I wind set and use WS = 1.0. Do not apply a single pressure-ratio multiplier to all wind loads.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox15Row11" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">REFERENCE POINT</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox15Row12" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Cap tables contain total superstructure-plus-fence resultants at the pier cap reference.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox15Row13" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Their moments already include eccentricity to that reference.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox15Row18" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">NODE TRANSFER</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox15Row19" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Distribute the total force once.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox15Row20" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• For an application elevation z above the cap reference:</paragraph>
                    </textcell>
                </row>
            </table>
        </embed>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingbefore="4" spacingafter="2" fontweight="bold" keepwithnext="True" textcolor="#1766A0" texthighlight="#EDF3F8">
            <link address="#FenceWind.FWStrategyStep06;paragraphfwstrategy06">STEP 6 OF 7 | Prepare the transfer to analysis nodes</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0" level="1">
            <dynexp mathlayout="on" formula="M_residual(M_cap, F, z) = M_cap - F*z" showsteps="False" showresult="False">
                <expbody>M_residual(M_cap, F, z) = M_cap - F*z</expbody>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Moment that still must be applied after a force is moved above the cap reference.</paragraph>
        <section name="EqNotes_FenceWind_045_M_residual_M_cap_F_z" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">M_cap is the total required moment about the cap reference. F is the horizontal force being applied. z is the signed height of that force’s application point above the cap reference, using the same sign convention as the moment component.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" level="1">Multiplying F by z gives the moment that the relocated force already creates about the reference. Subtract that amount from M_cap to find the remaining couple to apply. If the force is applied at the reference, z is zero and the full required moment remains.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="10" level="1">This is a scalar force-and-moment balance for one matching direction pair. For several forces, their combined moment about the reference must be accounted for before assigning the remaining couple.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Preserve force and moment equilibrium.</paragraph>
        <embed spacingbefore="8" spacingafter="12">
            <table name="FWContentBox17" capture="False" colwidths="1:520">
                <stylerule range="A1:A4" background="#EFF7F1" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#6A9075&quot;);" />
                <stylerule range="A1" background="#DCECE0" fontweight="bold" />
                <row>
                    <textcell name="FWBox17Row1" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" fontweight="bold">OUTPUT → MODEL INPUT</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox17Row2" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• The live four-bearing decomposition, coordinates and residual moments are collected in Ped Bridge — FBMP Model Loads.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox17Row3" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Map calculation directions to the analysis-model axes.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell name="FWBox17Row4" capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Map cap and wall load locations to the physical analysis nodes.</paragraph>
                    </textcell>
                </row>
            </table>
        </embed>
        <section name="FWStrategyWork07" capture="False" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="4" spacingbefore="12" fontweight="bold" textcolor="#1766A0" keepwithnext="True" id="paragraphfwstrategywork07" texthighlight="#EDF3F8">
                <link address="#FenceWind.FWStrategyStep07;paragraphfwstrategy07">STEP 7 OF 7 | Check the simplified method and complete the design handoff</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8">Check the simplified fence model, qualification limits, cap-reference bookkeeping, and the 100% transverse / 25% longitudinal component relationships before handoff.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="8" textcolor="#43556B">
                Code basis:
                <link address="#CodeReferencesC002.CodePage01;paragraphprojectcoderef01C002">RFQ — Governing Regulations</link>
                ;
                <link address="#CodeReferencesC002.CodePage13;paragraphprojectcoderef13C002">FDOT SDG 10.10.B and 10.10.F</link>
                ;
                <link address="#CodeReferencesC002.CodePage11;paragraphprojectcoderef11C002">LRFD 3.8.2</link>
            </paragraph>
        </section>
        <embed spacingafter="12">
            <table name="FWSectionIntro6" title="Section introduction" capture="False" colwidths="1:90, 2:430">
                <stylerule range="A1:B3" background="#EDF3F8" fontfamily="Times New Roman" fontsize="10" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#1766A0&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 1, &quot;#CCD9E5&quot;);" />
                <stylerule range="A1:A3" fontweight="bold" />
                <row>
                    <c capture="False"><textvalue>Objective</textvalue></c>
                    <c capture="False"><textvalue>Check model consistency and load-transfer bookkeeping.</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Inputs</textvalue></c>
                    <c capture="False"><textvalue>Geometry; tributary length; fence resultant; simplified-method criteria; simultaneous cap components.</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Output</textvalue></c>
                    <c capture="False"><textvalue>Live consistency checks and handoff items.</textvalue></c>
                </row>
                <stylerule range="A1:B1" background="#F1F5FA" />
                <stylerule range="A2:B2" background="#FFF8E9" />
                <stylerule range="A3:B3" background="#EFF7F1" />
            </table>
        </embed>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="2" spacingbefore="4" fontweight="bold" textcolor="#1766A0" keepwithnext="True" texthighlight="#EDF3F8">STEP 7 OF 7 | Check balance and complete the design handoff</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0">
            <dynexp mathlayout="off" formula="Check_geometry = If(And(h_f &gt; 0 ft, R_f &gt; 0 ft, h_tan &gt;= 0 ft, z_base &gt;= 0 ft, L_trib &gt; 0 ft), &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" showsteps="false" seplines="False" style="Result only" showresult="True" showidentifier="False" showformula="False">
                <expresult>✓ PASS</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Check the basic dimensions used by the prescribed fence load model.</paragraph>
        <section name="EqNotes_FenceWind_046_Check_geometry" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8" level="1">The fence height and hoop radius must be positive, the straight-leg height must not be negative, and the cap-reference and tributary dimensions must be valid.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="2" spacingbefore="4" fontweight="bold" textcolor="#1766A0" keepwithnext="True" texthighlight="#EDF3F8" id="paragraphrefreturn0027">STEP 7 OF 7 | Check balance and complete the design handoff</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="6" spacingafter="0">
            <dynexp mathlayout="off" formula="Check_balance = If(And(Abs(M_fence - F_fence*z_eff) &lt; 0.000001 kip*ft, Abs(F_cap_T_III - F_c_III - F_fence) &lt; 0.000001 kip, Abs(M_cap_L_III - M_c_III - M_fence) &lt; 0.000001 kip*ft, Abs(F_cap_T_SI - F_c_SI - F_fence) &lt; 0.000001 kip, Abs(M_cap_L_SI - M_c_SI - M_fence) &lt; 0.000001 kip*ft), &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" showsteps="false" seplines="False" style="Result only" showresult="True" showidentifier="False" showformula="False">
                <expresult>✓ PASS</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1" fontweight="bold">Check the fence resultant and cap-reference totals.</paragraph>
        <section name="EqNotes_FenceWind_047_Check_balance" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8" level="1">The live check verifies the equivalent-height identity and the Strength III/Service I force-and-moment additions. It does not establish member or foundation capacity.</paragraph>
        </section>
        <embed spacingafter="12">
            <table name="FWChecksTable" title="Consistency checks" capture="False" colwidths="1:300, 2:220">
                <stylerule range="A1:B4" background="#EFF7F1" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#6A9075&quot;);" fontfamily="Times New Roman" fontsize="10" />
                <stylerule range="A1:B1" background="#DCECE0" fontweight="bold" />
                <row>
                    <c capture="False"><textvalue>Check</textvalue></c>
                    <c capture="False"><textvalue>Result</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Fence/tributary geometry</textvalue></c>
                    <c capture="False" formula="Check_geometry"><textvalue>✓ PASS</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>LRFD simplified-method qualification</textvalue></c>
                    <c capture="False" formula="Check_simplified"><textvalue>✓ PASS</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Resultant equilibrium</textvalue></c>
                    <c capture="False" formula="Check_balance"><textvalue>✓ PASS</textvalue></c>
                </row>
            </table>
        </embed>
        <embed spacingafter="12">
            <table name="FWTransferChecks" title="Transfer checks" capture="False" colwidths="1:300, 2:220">
                <stylerule range="A1:B3" background="#EFF7F1" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#6A9075&quot;);" fontfamily="Times New Roman" fontsize="10" />
                <stylerule range="A1:B1" background="#DCECE0" fontweight="bold" />
                <row>
                    <c capture="False"><textvalue>Verification</textvalue></c>
                    <c capture="False"><textvalue>Result</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Tributary length = half the sum of spans</textvalue></c>
                    <c capture="False" formula="If(Abs(L_trib-(BridgeGeometry_2Beam.Span_1+BridgeGeometry_2Beam.Span_2)/2)&lt;1E-06 ft, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)"><textvalue>✓ PASS</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Simplified longitudinal force and moment components follow the 25% rule</textvalue></c>
                    <c capture="False" formula="If(And(Abs(F_cap_L_III - 0.25*F_cap_T_III) &lt; 0.000001 kip, Abs(M_cap_T_III - (0.25*M_c_III + 0.25*F_fence*z_mid)) &lt; 0.000001 kip*ft, Abs(F_cap_L_SI - 0.25*F_cap_T_SI) &lt; 0.000001 kip, Abs(M_cap_T_SI - (0.25*M_c_SI + 0.25*F_fence*z_mid)) &lt; 0.000001 kip*ft), &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)"><textvalue>✓ PASS</textvalue></c>
                </row>
            </table>
        </embed>
        <embed spacingbefore="8" spacingafter="12">
            <table name="FWContentBox18" capture="False" colwidths="1:520">
                <stylerule range="A1:A4" background="#F1F5FA" fontfamily="Times New Roman" fontsize="11" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;);" />
                <stylerule range="A1" background="#DCE7F3" fontweight="bold" />
                <row>
                    <textcell capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" spacingbefore="8" fontweight="bold">MEANING OF PASS</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• These checks establish geometry consistency and load bookkeeping; they do not establish member, connection, bearing, or foundation capacity.</paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">
                            • Confirm
                            <link address="#CodeReferencesC002.CodePage16;paragraphprojectcoderef16C002">LRFD 13.8.2</link>
                            fence applicability, the simplified-method span/height qualification, hoop geometry, cap reference, direct-pier wind direction mapping, and analysis-model axes before final use.
                        </paragraph>
                    </textcell>
                </row>
                <row>
                    <textcell capture="False">
                        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" level="1">• Address attachment resistance, deck uplift, FE analysis, bearings, piles, and foundations in their designated calculations.</paragraph>
                    </textcell>
                </row>
            </table>
        </embed>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="12" level="1">Handoff status: the live checks verify the identities named in the tables. The physical node list, direction-matched direct wall cases, separate deck uplift load, and component/connection resistance checks must be completed in their designated analysis and design calculations.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6">
            <link address="#FBMPPier.FBMPEntryReference;paragraphfbmpentry">Four-bearing node loads and matching wind cases</link>
        </paragraph>
    </report>
