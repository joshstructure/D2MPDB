    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strain ε_s</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="T_th_P = 0.25*φ_v*0.126*λ*Sqrt(fc/(1 ksi))*(1 ksi)*(b*h)^2/(2*(b + h))*Sqrt(Max(0, 1 - N_P/(b*h)/(0.126*λ*Sqrt(fc/(1 ksi))*(1 ksi)))) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>T_th_P = 0.25*φ_v*0.126*λ*Sqrt(fc/(1 ksi))*(1 ksi)*(b*h)^2/(2*(b + h))*Sqrt(Max(0, 1 - N_P/(b*h)/(0.126*λ*Sqrt(fc/(1 ksi))*(1 ksi)))) to kip*ft</expbody>
