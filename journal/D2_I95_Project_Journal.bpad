                    <planecontainer origin="5.52,1.3,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="10" textcolor="#1766A0" fontweight="bold" formula="If(FBMPPier.FE_axisL == -1,&quot;+L&quot;,&quot;&quot;)"><textvalue></textvalue></planecontainer>
