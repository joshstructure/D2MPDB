          <num>0.293 in^2/ft</num>
        </c>
        <c formula="s_tp_11 to in" capture="False" background="#EFF7F1">
          <num>29.250 in</num>
        </c>
        <c formula="DC_ta_11" capture="False" background="#EFF7F1">
          <num>0.716</num>
        </c>
        <c formula="DC_ts_11" capture="False" background="#EFF7F1">
          <num>2.438</num>
