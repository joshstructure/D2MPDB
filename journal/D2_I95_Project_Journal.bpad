        <expbody>F_req_M = Max(0 kip, F_mo_M + F_ax_M + F_di_M) to kip</expbody>
        <expresult> = 0.683 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">required tension</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_cap_M = A_st_M*fy to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_cap_M = A_st_M*fy to kip</expbody>
        <expresult> = 38.910 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">tension capacity A_s f_y</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_L_M = F_req_M/F_cap_M" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>DC_L_M = F_req_M/F_cap_M</expbody>
        <expresult> = 0.018</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">longitudinal tension D/C</paragraph>
  </section>
  <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True">8.5 Station results</paragraph>
