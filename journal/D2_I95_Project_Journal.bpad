        </c>
        <c formula="P_u_1 to kip" capture="False" background="#EFF7F1">
          <num>144.990 kip</num>
        </c>
        <c formula="M_res_1 to kip*ft" capture="False" background="#EFF7F1">
          <num>69.816 kip*ft</num>
        </c>
        <c formula="V_res_1 to kip" capture="False" background="#EFF7F1">
          <num>7.343 kip</num>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>2. 5.6.4.5</textvalue>
        </c>
        <c formula="P_fbmp_2 to kip" capture="False" background="#EFF7F1">
          <num>84.010 kip</num>
        </c>
        <c formula="P_u_2 to kip" capture="False" background="#EFF7F1">
          <num>123.610 kip</num>
        </c>
        <c formula="M_res_2 to kip*ft" capture="False" background="#EFF7F1">
          <num>102.797 kip*ft</num>
        </c>
        <c formula="V_res_2 to kip" capture="False" background="#EFF7F1">
          <num>1.592 kip</num>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>3. Resultant</textvalue>
        </c>
        <c formula="P_fbmp_3 to kip" capture="False" background="#EFF7F1">
          <num>80.640 kip</num>
        </c>
        <c formula="P_u_3 to kip" capture="False" background="#EFF7F1">
          <num>120.240 kip</num>
        </c>
        <c formula="M_res_3 to kip*ft" capture="False" background="#EFF7F1">
          <num>102.797 kip*ft</num>
        </c>
        <c formula="V_res_3 to kip" capture="False" background="#EFF7F1">
          <num>4.599 kip</num>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>4. Shear</textvalue>
        </c>
        <c formula="P_fbmp_4 to kip" capture="False" background="#EFF7F1">
          <num>92.500 kip</num>
        </c>
        <c formula="P_u_4 to kip" capture="False" background="#EFF7F1">
          <num>132.100 kip</num>
        </c>
        <c formula="M_res_4 to kip*ft" capture="False" background="#EFF7F1">
          <num>62.547 kip*ft</num>
        </c>
        <c formula="V_res_4 to kip" capture="False" background="#EFF7F1">
          <num>8.762 kip</num>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>5. Svc comp.</textvalue>
        </c>
        <c formula="P_fbmp_5 to kip" capture="False" background="#EFF7F1">
          <num>90.280 kip</num>
        </c>
        <c formula="P_u_5 to kip" capture="False" background="#EFF7F1">
          <num>126.280 kip</num>
        </c>
        <c formula="M_res_5 to kip*ft" capture="False" background="#EFF7F1">
          <num>43.676 kip*ft</num>
        </c>
        <c formula="V_res_5 to kip" capture="False" background="#EFF7F1">
          <num>1.318 kip</num>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>6. Svc tens.</textvalue>
        </c>
        <c formula="P_fbmp_6 to kip" capture="False" background="#EFF7F1">
          <num>50.320 kip</num>
        </c>
        <c formula="P_u_6 to kip" capture="False" background="#EFF7F1">
          <num>86.320 kip</num>
        </c>
        <c formula="M_res_6 to kip*ft" capture="False" background="#EFF7F1">
          <num>36.150 kip*ft</num>
        </c>
        <c formula="V_res_6 to kip" capture="False" background="#EFF7F1">
          <num>3.081 kip</num>
        </c>
      </row>
    </table>
  </embed>
  <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">4. Pile spacing</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="S_min = 3*D_pile to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>S_min = 3*D_pile to in</expbody>
      <expresult> = 54.000 in</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum center-to-center spacing, 3.0 diameters (SDG 3.5.4)</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="s_over_D = S_pile/D_pile" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>s_over_D = S_pile/D_pile</expbody>
      <expresult> = 3.000</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">provided spacing in pile diameters</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="DC_sp = S_min/S_pile" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>DC_sp = S_min/S_pile</expbody>
      <expresult> = 1.000</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">spacing D/C</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" pagebreakbefore="break">5. Section and prestress</paragraph>
  <embed spacingbefore="4" spacingafter="5">
    <canvas name="Figure1Section" title="Pile section" unit="in" size="6.5 in; 4.2 in; scaletofit">
      <include target="Library.Geometry"/>
      <planecontainer origin="0.15,4.05,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#29333D">
        <textvalue>PILE SECTION — 18 in square, 12 strands, Index 455-018, pattern 12~0.6</textvalue>
      </planecontainer>
      <plot formula="PlotLines([1.1,3.8,3.8,1.1,1.1],[0.85,0.85,3.55,3.55,0.85])" linecolor="#29333D" linethickness="1.8"/>
      <plot formula="PlotLines([1.625,3.275,3.275,1.625,1.625],[1.375,1.375,3.025,3.025,1.375])" linecolor="#7B8993" linethickness="0.6"/>
      <plot formula="PlotLines([0.95,3.95],[2.2,2.2])" linecolor="#AAB4BD" linethickness="0.5"/>
      <plot formula="PlotLines([2.45,2.45],[0.7,3.7])" linecolor="#AAB4BD" linethickness="0.5"/>
      <circle center="1.625, 1.375, 0" normal="0, 0, 1" radius="0.063" linethickness="0.6" linecolor="#7B241C" fillcolor="#B35012"/>
      <circle center="2.175, 1.375, 0" normal="0, 0, 1" radius="0.063" linethickness="0.6" linecolor="#7B241C" fillcolor="#B35012"/>
      <circle center="2.725, 1.375, 0" normal="0, 0, 1" radius="0.063" linethickness="0.6" linecolor="#7B241C" fillcolor="#B35012"/>
      <circle center="3.275, 1.375, 0" normal="0, 0, 1" radius="0.063" linethickness="0.6" linecolor="#7B241C" fillcolor="#B35012"/>
      <circle center="1.625, 1.925, 0" normal="0, 0, 1" radius="0.063" linethickness="0.6" linecolor="#7B241C" fillcolor="#B35012"/>
      <circle center="3.275, 1.925, 0" normal="0, 0, 1" radius="0.063" linethickness="0.6" linecolor="#7B241C" fillcolor="#B35012"/>
      <circle center="1.625, 2.475, 0" normal="0, 0, 1" radius="0.063" linethickness="0.6" linecolor="#7B241C" fillcolor="#B35012"/>
      <circle center="3.275, 2.475, 0" normal="0, 0, 1" radius="0.063" linethickness="0.6" linecolor="#7B241C" fillcolor="#B35012"/>
      <circle center="1.625, 3.025, 0" normal="0, 0, 1" radius="0.063" linethickness="0.6" linecolor="#7B241C" fillcolor="#B35012"/>
      <circle center="2.175, 3.025, 0" normal="0, 0, 1" radius="0.063" linethickness="0.6" linecolor="#7B241C" fillcolor="#B35012"/>
      <circle center="2.725, 3.025, 0" normal="0, 0, 1" radius="0.063" linethickness="0.6" linecolor="#7B241C" fillcolor="#B35012"/>
      <circle center="3.275, 3.025, 0" normal="0, 0, 1" radius="0.063" linethickness="0.6" linecolor="#7B241C" fillcolor="#B35012"/>
      <lines pts="0.824, 1.539, 0; 4.076, 2.861, 0" linecolor="#167B75" linepattern="Dashes" linethickness="1.1"/>
      <lines pts="0.696, 2.132, 0; 4.204, 2.268, 0" linecolor="#1766A0" linepattern="Dashes" linethickness="1.1"/>
      <lineardim startpoint="1.1, 0.85, 0" endpoint="3.8, 0.85, 0" pointondimline="2.45, 0.47, 0" formula="PileDesignEndBentOne.D_pile" linecolor="#5D6F80" textcolor="#5D6F80" linethickness="0.7" fontsize="9">
        <num>18.000 in</num>
      </lineardim>
      <lineardim startpoint="1.1, 3.55, 0" endpoint="1.625, 3.55, 0" pointondimline="1.363, 3.83, 0" formula="PileDesignEndBentOne.d_edge" linecolor="#B35012" textcolor="#B35012" linethickness="0.7" fontsize="9">
        <num>3.500 in</num>
      </lineardim>
      <plot formula="PlotLines([4.1,4.45],[3.05,3.05])" linecolor="#167B75" linethickness="1.4"/>
      <planecontainer origin="4.52,3.01,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D">
        <textvalue>resultant axis, alpha =</textvalue>
      </planecontainer>
      <planecontainer origin="5.84,3.01,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D" formula="PileDesignEndBentOne.alpha_rs/(1 deg)">
        <num>22.121</num>
      </planecontainer>
      <planecontainer origin="6.231,3.01,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D">
        <textvalue>deg</textvalue>
      </planecontainer>
      <plot formula="PlotLines([4.1,4.45],[2.8,2.8])" linecolor="#1766A0" linethickness="1.4"/>
      <planecontainer origin="4.52,2.76,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D">
        <textvalue>shear-record axis, alpha =</textvalue>
      </planecontainer>
      <planecontainer origin="6.005,2.76,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D" formula="PileDesignEndBentOne.alpha_sh/(1 deg)">
        <num>2.227</num>
      </planecontainer>
      <planecontainer origin="6.341,2.76,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D">
        <textvalue>deg</textvalue>
      </planecontainer>
      <planecontainer origin="4.1,1.55,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#B35012">
        <textvalue>red circles: prestressing strands</textvalue>
      </planecontainer>
      <planecontainer origin="4.1,1.35,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#7B8993">
        <textvalue>grey square: strand centre line</textvalue>
      </planecontainer>
    </canvas>
  </embed>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Figure 1. Pile cross-section: strand pattern of the Standard Plans option and the bending axes of the governing resultant and shear records. The outline and strands are the notebook's layout as a picture; the dimensions and the bending-axis angles are live.</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="A_ps = N_str*A_str to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>A_ps = N_str*A_str to in^2</expbody>
      <expresult> = 2.604 in^2</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">prestressing steel area</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="f_pj = P_jack/A_str to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>f_pj = P_jack/A_str to ksi</expbody>
      <expresult> = 161.290 ksi</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">jacking stress per strand</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="f_pe = f_pj*(1 - loss_frac) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>f_pe = f_pj*(1 - loss_frac) to ksi</expbody>
      <expresult> = 129.032 ksi</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">effective prestress after losses</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="P_e = A_ps*f_pe to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>P_e = A_ps*f_pe to kip</expbody>
      <expresult> = 336.000 kip</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">effective prestress force</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="A_g = D_pile^2 - 0.785398163397448*d_void^2 to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>A_g = D_pile^2 - 0.785398163397448*d_void^2 to in^2</expbody>
      <expresult> = 324.000 in^2</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">gross area (chamfers ignored)</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="I_g = D_pile^4/12 - 0.0490873852123405*d_void^4 to in^4" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>I_g = D_pile^4/12 - 0.0490873852123405*d_void^4 to in^4</expbody>
      <expresult> = 8748.000 in^4</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">gross moment of inertia</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="S_g = I_g/(D_pile/2) to in^3" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>S_g = I_g/(D_pile/2) to in^3</expbody>
      <expresult> = 972.000 in^3</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">section modulus</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="f_pc_eff = P_e/A_g to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>f_pc_eff = P_e/A_g to ksi</expbody>
      <expresult> = 1.037 ksi</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">effective uniform prestress on the gross area</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="β_1 = Min(0.85, Max(0.65, 0.85 - 0.05*(fc - (4 ksi))/(1 ksi)))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>β_1 = Min(0.85, Max(0.65, 0.85 - 0.05*(fc - (4 ksi))/(1 ksi)))</expbody>
      <expresult> = 0.725</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">stress block factor, 5.6.2.2</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="E_c = 120000*K_1*(w_c/(1 kip/ft^3))^2*(fc/(1 ksi))^0.33*(1 ksi) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>E_c = 120000*K_1*(w_c/(1 kip/ft^3))^2*(fc/(1 ksi))^0.33*(1 ksi) to ksi</expbody>
      <expresult> = 5007.549 ksi</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">concrete modulus, 5.4.2.4-1</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="eps_cu = 0.003" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>eps_cu = 0.003</expbody>
      <expresult> = 0.003</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">concrete crushing strain</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="k_c = Min(0.85, Max(0.75, 0.85 - 0.02*Max(fc - (10 ksi), 0 ksi)/(1 ksi)))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>k_c = Min(0.85, Max(0.75, 0.85 - 0.02*Max(fc - (10 ksi), 0 ksi)/(1 ksi)))</expbody>
      <expresult> = 0.850</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">ratio of maximum concrete stress to f'c</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="eps_pe = f_pe/E_p" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>eps_pe = f_pe/E_p</expbody>
      <expresult> = 0.005</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">effective prestrain</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="eps_ce = f_pc_eff/E_c" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>eps_ce = f_pc_eff/E_c</expbody>
      <expresult> = 0.000</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">concrete decompression strain</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="12" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="6" keepwithnext="True">Strand coordinates (one strand at each corner, equal spacing between, concentric)</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="k_row = N_str/4 + 1" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>k_row = N_str/4 + 1</expbody>
      <expresult> = 4.000</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strands on each face</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="p_st = (D_pile - 2*d_edge)/(k_row - 1) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>p_st = (D_pile - 2*d_edge)/(k_row - 1) to in</expbody>
      <expresult> = 3.667 in</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strand pitch</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="h_st = D_pile/2 - d_edge to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>h_st = D_pile/2 - d_edge to in</expbody>
      <expresult> = 5.500 in</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strand distance from the centroid, each face</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="b_st_1 = If(0 &lt; k_row, 0, If(0 &lt; 2*k_row, k_row, If(0 &lt; 3*k_row - 2, 2*k_row - 1, 3*k_row - 3)))" mathlayout="on" showformula="True" showresult="False" showsteps="False">
      <expbody>b_st_1 = If(0 &lt; k_row, 0, If(0 &lt; 2*k_row, k_row, If(0 &lt; 3*k_row - 2, 2*k_row - 1, 3*k_row - 3)))</expbody>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">first strand index of the face the strand is on</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="j_st_1 = 0 - b_st_1" mathlayout="on" showformula="True" showresult="False" showsteps="False">
      <expbody>j_st_1 = 0 - b_st_1</expbody>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">position along the face</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="x_st_1 = If(0 &lt; 2*k_row, -h_st + j_st_1*p_st, If(0 &lt; 3*k_row - 2, -h_st, h_st)) to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
      <expbody>x_st_1 = If(0 &lt; 2*k_row, -h_st + j_st_1*p_st, If(0 &lt; 3*k_row - 2, -h_st, h_st)) to in</expbody>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strand x</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="y_st_1 = If(0 &lt; k_row, -h_st, If(0 &lt; 2*k_row, h_st, -h_st + j_st_1*p_st)) to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
