                        <c capture="False" formula="NB_zn to ft in"><num>0 ft 0 in</num></c>
                        <c capture="False" formula="NB_l1 to ft in"><num>53 ft 8.100000000000023 in</num></c>
                    </row>
                    <row>
                        <c capture="False"><textvalue>B2</textvalue></c>
                        <c capture="False"><textvalue>1</textvalue></c>
