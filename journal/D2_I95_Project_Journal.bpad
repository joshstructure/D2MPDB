        </section>
        <paragraph fontfamily="Times New Roman" fontsize="1" spacingbefore="0" spacingafter="0" pagebreakafter="break"> </paragraph>
        <section name="CodePage05" capture="True" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="40" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" id="paragraphprojectcoderef05C004" textcolor="#155731" texthighlight="#DDEFE3">
                <link address="#CodeReferencesC004.CodePage05;paragraphprojectcoderef05C004">REFERENCE 05 | FDOT SDG 2.4.1.B-C</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC004.CodePage05;paragraphprojectcoderef05C004">FDOT Structures Manual, January 2026</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" textcolor="#536575">Printed 2-7 | Source PDF page 75</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">USED FOR</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Governs exposure selection and supplies the amended gust factor used in bridge and direct-pier wind pressures.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Variables: Exp_Cat; G_fac; G_f; K_Z_gov</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">SCOPE / REVIEW NOTE</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">The FDOT gust factor replaces the base LRFD gust table. Exposure remains a site/direction criterion.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC004.CodePage07;paragraphprojectcoderef07C004">Related: LRFD 3.8.1.1.5; Eq. 3.8.1.2.1-1</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC004.CodePage09;paragraphprojectcoderef09C004">Related: LRFD 3.8.1.2.1; Table 3.8.1.2.1-2</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">RETURN TO CALCULATIONS</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0005">C001 | 1.2. Wind Speed and Exposure</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0006">C001 | 1.3. Structure Type and Coefficients</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0015">C001 | 4.2. Strength V Wind Pressure</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0016">C001 | 4.3. Service I Wind Pressure</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind.FWCodeBasis;paragraphfwcodec06">C002 | Design basis</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind;paragraphrefreturn0025">C002 | Wind acting directly on the pier</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#SuperstructureUplift.UpliftStrategyWork03;headingSuperstructureUplift3">C004 | Concurrent wind and bearing equilibrium (upstream basis)</link>
            </paragraph>
