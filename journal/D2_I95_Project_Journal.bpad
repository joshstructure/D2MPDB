                    <planecontainer origin="1.66,2.12,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="10" textcolor="#29333D"><textvalue>36-in cap depth</textvalue></planecontainer>
                    <planecontainer origin="3.05,1.12,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#C46A23"><textvalue>Bearing CL</textvalue></planecontainer>
                    <planecontainer origin="0.2,1.12,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#29333D"><textvalue>Centered pile CL</textvalue></planecontainer>
                    <plot formula="PlotLines([1.5,1.3+.07*BridgeGeometry_2Beam.EndBent_pileCL_fromRear/(1 in)-.32],[1.12,1.12])" linecolor="#667887" linethickness="0.7" />
                    <plot formula="PlotLines([1.3+.07*BridgeGeometry_2Beam.EndBent_rearFaceInset/(1 in),1.3+.07*BridgeGeometry_2Beam.EndBent_rearFaceInset/(1 in)+.07*BridgeGeometry_2Beam.Backwall_thickness_shown/(1 in)],[4.38,4.38])" linecolor="#1766A0" linethickness="0.8" />
                    <plot formula="PlotLines([1.3+.07*BridgeGeometry_2Beam.EndBent_rearFaceInset/(1 in),1.3+.07*BridgeGeometry_2Beam.EndBent_rearFaceInset/(1 in)],[4.38-.07,4.38+.07])" linecolor="#1766A0" linethickness="0.8" />
                    <plot formula="PlotLines([1.3+.07*BridgeGeometry_2Beam.EndBent_rearFaceInset/(1 in)+.07*BridgeGeometry_2Beam.Backwall_thickness_shown/(1 in),1.3+.07*BridgeGeometry_2Beam.EndBent_rearFaceInset/(1 in)+.07*BridgeGeometry_2Beam.Backwall_thickness_shown/(1 in)],[4.38-.07,4.38+.07])" linecolor="#1766A0" linethickness="0.8" />
                    <planecontainer origin="1.32,4.57,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#1766A0" formula="BridgeGeometry_2Beam.Backwall_thickness_shown to in"><num>12 in</num></planecontainer>
                    <plot formula="PlotLines([1.3+.07*BridgeGeometry_2Beam.EndBent_rearFaceInset/(1 in)+.07*BridgeGeometry_2Beam.Backwall_thickness_shown/(1 in),1.3+.07*BridgeGeometry_2Beam.EndBent_rearFaceInset/(1 in)+.07*BridgeGeometry_2Beam.Backwall_thickness_shown/(1 in)+.07*BridgeGeometry_2Beam.EndBent_beamEndClear/(1 in)],[4.75,4.75])" linecolor="#1766A0" linethickness="0.8" />
