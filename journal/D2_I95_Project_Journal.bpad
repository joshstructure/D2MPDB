    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strand depth from the extreme compression fiber</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="d_t_x = Max(d_st_x_1, d_st_x_2, d_st_x_3, d_st_x_4, d_st_x_5, d_st_x_6, d_st_x_7, d_st_x_8, d_st_x_9, d_st_x_10, d_st_x_11, d_st_x_12) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>d_t_x = Max(d_st_x_1, d_st_x_2, d_st_x_3, d_st_x_4, d_st_x_5, d_st_x_6, d_st_x_7, d_st_x_8, d_st_x_9, d_st_x_10, d_st_x_11, d_st_x_12) to in</expbody>
      <expresult> = 14.500 in</expresult>
    </dynexp>
  </paragraph>
