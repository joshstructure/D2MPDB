        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="7">
            <link address="#CodeReferencesGeneral;paragraphreferenceindex">Code references and calculation backlinks</link>
        </paragraph>
        <stylerule type="AnyEquation" name="Required Input" texthighlight="#F7E6B9" />
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="8" id="paragraphrefreturn0034">
            <link address="#SuperstructureUplift.UpliftStrategyStep01;paragraphupliftstrategy01">Code basis and calculation strategy</link>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="16" spacingafter="4" fontweight="bold" horzalign="Left">D2 MPDB PEDESTRIAN BRIDGE</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" spacingbefore="0" fontweight="bold" background="#FFF8E9">
            <dynexp formula="Status_transfer" mathlayout="on" showsteps="False" showformula="False" showidentifier="False" showresult="True" seplines="False" style="Result only">
                <expresult>Source checks pass; confirm final geometry, restraints and model axes.</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="4" fontweight="bold" horzalign="Left">C004 — SUPERSTRUCTURE UPLIFT AND BEARING REACTIONS</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" id="paragraphrefreturn0033">
            Design basis:
            <link address="#CodeReferencesC004.CodePage17;paragraphprojectcoderef17C004">LRFD 10th Edition (2024)</link>
            ; FDOT Structures Manual, January 2026.
            <link address="#CodeReferencesC004.CodePage01;paragraphprojectcoderef01C004">RFQ V6.0 Addendum 5 — Governing Regulations</link>
            controls the contract edition and Task Work Order exceptions.
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="12" spacingbefore="6">
            <dynexp formula="Today()" mathlayout="on" showsteps="False" showformula="False" showidentifier="False" showresult="True" seplines="False" style="Result only">
                <expresult>2026-10-13</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" fontweight="bold" spacingbefore="0" keepwithnext="True">CALCULATION OVERVIEW</paragraph>
        <embed spacingbefore="8" spacingafter="12">
            <table name="UpliftOverviewContext" capture="False" colwidths="1:90, 2:430">
                <stylerule range="A1:B3" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" />
                <stylerule range="A1:B3" fontfamily="Times New Roman" fontsize="10" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 1, &quot;#7189A6&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#CCD9E5&quot;);" />
                <stylerule range="A1:A3" fontweight="bold" />
                <stylerule range="A1:B1" background="#F1F5FA" />
                <row>
                    <c capture="False"><textvalue>Objective</textvalue></c>
                    <c capture="False"><textvalue>Determine global superstructure uplift, bearing reactions and pier load transfer.</textvalue></c>
                </row>
                <stylerule range="A2:B2" background="#FFF8E9" />
                <row>
                    <c capture="False"><textvalue>Inputs</textvalue></c>
                    <c capture="False"><textvalue>C001 wind; C002 fence load; live bridge geometry and classified permanent loads.</textvalue></c>
                </row>
                <stylerule range="A3:B3" background="#EFF7F1" />
                <row>
                    <c capture="False"><textvalue>Output</textvalue></c>
                    <c capture="False"><textvalue>Concurrent bearing reactions, contact/stability checks and signed pier load sets.</textvalue></c>
                </row>
            </table>
        </embed>
        <embed spacingbefore="8" spacingafter="6">
            <canvas name="UpliftReviewFlow" title="Solution approach and load path" unit="in" size="6.5 in; 2.2 in; scaletofit">
                <include target="Library.Geometry" />
