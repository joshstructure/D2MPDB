      <dynexp formula="s_st_x_9 = -sn_x*x_st_9 + cs_x*y_st_9 to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>s_st_x_9 = -sn_x*x_st_9 + cs_x*y_st_9 to in</expbody>
