        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0">The combination factors reproduce the current journal’s DC/DW/PL/wind subset. Evaluate maximum/minimum permanent-load patterns and all required wind directions; add other applicable project actions separately. The arithmetic checks below verify entry equilibrium, not model restraint or member capacity.</paragraph>
        <embed spacingbefore="5" spacingafter="10" leftindent="0">
            <table name="EBChecks" capture="False" colwidths="1:100, 2:200, 3:300">
                <stylerule range="A1:C6" fontfamily="Times New Roman" fontsize="9.5" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.7, &quot;#7189A6&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.35, &quot;#CCD6D0&quot;); Border(&quot;BetweenColumns&quot;, &quot;Solid&quot;, 0.35, &quot;#CCD6D0&quot;);" horzalign="Center" vertalign="Center" />
                <stylerule range="A1:C1" background="#DCECE0" fontweight="bold" />
                <stylerule range="A2:C6" background="#EFF7F1" />
                <row>
                    <c capture="False"><textvalue>Case</textvalue></c>
                    <c capture="False"><textvalue>Force / gravity balance</textvalue></c>
                    <c capture="False"><textvalue>Moment balance</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>DC / PL</textvalue></c>
                    <c capture="False" formula="EB_CheckGravity"><textvalue>PASS</textvalue></c>
                    <c capture="False"><textvalue>—</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>W1</textvalue></c>
                    <c capture="False" formula="EB_CheckF_W1"><textvalue>PASS</textvalue></c>
                    <c capture="False" formula="EB_CheckM_W1"><textvalue>PASS</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>W2</textvalue></c>
                    <c capture="False" formula="EB_CheckF_W2"><textvalue>PASS</textvalue></c>
                    <c capture="False" formula="EB_CheckM_W2"><textvalue>PASS</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>W3</textvalue></c>
                    <c capture="False" formula="EB_CheckF_W3"><textvalue>PASS</textvalue></c>
                    <c capture="False" formula="EB_CheckM_W3"><textvalue>PASS</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Transfer geometry</textvalue></c>
                    <c capture="False" formula="EB_CheckGeometry"><textvalue>PASS</textvalue></c>
