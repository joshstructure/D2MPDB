                    <plot formula="PlotLines([1.3+.07*BridgeGeometry_2Beam.EndBent_rearFaceInset/(1 in)+.07*BridgeGeometry_2Beam.Backwall_thickness_shown/(1 in),1.3+.07*BridgeGeometry_2Beam.EndBent_rearFaceInset/(1 in)+.07*BridgeGeometry_2Beam.Backwall_thickness_shown/(1 in)],[4.38-.07,4.38+.07])" linecolor="#1766A0" linethickness="0.8" />
