  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" level="1"><dynexp formula="SP_B = 8.000000999999997 in" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input"><expbody>SP_B = 8.000000999999997 in</expbody></dynexp><break type="tab"/>bottom bar spacing, fitted</paragraph>
