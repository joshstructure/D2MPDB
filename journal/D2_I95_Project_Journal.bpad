                        <expbody>FE_CheckF_W3 = If(And(AX_Base_FE_CheckF_W3 == "✓ PASS",Abs(FE_SumFT_W3-FE_axisT*AX_Base_FE_SumFT_W3)&lt;0.000001 kip,Abs(FE_SumFL_W3-FE_axisL*AX_Base_FE_SumFL_W3)&lt;0.000001 kip,Abs(FE_SumFV_W3-FE_axisV*AX_Base_FE_SumFV_W3)&lt;0.000001 kip),"✓ PASS","⊗ FAIL")</expbody>
                        <expresult> = ✓ PASS</expresult>
                    </dynexp>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" leftindent="0" spacingbefore="0" keepwithnext="True">
                    <dynexp formula="FE_SumMT_W3=(FE_h*(FE_L_B1*FE_FV_W3_B1-FE_V_B1*FE_FL_W3_B1)+FE_MT_W3_B1)+(FE_h*(FE_L_B2*FE_FV_W3_B2-FE_V_B2*FE_FL_W3_B2)+FE_MT_W3_B2)+(FE_h*(FE_L_B3*FE_FV_W3_B3-FE_V_B3*FE_FL_W3_B3)+FE_MT_W3_B3)+(FE_h*(FE_L_B4*FE_FV_W3_B4-FE_V_B4*FE_FL_W3_B4)+FE_MT_W3_B4) to kip*ft" mathlayout="on" showsteps="False" seplines="False">
                        <expbody>FE_SumMT_W3=(FE_h*(FE_L_B1*FE_FV_W3_B1-FE_V_B1*FE_FL_W3_B1)+FE_MT_W3_B1)+(FE_h*(FE_L_B2*FE_FV_W3_B2-FE_V_B2*FE_FL_W3_B2)+FE_MT_W3_B2)+(FE_h*(FE_L_B3*FE_FV_W3_B3-FE_V_B3*FE_FL_W3_B3)+FE_MT_W3_B3)+(FE_h*(FE_L_B4*FE_FV_W3_B4-FE_V_B4*FE_FL_W3_B4)+FE_MT_W3_B4) to kip*ft</expbody>
                        <expresult> = 69.548 kip*ft</expresult>
                    </dynexp>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" leftindent="0" spacingbefore="0" keepwithnext="True">
                    <dynexp formula="FE_SumML_W3=(FE_h*(FE_V_B1*FE_FT_W3_B1-FE_T_B1*FE_FV_W3_B1)+FE_ML_W3_B1)+(FE_h*(FE_V_B2*FE_FT_W3_B2-FE_T_B2*FE_FV_W3_B2)+FE_ML_W3_B2)+(FE_h*(FE_V_B3*FE_FT_W3_B3-FE_T_B3*FE_FV_W3_B3)+FE_ML_W3_B3)+(FE_h*(FE_V_B4*FE_FT_W3_B4-FE_T_B4*FE_FV_W3_B4)+FE_ML_W3_B4) to kip*ft" mathlayout="on" showsteps="False" seplines="False">
                        <expbody>FE_SumML_W3=(FE_h*(FE_V_B1*FE_FT_W3_B1-FE_T_B1*FE_FV_W3_B1)+FE_ML_W3_B1)+(FE_h*(FE_V_B2*FE_FT_W3_B2-FE_T_B2*FE_FV_W3_B2)+FE_ML_W3_B2)+(FE_h*(FE_V_B3*FE_FT_W3_B3-FE_T_B3*FE_FV_W3_B3)+FE_ML_W3_B3)+(FE_h*(FE_V_B4*FE_FT_W3_B4-FE_T_B4*FE_FV_W3_B4)+FE_ML_W3_B4) to kip*ft</expbody>
                        <expresult> = -278.191 kip*ft</expresult>
                    </dynexp>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" leftindent="0" spacingbefore="0" keepwithnext="True">
                    <dynexp formula="FE_SumMV_W3=(FE_h*(FE_T_B1*FE_FL_W3_B1-FE_L_B1*FE_FT_W3_B1)+FE_MV_W3_B1)+(FE_h*(FE_T_B2*FE_FL_W3_B2-FE_L_B2*FE_FT_W3_B2)+FE_MV_W3_B2)+(FE_h*(FE_T_B3*FE_FL_W3_B3-FE_L_B3*FE_FT_W3_B3)+FE_MV_W3_B3)+(FE_h*(FE_T_B4*FE_FL_W3_B4-FE_L_B4*FE_FT_W3_B4)+FE_MV_W3_B4) to kip*ft" mathlayout="on" showsteps="False" seplines="False">
                        <expbody>FE_SumMV_W3=(FE_h*(FE_T_B1*FE_FL_W3_B1-FE_L_B1*FE_FT_W3_B1)+FE_MV_W3_B1)+(FE_h*(FE_T_B2*FE_FL_W3_B2-FE_L_B2*FE_FT_W3_B2)+FE_MV_W3_B2)+(FE_h*(FE_T_B3*FE_FL_W3_B3-FE_L_B3*FE_FT_W3_B3)+FE_MV_W3_B3)+(FE_h*(FE_T_B4*FE_FL_W3_B4-FE_L_B4*FE_FT_W3_B4)+FE_MV_W3_B4) to kip*ft</expbody>
                        <expresult> = 0.261 kip*ft</expresult>
                    </dynexp>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" leftindent="0" spacingbefore="0" keepwithnext="True">
                    <dynexp formula="FE_CheckM_W3 = If(And(AX_Base_FE_CheckM_W3 == &quot;✓ PASS&quot;,Abs(FE_SumMT_W3-FE_axisT*AX_Base_FE_SumMT_W3)&lt;0.000001 kip*ft,Abs(FE_SumML_W3-FE_axisL*AX_Base_FE_SumML_W3)&lt;0.000001 kip*ft,Abs(FE_SumMV_W3-FE_axisV*AX_Base_FE_SumMV_W3)&lt;0.000001 kip*ft),&quot;✓ PASS&quot;,&quot;⊗ FAIL&quot;)" mathlayout="on" showsteps="False" seplines="False">
                        <expbody>FE_CheckM_W3 = If(And(AX_Base_FE_CheckM_W3 == "✓ PASS",Abs(FE_SumMT_W3-FE_axisT*AX_Base_FE_SumMT_W3)&lt;0.000001 kip*ft,Abs(FE_SumML_W3-FE_axisL*AX_Base_FE_SumML_W3)&lt;0.000001 kip*ft,Abs(FE_SumMV_W3-FE_axisV*AX_Base_FE_SumMV_W3)&lt;0.000001 kip*ft),"✓ PASS","⊗ FAIL")</expbody>
                        <expresult> = ✓ PASS</expresult>
                    </dynexp>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" leftindent="0" spacingbefore="0" keepwithnext="True">
                    <dynexp formula="FE_CheckGravity=If(And(Abs(FE_TotalDC-(PedBridgeWeights_2Beams.DC_super_B1+PedBridgeWeights_2Beams.DC_super_B2+PedBridgeWeights_2Beams.DC_super_B3+PedBridgeWeights_2Beams.DC_super_B4))&lt;FE_tolF, Abs(FE_TotalPL-(PedBridgeWeights_2Beams.PL_B1+PedBridgeWeights_2Beams.PL_B2+PedBridgeWeights_2Beams.PL_B3+PedBridgeWeights_2Beams.PL_B4))&lt;FE_tolF), &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showsteps="False" seplines="False">
                        <expbody>FE_CheckGravity=If(And(Abs(FE_TotalDC-(PedBridgeWeights_2Beams.DC_super_B1+PedBridgeWeights_2Beams.DC_super_B2+PedBridgeWeights_2Beams.DC_super_B3+PedBridgeWeights_2Beams.DC_super_B4))&lt;FE_tolF, Abs(FE_TotalPL-(PedBridgeWeights_2Beams.PL_B1+PedBridgeWeights_2Beams.PL_B2+PedBridgeWeights_2Beams.PL_B3+PedBridgeWeights_2Beams.PL_B4))&lt;FE_tolF), "✓ PASS", "⊗ FAIL")</expbody>
                        <expresult> = ✓ PASS</expresult>
                    </dynexp>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" leftindent="0">
                    <dynexp formula="FE_axisT = If(FE_AxisTChoice == &quot;Toward B2 / B4&quot;,1,-1)" mathlayout="on" showsteps="False" seplines="False">
