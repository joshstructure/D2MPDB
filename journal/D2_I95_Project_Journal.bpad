        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="4" keepwithnext="True">
            <dynexp formula="P_pile_end = R_1+W_a to kip" mathlayout="on" showsteps="false" seplines="false">
                <expbody>P_pile_end = R_1+W_a to kip</expbody>
                <expresult> = 33.303 kip</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" fontweight="bold">Service wall-plus-fin reaction at either end pile.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="4" keepwithnext="True">
            <dynexp formula="P_pile_int = R_2+R_3+2*W_a to kip" mathlayout="on" showsteps="false" seplines="false">
                <expbody>P_pile_int = R_2+R_3+2*W_a to kip</expbody>
                <expresult> = 24.204 kip</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" fontweight="bold">Service wall-plus-fin reaction at either interior pile.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="4" keepwithnext="True">
            <dynexp formula="M_pile_end = R_1*r_f+W_p*(D_p/2+a_p/2)+W_s*r_nom to kip*ft" mathlayout="on" showsteps="false" seplines="false">
                <expbody>M_pile_end = R_1*r_f+W_p*(D_p/2+a_p/2)+W_s*r_nom to kip*ft</expbody>
                <expresult> = 38.437 kip*ft</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" fontweight="bold">Service wall-induced moment magnitude at an end-pile centerline.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="0" spacingbefore="4" keepwithnext="True">
            <dynexp formula="M_pile_int = (R_3-R_2)*r_f to kip*ft" mathlayout="on" showsteps="false" seplines="false">
                <expbody>M_pile_int = (R_3-R_2)*r_f to kip*ft</expbody>
                <expresult> = 15.201 kip*ft</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" fontweight="bold">Service moment from unequal opposite-fin gravity reactions at an interior pile.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" keepwithnext="True" fontweight="bold">Receiving pile interface — actual wall loads, excluding the bridge background state</paragraph>
        <embed spacingafter="10">
            <table name="C006Table283" title="Receiving pile interface — actual wall loads, excluding the bridge background state" capture="False" colwidths="1:100, 2:120, 3:145, 4:120, 5:165">
