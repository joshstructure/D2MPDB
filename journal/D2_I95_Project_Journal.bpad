                    <c capture="False"><textvalue>Limit state</textvalue></c>
                    <c capture="False"><textvalue>Concurrent wind</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>W1 / III-S</textvalue></c>
                    <c capture="False"><textvalue>Strength III</textvalue></c>
                    <c capture="False"><textvalue>Transverse + longitudinal; no deck uplift</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>W2 / III-U</textvalue></c>
                    <c capture="False"><textvalue>Strength III</textvalue></c>
                    <c capture="False"><textvalue>Transverse + upward deck wind; no longitudinal force</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>W3 / SI-S</textvalue></c>
                    <c capture="False"><textvalue>Service I</textvalue></c>
                    <c capture="False"><textvalue>Transverse + longitudinal; no deck uplift</textvalue></c>
                </row>
            </table>
        </embed>
        <paragraph fontfamily="Times New Roman" fontsize="1" spacingafter="0" leftindent="0" pagebreakafter="break" />
        <heading level="1" keepwithnext="True">DC / PL / W1–W3 - Node Entry Table</heading>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0">
            Force units: kip. Moment units:
            <dynexp formula="EB_MomentUnits" style="Result only" mathlayout="off">
                <expresult>kip-ft</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0">Forces follow the blue positive axes. Moments use the right-hand rule. Use each complete force-and-moment row at the displayed coordinates. Changing axis orientation preserves the physical load and its resultant.</paragraph>
