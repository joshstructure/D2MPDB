                    <planecontainer origin="4.65,2.76,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#29333D"><textvalue>6-in pedestal</textvalue></planecontainer>
                    <plot formula="PlotLines([1.3+.07*(BridgeGeometry_2Beam.EndBentPedestal_fromRear+BridgeGeometry_2Beam.Pedestal_length_endBent)/(1 in),4.55],[2.96,2.82])" linecolor="#667887" linethickness="0.7" />
                    <planecontainer origin="1.66,2.12,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="10" textcolor="#29333D"><textvalue>36-in cap depth</textvalue></planecontainer>
                    <planecontainer origin="3.05,1.12,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#C46A23"><textvalue>Bearing CL</textvalue></planecontainer>
                    <planecontainer origin="0.2,1.12,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#29333D"><textvalue>Centered pile CL</textvalue></planecontainer>
