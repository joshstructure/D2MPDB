        <expbody>m_sh_8 = If(s_sh_8 &lt; -0.000000001*(1 in), 1, 0)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strand on the flexural tension half depth (1)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="w_sh_8 = m_sh_8*s_sh_8 to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>w_sh_8 = m_sh_8*s_sh_8 to in</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">its coordinate</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="s_sh_9 = -sn_h*x_st_9 + cs_h*y_st_9 to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>s_sh_9 = -sn_h*x_st_9 + cs_h*y_st_9 to in</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strand coordinate toward the compression face</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="m_sh_9 = If(s_sh_9 &lt; -0.000000001*(1 in), 1, 0)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>m_sh_9 = If(s_sh_9 &lt; -0.000000001*(1 in), 1, 0)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strand on the flexural tension half depth (1)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="w_sh_9 = m_sh_9*s_sh_9 to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>w_sh_9 = m_sh_9*s_sh_9 to in</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">its coordinate</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="s_sh_10 = -sn_h*x_st_10 + cs_h*y_st_10 to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>s_sh_10 = -sn_h*x_st_10 + cs_h*y_st_10 to in</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strand coordinate toward the compression face</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="m_sh_10 = If(s_sh_10 &lt; -0.000000001*(1 in), 1, 0)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>m_sh_10 = If(s_sh_10 &lt; -0.000000001*(1 in), 1, 0)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strand on the flexural tension half depth (1)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="w_sh_10 = m_sh_10*s_sh_10 to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>w_sh_10 = m_sh_10*s_sh_10 to in</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">its coordinate</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="s_sh_11 = -sn_h*x_st_11 + cs_h*y_st_11 to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>s_sh_11 = -sn_h*x_st_11 + cs_h*y_st_11 to in</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strand coordinate toward the compression face</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="m_sh_11 = If(s_sh_11 &lt; -0.000000001*(1 in), 1, 0)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>m_sh_11 = If(s_sh_11 &lt; -0.000000001*(1 in), 1, 0)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strand on the flexural tension half depth (1)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="w_sh_11 = m_sh_11*s_sh_11 to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>w_sh_11 = m_sh_11*s_sh_11 to in</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">its coordinate</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="s_sh_12 = -sn_h*x_st_12 + cs_h*y_st_12 to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>s_sh_12 = -sn_h*x_st_12 + cs_h*y_st_12 to in</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strand coordinate toward the compression face</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="m_sh_12 = If(s_sh_12 &lt; -0.000000001*(1 in), 1, 0)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>m_sh_12 = If(s_sh_12 &lt; -0.000000001*(1 in), 1, 0)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strand on the flexural tension half depth (1)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="w_sh_12 = m_sh_12*s_sh_12 to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>w_sh_12 = m_sh_12*s_sh_12 to in</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">its coordinate</paragraph>
  </section>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="n_t1 = m_sh_1 + m_sh_2 + m_sh_3 + m_sh_4" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>n_t1 = m_sh_1 + m_sh_2 + m_sh_3 + m_sh_4</expbody>
      <expresult> = 4.000</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="n_t2 = n_t1 + m_sh_5 + m_sh_6 + m_sh_7 + m_sh_8" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>n_t2 = n_t1 + m_sh_5 + m_sh_6 + m_sh_7 + m_sh_8</expbody>
      <expresult> = 4.000</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="n_tens = n_t2 + m_sh_9 + m_sh_10 + m_sh_11 + m_sh_12" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>n_tens = n_t2 + m_sh_9 + m_sh_10 + m_sh_11 + m_sh_12</expbody>
      <expresult> = 6.000</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strands on the tension half</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="w_t1 = w_sh_1 + w_sh_2 + w_sh_3 + w_sh_4" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>w_t1 = w_sh_1 + w_sh_2 + w_sh_3 + w_sh_4</expbody>
      <expresult> = -21.990 in</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="w_t2 = w_t1 + w_sh_5 + w_sh_6 + w_sh_7 + w_sh_8" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>w_t2 = w_t1 + w_sh_5 + w_sh_6 + w_sh_7 + w_sh_8</expbody>
      <expresult> = -21.990 in</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="w_tens = w_t2 + w_sh_9 + w_sh_10 + w_sh_11 + w_sh_12 to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>w_tens = w_t2 + w_sh_9 + w_sh_10 + w_sh_11 + w_sh_12 to in</expbody>
      <expresult> = -25.655 in</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">sum of their coordinates</paragraph>
