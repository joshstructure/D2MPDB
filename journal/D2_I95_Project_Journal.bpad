                    <plot formula="PlotLines([1.92,2.89],[3.8,3.8])" linecolor="#1766A0" linethickness="0.8" />
                    <plot formula="PlotLines([1.92,1.92],[3.8-.07,3.8+.07])" linecolor="#1766A0" linethickness="0.8" />
