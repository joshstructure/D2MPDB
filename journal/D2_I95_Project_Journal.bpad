        <paragraph fontfamily="Times New Roman" fontsize="1" spacingbefore="0" spacingafter="0" pagebreakafter="break"> </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="1" spacingbefore="0" spacingafter="0" />
        <paragraph fontfamily="Times New Roman" fontsize="1" spacingbefore="0" spacingafter="0" />
        <section name="CodePage17" capture="True" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="40" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" id="paragraphprojectcoderef17C003" textcolor="#155731" texthighlight="#DDEFE3">
                <link address="#CodeReferencesC003.CodePage17;paragraphprojectcoderef17C003">REFERENCE 17 | FDOT Structures Manual I.6.B.5</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC003.CodePage17;paragraphprojectcoderef17C003">FDOT Structures Manual, January 2026</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" textcolor="#536575">Printed I-4 | Source PDF page 5</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">USED FOR</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Identifies the LRFD edition referenced by the adopted FDOT manual. Used with the RFQ governing-edition record.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Variables: Entire code-based calculation set</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC002.CodePage01;paragraphprojectcoderef01C002">Related: RFQ - Governing Regulations</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">RETURN TO CALCULATIONS</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind.FWCodeBasis;paragraphfwcodec01">C002 | Design basis</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#BridgeMovement;paragraphc003packetnav">C003 | Design basis</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#SuperstructureUplift;paragraphrefreturn0033">C004 | Design basis</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral;paragraphreferenceindex">Reference index</link>
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="1" spacingbefore="0" spacingafter="0" pagebreakafter="break"> </paragraph>
        <section name="CodePage18" capture="True" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="40" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" id="paragraphprojectcoderef18C003" textcolor="#155731" texthighlight="#DDEFE3">
                <link address="#CodeReferencesC003.CodePage18;paragraphprojectcoderef18C003">REFERENCE 18 | FDOT SDG 2.7.1; Table 2.7.1-1</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC003.CodePage18;paragraphprojectcoderef18C003">FDOT Structures Manual, January 2026</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" textcolor="#536575">Printed 2-15 | Source PDF page 83</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">USED FOR</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Supplies concrete-only temperatures, the construction mean, and the temperature-factor provision used by C003. Temperature excursions are derived from the mean.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Variables: T_mean; T_high; T_low; ΔT_rise; ΔT_fall; γ_TU</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">SCOPE / REVIEW NOTE</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                Displacement factors must not be generalized to restraint-force effects. Read with
                <link address="#CodeReferencesC003.CodePage21;paragraphprojectcoderef21C003">LRFD Table 3.4.1-6</link>
                .
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC003.CodePage21;paragraphprojectcoderef21C003">Related: LRFD Table 3.4.1-6</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">RETURN TO CALCULATIONS</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#BridgeMovement;paragraphrefreturn0028">C003 | Design basis</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#BridgeMovement;paragraphrefreturn0029">C003 | 1. DESIGN BASIS AND ASSUMPTIONS</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#BridgeMovement;paragraphrefreturn0030">C003 | 2.2. Temperature Parameters</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral;paragraphreferenceindex">Reference index</link>
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="1" spacingbefore="0" spacingafter="0" pagebreakafter="break"> </paragraph>
        <section name="CodePage19" capture="True" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="40" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" id="paragraphprojectcoderef19C003" textcolor="#155731" texthighlight="#DDEFE3">
                <link address="#CodeReferencesC003.CodePage19;paragraphprojectcoderef19C003">REFERENCE 19 | FDOT SDG 6.3 - Temperature movement</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC003.CodePage19;paragraphprojectcoderef19C003">FDOT Structures Manual, January 2026</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" textcolor="#536575">Printed 6-1 | Source PDF page 286</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">USED FOR</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Supplies the construction mean and temperature-range basis used in C003 movement calculations.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Variables: T_mean; δ_left; δ_right; δ_end_max</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">SCOPE / REVIEW NOTE</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Existing QC qualification: this paragraph does not expressly waive the LRFD displacement factor. C003's unfactored joint/bearing label alone does not establish final design demand.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC003.CodePage21;paragraphprojectcoderef21C003">Related: LRFD Table 3.4.1-6</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC003.CodePage22;paragraphprojectcoderef22C003">Related: LRFD C3.4.1</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">RETURN TO CALCULATIONS</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#BridgeMovement;paragraphrefreturn0029">C003 | 1. DESIGN BASIS AND ASSUMPTIONS</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#BridgeMovement;paragraphrefreturn0030">C003 | 2.2. Temperature Parameters</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#BridgeMovement;paragraphrefreturn0032">C003 | 4.2. Factored TU Movement Envelope</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral;paragraphreferenceindex">Reference index</link>
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="1" spacingbefore="0" spacingafter="0" pagebreakafter="break"> </paragraph>
        <section name="CodePage20" capture="True" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="40" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" id="paragraphprojectcoderef20C003" textcolor="#155731" texthighlight="#DDEFE3">
                <link address="#CodeReferencesC003.CodePage20;paragraphprojectcoderef20C003">REFERENCE 20 | LRFD 5.4.2.2</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC003.CodePage20;paragraphprojectcoderef20C003">LRFD Bridge Design Specifications, 10th Edition (2024)</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" textcolor="#536575">Printed 5-18 | Source PDF page 349</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">USED FOR</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Supplies the normal-weight concrete thermal-expansion default used by C003 when more precise information is absent.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Variables: α_T; δ_left; δ_right</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">SCOPE / REVIEW NOTE</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Testing the specific mix is the stated preference. The default is not a project-specific test result.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC003.CodePage23;paragraphprojectcoderef23C003">Related: LRFD Eq. 3.12.2.3-1</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">RETURN TO CALCULATIONS</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#BridgeMovement;paragraphrefreturn0029">C003 | 1. DESIGN BASIS AND ASSUMPTIONS</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#BridgeMovement;paragraphrefreturn0030">C003 | 2.2. Temperature Parameters</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral;paragraphreferenceindex">Reference index</link>
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="1" spacingbefore="0" spacingafter="0" pagebreakafter="break"> </paragraph>
        <section name="CodePage21" capture="True" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="40" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" id="paragraphprojectcoderef21C003" textcolor="#155731" texthighlight="#DDEFE3">
                <link address="#CodeReferencesC003.CodePage21;paragraphprojectcoderef21C003">REFERENCE 21 | LRFD Table 3.4.1-6</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC003.CodePage21;paragraphprojectcoderef21C003">LRFD Bridge Design Specifications, 10th Edition (2024)</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" textcolor="#536575">Printed 3-18 | Source PDF page 75</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">USED FOR</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Supports the TU displacement factor used in C003's factored movement envelope. The adjacent force-effects row is context.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Variables: γ_TU; δ_left_TU; δ_right_TU; δ_end_max_TU</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">SCOPE / REVIEW NOTE</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                Keep raw thermal movement distinct from final joint/bearing design demand; read with
                <link address="#CodeReferencesC003.CodePage22;paragraphprojectcoderef22C003">LRFD C3.4.1</link>
                .
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC003.CodePage22;paragraphprojectcoderef22C003">Related: LRFD C3.4.1</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">RETURN TO CALCULATIONS</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#BridgeMovement;paragraphrefreturn0029">C003 | 1. DESIGN BASIS AND ASSUMPTIONS</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral;paragraphreferenceindex">Reference index</link>
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="1" spacingbefore="0" spacingafter="0" pagebreakafter="break"> </paragraph>
        <section name="CodePage22" capture="True" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="40" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" id="paragraphprojectcoderef22C003" textcolor="#155731" texthighlight="#DDEFE3">
                <link address="#CodeReferencesC003.CodePage22;paragraphprojectcoderef22C003">REFERENCE 22 | LRFD C3.4.1</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC003.CodePage22;paragraphprojectcoderef22C003">LRFD Bridge Design Specifications, 10th Edition (2024)</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" textcolor="#536575">Printed 3-13 | Source PDF page 70</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">USED FOR</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Explains the displacement factor in relation to joints, expansion devices, and bearings, qualifying the design use of C003 movement results.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Variables: γ_TU; δ_end_max_TU</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">SCOPE / REVIEW NOTE</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">C003 calculates movement; joint and bearing resistance/adequacy remain separate checks.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC003.CodePage21;paragraphprojectcoderef21C003">Related: LRFD Table 3.4.1-6</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">RETURN TO CALCULATIONS</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#BridgeMovement;paragraphrefreturn0029">C003 | 1. DESIGN BASIS AND ASSUMPTIONS</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral;paragraphreferenceindex">Reference index</link>
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="1" spacingbefore="0" spacingafter="0" pagebreakafter="break"> </paragraph>
        <section name="CodePage23" capture="True" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="40" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" id="paragraphprojectcoderef23C003" textcolor="#155731" texthighlight="#DDEFE3">
                <link address="#CodeReferencesC003.CodePage23;paragraphprojectcoderef23C003">REFERENCE 23 | LRFD Eq. 3.12.2.3-1</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC003.CodePage23;paragraphprojectcoderef23C003">LRFD Bridge Design Specifications, 10th Edition (2024)</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" textcolor="#536575">Printed 3-123 | Source PDF page 180</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">USED FOR</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Provides full high-to-low thermal movement context. C003 applies the thermal coefficient and expansion lengths to each excursion from the construction mean.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Variables: L_left; L_right; L_unit; δ_left; δ_right; δ_end_to_end</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">SCOPE / REVIEW NOTE</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">The movement center at the intermediate pier is a project assumption. FDOT substitutes the temperature range. Code Δ_T denotes movement; C003 ΔT_rise denotes temperature change.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC003.CodePage18;paragraphprojectcoderef18C003">Related: FDOT SDG 2.7.1; Table 2.7.1-1</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">RETURN TO CALCULATIONS</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#BridgeMovement;paragraphrefreturn0031">C003 | 4. THERMAL MOVEMENT</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral;paragraphreferenceindex">Reference index</link>
            </paragraph>
        </section>
    </report>
