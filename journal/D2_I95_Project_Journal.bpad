    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">simplified β = 2, θ = 45° eligible (1), 5.7.3.4.1</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_fl_N = 0.5*N_N + V_ef_N - Abs(M_N)/d_v to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_fl_N = 0.5*N_N + V_ef_N - Abs(M_N)/d_v to kip</expbody>
        <expresult> = 206.813 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">compression-half flange force, C5.7.3.4.2</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="f_fl_N = F_fl_N*E_c/(E_c*A_cc_N + Es*A_cs_N) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>f_fl_N = F_fl_N*E_c/(E_c*A_cc_N + Es*A_cs_N) to ksi</expbody>
        <expresult> = 0.231 ksi</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">flange tensile stress</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="crk_N = If(And(N_N &gt; 0.0000000001 kip, f_fl_N &gt;= f_ct), 1, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>crk_N = If(And(N_N &gt; 0.0000000001 kip, f_fl_N &gt;= f_ct), 1, 0)</expbody>
