                    <c capture="False" formula="EB_V_entry to ft"><num>0 ft</num></c>
                </row>
            </table>
        </embed>
        <embed spacingbefore="5" spacingafter="10" leftindent="0">
            <table name="EBWindRegister" capture="False" colwidths="1:105, 2:110, 3:385">
                <stylerule range="A1:C4" fontfamily="Times New Roman" fontsize="9.5" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.7, &quot;#7189A6&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.35, &quot;#CCD6D0&quot;); Border(&quot;BetweenColumns&quot;, &quot;Solid&quot;, 0.35, &quot;#CCD6D0&quot;);" horzalign="Center" vertalign="Center" />
