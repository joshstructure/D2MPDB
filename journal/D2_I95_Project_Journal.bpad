            <c><textvalue>TOTAL AT PIER</textvalue></c>
            <cell />
            <c formula="F63+F64+F65+F66"><num>364.0717175 kip</num></c>
            <c formula="G63+G64+G65+G66"><num>8.0906325 kip</num></c>
            <c formula="H63+H64+H65+H66"><num>372.16235000000006 kip</num></c>
            <c formula="I63+I64+I65+I66"><num>114.615 kip</num></c>
