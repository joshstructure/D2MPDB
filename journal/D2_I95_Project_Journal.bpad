                        <c capture="False" formula="NB_l4 to ft in"><num>52 ft 5.399999999999977 in</num></c>
                    </row>
                </table>
            </embed>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6">The deck tributary width is the actual half-width of the centered two-beam section; the pedestrian width excludes parapets. The two different span tributaries are never averaged for node application.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" fontweight="bold" keepwithnext="True">TRANSVERSE GRAVITY TRIBUTARIES</paragraph>
            <embed spacingbefore="5" spacingafter="12">
                <table name="NBTribWidths" capture="False" colwidths="1:173.33333333333334, 2:173.33333333333334, 3:173.33333333333334">
                    <stylerule range="A1:C3" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.3, &quot;#BCD0C1&quot;); Border(&quot;BetweenColumns&quot;, &quot;Solid&quot;, 0.3, &quot;#BCD0C1&quot;);" />
                    <stylerule range="A1:C1" background="#DCECE0" fontweight="bold" />
                    <stylerule range="A2:C3" background="#EFF7F1" />
                    <row>
                        <c capture="False"><textvalue>Beam line</textvalue></c>
                        <c capture="False"><textvalue>Deck width</textvalue></c>
                        <c capture="False"><textvalue>Pedestrian width</textvalue></c>
                    </row>
                    <row>
                        <c capture="False"><textvalue>B−</textvalue></c>
