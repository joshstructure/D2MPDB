    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">moment for ε: not less than V d_v</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="ε_b_P = (M_e_P/d_v + 0.5*N_P + V_ef_P)/(Es*A_st_P)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>ε_b_P = (M_e_P/d_v + 0.5*N_P + V_ef_P)/(Es*A_st_P)</expbody>
        <expresult> = 0.003</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">longitudinal strain, 5.7.3.4.2-4</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="ok45_P = If(Min(r_adj_P, A_w45_P/L_w45_P) &gt;= A_vmin, 1, 0)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>ok45_P = If(Min(r_adj_P, A_w45_P/L_w45_P) &gt;= A_vmin, 1, 0)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum steel in the 45° window (1)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="okg_P = If(Min(r_adj_P, A_wg_P/L_wg_P) &gt;= A_vmin, 1, 0)" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>okg_P = If(Min(r_adj_P, A_wg_P/L_wg_P) &gt;= A_vmin, 1, 0)</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum steel in the d_v cot θ window (1)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="simp_P = If(And(N_P &lt;= 0.0000000001 kip, Or(ok45_P &gt; 0, h &lt; 16 in)), 1, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>simp_P = If(And(N_P &lt;= 0.0000000001 kip, Or(ok45_P &gt; 0, h &lt; 16 in)), 1, 0)</expbody>
        <expresult> = 1.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">simplified β = 2, θ = 45° eligible (1), 5.7.3.4.1</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="F_fl_P = 0.5*N_P + V_ef_P - Abs(M_P)/d_v to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>F_fl_P = 0.5*N_P + V_ef_P - Abs(M_P)/d_v to kip</expbody>
        <expresult> = 150.794 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">compression-half flange force, C5.7.3.4.2</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="f_fl_P = F_fl_P*E_c/(E_c*A_cc_P + Es*A_cs_P) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>f_fl_P = F_fl_P*E_c/(E_c*A_cc_P + Es*A_cs_P) to ksi</expbody>
        <expresult> = 0.170 ksi</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">flange tensile stress</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="crk_P = If(And(N_P &gt; 0.0000000001 kip, f_fl_P &gt;= f_ct), 1, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>crk_P = If(And(N_P &gt; 0.0000000001 kip, f_fl_P &gt;= f_ct), 1, 0)</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">flange cracked: ε doubles (1)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="ε_s_P = Max(0, ε_b_P)*If(crk_P &gt; 0, 2, 1)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>ε_s_P = Max(0, ε_b_P)*If(crk_P &gt; 0, 2, 1)</expbody>
        <expresult> = 0.003</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strain ε_s</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="T_th_B = 0.25*φ_v*0.126*λ*Sqrt(fc/(1 ksi))*(1 ksi)*(b*h)^2/(2*(b + h))*Sqrt(Max(0, 1 - N_B/(b*h)/(0.126*λ*Sqrt(fc/(1 ksi))*(1 ksi)))) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>T_th_B = 0.25*φ_v*0.126*λ*Sqrt(fc/(1 ksi))*(1 ksi)*(b*h)^2/(2*(b + h))*Sqrt(Max(0, 1 - N_B/(b*h)/(0.126*λ*Sqrt(fc/(1 ksi))*(1 ksi)))) to kip*ft</expbody>
        <expresult> = 99.441 kip*ft</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">torsion threshold, 5.7.2.1</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="tor_B = If(T_B &gt; T_th_B, 1, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>tor_B = If(T_B &gt; T_th_B, 1, 0)</expbody>
        <expresult> = 0.000</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">torsion investigated (1)</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="V_ef_B = If(tor_B &gt; 0, Sqrt(V_B^2 + (0.9*p_h_B*T_B/(2*A_o_B))^2), V_B) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_ef_B = If(tor_B &gt; 0, Sqrt(V_B^2 + (0.9*p_h_B*T_B/(2*A_o_B))^2), V_B) to kip</expbody>
        <expresult> = 215.864 kip</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">effective shear, 5.7.3.4.2-5</paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="M_e_B = Max(Abs(M_B), V_B*d_v) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>M_e_B = Max(Abs(M_B), V_B*d_v) to kip*ft</expbody>
