                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" leftindent="0" spacingafter="7">Area of one top bar from the shared bar table.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" leftindent="0" spacingafter="2" spacingbefore="4" keepwithnext="True">
                <dynexp formula="EBSteel_bottomCount = CapDesignEndBentOne.n_P1" mathlayout="on" showsteps="False" seplines="False">
