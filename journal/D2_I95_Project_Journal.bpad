    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shared journal value — Materials.Rebar_fy</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="Es = Materials.Rebar_Es to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>Es = Materials.Rebar_Es to ksi</expbody>
      <expresult> = 29000.000 ksi</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shared journal value — Materials.Rebar_Es</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="φ_f = CapDesignBasis.φ_f" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>φ_f = CapDesignBasis.φ_f</expbody>
      <expresult> = 0.900</expresult>
