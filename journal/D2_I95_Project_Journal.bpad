            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" leftindent="0">
                <dynexp formula="AX_Base_EB_CheckM_W2 = If(And(Abs(AX_Base_EB_SumMT_W2-EB_RefMT_W2)&lt;0.000001 kip*ft,Abs(AX_Base_EB_SumML_W2-EB_RefML_W2)&lt;0.000001 kip*ft,Abs(AX_Base_EB_SumMV_W2-EB_RefMV_W2)&lt;0.000001 kip*ft),&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>AX_Base_EB_CheckM_W2 = If(And(Abs(AX_Base_EB_SumMT_W2-EB_RefMT_W2)&lt;0.000001 kip*ft,Abs(AX_Base_EB_SumML_W2-EB_RefML_W2)&lt;0.000001 kip*ft,Abs(AX_Base_EB_SumMV_W2-EB_RefMV_W2)&lt;0.000001 kip*ft),"PASS","FAIL")</expbody>
                    <expresult> = PASS</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" leftindent="0">
                <dynexp formula="AX_Base_EB_CheckF_W3 = If(And(Abs(AX_Base_EB_SumFT_W3-EB_signT*(EB_wc_W3+EB_wf_W3)*EB_Trib)&lt;0.000001 kip,Abs(AX_Base_EB_SumFL_W3-EB_signL*EB_lambda_W3*(EB_wc_W3+EB_wf_W3)*EB_Trib)&lt;0.000001 kip,Abs(AX_Base_EB_SumFV_W3+EB_wu_W3*EB_Trib)&lt;0.000001 kip),&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>AX_Base_EB_CheckF_W3 = If(And(Abs(AX_Base_EB_SumFT_W3-EB_signT*(EB_wc_W3+EB_wf_W3)*EB_Trib)&lt;0.000001 kip,Abs(AX_Base_EB_SumFL_W3-EB_signL*EB_lambda_W3*(EB_wc_W3+EB_wf_W3)*EB_Trib)&lt;0.000001 kip,Abs(AX_Base_EB_SumFV_W3+EB_wu_W3*EB_Trib)&lt;0.000001 kip),"PASS","FAIL")</expbody>
                    <expresult> = PASS</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" leftindent="0">
                <dynexp formula="AX_Base_EB_CheckM_W3 = If(And(Abs(AX_Base_EB_SumMT_W3-EB_RefMT_W3)&lt;0.000001 kip*ft,Abs(AX_Base_EB_SumML_W3-EB_RefML_W3)&lt;0.000001 kip*ft,Abs(AX_Base_EB_SumMV_W3-EB_RefMV_W3)&lt;0.000001 kip*ft),&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>AX_Base_EB_CheckM_W3 = If(And(Abs(AX_Base_EB_SumMT_W3-EB_RefMT_W3)&lt;0.000001 kip*ft,Abs(AX_Base_EB_SumML_W3-EB_RefML_W3)&lt;0.000001 kip*ft,Abs(AX_Base_EB_SumMV_W3-EB_RefMV_W3)&lt;0.000001 kip*ft),"PASS","FAIL")</expbody>
                    <expresult> = PASS</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="2">
                <dynexp formula="EB_DeltaL = EB_RowL-EB_NodeL to ft" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_DeltaL = EB_RowL-EB_NodeL to ft</expbody>
                    <expresult> = 0.25 ft</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="2">
                <dynexp formula="EB_MT_DC_near = EB_axisT*EB_DeltaL*EB_DC_near to kip*ft" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_MT_DC_near = EB_axisT*EB_DeltaL*EB_DC_near to kip*ft</expbody>
                    <expresult> = 23.017 kip*ft</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="2">
                <dynexp formula="EB_MT_DC_far = EB_axisT*EB_DeltaL*EB_DC_far to kip*ft" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_MT_DC_far = EB_axisT*EB_DeltaL*EB_DC_far to kip*ft</expbody>
                    <expresult> = 23.017 kip*ft</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="2">
                <dynexp formula="EB_SumMT_DC = EB_L_entry*EB_axisV*EB_TotalDC+EB_MT_DC_near+EB_MT_DC_far to kip*ft" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_SumMT_DC = EB_L_entry*EB_axisV*EB_TotalDC+EB_MT_DC_near+EB_MT_DC_far to kip*ft</expbody>
                    <expresult> = 46.034 kip*ft</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="2">
                <dynexp formula="EB_CheckOffset_DC = If(Abs(EB_SumMT_DC-EB_axisT*EB_RowL*EB_TotalDC) &lt; 0.000001 kip*ft,&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_CheckOffset_DC = If(Abs(EB_SumMT_DC-EB_axisT*EB_RowL*EB_TotalDC) &lt; 0.000001 kip*ft,"PASS","FAIL")</expbody>
                    <expresult> = PASS</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="2">
                <dynexp formula="EB_MT_PL_near = EB_axisT*EB_DeltaL*EB_PL_near to kip*ft" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_MT_PL_near = EB_axisT*EB_DeltaL*EB_PL_near to kip*ft</expbody>
                    <expresult> = 7.246 kip*ft</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="2">
                <dynexp formula="EB_MT_PL_far = EB_axisT*EB_DeltaL*EB_PL_far to kip*ft" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_MT_PL_far = EB_axisT*EB_DeltaL*EB_PL_far to kip*ft</expbody>
                    <expresult> = 7.246 kip*ft</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="2">
                <dynexp formula="EB_SumMT_PL = EB_L_entry*EB_axisV*EB_TotalPL+EB_MT_PL_near+EB_MT_PL_far to kip*ft" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_SumMT_PL = EB_L_entry*EB_axisV*EB_TotalPL+EB_MT_PL_near+EB_MT_PL_far to kip*ft</expbody>
                    <expresult> = 14.492 kip*ft</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="2">
                <dynexp formula="EB_CheckOffset_PL = If(Abs(EB_SumMT_PL-EB_axisT*EB_RowL*EB_TotalPL) &lt; 0.000001 kip*ft,&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_CheckOffset_PL = If(Abs(EB_SumMT_PL-EB_axisT*EB_RowL*EB_TotalPL) &lt; 0.000001 kip*ft,"PASS","FAIL")</expbody>
                    <expresult> = PASS</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="2">
                <dynexp formula="EB_MT_DW_near = EB_axisT*EB_DeltaL*EB_DW_near to kip*ft" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_MT_DW_near = EB_axisT*EB_DeltaL*EB_DW_near to kip*ft</expbody>
                    <expresult> = 0 kip*ft</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="2">
                <dynexp formula="EB_MT_DW_far = EB_axisT*EB_DeltaL*EB_DW_far to kip*ft" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_MT_DW_far = EB_axisT*EB_DeltaL*EB_DW_far to kip*ft</expbody>
                    <expresult> = 0 kip*ft</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="2">
                <dynexp formula="EB_SumMT_DW = EB_L_entry*EB_axisV*EB_TotalDW+EB_MT_DW_near+EB_MT_DW_far to kip*ft" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_SumMT_DW = EB_L_entry*EB_axisV*EB_TotalDW+EB_MT_DW_near+EB_MT_DW_far to kip*ft</expbody>
                    <expresult> = 0 kip*ft</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="2">
                <dynexp formula="EB_CheckOffset_DW = If(Abs(EB_SumMT_DW-EB_axisT*EB_RowL*EB_TotalDW) &lt; 0.000001 kip*ft,&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_CheckOffset_DW = If(Abs(EB_SumMT_DW-EB_axisT*EB_RowL*EB_TotalDW) &lt; 0.000001 kip*ft,"PASS","FAIL")</expbody>
                    <expresult> = PASS</expresult>
                </dynexp>
            </paragraph>
        </section>
        <embed spacingbefore="5" spacingafter="10" leftindent="0">
            <table name="EBGeometrySummary" capture="False" colwidths="1:170, 2:190, 3:280">
                <stylerule range="A1:C14" fontfamily="Times New Roman" fontsize="9.5" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.7, &quot;#7189A6&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.35, &quot;#CCD6D0&quot;); Border(&quot;BetweenColumns&quot;, &quot;Solid&quot;, 0.35, &quot;#CCD6D0&quot;);" horzalign="Center" vertalign="Center" />
                <stylerule range="A1:C1" background="#DCE7F3" fontweight="bold" />
                <stylerule range="A2:C10" background="#F1F5FA" />
                <row>
                    <c capture="False"><textvalue>Item</textvalue></c>
                    <c capture="False"><textvalue>Live value</textvalue></c>
                    <c capture="False"><textvalue>Basis</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Selected end bent</textvalue></c>
                    <c capture="False" formula="EB_SelectedEnd"><textvalue>End Bent 1 - Begin Bridge</textvalue></c>
                    <c capture="False"><textvalue>Longest adjacent model span</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Span 1 / span 2</textvalue></c>
                    <c capture="False" formula="BridgeGeometry_2Beam.Span_1 to ft"><num>107.34999999999991 ft</num></c>
                    <c capture="False"><textvalue>Span 1; span 2 shown next</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Span 2</textvalue></c>
                    <c capture="False" formula="BridgeGeometry_2Beam.Span_2 to ft"><num>104.90000000000009 ft</num></c>
                    <c capture="False"><textvalue>Comparison span</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Loaded tributary</textvalue></c>
                    <c capture="False" formula="EB_Trib to ft"><num>53.674999999999955 ft</num></c>
                    <c capture="False"><textvalue>Half of selected span, once</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Bearing spacing</textvalue></c>
                    <c capture="False" formula="EB_s to ft in"><num>8 ft 7 in</num></c>
                    <c capture="False"><textvalue>Unchanged two-beam spacing</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Cap width</textvalue></c>
                    <c capture="False" formula="BridgeGeometry_2Beam.EndBentCap_width to in"><num>42 in</num></c>
                    <c capture="False"><textvalue>Current shared geometry</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Cap depth</textvalue></c>
                    <c capture="False" formula="BridgeGeometry_2Beam.EndBentCap_depth to in"><num>36 in</num></c>
                    <c capture="False"><textvalue>Current shared geometry</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Bearing plane above cap CG</textvalue></c>
                    <c capture="False" formula="EB_zb to ft in"><num>2 ft 2.562000000000001 in</num></c>
                    <c capture="False"><textvalue>18 in + 6 in + 2.5625 in</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Node assignment</textvalue></c>
                    <c capture="False" formula="EB_CheckSpan"><textvalue>END BENT 1 - NODES 15 / 34</textvalue></c>
                    <c capture="False"><textvalue>Remap if the governing span changes</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Bearing offset toward span</textvalue></c>
                    <c capture="False" formula="BridgeGeometry_2Beam.EndBent_bearingOffset to in"><num>3 in</num></c>
                    <c capture="False"><textvalue>Live rear-face chain minus half the current cap width</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Physical bearing-row L</textvalue></c>
                    <c capture="False" formula="EB_RowL to ft"><num>0.25 ft</num></c>
                    <c capture="False"><textvalue>Relative to centered pile/cap line</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>FBMP node-line selection</textvalue></c>
                    <c capture="False" formula="EB_NodeLine"><textvalue>At centered pile/cap line</textvalue></c>
                    <c capture="False"><textvalue>Select to match actual node locations</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Node-to-bearing offset</textvalue></c>
                    <c capture="False" formula="EB_DeltaL to in"><num>3 in</num></c>
                    <c capture="False"><textvalue>Residual moment uses this distance</textvalue></c>
                </row>
            </table>
        </embed>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0">Gravity uses the matching selected-span pier-side reactions because the source model assumes simple spans, symmetric loading and equal end reactions. It does not take half of the total pier reaction, and it does not import pier-only wall, cap, cheek-wall or pedestal weights. Confirm support restraint and longitudinal wind sharing in the actual model; the source half-span distribution is retained.</paragraph>
        <section name="EBBearingElevation" capture="False" hide="false">
            <embed spacingafter="8">
                <canvas name="EBBearingOffsetElevation" title="Upright end-bent bearing and centered pile" unit="in" size="6.5 in; 5.65 in; scaletofit">
                    <include target="Library.Geometry" />
