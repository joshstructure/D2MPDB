      <dynexp formula="V_ef_P = If(tor_P &gt; 0, Sqrt(V_P^2 + (0.9*p_h_P*T_P/(2*A_o_P))^2), V_P) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>V_ef_P = If(tor_P &gt; 0, Sqrt(V_P^2 + (0.9*p_h_P*T_P/(2*A_o_P))^2), V_P) to kip</expbody>
        <expresult> = 217.090 kip</expresult>
