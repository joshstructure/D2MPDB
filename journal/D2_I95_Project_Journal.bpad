        <paragraph fontfamily="Times New Roman" fontsize="16" spacingafter="6" fontweight="bold">D2 I-95 PEDESTRIAN BRIDGE</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="16" spacingafter="6" fontweight="bold">MSE WALL CLEARANCE — FRONT AND SIDES</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6">Both end bents | 13 October 2026 | Front strap check; specified side offsets</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" background="#F1F5FA">Evaluate a straight strap from the FRONT wall on the normal through a nominal pile center. Use the selected alpha in either skew direction. The SIDE walls use a separate specified 24-inch minimum; their strap routing is not evaluated.</paragraph>
        <embed spacingbefore="5" spacingafter="8">
            <table name="ResultSummary" capture="False" colwidths="1:370, 2:160">
                <stylerule range="A1:B7" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#A7B9C6&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#CBD5DD&quot;);" />
                <row>
                    <c capture="False" background="#DCE7F3" fontweight="bold"><textvalue>Geometry output</textvalue></c>
                    <c capture="False" background="#DCE7F3" fontweight="bold"><textvalue>Live value</textvalue></c>
                </row>
                <row>
                    <c capture="False" background="#EFF7F1"><textvalue>Front wall: calculated minimum pile-face clear</textvalue></c>
                    <c capture="False" background="#EFF7F1" formula="MinClear to in"><num>37.452160573276174 in</num></c>
                </row>
                <row>
                    <c capture="False" background="#EFF7F1"><textvalue>Front wall: adopted clear, rounded UP</textvalue></c>
                    <c capture="False" background="#EFF7F1" formula="LayoutClear to in"><num>37.5 in</num></c>
                </row>
                <row>
                    <c capture="False" background="#EFF7F1"><textvalue>Side walls: specified minimum pile-face clear</textvalue></c>
                    <c capture="False" background="#EFF7F1" formula="SideClear to in"><num>24 in</num></c>
                </row>
                <row>
                    <c capture="False" background="#EFF7F1"><textvalue>Selected front strap skew</textvalue></c>
                    <c capture="False" background="#EFF7F1" formula="α to deg"><num>15 deg</num></c>
                </row>
                <row>
                    <c capture="False" background="#EFF7F1"><textvalue>Trial strap width</textvalue></c>
                    <c capture="False" background="#EFF7F1" formula="Width to in"><num>2 in</num></c>
                </row>
                <row>
                    <c capture="False" background="#EFF7F1"><textvalue>Geometry input validity</textvalue></c>
                    <c capture="False" formula="InputStatus"><textvalue>VALID</textvalue></c>
                </row>
            </table>
        </embed>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6">Measure to the BACK OF FACING. Pile placement tolerance is excluded by the selected nominal-geometry basis. Reversing skew is permitted for this screen; actual pile locations and the complete strap route require separate coordination.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">1. TYPICAL PILE — FRONT AND SIDE LIMITS</paragraph>
        <embed spacingbefore="4" spacingafter="5">
            <canvas name="TypicalBox" unit="in" size="6.5 in; 3.3 in; scaletofit">
                <include target="Library.Geometry" />
                <plot formula="PlotLines([3.1+(-MSEWallExclusion.SideExtent)/(1 ft)*(MSEWallExclusion.TypicalScale),3.1+(-MSEWallExclusion.SideExtent)/(1 ft)*(MSEWallExclusion.TypicalScale),3.1+(MSEWallExclusion.SideExtent)/(1 ft)*(MSEWallExclusion.TypicalScale),3.1+(MSEWallExclusion.SideExtent)/(1 ft)*(MSEWallExclusion.TypicalScale)],[2.1+(MSEWallExclusion.DrawTop)/(1 ft)*(MSEWallExclusion.TypicalScale),2.1+(-MSEWallExclusion.FrontExtent)/(1 ft)*(MSEWallExclusion.TypicalScale),2.1+(-MSEWallExclusion.FrontExtent)/(1 ft)*(MSEWallExclusion.TypicalScale),2.1+(MSEWallExclusion.DrawTop)/(1 ft)*(MSEWallExclusion.TypicalScale)])" linecolor="#B44840" linethickness="2" />
                <plot formula="PlotLines([3.1+(-MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale),3.1+(MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale),3.1+(MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale),3.1+(-MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale),3.1+(-MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale)],[2.1+(-MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale),2.1+(-MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale),2.1+(MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale),2.1+(MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale),2.1+(-MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale)])" linecolor="#246B7B" linethickness="2" />
                <plot formula="PlotLines([3.1+(-1*MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale),3.1+(-1*MSEWallExclusion.SideExtent)/(1 ft)*(MSEWallExclusion.TypicalScale)],[2.1+(0 ft)/(1 ft)*(MSEWallExclusion.TypicalScale),2.1+(0 ft)/(1 ft)*(MSEWallExclusion.TypicalScale)])" linecolor="#1766A0" linethickness="1" />
                <plot formula="PlotLines([3.1+(-1*MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale),3.1+(-1*MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale)],[2.1+(-0.15 ft)/(1 ft)*(MSEWallExclusion.TypicalScale),2.1+(0.15 ft)/(1 ft)*(MSEWallExclusion.TypicalScale)])" linecolor="#1766A0" linethickness="1" />
                <plot formula="PlotLines([3.1+(-1*MSEWallExclusion.SideExtent)/(1 ft)*(MSEWallExclusion.TypicalScale),3.1+(-1*MSEWallExclusion.SideExtent)/(1 ft)*(MSEWallExclusion.TypicalScale)],[2.1+(-0.15 ft)/(1 ft)*(MSEWallExclusion.TypicalScale),2.1+(0.15 ft)/(1 ft)*(MSEWallExclusion.TypicalScale)])" linecolor="#1766A0" linethickness="1" />
                <plot formula="PlotLines([3.1+(1*MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale),3.1+(1*MSEWallExclusion.SideExtent)/(1 ft)*(MSEWallExclusion.TypicalScale)],[2.1+(0 ft)/(1 ft)*(MSEWallExclusion.TypicalScale),2.1+(0 ft)/(1 ft)*(MSEWallExclusion.TypicalScale)])" linecolor="#1766A0" linethickness="1" />
                <plot formula="PlotLines([3.1+(1*MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale),3.1+(1*MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale)],[2.1+(-0.15 ft)/(1 ft)*(MSEWallExclusion.TypicalScale),2.1+(0.15 ft)/(1 ft)*(MSEWallExclusion.TypicalScale)])" linecolor="#1766A0" linethickness="1" />
                <plot formula="PlotLines([3.1+(1*MSEWallExclusion.SideExtent)/(1 ft)*(MSEWallExclusion.TypicalScale),3.1+(1*MSEWallExclusion.SideExtent)/(1 ft)*(MSEWallExclusion.TypicalScale)],[2.1+(-0.15 ft)/(1 ft)*(MSEWallExclusion.TypicalScale),2.1+(0.15 ft)/(1 ft)*(MSEWallExclusion.TypicalScale)])" linecolor="#1766A0" linethickness="1" />
                <plot formula="PlotLines([3.1+(0 ft)/(1 ft)*(MSEWallExclusion.TypicalScale),3.1+(0 ft)/(1 ft)*(MSEWallExclusion.TypicalScale)],[2.1+(-MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale),2.1+(-MSEWallExclusion.FrontExtent)/(1 ft)*(MSEWallExclusion.TypicalScale)])" linecolor="#1766A0" linethickness="1" />
                <plot formula="PlotLines([3.1+(-0.15 ft)/(1 ft)*(MSEWallExclusion.TypicalScale),3.1+(0.15 ft)/(1 ft)*(MSEWallExclusion.TypicalScale)],[2.1+(-MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale),2.1+(-MSEWallExclusion.Half)/(1 ft)*(MSEWallExclusion.TypicalScale)])" linecolor="#1766A0" linethickness="1" />
                <plot formula="PlotLines([3.1+(-0.15 ft)/(1 ft)*(MSEWallExclusion.TypicalScale),3.1+(0.15 ft)/(1 ft)*(MSEWallExclusion.TypicalScale)],[2.1+(-MSEWallExclusion.FrontExtent)/(1 ft)*(MSEWallExclusion.TypicalScale),2.1+(-MSEWallExclusion.FrontExtent)/(1 ft)*(MSEWallExclusion.TypicalScale)])" linecolor="#1766A0" linethickness="1" />
                <planecontainer origin="0.15,3.06,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="10" textcolor="#9F332B"><textvalue>RED: MINIMUM BACK-OF-FACING LIMITS</textvalue></planecontainer>
                <planecontainer origin="1.86,2.19,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#1766A0" formula="MSEWallExclusion.SideClear to in"><num>24 in</num></planecontainer>
                <planecontainer origin="3.63,2.19,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#1766A0" formula="MSEWallExclusion.SideClear to in"><num>24 in</num></planecontainer>
                <planecontainer origin="3.23,1.02,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#1766A0" formula="MSEWallExclusion.LayoutClear to in"><num>37.5 in</num></planecontainer>
                <planecontainer origin="2.87,2.06,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#246B7B"><textvalue>PILE</textvalue></planecontainer>
                <planecontainer origin="1.92,2.79,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#263F49"><textvalue>OPEN — no rear-wall criterion</textvalue></planecontainer>
                <planecontainer origin="0.15,0.16,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#263F49"><textvalue>FRONT: calculated | SIDES: specified | pile tolerance excluded</textvalue></planecontainer>
            </canvas>
        </embed>
        <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" pagebreakbefore="break">2. INPUTS AND FRONT-WALL MINIMUM</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" background="#FFF8E9">Shared pile size and spacing are live journal references. Use nominal pile width only, without a placement envelope. Wall positions remain the saved CAD snapshot.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="PileSize = BridgeGeometry_2Beam.EndBent_pileWidth" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                <expbody>PileSize = BridgeGeometry_2Beam.EndBent_pileWidth</expbody>
                <expresult> = 18 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Nominal square pile width.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="PileSpacing = BridgeGeometry_2Beam.EndBent_pileSpacing" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                <expbody>PileSpacing = BridgeGeometry_2Beam.EndBent_pileSpacing</expbody>
                <expresult> = 54 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Pile spacing along the row.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="Width = 2 in" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input">
                <expbody>Width = 2 in</expbody>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Trial front-wall strap width; use vendor dimension.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="Clear = 0 in" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input">
                <expbody>Clear = 0 in</expbody>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Additional strap-edge gap; zero is tangency.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="α = 15 deg" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input">
                <expbody>α = 15 deg</expbody>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Selected front-wall plan skew, to either side of the wall normal.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="SideClear = 24 in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                <expbody>SideClear = 24 in</expbody>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Specified side pile-face to back-of-facing minimum; no side strap check.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="RoundStep = 0.25 in" mathlayout="on" showformula="True" showresult="True" showsteps="False" style="Required Input">
                <expbody>RoundStep = 0.25 in</expbody>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Round the computed front setback upward by this increment.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="Half = PileSize/2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                <expbody>Half = PileSize/2</expbody>
                <expresult> = 9 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Nominal pile half-width; no placement allowance.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="MinClear = (Half*Cos(α)+Width/2+Clear)/Sin(α) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                <expbody>MinClear = (Half*Cos(α)+Width/2+Clear)/Sin(α) to in</expbody>
                <expresult> = 37.452 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Front wall: minimum clear from nominal pile face to back of facing.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="LayoutClear = -Floor(-MinClear/Max(RoundStep,0.001 in),1)*Max(RoundStep,0.001 in) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                <expbody>LayoutClear = -Floor(-MinClear/Max(RoundStep,0.001 in),1)*Max(RoundStep,0.001 in) to in</expbody>
                <expresult> = 37.5 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Front wall: adopted clear rounded UP.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="FrontExtent = Half+LayoutClear" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                <expbody>FrontExtent = Half+LayoutClear</expbody>
                <expresult> = 46.5 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Pile center to front-wall limit.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="SideExtent = Half+SideClear" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                <expbody>SideExtent = Half+SideClear</expbody>
                <expresult> = 33 in</expresult>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5">Pile center to either side-wall limit.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" background="#F1F5FA">DERIVATION: S sin alpha - h cos alpha = w/2 + c. Solve for S using h = nominal pile width / 2. The centered nominal geometry is symmetric for positive or negative skew. No pile placement term enters this expression.</paragraph>
        <section name="GeometryAndChecks" capture="False" hide="true">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="FrameAngle = -89.9988175443184 deg" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>FrameAngle = -89.9988175443184 deg</expbody>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="PileCount = BridgeGeometry_2Beam.EndBent_pileCount" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>PileCount = BridgeGeometry_2Beam.EndBent_pileCount</expbody>
                    <expresult> = 4</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="CapLength = BridgeGeometry_2Beam.EndBentCap_length" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>CapLength = BridgeGeometry_2Beam.EndBentCap_length</expbody>
                    <expresult> = 17 ft 8 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="CapWidth = BridgeGeometry_2Beam.EndBentCap_width" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>CapWidth = BridgeGeometry_2Beam.EndBentCap_width</expbody>
                    <expresult> = 42 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="CapX = (CapLength*Abs(Sin(FrameAngle))+CapWidth*Abs(Cos(FrameAngle)))/2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>CapX = (CapLength*Abs(Sin(FrameAngle))+CapWidth*Abs(Cos(FrameAngle)))/2</expbody>
                    <expresult> = 8 ft 10 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="CapY = (CapWidth*Abs(Sin(FrameAngle))+CapLength*Abs(Cos(FrameAngle)))/2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>CapY = (CapWidth*Abs(Sin(FrameAngle))+CapLength*Abs(Cos(FrameAngle)))/2</expbody>
                    <expresult> = 1 ft 9.002 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="InputsValid = And(PileSize &gt; 0 in,PileSpacing &gt; PileSize,PileCount == 4,Width &gt;= 0 in,Clear &gt;= 0 in,α &gt; 0 deg,α &lt; 90 deg,SideClear &gt;= 24 in,RoundStep &gt; 0 in)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>InputsValid = And(PileSize &gt; 0 in,PileSpacing &gt; PileSize,PileCount == 4,Width &gt;= 0 in,Clear &gt;= 0 in,α &gt; 0 deg,α &lt; 90 deg,SideClear &gt;= 24 in,RoundStep &gt; 0 in)</expbody>
                    <expresult> = True</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="InputStatus = If(InputsValid,&quot;VALID&quot;,&quot;INVALID - DO NOT USE&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>InputStatus = If(InputsValid,"VALID","INVALID - DO NOT USE")</expbody>
                    <expresult> = VALID</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="SkewStatus = If(And(α &gt; 0 deg,α &lt;= 15 deg),&quot;Within ordinary 15 deg limit&quot;,&quot;Above ordinary 15 deg limit&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>SkewStatus = If(And(α &gt; 0 deg,α &lt;= 15 deg),"Within ordinary 15 deg limit","Above ordinary 15 deg limit")</expbody>
                    <expresult> = Within ordinary 15 deg limit</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="DrawTop = Half+1 ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>DrawTop = Half+1 ft</expbody>
                    <expresult> = 1 ft 9 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="TypicalScale = 2.25/((DrawTop+FrontExtent)/(1 ft))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>TypicalScale = 2.25/((DrawTop+FrontExtent)/(1 ft))</expbody>
                    <expresult> = 0.4</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="PlotScale = Min(6/((3*PileSpacing+2*SideExtent)/(1 ft)),2.5/((FrontExtent+DrawTop+2 ft)/(1 ft)))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>PlotScale = Min(6/((3*PileSpacing+2*SideExtent)/(1 ft)),2.5/((FrontExtent+DrawTop+2 ft)/(1 ft)))</expbody>
                    <expresult> = 0.316</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="PanelThickness = 0.458333333333333 ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>PanelThickness = 0.458333333333333 ft</expbody>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1P1x = -1.5*PileSpacing*Abs(Sin(FrameAngle))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1P1x = -1.5*PileSpacing*Abs(Sin(FrameAngle))</expbody>
                    <expresult> = -81.000 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1P1y = -1.5*PileSpacing*Cos(FrameAngle)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1P1y = -1.5*PileSpacing*Cos(FrameAngle)</expbody>
                    <expresult> = -0.00167 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1P2x = -0.5*PileSpacing*Abs(Sin(FrameAngle))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1P2x = -0.5*PileSpacing*Abs(Sin(FrameAngle))</expbody>
                    <expresult> = -27.000 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1P2y = -0.5*PileSpacing*Cos(FrameAngle)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1P2y = -0.5*PileSpacing*Cos(FrameAngle)</expbody>
                    <expresult> = -0.000557 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1P3x = 0.5*PileSpacing*Abs(Sin(FrameAngle))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1P3x = 0.5*PileSpacing*Abs(Sin(FrameAngle))</expbody>
                    <expresult> = 27.000 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1P3y = 0.5*PileSpacing*Cos(FrameAngle)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1P3y = 0.5*PileSpacing*Cos(FrameAngle)</expbody>
                    <expresult> = 0.000557 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1P4x = 1.5*PileSpacing*Abs(Sin(FrameAngle))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1P4x = 1.5*PileSpacing*Abs(Sin(FrameAngle))</expbody>
                    <expresult> = 81.000 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1P4y = 1.5*PileSpacing*Cos(FrameAngle)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1P4y = 1.5*PileSpacing*Cos(FrameAngle)</expbody>
                    <expresult> = 0.00167 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1Left = Bent1P1x-SideExtent" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1Left = Bent1P1x-SideExtent</expbody>
                    <expresult> = -114.000 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1Right = Bent1P4x+SideExtent" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1Right = Bent1P4x+SideExtent</expbody>
                    <expresult> = 114.000 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1Bottom = Min(Bent1P1y,Bent1P4y)-FrontExtent" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1Bottom = Min(Bent1P1y,Bent1P4y)-FrontExtent</expbody>
                    <expresult> = -46.502 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1Top = Max(Bent1P1y,Bent1P4y)+DrawTop" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1Top = Max(Bent1P1y,Bent1P4y)+DrawTop</expbody>
                    <expresult> = 1 ft 9.002 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1TotalX = Bent1Right-Bent1Left" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1TotalX = Bent1Right-Bent1Left</expbody>
                    <expresult> = 228.000 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1W1x = -8.66449266016689 ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1W1x = -8.66449266016689 ft</expbody>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1W1y = -3.84865400014849 ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1W1y = -3.84865400014849 ft</expbody>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1W1len = 17.333335694482 ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1W1len = 17.333335694482 ft</expbody>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1W1tx = 1.0" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1W1tx = 1.0</expbody>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1W1ty = 0.0" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1W1ty = 0.0</expbody>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1W1nx = -0.0" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1W1nx = -0.0</expbody>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1W1ny = 1.0" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1W1ny = 1.0</expbody>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1W1xend = Bent1W1x+Bent1W1tx*Bent1W1len" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1W1xend = Bent1W1x+Bent1W1tx*Bent1W1len</expbody>
                    <expresult> = 8.669 ft</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1W1yend = Bent1W1y+Bent1W1ty*Bent1W1len" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1W1yend = Bent1W1y+Bent1W1ty*Bent1W1len</expbody>
                    <expresult> = -3.849 ft</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1Wall1Pile1Face = (Bent1P1x-Bent1W1x)*Bent1W1nx+(Bent1P1y-Bent1W1y)*Bent1W1ny-Half" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1Wall1Pile1Face = (Bent1P1x-Bent1W1x)*Bent1W1nx+(Bent1P1y-Bent1W1y)*Bent1W1ny-Half</expbody>
                    <expresult> = 3 ft 1.182 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1Wall1Pile1Extra = Max(0 in,LayoutClear-Bent1Wall1Pile1Face)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1Wall1Pile1Extra = Max(0 in,LayoutClear-Bent1Wall1Pile1Face)</expbody>
                    <expresult> = 0 ft 0.318 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1Wall1Pile2Face = (Bent1P2x-Bent1W1x)*Bent1W1nx+(Bent1P2y-Bent1W1y)*Bent1W1ny-Half" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1Wall1Pile2Face = (Bent1P2x-Bent1W1x)*Bent1W1nx+(Bent1P2y-Bent1W1y)*Bent1W1ny-Half</expbody>
                    <expresult> = 3 ft 1.183 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1Wall1Pile2Extra = Max(0 in,LayoutClear-Bent1Wall1Pile2Face)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1Wall1Pile2Extra = Max(0 in,LayoutClear-Bent1Wall1Pile2Face)</expbody>
                    <expresult> = 0 ft 0.317 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1Wall1Pile3Face = (Bent1P3x-Bent1W1x)*Bent1W1nx+(Bent1P3y-Bent1W1y)*Bent1W1ny-Half" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1Wall1Pile3Face = (Bent1P3x-Bent1W1x)*Bent1W1nx+(Bent1P3y-Bent1W1y)*Bent1W1ny-Half</expbody>
                    <expresult> = 3 ft 1.184 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1Wall1Pile3Extra = Max(0 in,LayoutClear-Bent1Wall1Pile3Face)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1Wall1Pile3Extra = Max(0 in,LayoutClear-Bent1Wall1Pile3Face)</expbody>
                    <expresult> = 0 ft 0.316 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1Wall1Pile4Face = (Bent1P4x-Bent1W1x)*Bent1W1nx+(Bent1P4y-Bent1W1y)*Bent1W1ny-Half" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1Wall1Pile4Face = (Bent1P4x-Bent1W1x)*Bent1W1nx+(Bent1P4y-Bent1W1y)*Bent1W1ny-Half</expbody>
                    <expresult> = 3 ft 1.186 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1Wall1Pile4Extra = Max(0 in,LayoutClear-Bent1Wall1Pile4Face)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1Wall1Pile4Extra = Max(0 in,LayoutClear-Bent1Wall1Pile4Face)</expbody>
                    <expresult> = 0 ft 0.314 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent1W1Gap = Min(Bent1Wall1Pile1Face,Bent1Wall1Pile2Face,Bent1Wall1Pile3Face,Bent1Wall1Pile4Face)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent1W1Gap = Min(Bent1Wall1Pile1Face,Bent1Wall1Pile2Face,Bent1Wall1Pile3Face,Bent1Wall1Pile4Face)</expbody>
                    <expresult> = 3 ft 1.182 in</expresult>
