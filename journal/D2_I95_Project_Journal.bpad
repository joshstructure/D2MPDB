      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>Strand 11</textvalue>
        </c>
        <c formula="s_sh_11 to in" capture="False" background="#EFF7F1">
          <num>-2.046 in</num>
        </c>
        <c formula="m_sh_11" capture="False" background="#EFF7F1">
          <num>1.000</num>
        </c>
        <c formula="w_sh_11 to in" capture="False" background="#EFF7F1">
          <num>-2.046 in</num>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>Strand 12</textvalue>
        </c>
        <c formula="s_sh_12 to in" capture="False" background="#EFF7F1">
          <num>1.618 in</num>
        </c>
        <c formula="m_sh_12" capture="False" background="#EFF7F1">
          <num>0.000</num>
        </c>
        <c formula="w_sh_12 to in" capture="False" background="#EFF7F1">
          <num>0.000 in</num>
        </c>
      </row>
    </table>
  </embed>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="A_ps_t = A_str*n_tens to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>A_ps_t = A_str*n_tens to in^2</expbody>
      <expresult> = 1.302 in^2</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">prestressing on the flexural tension half depth</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="d_e = s_max_h - w_tens/n_tens to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>d_e = s_max_h - w_tens/n_tens to in</expbody>
      <expresult> = 13.617 in</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">depth from the compression fiber to that steel</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="b_v = D_pile - d_void to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>b_v = D_pile - d_void to in</expbody>
      <expresult> = 18.000 in</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">effective web width</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="d_v = Max(0.9*d_e, 0.72*D_pile) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>d_v = Max(0.9*d_e, 0.72*D_pile) to in</expbody>
      <expresult> = 12.960 in</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">effective shear depth, 5.7.2.8</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="M_u_v = Max(M_u_sh, V_u_sh*d_v) to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>M_u_v = Max(M_u_sh, V_u_sh*d_v) to kip*ft</expbody>
      <expresult> = 62.547 kip*ft</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">moment not less than Vu dv</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="N_u = -P_u_sh to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>N_u = -P_u_sh to kip</expbody>
      <expresult> = -132.100 kip</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">axial force, tension positive</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="f_po = 0.7*f_pu to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>f_po = 0.7*f_pu to ksi</expbody>
      <expresult> = 189.000 ksi</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">locked-in strand stress parameter</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="F_long = M_u_v/d_v + 0.5*N_u + V_u_sh - A_ps_t*f_po to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>F_long = M_u_v/d_v + 0.5*N_u + V_u_sh - A_ps_t*f_po to kip</expbody>
      <expresult> = -245.452 kip</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">numerator of Eq. 5.7.3.4.2-4</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="eps_s0 = F_long/(E_p*A_ps_t)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>eps_s0 = F_long/(E_p*A_ps_t)</expbody>
      <expresult> = -0.007</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">longitudinal strain, Eq. 5.7.3.4.2-4</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="A_ct = A_g/2 to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>A_ct = A_g/2 to in^2</expbody>
      <expresult> = 162.000 in^2</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">concrete on the flexural tension side</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="eps_s1 = F_long/(E_p*A_ps_t + E_c*A_ct)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>eps_s1 = F_long/(E_p*A_ps_t + E_c*A_ct)</expbody>
      <expresult> = -0.000</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strain with Ec Act added (negative eps_s0)</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="ε_s = Max(If(eps_s0 &lt; 0, eps_s1, eps_s0), -0.0004)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>ε_s = Max(If(eps_s0 &lt; 0, eps_s1, eps_s0), -0.0004)</expbody>
      <expresult> = -0.000</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">longitudinal strain used (not below -0.40E-3)</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="s_x = d_v to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>s_x = d_v to in</expbody>
      <expresult> = 12.960 in</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">crack spacing parameter</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="s_xe = Min(80 in, Max(12 in, s_x*1.38/((a_g + (0.63 in))/(1 in)))) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>s_xe = Min(80 in, Max(12 in, s_x*1.38/((a_g + (0.63 in))/(1 in)))) to in</expbody>
      <expresult> = 12.960 in</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">equivalent crack spacing, Eq. 5.7.3.4.2-7</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="A_v = 2*spiral_wire_area to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>A_v = 2*spiral_wire_area to in^2</expbody>
      <expresult> = 0.068 in^2</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">spiral area crossing the shear plane (two legs)</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="A_v_min = 0.0316*λ*Sqrt(fc/(1 ksi))*(1 ksi)*b_v*spiral_pitch/f_y_spiral to in^2" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>A_v_min = 0.0316*λ*Sqrt(fc/(1 ksi))*(1 ksi)*b_v*spiral_pitch/f_y_spiral to in^2</expbody>
      <expresult> = 0.124 in^2</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum transverse reinforcement, 5.7.2.5</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="beta_v = If(A_v &gt;= A_v_min, 4.8/(1 + 750*ε_s), 4.8/(1 + 750*ε_s)*51/(39 + s_xe/(1 in)))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>beta_v = If(A_v &gt;= A_v_min, 4.8/(1 + 750*ε_s), 4.8/(1 + 750*ε_s)*51/(39 + s_xe/(1 in)))</expbody>
      <expresult> = 6.017</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">beta, Eq. 5.7.3.4.2-1 (Av &gt;= Av,min) or -2</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="theta_v = (29 + 3500*ε_s)*(1 deg) to deg" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>theta_v = (29 + 3500*ε_s)*(1 deg) to deg</expbody>
      <expresult> = 27.987 deg</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">crack angle, Eq. 5.7.3.4.2-3</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="V_c = 0.0316*beta_v*λ*Sqrt(fc/(1 ksi))*(1 ksi)*b_v*d_v to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>V_c = 0.0316*beta_v*λ*Sqrt(fc/(1 ksi))*(1 ksi)*b_v*d_v to kip</expbody>
      <expresult> = 113.084 kip</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">concrete shear resistance</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="V_s = A_v*f_y_spiral*d_v/(Tan(theta_v)*spiral_pitch) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>V_s = A_v*f_y_spiral*d_v/(Tan(theta_v)*spiral_pitch) to kip</expbody>
      <expresult> = 19.347 kip</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">spiral shear resistance</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="V_n = Min(V_c + V_s, 0.25*fc*b_v*d_v) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>V_n = Min(V_c + V_s, 0.25*fc*b_v*d_v) to kip</expbody>
      <expresult> = 132.432 kip</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">nominal shear resistance</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="V_r = φ_v*V_n to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>V_r = φ_v*V_n to kip</expbody>
      <expresult> = 119.188 kip</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">factored shear resistance</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="DC_shear = V_u_sh/V_r" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>DC_shear = V_u_sh/V_r</expbody>
      <expresult> = 0.074</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">shear D/C</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">12. Service I stresses (LRFD 5.9.2.3.2)</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="P_sc = P_u_5 to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>P_sc = P_u_5 to kip</expbody>
      <expresult> = 126.280 kip</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">axial load, compression-stress record</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="Mx_sc = M_2_5 to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>Mx_sc = M_2_5 to kip*ft</expbody>
      <expresult> = 18.890 kip*ft</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">moment M2</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="My_sc = M_3_5 to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>My_sc = M_3_5 to kip*ft</expbody>
      <expresult> = -39.380 kip*ft</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">moment M3</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="sig_c = f_pc_eff + P_sc/A_g + (Abs(Mx_sc) + Abs(My_sc))/S_g to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>sig_c = f_pc_eff + P_sc/A_g + (Abs(Mx_sc) + Abs(My_sc))/S_g to ksi</expbody>
      <expresult> = 2.146 ksi</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">corner compression after losses</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="sig_c_lim = 0.6*fc to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>sig_c_lim = 0.6*fc to ksi</expbody>
      <expresult> = 3.900 ksi</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">compression limit 0.60 phi_w f'c (solid)</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="DC_svc_c = sig_c/sig_c_lim" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>DC_svc_c = sig_c/sig_c_lim</expbody>
      <expresult> = 0.550</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Service I compression D/C</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="P_st = P_u_6 to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>P_st = P_u_6 to kip</expbody>
      <expresult> = 86.320 kip</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">axial load, tension-stress record</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="Mx_st = M_2_6 to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>Mx_st = M_2_6 to kip*ft</expbody>
      <expresult> = -1.210 kip*ft</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">moment M2</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="My_st = M_3_6 to kip*ft" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>My_st = M_3_6 to kip*ft</expbody>
      <expresult> = -36.130 kip*ft</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">moment M3</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="sig_t = f_pc_eff + P_st/A_g - (Abs(Mx_st) + Abs(My_st))/S_g to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>sig_t = f_pc_eff + P_st/A_g - (Abs(Mx_st) + Abs(My_st))/S_g to ksi</expbody>
      <expresult> = 0.842 ksi</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">corner stress on the tension side (negative = tension)</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="f_t_net = Max(-sig_t, 0 ksi) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>f_t_net = Max(-sig_t, 0 ksi) to ksi</expbody>
      <expresult> = 0.000 ksi</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">net tensile stress</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="f_t_sev = Min(0.3 ksi, 0.0948*λ*Sqrt(fc/(1 ksi))*(1 ksi))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>f_t_sev = Min(0.3 ksi, 0.0948*λ*Sqrt(fc/(1 ksi))*(1 ksi))</expbody>
      <expresult> = 0.242 ksi</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">severe corrosive limit</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="f_t_mod = Min(0.6 ksi, 0.19*λ*Sqrt(fc/(1 ksi))*(1 ksi))" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>f_t_mod = Min(0.6 ksi, 0.19*λ*Sqrt(fc/(1 ksi))*(1 ksi))</expbody>
      <expresult> = 0.484 ksi</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">moderate limit</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="f_t_lim = If(environment == 3, f_t_sev, f_t_mod) to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>f_t_lim = If(environment == 3, f_t_sev, f_t_mod) to ksi</expbody>
      <expresult> = 0.484 ksi</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">tension limit: 0.19 sqrt(f'c) up to 0.6 ksi (0.0948, 0.3 ksi in Extremely Aggressive environments)</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="DC_svc_t = f_t_net/f_t_lim" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>DC_svc_t = f_t_net/f_t_lim</expbody>
      <expresult> = 0.000</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Service I tension D/C</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">13. Prestress, driving strength, minimum size</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="f_pc_min = 0.7 ksi to ksi" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>f_pc_min = 0.7 ksi to ksi</expbody>
      <expresult> = 0.700 ksi</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum uniform prestress after losses, 5.12.9.4.3</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="DC_pre = f_pc_min/f_pc_eff" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>DC_pre = f_pc_min/f_pc_eff</expbody>
      <expresult> = 0.675</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">effective prestress D/C</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="DC_fc = (5 ksi)/fc" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>DC_fc = (5 ksi)/fc</expbody>
      <expresult> = 0.769</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">driving strength 5.0 ksi / f'c, 5.12.9.4</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="D_min = If(environment == 3, Max(min_size_policy, 18 in), min_size_policy) to in" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>D_min = If(environment == 3, Max(min_size_policy, 18 in), min_size_policy) to in</expbody>
      <expresult> = 14.000 in</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum square pile size, SDG Table 3.5.1-1</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="DC_size = D_min/D_pile" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>DC_size = D_min/D_pile</expbody>
      <expresult> = 0.778</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">minimum size D/C</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Pile-to-cap moment transfer (SDG 3.5.1.C) needs 48 in of embedment for the full bending capacity; the embedment here is 12 in, so the connection stays a PENDING item of the notebook.</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True">14. Geotechnical resistance (SDG 3.5.13)</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6">SDG Eq. 3-1: Rn &gt;= (Factored Design Load + Net Scour Resistance + Downdrag) / phi. The downdrag enters nominally; the minimum tip elevation, scour and test-pile length of the Pile Data Table come from the geotechnical handoff.</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="FDL_tons = FDL_fbmp/(2 kip)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>FDL_tons = FDL_fbmp/(2 kip)</expbody>
      <expresult> = 49.440</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">Factored Design Load, tons (strength head compression, without downdrag)</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="R_scour_net = R_scour_net_tons*2*(1 kip) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>R_scour_net = R_scour_net_tons*2*(1 kip) to kip</expbody>
      <expresult> = 0.000 kip</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">net scour resistance</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="R_n_req = (FDL_fbmp + R_scour_net + DD)/phi_geo to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>R_n_req = (FDL_fbmp + R_scour_net + DD)/phi_geo to kip</expbody>
      <expresult> = 179.840 kip</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">required nominal bearing resistance, SDG Eq. 3-1</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="NBR_tons = R_n_req/(2 kip)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>NBR_tons = R_n_req/(2 kip)</expbody>
      <expresult> = 89.920</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">required nominal bearing resistance, tons (Pile Data Table column C)</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="R_drive_max = R_drive_tons*2*(1 kip) to kip" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>R_drive_max = R_drive_tons*2*(1 kip) to kip</expbody>
      <expresult> = 600.000 kip</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">maximum pile driving resistance, SDG Table 3.5.13-1</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="DC_nbr = NBR_tons/R_drive_tons" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>DC_nbr = NBR_tons/R_drive_tons</expbody>
      <expresult> = 0.300</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">bearing resistance D/C against Table 3.5.13-1</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" pagebreakbefore="break">15. Summary of checks</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="DC_max = Max(DC_axial, DC_bi, DC_rs, DC_shear, DC_t, DC_svc_c, DC_svc_t, DC_pre, DC_fc, DC_size, DC_sp, DC_nbr)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>DC_max = Max(DC_axial, DC_bi, DC_rs, DC_shear, DC_t, DC_svc_c, DC_svc_t, DC_pre, DC_fc, DC_size, DC_sp, DC_nbr)</expbody>
      <expresult> = 1.000</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">largest of the distilled ratios</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="Status = If(DC_max &lt;= 1, &quot;✓ All Checks Pass&quot;, &quot;⊗ There are FAILURES&quot;)" mathlayout="on" showformula="False" showresult="True" showsteps="False" style="Result only" showidentifier="False">
      <expbody>Status = If(DC_max &lt;= 1, "✓ All Checks Pass", "⊗ There are FAILURES")</expbody>
      <expresult> = ✓ All Checks Pass</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">distilled numerical checks only</paragraph>
  <section name="Checks" capture="False" hide="true">
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Chk_axial = If(DC_axial &lt;= 1, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>Chk_axial = If(DC_axial &lt;= 1, "✓ PASS", "⊗ FAIL")</expbody>
        <expresult> = ✓ PASS</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Chk_bi = If(DC_bi &lt;= 1, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>Chk_bi = If(DC_bi &lt;= 1, "✓ PASS", "⊗ FAIL")</expbody>
        <expresult> = ✓ PASS</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Chk_rs = If(DC_rs &lt;= 1, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>Chk_rs = If(DC_rs &lt;= 1, "✓ PASS", "⊗ FAIL")</expbody>
        <expresult> = ✓ PASS</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Chk_shear = If(DC_shear &lt;= 1, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>Chk_shear = If(DC_shear &lt;= 1, "✓ PASS", "⊗ FAIL")</expbody>
        <expresult> = ✓ PASS</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Chk_t = If(DC_t &lt;= 1, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>Chk_t = If(DC_t &lt;= 1, "✓ PASS", "⊗ FAIL")</expbody>
        <expresult> = ✓ PASS</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Chk_svc_c = If(DC_svc_c &lt;= 1, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>Chk_svc_c = If(DC_svc_c &lt;= 1, "✓ PASS", "⊗ FAIL")</expbody>
        <expresult> = ✓ PASS</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Chk_svc_t = If(DC_svc_t &lt;= 1, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>Chk_svc_t = If(DC_svc_t &lt;= 1, "✓ PASS", "⊗ FAIL")</expbody>
        <expresult> = ✓ PASS</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Chk_pre = If(DC_pre &lt;= 1, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>Chk_pre = If(DC_pre &lt;= 1, "✓ PASS", "⊗ FAIL")</expbody>
        <expresult> = ✓ PASS</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Chk_fc = If(DC_fc &lt;= 1, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>Chk_fc = If(DC_fc &lt;= 1, "✓ PASS", "⊗ FAIL")</expbody>
        <expresult> = ✓ PASS</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Chk_size = If(DC_size &lt;= 1, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>Chk_size = If(DC_size &lt;= 1, "✓ PASS", "⊗ FAIL")</expbody>
        <expresult> = ✓ PASS</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Chk_sp = If(DC_sp &lt;= 1, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>Chk_sp = If(DC_sp &lt;= 1, "✓ PASS", "⊗ FAIL")</expbody>
        <expresult> = ✓ PASS</expresult>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="Chk_nbr = If(DC_nbr &lt;= 1, &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>Chk_nbr = If(DC_nbr &lt;= 1, "✓ PASS", "⊗ FAIL")</expbody>
        <expresult> = ✓ PASS</expresult>
      </dynexp>
    </paragraph>
  </section>
  <embed spacingbefore="5" spacingafter="8">
    <table name="Summary" capture="False" colwidths="1:300, 2:90, 3:130">
      <stylerule range="A1:C14" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/>
      <stylerule range="A1:C1" horzalign="Center" vertalign="Center"/>
      <stylerule range="B2:C14" horzalign="Center" vertalign="Center"/>
      <row>
        <c capture="False" background="#DCECE0" fontweight="bold">
          <textvalue>Check</textvalue>
        </c>
        <c capture="False" background="#DCECE0" fontweight="bold">
          <textvalue>D/C</textvalue>
        </c>
        <c capture="False" background="#DCECE0" fontweight="bold">
          <textvalue>Result</textvalue>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>1. axial compression</textvalue>
        </c>
        <c formula="DC_axial" capture="False" background="#EFF7F1">
          <num>0.137</num>
        </c>
        <c formula="Chk_axial" capture="False" background="#EFF7F1">
          <textvalue>✓ PASS</textvalue>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>2. axial + biaxial flexure, 5.6.4.5</textvalue>
        </c>
        <c formula="DC_bi" capture="False" background="#EFF7F1">
          <num>0.474</num>
        </c>
        <c formula="Chk_bi" capture="False" background="#EFF7F1">
          <textvalue>✓ PASS</textvalue>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>3. axial + flexure, resultant axis</textvalue>
        </c>
        <c formula="DC_rs" capture="False" background="#EFF7F1">
          <num>0.398</num>
        </c>
        <c formula="Chk_rs" capture="False" background="#EFF7F1">
          <textvalue>✓ PASS</textvalue>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>4. shear</textvalue>
        </c>
        <c formula="DC_shear" capture="False" background="#EFF7F1">
          <num>0.074</num>
        </c>
        <c formula="Chk_shear" capture="False" background="#EFF7F1">
          <textvalue>✓ PASS</textvalue>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>5. tension</textvalue>
        </c>
        <c formula="DC_t" capture="False" background="#EFF7F1">
          <num>0.000</num>
        </c>
        <c formula="Chk_t" capture="False" background="#EFF7F1">
          <textvalue>✓ PASS</textvalue>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>6. Service I compression</textvalue>
        </c>
        <c formula="DC_svc_c" capture="False" background="#EFF7F1">
          <num>0.550</num>
        </c>
        <c formula="Chk_svc_c" capture="False" background="#EFF7F1">
          <textvalue>✓ PASS</textvalue>
