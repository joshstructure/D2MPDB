                    <c capture="False"><textvalue>FBMP node</textvalue></c>
                    <c capture="False"><textvalue>T (ft)</textvalue></c>
                    <c capture="False"><textvalue>L (ft)</textvalue></c>
                    <c capture="False"><textvalue>V (ft)</textvalue></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Near origin</textvalue></c>
                    <c capture="False" formula="EB_Node_near"><num>15</num></c>
                    <c capture="False" formula="EB_T_near to ft"><num>-4.291666666666667 ft</num></c>
                    <c capture="False" formula="EB_L_entry to ft"><num>0 ft</num></c>
