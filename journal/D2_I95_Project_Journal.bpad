                        <c capture="False" formula="NB_y2 to ft in"><num>-0 ft 10.5 in</num></c>
                        <c capture="False" formula="NB_zn to ft in"><num>0 ft 0 in</num></c>
                        <c capture="False" formula="NB_l2 to ft in"><num>53 ft 8.100000000000023 in</num></c>
