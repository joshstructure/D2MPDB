        <textcell name="StationInputsR16C5" capture="False" background="#FFF8E9">
          <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="2">
            <dynexp formula="A_o_M = 1033.082031 in^2" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input">
              <expbody>A_o_M = 1033.082031 in^2</expbody>
            </dynexp>
          </paragraph>
