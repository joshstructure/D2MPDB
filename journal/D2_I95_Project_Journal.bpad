      </planecontainer>
      <plot formula="PlotLines([0.6,6.3],[0.5,0.5])" linecolor="#29333D" linethickness="1.2"/>
      <plot formula="PlotLines([0.6,0.6],[0.5,2.9])" linecolor="#29333D" linethickness="1.2"/>
      <plot formula="PlotLines([0.6,6.3],[0.5+2.4/CapDesignEndBentTwo.DC_ymax,0.5+2.4/CapDesignEndBentTwo.DC_ymax])" linecolor="#7B8993" linethickness="0.9"/>
      <planecontainer origin="0.68,1.283,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#7B8993">
