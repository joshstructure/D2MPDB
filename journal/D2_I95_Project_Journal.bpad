                        <c capture="False" formula="If(EB_ViewCase == &quot;W1&quot;,EB_MT_W1_far,If(EB_ViewCase == &quot;W2&quot;,EB_MT_W2_far,EB_MT_W3_far))/EB_U_M"><num>-22.5039989770515</num></c>
                        <c capture="False" formula="If(EB_ViewCase == &quot;W1&quot;,EB_ML_W1_far,If(EB_ViewCase == &quot;W2&quot;,EB_ML_W2_far,EB_ML_W3_far))/EB_U_M"><num>-29.14570823645308</num></c>
                        <c capture="False" formula="If(EB_ViewCase == &quot;W1&quot;,EB_MV_W1_far,If(EB_ViewCase == &quot;W2&quot;,EB_MV_W2_far,EB_MV_W3_far))/EB_U_M"><num>-3.2917505772935245</num></c>
                    </row>
                </table>
            </embed>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0">
                Forces: kip. Moment units:
                <dynexp formula="EB_MomentUnits" style="Result only" mathlayout="off">
                    <expresult>kip-ft</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0">
                Axis consistency:
                <dynexp formula="EB_AxisCheck" style="Result only" mathlayout="off">
                    <expresult>PASS - RIGHT-HANDED</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0" background="#F1F5FA">Changing the axis view rotates coordinates, forces and moments together; DC and PL remain physically downward. Changing the orange wind controls changes the physical load case. W2 direct uplift stays physically upward in every view.</paragraph>
        </section>
        <embed spacingbefore="5" spacingafter="10" leftindent="0">
            <table name="EBNodeMap" capture="False" colwidths="1:140, 2:100, 3:120, 4:120, 5:120">
                <stylerule range="A1:E3" fontfamily="Times New Roman" fontsize="9.5" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.7, &quot;#7189A6&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.35, &quot;#CCD6D0&quot;); Border(&quot;BetweenColumns&quot;, &quot;Solid&quot;, 0.35, &quot;#CCD6D0&quot;);" horzalign="Center" vertalign="Center" />
                <stylerule range="A1:E1" background="#DCE7F3" fontweight="bold" />
