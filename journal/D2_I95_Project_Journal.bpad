            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="2" leftindent="0" spacingbefore="4" keepwithnext="False">
                <dynexp formula="EB_CheckF_W3 = If(And(AX_Base_EB_CheckF_W3 == &quot;PASS&quot;,Abs(EB_SumFT_W3-EB_axisT*AX_Base_EB_SumFT_W3)&lt;0.000001 kip,Abs(EB_SumFL_W3-EB_axisL*AX_Base_EB_SumFL_W3)&lt;0.000001 kip,Abs(EB_SumFV_W3-EB_axisV*AX_Base_EB_SumFV_W3)&lt;0.000001 kip),&quot;PASS&quot;,&quot;FAIL&quot;)" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_CheckF_W3 = If(And(AX_Base_EB_CheckF_W3 == "PASS",Abs(EB_SumFT_W3-EB_axisT*AX_Base_EB_SumFT_W3)&lt;0.000001 kip,Abs(EB_SumFL_W3-EB_axisL*AX_Base_EB_SumFL_W3)&lt;0.000001 kip,Abs(EB_SumFV_W3-EB_axisV*AX_Base_EB_SumFV_W3)&lt;0.000001 kip),"PASS","FAIL")</expbody>
                    <expresult> = PASS</expresult>
