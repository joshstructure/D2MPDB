        </c>
        <c formula="Chk_klr" capture="False" background="#EFF7F1">
          <textvalue>✓ PASS</textvalue>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>3. axial compression</textvalue>
        </c>
        <c formula="DC_axial" capture="False" background="#EFF7F1">
          <num>0.324</num>
        </c>
        <c formula="Chk_axial" capture="False" background="#EFF7F1">
