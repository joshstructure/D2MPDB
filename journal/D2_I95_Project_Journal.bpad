            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" fontweight="bold" keepwithnext="True">SOURCE AND DATUM CHECKS</paragraph>
            <embed spacingbefore="5" spacingafter="12">
                <table name="NBSourceChecks" capture="False" colwidths="1:400, 2:120">
                    <stylerule range="A1:B5" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.3, &quot;#BCD0C1&quot;); Border(&quot;BetweenColumns&quot;, &quot;Solid&quot;, 0.3, &quot;#BCD0C1&quot;);" />
