    <report title="Project Index" name="PedBridge" unit="in" pagesize="816, 1056" margin="48,48,48,48" collapsemargins="False">
        <float />
        <stylerule applytoall="True" type="Any" leftindent="0.25 in" spacingafter="4" />
        <stylerule type="AnyEquation" name="Required Input" texthighlight="#F7E6B9" />
        <heading level="0" keepwithnext="True">D2 I-95 Pedestrian Bridge - Project Index</heading>
        <section name="CurrentEndBentRecord" capture="False" hide="false">
            <heading level="1" keepwithnext="True">Current end-bent data — 8 October 2026</heading>
            <paragraph fontfamily="Times New Roman" fontsize="10" leftindent="0" spacingafter="7">
                <link address="#BridgeGeometry_2Beam.EndBentCurrentGeometry">Both end bents — cap and square pile geometry</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" leftindent="0" spacingafter="7">
                <link address="#FBMPEndBent.EBCurrentDesignRecord">Current steel configuration, End Bent 1 forces and coherence register</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" leftindent="0" spacingafter="7">Both end bents follow the controlling End Bent 1 configuration. User responses applied: 30-in end-bent pedestals, nodes 15/34, latest report model, field-adjusted U hooks and Service III N/A. Wall quantities are deferred; remaining design checks are listed in the record.</paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" leftindent="0">The former Ped Bridge contents are organized by topic. Use the module list or the links below. Existing geometry, load sources, calculations, notes and reference images are retained; historical alternatives are labeled separately.</paragraph>
        <heading level="1" keepwithnext="True">Project basis and geometry</heading>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0">
