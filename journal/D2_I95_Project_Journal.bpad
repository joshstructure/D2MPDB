            </rectangle>
            <rectangle origin="0, 33, 0" dir="8.5, 0, 0" normal="0, 0, -1" height="11" shapetype="Fill">
                <textbox capture="False" name="PDFDisplay07">
                    <paragraph spacingbefore="0" spacingafter="0">
                        <image source="ReferencePDF07" />
                    </paragraph>
                </textbox>
            </rectangle>
            <rectangle origin="0, 44, 0" dir="8.5, 0, 0" normal="0, 0, -1" height="11" shapetype="Fill">
                <textbox capture="False" name="PDFDisplay08">
                    <paragraph spacingbefore="0" spacingafter="0">
                        <image source="ReferencePDF08" />
                    </paragraph>
                </textbox>
            </rectangle>
            <rectangle origin="0, 55, 0" dir="8.5, 0, 0" normal="0, 0, -1" height="11" shapetype="Fill">
                <textbox capture="False" name="PDFDisplay09">
