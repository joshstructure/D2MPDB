                <planecontainer origin="2.12,1.92,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="10" textcolor="#29333D"><textvalue>Steps 1–2: Set up the model</textvalue></planecontainer>
                <planecontainer origin="2.12,1.74,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#29333D"><textvalue>Geometry / gravity / load factors</textvalue></planecontainer>
