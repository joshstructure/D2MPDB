        <paragraph fontfamily="Times New Roman" fontsize="1" spacingbefore="0" spacingafter="0" pagebreakafter="break"> </paragraph>
        <section name="CodePage07" capture="True" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="40" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" id="paragraphprojectcoderef07C004" textcolor="#155731" texthighlight="#DDEFE3">
                <link address="#CodeReferencesC004.CodePage07;paragraphprojectcoderef07C004">REFERENCE 07 | LRFD 3.8.1.1.5; Eq. 3.8.1.2.1-1</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC004.CodePage07;paragraphprojectcoderef07C004">LRFD Bridge Design Specifications, 10th Edition (2024)</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" textcolor="#536575">Printed 3-50 | Source PDF page 107</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">USED FOR</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Defines exposure categories and the horizontal wind-pressure equation. C001 calculates superstructure pressures; C002 uses the pressure equation for direct-pier wind.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Variables: Exp_Cat; P_Z_III; P_Z_SIV; q_III; q_SI</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">SCOPE / REVIEW NOTE</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">The vertical load and the prescribed fence pressure have separate code bases.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC004.CodePage05;paragraphprojectcoderef05C004">Related: FDOT SDG 2.4.1.B-C</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC004.CodePage08;paragraphprojectcoderef08C004">Related: LRFD Eqs. 3.8.1.2.1-2 through -4</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">RETURN TO CALCULATIONS</paragraph>
