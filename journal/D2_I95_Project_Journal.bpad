                    <dynexp formula="AX_Base_FE_SumMV_W3 = (FE_h*(AX_Base_FE_T_B1*AX_Base_FE_FL_W3_B1-AX_Base_FE_L_B1*AX_Base_FE_FT_W3_B1)+AX_Base_FE_MV_W3_B1)+(FE_h*(AX_Base_FE_T_B2*AX_Base_FE_FL_W3_B2-AX_Base_FE_L_B2*AX_Base_FE_FT_W3_B2)+AX_Base_FE_MV_W3_B2)+(FE_h*(AX_Base_FE_T_B3*AX_Base_FE_FL_W3_B3-AX_Base_FE_L_B3*AX_Base_FE_FT_W3_B3)+AX_Base_FE_MV_W3_B3)+(FE_h*(AX_Base_FE_T_B4*AX_Base_FE_FL_W3_B4-AX_Base_FE_L_B4*AX_Base_FE_FT_W3_B4)+AX_Base_FE_MV_W3_B4) to kip*ft" mathlayout="on" showsteps="False" seplines="False">
                        <expbody>AX_Base_FE_SumMV_W3 = (FE_h*(AX_Base_FE_T_B1*AX_Base_FE_FL_W3_B1-AX_Base_FE_L_B1*AX_Base_FE_FT_W3_B1)+AX_Base_FE_MV_W3_B1)+(FE_h*(AX_Base_FE_T_B2*AX_Base_FE_FL_W3_B2-AX_Base_FE_L_B2*AX_Base_FE_FT_W3_B2)+AX_Base_FE_MV_W3_B2)+(FE_h*(AX_Base_FE_T_B3*AX_Base_FE_FL_W3_B3-AX_Base_FE_L_B3*AX_Base_FE_FT_W3_B3)+AX_Base_FE_MV_W3_B3)+(FE_h*(AX_Base_FE_T_B4*AX_Base_FE_FL_W3_B4-AX_Base_FE_L_B4*AX_Base_FE_FT_W3_B4)+AX_Base_FE_MV_W3_B4) to kip*ft</expbody>
                        <expresult> = 0.261 kip*ft</expresult>
                    </dynexp>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" leftindent="0">
                    <dynexp formula="AX_Base_FE_CheckF_W1 = If(And(Abs(AX_Base_FE_SumFT_W1-(-(NB_HT_IIIS_1+NB_HT_IIIS_2+NB_HT_IIIS_3+NB_HT_IIIS_4)))&lt;FE_tolF, Abs(AX_Base_FE_SumFL_W1-((NB_HL_IIIS_1+NB_HL_IIIS_2+NB_HL_IIIS_3+NB_HL_IIIS_4)))&lt;FE_tolF, Abs(AX_Base_FE_SumFV_W1-(-(NB_FV_IIIS_1+NB_FV_IIIS_2+NB_FV_IIIS_3+NB_FV_IIIS_4)))&lt;FE_tolF), &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showsteps="False" seplines="False">
                        <expbody>AX_Base_FE_CheckF_W1 = If(And(Abs(AX_Base_FE_SumFT_W1-(-(NB_HT_IIIS_1+NB_HT_IIIS_2+NB_HT_IIIS_3+NB_HT_IIIS_4)))&lt;FE_tolF, Abs(AX_Base_FE_SumFL_W1-((NB_HL_IIIS_1+NB_HL_IIIS_2+NB_HL_IIIS_3+NB_HL_IIIS_4)))&lt;FE_tolF, Abs(AX_Base_FE_SumFV_W1-(-(NB_FV_IIIS_1+NB_FV_IIIS_2+NB_FV_IIIS_3+NB_FV_IIIS_4)))&lt;FE_tolF), "✓ PASS", "⊗ FAIL")</expbody>
                        <expresult> = ✓ PASS</expresult>
                    </dynexp>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" leftindent="0">
                    <dynexp formula="AX_Base_FE_CheckM_W1 = If(And(Abs(AX_Base_FE_SumMT_W1-(-((NB_y1*NB_FV_IIIS_1-NB_zn*NB_HL_IIIS_1+NB_MT_IIIS_1)+(NB_y2*NB_FV_IIIS_2-NB_zn*NB_HL_IIIS_2+NB_MT_IIIS_2)+(NB_y3*NB_FV_IIIS_3-NB_zn*NB_HL_IIIS_3+NB_MT_IIIS_3)+(NB_y4*NB_FV_IIIS_4-NB_zn*NB_HL_IIIS_4+NB_MT_IIIS_4))))&lt;FE_tolM, Abs(AX_Base_FE_SumML_W1-(((NB_zn*NB_HT_IIIS_1-NB_x1*NB_FV_IIIS_1+NB_ML_IIIS_1)+(NB_zn*NB_HT_IIIS_2-NB_x2*NB_FV_IIIS_2+NB_ML_IIIS_2)+(NB_zn*NB_HT_IIIS_3-NB_x3*NB_FV_IIIS_3+NB_ML_IIIS_3)+(NB_zn*NB_HT_IIIS_4-NB_x4*NB_FV_IIIS_4+NB_ML_IIIS_4))))&lt;FE_tolM, Abs(AX_Base_FE_SumMV_W1-(-((NB_x1*NB_HL_IIIS_1-NB_y1*NB_HT_IIIS_1+NB_MV_IIIS_1)+(NB_x2*NB_HL_IIIS_2-NB_y2*NB_HT_IIIS_2+NB_MV_IIIS_2)+(NB_x3*NB_HL_IIIS_3-NB_y3*NB_HT_IIIS_3+NB_MV_IIIS_3)+(NB_x4*NB_HL_IIIS_4-NB_y4*NB_HT_IIIS_4+NB_MV_IIIS_4))))&lt;FE_tolM), &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showsteps="False" seplines="False">
                        <expbody>AX_Base_FE_CheckM_W1 = If(And(Abs(AX_Base_FE_SumMT_W1-(-((NB_y1*NB_FV_IIIS_1-NB_zn*NB_HL_IIIS_1+NB_MT_IIIS_1)+(NB_y2*NB_FV_IIIS_2-NB_zn*NB_HL_IIIS_2+NB_MT_IIIS_2)+(NB_y3*NB_FV_IIIS_3-NB_zn*NB_HL_IIIS_3+NB_MT_IIIS_3)+(NB_y4*NB_FV_IIIS_4-NB_zn*NB_HL_IIIS_4+NB_MT_IIIS_4))))&lt;FE_tolM, Abs(AX_Base_FE_SumML_W1-(((NB_zn*NB_HT_IIIS_1-NB_x1*NB_FV_IIIS_1+NB_ML_IIIS_1)+(NB_zn*NB_HT_IIIS_2-NB_x2*NB_FV_IIIS_2+NB_ML_IIIS_2)+(NB_zn*NB_HT_IIIS_3-NB_x3*NB_FV_IIIS_3+NB_ML_IIIS_3)+(NB_zn*NB_HT_IIIS_4-NB_x4*NB_FV_IIIS_4+NB_ML_IIIS_4))))&lt;FE_tolM, Abs(AX_Base_FE_SumMV_W1-(-((NB_x1*NB_HL_IIIS_1-NB_y1*NB_HT_IIIS_1+NB_MV_IIIS_1)+(NB_x2*NB_HL_IIIS_2-NB_y2*NB_HT_IIIS_2+NB_MV_IIIS_2)+(NB_x3*NB_HL_IIIS_3-NB_y3*NB_HT_IIIS_3+NB_MV_IIIS_3)+(NB_x4*NB_HL_IIIS_4-NB_y4*NB_HT_IIIS_4+NB_MV_IIIS_4))))&lt;FE_tolM), "✓ PASS", "⊗ FAIL")</expbody>
                        <expresult> = ✓ PASS</expresult>
                    </dynexp>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" leftindent="0">
                    <dynexp formula="AX_Base_FE_CheckF_W2 = If(And(Abs(AX_Base_FE_SumFT_W2-(-(NB_HT_IIIU_1+NB_HT_IIIU_2+NB_HT_IIIU_3+NB_HT_IIIU_4)))&lt;FE_tolF, Abs(AX_Base_FE_SumFL_W2-((NB_HL_IIIU_1+NB_HL_IIIU_2+NB_HL_IIIU_3+NB_HL_IIIU_4)))&lt;FE_tolF, Abs(AX_Base_FE_SumFV_W2-(-(NB_FV_IIIU_1+NB_FV_IIIU_2+NB_FV_IIIU_3+NB_FV_IIIU_4)))&lt;FE_tolF), &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showsteps="False" seplines="False">
                        <expbody>AX_Base_FE_CheckF_W2 = If(And(Abs(AX_Base_FE_SumFT_W2-(-(NB_HT_IIIU_1+NB_HT_IIIU_2+NB_HT_IIIU_3+NB_HT_IIIU_4)))&lt;FE_tolF, Abs(AX_Base_FE_SumFL_W2-((NB_HL_IIIU_1+NB_HL_IIIU_2+NB_HL_IIIU_3+NB_HL_IIIU_4)))&lt;FE_tolF, Abs(AX_Base_FE_SumFV_W2-(-(NB_FV_IIIU_1+NB_FV_IIIU_2+NB_FV_IIIU_3+NB_FV_IIIU_4)))&lt;FE_tolF), "✓ PASS", "⊗ FAIL")</expbody>
                        <expresult> = ✓ PASS</expresult>
                    </dynexp>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" leftindent="0">
                    <dynexp formula="AX_Base_FE_CheckM_W2 = If(And(Abs(AX_Base_FE_SumMT_W2-(-((NB_y1*NB_FV_IIIU_1-NB_zn*NB_HL_IIIU_1+NB_MT_IIIU_1)+(NB_y2*NB_FV_IIIU_2-NB_zn*NB_HL_IIIU_2+NB_MT_IIIU_2)+(NB_y3*NB_FV_IIIU_3-NB_zn*NB_HL_IIIU_3+NB_MT_IIIU_3)+(NB_y4*NB_FV_IIIU_4-NB_zn*NB_HL_IIIU_4+NB_MT_IIIU_4))))&lt;FE_tolM, Abs(AX_Base_FE_SumML_W2-(((NB_zn*NB_HT_IIIU_1-NB_x1*NB_FV_IIIU_1+NB_ML_IIIU_1)+(NB_zn*NB_HT_IIIU_2-NB_x2*NB_FV_IIIU_2+NB_ML_IIIU_2)+(NB_zn*NB_HT_IIIU_3-NB_x3*NB_FV_IIIU_3+NB_ML_IIIU_3)+(NB_zn*NB_HT_IIIU_4-NB_x4*NB_FV_IIIU_4+NB_ML_IIIU_4))))&lt;FE_tolM, Abs(AX_Base_FE_SumMV_W2-(-((NB_x1*NB_HL_IIIU_1-NB_y1*NB_HT_IIIU_1+NB_MV_IIIU_1)+(NB_x2*NB_HL_IIIU_2-NB_y2*NB_HT_IIIU_2+NB_MV_IIIU_2)+(NB_x3*NB_HL_IIIU_3-NB_y3*NB_HT_IIIU_3+NB_MV_IIIU_3)+(NB_x4*NB_HL_IIIU_4-NB_y4*NB_HT_IIIU_4+NB_MV_IIIU_4))))&lt;FE_tolM), &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showsteps="False" seplines="False">
                        <expbody>AX_Base_FE_CheckM_W2 = If(And(Abs(AX_Base_FE_SumMT_W2-(-((NB_y1*NB_FV_IIIU_1-NB_zn*NB_HL_IIIU_1+NB_MT_IIIU_1)+(NB_y2*NB_FV_IIIU_2-NB_zn*NB_HL_IIIU_2+NB_MT_IIIU_2)+(NB_y3*NB_FV_IIIU_3-NB_zn*NB_HL_IIIU_3+NB_MT_IIIU_3)+(NB_y4*NB_FV_IIIU_4-NB_zn*NB_HL_IIIU_4+NB_MT_IIIU_4))))&lt;FE_tolM, Abs(AX_Base_FE_SumML_W2-(((NB_zn*NB_HT_IIIU_1-NB_x1*NB_FV_IIIU_1+NB_ML_IIIU_1)+(NB_zn*NB_HT_IIIU_2-NB_x2*NB_FV_IIIU_2+NB_ML_IIIU_2)+(NB_zn*NB_HT_IIIU_3-NB_x3*NB_FV_IIIU_3+NB_ML_IIIU_3)+(NB_zn*NB_HT_IIIU_4-NB_x4*NB_FV_IIIU_4+NB_ML_IIIU_4))))&lt;FE_tolM, Abs(AX_Base_FE_SumMV_W2-(-((NB_x1*NB_HL_IIIU_1-NB_y1*NB_HT_IIIU_1+NB_MV_IIIU_1)+(NB_x2*NB_HL_IIIU_2-NB_y2*NB_HT_IIIU_2+NB_MV_IIIU_2)+(NB_x3*NB_HL_IIIU_3-NB_y3*NB_HT_IIIU_3+NB_MV_IIIU_3)+(NB_x4*NB_HL_IIIU_4-NB_y4*NB_HT_IIIU_4+NB_MV_IIIU_4))))&lt;FE_tolM), "✓ PASS", "⊗ FAIL")</expbody>
                        <expresult> = ✓ PASS</expresult>
                    </dynexp>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" leftindent="0">
                    <dynexp formula="AX_Base_FE_CheckF_W3 = If(And(Abs(AX_Base_FE_SumFT_W3-(-(NB_HT_SIS_1+NB_HT_SIS_2+NB_HT_SIS_3+NB_HT_SIS_4)))&lt;FE_tolF, Abs(AX_Base_FE_SumFL_W3-((NB_HL_SIS_1+NB_HL_SIS_2+NB_HL_SIS_3+NB_HL_SIS_4)))&lt;FE_tolF, Abs(AX_Base_FE_SumFV_W3-(-(NB_FV_SIS_1+NB_FV_SIS_2+NB_FV_SIS_3+NB_FV_SIS_4)))&lt;FE_tolF), &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showsteps="False" seplines="False">
                        <expbody>AX_Base_FE_CheckF_W3 = If(And(Abs(AX_Base_FE_SumFT_W3-(-(NB_HT_SIS_1+NB_HT_SIS_2+NB_HT_SIS_3+NB_HT_SIS_4)))&lt;FE_tolF, Abs(AX_Base_FE_SumFL_W3-((NB_HL_SIS_1+NB_HL_SIS_2+NB_HL_SIS_3+NB_HL_SIS_4)))&lt;FE_tolF, Abs(AX_Base_FE_SumFV_W3-(-(NB_FV_SIS_1+NB_FV_SIS_2+NB_FV_SIS_3+NB_FV_SIS_4)))&lt;FE_tolF), "✓ PASS", "⊗ FAIL")</expbody>
                        <expresult> = ✓ PASS</expresult>
                    </dynexp>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="0" leftindent="0">
                    <dynexp formula="AX_Base_FE_CheckM_W3 = If(And(Abs(AX_Base_FE_SumMT_W3-(-((NB_y1*NB_FV_SIS_1-NB_zn*NB_HL_SIS_1+NB_MT_SIS_1)+(NB_y2*NB_FV_SIS_2-NB_zn*NB_HL_SIS_2+NB_MT_SIS_2)+(NB_y3*NB_FV_SIS_3-NB_zn*NB_HL_SIS_3+NB_MT_SIS_3)+(NB_y4*NB_FV_SIS_4-NB_zn*NB_HL_SIS_4+NB_MT_SIS_4))))&lt;FE_tolM, Abs(AX_Base_FE_SumML_W3-(((NB_zn*NB_HT_SIS_1-NB_x1*NB_FV_SIS_1+NB_ML_SIS_1)+(NB_zn*NB_HT_SIS_2-NB_x2*NB_FV_SIS_2+NB_ML_SIS_2)+(NB_zn*NB_HT_SIS_3-NB_x3*NB_FV_SIS_3+NB_ML_SIS_3)+(NB_zn*NB_HT_SIS_4-NB_x4*NB_FV_SIS_4+NB_ML_SIS_4))))&lt;FE_tolM, Abs(AX_Base_FE_SumMV_W3-(-((NB_x1*NB_HL_SIS_1-NB_y1*NB_HT_SIS_1+NB_MV_SIS_1)+(NB_x2*NB_HL_SIS_2-NB_y2*NB_HT_SIS_2+NB_MV_SIS_2)+(NB_x3*NB_HL_SIS_3-NB_y3*NB_HT_SIS_3+NB_MV_SIS_3)+(NB_x4*NB_HL_SIS_4-NB_y4*NB_HT_SIS_4+NB_MV_SIS_4))))&lt;FE_tolM), &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showsteps="False" seplines="False">
                        <expbody>AX_Base_FE_CheckM_W3 = If(And(Abs(AX_Base_FE_SumMT_W3-(-((NB_y1*NB_FV_SIS_1-NB_zn*NB_HL_SIS_1+NB_MT_SIS_1)+(NB_y2*NB_FV_SIS_2-NB_zn*NB_HL_SIS_2+NB_MT_SIS_2)+(NB_y3*NB_FV_SIS_3-NB_zn*NB_HL_SIS_3+NB_MT_SIS_3)+(NB_y4*NB_FV_SIS_4-NB_zn*NB_HL_SIS_4+NB_MT_SIS_4))))&lt;FE_tolM, Abs(AX_Base_FE_SumML_W3-(((NB_zn*NB_HT_SIS_1-NB_x1*NB_FV_SIS_1+NB_ML_SIS_1)+(NB_zn*NB_HT_SIS_2-NB_x2*NB_FV_SIS_2+NB_ML_SIS_2)+(NB_zn*NB_HT_SIS_3-NB_x3*NB_FV_SIS_3+NB_ML_SIS_3)+(NB_zn*NB_HT_SIS_4-NB_x4*NB_FV_SIS_4+NB_ML_SIS_4))))&lt;FE_tolM, Abs(AX_Base_FE_SumMV_W3-(-((NB_x1*NB_HL_SIS_1-NB_y1*NB_HT_SIS_1+NB_MV_SIS_1)+(NB_x2*NB_HL_SIS_2-NB_y2*NB_HT_SIS_2+NB_MV_SIS_2)+(NB_x3*NB_HL_SIS_3-NB_y3*NB_HT_SIS_3+NB_MV_SIS_3)+(NB_x4*NB_HL_SIS_4-NB_y4*NB_HT_SIS_4+NB_MV_SIS_4))))&lt;FE_tolM), "✓ PASS", "⊗ FAIL")</expbody>
                        <expresult> = ✓ PASS</expresult>
                    </dynexp>
                </paragraph>
            </section>
            <paragraph fontfamily="Times New Roman" fontsize="16" spacingafter="7" leftindent="0" keepwithnext="True" fontweight="bold" id="paragraphfbmpentry">FBMP ENTRY REFERENCE — PIER</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" leftindent="0">Live DC / PL / W1–W3 loads, current bearing labels, and node mapping.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="8" leftindent="0" background="#F1F5FA" fontweight="bold">Separate load cases—not combined reactions. Use one wind set per limit-state combination.</paragraph>
            <section name="FEEntryControls" capture="False" hide="false">
                <section name="FEAxisOrientation" capture="False" hide="false">
                    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0" fontweight="bold" textcolor="#1766A0">MATCH THE MODEL AXES</paragraph>
                    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0">
                        Positive transverse axis (+T):
                        <valuefield name="FE_AxisTChoice" valuedef="FromOptionsOrValue(null, [&quot;Toward B2 / B4&quot;, &quot;Toward B1 / B3&quot;])"><textvalue>Toward B2 / B4</textvalue></valuefield>
                    </paragraph>
                    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0">
                        Positive longitudinal axis (+L):
                        <valuefield name="FE_AxisLChoice" valuedef="FromOptionsOrValue(null, [&quot;Toward End Bent 2&quot;, &quot;Toward End Bent 1&quot;])"><textvalue>Toward End Bent 2</textvalue></valuefield>
                    </paragraph>
                    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0">
                        Show wind case on schematic:
                        <valuefield name="FE_ViewCase" valuedef="FromOptionsOrValue(null, [&quot;W1&quot;, &quot;W2&quot;, &quot;W3&quot;])"><textvalue>W1</textvalue></valuefield>
                    </paragraph>
                    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0" fontweight="bold">
                        Positive vertical axis (+V):
                        <dynexp formula="FE_VerticalLabel" style="Result only" mathlayout="off">
                            <expresult>Downward - into the plan</expresult>
                        </dynexp>
                    </paragraph>
                    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0" background="#F1F5FA">Blue = positive coordinate directions. Orange = physical wind. Nodes stay fixed. The vertical axis follows the two horizontal choices so all four views remain right-handed. Forces and right-hand-rule moments use the displayed axes.</paragraph>
                </section>
                <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" leftindent="0">
                    Physical transverse wind:
                    <valuefield name="FE_Tdirection" valuedef="FromOptionsOrValue(null, [&quot;Toward B2 / B4&quot;, &quot;Toward B1 / B3&quot;])"><textvalue>Toward B2 / B4</textvalue></valuefield>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" leftindent="0">
                    Physical longitudinal wind (W1 / W3):
                    <valuefield name="FE_Ldirection" valuedef="FromOptionsOrValue(null, [&quot;Toward End Bent 2&quot;, &quot;Toward End Bent 1&quot;])"><textvalue>Toward End Bent 2</textvalue></valuefield>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" leftindent="0">
                    Moment-entry units: 
                    <valuefield name="FE_MomentUnits" valuedef="FromOptionsOrValue(null, [&quot;kip-ft&quot;, &quot;kip-in&quot;])"><textvalue>kip-ft</textvalue></valuefield>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="4" leftindent="0" spacingbefore="4" keepwithnext="True">
                    <dynexp formula="FE_NodeElevation=0 ft" mathlayout="on" showsteps="False" seplines="False" style="Required Input">
                        <expbody>FE_NodeElevation=0 ft</expbody>
                    </dynexp>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="8" leftindent="0">Physical node elevation input: positive down from the cap centroid, independent of the chosen display axes. Negative puts a node above the centroid. The coordinate table converts this input to the chosen V direction.</paragraph>
            </section>
            <embed spacingafter="7" leftindent="0">
                <canvas name="FECurrentBearingPlan" title="Live nodes, axes and physical wind" unit="in" size="6.5 in; 4.25 in; scaletofit">
                    <include target="Library.Geometry" />
                    <planecontainer origin="0.1,4.04,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="11" textcolor="#29333D" fontweight="bold"><textvalue>LIVE MODEL MATCH — NODES STAY FIXED</textvalue></planecontainer>
                    <planecontainer origin="0.1,3.8,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#1766A0"><textvalue>Blue: positive axes</textvalue></planecontainer>
                    <planecontainer origin="2.15,3.8,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#C46A23"><textvalue>Orange: physical wind</textvalue></planecontainer>
                    <planecontainer origin="5.45,3.8,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="10" textcolor="#29333D" fontweight="bold" formula="FBMPPier.FE_ViewCase"><textvalue>W1</textvalue></planecontainer>
                    <lines pts="0.8,1.02,0;4.28,1.02,0;4.28,2.68,0;0.8,2.68,0;0.8,1.02,0" linecolor="#6B7A86" linethickness="1" />
                    <lines pts="0.8,1.85,0;4.28,1.85,0" linecolor="#BCC7D0" linethickness="1" />
                    <planecontainer origin="0.82,2.95,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#29333D"><textvalue>End Bent 2 / Span 2</textvalue></planecontainer>
                    <planecontainer origin="0.82,0.74,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#29333D"><textvalue>End Bent 1 / Span 1</textvalue></planecontainer>
                    <lines pts="2.52,1.02,0;2.52,2.65,0" linecolor="#BCC7D0" linethickness="1" />
                    <circle center="1.45,1.4,0" normal="0,0,1" radius=".065" linecolor="#29333D" fillcolor="#29333D" />
                    <planecontainer origin="0.99,1.63,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8.5" textcolor="#29333D" fontweight="bold"><textvalue>B2</textvalue></planecontainer>
                    <planecontainer origin="0.99,1.15,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#29333D"><textvalue>Node</textvalue></planecontainer>
                    <planecontainer origin="1.5,1.15,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="10" textcolor="#29333D" fontweight="bold" formula="FBMPPier.FE_Node_B2"><textvalue>2L</textvalue></planecontainer>
                    <circle center="3.6,1.4,0" normal="0,0,1" radius=".065" linecolor="#29333D" fillcolor="#29333D" />
                    <planecontainer origin="3.14,1.63,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8.5" textcolor="#29333D" fontweight="bold"><textvalue>B1</textvalue></planecontainer>
                    <planecontainer origin="3.14,1.15,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#29333D"><textvalue>Node</textvalue></planecontainer>
