                </row>
                <row>
                    <c capture="False"><textvalue>Fence force (kip)</textvalue></c>
                    <c capture="False" formula="F_fence"><num>15.429580078124996 kip</num></c>
                    <c capture="False" formula="F_fence"><num>15.429580078124996 kip</num></c>
