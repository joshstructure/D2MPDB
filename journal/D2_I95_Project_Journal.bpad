      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>Strand 1</textvalue>
        </c>
        <c formula="s_sh_1 to in" capture="False" background="#EFF7F1">
          <num>-5.282 in</num>
        </c>
        <c formula="m_sh_1" capture="False" background="#EFF7F1">
          <num>1.000</num>
        </c>
        <c formula="w_sh_1 to in" capture="False" background="#EFF7F1">
          <num>-5.282 in</num>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>Strand 2</textvalue>
        </c>
        <c formula="s_sh_2 to in" capture="False" background="#EFF7F1">
          <num>-5.425 in</num>
        </c>
        <c formula="m_sh_2" capture="False" background="#EFF7F1">
          <num>1.000</num>
        </c>
        <c formula="w_sh_2 to in" capture="False" background="#EFF7F1">
          <num>-5.425 in</num>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>Strand 3</textvalue>
        </c>
        <c formula="s_sh_3 to in" capture="False" background="#EFF7F1">
          <num>-5.567 in</num>
        </c>
        <c formula="m_sh_3" capture="False" background="#EFF7F1">
          <num>1.000</num>
        </c>
        <c formula="w_sh_3 to in" capture="False" background="#EFF7F1">
          <num>-5.567 in</num>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>Strand 4</textvalue>
        </c>
        <c formula="s_sh_4 to in" capture="False" background="#EFF7F1">
          <num>-5.710 in</num>
        </c>
        <c formula="m_sh_4" capture="False" background="#EFF7F1">
          <num>1.000</num>
        </c>
        <c formula="w_sh_4 to in" capture="False" background="#EFF7F1">
          <num>-5.710 in</num>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>Strand 5</textvalue>
        </c>
        <c formula="s_sh_5 to in" capture="False" background="#EFF7F1">
          <num>5.710 in</num>
        </c>
        <c formula="m_sh_5" capture="False" background="#EFF7F1">
          <num>0.000</num>
        </c>
        <c formula="w_sh_5 to in" capture="False" background="#EFF7F1">
          <num>0.000 in</num>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>Strand 6</textvalue>
        </c>
        <c formula="s_sh_6 to in" capture="False" background="#EFF7F1">
          <num>5.567 in</num>
        </c>
        <c formula="m_sh_6" capture="False" background="#EFF7F1">
          <num>0.000</num>
        </c>
        <c formula="w_sh_6 to in" capture="False" background="#EFF7F1">
          <num>0.000 in</num>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>Strand 7</textvalue>
        </c>
        <c formula="s_sh_7 to in" capture="False" background="#EFF7F1">
          <num>5.425 in</num>
        </c>
        <c formula="m_sh_7" capture="False" background="#EFF7F1">
          <num>0.000</num>
        </c>
        <c formula="w_sh_7 to in" capture="False" background="#EFF7F1">
          <num>0.000 in</num>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>Strand 8</textvalue>
        </c>
        <c formula="s_sh_8 to in" capture="False" background="#EFF7F1">
          <num>5.282 in</num>
        </c>
