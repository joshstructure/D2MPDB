              <expbody>V_res_2 = 12.895026 kip</expbody>
            </dynexp>
          </paragraph>
        </textcell>
      </row>
      <row>
        <c capture="False" background="#FFF8E9">
          <textvalue>3. Shear</textvalue>
        </c>
        <textcell name="DemandInputsR3C1" capture="False" background="#FFF8E9">
          <paragraph fontfamily="Times New Roman" fontsize="9" spacingafter="2">
            <dynexp formula="P_fbmp_3 = 120.41 kip" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input">
              <expbody>P_fbmp_3 = 120.41 kip</expbody>
            </dynexp>
          </paragraph>
        </textcell>
        <textcell name="DemandInputsR3C2" capture="False" background="#FFF8E9">
