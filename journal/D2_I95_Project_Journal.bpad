                    </row>
                    <row>
                        <c capture="False"><textvalue>B2</textvalue></c>
                        <c capture="False" formula="PedBridgeWeights_2Beams.DC_super_B2"><num>92.06854858333327 kip</num></c>
                        <c capture="False" formula="PedBridgeWeights_2Beams.DC_sub_B2"><num>2.022658125 kip</num></c>
                        <c capture="False" formula="PedBridgeWeights_2Beams.DC_cap_B2"><num>94.09120670833327 kip</num></c>
                        <c capture="False" formula="PedBridgeWeights_2Beams.PL_B2"><num>28.984499999999976 kip</num></c>
                        <c capture="False" formula="PedBridgeWeights_2Beams.DW_B2"><num>0 kip</num></c>
                    </row>
                    <row>
                        <c capture="False"><textvalue>B3</textvalue></c>
                        <c capture="False" formula="PedBridgeWeights_2Beams.DC_super_B3"><num>89.96731016666675 kip</num></c>
                        <c capture="False" formula="PedBridgeWeights_2Beams.DC_sub_B3"><num>2.022658125 kip</num></c>
                        <c capture="False" formula="PedBridgeWeights_2Beams.DC_cap_B3"><num>91.98996829166676 kip</num></c>
                        <c capture="False" formula="PedBridgeWeights_2Beams.PL_B3"><num>28.323000000000025 kip</num></c>
