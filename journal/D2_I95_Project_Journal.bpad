                            <c capture="False" formula="If(FE_ViewCase == &quot;W1&quot;,FE_FT_W1_B4,If(FE_ViewCase == &quot;W2&quot;,FE_FT_W2_B4,FE_FT_W3_B4))/FE_U_F"><num>12.866497831694131</num></c>
                            <c capture="False" formula="If(FE_ViewCase == &quot;W1&quot;,FE_FL_W1_B4,If(FE_ViewCase == &quot;W2&quot;,FE_FL_W2_B4,FE_FL_W3_B4))/FE_U_F"><num>3.216624457923533</num></c>
