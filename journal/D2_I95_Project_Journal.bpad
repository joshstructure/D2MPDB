                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0008">C001 | 3. PRESSURE EXPOSURE AND ELEVATION COEFFICIENT, K_Z</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0013">C001 | 4. DESIGN WIND PRESSURE ON STRUCTURES: WS</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0014">C001 | 4.1. Strength III Wind Pressure</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0015">C001 | 4.2. Strength V Wind Pressure</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0016">C001 | 4.3. Service I Wind Pressure</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
