        </c>
        <c formula="DC_comb" capture="False" background="#EFF7F1">
          <num>0.457</num>
        </c>
        <c formula="Chk_comb" capture="False" background="#EFF7F1">
          <textvalue>✓ PASS</textvalue>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>5. shear</textvalue>
        </c>
        <c formula="DC_shear" capture="False" background="#EFF7F1">
          <num>0.049</num>
        </c>
        <c formula="Chk_shear" capture="False" background="#EFF7F1">
          <textvalue>✓ PASS</textvalue>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>6. tension</textvalue>
        </c>
        <c formula="DC_t" capture="False" background="#EFF7F1">
          <num>0.009</num>
        </c>
        <c formula="Chk_t" capture="False" background="#EFF7F1">
          <textvalue>✓ PASS</textvalue>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>7. pile spacing</textvalue>
        </c>
        <c formula="DC_sp" capture="False" background="#EFF7F1">
          <num>1.000</num>
        </c>
        <c formula="Chk_sp" capture="False" background="#EFF7F1">
          <textvalue>✓ PASS</textvalue>
