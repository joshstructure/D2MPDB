                    <planecontainer origin="2.13,4.0,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#1766A0" formula="BridgeGeometry_2Beam.BeamEnd_bearingCL to in"><num>9 in</num></planecontainer>
