                        <c capture="False"><textvalue>B1</textvalue></c>
                        <c capture="False" formula="PedBridgeWeights_2Beams.DC_super_B1"><num>92.06854858333327 kip</num></c>
                        <c capture="False" formula="PedBridgeWeights_2Beams.DC_sub_B1"><num>2.022658125 kip</num></c>
