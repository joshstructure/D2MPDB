            <c name="DC_super_B3" showidentifier="False" formula="O6+O10+O15+O18+O33"><num>89.96731016666675 kip</num></c>
            <c name="DC_sub_B3" showidentifier="False" formula="O23+O29"><num>2.022658125 kip</num></c>
            <c name="DC_cap_B3" showidentifier="False" formula="F65+G65"><num>91.98996829166676 kip</num></c>
            <c name="PL_B3" showidentifier="False" formula="O46"><num>28.323000000000025 kip</num></c>
            <c name="DW_B3" showidentifier="False" formula="w_DW_super*Ltrib_B3/2"><num>0 kip</num></c>
            <c formula="H65+I65"><num>120.31296829166678 kip</num></c>
        </row>
        <row>
            <cell />
            <cell />
            <cell />
            <c><textvalue>B4 — Span 2, beam +</textvalue></c>
            <c name="Ltrib_B4" showidentifier="False" formula="BridgeGeometry_2Beam.PierTrib_2"><num>52 ft 5.399999999999977 in</num></c>
            <c name="DC_super_B4" showidentifier="False" formula="P6+P10+P15+P18+P33"><num>89.96731016666675 kip</num></c>
            <c name="DC_sub_B4" showidentifier="False" formula="P23+P29"><num>2.022658125 kip</num></c>
            <c name="DC_cap_B4" showidentifier="False" formula="F66+G66"><num>91.98996829166676 kip</num></c>
