        <section name="CodePage01" capture="True" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="40" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" id="paragraphprojectcoderef01C004" textcolor="#155731" texthighlight="#DDEFE3">
                <link address="#CodeReferencesC004.CodePage01;paragraphprojectcoderef01C004">REFERENCE 01 | RFQ - Governing Regulations</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC004.CodePage01;paragraphprojectcoderef01C004">RFQ V6.0, Addendum 5</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" textcolor="#536575">Printed 24 | Source PDF page 24</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">USED FOR</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Governs edition selection for the calculation set and records the Task Work Order route for later governing editions.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Variables: Entire calculation basis</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">RETURN TO CALCULATIONS</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind.FWCodeBasis;paragraphfwcodec01">C002 | Design basis</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind.FWStrategyWork01;paragraphfwstrategywork01">C002 | Code basis, reference point, and directions</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind.FWStrategyWork07;paragraphfwstrategywork07">C002 | Check the simplified method and complete the design handoff</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#SuperstructureUplift;paragraphrefreturn0033">C004 | Design basis</link>
