      <circle center="4.756, 0.912, 0" normal="0, 0, 1" radius="0.035" linethickness="0.5" linecolor="#29333D" fillcolor="#29333D"/>
      <circle center="2.913, 0.896, 0" normal="0, 0, 1" radius="0.02" linethickness="0.5" linecolor="#C8702A" fillcolor="#C8702A"/>
