                    <planecontainer origin="0.1,5.12,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#29333D"><textvalue>Longitudinal elevation | Span is to the right | Not to scale</textvalue></planecontainer>
                    <plot formula="PlotLines([1.3,1.3+.07*BridgeGeometry_2Beam.EndBentCap_width/(1 in),1.3+.07*BridgeGeometry_2Beam.EndBentCap_width/(1 in),1.3,1.3],[1.55,1.55,2.85,2.85,1.55])" linecolor="#667887" linethickness="1" />
