                    <expbody>EB_CheckM_W3 = If(And(AX_Base_EB_CheckM_W3 == "PASS",Abs(EB_SumMT_W3-EB_axisT*AX_Base_EB_SumMT_W3)&lt;0.000001 kip*ft,Abs(EB_SumML_W3-EB_axisL*AX_Base_EB_SumML_W3)&lt;0.000001 kip*ft,Abs(EB_SumMV_W3-EB_axisV*AX_Base_EB_SumMV_W3)&lt;0.000001 kip*ft),"PASS","FAIL")</expbody>
                    <expresult> = PASS</expresult>
                </dynexp>
            </paragraph>
