                            <c capture="False" formula="If(FE_ViewCase == &quot;W1&quot;,FE_FL_W1_B2,If(FE_ViewCase == &quot;W2&quot;,FE_FL_W2_B2,FE_FL_W3_B2))/FE_U_F"><num>3.291750577293524</num></c>
