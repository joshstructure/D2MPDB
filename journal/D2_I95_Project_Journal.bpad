                    </row>
                    <row>
                        <c capture="False"><textvalue>B4</textvalue></c>
                        <c capture="False" formula="FE_Node_B4"><textvalue>2R</textvalue></c>
                        <c capture="False" formula="FE_T_B4 to ft in"><num>4 ft 3.5 in</num></c>
                        <c capture="False" formula="FE_L_B4 to ft in"><num>0 ft 10.5 in</num></c>
                        <c capture="False" formula="FE_V_B4 to ft in"><num>0 ft 0 in</num></c>
