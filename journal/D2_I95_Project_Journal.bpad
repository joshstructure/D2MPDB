      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_ts_8 = s_tp_8/s_tlim" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>DC_ts_8 = s_tp_8/s_tlim</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_ts_9 = s_tp_9/s_tlim" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>DC_ts_9 = s_tp_9/s_tlim</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_ts_10 = s_tp_10/s_tlim" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>DC_ts_10 = s_tp_10/s_tlim</expbody>
      </dynexp>
    </paragraph>
    <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
      <dynexp formula="DC_ts_11 = s_tp_11/s_tlim" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>DC_ts_11 = s_tp_11/s_tlim</expbody>
      </dynexp>
    </paragraph>
  </section>
