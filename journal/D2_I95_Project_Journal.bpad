                    </c>
                    <c capture="False" background="#F1F5FA" formula="ProjectInfo.DesignDate">
                        <textvalue>10/17/2026</textvalue>
                    </c>
                </row>
                <row>
                    <c capture="False" background="#F1F5FA" fontweight="bold">
                        <textvalue>Checked by</textvalue>
                    </c>
                    <c capture="False" background="#F1F5FA" formula="ProjectInfo.CheckedBy">
                        <textvalue>MIK</textvalue>
