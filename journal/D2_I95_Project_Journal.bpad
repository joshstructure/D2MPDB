      <dynexp formula="simp_N = If(And(N_N &lt;= 0.0000000001 kip, Or(ok45_N &gt; 0, h &lt; 16 in)), 1, 0)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
        <expbody>simp_N = If(And(N_N &lt;= 0.0000000001 kip, Or(ok45_N &gt; 0, h &lt; 16 in)), 1, 0)</expbody>
