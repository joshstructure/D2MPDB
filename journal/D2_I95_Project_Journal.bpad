                        <c capture="False" formula="BridgeGeometry_2Beam.WalkTrib_minus to ft in"><num>6 ft 0 in</num></c>
                    </row>
                    <row>
                        <c capture="False"><textvalue>B+</textvalue></c>
                        <c capture="False" formula="BridgeGeometry_2Beam.DeckTrib_plus to ft in"><num>6 ft 9.5 in</num></c>
                        <c capture="False" formula="BridgeGeometry_2Beam.WalkTrib_plus to ft in"><num>6 ft 0 in</num></c>
                    </row>
                </table>
            </embed>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" fontweight="bold" keepwithnext="True">UNFACTORED GRAVITY — KIP, POSITIVE DOWNWARD</paragraph>
            <embed spacingbefore="5" spacingafter="12">
                <table name="NBGravityLoads" capture="False" colwidths="1:60, 2:92, 3:92, 4:92, 5:92, 6:92">
                    <stylerule range="A1:F5" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.3, &quot;#BCD0C1&quot;); Border(&quot;BetweenColumns&quot;, &quot;Solid&quot;, 0.3, &quot;#BCD0C1&quot;);" />
