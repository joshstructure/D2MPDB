      <lineardim startpoint="2.1, 0.65, 0" endpoint="2.1, 2.65, 0" pointondimline="1.75, 1.65, 0" formula="CapDesignPier.d_N" linecolor="#B35012" textcolor="#B35012" linethickness="0.7" fontsize="9">
        <num>31.995 in</num>
