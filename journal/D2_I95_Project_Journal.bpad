          <textvalue>P_fbmp (kip)</textvalue>
        </c>
        <c capture="False" background="#F7E6B9" fontweight="bold">
          <textvalue>M_2 (kip*ft)</textvalue>
        </c>
        <c capture="False" background="#F7E6B9" fontweight="bold">
          <textvalue>M_3 (kip*ft)</textvalue>
        </c>
