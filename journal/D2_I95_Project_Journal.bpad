      <dynexp formula="d_st_x_12 = s_max_x - s_st_x_12 to in" mathlayout="on" showformula="True" showresult="False" showsteps="False">
        <expbody>d_st_x_12 = s_max_x - s_st_x_12 to in</expbody>
