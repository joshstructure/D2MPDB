        <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="5" keepwithnext="True" fontweight="bold">Actual concurrent weld actions — positive transverse offset</paragraph>
        <embed spacingafter="10">
            <table name="C006Table277" title="Actual concurrent weld actions — positive transverse offset" capture="False" colwidths="1:35, 2:120, 3:55, 4:55, 5:95, 6:100, 7:105, 8:85">
                <stylerule range="A1:H13" fontfamily="Times New Roman" fontsize="9" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.5, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.3, &quot;#BCCEC0&quot;);" />
                <stylerule range="A1:H1" background="#DCECE0" fontweight="bold" />
                <row>
                    <c capture="False"><textvalue>Fin</textvalue></c>
                    <c capture="False"><textvalue>Case</textvalue></c>
                    <c capture="False"><textvalue>Fx kip</textvalue></c>
