                <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="7" spacingbefore="5" keepwithnext="False">
                    <dynexp formula="NB_checkUplift = If(And(Abs(SuperstructureUplift.η_bearing*(SuperstructureUplift.γ_DC_III*PedBridgeWeights_2Beams.DC_super_B1+SuperstructureUplift.γ_DW_III*PedBridgeWeights_2Beams.DW_B1+SuperstructureUplift.γ_WS_III*NB_N_IIIU_1)-If(NB_signT==1,SuperstructureUplift.R_W1_III,SuperstructureUplift.R_L1_III))&lt;0.000001 kip,Abs(SuperstructureUplift.η_bearing*(SuperstructureUplift.γ_DC_III*PedBridgeWeights_2Beams.DC_super_B2+SuperstructureUplift.γ_DW_III*PedBridgeWeights_2Beams.DW_B2+SuperstructureUplift.γ_WS_III*NB_N_IIIU_2)-If(NB_signT==1,SuperstructureUplift.R_L1_III,SuperstructureUplift.R_W1_III))&lt;0.000001 kip,Abs(SuperstructureUplift.η_bearing*(SuperstructureUplift.γ_DC_III*PedBridgeWeights_2Beams.DC_super_B3+SuperstructureUplift.γ_DW_III*PedBridgeWeights_2Beams.DW_B3+SuperstructureUplift.γ_WS_III*NB_N_IIIU_3)-If(NB_signT==1,SuperstructureUplift.R_W2_III,SuperstructureUplift.R_L2_III))&lt;0.000001 kip,Abs(SuperstructureUplift.η_bearing*(SuperstructureUplift.γ_DC_III*PedBridgeWeights_2Beams.DC_super_B4+SuperstructureUplift.γ_DW_III*PedBridgeWeights_2Beams.DW_B4+SuperstructureUplift.γ_WS_III*NB_N_IIIU_4)-If(NB_signT==1,SuperstructureUplift.R_L2_III,SuperstructureUplift.R_W2_III))&lt;0.000001 kip), &quot;✓ PASS&quot;, &quot;⊗ FAIL&quot;)" mathlayout="on" showsteps="False">
                        <expbody>NB_checkUplift = If(And(Abs(SuperstructureUplift.η_bearing*(SuperstructureUplift.γ_DC_III*PedBridgeWeights_2Beams.DC_super_B1+SuperstructureUplift.γ_DW_III*PedBridgeWeights_2Beams.DW_B1+SuperstructureUplift.γ_WS_III*NB_N_IIIU_1)-If(NB_signT==1,SuperstructureUplift.R_W1_III,SuperstructureUplift.R_L1_III))&lt;0.000001 kip,Abs(SuperstructureUplift.η_bearing*(SuperstructureUplift.γ_DC_III*PedBridgeWeights_2Beams.DC_super_B2+SuperstructureUplift.γ_DW_III*PedBridgeWeights_2Beams.DW_B2+SuperstructureUplift.γ_WS_III*NB_N_IIIU_2)-If(NB_signT==1,SuperstructureUplift.R_L1_III,SuperstructureUplift.R_W1_III))&lt;0.000001 kip,Abs(SuperstructureUplift.η_bearing*(SuperstructureUplift.γ_DC_III*PedBridgeWeights_2Beams.DC_super_B3+SuperstructureUplift.γ_DW_III*PedBridgeWeights_2Beams.DW_B3+SuperstructureUplift.γ_WS_III*NB_N_IIIU_3)-If(NB_signT==1,SuperstructureUplift.R_W2_III,SuperstructureUplift.R_L2_III))&lt;0.000001 kip,Abs(SuperstructureUplift.η_bearing*(SuperstructureUplift.γ_DC_III*PedBridgeWeights_2Beams.DC_super_B4+SuperstructureUplift.γ_DW_III*PedBridgeWeights_2Beams.DW_B4+SuperstructureUplift.γ_WS_III*NB_N_IIIU_4)-If(NB_signT==1,SuperstructureUplift.R_L2_III,SuperstructureUplift.R_W2_III))&lt;0.000001 kip), "✓ PASS", "⊗ FAIL")</expbody>
                        <expresult> = ✓ PASS</expresult>
                    </dynexp>
                </paragraph>
            </section>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" fontweight="bold" keepwithnext="True" />
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" fontweight="bold" keepwithnext="True" />
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" fontweight="bold" keepwithnext="True" />
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" fontweight="bold" keepwithnext="True">PHYSICAL POSITIONS AND SPAN TRIBUTARIES</paragraph>
            <embed spacingbefore="5" spacingafter="12">
                <table name="NBBearingCoordinates" capture="False" colwidths="1:60, 2:40, 3:105, 4:105, 5:85, 6:125">
                    <stylerule range="A1:F5" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.3, &quot;#BCD0C1&quot;); Border(&quot;BetweenColumns&quot;, &quot;Solid&quot;, 0.3, &quot;#BCD0C1&quot;);" />
