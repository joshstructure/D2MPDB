        <paragraph fontfamily="Times New Roman" fontsize="1" spacingbefore="0" spacingafter="0" pagebreakafter="break"> </paragraph>
        <section name="CodePage10" capture="True" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="40" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" id="paragraphprojectcoderef10General" textcolor="#155731" texthighlight="#DDEFE3">
                <link address="#CodeReferencesGeneral.CodePage10;paragraphprojectcoderef10General">REFERENCE 10 | LRFD 3.8.1.2.3a-b; Table 3.8.1.2.3a-1</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral.CodePage10;paragraphprojectcoderef10General">LRFD Bridge Design Specifications, 10th Edition (2024)</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" textcolor="#536575">Printed 3-54 | Source PDF page 111</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">USED FOR</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Supports skew coefficients, the mid-depth line of action, qualifying simplified bridge components, and direct-pier wind concurrency. C004 uses perpendicular horizontal wind with uplift.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Variables: C_T_gir; C_L_gir; w_T0_III; w_T0_SIV; Check_simplified; h_c; m_H_III</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">SCOPE / REVIEW NOTE</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">C002 simplified components and C004 perpendicular uplift cases remain distinct. Direct-pier loads must represent the same wind direction.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral.CodePage11;paragraphprojectcoderef11General">Related: LRFD 3.8.2 - Vertical wind</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">RETURN TO CALCULATIONS</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#PedBridgeWind;paragraphrefreturn0003">Wind loads | 3. Wind Load Sets</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0004">C001 | 1.1. Bridge Geometry</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0018">C001 | 5. WIND LOADS ON SUPERSTRUCTURE</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0019">C001 | 5.1. Skew Coefficients — Girders</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0020">C001 | 5.2. Strength III — Superstructure Wind Line Loads</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind;paragraphrefreturn0021">C002 | Design basis</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind.FWStrategyWork04;paragraphfwstrategywork04">C002 | Simplified superstructure wind components</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind.FWStrategyWork05;paragraphfwstrategywork05">C002 | Wind acting directly on the pier</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#SuperstructureUplift.UpliftStrategyWork01;headingSuperstructureUplift1">C004 | Model, sign convention and live inputs</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#SuperstructureUplift.UpliftStrategyWork03;headingSuperstructureUplift3">C004 | Concurrent wind and bearing equilibrium (upstream basis)</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral;paragraphreferenceindex">Reference index</link>
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="1" spacingbefore="0" spacingafter="0" pagebreakafter="break"> </paragraph>
        <section name="CodePage11" capture="True" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="40" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" id="paragraphprojectcoderef11General" textcolor="#155731" texthighlight="#DDEFE3">
                <link address="#CodeReferencesGeneral.CodePage11;paragraphprojectcoderef11General">REFERENCE 11 | LRFD 3.8.2 - Vertical wind</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral.CodePage11;paragraphprojectcoderef11General">LRFD Bridge Design Specifications, 10th Edition (2024)</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" textcolor="#536575">Printed 3-56 | Source PDF page 113</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">USED FOR</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">C001 generates upward line loads from prescribed pressures and the live deck width. C004 applies the windward-quarter-point eccentricity with concurrent horizontal wind to determine bearing reactions and stability.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Variables: p_V_III; w_V_III; e_V; w_U_III; m_U_III; m_OT_III</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">SCOPE / REVIEW NOTE</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">The source article includes Strength III and Service IV vertical wind. Only Strength III is used in the current pier load sets. Moments and bearing reactions are derived equilibrium results; C002 does not perform the uplift check.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral.CodePage10;paragraphprojectcoderef10General">Related: LRFD 3.8.1.2.3a-b; Table 3.8.1.2.3a-1</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral.CodePage14;paragraphprojectcoderef14General">Related: LRFD Table 3.4.1-1</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC004.CodePage27;paragraphprojectcoderef27C004">Related: LRFD Table 3.4.1-2</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">RETURN TO CALCULATIONS</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;paragraphrefreturn0004">C001 | 1.1. Bridge Geometry</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#C001WindLoadOnPedBridgeSuperstructure;headingC001WindLoadOnPedBridgeSuperstructure8">C001 | 8. VERTICAL WIND AND PERPENDICULAR COMPANION LOADS — LRFD 3.8.2</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind.FWCodeBasis;paragraphfwcodec16">C002 | Design basis</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind.FWStrategyWork07;paragraphfwstrategywork07">C002 | Check the simplified method and complete the design handoff</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#SuperstructureUplift;paragraphrefreturn0034">C004 | Design basis</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#SuperstructureUplift.UpliftStrategyWork01;headingSuperstructureUplift1">C004 | Model, sign convention and live inputs</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#SuperstructureUplift.UpliftStrategyWork03;headingSuperstructureUplift3">C004 | Concurrent wind and bearing equilibrium</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral;paragraphreferenceindex">Reference index</link>
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="1" spacingbefore="0" spacingafter="0" pagebreakafter="break"> </paragraph>
        <section name="CodePage14" capture="True" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="40" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" id="paragraphprojectcoderef14General" textcolor="#155731" texthighlight="#DDEFE3">
                <link address="#CodeReferencesGeneral.CodePage14;paragraphprojectcoderef14General">REFERENCE 14 | LRFD Table 3.4.1-1</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral.CodePage14;paragraphprojectcoderef14General">LRFD Bridge Design Specifications, 10th Edition (2024)</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" textcolor="#536575">Printed 3-16 | Source PDF page 73</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">USED FOR</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Supports the wind load-combination factors in C002/C004 and the TU cross-reference in C003. Permanent-load minima and displacement factors are supplied by the related tables.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Variables: γ_WS_III; γ_DC_SIV; γ_DW_SIV; γ_WS_SIV; γ_TU</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">SCOPE / REVIEW NOTE</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                Read with
                <link address="#CodeReferencesC004.CodePage27;paragraphprojectcoderef27C004">LRFD Table 3.4.1-2</link>
                for stabilizing dead load and
                <link address="#CodeReferencesC003.CodePage21;paragraphprojectcoderef21C003">Table 3.4.1-6</link>
                for TU displacement.
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC004.CodePage27;paragraphprojectcoderef27C004">Related: LRFD Table 3.4.1-2</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesC003.CodePage21;paragraphprojectcoderef21C003">Related: LRFD Table 3.4.1-6</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">RETURN TO CALCULATIONS</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind.FWCodeBasis;paragraphfwcodec14">C002 | Design basis</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind.FWStrategyWork04;paragraphfwstrategywork04">C002 | Simplified superstructure wind components</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind.FWStrategyWork06;paragraphfwstrategywork06">C002 | Prepare the transfer to analysis nodes</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#BridgeMovement;paragraphrefreturn0029">C003 | 1. DESIGN BASIS AND ASSUMPTIONS</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#SuperstructureUplift;paragraphrefreturn0034">C004 | Design basis</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#SuperstructureUplift.UpliftStrategyWork02;headingSuperstructureUplift2">C004 | Gravity classification and load combinations</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral;paragraphreferenceindex">Reference index</link>
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="1" spacingbefore="0" spacingafter="0" pagebreakafter="break"> </paragraph>
        <section name="CodePage16" capture="True" hide="false">
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="40" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" id="paragraphprojectcoderef16General" textcolor="#155731" texthighlight="#DDEFE3">
                <link address="#CodeReferencesGeneral.CodePage16;paragraphprojectcoderef16General">REFERENCE 16 | LRFD 13.8.2 - Metal-fabric fence wind</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral.CodePage16;paragraphprojectcoderef16General">LRFD Bridge Design Specifications, 10th Edition (2024)</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" textcolor="#536575">Printed 13-10 | Source PDF page 1753</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">USED FOR</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Supplies the prescribed pressure normal to the gross metal-fabric fence surface. C002 develops the global fence resultant and centroid; C004 receives those live loads.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">Variables: p_fence; w_fence; F_fence; M_fence; w_f_III; w_f_SIV</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">SCOPE / REVIEW NOTE</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">The projected resultant for the curved enclosure is a project modeling choice. The fence wind/live-load statement does not replace global bridge load combinations.</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingbefore="10" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in" fontweight="bold" textcolor="#154E79" texthighlight="#EAF1F7">RETURN TO CALCULATIONS</paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#PedBridgeWind;paragraphrefreturn0001">Wind loads | 1.2. Fencing</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#PedBridgeWind;paragraphrefreturn0002">Wind loads | 1.3. Fencing and Superstructure Combined</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind;paragraphrefreturn0021">C002 | Design basis</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind.FWStrategyWork03;paragraphfwstrategywork03">C002 | Prescribed LRFD 13.8.2 fence load</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind;paragraphrefreturn0023">C002 | Simplified superstructure wind components</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind;paragraphrefreturn0026">C002 | Wind acting directly on the pier</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind.FWStrategyWork06;paragraphfwstrategywork06">C002 | Prepare the transfer to analysis nodes</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#FenceWind;paragraphrefreturn0027">C002 | Check balance and complete the design handoff</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#SuperstructureUplift.UpliftStrategyWork03;headingSuperstructureUplift3">C004 | Concurrent wind and bearing equilibrium (upstream basis)</link>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="10" spacingbefore="4" spacingafter="0" leftindent="8.65 in" rightindent="0.25 in">
                <link address="#CodeReferencesGeneral;paragraphreferenceindex">Reference index</link>
            </paragraph>
        </section>
