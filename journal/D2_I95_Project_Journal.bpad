      <circle center="3.944, 0.896, 0" normal="0, 0, 1" radius="0.02" linethickness="0.5" linecolor="#C8702A" fillcolor="#C8702A"/>
      <circle center="4.287, 0.896, 0" normal="0, 0, 1" radius="0.02" linethickness="0.5" linecolor="#C8702A" fillcolor="#C8702A"/>
      <circle center="2.35, 1.26, 0" normal="0, 0, 1" radius="0.023" linethickness="0.5" linecolor="#7B8993" fillcolor="#7B8993"/>
      <circle center="2.35, 1.607, 0" normal="0, 0, 1" radius="0.023" linethickness="0.5" linecolor="#7B8993" fillcolor="#7B8993"/>
      <circle center="2.35, 1.955, 0" normal="0, 0, 1" radius="0.023" linethickness="0.5" linecolor="#7B8993" fillcolor="#7B8993"/>
      <circle center="2.35, 2.302, 0" normal="0, 0, 1" radius="0.023" linethickness="0.5" linecolor="#7B8993" fillcolor="#7B8993"/>
      <circle center="4.85, 1.26, 0" normal="0, 0, 1" radius="0.023" linethickness="0.5" linecolor="#7B8993" fillcolor="#7B8993"/>
      <circle center="4.85, 1.607, 0" normal="0, 0, 1" radius="0.023" linethickness="0.5" linecolor="#7B8993" fillcolor="#7B8993"/>
      <circle center="4.85, 1.955, 0" normal="0, 0, 1" radius="0.023" linethickness="0.5" linecolor="#7B8993" fillcolor="#7B8993"/>
