                            <c capture="False" formula="If(FE_ViewCase == &quot;W1&quot;,FE_MT_W1_B4,If(FE_ViewCase == &quot;W2&quot;,FE_MT_W2_B4,FE_MT_W3_B4))/FE_U_M"><num>26.507950332029395</num></c>
                            <c capture="False" formula="If(FE_ViewCase == &quot;W1&quot;,FE_ML_W1_B4,If(FE_ViewCase == &quot;W2&quot;,FE_ML_W2_B4,FE_ML_W3_B4))/FE_U_M"><num>-28.480529054531278</num></c>
                            <c capture="False" formula="If(FE_ViewCase == &quot;W1&quot;,FE_MV_W1_B4,If(FE_ViewCase == &quot;W2&quot;,FE_MV_W2_B4,FE_MV_W3_B4))/FE_U_M"><num>-0</num></c>
                        </row>
                    </table>
                </embed>
                <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0">
                    Forces: kip. Moment units:
                    <dynexp formula="FE_MomentUnits" style="Result only" mathlayout="off">
                        <expresult>kip-ft</expresult>
                    </dynexp>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0">
                    Axis consistency:
                    <dynexp formula="FE_AxisCheck" style="Result only" mathlayout="off">
                        <expresult>PASS - RIGHT-HANDED</expresult>
                    </dynexp>
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0" background="#F1F5FA">Changing the axis view rotates coordinates, forces and moments together; DC and PL remain physically downward. Changing the orange wind controls changes the physical load case. W2 direct uplift stays physically upward in every view.</paragraph>
            </section>
            <embed spacingbefore="5" spacingafter="10" leftindent="0">
                <table name="FEPositionMap" title="FEPositionMap" capture="False" colwidths="1:60, 2:75, 3:120, 4:115, 5:110, 6:120">
                    <stylerule range="A1:F5" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.7, &quot;#7189A6&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.35, &quot;#CCD6D0&quot;); Border(&quot;BetweenColumns&quot;, &quot;Solid&quot;, 0.35, &quot;#CCD6D0&quot;);" horzalign="Center" vertalign="Center" />
                    <stylerule range="A1:F1" background="#DCE7F3" fontweight="bold" />
                    <stylerule range="A2:F5" background="#F1F5FA" />
                    <row>
                        <c capture="False"><textvalue>Bearing</textvalue></c>
                        <c capture="False"><textvalue>FBMP node</textvalue></c>
                        <c capture="False"><textvalue>T coordinate</textvalue></c>
                        <c capture="False"><textvalue>L coordinate</textvalue></c>
                        <c capture="False"><textvalue>V coordinate</textvalue></c>
                        <c capture="False"><textvalue>Live source</textvalue></c>
                    </row>
                    <row>
                        <c capture="False"><textvalue>B1</textvalue></c>
                        <c capture="False" formula="FE_Node_B1"><textvalue>1L</textvalue></c>
                        <c capture="False" formula="FE_T_B1 to ft in"><num>-4 ft 3.5 in</num></c>
                        <c capture="False" formula="FE_L_B1 to ft in"><num>-0 ft 10.5 in</num></c>
                        <c capture="False" formula="FE_V_B1 to ft in"><num>0 ft 0 in</num></c>
                        <c capture="False" formula="FE_Source_B1"><textvalue>Source B2</textvalue></c>
                    </row>
                    <row>
                        <c capture="False"><textvalue>B2</textvalue></c>
                        <c capture="False" formula="FE_Node_B2"><textvalue>2L</textvalue></c>
                        <c capture="False" formula="FE_T_B2 to ft in"><num>4 ft 3.5 in</num></c>
                        <c capture="False" formula="FE_L_B2 to ft in"><num>-0 ft 10.5 in</num></c>
                        <c capture="False" formula="FE_V_B2 to ft in"><num>0 ft 0 in</num></c>
                        <c capture="False" formula="FE_Source_B2"><textvalue>Source B1</textvalue></c>
                    </row>
                    <row>
                        <c capture="False"><textvalue>B3</textvalue></c>
                        <c capture="False" formula="FE_Node_B3"><textvalue>1R</textvalue></c>
                        <c capture="False" formula="FE_T_B3 to ft in"><num>-4 ft 3.5 in</num></c>
                        <c capture="False" formula="FE_L_B3 to ft in"><num>0 ft 10.5 in</num></c>
                        <c capture="False" formula="FE_V_B3 to ft in"><num>0 ft 0 in</num></c>
