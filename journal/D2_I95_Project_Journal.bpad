            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent2W3yend = Bent2W3y+Bent2W3ty*Bent2W3len" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent2W3yend = Bent2W3y+Bent2W3ty*Bent2W3len</expbody>
                    <expresult> = -3.802 ft</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent2Wall3Pile1Face = (Bent2P1x-Bent2W3x)*Bent2W3nx+(Bent2P1y-Bent2W3y)*Bent2W3ny-Half" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent2Wall3Pile1Face = (Bent2P1x-Bent2W3x)*Bent2W3nx+(Bent2P1y-Bent2W3y)*Bent2W3ny-Half</expbody>
                    <expresult> = 14 ft 7.973 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent2Wall3Pile1Extra = Max(0 in,SideClear-Bent2Wall3Pile1Face)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent2Wall3Pile1Extra = Max(0 in,SideClear-Bent2Wall3Pile1Face)</expbody>
                    <expresult> = 0 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent2Wall3Pile2Face = (Bent2P2x-Bent2W3x)*Bent2W3nx+(Bent2P2y-Bent2W3y)*Bent2W3ny-Half" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent2Wall3Pile2Face = (Bent2P2x-Bent2W3x)*Bent2W3nx+(Bent2P2y-Bent2W3y)*Bent2W3ny-Half</expbody>
                    <expresult> = 10 ft 1.973 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent2Wall3Pile2Extra = Max(0 in,SideClear-Bent2Wall3Pile2Face)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent2Wall3Pile2Extra = Max(0 in,SideClear-Bent2Wall3Pile2Face)</expbody>
                    <expresult> = 0 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent2Wall3Pile3Face = (Bent2P3x-Bent2W3x)*Bent2W3nx+(Bent2P3y-Bent2W3y)*Bent2W3ny-Half" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent2Wall3Pile3Face = (Bent2P3x-Bent2W3x)*Bent2W3nx+(Bent2P3y-Bent2W3y)*Bent2W3ny-Half</expbody>
                    <expresult> = 5 ft 7.973 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent2Wall3Pile3Extra = Max(0 in,SideClear-Bent2Wall3Pile3Face)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent2Wall3Pile3Extra = Max(0 in,SideClear-Bent2Wall3Pile3Face)</expbody>
                    <expresult> = 0 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent2Wall3Pile4Face = (Bent2P4x-Bent2W3x)*Bent2W3nx+(Bent2P4y-Bent2W3y)*Bent2W3ny-Half" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent2Wall3Pile4Face = (Bent2P4x-Bent2W3x)*Bent2W3nx+(Bent2P4y-Bent2W3y)*Bent2W3ny-Half</expbody>
                    <expresult> = 1 ft 1.973 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent2Wall3Pile4Extra = Max(0 in,SideClear-Bent2Wall3Pile4Face)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent2Wall3Pile4Extra = Max(0 in,SideClear-Bent2Wall3Pile4Face)</expbody>
                    <expresult> = 0 ft 10.027 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent2W3Gap = Min(Bent2Wall3Pile1Face,Bent2Wall3Pile2Face,Bent2Wall3Pile3Face,Bent2Wall3Pile4Face)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent2W3Gap = Min(Bent2Wall3Pile1Face,Bent2Wall3Pile2Face,Bent2Wall3Pile3Face,Bent2Wall3Pile4Face)</expbody>
                    <expresult> = 1 ft 1.973 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent2W3Extra = Max(0 in,SideClear-Bent2W3Gap)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent2W3Extra = Max(0 in,SideClear-Bent2W3Gap)</expbody>
                    <expresult> = 0 ft 10.027 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent2W3Status = If(InputsValid,If(Bent2W3Extra &lt;= 0 in,&quot;MEETS CLEAR&quot;,&quot;SHORTFALL&quot;),&quot;INVALID&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent2W3Status = If(InputsValid,If(Bent2W3Extra &lt;= 0 in,"MEETS CLEAR","SHORTFALL"),"INVALID")</expbody>
                    <expresult> = SHORTFALL</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent2CapGap = -Bent2W1x*Bent2W1nx-Bent2W1y*Bent2W1ny-CapX*Abs(Bent2W1nx)-CapY*Abs(Bent2W1ny)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent2CapGap = -Bent2W1x*Bent2W1nx-Bent2W1y*Bent2W1ny-CapX*Abs(Bent2W1nx)-CapY*Abs(Bent2W1ny)</expbody>
                    <expresult> = 2 ft 0.617 in</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
                <dynexp formula="Bent2CapStatus = If(Bent2CapGap &gt;= 24 in,&quot;✓ PASS&quot;,&quot;⊗ FAIL&quot;)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
                    <expbody>Bent2CapStatus = If(Bent2CapGap &gt;= 24 in,"✓ PASS","⊗ FAIL")</expbody>
                    <expresult> = ✓ PASS</expresult>
                </dynexp>
            </paragraph>
        </section>
        <paragraph fontfamily="Times New Roman" fontsize="14" spacingafter="6" fontweight="bold" textcolor="#1766A0" spacingbefore="8" keepwithnext="True" pagebreakbefore="break">3. END BENT 1 — FRONT AND SIDE PLAN</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6">Red open boundary shows computed front and specified side offsets. There is no rear-wall criterion. Gray is the cap; black is the current back of facing. Local x runs across the piles and +y into the approach.</paragraph>
