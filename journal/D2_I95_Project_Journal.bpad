                    <c capture="False" formula="V_actual to kip"><num>41.62833909765975 kip</num></c>
                </row>
                <row>
                    <c capture="False"><textvalue>Full-yield target shear</textvalue></c>
                    <c capture="False" formula="V_target to kip"><num>74.45751685859229 kip</num></c>
                </row>
