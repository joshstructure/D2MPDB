            <c name="DC_cap_B1" showidentifier="False" formula="F63+G63"><num>94.09120670833327 kip</num></c>
            <c name="PL_B1" showidentifier="False" formula="M46"><num>28.984499999999976 kip</num></c>
            <c name="DW_B1" showidentifier="False" formula="w_DW_super*Ltrib_B1/2"><num>0 kip</num></c>
            <c formula="H63+I63"><num>123.07570670833326 kip</num></c>
        </row>
        <row>
            <cell />
            <cell />
            <cell />
            <c><textvalue>B2 — Span 1, beam +</textvalue></c>
            <c name="Ltrib_B2" showidentifier="False" formula="BridgeGeometry_2Beam.PierTrib_1"><num>53 ft 8.100000000000023 in</num></c>
            <c name="DC_super_B2" showidentifier="False" formula="N6+N10+N15+N18+N33"><num>92.06854858333327 kip</num></c>
            <c name="DC_sub_B2" showidentifier="False" formula="N23+N29"><num>2.022658125 kip</num></c>
            <c name="DC_cap_B2" showidentifier="False" formula="F64+G64"><num>94.09120670833327 kip</num></c>
            <c name="PL_B2" showidentifier="False" formula="N46"><num>28.984499999999976 kip</num></c>
            <c name="DW_B2" showidentifier="False" formula="w_DW_super*Ltrib_B2/2"><num>0 kip</num></c>
            <c formula="H64+I64"><num>123.07570670833326 kip</num></c>
        </row>
        <row>
