                    <planecontainer origin="4.38,3.05,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="10" textcolor="#29333D" fontweight="bold"><textvalue>Span 2 beam</textvalue></planecontainer>
                    <planecontainer origin="2.82,1.7,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="10" textcolor="#29333D"><textvalue>Pier cap</textvalue></planecontainer>
                    <planecontainer origin="2.82,0.4,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="9" textcolor="#29333D"><textvalue>Pier / cap CL</textvalue></planecontainer>
                    <planecontainer origin="0.2,2.34,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="8" textcolor="#1766A0"><textvalue>Pad</textvalue></planecontainer>
