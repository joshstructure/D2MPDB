        <paragraph />
        <paragraph fontfamily="Times New Roman" fontsize="11" fontweight="bold" spacingbefore="6" spacingafter="6" leftindent="0">MATERIAL PROPERTIES USED BY THE CALCULATIONS</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" leftindent="0" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="Substructure_fc = 5.5 ksi" mathlayout="on" showformula="True" showresult="False" showsteps="False" seplines="False" style="Required Input">
                <expbody>Substructure_fc = 5.5 ksi</expbody>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" leftindent="0" spacingafter="7">Class IV concrete, C.I.P. substructure: caps, pier wall and backwalls (min. 28-day strength, table above).</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" leftindent="0" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="Deck_fc = 4.5 ksi" mathlayout="on" showformula="True" showresult="False" showsteps="False" seplines="False" style="Required Input">
                <expbody>Deck_fc = 4.5 ksi</expbody>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" leftindent="0" spacingafter="7">Class II concrete, bridge deck (min. 28-day strength, table above).</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" leftindent="0" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="Beam_fc = 8.5 ksi" mathlayout="on" showformula="True" showresult="False" showsteps="False" seplines="False" style="Required Input">
                <expbody>Beam_fc = 8.5 ksi</expbody>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" leftindent="0" spacingafter="7">Class VI concrete, prestressed beams (min. 28-day strength, table above).</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" leftindent="0" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="Railing_fc = 3.4 ksi" mathlayout="on" showformula="True" showresult="False" showsteps="False" seplines="False" style="Required Input">
                <expbody>Railing_fc = 3.4 ksi</expbody>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" leftindent="0" spacingafter="7">Class II concrete, railings (min. 28-day strength, table above).</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" leftindent="0" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="Rebar_fy = 60 ksi" mathlayout="on" showformula="True" showresult="False" showsteps="False" seplines="False" style="Required Input">
                <expbody>Rebar_fy = 60 ksi</expbody>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" leftindent="0" spacingafter="7">Reinforcing steel yield strength, ASTM A615 Grade 60.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="11" leftindent="0" spacingafter="1" spacingbefore="4" keepwithnext="True">
            <dynexp formula="Rebar_Es = 29000 ksi" mathlayout="on" showformula="True" showresult="False" showsteps="False" seplines="False" style="Required Input">
                <expbody>Rebar_Es = 29000 ksi</expbody>
            </dynexp>
        </paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" leftindent="0" spacingafter="7">Reinforcing steel modulus of elasticity, LRFD 5.4.3.2.</paragraph>
        <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="6" leftindent="0">
            <link address="#PileProperties">Pipe steel unit weight and effective section properties</link>
        </paragraph>
    </report>
    <report title="Bridge Geometry - 2 Beam" name="BridgeGeometry_2Beam" unit="in" pagesize="816, 1056" margin="48,48,48,48" collapsemargins="False" bordermargin="0,0,0,0">
        <embed spacingbefore="5" spacingafter="8">
