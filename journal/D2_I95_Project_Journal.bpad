                    <planecontainer origin="4.57,0.46,0" dir="1,0,0" normal="0,0,1" fontfamily="Times New Roman" fontsize="7.5" textcolor="#29333D"><textvalue>PLAN / NOT TO SCALE</textvalue></planecontainer>
                </canvas>
            </embed>
            <section name="FESchematicValues" capture="False" hide="false">
