    <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">strand stress, PCI power formula (tension) or Ep eps (compression)</paragraph>
  </section>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="lam_cg = (P_u_rs*P_r_cg/(1 kip^2) + M_u_rs*M_r_cg/(1 kip^2*ft^2))/((P_u_rs/(1 kip))^2 + (M_u_rs/(1 kip*ft))^2)" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>lam_cg = (P_u_rs*P_r_cg/(1 kip^2) + M_u_rs*M_r_cg/(1 kip^2*ft^2))/((P_u_rs/(1 kip))^2 + (M_u_rs/(1 kip*ft))^2)</expbody>
      <expresult> = 2.251</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">projection of the point on the ray</paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="1" spacingbefore="4" keepwithnext="True">
    <dynexp formula="DC_cg = 1/lam_cg" mathlayout="on" showformula="True" showresult="True" showsteps="False">
      <expbody>DC_cg = 1/lam_cg</expbody>
      <expresult> = 0.444</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">D/C at c_gov (no interpolation between sweep points)</paragraph>
