          <num>2.438</num>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>End right vert.</textvalue>
        </c>
        <c formula="A_tp_10 to in^2/ft" capture="False" background="#EFF7F1">
          <num>0.251 in^2/ft</num>
        </c>
        <c formula="s_tp_10 to in" capture="False" background="#EFF7F1">
          <num>35.250 in</num>
        </c>
        <c formula="DC_ta_10" capture="False" background="#EFF7F1">
          <num>0.835</num>
        </c>
        <c formula="DC_ts_10" capture="False" background="#EFF7F1">
          <num>2.938</num>
        </c>
      </row>
      <row>
        <c capture="False" background="#EFF7F1">
          <textvalue>End right horiz.</textvalue>
        </c>
