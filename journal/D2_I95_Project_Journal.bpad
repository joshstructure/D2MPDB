                <dynexp formula="EB_SumML_W3 = (EB_V_entry*EB_FT_W3_near-EB_T_near*EB_FV_W3_near+EB_ML_W3_near)+(EB_V_entry*EB_FT_W3_far-EB_T_far*EB_FV_W3_far+EB_ML_W3_far) to kip*ft" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_SumML_W3 = (EB_V_entry*EB_FT_W3_near-EB_T_near*EB_FV_W3_near+EB_ML_W3_near)+(EB_V_entry*EB_FT_W3_far-EB_T_far*EB_FV_W3_far+EB_ML_W3_far) to kip*ft</expbody>
                    <expresult> = -140.701 kip*ft</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="2" leftindent="0" spacingbefore="4" keepwithnext="False">
                <dynexp formula="EB_SumMV_W3 = (EB_T_near*EB_FL_W3_near-EB_L_entry*EB_FT_W3_near+EB_MV_W3_near)+(EB_T_far*EB_FL_W3_far-EB_L_entry*EB_FT_W3_far+EB_MV_W3_far) to kip*ft" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_SumMV_W3 = (EB_T_near*EB_FL_W3_near-EB_L_entry*EB_FT_W3_near+EB_MV_W3_near)+(EB_T_far*EB_FL_W3_far-EB_L_entry*EB_FT_W3_far+EB_MV_W3_far) to kip*ft</expbody>
                    <expresult> = -3.268 kip*ft</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="2" leftindent="0" spacingbefore="4" keepwithnext="False">
                <dynexp formula="EB_RefMT_W3 = EB_signL*EB_lambda_W3*(EB_wc_W3*EB_zc+EB_wf_W3*EB_zf)*EB_Trib-EB_RowL*EB_wu_W3*EB_Trib to kip*ft" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_RefMT_W3 = EB_signL*EB_lambda_W3*(EB_wc_W3*EB_zc+EB_wf_W3*EB_zf)*EB_Trib-EB_RowL*EB_wu_W3*EB_Trib to kip*ft</expbody>
                    <expresult> = -35.175 kip*ft</expresult>
                </dynexp>
            </paragraph>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="2" leftindent="0" spacingbefore="4" keepwithnext="False">
                <dynexp formula="EB_RefML_W3 = -EB_signT*(EB_wc_W3*EB_zc+EB_wf_W3*EB_zf+EB_wu_W3*EB_e)*EB_Trib to kip*ft" mathlayout="on" showsteps="False" seplines="False">
                    <expbody>EB_RefML_W3 = -EB_signT*(EB_wc_W3*EB_zc+EB_wf_W3*EB_zf+EB_wu_W3*EB_e)*EB_Trib to kip*ft</expbody>
