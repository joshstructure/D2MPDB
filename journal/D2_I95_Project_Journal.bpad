            <dynexp formula="V_res_3 = 18.699703 kip" mathlayout="on" showformula="True" showresult="False" showsteps="False" style="Required Input">
              <expbody>V_res_3 = 18.699703 kip</expbody>
            </dynexp>
          </paragraph>
        </textcell>
      </row>
      <row>
