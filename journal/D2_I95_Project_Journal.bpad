                </table>
            </embed>
            <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6">PASS in these tables verifies the displayed force and moment identities. It does not validate provisional geometry or replace pad, restraint, cap, foundation, or dynamic-wind design.</paragraph>
            <section name="NBHistoricalRasterSketches" capture="False" hide="true">
                <paragraph fontfamily="Times New Roman" fontsize="11" fontweight="bold" spacingafter="6">HISTORICAL RASTER SKETCHES — NOT LIVE ENTRY VALUES OR CURRENT AXES</paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" fontweight="bold" keepwithnext="True">
                    <image source="Resource60" width="622.0213788988397" height="404.09940615358937" />
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" fontweight="bold" keepwithnext="True">
                    <image source="Resource172" width="622.1962639037632" height="462.5707396470716" />
                </paragraph>
                <paragraph fontfamily="Times New Roman" fontsize="11" spacingafter="6" fontweight="bold" keepwithnext="True">
