      <expresult> = -25.647 in</expresult>
    </dynexp>
  </paragraph>
  <paragraph fontfamily="Times New Roman" fontsize="10" spacingafter="5" textcolor="#43505C">sum of their coordinates</paragraph>
  <embed spacingbefore="5" spacingafter="8">
    <table name="ShearStrandTable" capture="False" colwidths="1:110, 2:100, 3:150, 4:100">
      <stylerule range="A1:D13" fontfamily="Times New Roman" fontsize="10" valueformat="RoundedNumber(3, 3, {PriorityUnits: []})" border="Border(&quot;AllSides&quot;, &quot;Solid&quot;, 0.6, &quot;#6A9075&quot;); Border(&quot;BetweenRows&quot;, &quot;Solid&quot;, 0.4, &quot;#6A9075&quot;);"/>
      <stylerule range="A1:D1" horzalign="Center" vertalign="Center"/>
      <stylerule range="B2:D13" horzalign="Center" vertalign="Center"/>
      <row>
        <c capture="False" background="#DCECE0" fontweight="bold">
          <textvalue>Strand</textvalue>
        </c>
        <c capture="False" background="#DCECE0" fontweight="bold">
          <textvalue>s (in)</textvalue>
        </c>
        <c capture="False" background="#DCECE0" fontweight="bold">
          <textvalue>on tension half (1)</textvalue>
        </c>
        <c capture="False" background="#DCECE0" fontweight="bold">
          <textvalue>w (in)</textvalue>
        </c>
