<text use-page-width="false" push-down="false" lock-width="true"><p style="Note" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">strand yield limit Aps fpy (upper bound of tension, 5.6.6.1)</p></text>
</region>
<region region-id="211" left="18.00" top="3893.70" width="234.77" height="41.00" align-x="18.00" align-y="3913.70" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
<math optimize="false" disable-calc="false"><ml:define xmlns:ml="http://schemas.mathsoft.com/math30"><ml:id xml:space="preserve" subscript="axial">DC</ml:id><ml:eval placeholderMultiplicationStyle="default"><ml:apply><ml:div/><ml:id xml:space="preserve" subscript="u.axial">P</ml:id><ml:id xml:space="preserve" subscript="r.max">P</ml:id></ml:apply></ml:eval></ml:define><resultFormat numeric-only="false"><decimal precision="3" show-trailing-zeros="true" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i"/><matrix display-style="auto" expand-nested-arrays="false"/><unit format-units="true" simplify-units="true" fractional-unit-exponent="false"/></resultFormat></math>
