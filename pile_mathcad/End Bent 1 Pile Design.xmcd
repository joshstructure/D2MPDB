<region region-id="656" left="18.00" top="12800.81" width="572.00" height="27.00" align-x="18.00" align-y="12809.31" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
<text use-page-width="false" push-down="false" lock-width="true"><p style="Note" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Pile-to-cap moment transfer (SDG 3.5.1.C) needs 48 in of embedment for the full bending capacity; the embedment here is 12 in, so the connection stays a PENDING item of the notebook.</p></text>
</region>
<region region-id="657" left="18.00" top="12843.81" width="572.00" height="22.00" align-x="18.00" align-y="12858.81" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
